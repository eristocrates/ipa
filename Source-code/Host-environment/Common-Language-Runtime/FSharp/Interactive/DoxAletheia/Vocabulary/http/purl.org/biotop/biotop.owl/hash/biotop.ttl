<http://purl.org/biotop/biotop.owl> dc11:creator "Stefan Schulz, Martin Boeker, Elena Beisswanger, Holger Stenzhorn, Djamila Raufie, Daniel Schober, Udo Hahn";
                                    dc11:description """BioTop Website:
http://purl.org/biotop


See related articles at:

http://www.google.com/search?q=Schulz+BioTop+site:www.ncbi.nlm.nih.gov/pmc/articles+ontology+OR+ontologies""",
                                                     "Upper-Level ontology for Biology and Medicine. Compatible with BFO, DOLCE, and the UMLS Semantic Network (mapping files available)";
                                    dc11:format "application/rdf+xml";
                                    dc11:identifier "20120424",
                                                    "http://purl.org/biotop/biotop.owl";
                                    dc11:publisher """Institute of Medical Biometry and Medical Informatics, University Medical Center Freiburg, Stefan-Meier-Strasse 26, 79104 Freiburg, Germany

Institute of Medical Informatics, Statistics and Documentation, Medical University of Graz, Auenbruggerplatz 2/V , 8036 Graz (Austria)""";
                                    dc11:rights "http://creativecommons.org/licenses/by/3.0";
                                    dc11:subject "Biology, Medicine",
                                                 "An experimental top level ontology for biology and medicine.";
                                    dc11:title "BioTop";
                                    a owl:Ontology;
                                    owl:versionInfo """Last modification
Apr 24, 2012 by Stefan Schulz""".
biotop:AcquiredAbnormalStructure ru:definition "biological structure that deviates from what is considered normal and that evolved during lifetime";
                                 a owl:Class;
                                 rdfs:label "acquired abnormal structure";
                                 rdfs:subClassOf biotop:PathologicalStructure;
                                 owl:disjointWith biotop:CongenitalAbnormalStructure.
biotop:AcquiredPathologicalCondition ru:definition "Ill-formed state of a biological entity,acquired after birth [steschu 20071010]";
                                     a owl:Class;
                                     rdfs:label "acquired pathological condition";
                                     rdfs:subClassOf biotop:PathologicalValueRegion;
                                     owl:disjointWith biotop:CongenitalPathologicalCondition.
biotop:AcquiredPathologicalStaticProcessualEntity ru:definition "pathological state acquired during lifetime";
                                                  a owl:Class;
                                                  rdfs:label "acquired pathological static processual entity";
                                                  owl:equivalentClass [owl:intersectionOf (biotop:PathologicalStaticProcessualEntity
                                                                                           [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                                                   [owl:someValuesFrom biotop:AcquiredPathologicalCondition ; 
                                                                                                                                   owl:onProperty biotop:qualityLocated ; 
                                                                                                                                   a owl:Restriction]) ; 
                                                                                                               a owl:Class] ; 
                                                                                           owl:onProperty biotop:hasProcessQuality ; 
                                                                                           a owl:Restriction]) ; 
                                                                       a owl:Class];
                                                  owl:priorVersion "acquired pathological state".
biotop:Action ru:definition "An action is a processual entity that that is promoted by an agent, having a clear role distinction between agent and patient";
              a owl:Class;
              rdfs:label "action";
              rdfs:subClassOf [owl:someValuesFrom biotop:TimeInterval ; 
                               owl:onProperty biotop:hasDuration ; 
                               a owl:Restriction];
              owl:equivalentClass [owl:intersectionOf (biotop:Process
                                                       [owl:someValuesFrom biotop:Particular ; 
                                                       owl:onProperty biotop:hasAgent ; 
                                                       a owl:Restriction]) ; 
                                   a owl:Class].
biotop:ActionOnBiologicalSystem ru:definition "an action which externally acts upon a biological system";
                                a owl:Class;
                                rdfs:label "action on biological system";
                                rdfs:subClassOf [owl:someValuesFrom [owl:unionOf (biotop:LivingOrganism
                                                                                  [owl:someValuesFrom biotop:LivingOrganism ; 
                                                                                  owl:onProperty biotop:properPhysicalPartOf ; 
                                                                                  a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty biotop:hasPatient ; 
                                                 a owl:Restriction],
                                                biotop:Action.
biotop:AdultOrganism ru:definition "organism in reproductive phase";
                     a owl:Class;
                     rdfs:label "adult organism";
                     rdfs:subClassOf biotop:OrganismByDevelopmentalStagePartition;
                     owl:disjointWith biotop:EmbryonicOrganism,
                                      biotop:JuvenileOrganism;
                     owl:equivalentClass [owl:intersectionOf (biotop:LivingOrganism
                                                              [owl:someValuesFrom [owl:intersectionOf (biotop:DevelopmentalQuality
                                                                                                      [owl:someValuesFrom biotop:AdultValueRegion ; 
                                                                                                      owl:onProperty biotop:qualityLocated ; 
                                                                                                      a owl:Restriction]) ; 
                                                                                  a owl:Class] ; 
                                                              owl:onProperty biotop:bearerOf ; 
                                                              a owl:Restriction]) ; 
                                          a owl:Class].
biotop:AdultValueRegion a owl:Class;
                        rdfs:comment """\"adult\" as the value of a developmental stage. E.g. a 4 year old dog has a quality which has its value located in \"adult value region\".""";
                        rdfs:label "adult value region";
                        rdfs:subClassOf biotop:DevelopmentalValueRegion.
biotop:Affecting ru:definition "Producing a direct effect on";
                 a owl:Class;
                 rdfs:label "affecting";
                 rdfs:subClassOf biotop:Action.
biotop:AgeQuality ru:definition "the quality of having a livespan";
                  a owl:Class;
                  rdfs:label "age quality";
                  rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom [owl:unionOf (biotop:ImmaterialObject
                                                                                        biotop:MaterialObject) ; 
                                                                           a owl:Class] ; 
                                                       owl:onProperty biotop:inheresIn ; 
                                                       a owl:Restriction]
                                                       [owl:onProperty biotop:inheresIn ; 
                                                       owl:allValuesFrom [owl:unionOf (biotop:ImmaterialObject
                                                                                       biotop:MaterialObject) ; 
                                                                          a owl:Class] ; 
                                                       a owl:Restriction]) ; 
                                   a owl:Class],
                                  biotop:ObjectQuality.
biotop:Alga a owl:Class;
            rdfs:label "alga";
            rdfs:subClassOf biotop:Eukaryote.
biotop:AlphaParticle ru:definition "Positively charged particles composed of two protons and two neutrons, i.e. equivalent to Helium nuclei ";
                     a owl:Class;
                     rdfs:label "alpha particle";
                     rdfs:subClassOf [owl:intersectionOf ([owl:complementOf [owl:someValuesFrom biotop:Electron ; 
                                                                            owl:onProperty biotop:hasProperPhysicalPart ; 
                                                                            a owl:Restriction] ; 
                                                          a owl:Class]
                                                          [owl:someValuesFrom biotop:Neutron ; 
                                                          owl:onProperty biotop:hasProperPhysicalPart ; 
                                                          a owl:Restriction]) ; 
                                      a owl:Class],
                                     biotop:Atom.
biotop:AminoAcidMoleculeOrResidue ru:definition "Amino Acids molecules or residues (residues as in peptide bonds)";
                                  a owl:Class;
                                  rdfs:comment "(QCR) ro:hasPart some CarbonHydrogenSubstructure and ((hasComponent myx 2 CarboxyGroup) and (hasComponent min 1 CarboxyGroup) and (hasComponent exactly 1 AminoGroup)) or ((hasComponent max 2 AminoGroup) and (hasComponent min 1 AminoGroup) and (hasComponent exactly 1 CarboxyGroup))",
                                               "In chemistry, an amino acid is any molecule that contains both amine and carboxyl functional groups. However, in biochemistry, this more general term is frequently used to refer to alpha amino acids (amino acids in which the amino and carboxylate functionalities are attached to the same carbon, called ?–carbon). Amino Acids have at least one amino and one carboxy group. Those having two carboxy groups have only one amino group and vice versa.";
                                  rdfs:label "amino acid molecule or residue";
                                  rdfs:subClassOf [owl:someValuesFrom biotop:SubmolecularGroup ; 
                                                   owl:onProperty biotop:hasComponentPart ; 
                                                   a owl:Restriction],
                                                  biotop:AminoAcidOrPeptideMoleculeOrStructure,
                                                  biotop:Monomer;
                                  owl:disjointWith biotop:PeptideStructure.
biotop:AminoAcidOrPeptideMoleculeOrStructure ru:definition "amino acids as monomers and polymers";
                                             a owl:Class;
                                             rdfs:label "amino acid or peptide molecule or structure";
                                             rdfs:subClassOf biotop:OrganicMolecularEntityPartition.
biotop:AminoAcidSequence ru:definition "Chain of amino acids, joined by peptide bonds. Folded or unfolded.";
                         a owl:Class;
                         rdfs:label "amino acid sequence";
                         rdfs:subClassOf biotop:PeptideStructure;
                         owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom biotop:AminoAcidMoleculeOrResidue ; 
                                                                  owl:onProperty biotop:hasComponentPart ; 
                                                                  a owl:Restriction]
                                                                  [owl:onProperty biotop:hasComponentPart ; 
                                                                  owl:allValuesFrom biotop:AminoAcidMoleculeOrResidue ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
biotop:AminoAcidSequenceInformation ru:definition "The information that describes the make-up of a (physical) amino acid sequence.";
                                    a owl:Class;
                                    rdfs:label "amino acid sequence information";
                                    rdfs:subClassOf biotop:DEPRECATED.
biotop:AmountOfBodySubstance ru:definition "collection with molecules or atoms as granular parts (but which may have also bigger granular parts) that is produced by a biological system (e.g. blood, urine, ivory)";
                             a owl:Class;
                             rdfs:label "amount of body substance";
                             rdfs:subClassOf biotop:CompoundOfCollectiveMaterialEntities.
biotop:AmountOfPureSubstance ru:definition "collection with molecules or atoms as granular parts of the same sort";
                             a owl:Class;
                             rdfs:label "amount of pure substance";
                             rdfs:subClassOf [owl:complementOf [owl:someValuesFrom biotop:PolyMolecularCompositeEntity ; 
                                                                owl:onProperty biotop:hasProperPhysicalPart ; 
                                                                a owl:Restriction] ; 
                                              a owl:Class],
                                             [owl:someValuesFrom [owl:unionOf (biotop:Atom
                                                                               biotop:MonoMolecularEntity) ; 
                                                                  a owl:Class] ; 
                                              owl:onProperty biotop:hasGranularPart ; 
                                              a owl:Restriction],
                                             [owl:onProperty biotop:hasGranularPart ; 
                                              owl:allValuesFrom [owl:unionOf (biotop:Atom
                                                                              biotop:MonoMolecularEntity) ; 
                                                                 a owl:Class] ; 
                                              a owl:Restriction],
                                             biotop:CollectiveMaterialEntity;
                             owl:disjointWith biotop:PluralityOfOrganisms.
biotop:Amphibian a owl:Class;
                 rdfs:label "amphibian";
                 rdfs:subClassOf biotop:Vertebrate.
biotop:Analyzing a owl:Class;
                 rdfs:label "analyzing";
                 rdfs:subClassOf biotop:HumanAction.
biotop:AnimalCell a owl:Class;
                  rdfs:label "animal cell";
                  rdfs:subClassOf biotop:CellByTaxonPartition;
                  owl:disjointWith biotop:BacterialCell,
                                   biotop:PlantCell;
                  owl:equivalentClass [owl:intersectionOf (biotop:Cell
                                                           [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                                                   [owl:someValuesFrom biotop:KingdomAnimaliaValueRegion ; 
                                                                                                   owl:onProperty biotop:qualityLocated ; 
                                                                                                   a owl:Restriction]) ; 
                                                                               a owl:Class] ; 
                                                           owl:onProperty biotop:bearerOf ; 
                                                           a owl:Restriction]) ; 
                                       a owl:Class].
biotop:AnimalExcludingHuman a owl:Class;
                            rdfs:label "animal excluding human";
                            owl:equivalentClass [owl:intersectionOf (biotop:AnimalIncludingHuman
                                                                     [owl:complementOf biotop:Human ; 
                                                                     a owl:Class]) ; 
                                                 a owl:Class].
biotop:AnimalIncludingHuman ru:definition "Multicellular organisms of the kingdom Animalia";
                            a owl:Class;
                            rdfs:label "animal including human";
                            rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                                     [owl:someValuesFrom biotop:KingdomAnimaliaValueRegion ; 
                                                                                     owl:onProperty biotop:qualityLocated ; 
                                                                                     a owl:Restriction]
                                                                                     [owl:onProperty biotop:qualityLocated ; 
                                                                                     owl:allValuesFrom biotop:KingdomAnimaliaValueRegion ; 
                                                                                     a owl:Restriction]) ; 
                                                                 a owl:Class] ; 
                                             owl:onProperty biotop:bearerOf ; 
                                             a owl:Restriction],
                                            biotop:Eukaryote.
biotop:AnimalLanguage ru:definition "language used in communication between animals";
                      a owl:Class;
                      rdfs:label "animal language";
                      rdfs:subClassOf biotop:LanguagePartition.
biotop:AnimalPopulation a owl:Class;
                        rdfs:comment "EXAMPLE OF POPULATION";
                        rdfs:label "animal population";
                        owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                 [owl:someValuesFrom biotop:AnimalIncludingHuman ; 
                                                                 owl:onProperty biotop:hasGranularPart ; 
                                                                 a owl:Restriction]
                                                                 [owl:onProperty biotop:hasGranularPart ; 
                                                                 owl:allValuesFrom biotop:AnimalIncludingHuman ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
biotop:AntibioticRole ru:definition "the role a chemical plays if used to combat a bacterial infection";
                      a owl:Class;
                      rdfs:label "antibiotic role";
                      rdfs:subClassOf biotop:DrugRole.
biotop:ArchaebacterialCell ru:synonym "Archaebacterium";
                           a owl:Class;
                           rdfs:label "archaebacterial cell";
                           rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                                    [owl:onProperty biotop:qualityLocated ; 
                                                                                    owl:allValuesFrom biotop:KingdomArchaeaValueRegion ; 
                                                                                    a owl:Restriction]) ; 
                                                                a owl:Class] ; 
                                            owl:onProperty biotop:bearerOf ; 
                                            a owl:Restriction],
                                           biotop:Prokaryote.
biotop:ArtefactRole ru:definition "The role an entity plays when it has been artificially produced. [steschu 20071010]";
                    a owl:Class;
                    rdfs:label "artefact role";
                    rdfs:subClassOf biotop:Role.
biotop:Arthropod a owl:Class;
                 rdfs:comment "one arthropod";
                 rdfs:label "arthropod";
                 rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                          [owl:someValuesFrom biotop:PhylumArthropodaValueRegion ; 
                                                                          owl:onProperty biotop:qualityLocated ; 
                                                                          a owl:Restriction]) ; 
                                                      a owl:Class] ; 
                                  owl:onProperty biotop:bearerOf ; 
                                  a owl:Restriction],
                                 biotop:Invertebrate.
biotop:ArthropodPopulation a owl:Class;
                           rdfs:comment "EXAMPLE OF POPULATION";
                           rdfs:label "arthropod population";
                           owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                    [owl:someValuesFrom biotop:Arthropod ; 
                                                                    owl:onProperty biotop:hasGranularPart ; 
                                                                    a owl:Restriction]
                                                                    [owl:onProperty biotop:hasGranularPart ; 
                                                                    owl:allValuesFrom biotop:Arthropod ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class].
biotop:Atom ru:definition "Basic building block of molecules. Particle of discrete types. Biologically important atoms are C, N, H, O, P, S, Na, Ca, K, Mg, Cl, J, Fe, Co, Zn ,... Atoms may be electrically neutral or ionic.";
            a owl:Class;
            rdfs:label "atom";
            rdfs:subClassOf [owl:unionOf (biotop:Proton
                                          [owl:someValuesFrom biotop:Proton ; 
                                          owl:onProperty biotop:hasProperPhysicalPart ; 
                                          a owl:Restriction]) ; 
                             a owl:Class],
                            biotop:MaterialEntityBySizePartition.
biotop:BacteriaPopulation a owl:Class;
                          rdfs:comment "EXAMPLE OF POPULATION";
                          rdfs:label "bacteria population";
                          owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                   [owl:someValuesFrom biotop:BacterialCell ; 
                                                                   owl:onProperty biotop:hasGranularPart ; 
                                                                   a owl:Restriction]
                                                                   [owl:onProperty biotop:hasGranularPart ; 
                                                                   owl:allValuesFrom biotop:BacterialCell ; 
                                                                   a owl:Restriction]) ; 
                                               a owl:Class].
biotop:BacterialCell ru:synonym "Bacterium";
                     a owl:Class;
                     rdfs:label "bacterial cell";
                     rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                              [owl:someValuesFrom biotop:KingdomBacteriaValueRegion ; 
                                                                              owl:onProperty biotop:qualityLocated ; 
                                                                              a owl:Restriction]) ; 
                                                          a owl:Class] ; 
                                      owl:onProperty biotop:bearerOf ; 
                                      a owl:Restriction],
                                     biotop:CellByTaxonPartition,
                                     biotop:Prokaryote;
                     owl:disjointWith biotop:PlantCell;
                     owl:equivalentClass [owl:intersectionOf (biotop:Cell
                                                              [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                                                      [owl:someValuesFrom biotop:KingdomBacteriaValueRegion ; 
                                                                                                      owl:onProperty biotop:qualityLocated ; 
                                                                                                      a owl:Restriction]) ; 
                                                                                  a owl:Class] ; 
                                                              owl:onProperty biotop:bearerOf ; 
                                                              a owl:Restriction]) ; 
                                          a owl:Class].
biotop:BacterialColony ru:definition "Cluster of bacteria, usually cultured from a single cell.";
                       a owl:Class;
                       rdfs:label "bacterial colony";
                       owl:equivalentClass [owl:intersectionOf (biotop:BiologicalColony
                                                                [owl:someValuesFrom biotop:BacterialCell ; 
                                                                owl:onProperty biotop:hasGranularPart ; 
                                                                a owl:Restriction]
                                                                [owl:onProperty biotop:hasGranularPart ; 
                                                                owl:allValuesFrom biotop:BacterialCell ; 
                                                                a owl:Restriction]) ; 
                                            a owl:Class].
biotop:BakersYeastCell a owl:Class;
                       rdfs:comment "one saccharomyces cerevisiae cell";
                       rdfs:label "bakers yeast cell";
                       rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                                [owl:someValuesFrom biotop:SpeciesSaccharomycesCerevisiaeValueRegion ; 
                                                                                owl:onProperty biotop:qualityLocated ; 
                                                                                a owl:Restriction]) ; 
                                                            a owl:Class] ; 
                                        owl:onProperty biotop:bearerOf ; 
                                        a owl:Restriction],
                                       biotop:YeastCell;
                       owl:disjointWith biotop:CandidaAlbicansCell.
biotop:BakersYeastPopulation a owl:Class;
                             rdfs:comment "EXAMPLE OF POPULATION";
                             rdfs:label "bakers yeast population";
                             owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                      [owl:someValuesFrom biotop:BakersYeastCell ; 
                                                                      owl:onProperty biotop:hasGranularPart ; 
                                                                      a owl:Restriction]
                                                                      [owl:onProperty biotop:hasGranularPart ; 
                                                                      owl:allValuesFrom biotop:BakersYeastCell ; 
                                                                      a owl:Restriction]) ; 
                                                  a owl:Class].
biotop:Behavior ru:definition "An (often habitual) action of an organism that is the realization of some disposition";
                a owl:Class;
                rdfs:label "behavior";
                rdfs:subClassOf biotop:Action.
biotop:BioMolecularProcess ru:definition "Process occuring on molecular level. It has exclusivly subclasses of MolecularEntity as participants.";
                           a owl:Class;
                           rdfs:label "bio molecular process";
                           owl:equivalentClass [owl:intersectionOf (biotop:BiologicalProcessualEntity
                                                                    [owl:someValuesFrom biotop:MonoMolecularEntity ; 
                                                                    owl:onProperty biotop:hasParticipant ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class].
biotop:BioMolecularSequenceInformation ru:definition """Sequence as an entity of information. The same sequence can inhere in different biopolymers. Sequence information can be theoretical, therefore a \"real\" sequence is not implied.""";
                                       a owl:Class;
                                       rdfs:label "bio molecular sequence information";
                                       rdfs:subClassOf biotop:DEPRECATED.
biotop:BioMolecularSequenceStructure ru:definition "chain (segment) of similar monomers such as proteins or nucleotides";
                                     a owl:Class;
                                     rdfs:label "bio molecular sequence structure";
                                     rdfs:subClassOf biotop:OrganicMolecularEntity;
                                     owl:equivalentClass [owl:unionOf (biotop:AminoAcidSequence
                                                                       biotop:ChainOfCarbohydrateMonomers
                                                                       biotop:ChainOfNucleotideMonomers
                                                                       biotop:DNAChain
                                                                       biotop:RNAChain) ; 
                                                          a owl:Class].
biotop:BiologicalAction ru:definition "Action that has some biological entity as agent";
                        a owl:Class;
                        rdfs:label "biological action";
                        rdfs:subClassOf biotop:Action;
                        owl:equivalentClass [owl:someValuesFrom [owl:unionOf (biotop:StructuredBiologicalEntity
                                                                              [owl:someValuesFrom biotop:StructuredBiologicalEntity ; 
                                                                              owl:onProperty biotop:hasGranularPart ; 
                                                                              a owl:Restriction]) ; 
                                                                 a owl:Class] ; 
                                             owl:onProperty biotop:hasAgent ; 
                                             a owl:Restriction].
biotop:BiologicalBoundary ru:definition "boundary in or of a biological entity";
                          a owl:Class;
                          rdfs:label "biological boundary";
                          rdfs:subClassOf biotop:PhysicalBoundary;
                          owl:equivalentClass [owl:someValuesFrom [owl:unionOf (biotop:BiologicalSpace
                                                                                biotop:StructuredBiologicalEntity) ; 
                                                                   a owl:Class] ; 
                                               owl:onProperty biotop:physicallyBounds ; 
                                               a owl:Restriction].
biotop:BiologicalColony ru:definition "Plurality of several individual organisms living closely together, usually for mutual benefit";
                        a owl:Class;
                        rdfs:label "biological colony";
                        rdfs:subClassOf biotop:PluralityOfOrganisms.
biotop:BiologicalFunction ru:definition "a function that inheres in some structured biological entity.";
                          a owl:Class;
                          rdfs:label "biological function";
                          owl:equivalentClass [owl:intersectionOf (biotop:Function
                                                                   [owl:someValuesFrom biotop:StructuredBiologicalEntity ; 
                                                                   owl:onProperty biotop:inheresIn ; 
                                                                   a owl:Restriction]) ; 
                                               a owl:Class].
biotop:BiologicalLife ru:definition "The whole process from origin to death of an organism";
                      a owl:Class;
                      rdfs:label "biological life";
                      rdfs:subClassOf biotop:OrganismProcess.
biotop:BiologicalProcessualEntity ru:definition "Process specific for biological systems.";
                                  a owl:Class;
                                  rdfs:label "biological processual entity";
                                  owl:disjointWith biotop:PhysicalProcessualEntity;
                                  owl:equivalentClass [owl:intersectionOf (biotop:Process
                                                                           [owl:someValuesFrom biotop:StructuredBiologicalEntity ; 
                                                                           owl:onProperty biotop:hasLocus ; 
                                                                           a owl:Restriction]
                                                                           [owl:someValuesFrom biotop:StructuredBiologicalEntity ; 
                                                                           owl:onProperty biotop:hasParticipant ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class].
biotop:BiologicalSize ru:definition "quality of being visible with or without microscope";
                      a owl:Class;
                      rdfs:label "biological size";
                      rdfs:subClassOf [owl:someValuesFrom biotop:BiologicalSizeValueRegion ; 
                                       owl:onProperty biotop:qualityLocated ; 
                                       a owl:Restriction],
                                      [owl:onProperty biotop:qualityLocated ; 
                                       owl:allValuesFrom biotop:BiologicalSizeValueRegion ; 
                                       a owl:Restriction],
                                      biotop:ObjectQuality.
biotop:BiologicalSizeValueRegion ru:definition "values that describe the size of biological entities";
                                 a owl:Class;
                                 rdfs:label "biological size value region";
                                 rdfs:subClassOf biotop:ValueRegion.
biotop:BiologicalSpace ru:definition "space that is located inside a biological entity";
                       a owl:Class;
                       rdfs:label "biological space";
                       owl:equivalentClass [owl:intersectionOf (biotop:ImmaterialThreeDimensionalPhysicalEntity
                                                                [owl:someValuesFrom biotop:StructuredBiologicalEntity ; 
                                                                owl:onProperty biotop:physicallyContainedIn ; 
                                                                a owl:Restriction]) ; 
                                            a owl:Class].
biotop:BiologicalSystemRole ru:definition "A role specific to biological processes";
                            a owl:Class;
                            rdfs:label "biological system role";
                            rdfs:subClassOf biotop:Role.
biotop:BiomedicalMaterialRole ru:definition "Role of Non-drug material used for therapeutic Purpose";
                              a owl:Class;
                              rdfs:label "biomedical material role";
                              rdfs:subClassOf biotop:TherapeuticRole;
                              owl:disjointWith biotop:DrugRole.
biotop:Biomolecule ru:definition "Monomolecular entity that stems from some organism";
                   a owl:Class;
                   rdfs:label "biomolecule";
                   owl:equivalentClass [owl:intersectionOf (biotop:MonoMolecularEntity
                                                            [owl:someValuesFrom biotop:LivingOrganism ; 
                                                            owl:onProperty biotop:originatesFrom ; 
                                                            a owl:Restriction]) ; 
                                        a owl:Class].
biotop:Bird a owl:Class;
            rdfs:label "bird";
            rdfs:subClassOf biotop:Vertebrate.
biotop:Body ru:definition """Entire biological structure that constitutes a (living) organism. A body can be living or dead. Whether a living organism coincides with its body or hasPart its body, is controversial. We use \"hasPhysicalPart\" for relating organism to body. Being reflexive, this would not be incompatible with a view in which a living organism is a body.""";
            a owl:Class;
            rdfs:label "body";
            rdfs:seeAlso "FMAID:256135 Body";
            rdfs:subClassOf biotop:StructuredBiologicalEntity.
biotop:BodyLiquid ru:definition "Suspension and / or solution of biomolecules, ions, bigger particles in Water.";
                  a owl:Class;
                  rdfs:label "body liquid";
                  rdfs:subClassOf [owl:someValuesFrom [owl:someValuesFrom biotop:MonoMolecularEntity ; 
                                                       owl:onProperty biotop:hasGranularPart ; 
                                                       a owl:Restriction] ; 
                                   owl:onProperty biotop:hasComponentPart ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom biotop:LivingOrganism ; 
                                   owl:onProperty biotop:originatesFrom ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom [owl:someValuesFrom biotop:WaterMolecule ; 
                                                       owl:onProperty biotop:hasGranularPart ; 
                                                       a owl:Restriction] ; 
                                   owl:onProperty biotop:hasComponentPart ; 
                                   a owl:Restriction],
                                  biotop:PortionOfHeterogenousLiquid.
biotop:BodySystem ru:definition "Mereological sum of heterogeneous body components that constitute a functional unity";
                  a owl:Class;
                  rdfs:label "body system";
                  rdfs:subClassOf biotop:OrganismPart;
                  owl:disjointWith biotop:Organ.
biotop:CandidaAlbicansCell a owl:Class;
                           rdfs:comment "One candida albicans cell";
                           rdfs:label "candida albicans cell";
                           rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                                    [owl:someValuesFrom biotop:SpeciesCandidaAlbicansValueRegion ; 
                                                                                    owl:onProperty biotop:qualityLocated ; 
                                                                                    a owl:Restriction]) ; 
                                                                a owl:Class] ; 
                                            owl:onProperty biotop:bearerOf ; 
                                            a owl:Restriction],
                                           biotop:YeastCell.
biotop:CandidaAlbicansPopulation a owl:Class;
                                 rdfs:comment "EXAMPLE OF POPULATION";
                                 rdfs:label "candida albicans population";
                                 owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                          [owl:someValuesFrom biotop:CandidaAlbicansCell ; 
                                                                          owl:onProperty biotop:hasGranularPart ; 
                                                                          a owl:Restriction]
                                                                          [owl:onProperty biotop:hasGranularPart ; 
                                                                          owl:allValuesFrom biotop:CandidaAlbicansCell ; 
                                                                          a owl:Restriction]) ; 
                                                      a owl:Class].
biotop:CanonicalProcessualEntity ru:definition "a process that is considered normal";
                                 a owl:Class;
                                 rdfs:label "canonical processual entity";
                                 rdfs:subClassOf biotop:Process;
                                 owl:disjointWith biotop:NoncanonicalProcessualEntity;
                                 owl:equivalentClass [owl:intersectionOf (biotop:Process
                                                                          [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                                  [owl:someValuesFrom biotop:CanonicalValueRegion ; 
                                                                                                                  owl:onProperty biotop:qualityLocated ; 
                                                                                                                  a owl:Restriction]) ; 
                                                                                              a owl:Class] ; 
                                                                          owl:onProperty biotop:hasProcessQuality ; 
                                                                          a owl:Restriction]) ; 
                                                      a owl:Class].
biotop:CanonicalStaticProcessualEntity a owl:Class;
                                       rdfs:comment """a biological state that is considered \"normal\"""";
                                       rdfs:label "canonical static processual entity";
                                       owl:disjointWith biotop:NoncanonicalStaticProcessualEntity;
                                       owl:equivalentClass [owl:intersectionOf (biotop:StaticProcessualEntity
                                                                                [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                                        [owl:someValuesFrom biotop:CanonicalValueRegion ; 
                                                                                                                        owl:onProperty biotop:qualityLocated ; 
                                                                                                                        a owl:Restriction]) ; 
                                                                                                    a owl:Class] ; 
                                                                                owl:onProperty biotop:hasProcessQuality ; 
                                                                                a owl:Restriction]) ; 
                                                            a owl:Class];
                                       owl:priorVersion "canonical state".
biotop:CanonicalValueRegion a owl:Class;
                            rdfs:comment """abstract region in which the value \"canonical\" of canonicity is located""";
                            rdfs:label "canonical value region";
                            rdfs:subClassOf biotop:CanonicityValueRegion;
                            owl:disjointWith biotop:NoncanonicalValueRegion.
biotop:Canonicity ru:definition "The condition of an entity (state, process, function, object) in terms of being well or ill-formed or behaving";
                  a owl:Class;
                  rdfs:label "canonicity";
                  rdfs:subClassOf [owl:onProperty biotop:qualityLocated ; 
                                   owl:allValuesFrom biotop:CanonicityValueRegion ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom biotop:CanonicityValueRegion ; 
                                   owl:onProperty biotop:qualityLocated ; 
                                   a owl:Restriction],
                                  biotop:Quality.
biotop:CanonicityValueRegion ru:definition "abstract region in which values of canonicity are located";
                             a owl:Class;
                             rdfs:label "canonicity value region";
                             rdfs:subClassOf [owl:someValuesFrom biotop:Canonicity ; 
                                              owl:onProperty biotop:qualityLocationOf ; 
                                              a owl:Restriction],
                                             biotop:ValueRegion.
biotop:CarbohydrateMoleculeOrResidue a owl:Class;
                                     rdfs:label "carbohydrate molecule or residue";
                                     rdfs:subClassOf biotop:OrganicMolecularEntityPartition.
biotop:CarbohydrateMonomer a owl:Class;
                           rdfs:label "carbohydrate monomer";
                           rdfs:subClassOf [owl:someValuesFrom biotop:SubmolecularGroup ; 
                                            owl:onProperty biotop:hasComponentPart ; 
                                            a owl:Restriction],
                                           biotop:CarbohydrateMoleculeOrResidue,
                                           biotop:Monomer;
                           owl:disjointWith biotop:ChainOfCarbohydrateMonomers.
biotop:CarbohydrateSequenceInformation ru:definition "The information that describes the make-up of a (physical) carbohydrate sequence.";
                                       a owl:Class;
                                       rdfs:label "carbohydrate sequence information";
                                       rdfs:subClassOf biotop:DEPRECATED.
biotop:CatalyticRole ru:definition "The role a substance plays in accelerating a chemical reaction";
                     a owl:Class;
                     rdfs:label "catalytic role";
                     rdfs:subClassOf biotop:ChemicalRole.
biotop:CategorizationSystem ru:definition "A categorization system is a human artifact that aims at partinioning object classes, denotations, or concepts of a given domain.";
                            a owl:Class;
                            rdfs:label "categorization system";
                            rdfs:subClassOf biotop:IntellectualProduct;
                            owl:disjointWith biotop:RegulationOrLaw.
biotop:Causing ru:definition "action that causes an effect";
               a owl:Class;
               rdfs:label "causing";
               rdfs:subClassOf biotop:Affecting.
biotop:Cell ru:definition "Constituting unit of an organism. The boundary between cell, syncytium and subcellular fragments such as platelets is problematic. Hence no full definition possible.";
            a owl:Class;
            rdfs:label "cell";
            rdfs:subClassOf biotop:StructuredBiologicalCompoundByGranularityPartition;
            owl:disjointWith biotop:CellularComponent,
                             biotop:OrganismPart,
                             biotop:Syncytium;
            owl:equivalentClass [owl:intersectionOf ([owl:complementOf biotop:Syncytium ; 
                                                     a owl:Class]
                                                     [owl:someValuesFrom biotop:CellMembrane ; 
                                                     owl:onProperty biotop:hasComponentPart ; 
                                                     a owl:Restriction]
                                                     [owl:someValuesFrom biotop:CellularComponent ; 
                                                     owl:onProperty biotop:hasComponentPart ; 
                                                     a owl:Restriction]
                                                     [owl:someValuesFrom biotop:Cytoplasm ; 
                                                     owl:onProperty biotop:hasProperPhysicalPart ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class].
biotop:CellByLocusPartition ru:definition """
CellByLocusPartition

Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint.""";
                            a owl:Class;
                            rdfs:label "*";
                            rdfs:subClassOf [owl:unionOf (biotop:CellInVivo
                                                          biotop:ModifiedCell) ; 
                                             a owl:Class],
                                            biotop:Cell.
biotop:CellByTaxonPartition ru:definition """CellByTaxonPartition

Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint.""";
                            a owl:Class;
                            rdfs:label "*";
                            rdfs:subClassOf [owl:unionOf (biotop:AnimalCell
                                                          biotop:BacterialCell
                                                          biotop:PlantCell) ; 
                                             a owl:Class],
                                            biotop:Cell.
biotop:CellByTypePartition ru:definition """CellByTypePartition

Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint.""";
                           a owl:Class;
                           rdfs:label "*";
                           rdfs:subClassOf biotop:Cell.
biotop:CellInVivo ru:definition "Living cell that is not removed from a living system";
                  a owl:Class;
                  rdfs:label "cell in vivo";
                  rdfs:subClassOf [owl:unionOf (biotop:LivingOrganism
                                                [owl:someValuesFrom biotop:LivingOrganism ; 
                                                owl:onProperty biotop:properPhysicalPartOf ; 
                                                a owl:Restriction]) ; 
                                   a owl:Class],
                                  biotop:CellByLocusPartition;
                  owl:disjointWith biotop:ModifiedCell.
biotop:CellMembrane ru:definition "Semipermeable lipid bilayer found in all cells.[1] It contains a wide variety of biological molecules, primarily proteins and lipids, which are involved in a vast array of cellular processes, and also serves as the attachment point for both the intracellular cytoskeleton and, if present, the cell wall.";
                    a owl:Class;
                    rdfs:label "cell membrane";
                    rdfs:subClassOf [owl:someValuesFrom [owl:someValuesFrom biotop:PeptideStructure ; 
                                                         owl:onProperty biotop:hasGranularPart ; 
                                                         a owl:Restriction] ; 
                                     owl:onProperty biotop:hasComponentPart ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom [owl:someValuesFrom biotop:LipidMoleculeOrResidue ; 
                                                         owl:onProperty biotop:hasGranularPart ; 
                                                         a owl:Restriction] ; 
                                     owl:onProperty biotop:hasComponentPart ; 
                                     a owl:Restriction],
                                    biotop:CellularComponent.
biotop:CellNucleus a owl:Class;
                   rdfs:label "cell nucleus";
                   rdfs:subClassOf biotop:CellularComponent.
biotop:CellularComponent ru:definition "Components which only can be formed inside living cells but which may survive their host cell.";
                         a owl:Class;
                         rdfs:label "cellular component";
                         rdfs:subClassOf [owl:someValuesFrom biotop:Cell ; 
                                          owl:onProperty biotop:originatesFrom ; 
                                          a owl:Restriction],
                                         biotop:StructuredBiologicalCompoundByGranularityPartition;
                         owl:disjointWith biotop:OrganismPart,
                                          biotop:Syncytium.
biotop:CentralNervousSystem ru:definition "the central control unit of an organism. Constitutes the brain in higher organisms. ";
                            a owl:Class;
                            rdfs:label "central nervous system";
                            rdfs:subClassOf biotop:OrganSystem.
biotop:ChainOfCarbohydrateMonomers a owl:Class;
                                   rdfs:label "chain of carbohydrate monomers";
                                   rdfs:subClassOf [owl:someValuesFrom biotop:CarbohydrateMonomer ; 
                                                    owl:onProperty biotop:hasComponentPart ; 
                                                    a owl:Restriction],
                                                   biotop:CarbohydrateMoleculeOrResidue.
biotop:ChainOfNucleotideMonomers a owl:Class;
                                 rdfs:label "chain of nucleotide monomers";
                                 rdfs:subClassOf biotop:NucleicAcidStructure.
biotop:ChemicalRole ru:definition "Any role performed by a chemical substance.";
                    a owl:Class;
                    rdfs:label "chemical role";
                    rdfs:subClassOf biotop:Role.
biotop:ChildRole ru:definition "the role an organism plays in relation to its parent";
                 a owl:Class;
                 rdfs:label "child role";
                 rdfs:subClassOf biotop:FamilyRole.
biotop:ChlamydiaCell a owl:Class;
                     rdfs:label "chlamydia cell";
                     rdfs:subClassOf biotop:Prokaryote;
                     owl:disjointWith biotop:RickettsiaCell.
biotop:Chromosome ru:definition "Organized form of DNA in cells, containing one very long, continuous piece of DNA, which contains many genes, regulatory elements and other intervening nucleotide sequences. Includes also the DNA-bound proteins which serve to package and manage the DNA.";
                  a owl:Class;
                  rdfs:label "chromosome";
                  rdfs:subClassOf [owl:someValuesFrom biotop:EntireNucleicAcidMolecule ; 
                                   owl:onProperty biotop:hasComponentPart ; 
                                   a owl:Restriction],
                                  biotop:MoleculeComplex.
biotop:ClassGammaProteobacteriaValueRegion a owl:Class;
                                           rdfs:comment "EXAMPLE OF TAXON REGION";
                                           rdfs:label "class gamma proteobacteria value region";
                                           rdfs:subClassOf biotop:PhylumProteobacteriaValueRegion.
biotop:ClassInsectaValueRegion a owl:Class;
                               rdfs:comment "EXAMPLE OF TAXON REGION";
                               rdfs:label "class insecta value region";
                               rdfs:subClassOf biotop:PhylumArthropodaValueRegion.
biotop:ClassMammaliaValueRegion a owl:Class;
                                rdfs:comment "EXAMPLE OF TAXON REGION";
                                rdfs:label "class mammalia value region";
                                rdfs:subClassOf biotop:SubphylumVertebrataValueRegion.
biotop:ClassSaccharomycetesValueRegion a owl:Class;
                                       rdfs:comment "EXAMPLE OF TAXON REGION";
                                       rdfs:label "class saccharomycetes value region";
                                       rdfs:subClassOf biotop:SubphylumSaccharomycotinaValueRegion.
biotop:CollectiveMaterialEntity ru:definition """Mereological Sum of multiple grains of the same sort without clear identity and unity criteria.
Whether or not the grains are considered of the same sort depends on the view. Therefore this class does not really make a clear categorial distinction, because all matter can be described as a collection of atoms.
As a consequence, these classes are not fully defined. 
 """;
                                a owl:Class;
                                rdfs:comment """The fuzzyness of this class is due to the \"same sort\" criterion.""";
                                rdfs:label "collective material entity";
                                owl:equivalentClass [owl:intersectionOf (biotop:MaterialObject
                                                                         [owl:someValuesFrom biotop:MaterialObject ; 
                                                                         owl:onProperty biotop:hasGranularPart ; 
                                                                         a owl:Restriction]) ; 
                                                     a owl:Class].
biotop:Complicating ru:definition "causes to become more severe";
                    a owl:Class;
                    rdfs:label "complicating";
                    rdfs:subClassOf biotop:Affecting.
biotop:CompoundOfCollectiveMaterialEntities ru:definition """Composition of different kinds of collections without clear unity and identity criteria.
Old name: compound of collections.
Practically all naturally occurring substances are of this sort. The different compounds are also called fractions""";
                                            a owl:Class;
                                            rdfs:label "compound of collective material entities";
                                            owl:disjointWith biotop:PluralityOfOrganisms;
                                            owl:equivalentClass [owl:intersectionOf (biotop:MaterialObject
                                                                                     [owl:someValuesFrom biotop:CollectiveMaterialEntity ; 
                                                                                     owl:onProperty biotop:hasComponentPart ; 
                                                                                     a owl:Restriction]
                                                                                     [owl:onProperty biotop:hasComponentPart ; 
                                                                                     owl:allValuesFrom biotop:CollectiveMaterialEntity ; 
                                                                                     a owl:Restriction]) ; 
                                                                 a owl:Class].
biotop:Condition ru:definition "Union of material entity, process, or disposition. The rationale of this class is to represent the ambiguous nature of what is commonly referred to by health-related condition (not necessarily pathologic)";
                 a owl:Class;
                 rdfs:label "condition";
                 rdfs:subClassOf biotop:Particular;
                 owl:equivalentClass [owl:unionOf (biotop:Disposition
                                                   biotop:MaterialObject
                                                   biotop:Process) ; 
                                      a owl:Class].
biotop:CongenitalAbnormalStructure ru:definition "biological structure that deviates from what is considered normal and that already existed at birth";
                                   a owl:Class;
                                   rdfs:label "congenital abnormal structure";
                                   rdfs:subClassOf biotop:PathologicalStructure.
biotop:CongenitalPathologicalCondition ru:definition "Ill-formed state of a biological entity, present from birth [steschu 20071010]";
                                       a owl:Class;
                                       rdfs:label "congenital pathological condition";
                                       rdfs:subClassOf biotop:PathologicalValueRegion.
biotop:CongenitalPathologicalStaticProcessualEntity ru:definition "pathological state present at birth";
                                                    a owl:Class;
                                                    rdfs:label "congenital pathological static processual entity";
                                                    owl:equivalentClass [owl:intersectionOf (biotop:PathologicalStaticProcessualEntity
                                                                                             [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                                                     [owl:someValuesFrom biotop:CongenitalPathologicalCondition ; 
                                                                                                                                     owl:onProperty biotop:qualityLocated ; 
                                                                                                                                     a owl:Restriction]) ; 
                                                                                                                 a owl:Class] ; 
                                                                                             owl:onProperty biotop:hasProcessQuality ; 
                                                                                             a owl:Restriction]) ; 
                                                                         a owl:Class];
                                                    owl:priorVersion "congenital pathological state".
biotop:Cytoplasm ru:definition "Gelatinous, semi-transparent fluid that fills most cells. E";
                 a owl:Class;
                 rdfs:label "cytoplasm";
                 rdfs:subClassOf [owl:someValuesFrom [owl:someValuesFrom biotop:PeptideStructure ; 
                                                      owl:onProperty biotop:hasGranularPart ; 
                                                      a owl:Restriction] ; 
                                  owl:onProperty biotop:hasProperPhysicalPart ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom [owl:someValuesFrom biotop:WaterMolecule ; 
                                                      owl:onProperty biotop:hasGranularPart ; 
                                                      a owl:Restriction] ; 
                                  owl:onProperty biotop:hasProperPhysicalPart ; 
                                  a owl:Restriction],
                                 biotop:CellularComponent.
biotop:DEPRECATED a owl:Class;
                  rdfs:comment "Place for currently non maintained classes. It should be assured that they are not being referred to by application ontologies that import BioTop".
biotop:DEPRECATED_RELATION a owl:ObjectProperty;
                           rdfs:subPropertyOf owl:topObjectProperty.
biotop:DNAChain ru:definition "A DNA is a complex, high-molecular-weight biochemical macromolecule composed of deoxyribonumcleotide chains that convey genetic information. Any kind of NucleicAcid that is composed of Deoxyribonucleotides is here defined as DNA.";
                a owl:Class;
                rdfs:label "DNA chain";
                rdfs:subClassOf biotop:ChainOfNucleotideMonomers;
                owl:disjointWith biotop:RNAChain.
biotop:DeadBody ru:definition "body that is the transformation of a living body after death";
                a owl:Class;
                rdfs:label "dead body";
                rdfs:subClassOf biotop:Body;
                owl:disjointWith biotop:LivingBody.
biotop:Death ru:definition "End of live of a biological system";
             a owl:Class;
             rdfs:label "death";
             rdfs:subClassOf [owl:intersectionOf (biotop:BiologicalProcessualEntity
                                                  [owl:complementOf [owl:someValuesFrom biotop:TimeInterval ; 
                                                                    owl:onProperty biotop:hasDuration ; 
                                                                    a owl:Restriction] ; 
                                                  a owl:Class]
                                                  [owl:someValuesFrom biotop:PointInTime ; 
                                                  owl:onProperty biotop:hasPointInTime ; 
                                                  a owl:Restriction]) ; 
                              a owl:Class].
biotop:DevelopmentalQuality ru:definition "Ontogenetic stage";
                            a owl:Class;
                            rdfs:label "developmental quality";
                            rdfs:subClassOf [owl:someValuesFrom biotop:DevelopmentalValueRegion ; 
                                             owl:onProperty biotop:qualityLocated ; 
                                             a owl:Restriction],
                                            [owl:onProperty biotop:qualityLocated ; 
                                             owl:allValuesFrom biotop:DevelopmentalValueRegion ; 
                                             a owl:Restriction],
                                            biotop:ObjectQuality.
biotop:DevelopmentalValueRegion ru:definition "abstract region in which the values of developmental stages are located";
                                a owl:Class;
                                rdfs:label "developmental value region";
                                rdfs:subClassOf biotop:ValueRegion.
biotop:DigitalEntity ru:definition "any kind of information that is fully expressible by a sequence of binary values.";
                     a owl:Class;
                     rdfs:comment "(OBI 306)";
                     rdfs:label "digital entity";
                     rdfs:subClassOf biotop:InformationObject.
biotop:Disposition ru:definition """A disposition is a realizable entity. 
Its manifestation is a process its bearer is involved in virtue of the bearer's physical make-up.""";
                   a owl:Class;
                   rdfs:label "disposition";
                   rdfs:subClassOf [owl:someValuesFrom [owl:unionOf (biotop:ImmaterialObject
                                                                     biotop:MaterialObject) ; 
                                                        a owl:Class] ; 
                                    owl:onProperty biotop:inheresIn ; 
                                    a owl:Restriction],
                                   biotop:Particular.
biotop:Disrupting ru:definition "Producing a negative effect on";
                  a owl:Class;
                  rdfs:label "disrupting";
                  rdfs:subClassOf [owl:onProperty biotop:hasPatient ; 
                                   owl:allValuesFrom [owl:unionOf (biotop:Function
                                                                   biotop:MaterialObject
                                                                   biotop:Process) ; 
                                                      a owl:Class] ; 
                                   a owl:Restriction],
                                  biotop:Affecting.
biotop:DrugRole ru:definition "The role of a chemical of biological entity of being deliberately used in virtue of its expected positive impact on a dysfunctional biological system";
                a owl:Class;
                rdfs:label "drug role";
                rdfs:subClassOf biotop:TherapeuticRole.
biotop:EducatorRole ru:definition "The role a person plays that is occupied by educational activities";
                    a owl:Class;
                    rdfs:label "educator role";
                    rdfs:subClassOf biotop:OccupationalRole.
biotop:Eicosanoid ru:definition "An oxygenated metabolite from polyunsaturated 20 carbon fatty acids including lipoxygenase and cyclooxygenase products and their synthetic analogs. This includes the prostaglandins and thromboxanes. (UMLS SN)";
                  a owl:Class;
                  rdfs:label "eicosanoid";
                  rdfs:subClassOf biotop:LipidMoleculeOrResidue.
biotop:Electron ru:definition "Negatively Charged Particle";
                a owl:Class;
                rdfs:label "electron";
                rdfs:subClassOf biotop:SubatomicEntityByChargePartition.
biotop:EmbryonicOrganism ru:definition "evolving organism before birth, with not yet fully formed organs";
                         a owl:Class;
                         rdfs:label "embryonic organism";
                         rdfs:subClassOf biotop:OrganismByDevelopmentalStagePartition;
                         owl:disjointWith biotop:JuvenileOrganism;
                         owl:equivalentClass [owl:intersectionOf (biotop:LivingOrganism
                                                                  [owl:someValuesFrom [owl:intersectionOf (biotop:DevelopmentalQuality
                                                                                                          [owl:someValuesFrom biotop:EmbryonicValueRegion ; 
                                                                                                          owl:onProperty biotop:qualityLocated ; 
                                                                                                          a owl:Restriction]) ; 
                                                                                      a owl:Class] ; 
                                                                  owl:onProperty biotop:bearerOf ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
biotop:EmbryonicStructure ru:definition "An embryo or any structure derived from it. There may be structures derived from an embryo that are no longer considered embryonic ones, hence no full definition.";
                          a owl:Class;
                          rdfs:label "embryonic structure";
                          owl:equivalentClass [owl:intersectionOf (biotop:StructuredBiologicalEntity
                                                                   [owl:unionOf (biotop:EmbryonicOrganism
                                                                                [owl:someValuesFrom biotop:EmbryonicOrganism ; 
                                                                                owl:onProperty biotop:originatesFrom ; 
                                                                                a owl:Restriction]) ; 
                                                                   a owl:Class]
                                                                   [owl:someValuesFrom [owl:intersectionOf (biotop:DevelopmentalQuality
                                                                                                           [owl:someValuesFrom biotop:EmbryonicValueRegion ; 
                                                                                                           owl:onProperty biotop:qualityLocated ; 
                                                                                                           a owl:Restriction]) ; 
                                                                                       a owl:Class] ; 
                                                                   owl:onProperty biotop:bearerOf ; 
                                                                   a owl:Restriction]) ; 
                                               a owl:Class].
biotop:EmbryonicValueRegion a owl:Class;
                            rdfs:comment """\"embryonic\" as the value of a developmental stage. E.g. a 3 days old mouse embryo has a quality which has its value located in \"embryonic value region\".""";
                            rdfs:label "embryonic value region";
                            rdfs:subClassOf biotop:DevelopmentalValueRegion.
biotop:EntireCarbohydrateMonomer a owl:Class;
                                 rdfs:label "entire carbohydrate monomer";
                                 owl:equivalentClass [owl:intersectionOf (biotop:CarbohydrateMonomer
                                                                          [owl:complementOf [owl:someValuesFrom biotop:MonoMolecularEntity ; 
                                                                                            owl:onProperty biotop:properPhysicalPartOf ; 
                                                                                            a owl:Restriction] ; 
                                                                          a owl:Class]) ; 
                                                      a owl:Class].
biotop:EntireMolecularEntity ru:definition "Separately distinguishable molecular structure, neither part of nor attached to any other molecular structure. Atoms are not considered molecular structures. The hierarchy of entire entities mirrors the hierarchy of structures.";
                             a owl:Class;
                             rdfs:label "entire molecular entity";
                             rdfs:subClassOf biotop:MolecularEntityByEntiretyPartition;
                             owl:disjointWith biotop:MolecularResidue;
                             owl:equivalentClass [owl:intersectionOf (biotop:MonoMolecularEntity
                                                                      [owl:complementOf [owl:someValuesFrom biotop:MonoMolecularEntity ; 
                                                                                        owl:onProperty biotop:properPhysicalPartOf ; 
                                                                                        a owl:Restriction] ; 
                                                                      a owl:Class]) ; 
                                                  a owl:Class].
biotop:EntireNucleicAcidMolecule a owl:Class;
                                 rdfs:comment "not (properPartOf some MonoMolecularEntity)  REMOVED";
                                 rdfs:label "entire nucleic acid molecule";
                                 rdfs:subClassOf [owl:intersectionOf (biotop:NucleicAcidStructure
                                                                      [owl:complementOf [owl:someValuesFrom biotop:MonoMolecularEntity ; 
                                                                                        owl:onProperty biotop:properPhysicalPartOf ; 
                                                                                        a owl:Restriction] ; 
                                                                      a owl:Class]) ; 
                                                  a owl:Class],
                                                 [owl:someValuesFrom biotop:Monomer ; 
                                                  owl:onProperty biotop:hasComponentPart ; 
                                                  a owl:Restriction].
biotop:EntireProteinMolecule ru:definition "Amino Acid Polymer longer than 100 monomers.";
                             a owl:Class;
                             rdfs:comment "(QCR) Peptide and hasComponent min 101 AminoAcidMonomer and not (ro:properPartOf some MolecularEntity)";
                             rdfs:label "entire protein molecule";
                             rdfs:subClassOf [owl:complementOf [owl:someValuesFrom biotop:MonoMolecularEntity ; 
                                                                owl:onProperty biotop:properPhysicalPartOf ; 
                                                                a owl:Restriction] ; 
                                              a owl:Class],
                                             biotop:PeptideStructure.
biotop:EnzymeRole a owl:Class;
                  rdfs:comment "The role a peptide plays in accelerating a biochemical reaction";
                  rdfs:label "enzyme role";
                  owl:equivalentClass [owl:intersectionOf (biotop:CatalyticRole
                                                           [owl:someValuesFrom [owl:unionOf (biotop:PeptideStructure
                                                                                            biotop:RNAChain) ; 
                                                                               a owl:Class] ; 
                                                           owl:onProperty biotop:inheresIn ; 
                                                           a owl:Restriction]) ; 
                                       a owl:Class].
biotop:EpithelialCell a owl:Class;
                      rdfs:label "epithelial cell";
                      rdfs:subClassOf biotop:CellByTypePartition.
biotop:EscherichiaColiCell a owl:Class;
                           rdfs:label "escherichia coli cell";
                           rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                                    [owl:someValuesFrom biotop:SpeciesEscherichiaColiValueRegion ; 
                                                                                    owl:onProperty biotop:qualityLocated ; 
