                rdfs:label "RNA chain";
                rdfs:subClassOf biotop:ChainOfNucleotideMonomers.
biotop:Radiation <http://purl.org/imbi/ru-meta.owl#definition> "process in which energy-rich particles or electromagnetic waves participate";
