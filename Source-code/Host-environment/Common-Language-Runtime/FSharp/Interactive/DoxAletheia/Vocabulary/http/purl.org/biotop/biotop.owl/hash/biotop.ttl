                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> biotop:hasParticipant ; 
                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
biotop:ReagentRole <http://purl.org/imbi/ru-meta.owl#definition> "A role a chemical plays as participant in a chemical reation";
