@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix biotop: <http://purl.org/biotop/biotop.owl#>.
@prefix ru: <http://purl.org/imbi/ru-meta.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.

_:B0e8d55a0f2eb9b7db83f9b05c84da0da a owl:AllDisjointClasses;
                                    owl:members (biotop:ImmaterialThreeDimensionalPhysicalEntity
                                                 biotop:OneDimensionalPhysicalEntity
                                                 biotop:TwoDimensionalPhysicalEntity).
