                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      biotop:BiologicalSystemRole.
biotop:SocialAction <http://purl.org/imbi/ru-meta.owl#definition> "action that targets a population";
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "social action";
