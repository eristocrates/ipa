                                        biotop:Action.
biotop:PreventiveRole <http://purl.org/imbi/ru-meta.owl#definition> "The role an action plays if it is intended to protect an organism against negative external influences.";
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "preventive role";
                      rdfs:subClassOf biotop:HealthRelatedRole.
