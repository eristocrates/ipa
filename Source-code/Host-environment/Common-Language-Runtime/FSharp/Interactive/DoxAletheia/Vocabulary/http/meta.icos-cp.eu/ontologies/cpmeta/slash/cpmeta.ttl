ccrel:license a owl:AnnotationProperty.
cpmeta: ccrel:license <https://creativecommons.org/publicdomain/zero/1.0/>;
        dc11:creator <http://meta.icos-cp.eu/resources/people/Oleg%20Mirzov>;
        dc11:description "OWL vocabulary describing metadata of two environmental research infrastructures: ICOS and SITES"@en;
        dc11:issued "2015-05-18"^^xsd:date;
        dc11:modified "2023-01-24"^^xsd:date;
        dc11:publisher <http://meta.icos-cp.eu/resources/organizations/CP>;
        dc11:rights "Copyright © 2023 ICOS ERIC";
        dc11:title "Ontology of Integrated Carbon Observation System (ICOS)"@en;
        vann:preferredNamespacePrefix "cpmeta";
        vann:preferredNamespaceUri "http://meta.icos-cp.eu/ontologies/cpmeta/";
        a owl:Ontology,
          voaf:Vocabulary;
        owl:versionInfo 1.0.
cpmeta:AS a owl:Class;
          rdfs:label "Atmospheric station";
          rdfs:subClassOf [owl:onProperty cpmeta:belongsToTheNetworkOf ; 
                           owl:hasValue <http://meta.icos-cp.eu/resources/organizations/ATC> ; 
                           a owl:Restriction],
                          cpmeta:IcosStation.
cpmeta:AncillaryDatum a owl:Class;
                      owl:disjointUnionOf (cpmeta:AncillaryEntry
                                           cpmeta:AncillaryValue).
cpmeta:AncillaryEntry a owl:Class;
                      rdfs:comment "contains the ancillary value(s), submission date, and optional information date";
                      rdfs:label "Ancillary Entry";
                      rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dcterms:dateSubmitted ; 
                                       owl:onDataRange xsd:dateTime ; 
                                       a owl:Restriction],
                                      cpmeta:AncillaryDatum.
cpmeta:AncillaryValue a owl:Class;
                      rdfs:comment "the class of ancillary values coming from controlled vocabularies";
                      rdfs:label "Ancillary Value";
                      rdfs:subClassOf cpmeta:AncillaryDatum.
cpmeta:AtmoStation a owl:Class;
                   rdfs:label "ATMO station";
                   rdfs:subClassOf cpmeta:Station.
cpmeta:CentralFacility a owl:Class;
                       rdfs:label "Central Facility";
                       rdfs:subClassOf cpmeta:Organization.
cpmeta:ClimateZone a owl:Class;
                   rdfs:label "Climate Zone".
cpmeta:Collection a owl:Class;
                  rdfs:subClassOf [owl:onProperty cpmeta:isNextVersionOf ; 
                                   owl:allValuesFrom cpmeta:Collection ; 
                                   a owl:Restriction],
                                  [owl:onProperty dcterms:hasPart ; 
                                   owl:allValuesFrom [owl:unionOf (cpmeta:Collection
                                                                   cpmeta:DataObject) ; 
                                                      a owl:Class] ; 
                                   a owl:Restriction],
                                  [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dcterms:creator ; 
                                   owl:onClass cpmeta:Organization ; 
                                   a owl:Restriction],
                                  [owl:onProperty dcterms:description ; 
                                   owl:allValuesFrom xsd:string ; 
                                   a owl:Restriction],
                                  [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dcterms:title ; 
                                   owl:onDataRange xsd:string ; 
                                   a owl:Restriction],
                                  nsprov:Entity.
cpmeta:DataAcquisition a owl:Class;
                       rdfs:subClassOf [owl:someValuesFrom owl:Thing ; 
                                        owl:onProperty nsprov:wasAssociatedWith ; 
                                        a owl:Restriction],
                                       nsprov:Activity.
cpmeta:DataObject a owl:Class;
                  rdfs:subClassOf [owl:someValuesFrom owl:Thing ; 
                                   owl:onProperty cpmeta:hasObjectSpec ; 
                                   a owl:Restriction],
                                  [owl:onProperty cpmeta:isNextVersionOf ; 
                                   owl:allValuesFrom cpmeta:DataObject ; 
                                   a owl:Restriction],
                                  cpmeta:StaticObject.
cpmeta:DataObjectSpec a owl:Class;
                      rdfs:label "Data Object specification";
                      rdfs:subClassOf [owl:someValuesFrom owl:Thing ; 
                                       owl:onProperty cpmeta:hasAssociatedProject ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom owl:Thing ; 
                                       owl:onProperty cpmeta:hasDataTheme ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom owl:Thing ; 
                                       owl:onProperty cpmeta:hasEncoding ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom owl:Thing ; 
                                       owl:onProperty cpmeta:hasFormat ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom rdfs:Literal ; 
                                       owl:onProperty cpmeta:hasDataLevel ; 
                                       a owl:Restriction],
                                      cpmeta:DataObjectSpecifyingThing.
cpmeta:DataObjectSpecifyingThing a owl:Class.
cpmeta:DataProduction a owl:Class;
                      rdfs:subClassOf [owl:someValuesFrom owl:Thing ; 
                                       owl:onProperty cpmeta:wasPerformedBy ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom rdfs:Literal ; 
                                       owl:onProperty nsprov:endedAtTime ; 
                                       a owl:Restriction],
                                      nsprov:Activity.
cpmeta:DataSubmission a owl:Class;
                      rdfs:subClassOf [owl:someValuesFrom owl:Thing ; 
                                       owl:onProperty nsprov:wasAssociatedWith ; 
                                       a owl:Restriction],
                                      nsprov:Activity.
cpmeta:DataTheme a owl:Class;
                 rdfs:label "Data Theme";
                 rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty cpmeta:hasIcon ; 
                                  a owl:Restriction],
                                 cpmeta:DataObjectSpecifyingThing.
cpmeta:DatasetColumn a owl:Class;
                     rdfs:label "Dataset column";
                     rdfs:subClassOf [owl:someValuesFrom owl:Thing ; 
                                      owl:onProperty cpmeta:hasValueFormat ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom owl:Thing ; 
                                      owl:onProperty cpmeta:hasValueType ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom rdfs:Literal ; 
                                      owl:onProperty cpmeta:hasColumnTitle ; 
                                      a owl:Restriction],
                                     cpmeta:DataObjectSpecifyingThing.
cpmeta:DatasetSpec a owl:Class;
                   rdfs:label "Dataset Specification";
                   rdfs:subClassOf cpmeta:DataObjectSpecifyingThing.
cpmeta:DatasetVariable a owl:Class;
                       rdfs:label "Dataset variable";
                       rdfs:subClassOf [owl:someValuesFrom owl:Thing ; 
                                        owl:onProperty cpmeta:hasValueType ; 
                                        a owl:Restriction],
                                       [owl:someValuesFrom rdfs:Literal ; 
                                        owl:onProperty cpmeta:hasVariableTitle ; 
                                        a owl:Restriction],
                                       sosa:ObservableProperty.
cpmeta:DocumentObject a owl:Class;
                      rdfs:subClassOf [owl:onProperty cpmeta:isNextVersionOf ; 
                                       owl:allValuesFrom cpmeta:DocumentObject ; 
                                       a owl:Restriction],
                                      cpmeta:StaticObject.
cpmeta:ES a owl:Class;
          rdfs:label "Ecosystem station";
          rdfs:subClassOf [owl:onProperty cpmeta:belongsToTheNetworkOf ; 
                           owl:hasValue <http://meta.icos-cp.eu/resources/organizations/ETC> ; 
                           a owl:Restriction],
                          cpmeta:IcosStation.
cpmeta:EcosystemType a owl:Class;
                     rdfs:label "Ecosystem Type".
cpmeta:FluxnetStation a owl:Class;
                      rdfs:label "FLUXNET station";
                      rdfs:subClassOf cpmeta:Station.
cpmeta:Funder a owl:Class;
              rdfs:subClassOf cpmeta:Organization.
cpmeta:Funding a owl:Class;
               rdfs:subClassOf [owl:someValuesFrom cpmeta:Funder ; 
                                owl:onProperty cpmeta:hasFunder ; 
                                a owl:Restriction].
cpmeta:IcosStation a owl:Class;
                   rdfs:label "ICOS station";
                   rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                    owl:onProperty cpmeta:countryCode ; 
                                    a owl:Restriction],
                                   cpmeta:Station.
cpmeta:IngosStation a owl:Class;
                    rdfs:label "InGOS station";
                    rdfs:subClassOf cpmeta:Station.
cpmeta:Instrument a owl:Class;
                  rdfs:subClassOf [owl:onProperty cpmeta:hasInstrumentOwner ; 
                                   owl:onClass cpmeta:Organization ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   a owl:Restriction],
                                  [owl:onProperty cpmeta:hasVendor ; 
                                   owl:onClass cpmeta:Organization ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom rdfs:Literal ; 
                                   owl:onProperty cpmeta:hasModel ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom rdfs:Literal ; 
                                   owl:onProperty cpmeta:hasSerialNumber ; 
                                   a owl:Restriction],
                                  sosa:Sensor.
cpmeta:LatLonBox a owl:Class;
                 owl:equivalentClass [owl:intersectionOf (cpmeta:SpatialCoverage
                                                          [owl:someValuesFrom rdfs:Literal ; 
                                                          owl:onProperty cpmeta:hasEasternBound ; 
                                                          a owl:Restriction]
                                                          [owl:someValuesFrom rdfs:Literal ; 
                                                          owl:onProperty cpmeta:hasNorthernBound ; 
                                                          a owl:Restriction]
                                                          [owl:someValuesFrom rdfs:Literal ; 
                                                          owl:onProperty cpmeta:hasSouthernBound ; 
                                                          a owl:Restriction]
                                                          [owl:someValuesFrom rdfs:Literal ; 
                                                          owl:onProperty cpmeta:hasWesternBound ; 
                                                          a owl:Restriction]) ; 
                                      a owl:Class].
cpmeta:Membership a owl:Class;
                  rdfs:label "Membership";
                  rdfs:subClassOf [owl:someValuesFrom owl:Thing ; 
                                   owl:onProperty cpmeta:atOrganization ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom owl:Thing ; 
                                   owl:onProperty cpmeta:hasRole ; 
                                   a owl:Restriction].
cpmeta:NeonStation a owl:Class;
                   rdfs:label "NEON station";
                   rdfs:subClassOf cpmeta:Station.
cpmeta:OS a owl:Class;
          rdfs:label "Oceanic station";
          rdfs:subClassOf [owl:onProperty cpmeta:belongsToTheNetworkOf ; 
                           owl:hasValue <http://meta.icos-cp.eu/resources/organizations/OTC> ; 
                           a owl:Restriction],
                          cpmeta:IcosStation.
cpmeta:ObjectEncoding a owl:Class;
                      rdfs:subClassOf dcterms:FileFormat.
cpmeta:ObjectFormat a owl:Class;
                    rdfs:subClassOf dcterms:FileFormat.
cpmeta:Organization a owl:Class;
                    rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty cpmeta:hasName ; 
                                     a owl:Restriction],
                                    nsprov:Agent.
cpmeta:Person a owl:Class;
              rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                               owl:onProperty cpmeta:hasEmail ; 
                               a owl:Restriction],
                              [owl:someValuesFrom rdfs:Literal ; 
                               owl:onProperty cpmeta:hasFirstName ; 
                               a owl:Restriction],
                              [owl:someValuesFrom rdfs:Literal ; 
                               owl:onProperty cpmeta:hasLastName ; 
                               a owl:Restriction],
                              nsprov:Agent.
cpmeta:Position a owl:Class;
                rdfs:label "Position";
                rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                 owl:onProperty cpmeta:hasLatitude ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom rdfs:Literal ; 
                                 owl:onProperty cpmeta:hasLongitude ; 
                                 a owl:Restriction],
                                cpmeta:SpatialCoverage.
cpmeta:Project a owl:Class;
               rdfs:subClassOf cpmeta:DataObjectSpecifyingThing.
cpmeta:QuantityKind a owl:Class;
                    rdfs:comment "The kind of physical quantity, for example volume, length, concentration. Can be basic or derived, standard or non-standard. Implies an associated physical quantity dimension but does not have a fixed unit of measurement.";
                    rdfs:label "Quantity Kind";
                    rdfs:seeAlso qu:QuantityKind,
                                 <http://qudt.org/schema/qudt#QuantityKind>;
                    rdfs:subClassOf cpmeta:DataObjectSpecifyingThing.
cpmeta:Role a owl:Class.
cpmeta:SailDrone a owl:Class;
                 rdfs:label "Sail Drone";
                 rdfs:subClassOf cpmeta:Station.
cpmeta:SimpleDataObject a owl:Class;
                        owl:disjointWith cpmeta:SpatialDataObject;
                        owl:equivalentClass [owl:intersectionOf (cpmeta:DataObject
                                                                 [owl:someValuesFrom owl:Thing ; 
                                                                 owl:onProperty cpmeta:wasAcquiredBy ; 
                                                                 a owl:Restriction]
                                                                 [owl:onProperty cpmeta:hasObjectSpec ; 
                                                                 owl:allValuesFrom cpmeta:SimpleObjectSpec ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
cpmeta:SimpleObjectSpec a owl:Class;
                        rdfs:label "Simple Object specification";
                        rdfs:subClassOf [owl:onProperty cpmeta:containsDataset ; 
                                         owl:allValuesFrom cpmeta:TabularDatasetSpec ; 
                                         a owl:Restriction],
                                        [owl:onProperty cpmeta:containsDataset ; 
                                         owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                         a owl:Restriction],
                                        cpmeta:DataObjectSpec.
cpmeta:Site a owl:Class;
            rdfs:comment "Physical research site";
            rdfs:subClassOf [owl:onProperty geosparql:hasGeometry ; 
                             owl:allValuesFrom cpmeta:SpatialCoverage ; 
                             a owl:Restriction],
                            [owl:onProperty cpmeta:hasEcosystemType ; 
                             owl:onClass cpmeta:EcosystemType ; 
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                             a owl:Restriction],
                            geosparql:Feature.
cpmeta:SpatialCoverage a owl:Class;
                       rdfs:label "Spatial Coverage";
                       rdfs:subClassOf geosparql:Geometry.
cpmeta:SpatialDataObject a owl:Class;
                         owl:equivalentClass [owl:intersectionOf (cpmeta:DataObject
                                                                  [owl:someValuesFrom cpmeta:LatLonBox ; 
                                                                  owl:onProperty cpmeta:hasSpatialCoverage ; 
                                                                  a owl:Restriction]
                                                                  [owl:someValuesFrom owl:Thing ; 
                                                                  owl:onProperty cpmeta:wasProducedBy ; 
                                                                  a owl:Restriction]
                                                                  [owl:someValuesFrom rdfs:Literal ; 
                                                                  owl:onProperty cpmeta:hasEndTime ; 
                                                                  a owl:Restriction]
                                                                  [owl:someValuesFrom rdfs:Literal ; 
                                                                  owl:onProperty cpmeta:hasStartTime ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
cpmeta:StaticObject a owl:Class;
                    rdfs:subClassOf [owl:someValuesFrom owl:Thing ; 
                                     owl:onProperty cpmeta:wasSubmittedBy ; 
                                     a owl:Restriction],
                                    nsprov:Entity.
cpmeta:Station a owl:Class;
               rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                owl:onProperty cpmeta:hasStationId ; 
                                a owl:Restriction],
                               cpmeta:Organization.
cpmeta:StringVocabulary a owl:Class;
                        rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                         owl:onProperty cpmeta:containsString ; 
                                         a owl:Restriction],
                                        cpmeta:ValueFormat.
cpmeta:TabularDatasetSpec a owl:Class;
                          rdfs:label "Tabular Dataset Specification";
                          rdfs:subClassOf [owl:someValuesFrom owl:Thing ; 
                                           owl:onProperty cpmeta:hasColumn ; 
                                           a owl:Restriction],
                                          cpmeta:DatasetSpec.
cpmeta:ThematicCenter a owl:Class;
                      rdfs:label "Thematic Center";
                      rdfs:subClassOf cpmeta:CentralFacility;
                      owl:equivalentClass [owl:oneOf (<http://meta.icos-cp.eu/resources/organizations/ATC>
                                                      <http://meta.icos-cp.eu/resources/organizations/ETC>
                                                      <http://meta.icos-cp.eu/resources/organizations/OTC>
                                                      <https://meta.fieldsites.se/resources/organizations/SITES_SLU>) ; 
                                           a owl:Class].
cpmeta:ValueFormat a owl:Class;
                   rdfs:subClassOf cpmeta:DataObjectSpecifyingThing.
cpmeta:ValueType a owl:Class;
                 rdfs:comment "Domain-specific meaning of the values";
                 rdfs:label "Value Type";
                 rdfs:subClassOf skos:Concept.
cpmeta:VariableInfo a owl:Class;
                    rdfs:subClassOf cpmeta:DataObjectSpecifyingThing.
cpmeta:WdcggStation a owl:Class;
                    rdfs:label "WDCGG station";
                    rdfs:subClassOf cpmeta:Station.
cpmeta:asGeoJSON a owl:DatatypeProperty,
                   owl:FunctionalProperty;
                 rdfs:domain cpmeta:SpatialCoverage;
                 rdfs:label "GeoJSON representation";
                 rdfs:range xsd:string;
                 rdfs:subPropertyOf geosparql:hasSerialization.
cpmeta:asciiAtcProductTimeSer cpmeta:hasGoodFlagValue "O",
                                                      "R",
                                                      "U";
                              a owl:NamedIndividual,
                                cpmeta:ObjectFormat;
                              rdfs:comment "Semicolon-separated ASCII, with #-prefixed multi-line header";
                              rdfs:label "ICOS ATC time series".
cpmeta:asciiAtcTimeSer a owl:NamedIndividual,
                         cpmeta:ObjectFormat;
                       rdfs:label "ICOS ATC Raw time series".
cpmeta:asciiEtcHalfHourlyProductTimeSer cpmeta:hasGoodFlagValue "1",
                                                                "0";
                                        a owl:NamedIndividual,
                                          cpmeta:ObjectFormat;
                                        rdfs:comment "The first two columns are expected to be the beginning and the end of the averaging period in yyyyMMddHHmm format (no DST)";
                                        rdfs:label "ICOS ETC half-hourly product CSV";
                                        rdfs:seeAlso cpmeta:etcLocalDateTime.
cpmeta:asciiEtcRawTimeSer a owl:NamedIndividual,
                            cpmeta:ObjectFormat;
                          rdfs:label "Raw ASCII ETC station data".
cpmeta:asciiEtcTimeSer a owl:NamedIndividual,
                         cpmeta:ObjectFormat;
                       rdfs:label "Time series in ICOS Sweden format".
cpmeta:asciiOtcProductCsv cpmeta:hasGoodFlagValue "2",
                                                  "9";
                          a owl:NamedIndividual,
                            cpmeta:ObjectFormat;
                          rdfs:comment "Single-line comment, first column is UTC ISO-8601 timestamp, NaN for missing values, comma-separated.";
                          rdfs:label "ICOS OTC time series".
cpmeta:asciiOtcSocatTimeSer a owl:NamedIndividual,
                              cpmeta:ObjectFormat;
                            rdfs:label "Data in OTC/SOCAT TSV format".
cpmeta:asciiWdcggTimeSer a owl:NamedIndividual,
                           cpmeta:ObjectFormat;
                         rdfs:label "WDCGG gas mole fraction time series".
cpmeta:atOrganization a owl:FunctionalProperty,
                        owl:ObjectProperty;
                      rdfs:domain [owl:unionOf (cpmeta:Membership
                                                ssno:Deployment) ; 
                                   a owl:Class];
                      rdfs:label "at organization";
                      rdfs:range cpmeta:Organization.
cpmeta:awardNumber a owl:DatatypeProperty,
                     owl:FunctionalProperty;
                   rdfs:domain cpmeta:Funding;
                   rdfs:label "award number";
                   rdfs:range xsd:string;
                   rdfs:subPropertyOf cpmeta:fundingInfoProp.
cpmeta:awardTitle a owl:DatatypeProperty,
                    owl:FunctionalProperty;
                  rdfs:domain cpmeta:Funding;
                  rdfs:label "award title";
                  rdfs:range xsd:string;
                  rdfs:subPropertyOf cpmeta:fundingInfoProp.
cpmeta:awardURI a owl:DatatypeProperty,
                  owl:FunctionalProperty;
                rdfs:domain cpmeta:Funding;
                rdfs:label "award URI";
                rdfs:range xsd:anyURI;
                rdfs:subPropertyOf cpmeta:fundingInfoProp.
cpmeta:belongsToTheNetworkOf a owl:FunctionalProperty,
                               owl:ObjectProperty;
                             rdfs:domain cpmeta:Station;
                             rdfs:label "belongs to thematic center";
                             rdfs:range cpmeta:ThematicCenter.
cpmeta:binEtcRawTimeSer a owl:NamedIndividual,
                          cpmeta:ObjectFormat;
                        rdfs:label "Raw binary ETC station data".
cpmeta:bmpChar a owl:NamedIndividual,
                 cpmeta:ValueFormat;
               rdfs:comment "a character from the basic multilingual plane";
               rdfs:label "UTF-16 character".
cpmeta:broaderEcosystem a owl:ObjectProperty;
                        rdfs:domain cpmeta:EcosystemType;
                        rdfs:label "more general ecosystem";
                        rdfs:range cpmeta:EcosystemType;
                        rdfs:subPropertyOf skos:broader.
cpmeta:containsDataset a owl:ObjectProperty;
                       rdfs:domain cpmeta:DataObjectSpec;
                       rdfs:label "contains dataset";
                       rdfs:range cpmeta:DatasetSpec.
cpmeta:containsString a owl:DatatypeProperty;
                      rdfs:domain cpmeta:StringVocabulary;
                      rdfs:range xsd:string.
cpmeta:country a owl:DatatypeProperty,
                 owl:FunctionalProperty;
               rdfs:domain cpmeta:Station;
               rdfs:label "Country";
               rdfs:range xsd:string;
               rdfs:subPropertyOf cpmeta:hasStationSpecificParam.
cpmeta:countryCode a owl:DatatypeProperty,
                     owl:FunctionalProperty;
                   rdfs:comment "ISO 3166-1 alpha-2 country code";
                   rdfs:domain cpmeta:Station;
                   rdfs:label "country code";
                   rdfs:range [owl:withRestrictions ([xsd:pattern "^[A-Z]{2}$"]) ; 
                               owl:onDatatype xsd:string ; 
                               a rdfs:Datatype];
                   rdfs:seeAlso wikipedia:ISO_3166-1;
                   rdfs:subPropertyOf cpmeta:hasStationSpecificParam.
cpmeta:csvWithIso8601tsFirstCol a owl:NamedIndividual,
                                  cpmeta:ObjectFormat;
                                rdfs:label "CSV with ISO8601 timestamp as first column".
cpmeta:etcDate a owl:NamedIndividual,
                 cpmeta:ValueFormat;
               rdfs:label "d/m/yyyy".
cpmeta:etcLocalDateTime a owl:NamedIndividual,
                          cpmeta:ValueFormat;
                        rdfs:comment "Local dateTime timestamp without any daylight savings time adjustments, that is, local winter time.";
                        rdfs:label "yyyyMMddHHmm (no DST) (ICOS ETC)".
cpmeta:etcRawTimeSerMultiZip a owl:NamedIndividual,
                               cpmeta:ObjectFormat;
                             rdfs:label "Multi-file zip archive with ETC raw time series".
cpmeta:excel a owl:NamedIndividual,
               cpmeta:ObjectFormat;
             rdfs:label "Microsoft Excel (of unspecified structure)".
cpmeta:float32 a owl:NamedIndividual,
                 cpmeta:ValueFormat;
               rdfs:label "32-bit floating point value".
cpmeta:float64 a owl:NamedIndividual,
                 cpmeta:ValueFormat;
               rdfs:label "64-bit floating point value".
cpmeta:funderIdentifier a owl:DatatypeProperty,
                          owl:FunctionalProperty;
                        rdfs:domain cpmeta:Funder;
                        rdfs:label "funder identifier";
                        rdfs:range xsd:string;
                        rdfs:subPropertyOf cpmeta:fundingInfoProp.
cpmeta:funderIdentifierType a owl:DatatypeProperty,
                              owl:FunctionalProperty;
                            rdfs:domain cpmeta:Funder;
                            rdfs:label "funder identifier type";
