cpmeta:hasAncillaryObjectValue a owl:ObjectProperty;
                               rdfs:comment "parent property for ancillary value properties whose values come from controlled vocabularies";
                               rdfs:domain cpmeta:AncillaryEntry;
                               rdfs:label "ancillary object value";
                               rdfs:range cpmeta:AncillaryValue.
cpmeta:hasAssociatedProject a owl:FunctionalProperty,
