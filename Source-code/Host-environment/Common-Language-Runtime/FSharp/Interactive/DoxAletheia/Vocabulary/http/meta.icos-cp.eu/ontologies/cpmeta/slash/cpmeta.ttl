                                        a rdfs:Datatype];
                            rdfs:subPropertyOf cpmeta:fundingInfoProp.
cpmeta:fundingInfoProp a owl:DatatypeProperty.
cpmeta:gzipEncoding a owl:NamedIndividual,
                      cpmeta:ObjectEncoding;
                    rdfs:label "gzip".
cpmeta:hasActualColumnNames a owl:DatatypeProperty,
                              owl:FunctionalProperty;
                            rdfs:comment "Contains a JSON array with actual column names";
                            rdfs:domain cpmeta:SimpleDataObject;
                            rdfs:range xsd:string.
cpmeta:hasActualVariable a owl:ObjectProperty;
                         rdfs:domain cpmeta:DataObject;
                         rdfs:range cpmeta:VariableInfo.
cpmeta:hasAncillaryDataValue a owl:DatatypeProperty;
                             rdfs:comment "parent property for ancillary value properties whose values are plain literals (not from vocabularies)";
                             rdfs:domain cpmeta:AncillaryEntry;
                             rdfs:label "ancillary data value";
                             rdfs:range rdfs:Literal.
cpmeta:hasAncillaryEntry a owl:ObjectProperty;
                         rdfs:comment "ancillary entry associated with a station";
