                                  a owl:Restriction],
                                 [owl:allValuesFrom ha:Human ; 
                                  owl:onProperty ha:has_Actor ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty ha:has_Posture_name ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty ha:has_Actor ; 
                                  a owl:Restriction],
                                 [owl:allValuesFrom ha:integer ; 
                                  owl:onProperty ha:has_Posture_ID ; 
                                  a owl:Restriction],
                                 ha:Any.
