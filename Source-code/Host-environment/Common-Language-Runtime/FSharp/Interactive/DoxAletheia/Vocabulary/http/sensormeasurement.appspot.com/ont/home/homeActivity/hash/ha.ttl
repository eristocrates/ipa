                         a owl:Restriction],
                        [owl:allValuesFrom ha:string ; 
                         owl:onProperty ha:has_Day_of_week ; 
                         a owl:Restriction],
                        [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                         owl:onProperty ha:has_Day_of_week ; 
                         a owl:Restriction],
                        ha:Any,
                        [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                         owl:onProperty ha:has_Month ; 
                         a owl:Restriction],
                        [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                         owl:onProperty ha:has_date ; 
                         a owl:Restriction].
ha:Door a owl:Class;
        rdfs:label "Door";
        rdfs:subClassOf ha:Furniture.
ha:Drink a owl:Class;
         rdfs:label "Drink";
         rdfs:subClassOf ha:Food.
