@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix ha: <http://sensormeasurement.appspot.com/ont/home/homeActivity#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.

voaf:Vocabulary a owl:Class.
ha: ccrel:license <http://creativecommons.org/licenses/by/3.0/>;
    dc11:creator "Konlakorn Wongpatikseree";
    dc11:description "13 rules are described such as sweeping the floor, scrubbing the floor, making a coffee, cooking, eating or drinking, sleeping, working on a computer, taking a bath, watching tv, reading a book, sitting on the toilet, lying down relaxing, wash dishes. The ontology has been implemented with Ontology editor tool HOZO:OWL Export"@en;
    dc11:title "An ontology to detect activities in a smart home"@en;
    dcterms:issued "2014-04-02"^^xsd:date;
    dcterms:modified "2014-05-12"^^xsd:date;
    vann:preferredNamespacePrefix "homeActivity";
    vann:preferredNamespaceUri "http://sensormeasurement.appspot.com/ont/home/homeActivity#";
    a voaf:Vocabulary,
      owl:Ontology,
      owl:NamedIndividual;
    rdfs:seeAlso <http://saki.siit.tu.ac.th/acis2013/uploads_final/29__3557af91375c8a9aa3b6f92c3f9165af/A%20Context-aware%20Information%20in%20Smart%20Home%20for%20Health%20Recommendation%20Service%20based%20on%20CARE%20Architecture_Camera_Ready.pdf>,
                 "Location-based concept in activity log ontology for activity recognition in smart home domain. [Wongpatikseree et al. 2013]",
                 <http://link.springer.com/chapter/10.1007%2F978-3-642-37996-3_24#page-1>,
                 "A context aware information in smart home for health recommendation service based on care architecture. [Wongpatikseree et al. 2013] ";
    owl:versionInfo 0.1;
    status:term_status "Work in progress".
ha:ADL a owl:Class;
       rdfs:label "ADL";
       rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                        owl:onProperty ha:has_have_date ; 
                        a owl:Restriction],
                       [owl:allValuesFrom ha:string ; 
                        owl:onProperty ha:has_Time ; 
                        a owl:Restriction],
                       [owl:allValuesFrom ha:Date ; 
                        owl:onProperty ha:has_have_date ; 
                        a owl:Restriction],
                       [owl:allValuesFrom ha:Last_Activity ; 
                        owl:onProperty ha:has_Collect ; 
                        a owl:Restriction],
                       [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                        owl:onProperty ha:has_Collect ; 
                        a owl:Restriction],
                       [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                        owl:onProperty ha:has_Time ; 
                        a owl:Restriction],
                       ha:Any.
ha:Activity_Log a owl:Class;
                rdfs:label "Activity_Log";
                rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty ha:has_Time ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom ha:string ; 
                                 owl:onProperty ha:has_Time ; 
                                 a owl:Restriction],
                                ha:Any.
ha:Alcolhol a owl:Class;
            rdfs:label "Alcolhol";
            rdfs:subClassOf ha:Drink.
ha:Any a owl:Class;
       rdfs:label "Any".
ha:Bathroom a owl:Class;
            rdfs:label "Bathroom";
            rdfs:subClassOf ha:Location.
ha:Bathroom_Activity a owl:Class;
                     rdfs:label "Bathroom_Activity";
                     rdfs:subClassOf [owl:allValuesFrom ha:Bathroom ; 
                                      owl:onProperty ha:has_location ; 
                                      a owl:Restriction],
                                     [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty ha:has_location ; 
                                      a owl:Restriction],
                                     ha:Location_based_Activity.
ha:Bed a owl:Class;
       rdfs:label "Bed";
       rdfs:subClassOf ha:Furniture.
ha:Bedroom a owl:Class;
           rdfs:label "Bedroom";
