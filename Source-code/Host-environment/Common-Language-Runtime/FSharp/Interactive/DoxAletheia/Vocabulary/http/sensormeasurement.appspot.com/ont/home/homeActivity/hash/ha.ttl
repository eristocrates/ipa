                                        owl:onProperty ha:has_name ; 
                                        a owl:Restriction],
                                       [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty ha:has_id ; 
                                        a owl:Restriction],
                                       [owl:allValuesFrom ha:integer ; 
                                        owl:onProperty ha:has_id ; 
                                        a owl:Restriction],
                                       ha:Any.
