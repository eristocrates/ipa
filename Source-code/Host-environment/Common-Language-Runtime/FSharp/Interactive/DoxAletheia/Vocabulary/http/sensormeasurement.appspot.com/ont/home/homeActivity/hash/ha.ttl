                                     owl:onProperty ha:has_location ; 
                                     a owl:Restriction],
                                    [owl:allValuesFrom ha:Bedroom ; 
                                     owl:onProperty ha:has_location ; 
                                     a owl:Restriction],
                                    ha:Location_based_Activity.
ha:Book a owl:Class;
        rdfs:label "Book";
