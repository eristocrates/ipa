ha:Bottle a owl:Class;
          rdfs:label "Bottle";
          rdfs:subClassOf ha:Furniture.
ha:Broom a owl:Class;
         rdfs:label "Broom";
         rdfs:subClassOf ha:Furniture.
ha:Chair a owl:Class;
         rdfs:label "Chair";
         rdfs:subClassOf ha:Furniture.
ha:Coffee a owl:Class;
          rdfs:label "Coffee";
          rdfs:subClassOf ha:Drink.
ha:Computer a owl:Class;
            rdfs:label "Computer";
            rdfs:subClassOf ha:Entertainment.
ha:Context a owl:Class;
           rdfs:label "Context";
           rdfs:subClassOf [owl:allValuesFrom ha:Date ; 
                            owl:onProperty ha:has_have_date ; 
                            a owl:Restriction],
                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty ha:has_have_sensor ; 
                            a owl:Restriction],
                           [owl:allValuesFrom ha:Sensor ; 
                            owl:onProperty ha:has_have_sensor ; 
                            a owl:Restriction],
                           [owl:allValuesFrom ha:Human_Posture ; 
                            owl:onProperty ha:has_have_hum_pos ; 
                            a owl:Restriction],
                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty ha:has_have_inf_activity ; 
                            a owl:Restriction],
                           [owl:allValuesFrom ha:Last_Object ; 
                            owl:onProperty ha:has_have_last_object ; 
                            a owl:Restriction],
                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty ha:has_have_last_activity ; 
                            a owl:Restriction],
                           ha:Any,
                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty ha:has_have_date ; 
                            a owl:Restriction],
                           [owl:allValuesFrom ha:integer ; 
                            owl:onProperty ha:has_Context_ID ; 
                            a owl:Restriction],
                           [owl:allValuesFrom ha:Last_Activity ; 
                            owl:onProperty ha:has_have_last_activity ; 
                            a owl:Restriction],
                           [owl:allValuesFrom ha:string ; 
                            owl:onProperty ha:has_have_time ; 
                            a owl:Restriction],
                           [owl:allValuesFrom ha:ObjectInstance ; 
                            owl:onProperty ha:has_have_obj ; 
                            a owl:Restriction],
                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty ha:has_Context_ID ; 
                            a owl:Restriction],
                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty ha:has_have_last_object ; 
                            a owl:Restriction],
                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty ha:has_have_obj ; 
                            a owl:Restriction],
                           [owl:allValuesFrom ha:InferredActivity ; 
                            owl:onProperty ha:has_have_inf_activity ; 
                            a owl:Restriction],
                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty ha:has_have_hum_pos ; 
                            a owl:Restriction],
                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty ha:has_have_time ; 
                            a owl:Restriction].
ha:Cooking a owl:Class;
           rdfs:label "Cooking";
           rdfs:subClassOf [owl:allValuesFrom ha:Electric_Stove ; 
                            owl:onProperty ha:has_use ; 
