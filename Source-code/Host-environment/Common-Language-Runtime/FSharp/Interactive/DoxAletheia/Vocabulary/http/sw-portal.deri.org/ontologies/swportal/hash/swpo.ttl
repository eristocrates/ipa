                                        <http://purl.org/dc/elements/1.1/description> """\"A project this person has previously worked on.\" NOTE: foaf defines the range as <link>foaf:Person</link> - we decided to change this to the more general <link>foaf:Agent</link>, since other types of Agents (e.g. a company) can also have projects."""@en;
                                        <http://purl.org/dc/elements/1.1/format> "application/rdf+xml";
