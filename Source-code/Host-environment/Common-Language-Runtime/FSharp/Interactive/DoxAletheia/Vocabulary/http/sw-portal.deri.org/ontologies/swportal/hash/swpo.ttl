<http://xmlns.com/foaf/0.1/mbox> <http://purl.org/dc/elements/1.1/contributor> "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
                                                                               "http://www.w3.org/RDF/Interest/";
                                 <http://purl.org/dc/elements/1.1/coverage> "world";
                                 <http://purl.org/dc/elements/1.1/creator> "Libby Miller",
                                                                           "Dan Brickley";
                                 <http://purl.org/dc/elements/1.1/description> """\"A personal mailbox, i.e. an internet mailbox associated with exactly one owner, the first owner of this mailbox. This is a 'static inverse functional property', in that there is (across time and change) at most one individual that ever has any particular value for <link>foaf:mbox</link>.\" Because we switched over to OWL Lite– ,we don’t have functional properties anymore. However, we recommend to the users of this ontology to apply this property like it is described in the FOAF specification."""@en;
                                 <http://purl.org/dc/elements/1.1/format> "application/rdf+xml";
                                 <http://purl.org/dc/elements/1.1/publisher> "Dan Brickley",
                                                                             "Libby Miller";
                                 <http://purl.org/dc/elements/1.1/title> "Email"@en;
                                 <http://purl.org/dc/elements/1.1/type> "http://www.w3.org/2002/07/owl#ObjectProperty";
                                 a <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>,
                                   <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment """\"A personal mailbox, i.e. an internet mailbox associated with exactly one owner, the first owner of this mailbox. This is a 'static inverse functional property', in that there is (across time and change) at most one individual that ever has any particular value for <link>foaf:mbox</link>.\" Because we switched over to OWL Lite– ,we don’t have functional properties anymore. However, we recommend to the users of this ontology to apply this property like it is described in the FOAF specification.""";
                                 rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
                                 rdfs:label "Email"@en;
                                 rdfs:range rdfs:Literal.
<http://xmlns.com/foaf/0.1/member> <http://purl.org/dc/elements/1.1/contributor> "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
