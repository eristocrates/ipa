                                      a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                        <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                      rdfs:comment """\"The first name of a person.\" NOTE: the naming substructure of foaf is currently quite unstable.""";
                                      rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                                      rdfs:label "First Name"@en;
                                      rdfs:range xsd:string.
<http://xmlns.com/foaf/0.1/knows> <http://purl.org/dc/elements/1.1/contributor> "http://www.w3.org/RDF/Interest/",
