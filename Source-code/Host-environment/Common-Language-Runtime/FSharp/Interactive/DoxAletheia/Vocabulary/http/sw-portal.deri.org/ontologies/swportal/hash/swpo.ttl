swpo:Inbook dc11:coverage "world";
            dc11:creator "DERI International";
            dc11:date "2004-10-20";
            dc11:description "A part of a Book, which may be a chapter (or section or whatever) and/or a range of pages. Because the BibTex types inCollection and inBook are very similiar, we decided to keep the ontology as simple as possible and merge them both into <link>Inbook</link>."@en;
            dc11:format "application/rdf+xml";
            dc11:publisher "DERI International";
            dc11:rights "http://www.deri.org/privacy.html";
            dc11:title "Inbook"@en;
            dc11:type "http://www.w3.org/2000/01/rdf-schema#Class";
            a owl:Class;
            rdfs:comment "A part of a Book, which may be a chapter (or section or whatever) and/or a range of pages. Because the BibTex types inCollection and inBook are very similiar, we decided to keep the ontology as simple as possible and merge them both into <link>Inbook</link>.";
            rdfs:label "Inbook"@en;
            rdfs:subClassOf foaf:Document.
swpo:IndividualPublication dc11:coverage "world";
                           dc11:creator "DERI International";
                           dc11:date "2004-10-20";
                           dc11:description "The instances of this class comprise all publications which have a specific publication date. If a publication P is contained within an <link>PublicationContainer</link>, and this container has a publication date, than P is not an <link>IndividualPublication</link>. Example: an <link>Inbook</link> publication is not an <link>IndividualPublication</link>, because its publication date can be inferred from the <link>Book</link> which contains it."@en;
                           dc11:format "application/rdf+xml";
                           dc11:publisher "DERI International";
                           dc11:rights "http://www.deri.org/privacy.html";
                           dc11:title "Dated Publication"@en;
                           dc11:type "http://www.w3.org/2002/07/owl#Class";
                           a owl:Class;
                           rdfs:comment "The instances of this class comprise all publications which have a specific publication date. If a publication P is contained within an <link>PublicationContainer</link>, and this container has a publication date, than P is not an <link>IndividualPublication</link>. Example: an <link>Inbook</link> publication is not an <link>IndividualPublication</link>, because its publication date can be inferred from the <link>Book</link> which contains it.";
                           rdfs:label "Dated Publication"@en;
                           rdfs:subClassOf foaf:Document.
