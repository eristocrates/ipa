                                                                             "Libby Miller";
                                   <http://purl.org/dc/elements/1.1/description> """\"Indicates a member of a Group.\" This property relates a set of agents to a group. These are the members of that group."""@en;
                                   <http://purl.org/dc/elements/1.1/format> "application/rdf+xml";
                                   <http://purl.org/dc/elements/1.1/publisher> "Libby Miller",
