                                        rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
                                        rdfs:label "Past Project"@en;
                                        rdfs:range <http://xmlns.com/foaf/0.1/Project>.
<http://xmlns.com/foaf/0.1/phone> <http://purl.org/dc/elements/1.1/contributor> "http://www.w3.org/RDF/Interest/",
                                                                                "http://rdfweb.org/mailman/listinfo/rdfweb-dev";
                                  <http://purl.org/dc/elements/1.1/coverage> "world";
                                  <http://purl.org/dc/elements/1.1/creator> "Libby Miller",
                                                                            "Dan Brickley";
                                  <http://purl.org/dc/elements/1.1/description> """\"The foaf:phone of something is a phone, typically identified using the tel: URI  scheme.\" The tel: URI scheme is defined in http://www.ietf.org/rfc/rfc2806.txt."""@en;
                                  <http://purl.org/dc/elements/1.1/format> "application/rdf+xml";
