                rdfs:comment "An initiative is a group which has specific aims. It differs from <link>foaf:Project</link> in that it normally doesn’t have any funding. Often, its duration is longer.";
                rdfs:label "Initiative"@en;
                rdfs:subClassOf swpo:TemporaryGroup.
