                                      <http://purl.org/dc/elements/1.1/description> """\"The first name of a person.\" NOTE: the naming substructure of foaf is currently quite unstable."""@en;
                                      <http://purl.org/dc/elements/1.1/format> "application/rdf+xml";
                                      <http://purl.org/dc/elements/1.1/publisher> "Dan Brickley",
