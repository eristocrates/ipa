swpo:onPages dc11:coverage "world";
             dc11:creator "DERI International";
             dc11:date "2004-10-20";
             dc11:description "One or more page numbers or range of numbers, such as 42--111 or 7,41,73--97 or 43+ (the `+' in this last example indicates pages following that don't form a simple range). To make it easier to maintain Scribe-compatible databases, the standard styles convert a single dash (as in 7-33) to the double dash used in TeX to denote number ranges (as in 7--33)."@en;
             dc11:format "application/rdf+xml";
             dc11:publisher "DERI International";
             dc11:rights "http://www.deri.org/privacy.html";
             dc11:title "Pages"@en;
             dc11:type "http://www.w3.org/2002/07/owl#DatatypeProperty";
             a owl:FunctionalProperty,
               owl:DatatypeProperty;
             rdfs:comment "One or more page numbers or range of numbers, such as 42--111 or 7,41,73--97 or 43+ (the `+' in this last example indicates pages following that don't form a simple range). To make it easier to maintain Scribe-compatible databases, the standard styles convert a single dash (as in 7-33) to the double dash used in TeX to denote number ranges (as in 7--33).";
             rdfs:domain [owl:unionOf (swpo:Inbook
                                       swpo:Inproceedings
                                       swpo:Article) ; 
                          a owl:Class];
             rdfs:label "Pages"@en;
             rdfs:range xsd:nonNegativeInteger.
swpo:organizedby dc11:coverage "world";
                 dc11:creator "DERI International";
                 dc11:date "2004-10-20";
                 dc11:description "The organizers of an event. At least one agent has to organize an event. The inverse property is <link>organizes</link>."@en;
                 dc11:format "application/rdf+xml";
                 dc11:publisher "DERI International";
                 dc11:rights "http://www.deri.org/privacy.html";
                 dc11:title "Organized by"@en;
                 dc11:type "http://www.w3.org/2002/07/owl#ObjectProperty";
                 a owl:ObjectProperty;
                 rdfs:comment "The organizers of an event. At least one agent has to organize an event. The inverse property is <link>organizes</link>.";
                 rdfs:domain swpo:Event;
                 rdfs:label "Organized by"@en;
                 rdfs:range foaf:Agent;
                 owl:inverseOf swpo:organizes.
swpo:organizes dc11:coverage "world";
               dc11:creator "DERI International";
               dc11:date "2004-10-20";
               dc11:description "This property relates an agent to the events it organizes. The inverse property is <link>organizedBy</link>."@en;
               dc11:format "application/rdf+xml";
               dc11:publisher "DERI International";
               dc11:rights "http://www.deri.org/privacy.html";
               dc11:title "Organizes"@en;
               dc11:type "http://www.w3.org/2002/07/owl#ObjectProperty";
               a owl:ObjectProperty;
               rdfs:comment "This property relates an agent to the events it organizes. The inverse property is <link>organizedBy</link>.";
               rdfs:domain foaf:Agent;
               rdfs:label "Organizes"@en;
               rdfs:range swpo:Event;
               owl:inverseOf swpo:organizedby.
swpo:publishedBy dc11:coverage "world";
                 dc11:creator "DERI International";
                 dc11:date "2004-10-20";
                 dc11:description "The instance of <link>Publisher</link> which published this document."@en;
                 dc11:format "application/rdf+xml";
                 dc11:publisher "DERI International";
                 dc11:rights "http://www.deri.org/privacy.html";
                 dc11:title "Publisher"@en;
                 dc11:type "http://www.w3.org/2002/07/owl#FunctionalProperty";
                 a owl:ObjectProperty,
                   owl:FunctionalProperty;
                 rdfs:comment "The instance of <link>Publisher</link> which published this document.";
                 rdfs:domain [owl:unionOf (swpo:Proceedings
                                           swpo:Book) ; 
                              a owl:Class];
                 rdfs:label "Publisher"@en;
                 rdfs:range swpo:PublishingCompany.
<http://www.wsmo.org/ontologies/dateTime#date> dc11:coverage "world";
                                               dc11:creator "Jos de Bruin",
                                                            "Holger Lausen",
                                                            "DERI International";
                                               dc11:description """\"Concept date and its representation according to the Gregorian Calendar.\" For the excat definition of this class, please refere to <link>http://www.wsmo.org/2004/d3/d3.3/v0.1/</link>."""@en;
                                               dc11:format "application/rdf+xml";
                                               dc11:publisher "Holger Lausen",
                                                              "Jos de Bruin",
                                                              "DERI International";
                                               dc11:rights "http://www.deri.org/privacy.html";
                                               dc11:type "http://www.w3.org/2000/01/rdf-schema#Class";
                                               a owl:Class;
                                               rdfs:comment """\"Concept date and its representation according to the Gregorian Calendar.\" For the excat definition of this class, please refere to <link>http://www.wsmo.org/2004/d3/d3.3/v0.1/</link>.""".
<http://www.wsmo.org/ontologies/dateTime#interval> dc11:coverage "world";
                                                   dc11:creator "Jos de Bruin",
                                                                "DERI International",
                                                                "Holger Lausen";
                                                   dc11:description """\"An interval represents a duration between 2 points in time.\" For the excat definition of this class, please refere to <link>http://www.wsmo.org/2004/d3/d3.3/v0.1/</link>."""@en;
                                                   dc11:format "application/rdf+xml";
                                                   dc11:publisher "DERI International",
                                                                  "Holger Lausen",
                                                                  "Jos de Bruin";
                                                   dc11:rights "http://www.deri.org/privacy.html";
                                                   dc11:type "http://www.w3.org/2000/01/rdf-schema#Class";
                                                   a owl:Class;
                                                   rdfs:comment """\"An interval represents a duration between 2 points in time.\" For the excat definition of this class, please refere to <link>http://www.wsmo.org/2004/d3/d3.3/v0.1/</link>.""".
<http://www.wsmo.org/ontologies/dateTime#time> dc11:coverage "world";
                                               dc11:creator "DERI International",
                                                            "Jos de Bruin",
                                                            "Holger Lausen";
                                               dc11:description "A specific point in time during any arbitrary day. For the excat definition of this class, please refere to <link>http://www.wsmo.org/2004/d3/d3.3/v0.1/</link>."@en;
                                               dc11:format "application/rdf+xml";
                                               dc11:publisher "Jos de Bruin",
                                                              "Holger Lausen",
                                                              "DERI International";
                                               dc11:rights "http://www.deri.org/privacy.html";
                                               dc11:type "http://www.w3.org/2000/01/rdf-schema#Class";
                                               a owl:Class;
                                               rdfs:comment "A specific point in time during any arbitrary day. For the excat definition of this class, please refere to <link>http://www.wsmo.org/2004/d3/d3.3/v0.1/</link>.".
foaf:Agent dc11:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
                            "http://www.w3.org/RDF/Interest/";
           dc11:coverage "world";
           dc11:creator "Dan Brickley",
                        "Libby Miller";
           dc11:description """\"An agent (e.g. person, group, software or physical artifact).\"  NOTE: We adopted this concept partially from the FOAF ontology. However, in our ontology the agent concept does not comprise the subclasses software and physical artifact. We decided to introduce this main concept in order to make the range of e.g. the attribute authors of a publication more general."""@en;
           dc11:format "application/rdf+xml";
           dc11:publisher "Dan Brickley",
                          "Libby Miller";
           dc11:title "Agent"@en;
           dc11:type "http://www.w3.org/2000/01/rdf-schema#Class";
           a owl:Class;
           rdfs:comment """\"An agent (e.g. person, group, software or physical artifact).\"  NOTE: We adopted this concept partially from the FOAF ontology. However, in our ontology the agent concept does not comprise the subclasses software and physical artifact. We decided to introduce this main concept in order to make the range of e.g. the attribute authors of a publication more general.""";
           rdfs:label "Agent"@en.
foaf:Document dc11:contributor "http://www.w3.org/RDF/Interest/",
                               "http://rdfweb.org/mailman/listinfo/rdfweb-dev";
              dc11:coverage "world";
              dc11:creator "Dan Brickley",
                           "Libby Miller";
              dc11:description """Similar to the Agent concept, we have again decided to include a concept from the popular FOAF ontology. The FOAF Vocabulary Specification currently defines Document in a very loose way: \"The <link>foaf:Document</link> class represents those things which are, broadly conceived, 'documents'. ... We do not (currently) distinguish between physical and electronic documents, or between copies of a work and the abstraction those copies embody.\"
The intended use of this concept within the SWPortal ontology is to subsume everything that contains some sort of information and has been produced by some <link>foaf:Agent</link> An instance of Document can either refer to an electronic or physical thing, as long as it is adressable by means of a URI. Examples are a book written, or a picture taken by a person, but also a log file generated by a machine."""@en;
              dc11:format "application/rdf+xml";
              dc11:publisher "Libby Miller",
                             "Dan Brickley";
              dc11:title "Document"@en;
              dc11:type "http://www.w3.org/2000/01/rdf-schema#Class";
              a owl:Class;
              rdfs:comment """Similar to the Agent concept, we have again decided to include a concept from the popular FOAF ontology. The FOAF Vocabulary Specification currently defines Document in a very loose way: \"The <link>foaf:Document</link> class represents those things which are, broadly conceived, 'documents'. ... We do not (currently) distinguish between physical and electronic documents, or between copies of a work and the abstraction those copies embody.\"
The intended use of this concept within the SWPortal ontology is to subsume everything that contains some sort of information and has been produced by some <link>foaf:Agent</link> An instance of Document can either refer to an electronic or physical thing, as long as it is adressable by means of a URI. Examples are a book written, or a picture taken by a person, but also a log file generated by a machine.""";
              rdfs:label "Document"@en;
              rdfs:subClassOf swpo:Publication.
foaf:Group dc11:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
                            "http://www.w3.org/RDF/Interest/";
           dc11:coverage "world";
           dc11:creator "Libby Miller",
                        "Dan Brickley";
           dc11:description """\"A class of Agents. The foaf:Group classs represents a collection of individual agents (and may itself play the role of a <link>foaf:Agent</link>, i.e. something that can perform actions).\""""@en;
           dc11:format "application/rdf+xml";
           dc11:publisher "Libby Miller",
                          "Dan Brickley";
           dc11:title "Group"@en;
           dc11:type "http://www.w3.org/2000/01/rdf-schema#Class";
           a owl:Class;
           rdfs:comment """\"A class of Agents. The foaf:Group classs represents a collection of individual agents (and may itself play the role of a <link>foaf:Agent</link>, i.e. something that can perform actions).\"""";
           rdfs:label "Group"@en;
           rdfs:subClassOf foaf:Agent.
foaf:Organization dc11:contributor "http://www.w3.org/RDF/Interest/",
                                   "http://rdfweb.org/mailman/listinfo/rdfweb-dev";
                  dc11:coverage "world";
                  dc11:creator "Dan Brickley",
                               "Libby Miller";
                  dc11:description """\"The foaf:Organization class represents a kind of foaf:Agent corresponding to social institutions such as companies, societies, etc.\" As we consider an organization to be a group as well, we introduced a subclass <link>Organization</link> as a subclass of both <link>foaf:Organization</link> and <link>foaf:Group</link>. We added <link>foaf:Organization</link> to facilitate FOAF based agents to query our ontology."""@en;
                  dc11:format "application/rdf+xml";
                  dc11:publisher "Dan Brickley",
                                 "Libby Miller";
                  dc11:title ""@en;
                  dc11:type "http://www.w3.org/2000/01/rdf-schema#Class";
                  a owl:Class;
                  rdfs:comment """\"The foaf:Organization class represents a kind of foaf:Agent corresponding to social institutions such as companies, societies, etc.\" As we consider an organization to be a group as well, we introduced a subclass <link>Organization</link> as a subclass of both <link>foaf:Organization</link> and <link>foaf:Group</link>. We added <link>foaf:Organization</link> to facilitate FOAF based agents to query our ontology.""";
                  rdfs:label ""@en;
                  rdfs:subClassOf foaf:Agent.
foaf:Person dc11:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
                             "http://www.w3.org/RDF/Interest/";
            dc11:coverage "world";
            dc11:creator "Dan Brickley",
                         "Libby Miller";
            dc11:description """\"A person. The foaf:Person class represents people. Something is a foaf:Person if it is a person. We don't nitpick about whether they're alive, dead, real or imaginary.\""""@en;
            dc11:format "application/rdf+xml";
            dc11:publisher "Libby Miller",
                           "Dan Brickley";
            dc11:title "Person"@en;
            dc11:type "http://www.w3.org/2000/01/rdf-schema#Class";
            a owl:Class;
            rdfs:comment """\"A person. The foaf:Person class represents people. Something is a foaf:Person if it is a person. We don't nitpick about whether they're alive, dead, real or imaginary.\"""";
            rdfs:label "Person"@en;
            rdfs:subClassOf foaf:Agent.
foaf:Project dc11:contributor "http://www.w3.org/RDF/Interest/",
                              "http://rdfweb.org/mailman/listinfo/rdfweb-dev";
             dc11:coverage "world";
             dc11:creator "Dan Brickley",
                          "Libby Miller";
             dc11:description """\"A project (a collective endeavour of some kind).\" Within the context of the SWPortal Ontology we specify <link>foaf:Project</link> as such: A project is an endeavour of a group which has a specific aim. As a project can also be individualized and can publish documents and the like, we model it as a subclass of foaf:Agent. It has members and inherits all properties of <link>foaf:Agent</link> and <link>foaf:Group</link>. Also, projects are usually funded."""@en;
             dc11:format "application/rdf+xml";
             dc11:publisher "Libby Miller",
                            "Dan Brickley";
             dc11:title "Project"@en;
             dc11:type "http://www.w3.org/2000/01/rdf-schema#Class";
             a owl:Class;
             rdfs:comment """\"A project (a collective endeavour of some kind).\" Within the context of the SWPortal Ontology we specify <link>foaf:Project</link> as such: A project is an endeavour of a group which has a specific aim. As a project can also be individualized and can publish documents and the like, we model it as a subclass of foaf:Agent. It has members and inherits all properties of <link>foaf:Agent</link> and <link>foaf:Group</link>. Also, projects are usually funded.""";
             rdfs:label "Project"@en;
             rdfs:subClassOf swpo:TemporaryGroup.
foaf:currentProject dc11:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
                                     "http://www.w3.org/RDF/Interest/";
                    dc11:coverage "world";
                    dc11:creator "Dan Brickley",
                                 "Libby Miller";
                    dc11:description """\"A current project this person works on.\" NOTE: FOAF defines the range as <link>foaf:Person</link> - we decided to change this to the more general <link>foaf:Agent</link>, since other types of Agents (e.g. a company) can also have projects.
We have also defined an inverse for this property (see <link>drivenBy</link>)."""@en;
                    dc11:format "application/rdf+xml";
                    dc11:publisher "Libby Miller",
                                   "Dan Brickley";
                    dc11:title "Current Project"@en;
                    dc11:type "http://www.w3.org/2002/07/owl#ObjectProperty";
                    a owl:ObjectProperty;
                    rdfs:comment """\"A current project this person works on.\" NOTE: FOAF defines the range as <link>foaf:Person</link> - we decided to change this to the more general <link>foaf:Agent</link>, since other types of Agents (e.g. a company) can also have projects.
We have also defined an inverse for this property (see <link>drivenBy</link>).""";
                    rdfs:domain foaf:Agent;
                    rdfs:label "Current Project"@en;
                    rdfs:range foaf:Project;
                    owl:inverseOf swpo:drivenBy.
foaf:firstName dc11:contributor "http://www.w3.org/RDF/Interest/",
                                "http://rdfweb.org/mailman/listinfo/rdfweb-dev";
               dc11:coverage "world";
               dc11:creator "Libby Miller",
                            "Dan Brickley";
               dc11:description """\"The first name of a person.\" NOTE: the naming substructure of foaf is currently quite unstable."""@en;
               dc11:format "application/rdf+xml";
               dc11:publisher "Dan Brickley",
                              "Libby Miller";
               dc11:title "First Name"@en;
               dc11:type "http://www.w3.org/2002/07/owl#DatatypeProperty";
               a owl:FunctionalProperty,
                 owl:DatatypeProperty;
               rdfs:comment """\"The first name of a person.\" NOTE: the naming substructure of foaf is currently quite unstable.""";
               rdfs:domain foaf:Person;
               rdfs:label "First Name"@en;
               rdfs:range xsd:string.
foaf:knows dc11:contributor "http://www.w3.org/RDF/Interest/",
                            "http://rdfweb.org/mailman/listinfo/rdfweb-dev";
           dc11:coverage "world";
           dc11:creator "Dan Brickley",
                        "Libby Miller";
           dc11:description """\"A person known by this person (indicating some level of reciprocated interaction between the parties).\""""@en;
           dc11:format "application/rdf+xml";
           dc11:publisher "Libby Miller",
                          "Dan Brickley";
           dc11:title "Knows"@en;
           dc11:type "http://www.w3.org/2002/07/owl#ObjectProperty";
           a owl:ObjectProperty;
           rdfs:comment """\"A person known by this person (indicating some level of reciprocated interaction between the parties).\"""";
           rdfs:domain foaf:Person;
           rdfs:label "Knows"@en;
           rdfs:range foaf:Person.
foaf:made dc11:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
                           "http://www.w3.org/RDF/Interest/";
          dc11:coverage "world";
          dc11:creator "Dan Brickley",
                       "Libby Miller";
          dc11:description """\"Something that was made by this agent.\" In the context of the SWPortal ontology, this could e.g. be an <link>Tool</link>."""@en;
          dc11:format "application/rdf+xml";
          dc11:publisher "Libby Miller",
                         "Dan Brickley";
          dc11:title "Made"@en;
          dc11:type "http://www.w3.org/2002/07/owl#ObjectProperty";
          a owl:ObjectProperty;
          rdfs:comment """\"Something that was made by this agent.\" In the context of the SWPortal ontology, this could e.g. be an <link>Tool</link>.""";
          rdfs:domain foaf:Agent;
          rdfs:label "Made"@en;
          rdfs:range [owl:unionOf (swpo:Tool
                                   foaf:Document
                                   swpo:Book) ; 
                      a owl:Class].
foaf:mbox dc11:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
                           "http://www.w3.org/RDF/Interest/";
          dc11:coverage "world";
          dc11:creator "Libby Miller",
                       "Dan Brickley";
          dc11:description """\"A personal mailbox, i.e. an internet mailbox associated with exactly one owner, the first owner of this mailbox. This is a 'static inverse functional property', in that there is (across time and change) at most one individual that ever has any particular value for <link>foaf:mbox</link>.\" Because we switched over to OWL Lite– ,we don’t have functional properties anymore. However, we recommend to the users of this ontology to apply this property like it is described in the FOAF specification."""@en;
          dc11:format "application/rdf+xml";
          dc11:publisher "Dan Brickley",
                         "Libby Miller";
          dc11:title "Email"@en;
          dc11:type "http://www.w3.org/2002/07/owl#ObjectProperty";
          a owl:InverseFunctionalProperty,
            owl:ObjectProperty;
          rdfs:comment """\"A personal mailbox, i.e. an internet mailbox associated with exactly one owner, the first owner of this mailbox. This is a 'static inverse functional property', in that there is (across time and change) at most one individual that ever has any particular value for <link>foaf:mbox</link>.\" Because we switched over to OWL Lite– ,we don’t have functional properties anymore. However, we recommend to the users of this ontology to apply this property like it is described in the FOAF specification.""";
          rdfs:domain foaf:Agent;
          rdfs:label "Email"@en;
          rdfs:range rdfs:Literal.
foaf:member dc11:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
                             "http://www.w3.org/RDF/Interest/";
            dc11:coverage "world";
            dc11:creator "Dan Brickley",
                         "Libby Miller";
            dc11:description """\"Indicates a member of a Group.\" This property relates a set of agents to a group. These are the members of that group."""@en;
            dc11:format "application/rdf+xml";
            dc11:publisher "Libby Miller",
                           "Dan Brickley";
            dc11:title "Member"@en;
            dc11:type "http://www.w3.org/2002/07/owl#ObjectProperty";
            a owl:ObjectProperty;
            rdfs:comment """\"Indicates a member of a Group.\" This property relates a set of agents to a group. These are the members of that group.""";
            rdfs:domain foaf:Group;
            rdfs:label "Member"@en;
            rdfs:range foaf:Agent.
foaf:name dc11:contributor "http://www.w3.org/RDF/Interest/",
                           "http://rdfweb.org/mailman/listinfo/rdfweb-dev";
          dc11:coverage "world";
          dc11:creator "Libby Miller",
                       "Dan Brickley";
          dc11:description """\"The name of some thing.\""""@en;
          dc11:format "application/rdf+xml";
          dc11:publisher "Libby Miller",
                         "Dan Brickley";
          dc11:title "Complete Name"@en;
          dc11:type "http://www.w3.org/2002/07/owl#FunctionalProperty";
          a owl:FunctionalProperty,
            owl:DatatypeProperty;
          rdfs:comment """\"The name of some thing.\"""";
          rdfs:domain [owl:unionOf (foaf:Agent
                                    swpo:Location
                                    swpo:Tool
                                    swpo:Event) ; 
                       a owl:Class];
          rdfs:label "Complete Name"@en;
          rdfs:range xsd:string.
foaf:pastProject dc11:contributor "http://www.w3.org/RDF/Interest/",
                                  "http://rdfweb.org/mailman/listinfo/rdfweb-dev";
                 dc11:coverage "world";
                 dc11:creator "Dan Brickley",
                              "Libby Miller";
                 dc11:description """\"A project this person has previously worked on.\" NOTE: foaf defines the range as <link>foaf:Person</link> - we decided to change this to the more general <link>foaf:Agent</link>, since other types of Agents (e.g. a company) can also have projects."""@en;
                 dc11:format "application/rdf+xml";
                 dc11:publisher "Libby Miller",
                                "Dan Brickley";
                 dc11:title "Past Project"@en;
                 dc11:type "http://www.w3.org/2002/07/owl#ObjectProperty";
                 a owl:ObjectProperty,
                   owl:SymmetricProperty;
                 rdfs:comment """\"A project this person has previously worked on.\" NOTE: foaf defines the range as <link>foaf:Person</link> - we decided to change this to the more general <link>foaf:Agent</link>, since other types of Agents (e.g. a company) can also have projects.""";
                 rdfs:domain foaf:Agent;
                 rdfs:label "Past Project"@en;
                 rdfs:range foaf:Project.
foaf:phone dc11:contributor "http://www.w3.org/RDF/Interest/",
                            "http://rdfweb.org/mailman/listinfo/rdfweb-dev";
           dc11:coverage "world";
           dc11:creator "Libby Miller",
                        "Dan Brickley";
           dc11:description """\"The foaf:phone of something is a phone, typically identified using the tel: URI  scheme.\" The tel: URI scheme is defined in http://www.ietf.org/rfc/rfc2806.txt."""@en;
           dc11:format "application/rdf+xml";
           dc11:publisher "Libby Miller",
                          "Dan Brickley";
           dc11:title "Telephone"@en;
           dc11:type "http://www.w3.org/2002/07/owl#ObjectProperty";
           a owl:ObjectProperty;
           rdfs:comment """\"The foaf:phone of something is a phone, typically identified using the tel: URI  scheme.\" The tel: URI scheme is defined in http://www.ietf.org/rfc/rfc2806.txt.""";
           rdfs:domain foaf:Agent;
           rdfs:label "Telephone"@en;
           rdfs:range rdfs:Literal.
foaf:publications dc11:contributor "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
                                   "http://www.w3.org/RDF/Interest/";
                  dc11:coverage "world";
                  dc11:creator "Dan Brickley",
                               "Libby Miller";
                  dc11:description """\"A link to the publications of this person.\" This property relates an agent to its publications. NOTE: foaf defines the range as <link>foaf:Person</link> - we decided to change this to the more general <link>foaf:Agent</link>, since other types of Agents (e.g. a company) can also have publications (with no specific human authors)."""@en;
                  dc11:format "application/rdf+xml";
                  dc11:publisher "Libby Miller",
                                 "Dan Brickley";
                  dc11:title "Publications"@en;
                  dc11:type "http://www.w3.org/2002/07/owl#ObjectProperty";
                  a owl:ObjectProperty;
                  rdfs:comment """\"A link to the publications of this person.\" This property relates an agent to its publications. NOTE: foaf defines the range as <link>foaf:Person</link> - we decided to change this to the more general <link>foaf:Agent</link>, since other types of Agents (e.g. a company) can also have publications (with no specific human authors).""";
                  rdfs:domain foaf:Agent;
                  rdfs:label "Publications"@en;
                  rdfs:range foaf:Document;
                  owl:inverseOf swpo:hasAuthors.
foaf:surname dc11:contributor "http://www.w3.org/RDF/Interest/",
                              "http://rdfweb.org/mailman/listinfo/rdfweb-dev";
             dc11:coverage "world";
             dc11:creator "Libby Miller",
                          "Dan Brickley";
             dc11:description """\"The surname of a person.\" NOTE: the naming substructure of foaf is currently quite unstable."""@en;
             dc11:format "application/rdf+xml";
             dc11:publisher "Libby Miller",
                            "Dan Brickley";
             dc11:title "Surname"@en;
             dc11:type "http://www.w3.org/2002/07/owl#DatatypeProperty";
             a owl:DatatypeProperty,
               owl:FunctionalProperty;
             rdfs:comment """\"The surname of a person.\" NOTE: the naming substructure of foaf is currently quite unstable.""";
             rdfs:domain foaf:Person;
             rdfs:label "Surname"@en;
             rdfs:range xsd:string.
