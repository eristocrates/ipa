<http://xmlns.com/foaf/0.1/made> <http://purl.org/dc/elements/1.1/contributor> "http://rdfweb.org/mailman/listinfo/rdfweb-dev",
                                                                               "http://www.w3.org/RDF/Interest/";
                                 <http://purl.org/dc/elements/1.1/coverage> "world";
                                 <http://purl.org/dc/elements/1.1/creator> "Dan Brickley",
                                                                           "Libby Miller";
                                 <http://purl.org/dc/elements/1.1/description> """\"Something that was made by this agent.\" In the context of the SWPortal ontology, this could e.g. be an <link>Tool</link>."""@en;
                                 <http://purl.org/dc/elements/1.1/format> "application/rdf+xml";
                                 <http://purl.org/dc/elements/1.1/publisher> "Libby Miller",
