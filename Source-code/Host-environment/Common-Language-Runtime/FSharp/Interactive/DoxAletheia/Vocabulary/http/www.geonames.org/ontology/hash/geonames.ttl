                                                               "залив"@bg,
                                                               "бухта"@ru,
                                                               "bay"@en.
geonames:H.BAYS a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "coastal indentations between two capes or headlands, larger than a cove but smaller than a gulf"@en,
                                                                 "изгибы берега  между двумя мысами, больше чем открытая гавань, но меньше чем залив"@ru;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
