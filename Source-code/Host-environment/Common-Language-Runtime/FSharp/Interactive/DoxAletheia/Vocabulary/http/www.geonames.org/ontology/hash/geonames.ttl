                                                                "пристань"@ru.
geonames:S.WRCK a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "the site of the remains of a wrecked vessel"@en,
                                                                 "остатки кораблекрушения, выброшенные морем на берег"@ru;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:S;
                <http://www.w3.org/2004/02/skos/core#notation> "S.WRCK";
