geonames:S.WTRW a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "система наносов и очистных сооружений, сквозь которые проходит вода, используемая в дальнейшем для питья и технических целей"@ru,
                                                                 "a facility for supplying potable water through a water source and a system of pumps and filtration beds"@en;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:S;
                <http://www.w3.org/2004/02/skos/core#notation> "S.WTRW";
