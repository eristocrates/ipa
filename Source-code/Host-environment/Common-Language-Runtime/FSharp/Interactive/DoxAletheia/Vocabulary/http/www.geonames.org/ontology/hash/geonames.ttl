geonames:H.CNLSB a geonames:Code;
                 <http://www.w3.org/2004/02/skos/core#definition> "a gently inclined underground tunnel bringing water for irrigation from aquifers"@en,
                                                                  "подземный туннель, по которому течет вода, используемая  для орошения; вода берется из водоносного слоя почвы"@ru;
                 <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
                 <http://www.w3.org/2004/02/skos/core#notation> "H.CNLSB";
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "underground irrigation canal(s)"@en,
