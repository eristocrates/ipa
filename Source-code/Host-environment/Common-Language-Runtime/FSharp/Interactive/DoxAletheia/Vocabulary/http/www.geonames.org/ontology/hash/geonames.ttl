                                                               "kärr, träsk"@sv.
geonames:H.CAPG a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "a dome-shaped mass of glacial ice covering an area of  mountain summits or other high lands; smaller than an ice sheet"@en,
                                                                 "куполообразная масса ледникового льда, покрывающая гонные вершины; по размеру меньше ледникового щита"@ru;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
                <http://www.w3.org/2004/02/skos/core#notation> "H.CAPG";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "icecap"@en,
                                                                "iskalott"@sv,
                                                                "шапка полярного льда"@ru,
                                                                "iskappe"@no,
                                                                "ледена покривка"@bg.
geonames:H.CHN a geonames:Code;
               <http://www.w3.org/2004/02/skos/core#definition> "самый глубоки участок реки, пролива, залива, лагуны; через него проходит основной поток воды"@ru,
                                                                "the deepest part of a stream, bay, lagoon, or strait, through which the main current flows"@en;
               <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
               <http://www.w3.org/2004/02/skos/core#notation> "H.CHN";
