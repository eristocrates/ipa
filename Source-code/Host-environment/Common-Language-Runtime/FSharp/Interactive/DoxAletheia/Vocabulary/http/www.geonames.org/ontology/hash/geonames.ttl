geonames:H.CNLD a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "an artificial waterway carrying water away from a wetland or from drainage ditches"@en,
                                                                 "искусственный судоходный канал, забирает лишнюю воду  либо в заболоченной местности, либо из дренажного канала"@ru;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
                <http://www.w3.org/2004/02/skos/core#notation> "H.CNLD";
