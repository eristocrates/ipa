                                                                "излучина (реки)"@ru.
geonames:H.BNK a geonames:Code;
               <http://www.w3.org/2004/02/skos/core#definition> "an elevation, typically located on a shelf, over which the depth of water is relatively shallow but sufficient for most surface navigation"@en,
                                                                "возвышенность, которая обычно располагается на мелководье; однако количества воды достаточно для надводного судоходства"@ru;
               <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
               <http://www.w3.org/2004/02/skos/core#notation> "H.BNK";
               <http://www.w3.org/2004/02/skos/core#prefLabel> "нанос"@ru,
                                                               "бряг(ове)"@bg,
                                                               "strandssluttning, strandvall"@sv,
                                                               "bank(s)"@en,
                                                               "banker"@no.
geonames:H.BNKR a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "косой берег реки, который удерживает поток воды в своих границах"@ru,
                                                                 "a sloping margin of a stream channel which normally confines the stream to its channel on land"@en;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
                <http://www.w3.org/2004/02/skos/core#notation> "H.BNKR";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "речной берег"@ru,
