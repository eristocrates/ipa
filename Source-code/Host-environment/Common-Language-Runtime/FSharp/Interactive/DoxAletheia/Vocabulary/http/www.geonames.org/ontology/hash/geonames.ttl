                                                                "skipsled på sjøen"@no.
geonames:H.CHNN a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "a buoyed channel of sufficient depth for the safe navigation of vessels"@en,
                                                                 "огражденный буями пролив, достаточно глубокий для безопасного судоходства"@ru;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
                <http://www.w3.org/2004/02/skos/core#notation> "H.CHNN";
