geonames:H.AIRS a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "a place on a waterbody where floatplanes land and take off"@en,
                                                                 "место на воде для взлета и посадки гидросамолета"@ru;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
                <http://www.w3.org/2004/02/skos/core#notation> "H.AIRS";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "seaplane landing area"@en,
                                                                "landingsområde for sjøfly"@no,
                                                                "летище за хидроплани"@bg,
                                                                "посадочная полоса для гидросамолета"@ru,
                                                                "landningsplats för sjöflygplan"@sv.
geonames:H.ANCH a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "an area where vessels may anchor"@en,
                                                                 "место, где судна бросают якорь"@ru;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
                <http://www.w3.org/2004/02/skos/core#notation> "H.ANCH";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "anchorage"@en,
                                                                "ankarplats"@sv,
                                                                "якорная стоянка"@ru,
                                                                "ankerplass"@no,
                                                                "пристанище"@bg.
geonames:H.BAY a geonames:Code;
               <http://www.w3.org/2004/02/skos/core#definition> "a coastal indentation between two capes or headlands, larger than a cove but smaller than a gulf"@en,
                                                                "изгиб берега  между двумя мысами, больше чем открытая гавань, но меньше чем залив"@ru;
               <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
               <http://www.w3.org/2004/02/skos/core#notation> "H.BAY";
               <http://www.w3.org/2004/02/skos/core#prefLabel> "bukt"@no,
