                          rdfs:comment "A Wikipedia article"@en;
                          rdfs:label "Wikipedia Article"@en;
                          rdfs:subClassOf <http://xmlns.com/foaf/0.1/Document>.
geonames:alternateName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain geonames:Feature;
                       rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#altLabel>.
geonames:childrenFeatures a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Links to an RDF document containing the descriptions of children features"@en;
                          rdfs:domain geonames:Feature;
                          rdfs:label "children features"@en;
                          rdfs:range geonames:RDFData.
geonames:colloquialName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:label "colloquial name"@en;
                        rdfs:subPropertyOf geonames:alternateName.
geonames:countryCode a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "The countryCode value for a Geoname Feature is equal to the countryCode value of the parentCountry value."@en,
                                  "A two letters country code in the ISO 3166 list"@en;
                     rdfs:domain geonames:Feature;
                     rdfs:label "ISO country code"@en.
geonames:featureClass a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "The main category of the feature, as defined in geonames taxonomy."@en;
                      rdfs:domain geonames:Feature;
                      rdfs:label "feature class"@en;
                      rdfs:range geonames:Class;
                      rdfs:subPropertyOf <http://purl.org/dc/terms/type>;
                      <http://www.w3.org/2002/07/owl#propertyChainAxiom> (geonames:featureCode
                                                                          <http://www.w3.org/2004/02/skos/core#inScheme>),
                                                                         (geonames:featureCode
                                                                          <http://www.w3.org/2004/02/skos/core#inScheme>).
geonames:featureCode a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Type of the feature, as defined in geonames taxonomy."@en;
                     rdfs:domain geonames:Feature;
                     rdfs:label "feature code"@en;
                     rdfs:range geonames:Code;
                     rdfs:subPropertyOf <http://purl.org/dc/terms/type>.
geonames:geonamesID a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:label "geonames identifier"@en;
                    rdfs:subPropertyOf <http://purl.org/dc/terms/identifier>;
                    <http://www.w3.org/2004/02/skos/core#historyNote> "Added in version 3.1"@en.
geonames:historicalName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:label "historical name"@en;
                        rdfs:subPropertyOf geonames:alternateName.
geonames:locatedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Indicates that the subject resource is located in the object feature"@en;
                   rdfs:label "located in"@en;
                   rdfs:range geonames:Feature.
geonames:locationMap a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "A geonames map centered on the feature."@en;
                     rdfs:domain geonames:Feature;
                     rdfs:label "map"@en;
                     rdfs:range geonames:Map.
geonames:name a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "The main international name of a feature. The value has no xml:lang tag."@en;
              rdfs:domain geonames:Feature;
              rdfs:label "name"@en.
geonames:nearby a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "A feature close to the reference feature"@en;
                rdfs:domain geonames:Feature;
                rdfs:label "nearby"@en;
                rdfs:range geonames:Feature.
geonames:nearbyFeatures a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Links to an RDF document containing the descriptions of nearby features"@en;
                        rdfs:domain geonames:Feature;
                        rdfs:label "nearby features"@en;
                        rdfs:range geonames:RDFData.
geonames:neighbour a <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                     <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A feature sharing a common boarder with the reference feature"@en;
                   rdfs:domain geonames:Feature;
                   rdfs:label "neighbour"@en;
                   rdfs:range geonames:Feature.
geonames:neighbouringFeatures a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "Links to an RDF document containing the descriptions of neighbouring features. Applies when the feature has definite boarders."@en;
                              rdfs:domain geonames:Feature;
                              rdfs:label "neighbouring features"@en;
                              rdfs:range geonames:RDFData.
geonames:officialName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "A name in an official local language"@en;
                      rdfs:domain geonames:Feature;
                      rdfs:label "official name"@en;
                      rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#prefLabel>.
geonames:parentADM1 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain geonames:Feature;
                    rdfs:label "level 1 administrative parent"@en;
                    rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> geonames:featureCode ; 
                                <http://www.w3.org/2002/07/owl#hasValue> geonames:A.ADM1 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#onProperty> geonames:featureCode ; 
                                <http://www.w3.org/2002/07/owl#hasValue> geonames:A.ADM1 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>];
                    rdfs:subPropertyOf geonames:parentFeature.
geonames:parentADM2 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain geonames:Feature;
                    rdfs:label "level 2 administrative parent"@en;
                    rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> geonames:featureCode ; 
                                <http://www.w3.org/2002/07/owl#hasValue> geonames:A.ADM2 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#onProperty> geonames:featureCode ; 
                                <http://www.w3.org/2002/07/owl#hasValue> geonames:A.ADM2 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>];
                    rdfs:subPropertyOf geonames:parentFeature.
geonames:parentADM3 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain geonames:Feature;
                    rdfs:label "level 3 administrative parent"@en;
                    rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> geonames:featureCode ; 
                                <http://www.w3.org/2002/07/owl#hasValue> geonames:A.ADM3 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#onProperty> geonames:featureCode ; 
                                <http://www.w3.org/2002/07/owl#hasValue> geonames:A.ADM3 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>];
                    rdfs:subPropertyOf geonames:parentFeature.
geonames:parentADM4 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain geonames:Feature;
                    rdfs:label "level 4 administrative parent"@en;
                    rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> geonames:featureCode ; 
                                <http://www.w3.org/2002/07/owl#hasValue> geonames:A.ADM4 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#onProperty> geonames:featureCode ; 
                                <http://www.w3.org/2002/07/owl#hasValue> geonames:A.ADM4 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>];
                    rdfs:subPropertyOf geonames:parentFeature.
geonames:parentCountry a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain geonames:Feature;
                       rdfs:label "parent country"@en;
                       rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> geonames:featureCode ; 
                                   <http://www.w3.org/2002/07/owl#hasValue> geonames:A.PCLI ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#onProperty> geonames:featureCode ; 
                                   <http://www.w3.org/2002/07/owl#hasValue> geonames:A.PCLI ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>];
                       rdfs:subPropertyOf geonames:parentFeature.
geonames:parentFeature a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                         <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "A feature parent of the current one, in either administrative or physical subdivision."@en;
                       rdfs:domain geonames:Feature;
                       rdfs:label "parent feature"@en;
                       rdfs:range geonames:Feature.
geonames:population a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain geonames:Feature;
                    rdfs:label "population"@en;
                    rdfs:range xsd:integer.
geonames:postalCode a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain geonames:Feature;
                    rdfs:label "postal code"@en.
geonames:shortName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:domain geonames:Feature;
                   rdfs:label "short name"@en;
                   rdfs:subPropertyOf geonames:alternateName.
geonames:wikipediaArticle a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "A Wikipedia article of which subject is the resource."@en;
                          rdfs:domain geonames:Feature;
                          rdfs:label "wikipedia article"@en;
                          rdfs:range geonames:WikipediaArticle.
<http://www.w3.org/2004/02/skos/core#notation> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                               rdfs:comment "Used to store the values of feature codes"@en;
                                               rdfs:label "notation"@en.
<http://www.w3.org/2004/02/skos/core#prefLabel> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://xmlns.com/foaf/0.1/name> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
