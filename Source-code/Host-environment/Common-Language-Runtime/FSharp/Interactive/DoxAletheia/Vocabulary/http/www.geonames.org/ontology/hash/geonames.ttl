geonames:H.BGHT a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "открытый участок воды; там, где происходит отступание береговой черты"@ru,
                                                                 "an open body of water forming a slight recession in a coastline"@en;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
                <http://www.w3.org/2004/02/skos/core#notation> "H.BGHT";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "bight(s)"@en,
