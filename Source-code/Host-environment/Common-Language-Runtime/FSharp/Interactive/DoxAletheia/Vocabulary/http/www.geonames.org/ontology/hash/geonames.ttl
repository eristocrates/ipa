                                                                "elvebredd"@no.
geonames:H.BNKX a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:H;
                <http://www.w3.org/2004/02/skos/core#notation> "H.BNKX";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "част от бряг"@bg,
                                                                "участок берега"@ru,
                                                                "section of bank"@en,
                                                                "del av flodstrand"@sv,
                                                                "del av bredd"@no.
geonames:H.BOG a geonames:Code;
               <http://www.w3.org/2004/02/skos/core#definition> "заболоченная территория, которая является благоприятной почвой для торфяного мха, осоки и других болотных растений"@ru,
                                                                "a wetland characterized by peat forming sphagnum moss, sedge, and other acid-water plants"@en;
