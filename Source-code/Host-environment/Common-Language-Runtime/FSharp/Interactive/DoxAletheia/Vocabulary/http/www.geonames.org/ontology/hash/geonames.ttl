<http://dbpedia.org/resource/GeoNames> <http://id.loc.gov/vocabulary/relators/dtm> geonames:Marc-Wick;
                                       a <http://xmlns.com/foaf/0.1/Organization>;
                                       <http://xmlns.com/foaf/0.1/homepage> <http://www.geonames.org/>;
                                       <http://xmlns.com/foaf/0.1/name> "GeoNames".
<http://www.geonames.org/ontology> <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
                                   <http://purl.org/dc/terms/contributor> "Roman Rachkov (bulgarian translation)",
                                                                          "Valery Hronusov (russian translation)",
                                                                          "Erik Bolstad (norwegian and swedish translations)";
                                   <http://purl.org/dc/terms/creator> <http://data.semanticweb.org/person/bernard-vatant>;
                                   <http://purl.org/dc/terms/description> "The Geonames ontologies provides elements of description for geographical features, in particular those defined in the geonames.org data base"@en;
                                   <http://purl.org/dc/terms/issued> "2006-10-14";
                                   <http://purl.org/dc/terms/modified> "2012-10-29";
                                   <http://purl.org/dc/terms/publisher> <http://dbpedia.org/resource/GeoNames>;
                                   <http://purl.org/dc/terms/title> "The Geonames ontology"@en;
                                   <http://purl.org/vocab/vann/preferredNamespacePrefix> "gn";
                                   <http://purl.org/vocab/vann/preferredNamespaceUri> "http://www.geonames.org/ontology#";
                                   a <http://www.w3.org/2002/07/owl#Ontology>;
                                   rdfs:comment """Modifications from version 3.01 :
            Added : gn:GeonamesFeature, subclass of gn:Feature.
            Added : explicit property gn:geonamesID, mandatory and unique for each gn:GeonamesFeature instance.
            Deleted : owl:FunctionalProperty declarations for properties attached to gn:Feature, replaced by local cardinality restrictions on gn:GeonamesFeature
            The gn:Feature class and attached properties can therefore be used in the open world for features not necessarily identified in the Geonames data base, or with partial descriptions.
            Modified : Equivalent classes and superclasses of geonames:Feature in other vocabularies.
            Added : new feature codes for historical features.
            Improved metadata."""@en;
                                   rdfs:isDefinedBy <http://www.geonames.org/ontology/ontology_v3.1.rdf>;
                                   <http://www.w3.org/2002/07/owl#priorVersion> <http://www.geonames.org/ontology/ontology_v3.0.1.rdf>;
                                   <http://www.w3.org/2002/07/owl#versionInfo> "Version 3.1 - 2012-10-29"@en;
                                   <http://www.w3.org/ns/adms#relatedDocumentation> <http://www.geonames.org/ontology/documentation.html>;
                                   <http://xmlns.com/foaf/0.1/homepage> <http://www.geonames.org/ontology/documentation.html>.
geonames:A a geonames:Class;
           rdfs:comment "country, state, region ..."@en.
geonames:A.ADM1 a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "первоначальное политико-административное  деление, например, деление США на штаты"@ru,
                                                                 "a primary administrative division of a country, such as a state in the United States"@en;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.ADM1";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "политико-административное деление первого порядка"@ru,
                                                                "primær administrativ inndeling"@no,
                                                                "first-order administrative division"@en,
                                                                "första ordningens administrativ avdelning"@sv,
                                                                "първостепенна административна единица"@bg.
geonames:A.ADM1H a geonames:Code;
                 <http://www.w3.org/2004/02/skos/core#historyNote> "Added in v3.1"@en;
                 <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                 <http://www.w3.org/2004/02/skos/core#notation> "A.ADM1H";
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "historical first-order administrative division"@en.
geonames:A.ADM2 a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "дальнейшее деление политико-административного деления первого порядка"@ru,
                                                                 "a subdivision of a first-order administrative division"@en;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.ADM2";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "второстепенна административна единица"@bg,
                                                                "second-order administrative division"@en,
                                                                "политико-административное деление второго порядка"@ru,
                                                                "sekundær administrativ inndeling"@no,
                                                                "andra ordningens administrativ avdelning"@sv.
geonames:A.ADM2H a geonames:Code;
                 <http://www.w3.org/2004/02/skos/core#historyNote> "Added in v3.1"@en;
                 <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                 <http://www.w3.org/2004/02/skos/core#notation> "A.ADM2H";
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "historical second-order administrative division"@en.
geonames:A.ADM3 a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "a subdivision of a second-order administrative division"@en,
                                                                 "дальнейшее деление политико-административного деления второго порядка"@ru;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.ADM3";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "administrativ inndeling av tredje grad"@no,
                                                                "third-order administrative division"@en,
                                                                "tredje ordningens administrativ avdelning"@sv,
                                                                "третостепенна административна единица"@bg,
                                                                "политико-административное деление третьего порядка"@ru.
geonames:A.ADM3H a geonames:Code;
                 <http://www.w3.org/2004/02/skos/core#historyNote> "Added in v3.1"@en;
                 <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                 <http://www.w3.org/2004/02/skos/core#notation> "A.ADM3H";
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "historical third-order administrative division"@en.
geonames:A.ADM4 a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "a subdivision of a third-order administrative division"@en,
                                                                 "дальнейшее деление политико-административного деления третьего порядка"@ru;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.ADM4";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "fourth-order administrative division"@en,
                                                                "политико-административное деление четвертого порядка"@ru,
                                                                "administrativ inndeling av fjerde grad"@no,
                                                                "fjärde ordningens administrativ avdelning"@sv,
                                                                "четвъртостепенна административна единица"@bg.
geonames:A.ADM4H a geonames:Code;
                 <http://www.w3.org/2004/02/skos/core#historyNote> "Added in v3.1"@en;
                 <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                 <http://www.w3.org/2004/02/skos/core#notation> "A.ADM4H";
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "historical fourth-order administrative division"@en.
geonames:A.ADM5 a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "a subdivision of a fourth-order administrative division"@en;
                <http://www.w3.org/2004/02/skos/core#notation> "A.ADM5";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "fifth-order administrative division"@en.
geonames:A.ADMD a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "an administrative division of a country, undifferentiated as to administrative level"@en,
                                                                 "деление страны на административные единицы"@ru;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.ADMD";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "политико-административное  деление"@ru,
                                                                "административно делене"@bg,
                                                                "administrative division"@en,
                                                                "administrativ inndeling"@no,
                                                                "administrativ avdelning"@sv.
geonames:A.ADMH a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#historyNote> "Added in v3.1"@en;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.ADMH";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "historical administrative division"@en.
geonames:A.LTER a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "a tract of land leased to another country, usually for military installations"@en,
                                                                 "арендованный правительством Великобритании у властей Китая участок земли, часть Гонконга"@ru;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.LTER";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "арендованный район/территория"@ru,
                                                                "leid landområde"@no,
                                                                "uthyrt område"@sv,
                                                                "територия под аренда"@bg,
                                                                "leased area"@en.
geonames:A.PCL a geonames:Code;
               <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
               <http://www.w3.org/2004/02/skos/core#notation> "A.PCL";
               <http://www.w3.org/2004/02/skos/core#prefLabel> "политическое образование"@ru,
                                                               "политическо тяло"@bg,
                                                               "politisk enhet"@sv,
                                                               "politisk enhet"@no,
                                                               "political entity"@en.
geonames:A.PCLD a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.PCLD";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "зависимое политическое образование"@ru,
                                                                "зависимо политическо тяло"@bg,
                                                                "dependent political entity"@en,
                                                                "beroende politisk enhet"@sv,
                                                                "avhengig politisk enhet"@no.
geonames:A.PCLF a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.PCLF";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "свободно присоединившееся государство (свободное ассоциированное государство)"@ru,
                                                                "свободно асоциирана държава"@bg,
                                                                "fritt tilknyttet stat"@no,
                                                                "fritt associerad stat"@sv,
                                                                "freely associated state"@en.
geonames:A.PCLH a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#historyNote> "Added in v3.1"@en;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.PCLH";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "historical political entity"@en.
geonames:A.PCLI a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.PCLI";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "независимое политическое образование"@ru,
                                                                "независимо политическо образувание"@bg,
                                                                "uavhengig politisk enhet"@no,
                                                                "oberoende politisk enhet"@sv,
                                                                "independent political entity"@en.
geonames:A.PCLIX a geonames:Code;
                 <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                 <http://www.w3.org/2004/02/skos/core#notation> "A.PCLIX";
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "част от независимо политическо образувание"@bg,
                                                                 "участок независимого политического образования"@ru,
                                                                 "section of independent political entity"@en,
                                                                 "del av uavhengig politisk enhet"@no,
                                                                 "del av oberoende politisk enhet"@sv.
geonames:A.PCLS a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.PCLS";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "полу-независимо политическо образувание"@bg,
                                                                "наполовину зависимое политическое образование"@ru,
                                                                "semi-independent political entity"@en,
                                                                "delvis uavhengig politisk enhet"@no,
                                                                "delvis oberoende politisk enhet"@sv.
geonames:A.PPCLH a geonames:Code;
                 <http://www.w3.org/2004/02/skos/core#historyNote> "Added in v3.1"@en;
                 <http://www.w3.org/2004/02/skos/core#inScheme> geonames:P;
                 <http://www.w3.org/2004/02/skos/core#notation> "A.PPCLH";
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "historical capital of a political entity"@en.
geonames:A.PPLH a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#historyNote> "Added in v3.1"@en;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:P;
                <http://www.w3.org/2004/02/skos/core#notation> "A.PPLH";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "historical populated place"@en.
geonames:A.PRSH a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "низший церковный округ в христианской церкви, центром которого является храм"@ru,
                                                                 "an ecclesiastical district"@en;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.PRSH";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "parish"@en,
                                                                "церковный приход"@ru,
                                                                "sogn"@no,
                                                                "kommun"@sv,
                                                                "енория"@bg.
geonames:A.TERR a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
                <http://www.w3.org/2004/02/skos/core#notation> "A.TERR";
                <http://www.w3.org/2004/02/skos/core#prefLabel> "территория (административная единица в США, Канаде и Австралии, не имеющая прав штата или провинции)"@ru,
                                                                "територия"@bg,
                                                                "territory"@en,
                                                                "territorium"@sv,
                                                                "territorium"@no.
geonames:A.ZN a geonames:Code;
              <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
              <http://www.w3.org/2004/02/skos/core#notation> "A.ZN";
              <http://www.w3.org/2004/02/skos/core#prefLabel> "зона"@ru,
                                                              "зона"@bg,
                                                              "zone"@en,
                                                              "zon"@sv,
                                                              "sone"@no.
geonames:A.ZNB a geonames:Code;
               <http://www.w3.org/2004/02/skos/core#definition> "a zone recognized as a buffer between two nations in which military presence is minimal or absent"@en,
                                                                "область, официально признанная в качестве буфера между двумя нациями; военное присутствие минимально или вовсе отсутствует"@ru;
               <http://www.w3.org/2004/02/skos/core#inScheme> geonames:A;
               <http://www.w3.org/2004/02/skos/core#notation> "A.ZNB";
               <http://www.w3.org/2004/02/skos/core#prefLabel> "буферна зона"@bg,
                                                               "buffersone"@no,
                                                               "bufferzon"@sv,
                                                               "buffer zone"@en,
                                                               "буферная зона"@ru.
geonames:Class a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A class of features."@en;
               rdfs:label "Class"@en;
               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#ConceptScheme>.
geonames:Code a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A feature code."@en;
              rdfs:label "Code"@en;
              rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>.
geonames:Feature a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A geographical feature"@en;
                 rdfs:label "Feature"@en;
                 rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>,
                                 <http://schema.org/Place>;
                 <http://www.w3.org/2002/07/owl#equivalentClass> <http://geovocab.org/spatial#Feature>,
                                                                 <http://www.mindswap.org/2003/owl/geo/geoFeatures20040307.owl#GeographicFeature>;
                 <http://www.w3.org/2004/02/skos/core#historyNote> "Modified in version 3.1 : The cardinality constraints on feature code, feature class are relaxed on this class, and put on the specific subclass Geonames Feature. This class and attached properties can therefore be used for features not necessarily identified in the Geoanmes data base"@en.
geonames:GeonamesFeature a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A feature described in geonames database, uniquely defined by its geonames identifier"@en;
                         rdfs:label "Geonames Feature"@en;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2003/01/geo/wgs84_pos#long> ; 
                                          <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> geonames:population ; 
                                          <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> geonames:geonamesID ; 
                                          <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> geonames:name ; 
                                          <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> geonames:geonamesID ; 
                                          <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> geonames:featureClass ; 
                                          <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> geonames:parentADM1 ; 
                                          <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> geonames:parentADM3 ; 
                                          <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> geonames:countryCode ; 
                                          <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> geonames:population ; 
                                          <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> geonames:name ; 
                                          <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2003/01/geo/wgs84_pos#lat> ; 
                                          <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> geonames:featureCode ; 
                                          <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> geonames:countryCode ; 
