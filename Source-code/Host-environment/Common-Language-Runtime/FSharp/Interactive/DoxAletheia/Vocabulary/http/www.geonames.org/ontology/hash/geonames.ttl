geonames:S.ZOO a geonames:Code;
               <http://www.w3.org/2004/02/skos/core#definition> "a zoological garden or park where wild animals are kept for exhibition"@en,
                                                                "зоологический парк, где содержат диких животных с целью их демонстрации"@ru;
