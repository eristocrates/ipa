                                                                "судоходное русло"@ru,
                                                                "навигационен канал"@bg,
                                                                "navigeringskanal"@sv.
geonames:H.CNFL a geonames:Code;
                <http://www.w3.org/2004/02/skos/core#definition> "a place where two or more streams or intermittent streams flow together"@en,
                                                                 "место, где две (или больше) реки соединяются в одну"@ru;
