<http://purl.org/dc/terms/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/ontology/bibo/status> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://w3id.org/rml/ExpressionMap> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/rml/FunctionExecution> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "Represents a function execution."@en;
                                        rdfs:isDefinedBy rml_fnml:;
                                        rdfs:label "Function Execution".
<http://w3id.org/rml/FunctionMap> a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "Represents a function map."@en;
                                  rdfs:isDefinedBy rml_fnml:;
                                  rdfs:label "Function Map";
                                  rdfs:subClassOf <http://w3id.org/rml/TermMap>.
<http://w3id.org/rml/Input> a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Represents a input for an execution."@en;
                            rdfs:isDefinedBy rml_fnml:;
                            rdfs:label "Input".
<http://w3id.org/rml/ParameterMap> a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "Represents a parameter map."@en;
                                   rdfs:isDefinedBy rml_fnml:;
                                   rdfs:label "Parameter Map";
                                   rdfs:subClassOf <http://w3id.org/rml/TermMap>.
<http://w3id.org/rml/ReturnMap> a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Represents a return map."@en;
                                rdfs:isDefinedBy rml_fnml:;
                                rdfs:label "Return Map";
                                rdfs:subClassOf <http://w3id.org/rml/TermMap>.
<http://w3id.org/rml/TermMap> a <http://www.w3.org/2002/07/owl#Class>.
rml_fnml: <http://purl.org/dc/terms/contributor> "Ben de Meester",
                                                 "Ana Iglesias Molina",
                                                 "Samaneh Jozashoori";
          <http://purl.org/dc/terms/created> "2023-03-14";
          <http://purl.org/dc/terms/description> "RML-FNML provides data transformations for generating knowledge graphs from (semi-)structured data"@en;
          <http://purl.org/dc/terms/license> <http://purl.org/NET/rdflicense/cc-by4.0>;
          <http://purl.org/dc/terms/modified> "2023-06-15";
          <http://purl.org/dc/terms/publisher> <https://www.w3.org/community/kg-construct/>;
          <http://purl.org/dc/terms/title> "RML-FNML"@en;
          <http://purl.org/ontology/bibo/status> "draft";
          <http://purl.org/vocab/vann/preferredNamespacePrefix> "rml";
          <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/rml/";
          a <http://www.w3.org/2002/07/owl#Ontology>;
          <http://www.w3.org/2002/07/owl#versionIRI> <http://w3id.org/rml/fnml>;
          <http://www.w3.org/2002/07/owl#versionInfo> "0.1.0".
<http://w3id.org/rml/function> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "Specifies a data transformation function."@en;
                               rdfs:domain <http://w3id.org/rml/FunctionExecution>;
                               rdfs:isDefinedBy rml_fnml:;
                               rdfs:label "function";
                               rdfs:range rdfs:Resource.
<http://w3id.org/rml/functionExecution> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:comment "Denotes the execution of a function with its required input parameters and values."@en;
                                        rdfs:domain <http://w3id.org/rml/ExpressionMap>;
                                        rdfs:isDefinedBy rml_fnml:;
                                        rdfs:label "function execution";
                                        rdfs:range <http://w3id.org/rml/FunctionExecution>.
<http://w3id.org/rml/functionMap> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "A Function Map element to generate the data transformation function."@en;
                                  rdfs:domain <http://w3id.org/rml/Input>;
                                  rdfs:isDefinedBy rml_fnml:;
                                  rdfs:label "function map";
                                  rdfs:range <http://w3id.org/rml/FunctionMap>.
<http://w3id.org/rml/input> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "Specifies the Input element of a Function Map."@en;
                            rdfs:domain <http://w3id.org/rml/FunctionExecution>;
                            rdfs:isDefinedBy rml_fnml:;
                            rdfs:label "input";
                            rdfs:range <http://w3id.org/rml/Input>.
<http://w3id.org/rml/inputValue> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "Specifies the value of a parameter of a function."@en;
                                 rdfs:domain <http://w3id.org/rml/Input>;
                                 rdfs:isDefinedBy rml_fnml:;
                                 rdfs:label "value".
<http://w3id.org/rml/inputValueMap> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "A Value map element to generate the value of a parameter of a function."@en;
                                    rdfs:domain <http://w3id.org/rml/Input>;
                                    rdfs:isDefinedBy rml_fnml:;
                                    rdfs:label "value map";
                                    rdfs:range <http://w3id.org/rml/TermMap>.
<http://w3id.org/rml/parameter> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "Specifies the parameter of a function."@en;
                                rdfs:domain <http://w3id.org/rml/Input>;
                                rdfs:isDefinedBy rml_fnml:;
                                rdfs:label "parameter";
                                rdfs:range rdfs:Resource.
<http://w3id.org/rml/parameterMap> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "A Parameter Map element to generate the parameter of a function."@en;
                                   rdfs:domain <http://w3id.org/rml/Input>;
                                   rdfs:isDefinedBy rml_fnml:;
                                   rdfs:label "parameter map";
                                   rdfs:range <http://w3id.org/rml/ParameterMap>.
<http://w3id.org/rml/return> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Specifies the return output of a function."@en;
                             rdfs:domain <http://w3id.org/rml/ExpressionMap>;
                             rdfs:isDefinedBy rml_fnml:;
                             rdfs:label "return";
                             rdfs:range rdfs:Resource.
<http://w3id.org/rml/returnMap> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "A Return Map element to generate the return output of a function."@en;
                                rdfs:domain <http://w3id.org/rml/ExpressionMap>;
                                rdfs:isDefinedBy rml_fnml:;
                                rdfs:label "return map";
                                rdfs:range <http://w3id.org/rml/ReturnMap>.
<http://www.linkedmodel.org/schema/vaem#acronym> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:Resource a <http://www.w3.org/2002/07/owl#Class>.
