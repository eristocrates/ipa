                                     rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                                     rdfs:label "addressed from"@en;
                                     rdfs:range xsd:dateTime;
                                     skos:definition "Date and time from which the addressed object is unambiguously determined by the address."@en.
isoadr:AddressedPeriod.addressedObject <http://def.isotc211.org/iso19150/-2/2012/base#associationName> "allows unambiguous determination";
                                       a owl:ObjectProperty;
                                       rdfs:domain isoadr:AddressedPeriod;
                                       rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                                       rdfs:label "addressed object"@en;
                                       rdfs:range isoadr:AddressableObject.
isoadr:AddressedPeriod.addressedTo a owl:DatatypeProperty;
                                   rdfs:domain isoadr:AddressedPeriod;
                                   rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                                   rdfs:label "addressed to"@en;
                                   rdfs:range xsd:dateTime;
                                   skos:definition "Date and time when the addressed object ceased to be unambiguously determined by the address."@en.
isoadr:Lifespan a owl:Class;
                rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                rdfs:label "Lifespan";
                rdfs:subClassOf [owl:onProperty isoadr:Lifespan.validFrom ; 
                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                [owl:onProperty isoadr:Lifespan.openRecord ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                [owl:onProperty isoadr:Lifespan.closeRecord ; 
                                 owl:allValuesFrom xsd:dateTime ; 
                                 a owl:Restriction],
                                [owl:onProperty isoadr:Lifespan.version ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                [owl:onProperty isoadr:Lifespan.closeRecord ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                [owl:onProperty isoadr:Lifespan.version ; 
                                 owl:allValuesFrom xsd:string ; 
                                 a owl:Restriction],
                                [owl:onProperty isoadr:Lifespan.validTo ; 
                                 owl:allValuesFrom xsd:dateTime ; 
                                 a owl:Restriction],
                                [owl:onProperty isoadr:Lifespan.validFrom ; 
                                 owl:allValuesFrom xsd:dateTime ; 
                                 a owl:Restriction],
                                [owl:onProperty isoadr:Lifespan.validTo ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                [owl:onProperty isoadr:Lifespan.openRecord ; 
                                 owl:allValuesFrom xsd:dateTime ; 
                                 a owl:Restriction];
                skos:definition "Information to describe the lifespan of an address, adress component or addressable object."@en.
isoadr:Lifespan.closeRecord a owl:DatatypeProperty;
                            rdfs:domain isoadr:Lifespan;
                            rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                            rdfs:label "close record"@en;
                            rdfs:range xsd:dateTime;
                            skos:definition "Specifies the date and time at which this version of the data object was superseded by another version or retired in the dataset."@en.
isoadr:Lifespan.openRecord a owl:DatatypeProperty;
                           rdfs:domain isoadr:Lifespan;
                           rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                           rdfs:label "open record"@en;
                           rdfs:range xsd:dateTime;
                           skos:definition "Specifies the date and time at which this version of the data object was inserted into the dataset."@en.
isoadr:Lifespan.validFrom a owl:DatatypeProperty;
                          rdfs:domain isoadr:Lifespan;
                          rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                          rdfs:label "valid from"@en;
                          rdfs:range xsd:dateTime;
                          skos:definition "Date and time from which the object is valid in the physical world."@en.
isoadr:Lifespan.validTo a owl:DatatypeProperty;
                        rdfs:domain isoadr:Lifespan;
                        rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                        rdfs:label "valid to"@en;
                        rdfs:range xsd:dateTime;
                        skos:definition "Date and time when this object ceased to be valid in the physical world."@en.
isoadr:Lifespan.version a owl:DatatypeProperty;
                        rdfs:domain isoadr:Lifespan;
                        rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                        rdfs:label "version"@en;
                        rdfs:range xsd:string;
                        skos:definition """Unique identifier of this variant of the address record.

NOTE The version is incremented with any change to the data object."""@en.
isoadr:ReferenceObject a owl:Class;
                       rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                       rdfs:label "Reference Object";
                       rdfs:subClassOf [owl:onProperty isoadr:ReferenceObject.geometry ; 
                                        owl:allValuesFrom <http://def.isotc211.org/iso19107/2003/GeometryRoot#GM_Object> ; 
                                        a owl:Restriction],
                                       [owl:onProperty isoadr:ReferenceObject.id ; 
                                        owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction],
                                       [owl:onProperty isoadr:ReferenceObject.addressComponent ; 
                                        owl:allValuesFrom isoadr:AddressComponent ; 
                                        a owl:Restriction],
                                       [owl:onProperty isoadr:ReferenceObject.type ; 
                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction],
                                       [owl:onProperty isoadr:ReferenceObject.id ; 
                                        owl:allValuesFrom <http://def.isotc211.org/iso19152/2012/SpecialClasses#Oid> ; 
                                        a owl:Restriction],
                                       [owl:onProperty isoadr:ReferenceObject.geometry ; 
                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction],
                                       [owl:onProperty isoadr:ReferenceObject.addressComponent ; 
                                        owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction],
                                       [owl:onProperty isoadr:ReferenceObject.type ; 
                                        owl:allValuesFrom isoadr:ReferenceObjectType ; 
                                        a owl:Restriction];
                       skos:definition "The object to which the address component value may refer."@en.
isoadr:ReferenceObject.addressComponent <http://def.isotc211.org/iso19150/-2/2012/base#associationName> "references";
                                        a owl:ObjectProperty;
                                        rdfs:domain isoadr:ReferenceObject;
                                        rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                                        rdfs:label "address component"@en;
                                        rdfs:range isoadr:AddressComponent.
isoadr:ReferenceObject.geometry a owl:ObjectProperty;
                                rdfs:domain isoadr:ReferenceObject;
                                rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                                rdfs:label "geometry"@en;
                                rdfs:range <http://def.isotc211.org/iso19107/2003/GeometryRoot#GM_Object>;
                                skos:definition "Geometry (coordinates) representing the reference object."@en.
isoadr:ReferenceObject.id a owl:ObjectProperty;
                          rdfs:domain isoadr:ReferenceObject;
                          rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                          rdfs:label "id"@en;
                          rdfs:range <http://def.isotc211.org/iso19152/2012/SpecialClasses#Oid>;
                          skos:definition "Unique character string that identifies the reference object."@en.
isoadr:ReferenceObject.type a owl:ObjectProperty;
                            rdfs:domain isoadr:ReferenceObject;
                            rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                            rdfs:label "type"@en;
                            rdfs:range isoadr:ReferenceObjectType;
                            skos:definition "Code that specifies the kind of reference object."@en.
isoadr:ReferenceObjectType a owl:Class;
                           rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                           rdfs:label "Reference Object Type"@en;
                           rdfs:subClassOf skos:Concept.
skos:Concept a owl:Class.
skos:definition a owl:AnnotationProperty.
