                        rdfs:label "employee"@en;
                        rdfs:range <http://def.isotc211.org/iso19160/-1/2015/ExternalClasses#Employee>.
isoadr:Address.id a owl:ObjectProperty;
                  rdfs:domain isoadr:Address;
