                                     a owl:Restriction],
                                    [owl:onProperty isoadr:AddressAlias.address ; 
                                     owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                     a owl:Restriction];
                    skos:definition "Information about an address alias."@en.
