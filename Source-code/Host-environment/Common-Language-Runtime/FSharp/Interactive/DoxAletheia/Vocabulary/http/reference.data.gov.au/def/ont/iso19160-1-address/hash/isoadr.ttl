                            owl:inverseOf isoadr:Address.parentAddress.
isoadr:Address.class a owl:ObjectProperty;
                     rdfs:domain isoadr:Address;
                     rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                     rdfs:label "class"@en;
                     rdfs:range isoadr:AddressClass;
                     skos:definition "Code that specifies the address class to which the address belongs."@en.
isoadr:Address.client a owl:ObjectProperty;
