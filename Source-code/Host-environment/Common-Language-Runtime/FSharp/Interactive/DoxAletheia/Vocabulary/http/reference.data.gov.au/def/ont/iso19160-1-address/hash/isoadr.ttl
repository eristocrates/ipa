isoadr:Address.childAddress <http://def.isotc211.org/iso19150/-2/2012/base#associationName> "parent";
                            a owl:ObjectProperty;
                            rdfs:domain isoadr:Address;
                            rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                            rdfs:label "child address"@en;
