<http://reference.data.gov.au/def/ont/iso19160-1-address> dc11:contributor "Nicholas Car",
                                                                           "Australian Government Linked Data Working Group";
                                                          dc11:creator "ISO TC211, Group for Ontology Management";
                                                          dc11:publisher "Australian Government Linked Data Working Group";
                                                          dcterms:created "2017-11-27"^^xsd:date;
                                                          dcterms:source "http://standards.iso.org/iso/19160/-1/ed-1/en/";
                                                          a owl:Ontology;
                                                          rdfs:comment """This ontology is a version of the ISO TC211, Group for Ontology Management (GOM)'s OWL ontology interpretation of the ISO19160-1:2015 \"Addressing -- Part 1: Conceptual model\" standard (see https://www.iso.org/standard/61710.html) taken from that ontology's source code, published at https://github.com/ISO-TC211/GOM/tree/master/isotc211_GOM_harmonizedOntology/19160-1/2015.

This version uses different URIs for the ontology so that they can be made to resolve through the Australian Government Linked Data Working Groups redirect services where the original ontology's URIs do not resolve.

This ontology also has had the code lists removed thus preserving the data model but not the vocabularies. The code lists are published separately at http://reference.data.gov.au/def/ont/iso19160-1-address/codelist.

Additionally, this version adds some metadata, such as this explanation, some further annotation properties to better display elements of the ontology and includes a human-readable (HTML) version of the ontology generated from the RDF version.

As the GOM's version of the ontology evolves, we will keep this version up-to-date as we intend to only publish an easier-to-access version of their ontology here, not to profile it."""@en;
                                                          rdfs:label "ISO19160-1:2015 Address ontology";
                                                          owl:imports <http://def.isotc211.org/iso19160/-1/2015/Profile_Minimal>,
                                                                      <http://def.isotc211.org/iso19160/-1/2015/ExternalClasses>,
                                                                      <http://def.isotc211.org/iso19150/-2/2012/base>;
                                                          owl:versionIRI <http://reference.data.gov.au/def/ont/iso19160-1-address/1.1>;
                                                          owl:versionInfo "1.1".
isoadr:Address <http://def.isotc211.org/iso19150/-2/2012/base#constraint> "For Provenance conformance, provenance shall be mandatory"@en;
               a owl:Class;
               rdfs:isDefinedBy "http://standards.iso.org/iso/19160/-1/ed-1/en/";
               rdfs:label "Address"@en;
               rdfs:subClassOf [owl:onProperty isoadr:Address.preferenceLevel ; 
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.position ; 
                                owl:allValuesFrom isoadr:AddressPosition ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.status ; 
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.status ; 
                                owl:allValuesFrom isoadr:AddressStatus ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.lifespan ; 
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.addressComponent ; 
                                owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.preferenceLevel ; 
                                owl:allValuesFrom xsd:integer ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.business_branch ; 
                                owl:allValuesFrom <http://def.isotc211.org/iso19160/-1/2015/ExternalClasses#BusinessRegister> ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.lifespan ; 
                                owl:allValuesFrom isoadr:Lifespan ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.employee ; 
                                owl:allValuesFrom <http://def.isotc211.org/iso19160/-1/2015/ExternalClasses#Employee> ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.locale ; 
                                owl:allValuesFrom <http://def.isotc211.org/iso19135/-1/2015/ExtendedModel#RE_Locale> ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.lifecycleStage ; 
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.specification ; 
                                owl:allValuesFrom isoadr:AddressSpecification ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.theAddressAlias ; 
                                owl:allValuesFrom isoadr:AddressAlias ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.id ; 
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.childAddress ; 
                                owl:allValuesFrom isoadr:Address ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.id ; 
                                owl:allValuesFrom <http://def.isotc211.org/iso19152/2012/SpecialClasses#Oid> ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.business_headOffice ; 
                                owl:allValuesFrom <http://def.isotc211.org/iso19160/-1/2015/ExternalClasses#BusinessRegister> ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.addressComponent ; 
                                owl:allValuesFrom isoadr:AddressComponent ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.locale ; 
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.theAddressedPeriod ; 
                                owl:allValuesFrom isoadr:AddressedPeriod ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.class ; 
                                owl:allValuesFrom isoadr:AddressClass ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.parentAddress ; 
                                owl:allValuesFrom isoadr:Address ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.provenance ; 
                                owl:allValuesFrom isoadr:AddressProvenance ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.provenance ; 
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.lifecycleStage ; 
                                owl:allValuesFrom isoadr:AddressLifecycleStage ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.parentAddress ; 
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction],
                               [owl:onProperty isoadr:Address.class ; 
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
