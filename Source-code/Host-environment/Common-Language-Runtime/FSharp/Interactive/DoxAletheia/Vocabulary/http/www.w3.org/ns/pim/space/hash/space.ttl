@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix space: <http://www.w3.org/ns/pim/space#>.

space:ConfigurationFile rdfs:subClassOf <http://www.w3.org/2006/gen/ont#InformationResource>.
space:ControlledStorage a rdfs:Class;
                        rdfs:comment """A  storage is a space of URIs in which you can individually control for each resource
    who has access to it.
""";
                        rdfs:label "access controlled storage";
                        rdfs:subClassOf space:Storage.
space:MasterWorkspace rdfs:comment """This is a workspace for storing the
    information about the other workspaces.
    As a user, you normally don't have to worry about it.""";
                      rdfs:label "Master Workspace"@en;
                      rdfs:subClassOf space:PrivateWorkspace.
space:PersonalStorage a rdfs:Class;
                      rdfs:comment """A personal storage is a space of URIs in which you and only you have access to data,
    you cannot give access to anyone else.
""";
                      rdfs:label "personal storage";
                      rdfs:subClassOf space:Storage.
space:PreferencesWorkspace rdfs:comment "Aceess may not be open to the public. Contains preferences resources.";
                           rdfs:label "Preferences workspace";
                           rdfs:subClassOf space:Workspace.
space:PrivateWorkspace rdfs:comment "Access only by the you, the user.";
                       rdfs:label "Private workspace";
                       rdfs:subClassOf space:Workspace.
space:PublicStorage a rdfs:Class;
                    rdfs:comment """A public storage is a space of URIs in which you have access to data,
    and all data is accessible to anyone without control.
""";
                    rdfs:label "public storage";
                    rdfs:subClassOf space:Storage.
space:PublicWorkspace rdfs:comment """Aceess is open to the public. Anything in a public workspace
    can be accesed by anyone.""";
                      rdfs:label "Public workspace";
                      rdfs:subClassOf space:Workspace.
space:SharedWorkspace rdfs:comment "Access is to some but not all people.";
                      rdfs:label "Shared workspace";
                      rdfs:subClassOf space:Workspace.
space:Storage a rdfs:Class;
              rdfs:comment """A storage is a space of URIs in which you have access to data.
""";
              rdfs:label "storage".
space:Workspace a rdfs:Class;
                rdfs:comment """Workspaces are place where data is stored, and associated polices of privacy.
A given application typically stores information in several different
workspaces, some being user private, some shared, and some public.
""";
                rdfs:label "workspace";
                <http://www.w3.org/2002/07/owl#disjointUnionOf> (space:PrivateWorkspace
                                                                 space:SharedWorkspace
                                                                 space:PublicWorkspace).
space:masterWorkspace a rdf:Property;
                      rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
                      rdfs:label "master workspace"@en;
                      rdfs:range space:MasterWorkspace.
space:preferencesFile a rdf:Property;
                      rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
                      rdfs:label "preferences file";
                      rdfs:range space:ConfigurationFile.
space:storage a rdf:Property;
              rdfs:comment """The storage in which this workspace is, or the storage which
contains this resource, or a storage available to this agent to use.""";
              rdfs:label "storage";
              rdfs:range space:Storage.
space:uriPrefix a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  rdf:Property;
                rdfs:comment """URIs which start with this string are in this workspace or storage.
This may be used for constructing URIs for new storage resources.
""";
                rdfs:label "URI prefix";
                <http://www.w3.org/ns/ui#prompt> "Give the first part of the URis in this workspace".
space:workspace a rdf:Property;
                rdfs:label "workspace"@en;
                rdfs:range space:Workspace.
<https://www.w3.org/ns/pim/space#> <http://purl.org/dc/elements/1.1/title> "Workspace Ontology";
                                   rdfs:comment """This ontology is for use in describing
Workspaces.  Workspaces are places where data is stored and associated policies of privacy.
A given application typically stores information in several different
workspaces, some being user private, some shared, and some public.
it is crucial that the user has easy control over the destiny of information.

Goals then are that the user can

      - create workspaces
      - easily understand which workspace data is going into
      - understand what the implications of that are
      - (later) set ACLS on them
      - publish apropriate use policies for them

""";
                                   <http://www.w3.org/2000/10/swap/pim/doc#version> "$Id: space.ttl,v 1.4 2021/10/01 18:47:19 timbl Exp $".
