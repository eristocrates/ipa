                                     rdfs:subClassOf unicore:Sequence_Annotation.
unicore:Neutron_Diffraction a unicore:Structure_Determination_Method,
                              <http://www.w3.org/2002/07/owl#Thing>;
                            rdfs:label "Neutron Diffraction";
                            rdfs:seeAlso "iki:Neutron_diffraction"^^xsd:anyURI.
unicore:Non-adjacent_Residues_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment "Indicates that two residues in a sequence are not consecutive and that there are a number of unsequenced residues between them.";
                                         rdfs:label "Non-consecutive Residues";
                                         rdfs:seeAlso "http://www.uniprot.org/manual/non_cons"^^xsd:anyURI;
                                         rdfs:subClassOf unicore:Experimental_Information_Annotation.
unicore:Non-photosynthetic_plastid a unicore:Organelle,
