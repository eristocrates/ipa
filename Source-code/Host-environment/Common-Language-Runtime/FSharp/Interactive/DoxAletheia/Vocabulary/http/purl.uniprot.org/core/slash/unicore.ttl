                                           rdf:Statement.
unicore:Class a unicore:Rank,
                <http://www.w3.org/2002/07/owl#Thing>;
              rdfs:label "Taxonomy rank Class".
unicore:Cluster a <http://www.w3.org/2002/07/owl#Class>;
