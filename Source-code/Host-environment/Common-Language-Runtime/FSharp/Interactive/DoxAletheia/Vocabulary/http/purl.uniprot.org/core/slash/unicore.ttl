                               rdfs:label "Coiled-Coil";
                               rdfs:seeAlso "http://www.uniprot.org/manual/coiled"^^xsd:anyURI;
                               rdfs:subClassOf unicore:Region_Annotation.
unicore:Compositional_Bias_Annotation a <http://www.w3.org/2002/07/owl#Class>;
