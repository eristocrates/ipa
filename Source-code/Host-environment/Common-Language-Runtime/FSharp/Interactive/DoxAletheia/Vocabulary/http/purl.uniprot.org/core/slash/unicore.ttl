                                                                    [<http://www.w3.org/2002/07/owl#hasValue> false ; 
                                                                     <http://www.w3.org/2002/07/owl#onProperty> unicore:obsolete ; 
                                                                     a <http://www.w3.org/2002/07/owl#Restriction>].
unicore:NotObsoleteProtein a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
