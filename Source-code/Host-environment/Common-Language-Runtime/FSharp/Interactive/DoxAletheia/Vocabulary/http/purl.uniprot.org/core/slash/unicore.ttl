unicore:Potential a unicore:Status,
                    <http://www.w3.org/2002/07/owl#Thing>;
                  rdfs:comment "indicates that there is some logical or conclusive evidence that the given annotation could apply. This non-experimental qualifier is often used to present results from protein sequence analysis software tools, which are only annotated if the result makes sense in the biological context of a given protein. A typical example is the annotation of N-glycosylation sites in secreted proteins";
                  rdfs:label "Potential".
unicore:Predicted_Existence a unicore:Protein_Existence,
                              <http://www.w3.org/2002/07/owl#Thing>;
                            rdfs:comment "This is used for proteins without evidence at protein, transcript, or homology levels.";
                            rdfs:label "Predicted".
unicore:Prediction a unicore:Structure_Determination_Method,
