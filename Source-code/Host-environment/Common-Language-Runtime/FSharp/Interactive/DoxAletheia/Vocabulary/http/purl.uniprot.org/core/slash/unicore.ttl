unicore:Non-standard_Residue_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "Describes the occurrence of a non standard residue in the sequence record.";
                                        rdfs:label "Non standard residue";
                                        rdfs:seeAlso "http://www.uniprot.org/manual/non_std"^^xsd:anyURI;
                                        rdfs:subClassOf unicore:Modification_Annotation.
unicore:Non-terminal_Residue_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "The residue at an extremity of the sequence is not the terminal residue.";
                                        rdfs:label "Non-terminal Residue";
                                        rdfs:seeAlso "http://www.uniprot.org/manual/non_ter"^^xsd:anyURI;
                                        rdfs:subClassOf unicore:Experimental_Information_Annotation.
unicore:NotObsolete a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A class introduced to group all records that are currently in the database.";
                    <http://www.w3.org/2002/07/owl#disjointWith> unicore:Obsolete;
                    <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#hasValue> false ; 
