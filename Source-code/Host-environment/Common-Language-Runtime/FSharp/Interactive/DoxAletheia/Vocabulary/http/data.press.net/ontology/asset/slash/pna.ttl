@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix pna: <http://data.press.net/ontology/asset/>.

pna: <http://purl.org/dc/terms/created> "2011-07-28"^^xsd:date;
     <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by-nd/3.0/>;
     <http://purl.org/dc/terms/modified> "2012-01-11"^^xsd:date;
     <http://purl.org/dc/terms/title> "SNaP Asset Ontology"@en;
     a <http://www.w3.org/2002/07/owl#Ontology>;
     rdfs:comment "The Asset Ontology describes news assets (text, images, video, data, etc), the relationships between them and how assets can be classified and semantically annotated.";
     <http://www.w3.org/2002/07/owl#versionInfo> "0.3.1";
     <http://xmlns.com/foaf/0.1/maker> <http://uk.linkedin.com/in/paulwilton>,
                                       <http://uk.linkedin.com/in/pauliharman>,
                                       <http://uk.linkedin.com/in/jarredmcginnis>.
pna:Asset a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Generic News Asset Class"@en;
          rdfs:isDefinedBy pna:;
          rdfs:label "Generic Asset Class"@en;
          rdfs:subClassOf <http://data.press.net/ontology/tag/Taggable>,
                          <http://data.press.net/ontology/classification/Classifiable>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:Image a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Image Asset Class"@en;
          rdfs:isDefinedBy pna:;
          rdfs:label "Image Asset Class"@en;
          rdfs:subClassOf <http://purl.org/dc/dcmitype/StillImage>,
                          pna:Asset;
          <http://www.w3.org/2002/07/owl#seeAlso> <http://cv.iptc.org/newscodes/ninature/picture>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:Text a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "Text Asset Class"@en;
         rdfs:isDefinedBy pna:;
         rdfs:label "Text Asset Class"@en;
         rdfs:subClassOf <http://purl.org/dc/dcmitype/Text>,
                         pna:Asset;
         <http://www.w3.org/2002/07/owl#seeAlso> <http://cv.iptc.org/newscodes/ninature/text>;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:Video a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Video Asset Class"@en;
          rdfs:isDefinedBy pna:;
          rdfs:label "Video Asset Class"@en;
          rdfs:subClassOf <http://purl.org/dc/dcmitype/MovingImage>,
                          pna:Asset;
          <http://www.w3.org/2002/07/owl#seeAlso> <http://cv.iptc.org/newscodes/ninature/video>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:associatedAsset a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Property that associates one asset with another asset"@en;
                    rdfs:domain pna:Asset;
                    rdfs:isDefinedBy pna:;
                    rdfs:label "Property that associates one asset with another asset"@en;
                    rdfs:range pna:Asset;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:byline a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "The byline of a news Asset"@en;
           rdfs:domain pna:Asset;
           rdfs:isDefinedBy pna:;
           rdfs:label "Asset byline"@en;
           rdfs:range xsd:string;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:created a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "The date and time a news Asset was created"@en;
            rdfs:domain pna:Asset;
            rdfs:isDefinedBy pna:;
            rdfs:label "Asset created dateTime"@en;
            rdfs:range xsd:dateTime;
            rdfs:subPropertyOf <http://purl.org/dc/terms/created>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:derivedFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Relates an asset to an asset that it is derived from"@en;
                rdfs:domain pna:Asset;
                rdfs:isDefinedBy pna:;
                rdfs:label "Relates an asset to an asset that it is derived from"@en;
                rdfs:range pna:Asset;
                rdfs:subPropertyOf pna:associatedAsset;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:embargoedUntil a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "The date and time a news Asset is embargoedUntil"@en;
                   rdfs:domain pna:Asset;
                   rdfs:isDefinedBy pna:;
                   rdfs:label "Asset embargoed until dateTime"@en;
                   rdfs:range xsd:dateTime;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:hasThumbnail a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Property that associates a thumbnail image with an asset"@en;
                 rdfs:domain pna:Asset;
                 rdfs:isDefinedBy pna:;
                 rdfs:label "Property that associates a thumbnail image with an asset"@en;
                 rdfs:range pna:Image;
                 rdfs:subPropertyOf pna:associatedAsset;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:hasTranscript a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Property that associates a Text transcript with a Video"@en;
                  rdfs:domain pna:Video;
                  rdfs:isDefinedBy pna:;
                  rdfs:label "The text transcript of a Video"@en;
                  rdfs:range pna:Text;
                  rdfs:subPropertyOf pna:associatedAsset;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:modified a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "The date and time a news Asset was modified"@en;
             rdfs:domain pna:Asset;
             rdfs:isDefinedBy pna:;
             rdfs:label "Asset modified dateTime"@en;
             rdfs:range xsd:dateTime;
             rdfs:subPropertyOf <http://purl.org/dc/terms/modified>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:published a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "The date and time a news Asset was published"@en;
              rdfs:domain pna:Asset;
              rdfs:isDefinedBy pna:;
              rdfs:label "Asset published dateTime"@en;
              rdfs:range xsd:dateTime;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:summary a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "The summary text of a news Asset"@en;
            rdfs:domain pna:Asset;
            rdfs:isDefinedBy pna:;
            rdfs:label "Asset summary"@en;
            rdfs:range xsd:string;
            rdfs:subPropertyOf <http://purl.org/dc/terms/abstract>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pna:title a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "The title of a news Asset"@en;
          rdfs:domain pna:Asset;
          rdfs:isDefinedBy pna:;
          rdfs:label "Asset title"@en;
          rdfs:range xsd:string;
          rdfs:subPropertyOf <http://purl.org/dc/terms/title>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
<http://uk.linkedin.com/in/jarredmcginnis> a <http://xmlns.com/foaf/0.1/Person>;
                                           <http://xmlns.com/foaf/0.1/name> "Jarred McGinnis".
<http://uk.linkedin.com/in/pauliharman> a <http://xmlns.com/foaf/0.1/Person>;
                                        <http://xmlns.com/foaf/0.1/name> "Paul Harman".
<http://uk.linkedin.com/in/paulwilton> a <http://xmlns.com/foaf/0.1/Person>;
                                       <http://xmlns.com/foaf/0.1/name> "Paul Wilton".
