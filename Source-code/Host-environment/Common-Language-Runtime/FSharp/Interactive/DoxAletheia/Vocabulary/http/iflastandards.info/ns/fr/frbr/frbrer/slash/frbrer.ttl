                                                                  frbrer:P3002,
                                                                  frbrer:P3005;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a work to a corporate body that is responsible for the creation of the intellectual or artistic content of the work."@en.
frbrer:P2008 <http://metadataregistry.org/uri/profile/RegAp/name> "isCreatorCorporateBodyOf"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1006;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "es creador (entidad corporativa) de"@es,
                        "is creator (corporate body) of"@en;
             rdfs:range frbrer:C1001;
             <http://www.w3.org/2002/07/owl#inverseOf> frbrer:P2007;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a corporate body to a work of which it is responsible for the creation of the intellectual or artistic content."@en.
frbrer:P2009 <http://metadataregistry.org/uri/profile/RegAp/name> "isCreatedByPerson"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1001;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "is created by (person)"@en,
                        "es creado por (persona)"@es;
             rdfs:range frbrer:C1005;
             <http://www.w3.org/2002/07/owl#inverseOf> frbrer:P2010;
             <http://www.w3.org/2002/07/owl#propertyDisjointWith> frbrer:P3003,
                                                                  frbrer:P3006,
