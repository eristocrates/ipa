frbrer:P2093 <http://metadataregistry.org/uri/profile/RegAp/name> "hasAReproductionManifestationFromItem"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
