             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene lengua de la expresiÃ³n"@es,
                        "has language of expression"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to the language in which the work is expressed."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The language of the expression may comprise a number of languages, each pertaining to an individual component of the expression."@en.
frbrer:P3012 <http://metadataregistry.org/uri/profile/RegAp/name> "hasOtherDistinguishingCharacteristicOfExpression"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:comment """Source document has label \"Other Distinguishing Characteristic\" used also for a Work attribute."""@en;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene otras caracterÃ­sticas distintivas de expresiÃ³n"@es,
                        "has other distinguishing characteristic of expression"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to any characteristic of the expression that serves to differentiate the expression from another expression of the same work."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> """E.g., the names used to differentiate the various versions of the English text of the Bible, or an \"edition\" or version designation relating to the intellectual content of the expression such as \"2nd revision\"."""@en.
frbrer:P3013 <http://metadataregistry.org/uri/profile/RegAp/name> "hasExtensibilityOfExpression"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene extensibilidad de la expresiÃ³n"@es,
                        "has extensibility of expression"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a reflection of the expectation that the expression will have additional intellectual or artistic content added to it."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., an expression that is completed one part at a time, segment by segment, issue by issue, etc."@en.
frbrer:P3014 <http://metadataregistry.org/uri/profile/RegAp/name> "hasRevisabilityOfExpression"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene revisabilidad de la expresiÃ³n"@es,
                        "has revisability of expression"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a reflection of the expectation that the intellectual or artistic content of the expression will be revised."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., a draft or interim report, a directory that is expected to be updated periodically."@en.
frbrer:P3015 <http://metadataregistry.org/uri/profile/RegAp/name> "hasExtentOfTheExpression"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene extensiÃ³n de la expresiÃ³n"@es,
                        "has extent of the expression"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a quantification of the intellectual content of the expression."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., number of words in a text, statements in a computer program, images in a comic strip, etc. For works expressed as sound and, or, motion the extent may be a measure of duration; e.g., playing time."@en.
frbrer:P3016 <http://metadataregistry.org/uri/profile/RegAp/name> "hasSummarizationOfContent"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene resumen del contenido"@es,
                        "has summarization of content"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to an abstract, summary, synopsis, etc., or a list of chapter headings, songs, parts, etc. included in the expression."@en.
frbrer:P3017 <http://metadataregistry.org/uri/profile/RegAp/name> "hasContextForTheExpression"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene contexto de la expresiÃ³n"@es,
                        "has context for the expression"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to the historical, social, intellectual, artistic, or other context within which the expression was realized."@en.
frbrer:P3018 <http://metadataregistry.org/uri/profile/RegAp/name> "hasCriticalResponseToTheExpression"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene respuesta crÃ­tica a la expresiÃ³n"@es,
                        "has critical response to the expression"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to the reception given to the expression by reviewers, critics, etc., as encapsulated in an annotation."@en.
frbrer:P3019 <http://metadataregistry.org/uri/profile/RegAp/name> "hasUseRestrictionsOnTheExpression"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene restricciones de uso de la expresiÃ³n"@es,
                        "has use restrictions on the expression"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to restrictions on access to and use of an expression."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Use restrictions may be based in copyright, or they may extend beyond the protections guaranteed in law to the owner of the copyright."@en.
frbrer:P3020 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTitleOfTheManifestation"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene tÃ­tulo de la manifestaciÃ³n"@es,
                        "has title of the manifestation"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to the word, phrase, or group of characters naming the manifestation."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "There may be one or more titles associated with a manifestation. Titles associated with a manifestation include all those that appear in the manifestation itself (e.g., the title on the title page, title frame, etc., a cover title, added title-page title, caption title, running title, spine title, etc., the title in a colophon, explicit, etc., the title on a container, on a microfiche header, etc.), as well as those that have been assigned to the manifestation for purposes of bibliographic control (e.g., key title, expanded title, translated title, supplied title, etc.)."@en.
frbrer:P3021 <http://metadataregistry.org/uri/profile/RegAp/name> "hasStatementOfResponsibility"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene menciÃ³n de responsabilidad"@es,
                        "has statement of responsibility"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to a statement appearing in the manifestation (normally in conjunction with the title) that names one or more individuals or groups responsible for the creation or realization of the intellectual or artistic content embodied in the manifestation."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "An individual or group named may be directly responsible for the work embodied in the manifestation (e.g., the author, composer, etc.), or indirectly responsible (e.g., the author of a novel on which a film script is based). Other individuals or groups named in the statement may include those responsible for the expression of the work contained in the manifestation (e.g., translators, performers, etc.), or those responsible for the compilation of works contained in the manifestation (e.g., the editor, compiler, etc.). A statement of responsibility may name an organization responsible for sponsoring or issuing the work contained in the manifestation. The statement may also indicate the role or function performed by each of the individuals, groups, or organizations responsible. The names appearing in the statement of responsibility in the manifestation may or may not be those of the persons and corporate bodies actually responsible for the creation or realization of the intellectual or artistic content embodied in the manifestation. Similarly, the stated functions may or may not reflect the actual relationship that exists between the individuals and groups named and the intellectual or artistic content."@en.
frbrer:P3022 <http://metadataregistry.org/uri/profile/RegAp/name> "hasSeriesStatement"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene menciÃ³n de serie"@es,
                        "has series statement"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to the word, phrase, or group of characters appearing in the manifestation naming the series to which the manifestation belongs."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "A series statement may also include a number designating the sequential position of the manifestation within the series. There may be one or more series and, or, subseries named in the manifestation."@en.
frbrer:P3023 <http://metadataregistry.org/uri/profile/RegAp/name> "hasFormOfCarrier"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene forma del soporte"@es,
                        "has form of carrier"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to the specific class of material to which the physical carrier of the manifestation belongs."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., sound cassette, videodisc, microfilm cartridge, transparency, etc. The carrier for a manifestation comprising multiple physical components may include more than one form (e.g., a filmstrip with an accompanying booklet, a separate sound disc carrying the sound track for a film, etc.)."@en.
frbrer:P3024 <http://metadataregistry.org/uri/profile/RegAp/name> "hasExtentOfTheCarrier"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene extensiÃ³n del soporte"@es,
                        "has extent of the carrier"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to a quantification of the number of physical units making up the carrier."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., number of sheets, discs, reels, etc."@en.
frbrer:P3025 <http://metadataregistry.org/uri/profile/RegAp/name> "hasPhysicalMedium"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene soporte fÃ­sico"@es,
                        "has physical medium"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to the type of material from which the carrier is produced."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., paper, wood, plastic, metal, etc. The physical medium may include in addition to the base material any material that is applied to the base (e.g., oil paint applied to canvas, a chemical emulsion applied to a film base, etc.). Each component of a manifestation comprising multiple physical components may be produced from a different type of material."@en.
frbrer:P3026 <http://metadataregistry.org/uri/profile/RegAp/name> "hasCaptureMode"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene modo de captura"@es,
                        "has capture mode"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to the means used to record notation, sound, or images in the production of a manifestation."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., analogue, acoustic, electric, digital, optical etc."@en.
frbrer:P3027 <http://metadataregistry.org/uri/profile/RegAp/name> "hasDimensionsOfTheCarrier"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene dimensiones del soporte"@es,
                        "has dimensions of the carrier"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to the measurements of the physical components and, or, the container of the manifestation."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The dimensions may comprise measurements of height (e.g., 18 cm bound volume), width (e.g., 8mm film), height x width (e.g., 5 x 5 cm slide), height x width x depth (e.g., 9 x 30 x 20 cm model), or diameter (e.g., 30 cm disc)."@en.
frbrer:P3028 <http://metadataregistry.org/uri/profile/RegAp/name> "hasManifestationIdentifier"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene identificador del manifestaciÃ³n"@es,
                        "has manifestation identifier"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to a number or code uniquely associated with the manifestation that serves to differentiate that manifestation from any other manifestation."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "A manifestation may have one or more identifiers associated with it. The identifier may be assigned as part of an international numbering or coding system (e.g., ISBN, etc.), as part of a national system (e.g., legal deposit number), or it may be assigned independently by the publisher or distributor of the manifestation (e.g., government publication number, music publisher's number, clearinghouse inventory number, etc.). A manifestation identifier may also be assigned by a bibliographer, musicologist, etc. The manifestation identifier may comprise both a numeric component and a textual or coded component identifying the system under which it was assigned and, or, the agency or individual that assigned the number, so as to render the identifier unique to the manifestation."@en.
frbrer:P3029 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTermsOfAvailability"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene condiciones de disponibilidad"@es,
                        "has terms of availability"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to the terms indicated in the manifestation under which the supplier (i.e., the source for acquisition or access authorization) will normally make the manifestation available, or the price for which the manifestation sells."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., free to members of a particular association."@en.
frbrer:P3030 <http://metadataregistry.org/uri/profile/RegAp/name> "hasAccessRestrictionsOnTheManifestation"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene restricciones de acceso a la manifestaciÃ³n"@es,
                        "has access restrictions on the manifestation"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to restrictions on access to and use of a manifestation."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Access restrictions may be based in copyright, or they may extend beyond the protections guaranteed in law to the owner of the copyright."@en.
frbrer:P3031 <http://metadataregistry.org/uri/profile/RegAp/name> "hasItemIdentifier"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1004;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene identificador del ejemplar"@es,
                        "has item identifier"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an item to a number or code that is uniquely associated with the item, and serves to differentiate that item from any other item in the same collection and, or, institution."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., call number, accession number, bar code, etc. The number is normally assigned by the institution that holds the item. The item identifier may also include a name or code identifying the institution or repository in which the item is housed, and a name or code identifying a particular collection or sub-unit within the institution (e.g., a rare book collection, a branch library, etc.)."@en.
frbrer:P3032 <http://metadataregistry.org/uri/profile/RegAp/name> "hasFingerprint"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1004;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene huella tipogrÃ¡fica"@es,
                        "has fingerprint"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an item to an identifier constructed by combining groups of characters transcribed from specified pages of a printed item."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The technique is used primarily to signal differences between individual copies of early printed books. There are various formulae for constructing the fingerprint (e.g., the one specified in Fingerprints = Empreintes = Impronte, published by the Institut de Recherche et dâ€™Histoire des Textes in Paris)."@en.
frbrer:P3033 <http://metadataregistry.org/uri/profile/RegAp/name> "hasProvenanceOfTheItem"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1004;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene procedencia del ejemplar"@es,
                        "has provenance of the item"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an item to a record of previous ownership or custodianship of the item."@en.
frbrer:P3034 <http://metadataregistry.org/uri/profile/RegAp/name> "hasExhibitionHistory"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1004;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene historial de exposiciones"@es,
                        "has exhibition history"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an item to a record of public exhibitions of an item, including dates, venues, etc."@en.
frbrer:P3035 <http://metadataregistry.org/uri/profile/RegAp/name> "hasConditionOfTheItem"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1004;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene estado del ejemplar"@es,
                        "has condition of the item"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an item to the physical condition of the item, particularly any variances between the physical makeup of the item and that of the manifestation it exemplifies."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., missing pages, plates, etc. Condition may reflect other aspects of the physical condition of the item as well (e.g., brittleness, faded images, etc.)."@en.
frbrer:P3036 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTreatmentHistory"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1004;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene historial de tratamientos"@es,
                        "has treatment history"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an item to a record of the treatment the item has undergone."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., deacidification, restoration, etc. Treatment history may also comprise details of the treatment process (e.g., chemical solutions used, techniques applied, etc.), the date the treatment was applied, etc."@en.
frbrer:P3037 <http://metadataregistry.org/uri/profile/RegAp/name> "hasScheduledTreatment"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1004;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene tratamiento programado"@es,
                        "has scheduled treatment"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an item to a plan for future treatment of the item."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., chemical wash. Scheduled treatment may also comprise details of the planned treatment process and the scheduled date of application."@en.
frbrer:P3038 <http://metadataregistry.org/uri/profile/RegAp/name> "hasAccessRestrictionsOnTheItem"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1004;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene restricciones de acceso al ejemplar"@es,
                        "has access restrictions on the item"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an item to any limitations placed on physical access to the item."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., restricted to supervised on-site use, etc."@en.
frbrer:P3039 <http://metadataregistry.org/uri/profile/RegAp/name> "hasNameOfPerson"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1005;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene nombre de persona"@es,
                        "has name of person"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a person to the word, character, or group of words and, or, characters by which the person is known."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., Donald Horne, A. A. Milne, Ellery Queen, etc. A name may include one or more forenames (or given names), matronymics, patronymics, family names (or surnames), sobriquets, dynastic names, etc. A person may be known by more than one name, or by more than one form of the same name. A bibliographic agency normally selects one of those names as the uniform heading for purposes of consistency in naming and referencing the person. The other names or forms of name may be treated as variant names for the person. In some cases (e.g., in the case of a person who writes under more than one pseudonym, or a person who writes both in an official capacity and as an individual) the bibliographic agency may establish more than one uniform heading for the person."@en.
frbrer:P3040 <http://metadataregistry.org/uri/profile/RegAp/name> "hasDatesOfPerson"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:comment """Source documentation has \"includes\" prefixing the definition, interpreted as \"and other dates\" in the property description."""@en;
             rdfs:domain frbrer:C1005;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene fechas de persona"@es,
                        "has dates of person"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a person to the precise or approximate date of the person's birth and, or, death, or dates indicating the period in which the person was known to be active in a given field of endeavour, and other dates."@en.
frbrer:P3041 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTitleOfPerson"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1005;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene calificativo de persona"@es,
                        "has title of person"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a person to a word or phrase indicative of rank, office, nobility, honour, etc., or a term of address associated with the person."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., Major, Premier, Duke, etc.; Sir, Mrs., etc."@en.
frbrer:P3042 <http://metadataregistry.org/uri/profile/RegAp/name> "hasOtherDesignationAssociatedWithThePerson"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1005;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene otras designaciones asociadas con la persona"@es,
                        "has other designation associated with the person"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a person to a numeral, word, or abbreviation indicating succession within a family or dynasty, or an epithet or other word or phrase associated with the person."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., III, Jr., etc.; the Brave, Professional Engineer, etc."@en.
frbrer:P3043 <http://metadataregistry.org/uri/profile/RegAp/name> "hasNameOfTheCorporateBody"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1006;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene nombre de entidad corporativa"@es,
                        "has name of the corporate body"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a corporate body to the word, phrase, character, or group of words and, or, characters by which the body is known."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., Royal Aeronautical Society, IBM, SÃ©minaire europÃ©en sur la recherche en Ã©ducation, Friedrich Witte, etc. A corporate body may be known by more than one name, or more than one form of the same name. A bibliographic agency normally selects one of those names as the uniform heading for purposes of consistency in naming and referencing the corporate body. The other names or forms of name may be treated as variant names for the corporate body. In some cases (e.g., in the case where a corporate body is known by different names at different periods in its history) the bibliographic agency may establish more than one uniform heading for the corporate body."@en.
frbrer:P3044 <http://metadataregistry.org/uri/profile/RegAp/name> "hasNumberAssociatedWithTheCorporateBody"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1006;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene nÃºmero asociado a la entidad corporativa"@es,
                        "has number associated with the corporate body"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a corporate body to the numerical designation sequencing a meeting, conference, exhibition, fair, etc. that constitutes one of a series of related meetings, conferences, exhibitions, fairs, etc., or any other numerical designation associated with a corporate body."@en.
frbrer:P3045 <http://metadataregistry.org/uri/profile/RegAp/name> "hasPlaceAssociatedWithTheCorporateBody"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1006;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene lugar asociado a la entidad corporativa"@es,
                        "has place associated with the corporate body"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a corporate body to the city, town, or other designation of location in which a meeting, conference, exhibition, fair, etc. was held, or the location with which the corporate body is otherwise associated."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., Los Angeles, Bretton Woods, Oxford University, etc. The place may comprise the name of the state, province, territory, and, or, country as well as the local place name."@en.
frbrer:P3046 <http://metadataregistry.org/uri/profile/RegAp/name> "hasDateAssociatedWithTheCorporateBody"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1006;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene fecha asociada a la entidad corporativa"@es,
                        "has date associated with the corporate body"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a corporate body to the date or range of dates on which a meeting, conference, exhibition, fair, etc. was held, or a date with which the corporate body is otherwise associated."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., the date of incorporation."@en.
frbrer:P3047 <http://metadataregistry.org/uri/profile/RegAp/name> "hasOtherDesignationAssociatedWithTheCorporateBody"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1006;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene otra designaciÃ³n asociada a la entidad corporativa"@es,
                        "has other designation associated with the corporate body"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a corporate body to a word, phrase, or abbreviation indicating incorporation or legal status of the body, or any term serving to differentiate the body from other corporate bodies, persons, etc."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., Inc., Ltd., etc.; firm, musical group, etc."@en.
frbrer:P3048 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTermForTheConcept"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1007;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene tÃ©rmino del concepto"@es,
                        "has term for the concept"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a concept to the word, phrase, or group of characters used to name or designate the concept."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., economics, existentialism, radioactivity, etc. A concept may be designated by more than one term, or by more than one form of the term. A bibliographic agency normally selects one of those terms as the uniform heading for purposes of consistency in naming and referencing the concept. The other terms or forms of term may be treated as variant terms for the concept."@en.
frbrer:P3049 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTermForTheObject"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1008;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene tÃ©rmino del objeto"@es,
                        "has term for the object"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an object to the word, phrase, or group of characters used to name or designate the object."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., a building, a ship, etc. An object may be designated by more than one term, or by more than one form of the term. A bibliographic agency normally selects one of those terms as the uniform heading for purposes of consistency in naming and referencing the object. The other terms or forms of term may be treated as variant terms for the object."@en.
frbrer:P3050 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTermForTheEvent"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1009;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene tÃ©rmino del acontecimiento"@es,
                        "has term for the event"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an event to the word, phrase, or group of characters used to name or designate the event."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., Battle of Hastings, Tour de France, etc. An event may be designated by more than one term, or by more than one form of the term. A bibliographic agency normally selects one of those terms as the uniform heading for purposes of consistency in naming and referencing the event. The other terms or forms of term may be treated as variant terms for the event."@en.
frbrer:P3051 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTermForThePlace"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1010;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene tÃ©rmino del lugar"@es,
                        "has term for the place"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a place to the word, phrase, or group of characters used to name or designate the place."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., London, St. Lawrence River, etc. A place may be designated by more than one term, or by more than one form of the term. A bibliographic agency normally selects one of those terms as the uniform heading for purposes of consistency in naming and referencing the place. The other terms or forms of term may be treated as variant terms for the place."@en.
frbrer:P3052 <http://metadataregistry.org/uri/profile/RegAp/name> "hasMarksOrInscriptions"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:comment """Source documentation has \"marks/inscriptions\"; slash character replaced with \"or\" to improve clarity."""@en;
             rdfs:domain frbrer:C1004;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene marcas o inscripciones"@es,
                        "has marks or inscriptions"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an item to any signatures, numbering, annotations, etc. that have been applied uniquely to the item by the artist, fabricator, owner, etc., and other marks and inscriptions."@en.
frbrer:P3053 <http://metadataregistry.org/uri/profile/RegAp/name> "hasSourceForAcquisitionOrAccessAuthorization"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:comment """Source documentation has \"acquisition/access\"; slash character replaced with \"or\" to improve clarity."""@en;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene fuente de adquisiciÃ³n o autorizaciÃ³n para el acceso"@es,
                        "has source for acquisition or access authorization"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to the name of a publisher, distributor, etc. indicated in the manifestation as the source from which the manifestation may be acquired or through whom access may be authorized."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The source for acquisition/access authorization will normally also include an address for the publisher, distributor, etc. A manifestation may be associated with one or more sources."@en.
frbrer:P3054 <http://metadataregistry.org/uri/profile/RegAp/name> "hasFabricatorOrManufacturer"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:comment """Source documentation has \"fabricator/manufacturer\"; slash character replaced with \"or\" to improve clarity."""@en;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "has fabricator or manufacturer"@en,
                        "tiene fabricante o productor"@es;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to the individual, group, or organization named in the manifestation as being responsible for the fabrication or manufacture of the manifestation."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "A manifestation may be associated with one or more fabricators or manufacturers."@en.
frbrer:P3055 <http://metadataregistry.org/uri/profile/RegAp/name> "hasDateOfPublicationOrDistribution"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:comment """Source documentation has \"publication/distribution\"; slash character replaced with \"or\" to improve clarity."""@en;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene fecha de publicaciÃ³n o distribuciÃ³n"@es,
                        "has date of publication or distribution"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to the date of public release of the manifestation."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The date (normally a year) may be a single date of publication or release, or a range of dates (e.g., in the case of a serial publication). In the absence of a date designated as the date of publication or release, a copyright date or a date of printing or manufacture may serve as a substitute."@en.
frbrer:P3056 <http://metadataregistry.org/uri/profile/RegAp/name> "hasPublisherOrDistributor"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:comment """Source documentation has \"publisher/distributor\"; slash character replaced with \"or\" to improve clarity."""@en;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "has publisher or distributor"@en,
                        "tiene editor o distribuidor"@es;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to the individual, group, or organization named in the manifestation as being responsible for the publication, distribution, issuing, or release of the manifestation."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "A manifestation may be associated with one or more publishers or distributors."@en.
frbrer:P3057 <http://metadataregistry.org/uri/profile/RegAp/name> "hasPlaceOfPublicationOrDistribution"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:comment """Source documentation has \"publication/distribution\"; slash character replaced with \"or\" to improve clarity."""@en;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "has place of publication or distribution"@en,
                        "tiene lugar de publicaciÃ³n o distribuciÃ³n"@es;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to the city, town, or other locality associated in the manifestation with the name of the publisher or distributor."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The place of publication may comprise the name of the state, province, territory, and/or country as well as the local place name. A manifestation may be associated with one or more places of publication or distribution."@en.
frbrer:P3058 <http://metadataregistry.org/uri/profile/RegAp/name> "hasEditionOrIssueDesignation"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:comment """Source documentation has \"edition/issue\"; slash character replaced with \"or\" to improve clarity."""@en;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "has edition or issue designation"@en,
                        "tiene designaciÃ³n de ediciÃ³n o emisiÃ³n"@es;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to a word or phrase appearing in the manifestation that normally indicates a difference in either content or form between the manifestation and a related manifestation previously issued by the same publisher/distributor, or simultaneously issued by either the same publisher/distributor or another publisher/distributor."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The edition/issue designation pertains to all copies of a manifestation produced from substantially the same master and issued by the same publisher/distributor or group of publishers/distributors."@en.
frbrer:P3059 <http://metadataregistry.org/uri/profile/RegAp/name> "hasMediumOfPerformanceMusicalWork"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1001;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene medio de interpretaciÃ³n (obra musical)"@es,
                        "has medium of performance (musical work)"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a work that is musical to the instrumental, vocal, and, or, other medium of performance for which the work was originally intended."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., piano, violin, orchestra, men's voices, etc."@en.
frbrer:P3060 <http://metadataregistry.org/uri/profile/RegAp/name> "hasNumericDesignationMusicalWork"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1001;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene designaciÃ³n numÃ©rica (obra musical)"@es,
                        "has numeric designation (musical work)"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a work that is musical to a serial number, opus number, or thematic index number assigned to thel work by the composer, publisher, or a musicologist."@en.
frbrer:P3061 <http://metadataregistry.org/uri/profile/RegAp/name> "hasKeyMusicalWork"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1001;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene clave (obra musical)"@es,
                        "has key (musical work)"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a work that is musical to the set of pitch relationships that establishes a single pitch class as a tonal centre."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The key for a musical work is the key in which the work is originally composed."@en.
frbrer:P3062 <http://metadataregistry.org/uri/profile/RegAp/name> "hasCoordinatesCartographicWork"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1001;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene coordenadas (obra cartogrÃ¡fica)"@es,
                        "has coordinates (cartographic work)"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a work that is cartographic to the degrees, minutes, and seconds of longitude and latitude, or the angles of declination and ascension that form the outer boundaries for the area represented in the cartographic image or object."@en.
frbrer:P3063 <http://metadataregistry.org/uri/profile/RegAp/name> "hasEquinoxCartographicWork"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1001;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene equinoccio (obra cartogrÃ¡fica)"@es,
                        "has equinox (cartographic work)"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a work that is cartographic to the year that serves as the point of reference for a celestial chart or model."@en.
frbrer:P3064 <http://metadataregistry.org/uri/profile/RegAp/name> "hasSequencingPatternSerial"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene modelo de secuencia (publicaciÃ³n seriada)"@es,
                        "has sequencing pattern (serial)"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression issued as a serial to the form anticipated to be used in designating volumes, issues, etc. and, or, dates for the individual units of the serial."@en.
frbrer:P3065 <http://metadataregistry.org/uri/profile/RegAp/name> "hasExpectedRegularityOfIssueSerial"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene regularidad prevista de la publicaciÃ³n (publicaciÃ³n seriada)"@es,
                        "has expected regularity of issue (serial)"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression issued as a serial to the anticipated regularity of release of individual issues (i.e., whether the release is expected to be regular or irregular)."@en.
frbrer:P3066 <http://metadataregistry.org/uri/profile/RegAp/name> "hasExpectedFrequencyOfIssueSerial"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene frecuencia de publicaciÃ³n prevista (publicaciÃ³n seriada)"@es,
                        "has expected frequency of issue (serial)"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression issued as a serial to the interval at which individual issues of the serial are anticipated to be released."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., weekly, monthly, quarterly, annually, etc."@en.
frbrer:P3067 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTypeOfScoreMusicalNotation"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene tipo de partitura (notaciÃ³n musical)"@es,
                        "has type of score (musical notation)"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression that is a musical notation to the format used to represent a musical composition."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., short score, full score, condensed score, close score, etc."@en.
frbrer:P3068 <http://metadataregistry.org/uri/profile/RegAp/name> "hasMediumOfPerformanceMusicalNotationExpressionOrRecordedSound"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene medio de interpretaciÃ³n (notaciÃ³n musical o registro sonoro)"@es,
                        "has medium of performance (musical notation or recorded sound)"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression that is a musical notation or recorded sound to the instrumental and, or, vocal medium of performance of a musical work represented in the expression. The instruments and, or, voices represented in a particular expression of a work may differ from the medium of performance for which the work was originally intended."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., two pianos, soprano and alto, etc."@en.
frbrer:P3070 <http://metadataregistry.org/uri/profile/RegAp/name> "hasRecordingTechniqueRemoteSensingImage"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene tÃ©cnica de grabaciÃ³n (imagen sensible remota)"@es,
