             rdfs:range frbrer:C1003;
             <http://www.w3.org/2002/07/owl#inverseOf> frbrer:P2086;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to another manifestation that is a component of the manifestation."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The component manifestation may be a discrete physical unit of the prior manifestation or may be an integral part that is physically inseparable from the whole of the prior expression."@en.
frbrer:P2086 <http://metadataregistry.org/uri/profile/RegAp/name> "isPartManifestationOf"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "forma parte (manifestaciÃ³n) de"@es,
                        "is part (manifestation) of"@en;
             rdfs:range frbrer:C1003;
             <http://www.w3.org/2002/07/owl#inverseOf> frbrer:P2085;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation to another manifestation of which it is a component."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The component manifestation may be a discrete physical unit of the prior manifestation or may be an integral part that is physically inseparable from the whole of the prior manifestation."@en.
frbrer:P2087 <http://metadataregistry.org/uri/profile/RegAp/name> "hasAReconfiguration"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:comment """Source documentation has label \"has reconfiguration\", amended to improve consistency."""@en;
             rdfs:domain frbrer:C1004;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "has a reconfiguration"@en,
                        "tiene reconfiguraciÃ³n"@es;
             rdfs:range frbrer:C1004;
             <http://www.w3.org/2002/07/owl#inverseOf> frbrer:P2088;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an item to another item that is the result of a change to the prior item. The reconfiguration item may be the result of changes to more than one prior item."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Most commonly, an item of one manifestation is bound with an item of a different manifestation to make a new item."@en.
frbrer:P2088 <http://metadataregistry.org/uri/profile/RegAp/name> "isAReconfigurationOf"@en;
