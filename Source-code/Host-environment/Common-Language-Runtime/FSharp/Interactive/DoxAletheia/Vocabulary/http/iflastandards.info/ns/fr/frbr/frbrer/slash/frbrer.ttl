frbrer:P3076 <http://metadataregistry.org/uri/profile/RegAp/name> "hasFoliationHandPrintedBook"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene foliaciÃ³n (imprenta manual)"@es,
