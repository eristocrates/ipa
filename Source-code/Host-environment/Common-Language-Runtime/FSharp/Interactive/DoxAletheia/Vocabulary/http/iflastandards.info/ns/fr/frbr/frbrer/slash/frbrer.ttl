             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "has system requirements (electronic resource)"@en,
                        "tiene requisitos del sistema (recurso electrÃ³nico)"@es;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation that is an electronic resource to requirements related to hardware, software, and peripherals, and other system components."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> " E.g., machine make and model, RAM capacity, etc. E.g., operating systems, programming language, supporting software, etc. Peripherals include monitor, printer, mouse, etc."@en.
frbrer:P3094 <http://metadataregistry.org/uri/profile/RegAp/name> "hasFileCharacteristicsElectronicResource"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:comment """Source documentation has \"include\" prefixing the definition, removed for being redundant with respect to \"and other characteristics\" in the property description."""@en;
             rdfs:domain frbrer:C1003;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "has file characteristics (electronic resource)"@en,
                        "tiene caracterÃ­sticas del archivo (recurso electrÃ³nico)"@es;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a manifestation that is an electronic resource to standards or schemes used to encode the file, physical characteristics of the file, and other characteristics that have a bearing on how the file can be processed."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., ASCII, SGML, etc. E.g., recording density, parity, blocking, etc."@en.
frbrer:P3095 <http://metadataregistry.org/uri/profile/RegAp/name> "hasModeOfAccessRemoteElectronicResource"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
