             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene tÃ©cnica de presentaciÃ³n (imagen cartogrÃ¡fica u objeto)"@es,
                        "has presentation technique (cartographic image or object)"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression that is cartographic to the method used to represent geographic or other features in a cartographic image."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "E.g., anaglyphic, diagrammatic, pictorial, etc."@en.
frbrer:P3100 <http://metadataregistry.org/uri/profile/RegAp/name> "hasRepresentationOfReliefCartographicImageOrObject"@en;
