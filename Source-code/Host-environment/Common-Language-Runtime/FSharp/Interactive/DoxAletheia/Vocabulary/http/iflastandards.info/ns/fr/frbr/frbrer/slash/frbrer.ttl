             <http://www.w3.org/2002/07/owl#inverseOf> frbrer:P2009;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a person to a work of which they are responsible for the creation of the intellectual or artistic content."@en.
frbrer:P2011 <http://metadataregistry.org/uri/profile/RegAp/name> "isRealizedByCorporateBody"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "estÃ¡ realizado por (entidad corporativa)"@es,
                        "is realized by (corporate body)"@en;
             rdfs:range frbrer:C1006;
             <http://www.w3.org/2002/07/owl#inverseOf> frbrer:P2012;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a corporate body that is responsible for the specifics of the intellectual or artistic realization or execution of the expression."@en.
frbrer:P2012 <http://metadataregistry.org/uri/profile/RegAp/name> "isRealizerCorporateBodyOf"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1006;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "es realizador (entidad corporativa) de"@es,
                        "is realizer (corporate body) of"@en;
             rdfs:range frbrer:C1002;
             <http://www.w3.org/2002/07/owl#inverseOf> frbrer:P2011;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a corporate body to an expression of which it is responsible for the specifics of the intellectual or artistic realization or execution."@en.
frbrer:P2013 <http://metadataregistry.org/uri/profile/RegAp/name> "isRealizedByPerson"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "is realized by (person)"@en,
                        "estÃ¡ realizado por (persona)"@es;
