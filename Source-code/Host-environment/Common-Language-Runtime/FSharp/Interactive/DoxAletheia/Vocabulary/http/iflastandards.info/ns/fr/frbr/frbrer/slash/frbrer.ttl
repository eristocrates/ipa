             rdfs:domain frbrer:C1004;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "es reconfiguraciÃ³n de"@es,
                        "is a reconfiguration of"@en;
             rdfs:range frbrer:C1004;
             <http://www.w3.org/2002/07/owl#inverseOf> frbrer:P2087;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an item to another item to which it is the result of a change. The reconfiguration item may be the result of changes to more than one prior item."@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Most commonly, an item of one manifestation is bound with an item of a different manifestation to make a new item."@en.
frbrer:P2089 <http://metadataregistry.org/uri/profile/RegAp/name> "hasAReproductionItemFromItem"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:comment """Source documentation has label \"has reproduction\"; amended to improve consistency."""@en;
             rdfs:domain frbrer:C1004;
             rdfs:isDefinedBy frbrer:;
