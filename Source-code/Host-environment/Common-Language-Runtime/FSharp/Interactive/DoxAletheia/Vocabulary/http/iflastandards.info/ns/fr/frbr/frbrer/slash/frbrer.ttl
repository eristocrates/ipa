             <http://www.w3.org/2004/02/skos/core#definition> "Relates a work to a person who is responsible for the creation of the intellectual or artistic content of the work."@en.
frbrer:P2010 <http://metadataregistry.org/uri/profile/RegAp/name> "isCreatorPersonOf"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1005;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "es creador (persona) de"@es,
