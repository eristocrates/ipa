frbrer:P2103 <http://metadataregistry.org/uri/profile/RegAp/name> "hasAnAdaptationWorkFromExpression"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
             rdfs:domain frbrer:C1002;
             rdfs:isDefinedBy frbrer:;
             rdfs:label "tiene adaptaciÃ³n (obra) (de expresiÃ³n)"@es,
