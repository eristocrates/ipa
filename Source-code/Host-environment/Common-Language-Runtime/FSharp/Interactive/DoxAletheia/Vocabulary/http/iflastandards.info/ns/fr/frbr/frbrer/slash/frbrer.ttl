frbrer:P2105 <http://metadataregistry.org/uri/profile/RegAp/name> "hasATransformationWorkFromExpression"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
             a rdf:Property;
