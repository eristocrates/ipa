                                               a owl:Ontology;
                                               owl:imports ucum:;
                                               owl:priorVersion "3.2.10";
                                               owl:versionInfo "3.2.11";
                                               foaf:primaryTopic "Domotic Systems".
dogont:AccessControlSystem a owl:Class;
                           rdfs:comment "System that provides security about access";
                           rdfs:label "AccessControlSystem";
                           rdfs:subClassOf dogont:SecuritySystem;
                           owl:disjointWith dogont:FireSystem,
                                            dogont:FloodSystem,
                                            dogont:GasSystem.
dogont:Acoustic a owl:Class;
                rdfs:subClassOf [owl:onProperty dogont:isIn ; 
                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                dogont:ElectricalSystem;
                owl:disjointWith dogont:Actuator,
                                 dogont:Control,
                                 dogont:Lighting,
                                 dogont:PowerDelivery,
                                 dogont:Sensor.
dogont:ActiveDiscoveryStateValue a owl:Class;
                                 rdfs:subClassOf [owl:onProperty dogont:realStateValue ; 
                                                  owl:hasValue "searching" ; 
                                                  a owl:Restriction],
                                                 dogont:DiscreteValue.
dogont:ActiveEnergyMeasurementFunctionality a owl:Class;
                                            rdfs:subClassOf dogont:EnergyMeasurementFunctionality.
dogont:ActiveEnergyMeasurementNotificationFunctionality a owl:Class;
                                                        rdfs:subClassOf dogont:EnergyMeasurementNotificationFunctionality.
dogont:ActiveEnergyStateValue a owl:Class;
                              rdfs:subClassOf [owl:onProperty dogont:phaseID ; 
                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                               a owl:Restriction],
                                              dogont:ContinuousValue;
                              owl:disjointWith dogont:ChannelStateValue,
                                               dogont:PressureStateValue,
                                               dogont:TemperatureStateValue,
                                               dogont:FlowRateStateValue,
                                               dogont:ShadeStateValue,
                                               dogont:HumidityStateValue,
                                               dogont:CurrentStateValue,
                                               dogont:LevelStateValue,
                                               dogont:ReactiveEnergyStateValue.
dogont:ActivePowerMeasurementFunctionality a owl:Class;
                                           rdfs:subClassOf dogont:PowerMeasurementFunctionality.
dogont:ActivePowerMeasurementNotificationFunctionality a owl:Class;
                                                       rdfs:subClassOf dogont:ElectricPowerMeasurementNotificationFunctionality.
dogont:ActivePowerMeasurementState a owl:Class;
                                   rdfs:subClassOf dogont:ElectricPowerMeasurementState.
dogont:ActivePowerMeter a owl:Class;
                        rdfs:subClassOf dogont:PowerMeter.
dogont:ActivePowerStateValue a owl:Class;
                             rdfs:subClassOf [owl:onProperty dogont:phaseID ; 
                                              owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                              a owl:Restriction],
                                             dogont:ContinuousValue.
dogont:ActivePushLinkAuthenticationStateValue a owl:Class;
                                              rdfs:subClassOf [owl:onProperty dogont:realStateValue ; 
                                                               owl:hasValue "authenticating" ; 
                                                               a owl:Restriction],
                                                              dogont:DiscreteValue.
dogont:Actuator a owl:Class;
                rdfs:comment "A mechanism that puts something into automatic action";
                rdfs:label "Actuator";
                rdfs:subClassOf [owl:onProperty dogont:isIn ; 
                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                dogont:ElectricalSystem;
                owl:disjointWith dogont:Lighting,
                                 dogont:PowerDelivery,
                                 dogont:Sensor.
dogont:AirConditioningSystem a owl:Class;
                             rdfs:comment "A system that keeps air cool and dry";
                             rdfs:label "AirConditioningSystem";
                             rdfs:subClassOf [owl:someValuesFrom dogont:ThermostatNotificationFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:OnOffFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction],
                                             dogont:HVACSystem,
                                             [owl:someValuesFrom dogont:OnOffState ; 
                                              owl:onProperty dogont:hasState ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:OnOffNotificationFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction],
                                             [owl:onProperty dogont:hasState ; 
                                              owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:ThermostatControlFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction];
                             owl:disjointWith dogont:PressureSensor,
                                              dogont:Pump,
                                              dogont:PumpController,
                                              dogont:VentilatingSystem,
                                              dogont:Thermostat,
                                              dogont:HeatingSystem,
                                              dogont:SingleFlowSensor,
                                              dogont:HeatingAndCoolingUnit.
dogont:AlarmClock a owl:Class;
                  rdfs:comment "A clock that wakes sleeper at preset time";
                  rdfs:label "AlarmClock";
