dogont:HeatingApplianceState a owl:Class;
                             rdfs:subClassOf [owl:someValuesFrom dogont:SuperHeatingStateValue ; 
                                              owl:onProperty dogont:hasStateValue ; 
                                              a owl:Restriction],
