                                           dogont:PanDownCommand,
                                           dogont:GetTemperatureMCommand,
                                           dogont:SetSecondsCommand,
                                           dogont:IncreaseContrastCommand,
                                           dogont:GetLuminanceCommand,
                                           dogont:PanLeftCommand.
dogont:DeleteSceneNotification a owl:Class;
                               rdfs:subClassOf [owl:onProperty dogont:nParams ; 
                                                owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                a owl:Restriction],
                                               dogont:ParametricNotification,
                                               dogont:NetworkNotification,
                                               [owl:onProperty dogont:notificationParamName ; 
                                                owl:hasValue "sceneNumber^^Integer" ; 
                                                a owl:Restriction],
