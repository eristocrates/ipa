                           rdfs:subClassOf [owl:onProperty dogont:realCommandName ; 
                                            owl:hasValue "getOccupancy" ; 
                                            a owl:Restriction],
                                           dogont:NonVoidCommand,
                                           dogont:NonParametricCommand,
                                           [owl:onProperty dogont:returnType ; 
                                            owl:hasValue "Boolean" ; 
                                            a owl:Restriction];
                           owl:disjointWith dogont:RewindCommand,
                                            dogont:ZoomOutCommand,
                                            dogont:SpeedUpCommand,
                                            dogont:StepUpCommand,
                                            dogont:NextTrackCommand,
                                            dogont:StopHeatingCoolingCommand,
                                            dogont:PreviousTrackCommand,
                                            dogont:ToggleCommand,
                                            dogont:GetPressureCommand,
                                            dogont:PanUpCommand,
                                            dogont:GetRelativeHumidityMCommand,
                                            dogont:UpCommand,
                                            dogont:GetTemperatureCommand,
                                            dogont:GetRelativeHumidityCommand,
                                            dogont:HeatCommand,
                                            dogont:PanRightCommand,
                                            dogont:StandBy,
                                            dogont:PanDownCommand,
                                            dogont:SpeedDownCommand,
                                            dogont:OffFlashingCommand,
                                            dogont:OnFlashingCommand,
                                            dogont:GetPressureMCommand,
                                            dogont:IncreaseQualityCommand,
                                            dogont:ZoomInCommand,
                                            dogont:GetTemperatureMCommand,
                                            dogont:RestCommand,
                                            dogont:GrabPictureCommand,
                                            dogont:PlayCommand,
                                            dogont:StopPlayingCommand,
                                            dogont:PanLeftCommand,
                                            dogont:IncreaseContrastCommand,
                                            dogont:IncreaseColorCommand,
                                            dogont:PauseCommand,
                                            dogont:StepDownCommand,
                                            dogont:OpenCommand,
                                            dogont:IncreaseLuminosityCommand,
                                            dogont:OnCommand,
                                            dogont:OffCommand.
dogont:GetPowerFactorCommand a owl:Class;
                             rdfs:subClassOf [owl:onProperty dogont:returnType ; 
                                              owl:hasValue "Measure" ; 
                                              a owl:Restriction],
                                             [owl:onProperty dogont:realCommandName ; 
                                              owl:hasValue "getPowerFactor" ; 
                                              a owl:Restriction],
                                             dogont:NonParametricCommand,
                                             dogont:NonVoidCommand.
dogont:GetPressureCommand a owl:Class;
                          rdfs:subClassOf dogont:NonParametricCommand,
