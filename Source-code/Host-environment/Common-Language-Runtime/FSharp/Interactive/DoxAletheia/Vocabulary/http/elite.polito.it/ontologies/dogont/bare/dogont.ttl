                                               a owl:Restriction],
                                              dogont:DiscreteValue.
dogont:DiscoveryActiveNotification a owl:Class;
                                   rdfs:subClassOf [owl:onProperty dogont:notificationName ; 
                                                    owl:hasValue "activatedDiscovery" ; 
                                                    a owl:Restriction],
                                                   dogont:HueNotification.
dogont:DiscoveryFunctionality a owl:Class;
                              rdfs:subClassOf [owl:someValuesFrom dogont:StartDiscoveryCommand ; 
                                               owl:onProperty dogont:hasCommand ; 
                                               a owl:Restriction],
                                              [owl:someValuesFrom dogont:StopDiscoveryCommand ; 
                                               owl:onProperty dogont:hasCommand ; 
                                               a owl:Restriction],
                                              dogont:NetworkFunctionality.
dogont:DiscoveryIdleNotification a owl:Class;
                                 rdfs:subClassOf [owl:onProperty dogont:notificationName ; 
