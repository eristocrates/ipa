dogont:AuxStateValue a owl:Class;
                     rdfs:subClassOf [owl:onProperty dogont:realStateValue ; 
                                      owl:hasValue "aux" ; 
                                      a owl:Restriction],
                                     dogont:DiscreteValue.
dogont:Awning a owl:Class;
              rdfs:comment "A canopy made of canvas to shelter people or things from rain or sun.";
              rdfs:label "Awning";
              rdfs:subClassOf [owl:onProperty dogont:hasActuator ; 
                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction],
                              dogont:Furniture,
                              [owl:onProperty dogont:hasActuator ; 
                               owl:allValuesFrom dogont:AwningActuator ; 
                               a owl:Restriction];
              owl:disjointWith dogont:Nightstand,
                               dogont:Sofa,
                               dogont:Drawer,
                               dogont:Shade,
                               dogont:Bed,
                               dogont:Cupboard,
                               dogont:Closet,
                               dogont:Desk,
                               dogont:SanitaryFixtures,
                               dogont:Shutter,
                               dogont:Wardrobe,
                               dogont:Chair,
                               dogont:Table.
dogont:AwningActuator a owl:Class;
                      rdfs:comment "A mechanism that allow automatic control about awning";
                      rdfs:label "AwningActuator";
                      rdfs:subClassOf [owl:someValuesFrom dogont:OpenCloseFunctionality ; 
                                       owl:onProperty dogont:hasFunctionality ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom dogont:OpenCloseState ; 
                                       owl:onProperty dogont:hasState ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom dogont:MovementState ; 
                                       owl:onProperty dogont:hasState ; 
                                       a owl:Restriction],
                                      [owl:onProperty dogont:actuatorOf ; 
                                       owl:allValuesFrom dogont:Awning ; 
                                       a owl:Restriction],
                                      dogont:Actuator,
                                      [owl:someValuesFrom dogont:OpenCloseNotificationFunctionality ; 
                                       owl:onProperty dogont:hasFunctionality ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom dogont:MovementNotificationFunctionality ; 
                                       owl:onProperty dogont:hasFunctionality ; 
                                       a owl:Restriction];
                      owl:disjointWith dogont:WindowActuator,
                                       dogont:DoorActuator,
                                       dogont:GateActuator,
                                       dogont:ShadeActuator,
                                       dogont:Pump,
                                       dogont:ShutterActuator.
dogont:BTicinoComponent a owl:Class;
                        rdfs:comment "Components manufactured by Bticino";
                        rdfs:label "BTicinoComponent";
                        rdfs:subClassOf [owl:onProperty dogont:physicalAddress ; 
                                         owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                         a owl:Restriction],
                                        [owl:onProperty dogont:physicalType ; 
                                         owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                         a owl:Restriction],
                                        dogont:NetworkComponent;
                        owl:disjointWith dogont:EliteComponent,
                                         dogont:KonnexComponent,
                                         dogont:ZigBeeComponent.
dogont:BTicinoGateway a owl:Class;
                      rdfs:comment "A BTIcino Gateway";
                      rdfs:label "BTicinoGateway";
                      rdfs:subClassOf [owl:onProperty dogont:IPAddress ; 
                                       owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                       a owl:Restriction],
