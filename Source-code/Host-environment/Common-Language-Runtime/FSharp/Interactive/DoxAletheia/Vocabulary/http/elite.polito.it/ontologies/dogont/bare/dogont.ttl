dogont:ForwardNotification a owl:Class;
                           rdfs:subClassOf [owl:onProperty dogont:notificationName ; 
                                            owl:hasValue "fwd" ; 
                                            a owl:Restriction],
                                           dogont:PlaybackNotification.
dogont:ForwardStateValue a owl:Class;
                         rdfs:subClassOf [owl:onProperty dogont:realStateValue ; 
                                          owl:hasValue "forward" ; 
                                          a owl:Restriction],
                                         dogont:DiscreteValue.
dogont:FreeStateValue a owl:Class;
