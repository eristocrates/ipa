dogont:ElectricityMeter a owl:Class;
                        rdfs:subClassOf dogont:Meter.
dogont:EliteComponent a owl:Class;
                      rdfs:comment "Emulated component";
                      rdfs:label "EliteComponent";
                      rdfs:subClassOf dogont:NetworkComponent;
                      owl:disjointWith dogont:KonnexComponent,
                                       dogont:ZigBeeComponent.
dogont:EliteGateway a owl:Class;
                    rdfs:comment "A software emulator of a network level to be used for simulating devices not available in the real world"@en;
                    rdfs:label "EliteGateway"@en;
                    rdfs:subClassOf dogont:EliteComponent;
                    owl:disjointWith dogont:KonnexGateway.
dogont:EmittingMicrowavesNotification a owl:Class;
                                      rdfs:subClassOf [owl:onProperty dogont:notificationName ; 
                                                       owl:hasValue "emittingMicrowaves" ; 
                                                       a owl:Restriction],
                                                      dogont:NonParametricNotification.
dogont:EmittingMicrowavesStateValue a owl:Class;
                                    rdfs:subClassOf [owl:onProperty dogont:realStateValue ; 
                                                     owl:hasValue "emittingMicrowaves" ; 
                                                     a owl:Restriction],
                                                    dogont:DiscreteValue.
dogont:EnableDisableGasFunctionality a owl:Class;
                                     rdfs:subClassOf [owl:someValuesFrom dogont:DisableGasCommand ; 
                                                      owl:onProperty dogont:hasCommand ; 
                                                      a owl:Restriction],
                                                     [owl:someValuesFrom dogont:EnableGasCommand ; 
                                                      owl:onProperty dogont:hasCommand ; 
                                                      a owl:Restriction],
                                                     dogont:DoubleValuedFunctionality.
dogont:EnableGasCommand a owl:Class;
                        rdfs:subClassOf [owl:onProperty dogont:realCommandName ; 
                                         owl:hasValue "disableGas" ; 
                                         a owl:Restriction],
                                        dogont:NonParametricCommand,
                                        dogont:VoidCommand.
dogont:EndProgrammedStateValue a owl:Class;
                               rdfs:subClassOf [owl:onProperty dogont:realStateValue ; 
                                                owl:hasValue "endProgrammed" ; 
                                                a owl:Restriction],
                                               dogont:DiscreteValue.
dogont:EndTimeChangedNotification a owl:Class;
                                  rdfs:subClassOf [owl:onProperty dogont:notificationName ; 
                                                   owl:hasValue "changedEndTime" ; 
                                                   a owl:Restriction],
                                                  [owl:onProperty dogont:notificationParamName ; 
                                                   owl:hasValue "endTime^^Measure" ; 
                                                   a owl:Restriction],
                                                  [owl:onProperty dogont:nParams ; 
                                                   owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                   a owl:Restriction],
                                                  dogont:ApplianceCycleTimingNotification.
dogont:EnergyAndPowerMeter a owl:Class;
                           rdfs:subClassOf dogont:SinglePhaseActivePowerMeter,
                                           dogont:SinglePhaseEnergyMeter.
dogont:EnergyAndPowerMeteringLevelControllableOutput a owl:Class;
                                                     rdfs:subClassOf dogont:LevelControllableOutput,
                                                                     dogont:SinglePhaseActiveEnergyMeter,
                                                                     dogont:SinglePhaseActivePowerMeter.
dogont:EnergyMeasurementFunctionality a owl:Class;
                                      rdfs:subClassOf dogont:QueryFunctionality.
dogont:EnergyMeasurementNotificationFunctionality a owl:Class;
                                                  rdfs:subClassOf dogont:ContinuousNotificationFunctionality.
dogont:EnergyMeasurementState a owl:Class;
                              rdfs:subClassOf dogont:ContinuousState.
dogont:EnergyMeter a owl:Class;
                   rdfs:subClassOf dogont:ElectricityMeter.
dogont:EnergyMeteringPowerOutlet a owl:Class;
                                 rdfs:subClassOf dogont:MainsPowerOutlet,
                                                 dogont:SinglePhaseEnergyMeter.
dogont:Entertainment a owl:Class;
                     rdfs:comment "A diversion that holds the attention";
                     rdfs:label "Entertainment";
                     rdfs:subClassOf dogont:BrownGoods;
                     owl:disjointWith dogont:Fan,
                                      dogont:Printer.
dogont:Entrance a owl:Class;
                rdfs:subClassOf dogont:Door.
dogont:EventNotification a owl:Class;
                         rdfs:subClassOf [owl:onProperty dogont:notificationName ; 
                                          owl:hasValue "newEvent" ; 
                                          a owl:Restriction],
                                         [owl:onProperty dogont:nParams ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty dogont:notificationParamName ; 
                                          owl:hasValue "event^^Object" ; 
                                          a owl:Restriction],
                                         dogont:ParametricNotification.
dogont:EventNotificationFunctionality a owl:Class;
                                      rdfs:subClassOf [owl:someValuesFrom dogont:EventNotification ; 
                                                       owl:onProperty dogont:hasNotification ; 
                                                       a owl:Restriction],
                                                      dogont:SingleValuedNotificationFunctionality.
dogont:EventsAndAlertsNotificationFunctionality a owl:Class;
                                                rdfs:subClassOf dogont:MultipleAlertNotificationFunctionality,
                                                                dogont:MultipleEventNotificationFunctionality.
dogont:EventsAndAlertsQueryFunctionality a owl:Class;
