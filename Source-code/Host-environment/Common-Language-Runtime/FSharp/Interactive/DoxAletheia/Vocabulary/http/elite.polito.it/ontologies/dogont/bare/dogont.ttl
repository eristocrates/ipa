dogont:GroupFunctionality a owl:Class;
                          rdfs:comment "Derives from the general cluster functionalities defined in ZigBee HA specifications"@en;
                          rdfs:subClassOf [owl:onProperty dogont:hasCommand ; 
                                           owl:cardinality "2"^^xsd:nonNegativeInteger ; 
                                           a owl:Restriction],
                                          [owl:someValuesFrom dogont:DeleteGroupCommand ; 
                                           owl:onProperty dogont:hasCommand ; 
