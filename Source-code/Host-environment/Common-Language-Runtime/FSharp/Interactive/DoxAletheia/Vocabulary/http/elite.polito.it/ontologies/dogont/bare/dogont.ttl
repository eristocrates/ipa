                                                       dogont:SceneNotificationFunctionality.
dogont:HVACSystem a owl:Class;
                  rdfs:comment "Heating Ventilating and Air Conditioning system";
                  rdfs:label "HVACSystem";
                  rdfs:subClassOf dogont:HousePlants.
dogont:HeatCommand a owl:Class;
