dogont:AssociateCommand a owl:Class;
                        rdfs:subClassOf [owl:onProperty dogont:realCommandName ; 
                                         owl:hasValue "associate" ; 
                                         a owl:Restriction],
                                        dogont:NonParametricCommand,
                                        dogont:VoidCommand.
dogont:AssociateFunctionality a owl:Class;
                              rdfs:subClassOf [owl:someValuesFrom dogont:AssociateCommand ; 
                                               owl:onProperty dogont:hasCommand ; 
                                               a owl:Restriction],
