                                                          owl:onProperty dogont:hasCommand ; 
                                                          a owl:Restriction],
                                                         dogont:QueryFunctionality.
dogont:FailureStateValue a owl:Class;
                         rdfs:subClassOf [owl:onProperty dogont:realStateValue ; 
                                          owl:hasValue "failure" ; 
