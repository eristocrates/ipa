                                           a owl:Restriction],
                                          dogont:NetworkFunctionality;
                          owl:disjointWith dogont:IdentificationFunctionality,
                                           dogont:SceneFunctionality.
dogont:GroupNotificationFunctionality a owl:Class;
                                      rdfs:comment "Derives from the general cluster functionalities defined in ZigBee HA specifications"@en;
                                      rdfs:subClassOf [owl:someValuesFrom dogont:LeaveGroupNotification ; 
