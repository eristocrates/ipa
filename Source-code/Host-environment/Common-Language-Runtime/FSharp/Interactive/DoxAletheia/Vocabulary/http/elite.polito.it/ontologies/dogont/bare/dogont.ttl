                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom dogont:SceneNotificationFunctionality ; 
                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     [owl:onProperty dogont:actuatorOf ; 
                                      owl:allValuesFrom dogont:Shade ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom dogont:SimpleLevelNotificationFunctionality ; 
                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom dogont:OnOffNotificationFunctionality ; 
                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom dogont:SceneFunctionality ; 
                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom dogont:MovementNotificationFunctionality ; 
                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     dogont:Actuator,
                                     [owl:someValuesFrom dogont:ShadeState ; 
                                      owl:onProperty dogont:hasState ; 
                                      a owl:Restriction];
                     owl:disjointWith dogont:WindowActuator,
                                      dogont:ShutterActuator.
dogont:ShadeController a owl:Class;
