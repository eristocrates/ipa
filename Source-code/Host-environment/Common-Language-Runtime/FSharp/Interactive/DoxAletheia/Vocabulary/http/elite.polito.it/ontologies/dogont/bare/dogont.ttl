dogont:ApplianceManagementFunctionality a owl:Class;
                                        rdfs:subClassOf [owl:someValuesFrom dogont:DeleteApplianceCommand ; 
                                                         owl:onProperty dogont:hasCommand ; 
                                                         a owl:Restriction],
