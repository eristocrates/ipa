                                             owl:onProperty dogont:hasCommand ; 
                                             a owl:Restriction],
                                            dogont:DiscreteOutputFunctionality.
dogont:Door a owl:Class;
            rdfs:comment "A swinging or sliding barrier that will close the entrance to a room or building.";
            rdfs:label "Door";
            rdfs:subClassOf [owl:onProperty dogont:hasActuator ; 
                             owl:allValuesFrom dogont:DoorActuator ; 
                             a owl:Restriction],
                            [owl:onProperty dogont:hasSensor ; 
                             owl:allValuesFrom dogont:DoorSensor ; 
                             a owl:Restriction],
                            [owl:onProperty dogont:hasActuator ; 
                             owl:maxCardinality "2"^^xsd:nonNegativeInteger ; 
                             a owl:Restriction],
                            dogont:WallOpening;
            owl:disjointWith dogont:Window.
dogont:DoorActuator a owl:Class;
                    rdfs:comment "A mechanism that allow automatic opening and closing about door";
                    rdfs:label "DoorActuator";
                    rdfs:subClassOf [owl:someValuesFrom dogont:MovementNotificationFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:OpenCloseState ; 
                                     owl:onProperty dogont:hasState ; 
                                     a owl:Restriction],
                                    dogont:Actuator,
                                    [owl:someValuesFrom dogont:OpenCloseNotificationFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    [owl:onProperty dogont:actuatorOf ; 
                                     owl:allValuesFrom dogont:Door ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:MovementState ; 
                                     owl:onProperty dogont:hasState ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:OpenCloseFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction];
                    owl:disjointWith dogont:Pump,
                                     dogont:ShadeActuator,
                                     dogont:WindowActuator,
                                     dogont:GateActuator,
                                     dogont:ShutterActuator.
dogont:DoorSensor a owl:Class;
                  rdfs:comment "Sensor that controls if a door is closed";
                  rdfs:label "DoorSensor";
                  rdfs:subClassOf [owl:onProperty dogont:sensorOf ; 
                                   owl:allValuesFrom dogont:Door ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:OpenCloseState ; 
                                   owl:onProperty dogont:hasState ; 
                                   a owl:Restriction],
                                  [owl:onProperty dogont:sensorOf ; 
                                   owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                   a owl:Restriction],
                                  dogont:AntiIntrusionSystem,
                                  [owl:onProperty dogont:hasFunctionality ; 
                                   owl:cardinality "3"^^xsd:nonNegativeInteger ; 
                                   a owl:Restriction],
                                  dogont:Sensor,
                                  [owl:someValuesFrom dogont:OpenCloseNotificationFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction];
                  owl:disjointWith dogont:WindowSensor,
                                   dogont:InfraredSensor,
                                   dogont:SingleFlowSensor,
                                   dogont:SmokeSensor,
                                   dogont:FloodSensor,
                                   dogont:OccupancySensor,
                                   dogont:SurveillanceCamera,
                                   dogont:PressureSensor,
                                   dogont:GasSensor.
dogont:DoubleBed a owl:Class;
                 rdfs:subClassOf dogont:Bed;
                 owl:disjointWith dogont:SingleBed.
dogont:DoubleValuedFunctionality a owl:Class;
                                 rdfs:comment "Discrete functionalities with exactly two values";
                                 rdfs:label "DoubleValuedFunctionality";
                                 rdfs:subClassOf [owl:onProperty dogont:hasCommand ; 
                                                  owl:cardinality "2"^^xsd:nonNegativeInteger ; 
                                                  a owl:Restriction],
