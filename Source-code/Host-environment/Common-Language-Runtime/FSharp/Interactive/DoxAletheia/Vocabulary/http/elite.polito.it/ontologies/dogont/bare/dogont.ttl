                         rdfs:subClassOf [owl:onProperty dogont:phaseID ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         dogont:ContinuousValue.
dogont:VolumeLevelState a owl:Class;
                        rdfs:comment "Models the volume value";
                        rdfs:label "VolumeLevel";
                        rdfs:subClassOf dogont:LevelState.
dogont:VolumeRegulationFunctionality a owl:Class;
                                     rdfs:comment "Functionalities for the regulation of volume";
                                     rdfs:label "VolumeRegulationFunctionality";
                                     rdfs:subClassOf [owl:someValuesFrom dogont:DecreaseVolumeCommand ; 
                                                      owl:onProperty dogont:hasCommand ; 
                                                      a owl:Restriction],
                                                     [owl:someValuesFrom dogont:SetVolumeCommand ; 
                                                      owl:onProperty dogont:hasCommand ; 
                                                      a owl:Restriction],
                                                     [owl:someValuesFrom dogont:IncreaseVolumeCommand ; 
                                                      owl:onProperty dogont:hasCommand ; 
                                                      a owl:Restriction],
                                                     dogont:ContinuousControlFunctionality.
dogont:Wall a owl:Class;
            rdfs:comment "An architectural partition used to divide or enclose an area or to support another structure.";
            rdfs:label "Wall";
            rdfs:subClassOf dogont:Vertical;
            owl:disjointWith dogont:WallOpening.
dogont:WallOpening a owl:Class;
                   rdfs:comment "An opening in a Wall";
                   rdfs:label "WallOpening";
                   rdfs:subClassOf [owl:onProperty dogont:isInWall ; 
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction],
                                   dogont:Vertical.
dogont:Wardrobe a owl:Class;
                rdfs:comment "A tall piece of furniture that provides storage space for clothes";
                rdfs:label "Wardrobe";
                rdfs:subClassOf dogont:Furniture.
dogont:WashRinseStateValue a owl:Class;
                           rdfs:subClassOf [owl:onProperty dogont:realStateValue ; 
                                            owl:hasValue "washOrRinse" ; 
                                            a owl:Restriction],
                                           dogont:DiscreteValue.
dogont:Washbasin a owl:Class;
                 rdfs:comment "A basin for washing the hands";
                 rdfs:label "Washbasin";
                 rdfs:subClassOf dogont:SanitaryFixtures;
                 owl:disjointWith dogont:WaterCloset.
dogont:WashingApplianceState a owl:Class;
                             rdfs:subClassOf [owl:someValuesFrom dogont:WashRinseStateValue ; 
                                              owl:onProperty dogont:hasStateValue ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:RinseHoldStateValue ; 
                                              owl:onProperty dogont:hasStateValue ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:HeatingStateValue ; 
                                              owl:onProperty dogont:hasStateValue ; 
                                              a owl:Restriction],
                                             dogont:GenericApplianceState.
dogont:WashingCycleNotificationFunctionality a owl:Class;
                                             rdfs:subClassOf [owl:someValuesFrom dogont:StoppedWashingNotification ; 
                                                              owl:onProperty dogont:hasNotification ; 
                                                              a owl:Restriction],
                                                             [owl:someValuesFrom dogont:StartedWashingNotification ; 
                                                              owl:onProperty dogont:hasNotification ; 
                                                              a owl:Restriction],
                                                             dogont:DoubleValuedNotificationFunctionality.
dogont:WashingMachine a owl:Class;
                      rdfs:comment "A home appliance for washing clothes and linens automatically";
                      rdfs:label "WashingMachine";
                      rdfs:subClassOf [owl:someValuesFrom dogont:StartStopPauseNotificationFunctionality ; 
                                       owl:onProperty dogont:hasFunctionality ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom dogont:WashingCycleNotificationFunctionality ; 
                                       owl:onProperty dogont:hasFunctionality ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom dogont:HeatingCycleNotificationFunctionality ; 
                                       owl:onProperty dogont:hasFunctionality ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom dogont:StartStopPauseFunctionality ; 
                                       owl:onProperty dogont:hasFunctionality ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom dogont:WashingApplianceState ; 
                                       owl:onProperty dogont:hasState ; 
                                       a owl:Restriction],
                                      dogont:WhiteGoods.
dogont:WashingNotification a owl:Class;
                           rdfs:subClassOf dogont:NonParametricNotification;
                           owl:disjointUnionOf (dogont:StartedHeatingCycleNotification
                                                dogont:StartedWashingNotification
                                                dogont:StoppedHeatingCycleNotification
                                                dogont:StoppedWashingNotification).
dogont:WaterCloset a owl:Class;
                   rdfs:comment "A plumbing fixture for defecation and urination";
                   rdfs:label "WaterCloset";
                   rdfs:subClassOf dogont:SanitaryFixtures.
dogont:WaterMeasurementFuctionality a owl:Class;
                                    rdfs:subClassOf [owl:someValuesFrom dogont:GetHotWaterM3Command ; 
                                                     owl:onProperty dogont:hasCommand ; 
                                                     a owl:Restriction],
                                                    [owl:someValuesFrom dogont:GetColdWaterM3Command ; 
                                                     owl:onProperty dogont:hasCommand ; 
                                                     a owl:Restriction],
                                                    dogont:QueryFunctionality.
dogont:WaterMeasurementNotificationFunctionality a owl:Class;
                                                 rdfs:subClassOf [owl:someValuesFrom dogont:ColdWaterM3MeasurementNotification ; 
                                                                  owl:onProperty dogont:hasNotification ; 
                                                                  a owl:Restriction],
                                                                 [owl:someValuesFrom dogont:HotWaterM3MeasurementNotification ; 
                                                                  owl:onProperty dogont:hasNotification ; 
                                                                  a owl:Restriction],
                                                                 dogont:ContinuousNotificationFunctionality.
dogont:WaterMeasurementState a owl:Class;
                             rdfs:subClassOf [owl:someValuesFrom dogont:ConsumedWaterStateValue ; 
                                              owl:onProperty dogont:hasStateValue ; 
                                              a owl:Restriction],
                                             dogont:ContinuousState.
dogont:WaterMeter a owl:Class;
                  rdfs:subClassOf [owl:someValuesFrom dogont:WaterMeasurementNotificationFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:WaterMeasurementState ; 
                                   owl:onProperty dogont:hasState ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:WaterMeasurementFuctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  dogont:Meter.
dogont:WeeklyClimateScheduleNotification a owl:Class;
                                         rdfs:subClassOf [owl:onProperty dogont:nParams ; 
                                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                          a owl:Restriction],
                                                         [owl:onProperty dogont:notificationParamName ; 
                                                          owl:hasValue "dailySchedules^^DailyClimateSchedule[]" ; 
                                                          a owl:Restriction],
                                                         [owl:onProperty dogont:notificationName ; 
                                                          owl:hasValue "changedWeeklyClimateSchedule" ; 
                                                          a owl:Restriction],
                                                         dogont:ClimateScheduleNotification.
dogont:WhiteGoods a owl:Class;
                  rdfs:comment """Major household appliances.

It mus be noticed that the functionality modeling uses existential quantifiers for functionalities that can be optional, this is only for the sake of easier interpretation and should be improved in future releases""";
                  rdfs:label "WhiteGoods";
                  rdfs:subClassOf [owl:someValuesFrom dogont:ConnectionState ; 
                                   owl:onProperty dogont:hasState ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:FaultState ; 
                                   owl:onProperty dogont:hasState ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:RunState ; 
                                   owl:onProperty dogont:hasState ; 
                                   a owl:Restriction],
                                  dogont:Appliances,
                                  [owl:someValuesFrom dogont:CycleTimingQueryFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:MultipleEventNotificationFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:AlertNotificationFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:CycleTimingControlFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:OnOffStandbyNotificationFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:StandByOnOffState ; 
                                   owl:onProperty dogont:hasState ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:EventsAndAlertsQueryFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:MultipleAlertNotificationFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:OnOffStandByFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:CycleTimingNotificationFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:EventNotificationFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:ProgramState ; 
                                   owl:onProperty dogont:hasState ; 
                                   a owl:Restriction].
dogont:Window a owl:Class;
              rdfs:comment "A framework that contains a glass windowpane and is built into a wall or roof to admit light or air";
              rdfs:label "Window";
              rdfs:subClassOf [owl:onProperty dogont:hasSensor ; 
                               owl:allValuesFrom dogont:WindowSensor ; 
                               a owl:Restriction],
                              [owl:onProperty dogont:hasActuator ; 
                               owl:maxCardinality "2"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction],
                              [owl:onProperty dogont:hasActuator ; 
                               owl:allValuesFrom dogont:WindowActuator ; 
                               a owl:Restriction],
                              dogont:WallOpening.
dogont:WindowActuator a owl:Class;
                      rdfs:comment "A mechanism that allow automatic opening and closing about window";
                      rdfs:label "WindowActuator";
                      rdfs:subClassOf [owl:someValuesFrom dogont:OpenCloseNotificationFunctionality ; 
                                       owl:onProperty dogont:hasFunctionality ; 
                                       a owl:Restriction],
                                      dogont:Actuator,
                                      [owl:someValuesFrom dogont:OpenCloseState ; 
                                       owl:onProperty dogont:hasState ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom dogont:MovementNotificationFunctionality ; 
                                       owl:onProperty dogont:hasFunctionality ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom dogont:MovementState ; 
                                       owl:onProperty dogont:hasState ; 
                                       a owl:Restriction],
                                      [owl:onProperty dogont:actuatorOf ; 
                                       owl:allValuesFrom dogont:Window ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom dogont:OpenCloseFunctionality ; 
                                       owl:onProperty dogont:hasFunctionality ; 
                                       a owl:Restriction].
dogont:WindowSensor a owl:Class;
                    rdfs:comment "Sensor that controls if a window is closed";
                    rdfs:label "WindowSensor";
                    rdfs:subClassOf dogont:AntiIntrusionSystem,
                                    [owl:onProperty dogont:sensorOf ; 
                                     owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                     a owl:Restriction],
                                    dogont:Sensor,
                                    [owl:onProperty dogont:sensorOf ; 
                                     owl:allValuesFrom dogont:Window ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:OpenCloseState ; 
                                     owl:onProperty dogont:hasState ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:OpenCloseNotificationFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    [owl:onProperty dogont:hasFunctionality ; 
                                     owl:cardinality "3"^^xsd:nonNegativeInteger ; 
                                     a owl:Restriction].
dogont:WirelessPhone a owl:Class;
                     rdfs:comment "Phone with no wire";
                     rdfs:label "WirelessPhone";
                     rdfs:subClassOf dogont:Phone.
dogont:ZWaveComponent a owl:Class;
                      rdfs:subClassOf dogont:NetworkComponent.
dogont:ZWaveGateway a owl:Class;
                    rdfs:subClassOf [owl:someValuesFrom dogont:AssociationNotificationFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:AssociateFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    dogont:ZWaveComponent.
dogont:ZWaveNotification a owl:Class;
                         rdfs:subClassOf dogont:NetworkSpecificNotification.
dogont:ZWaveProperty a owl:DatatypeProperty;
                     rdfs:domain dogont:ZWaveComponent;
                     rdfs:range xsd:int.
dogont:ZigBeeComponent a owl:Class;
                       rdfs:subClassOf dogont:NetworkComponent.
dogont:ZigBeeGateway a owl:Class;
                     rdfs:subClassOf [owl:someValuesFrom dogont:NetworkManagementState ; 
                                      owl:onProperty dogont:hasState ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom dogont:NetworkManagementNotificationFunctionality ; 
                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom dogont:ApplianceManagementFunctionality ; 
                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom dogont:NetworkManagementFunctionality ; 
                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     dogont:ZigBeeComponent.
dogont:ZigBeeNotification a owl:Class;
                          rdfs:subClassOf dogont:NetworkSpecificNotification.
dogont:ZoomInCommand a owl:Class;
                     rdfs:subClassOf [owl:onProperty dogont:realCommandName ; 
                                      owl:hasValue "zoomIn" ; 
                                      a owl:Restriction],
                                     dogont:NonParametricCommand,
                                     dogont:VoidCommand;
                     owl:disjointWith dogont:ZoomOutCommand.
dogont:ZoomOutCommand a owl:Class;
                      rdfs:subClassOf [owl:onProperty dogont:realCommandName ; 
                                       owl:hasValue "zoomOut" ; 
                                       a owl:Restriction],
                                      dogont:NonParametricCommand,
                                      dogont:VoidCommand.
dogont:actuatorOf a owl:ObjectProperty;
                  rdfs:domain dogont:Actuator;
                  rdfs:range [owl:unionOf (dogont:Awning
                                           dogont:Door
                                           dogont:Gate
                                           dogont:Shutter
                                           dogont:Window) ; 
                              a owl:Class];
                  owl:inverseOf dogont:hasActuator.
dogont:ceilingOf a owl:ObjectProperty;
                 rdfs:domain dogont:Ceiling;
                 rdfs:range [owl:unionOf (dogont:Garage
                                          dogont:Room) ; 
                             a owl:Class].
dogont:commandOf a owl:ObjectProperty;
                 rdfs:domain dogont:Command;
                 rdfs:range [owl:unionOf (dogont:ControlFunctionality
                                          dogont:QueryFunctionality) ; 
                             a owl:Class];
                 owl:inverseOf dogont:hasCommand.
dogont:commandParamName a owl:DatatypeProperty;
                        rdfs:domain dogont:ParametricCommand;
                        rdfs:range xsd:string.
dogont:commandParamValue a owl:DatatypeProperty;
                         rdfs:domain dogont:ParametricCommand;
                         rdfs:range xsd:string.
dogont:connectionTimeOut a owl:DatatypeProperty;
                         rdfs:comment "The time before the connection expires";
                         rdfs:domain [owl:unionOf (dogont:BTicinoGateway
                                                   dogont:KNXNetIPGateway
                                                   dogont:KonnexGateway) ; 
                                      a owl:Class];
                         rdfs:label "connectionTimeOut";
                         rdfs:range xsd:int.
dogont:connectionTrials a owl:DatatypeProperty;
                        rdfs:comment "Number of connection trials before failure";
                        rdfs:domain [owl:unionOf (dogont:BTicinoGateway
                                                  dogont:KonnexGateway) ; 
                                     a owl:Class];
                        rdfs:label "connectionTrials";
                        rdfs:range xsd:int.
dogont:contains a owl:ObjectProperty;
                rdfs:comment "Indicates which object are contained in a building environment, e.g. the kitchen contains Lamp1,Lamp2...";
                rdfs:domain dogont:BuildingEnvironment;
                rdfs:label "contains";
                rdfs:range [owl:unionOf (dogont:Appliances
                                         dogont:BuildingEnvironment
                                         dogont:Furniture
                                         dogont:HousePlants) ; 
                            a owl:Class].
dogont:controlledObject a owl:ObjectProperty;
                        rdfs:comment "Association between a controller and the controlled object";
                        rdfs:domain dogont:Control;
                        rdfs:label "controlledObject";
                        rdfs:range [owl:unionOf (dogont:Acoustic
                                                 dogont:Actuator
                                                 dogont:Control
                                                 dogont:Lighting
                                                 dogont:PowerDelivery) ; 
                                    a owl:Class].
dogont:datapoinId a owl:DatatypeProperty;
                  rdfs:comment "The ILON id of a given datapoint associated to the command or notification of a given echelon-managed device"@en;
                  rdfs:domain [owl:unionOf (dogont:EchelonCommand
                                            dogont:EchelonNetworkComponent
                                            dogont:EchelonNotification) ; 
                               a owl:Class];
                  rdfs:range xsd:string;
                  rdfs:subPropertyOf dogont:EchelonIlon100Property.
dogont:datapointAlias a owl:DatatypeProperty;
                      rdfs:domain [owl:unionOf (dogont:EchelonCommand
                                                dogont:EchelonNetworkComponent
                                                dogont:EchelonNotification) ; 
                                   a owl:Class];
                      rdfs:range xsd:string;
                      rdfs:subPropertyOf dogont:EchelonIlon100Property.
dogont:eZ430Chronos a owl:Class;
                    rdfs:subClassOf [owl:someValuesFrom dogont:TridimensionalAccelerationNotificationFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:ButtonMNotificationFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:OnOffState ; 
                                     owl:onProperty dogont:hasState ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:DisplayFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:SoundFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    dogont:Clock.
dogont:endpointAddress a owl:DatatypeProperty;
                       rdfs:comment "The address (URL) of the web service endpoint at which the ILON100 server having this property offers data reading and writing services"@en;
                       rdfs:domain dogont:EchelonIlon100Gateway;
                       rdfs:range xsd:string;
                       rdfs:subPropertyOf dogont:EchelonIlon100Property.
dogont:flashingTime a owl:DatatypeProperty;
                    rdfs:comment "The flashing period duration in seconds";
                    rdfs:domain dogont:OnOffFlashingFunctionality;
                    rdfs:label "flashingTime";
                    rdfs:range xsd:float.
dogont:floorOf a owl:ObjectProperty;
               rdfs:domain dogont:Floor;
               rdfs:range [owl:unionOf (dogont:Garage
                                        dogont:Room) ; 
                           a owl:Class];
               owl:inverseOf dogont:hasFloor.
dogont:generateCommand a owl:ObjectProperty;
                       rdfs:domain dogont:Notification;
                       rdfs:range dogont:Command.
dogont:groupAddress a owl:DatatypeProperty;
                    rdfs:comment "The address of the group of the component";
                    rdfs:domain [owl:unionOf (dogont:KNXNetIPComponent
                                              dogont:KonnexCommand
                                              dogont:KonnexComponent
                                              dogont:KonnexNotification) ; 
                                 a owl:Class];
                    rdfs:label "groupAddress";
                    rdfs:range xsd:string;
                    rdfs:subPropertyOf dogont:KonnexProperty.
dogont:hasActuator a owl:ObjectProperty;
                   rdfs:comment "Association between a mobile uncontrollable object and its actuator";
                   rdfs:domain [owl:unionOf (dogont:Awning
                                             dogont:Door
                                             dogont:Gate
                                             dogont:Shutter
                                             dogont:Window) ; 
                                a owl:Class];
                   rdfs:label "hasActuator";
                   rdfs:range dogont:Actuator.
dogont:hasCeiling a owl:ObjectProperty;
                  rdfs:domain [owl:unionOf (dogont:Garage
                                            dogont:Room) ; 
                               a owl:Class];
                  rdfs:range dogont:Ceiling;
                  owl:inverseOf dogont:ceilingOf.
dogont:hasCommand a owl:ObjectProperty;
                  rdfs:domain [owl:unionOf (dogont:ControlFunctionality
                                            dogont:QueryFunctionality) ; 
                               a owl:Class];
                  rdfs:range dogont:Command.
dogont:hasControl a owl:ObjectProperty;
                  rdfs:comment "Association between an object and its controller,e.g.switch,button,knob";
                  rdfs:domain [owl:unionOf (dogont:Acoustic
                                            dogont:Actuator
                                            dogont:Control
                                            dogont:Lighting
                                            dogont:PowerDelivery) ; 
                               a owl:Class];
                  rdfs:label "hasControl";
                  rdfs:range dogont:Control;
                  owl:inverseOf dogont:controlledObject.
dogont:hasFloor a owl:ObjectProperty;
                rdfs:domain [owl:unionOf (dogont:Garage
                                          dogont:Room) ; 
                             a owl:Class];
                rdfs:range dogont:Floor.
dogont:hasFunctionality a owl:ObjectProperty;
                        rdfs:comment "Provide functionalities to controllable things";
                        rdfs:domain dogont:Controllable;
                        rdfs:label "hasFunctionality";
                        rdfs:range dogont:Functionality.
dogont:hasGateway a owl:ObjectProperty;
                  rdfs:comment "Relates a given domotic component with the network level gateway used to control it"@en;
                  rdfs:domain dogont:Controllable;
                  rdfs:range [owl:unionOf (dogont:BTicinoGateway
                                           dogont:EliteGateway
                                           dogont:KonnexGateway) ; 
                              a owl:Class].
dogont:hasMeter a owl:ObjectProperty;
                rdfs:domain dogont:Controllable;
                rdfs:range dogont:Meter;
                rdfs:subPropertyOf owl:topObjectProperty;
                owl:inverseOf dogont:meterOf.
dogont:hasNotification a owl:ObjectProperty;
                       rdfs:domain dogont:NotificationFunctionality;
                       rdfs:range dogont:Notification.
dogont:hasSensor a owl:ObjectProperty;
                 rdfs:comment "Association between an object and its sensor";
                 rdfs:domain [owl:unionOf (dogont:FenceOpening
                                           dogont:WallOpening) ; 
                              a owl:Class];
                 rdfs:label "hasSensor";
                 rdfs:range [owl:unionOf (dogont:DoorSensor
                                          dogont:WindowSensor) ; 
                             a owl:Class].
dogont:hasState a owl:ObjectProperty;
                rdfs:comment "Provide the actual state to controllable things";
                rdfs:domain dogont:Controllable;
                rdfs:label "hasState";
                rdfs:range dogont:State.
dogont:hasStateValue a owl:ObjectProperty;
                     rdfs:domain dogont:State;
                     rdfs:range dogont:StateValue.
dogont:hasWall a owl:ObjectProperty;
               rdfs:comment "Association between a room and its walls";
               rdfs:domain dogont:Room;
               rdfs:label "hasWall";
               rdfs:range dogont:Wall.
dogont:hasWallOpening a owl:ObjectProperty;
                      rdfs:comment "Association between a wall and its opening like door,window";
                      rdfs:domain dogont:Wall;
                      rdfs:label "hasWallOpening";
                      rdfs:range dogont:WallOpening;
                      owl:inverseOf dogont:isInWall.
dogont:hexValue a owl:DatatypeProperty;
                rdfs:domain [owl:unionOf (dogont:KonnexCommand
                                          dogont:KonnexNotification) ; 
                             a owl:Class];
                rdfs:range xsd:string;
                rdfs:subPropertyOf dogont:KonnexProperty.
dogont:individualAddress a owl:DatatypeProperty;
                         rdfs:comment "The individual address of the component";
                         rdfs:domain dogont:KonnexComponent;
                         rdfs:label "individualAddress";
                         rdfs:range xsd:string;
                         rdfs:subPropertyOf dogont:KonnexProperty.
dogont:instanceId a owl:DatatypeProperty;
                  rdfs:domain dogont:ZWaveComponent;
                  rdfs:range xsd:int;
                  rdfs:subPropertyOf dogont:ZWaveProperty;
                  owl:propertyDisjointWith dogont:nodeId.
dogont:isIn a owl:ObjectProperty;
            rdfs:comment "Indicates in which building environment is contained an object, e.g. the lamp5 isIn Kitchen";
            rdfs:domain [owl:unionOf (dogont:Appliances
                                      dogont:BuildingEnvironment
                                      dogont:Furniture
                                      dogont:HousePlants) ; 
                         a owl:Class];
            rdfs:label "isIn";
            rdfs:range dogont:BuildingEnvironment;
            owl:inverseOf dogont:contains.
dogont:isInWall a owl:ObjectProperty;
                rdfs:comment "Association between a wallopening(door or window) and the wall opening where it is";
                rdfs:domain dogont:WallOpening;
                rdfs:label "isInWall";
                rdfs:range dogont:Wall.
dogont:levelFromGround a owl:DatatypeProperty;
                       rdfs:domain dogont:Storey;
                       rdfs:range xsd:integer.
dogont:meterOf a owl:ObjectProperty;
               rdfs:domain dogont:Meter;
               rdfs:range dogont:Controllable;
               rdfs:subPropertyOf owl:topObjectProperty.
dogont:multicastIP a owl:DatatypeProperty;
                   rdfs:comment "The multicast address of the gateway";
                   rdfs:domain dogont:KonnexGateway;
                   rdfs:label "multicastIP";
                   rdfs:range xsd:string;
                   rdfs:subPropertyOf dogont:KonnexProperty.
dogont:nParams a owl:DatatypeProperty,
                 owl:FunctionalProperty;
               rdfs:domain [owl:unionOf (dogont:ParametricCommand
                                         dogont:ParametricNotification) ; 
                            a owl:Class];
               rdfs:range xsd:int.
dogont:nodeId a owl:DatatypeProperty;
              rdfs:domain dogont:ZWaveComponent;
              rdfs:range xsd:int;
              rdfs:subPropertyOf dogont:ZWaveProperty.
dogont:notificationName a owl:DatatypeProperty;
                        rdfs:domain dogont:Notification;
                        rdfs:range xsd:string.
dogont:notificationOf a owl:ObjectProperty;
                      rdfs:domain dogont:Notification;
                      rdfs:range dogont:NotificationFunctionality;
                      owl:inverseOf dogont:hasNotification.
dogont:notificationParamName a owl:DatatypeProperty;
                             rdfs:domain dogont:ParametricNotification;
                             rdfs:range xsd:string.
dogont:phaseID a owl:DatatypeProperty;
               rdfs:domain dogont:StateValue;
               rdfs:range xsd:string.
dogont:physicalAddress a owl:DatatypeProperty;
                       rdfs:comment "The address of the component";
                       rdfs:domain dogont:BTicinoComponent;
                       rdfs:label "physicalAddress";
                       rdfs:range xsd:string;
                       rdfs:subPropertyOf dogont:BTicinoProperty;
                       owl:propertyDisjointWith dogont:physicalType.
dogont:physicalType a owl:DatatypeProperty;
                    rdfs:comment "The category of the component";
                    rdfs:domain dogont:BTicinoComponent;
                    rdfs:label "physicalType";
                    rdfs:range xsd:string;
                    rdfs:subPropertyOf dogont:BTicinoProperty.
dogont:plugOf a owl:ObjectProperty;
              rdfs:domain dogont:PowerDelivery;
              rdfs:range dogont:Appliances;
              rdfs:subPropertyOf owl:topObjectProperty;
              owl:inverseOf dogont:pluggedIn.
dogont:pluggedIn a owl:ObjectProperty;
                 rdfs:domain dogont:Appliances;
                 rdfs:range dogont:PowerDelivery;
                 rdfs:subPropertyOf owl:topObjectProperty.
dogont:pollingInterval a owl:DatatypeProperty;
                       rdfs:comment "The interval between subsequent polls";
                       rdfs:domain [owl:unionOf (dogont:EchelonIlon100Gateway
                                                 dogont:KonnexGateway
                                                 dogont:ModbusGateway
                                                 dogont:ZWaveGateway
                                                 dogont:ZigBeeGateway) ; 
                                    a owl:Class];
                       rdfs:label "pollingInterval";
                       rdfs:range xsd:int.
dogont:port a owl:DatatypeProperty;
            rdfs:comment "The port of the gateway";
            rdfs:domain [owl:unionOf (dogont:BTicinoGateway
                                      dogont:EchelonIlon100Gateway
                                      dogont:KNXNetIPGateway
                                      dogont:KonnexGateway
                                      dogont:ModbusGateway) ; 
                         a owl:Class];
            rdfs:label "port";
            rdfs:range xsd:int.
dogont:probeID a owl:DatatypeProperty;
               rdfs:domain [owl:unionOf (dogont:MultipleFlowRateStateValue
                                         dogont:MultiplePressureStateValue
                                         dogont:MultipleTemperatureStateValue) ; 
                            a owl:Class];
               rdfs:range xsd:string.
dogont:realCommandName a owl:DatatypeProperty;
                       rdfs:domain dogont:Command;
                       rdfs:range xsd:string.
dogont:realStateValue a owl:DatatypeProperty;
                      rdfs:domain dogont:StateValue;
                      rdfs:range xsd:string.
dogont:registerAddress a owl:DatatypeProperty;
                       rdfs:domain [owl:unionOf (dogont:ModbusCommand
                                                 dogont:ModbusComponent
                                                 dogont:ModbusNotification) ; 
                                    a owl:Class];
                       rdfs:range xsd:string;
                       rdfs:subPropertyOf dogont:ModBusProperty.
dogont:registerType a owl:DatatypeProperty;
                    rdfs:domain [owl:unionOf (dogont:ModbusCommand
                                              dogont:ModbusComponent
                                              dogont:ModbusNotification) ; 
                                 a owl:Class];
                    rdfs:range xsd:string;
                    rdfs:subPropertyOf dogont:ModBusProperty.
dogont:returnType a owl:DatatypeProperty;
                  rdfs:domain [owl:unionOf (dogont:NonVoidCommand
                                            dogont:ParametricNotification) ; 
                               a owl:Class];
                  rdfs:range [owl:oneOf () ; 
                              a rdfs:Datatype].
dogont:scaleFactor a owl:DatatypeProperty;
                   rdfs:domain [owl:unionOf (dogont:ModbusCommand
                                             dogont:ModbusNotification) ; 
                                a owl:Class];
                   rdfs:range xsd:float;
                   rdfs:subPropertyOf dogont:ModBusProperty.
dogont:sensorOf a owl:ObjectProperty;
                rdfs:comment "Association between a sensor and its sensed object";
                rdfs:domain [owl:unionOf (dogont:DoorSensor
                                          dogont:WindowSensor) ; 
                             a owl:Class];
                rdfs:label "isSensorOf";
                rdfs:range [owl:unionOf (dogont:FenceOpening
                                         dogont:WallOpening) ; 
                            a owl:Class];
                owl:inverseOf dogont:hasSensor.
dogont:slaveId a owl:DatatypeProperty;
               rdfs:domain [owl:unionOf (dogont:ModbusCommand
                                         dogont:ModbusComponent
                                         dogont:ModbusNotification) ; 
                            a owl:Class];
               rdfs:range xsd:string;
               rdfs:subPropertyOf dogont:ModBusProperty.
dogont:sleepTime a owl:DatatypeProperty;
                 rdfs:comment "The time between connection trials";
                 rdfs:domain [owl:unionOf (dogont:BTicinoGateway
                                           dogont:KonnexGateway) ; 
                              a owl:Class];
                 rdfs:label "sleepTime";
                 rdfs:range xsd:int.
dogont:statevalueOf a owl:ObjectProperty;
                    rdfs:domain dogont:StateValue;
                    rdfs:range dogont:State;
                    owl:inverseOf dogont:hasStateValue.
dogont:stepValue a owl:DatatypeProperty;
                 rdfs:domain dogont:ContinuousControlFunctionality;
                 rdfs:range xsd:double.
dogont:svgFootprint a owl:DatatypeProperty;
                    rdfs:comment "A property holding the svg footprint for the given building environment object";
                    rdfs:domain dogont:BuildingEnvironment;
                    rdfs:range xsd:string.
dogont:tariffID a owl:DatatypeProperty;
                rdfs:domain [owl:unionOf (dogont:MultiTariffActiveEnergyStateValue
                                          dogont:MultiTariffReactiveEnergyStateValue
                                          dogont:MultiTariffSinglePhaseActiveEnergyMeasurementNotification
                                          dogont:MultiTariffSinglePhaseReactiveEnergyMeasurementNotification
                                          dogont:MultiTariffThreePhaseActiveEnergyMeasurementNotification
                                          dogont:MultiTariffThreePhaseReactiveEnergyMeasurementNotification) ; 
                             a owl:Class];
                rdfs:range xsd:string.
dogont:timeToOff a owl:DatatypeProperty;
                 rdfs:comment "The time in seconds during which the object is turned on";
                 rdfs:domain dogont:TimedOnFunctionality;
                 rdfs:label "timeToOff";
                 rdfs:range [owl:oneOf () ; 
                             a rdfs:Datatype].
dogont:unitOfMeasure a owl:ObjectProperty,
                       owl:FunctionalProperty;
                     rdfs:domain [owl:unionOf (dogont:ContinuousValue
                                               dogont:ParametricNotification) ; 
                                  a owl:Class];
                     rdfs:range muo:UnitOfMeasurement;
                     owl:propertyDisjointWith muo:measuredIn.
dogont:weekDay a owl:DatatypeProperty;
               rdfs:domain dogont:ClimateScheduleStateValue;
               rdfs:range xsd:string.
