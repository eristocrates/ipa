dogont:Desk a owl:Class;
            rdfs:comment "A piece of furniture with a writing surface and usually drawers or other compartments";
            rdfs:label "Desk";
            rdfs:subClassOf dogont:Furniture;
            owl:disjointWith dogont:Wardrobe,
                             dogont:Shade,
                             dogont:Sofa,
                             dogont:Nightstand,
                             dogont:SanitaryFixtures,
                             dogont:Drawer,
                             dogont:Shutter,
                             dogont:Table.
dogont:DetectedNotification a owl:Class;
                            rdfs:subClassOf [owl:onProperty dogont:notificationName ; 
                                             owl:hasValue "detected" ; 
                                             a owl:Restriction],
                                            dogont:NonParametricNotification.
dogont:DetectedStateValue a owl:Class;
                          rdfs:subClassOf [owl:onProperty dogont:realStateValue ; 
                                           owl:hasValue "detected" ; 
                                           a owl:Restriction],
                                          dogont:DiscreteValue.
dogont:DeviceAssociationState a owl:Class;
                              rdfs:subClassOf [owl:someValuesFrom dogont:DisassociatingStateValue ; 
                                               owl:onProperty dogont:hasStateValue ; 
                                               a owl:Restriction],
                                              [owl:someValuesFrom dogont:AssociatingStateValue ; 
                                               owl:onProperty dogont:hasStateValue ; 
                                               a owl:Restriction],
                                              [owl:someValuesFrom dogont:IdleStateValue ; 
                                               owl:onProperty dogont:hasStateValue ; 
                                               a owl:Restriction],
                                              dogont:TripleValuedState.
dogont:DimmableLight a owl:Class;
                     rdfs:comment "The Dimmable Light device is a light that can be switched on and off, and whose luminance level may be controlled, derives from ZigBee HA specifications"@en;
                     rdfs:subClassOf [owl:someValuesFrom dogont:SceneNotificationFunctionality ; 
                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom dogont:SceneFunctionality ; 
                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom dogont:GroupNotificationFunctionality ; 
                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom dogont:GroupFunctionality ; 
                                      owl:onProperty dogont:hasFunctionality ; 
                                      a owl:Restriction],
                                     dogont:DimmerLamp.
dogont:DimmerLamp a owl:Class;
                  rdfs:comment "Lamp that varies the level of illumination";
                  rdfs:label "DimmerLamp";
                  rdfs:subClassOf [owl:someValuesFrom dogont:NetworkNotificationFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:LightRegulationFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:onProperty dogont:hasFunctionality ; 
                                   owl:minCardinality "3"^^xsd:nonNegativeInteger ; 
                                   a owl:Restriction],
                                  dogont:Lamp,
                                  [owl:someValuesFrom dogont:LightIntensityState ; 
                                   owl:onProperty dogont:hasState ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:NetworkFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:SimpleLevelNotificationFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:QueryFunctionality ; 
                                   owl:onProperty dogont:hasFunctionality ; 
                                   a owl:Restriction];
                  owl:disjointWith dogont:SimpleLamp.
dogont:DimmerSwitch a owl:Class;
                    rdfs:comment "Switch for controlling dimmable lights, derives from ZigBee HA specifications"@en;
                    rdfs:subClassOf [owl:someValuesFrom dogont:LightIntensityState ; 
                                     owl:onProperty dogont:hasState ; 
                                     a owl:Restriction],
                                    [owl:onProperty dogont:controlledObject ; 
                                     owl:allValuesFrom dogont:DimmerLamp ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:OnOffState ; 
                                     owl:onProperty dogont:hasState ; 
                                     a owl:Restriction],
                                    dogont:LevelControlSwitch.
dogont:DiningRoom a owl:Class;
                  rdfs:comment "A room used for dining";
                  rdfs:label "DiningRoom";
                  rdfs:subClassOf dogont:Room.
dogont:DisableGasCommand a owl:Class;
                         rdfs:subClassOf [owl:onProperty dogont:realCommandName ; 
                                          owl:hasValue "disableGas" ; 
