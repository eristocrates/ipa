                                                  dogont:PlayFunctionality,
                                                  dogont:SingleValuedFunctionality,
                                                  dogont:TripleValuedFunctionality.
dogont:DoubleValuedNotificationFunctionality a owl:Class;
                                             rdfs:comment "Discrete notification with exactly two values";
                                             rdfs:label "DoubleValuedNotificationFunctionality";
