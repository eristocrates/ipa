                                         dogont:DiscreteValue.
dogont:Fan a owl:Class;
           rdfs:comment "A device for creating a current of air";
           rdfs:label "Fan";
           rdfs:subClassOf dogont:BrownGoods;
           owl:disjointWith dogont:Printer.
dogont:FanControlFunctionality a owl:Class;
                               rdfs:comment "Models the capability of controlling the speed of a cooling/heating fan. Derives from ZigBee HA"@en;
                               rdfs:subClassOf [owl:someValuesFrom dogont:SpeedUpCommand ; 
                                                owl:onProperty dogont:hasCommand ; 
                                                a owl:Restriction],
                                               [owl:someValuesFrom dogont:SpeedDownCommand ; 
                                                owl:onProperty dogont:hasCommand ; 
                                                a owl:Restriction],
                                               [owl:onProperty dogont:hasCommand ; 
                                                owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                a owl:Restriction],
                                               dogont:ContinuousControlFunctionality,
                                               [owl:someValuesFrom dogont:SetSpeedCommand ; 
                                                owl:onProperty dogont:hasCommand ; 
                                                a owl:Restriction];
                               owl:disjointWith dogont:ShutterRegulationFunctionality,
                                                dogont:LevelControlFunctionality,
                                                dogont:TimeRegulationFunctionality,
                                                dogont:TunerFunctionality,
                                                dogont:ThermostatControlFunctionality.
dogont:FaultState a owl:Class;
                  rdfs:subClassOf [owl:someValuesFrom dogont:NoFailureStateValue ; 
                                   owl:onProperty dogont:hasStateValue ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom dogont:FailureStateValue ; 
                                   owl:onProperty dogont:hasStateValue ; 
                                   a owl:Restriction],
                                  dogont:DoubleValuedState.
dogont:Fax a owl:Class;
           rdfs:comment "Appliance that send text and document";
           rdfs:label "Fax";
           rdfs:subClassOf dogont:Communication;
           owl:disjointWith dogont:Interphone,
                            dogont:Phone.
dogont:Fence a owl:Class;
             rdfs:comment "A barrier that serves to enclose an area";
             rdfs:label "Fence";
             rdfs:subClassOf dogont:Vertical;
             owl:disjointWith dogont:FenceOpening,
                              dogont:Wall,
                              dogont:WallOpening.
dogont:FenceOpening a owl:Class;
                    rdfs:comment "An opening in a Fence";
                    rdfs:label "FenceOpening";
                    rdfs:subClassOf dogont:Vertical;
                    owl:disjointWith dogont:Wall,
                                     dogont:WallOpening.
dogont:FireHeatCoolNotificationFunctionality a owl:Class;
                                             rdfs:subClassOf [owl:someValuesFrom dogont:HeatNotification ; 
                                                              owl:onProperty dogont:hasNotification ; 
                                                              a owl:Restriction],
                                                             [owl:someValuesFrom dogont:FiringUpNotification ; 
                                                              owl:onProperty dogont:hasNotification ; 
                                                              a owl:Restriction],
                                                             [owl:someValuesFrom dogont:CoolNotification ; 
                                                              owl:onProperty dogont:hasNotification ; 
                                                              a owl:Restriction],
                                                             dogont:TripleValuedNotificationFunctionality.
dogont:FireSystem a owl:Class;
                  rdfs:comment "System that detects the presence of fire";
                  rdfs:label "FireSystem";
                  rdfs:subClassOf dogont:SecuritySystem;
                  owl:disjointWith dogont:FloodSystem,
                                   dogont:GasSystem.
dogont:FireUpStateValue a owl:Class;
                        rdfs:subClassOf [owl:onProperty dogont:realStateValue ; 
                                         owl:hasValue "firingUp" ; 
                                         a owl:Restriction],
                                        dogont:DiscreteValue.
dogont:FiringUpNotification a owl:Class;
                            rdfs:subClassOf [owl:onProperty dogont:notificationName ; 
                                             owl:hasValue "firingUp" ; 
                                             a owl:Restriction],
                                            dogont:NonParametricNotification.
dogont:FlashingLamp a owl:Class;
                    rdfs:comment "Lamp that emits light in sudden short or intermittent bursts";
                    rdfs:label "FlashingLamp";
                    rdfs:subClassOf dogont:SimpleLamp,
                                    [owl:someValuesFrom dogont:OnOffFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:QueryFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:OnOffNotificationFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom dogont:OnOffFlashingFunctionality ; 
                                     owl:onProperty dogont:hasFunctionality ; 
                                     a owl:Restriction],
                                    [owl:onProperty dogont:hasState ; 
                                     owl:allValuesFrom dogont:OnOffState ; 
                                     a owl:Restriction];
                    owl:disjointWith dogont:OnOffLight.
dogont:Flat a owl:Class;
            rdfs:subClassOf [owl:someValuesFrom dogont:Room ; 
                             owl:onProperty dogont:contains ; 
                             a owl:Restriction],
                            [owl:onProperty dogont:contains ; 
                             owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                             a owl:Restriction],
                            dogont:BuildingEnvironment;
            owl:disjointWith dogont:Garage,
                             dogont:Garden,
                             dogont:Room.
dogont:FloodSensor a owl:Class;
                   rdfs:comment "Sensor that detects the presence of flood";
                   rdfs:label "FloodSensor";
                   rdfs:subClassOf dogont:FloodSystem,
                                   dogont:Sensor,
                                   [owl:someValuesFrom dogont:OnOffNotificationFunctionality ; 
                                    owl:onProperty dogont:hasFunctionality ; 
                                    a owl:Restriction],
                                   [owl:onProperty dogont:hasState ; 
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom dogont:SensingState ; 
                                    owl:onProperty dogont:hasState ; 
                                    a owl:Restriction];
                   owl:disjointWith dogont:SingleFlowSensor,
                                    dogont:PressureSensor,
                                    dogont:WindowSensor,
                                    dogont:SmokeSensor,
                                    dogont:GasSensor,
                                    dogont:OccupancySensor,
                                    dogont:InfraredSensor.
dogont:FloodSystem a owl:Class;
                   rdfs:comment "System that detects the presence of flood";
                   rdfs:label "FloodSystem";
                   rdfs:subClassOf dogont:SecuritySystem;
                   owl:disjointWith dogont:GasSystem.
dogont:Floor a owl:Class;
             rdfs:comment "The inside lower horizontal surface of a room";
             rdfs:label "Floor";
             rdfs:subClassOf dogont:Horizontal;
             owl:disjointWith dogont:Terrace.
dogont:FlowMeasurementFunctionality a owl:Class;
                                    rdfs:subClassOf [owl:someValuesFrom dogont:GetFlowRateCommand ; 
                                                     owl:onProperty dogont:hasCommand ; 
                                                     a owl:Restriction],
                                                    dogont:QueryFunctionality;
                                    owl:disjointWith dogont:HumidityMeasurementFunctionality,
                                                     dogont:LightSensingFunctionality,
                                                     dogont:OccupancySensingFunctionality,
                                                     dogont:PictureGrabFunctionality,
                                                     dogont:PressureMeasurementFunctionality,
                                                     dogont:TemperatureMeasurementFunctionality.
dogont:FlowMeasurementNotificationFunctionality a owl:Class;
                                                rdfs:subClassOf [owl:someValuesFrom dogont:FlowRateMeasurementNotification ; 
                                                                 owl:onProperty dogont:hasNotification ; 
                                                                 a owl:Restriction],
                                                                dogont:ContinuousNotificationFunctionality;
                                                owl:disjointWith dogont:HumidityMeasurementNotificationFunctionality,
                                                                 dogont:PressureMeasurementNotificationFunctionality,
                                                                 dogont:SimpleLevelNotificationFunctionality,
                                                                 dogont:TemperatureMeasurementNotificationFunctionality,
                                                                 dogont:ThermostatNotificationFunctionality.
dogont:FlowRateMeasurementMNotification a owl:Class;
                                        rdfs:subClassOf [owl:onProperty dogont:notificationParamName ; 
                                                         owl:hasValue "sensorID^^String" ; 
                                                         a owl:Restriction],
                                                        [owl:onProperty dogont:notificationName ; 
                                                         owl:hasValue "changedFlowRateAt" ; 
                                                         a owl:Restriction],
                                                        [owl:onProperty dogont:notificationParamName ; 
                                                         owl:hasValue "flowRateValue^^Measure" ; 
                                                         a owl:Restriction],
                                                        dogont:ParametricNotification;
                                        owl:disjointWith dogont:TemperatureMeasurementMNotification,
                                                         dogont:LeaveGroupNotification,
                                                         dogont:LevelControlNotification,
                                                         dogont:StoreSceneNotification,
                                                         dogont:HumidityMeasurementMNotification,
                                                         dogont:PressureMeasurementMNotification,
                                                         dogont:JoinGroupNotification.
dogont:FlowRateMeasurementNotification a owl:Class;
                                       rdfs:subClassOf dogont:ParametricNotification,
                                                       [owl:onProperty dogont:notificationName ; 
                                                        owl:hasValue "changedFlowRateValue" ; 
                                                        a owl:Restriction],
                                                       [owl:onProperty dogont:notificationParamName ; 
                                                        owl:hasValue "flowRateValue^^Measure" ; 
                                                        a owl:Restriction];
                                       owl:disjointWith dogont:SimpleMovementNotification,
                                                        dogont:LevelStepUpNotification,
                                                        dogont:HumidityMeasurementNotification,
                                                        dogont:LevelStepDownNotification,
                                                        dogont:TemperatureMeasurementNotification,
                                                        dogont:PressureMeasurementNotification,
                                                        dogont:SimpleNoMovementNotification.
dogont:FlowRateState a owl:Class;
                     rdfs:subClassOf [owl:someValuesFrom dogont:FlowRateStateValue ; 
                                      owl:onProperty dogont:hasStateValue ; 
                                      a owl:Restriction],
                                     dogont:ContinuousState;
                     owl:disjointWith dogont:HumidityMeasurementState,
                                      dogont:LevelState,
                                      dogont:PressureState,
                                      dogont:ShadeState,
                                      dogont:TemperatureState,
                                      dogont:TunerState.
dogont:FlowRateStateValue a owl:Class;
                          rdfs:subClassOf dogont:ContinuousValue;
                          owl:disjointWith dogont:HumidityStateValue,
                                           dogont:LevelStateValue,
                                           dogont:PressureStateValue,
                                           dogont:ReactiveEnergyStateValue,
                                           dogont:ShadeStateValue,
                                           dogont:TemperatureStateValue.
dogont:FlowSensor a owl:Class;
                  rdfs:subClassOf dogont:Sensor.
dogont:ForwardCommand a owl:Class;
                      rdfs:subClassOf [owl:onProperty dogont:realCommandName ; 
                                       owl:hasValue "fwd" ; 
                                       a owl:Restriction],
                                      dogont:VoidCommand,
                                      dogont:NonParametricCommand;
