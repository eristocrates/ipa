dogont:GetRelativeHumidityMCommand a owl:Class;
                                   rdfs:subClassOf dogont:ParametricCommand,
                                                   dogont:NonVoidCommand,
                                                   [owl:onProperty dogont:returnType ; 
                                                    owl:hasValue "Measure" ; 
                                                    a owl:Restriction],
                                                   [owl:onProperty dogont:nParams ; 
                                                    owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                    a owl:Restriction],
                                                   [owl:onProperty dogont:realCommandName ; 
                                                    owl:hasValue "getRelativeHumidityFrom" ; 
                                                    a owl:Restriction],
                                                   [owl:onProperty dogont:commandParamName ; 
                                                    owl:hasValue "sensorURI^^String" ; 
                                                    a owl:Restriction];
                                   owl:disjointWith dogont:TimedOnCommand,
                                                    dogont:SetHourCommand,
                                                    dogont:StoreGroupCommand,
                                                    dogont:SelectSourceCommand,
                                                    dogont:StoreSceneCommand,
                                                    dogont:GoToTrackCommand,
