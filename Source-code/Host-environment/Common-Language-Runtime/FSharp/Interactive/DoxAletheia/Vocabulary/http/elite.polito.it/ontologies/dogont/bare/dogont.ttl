                                                  a owl:Restriction],
                                                 dogont:HueNotification.
dogont:DiscoveryNotificationFunctionality a owl:Class;
                                          rdfs:subClassOf [owl:someValuesFrom dogont:DiscoveryActiveNotification ; 
                                                           owl:onProperty dogont:hasNotification ; 
                                                           a owl:Restriction],
                                                          [owl:someValuesFrom dogont:DiscoveryIdleNotification ; 
                                                           owl:onProperty dogont:hasNotification ; 
                                                           a owl:Restriction],
                                                          dogont:NetworkNotificationFunctionality.
dogont:DiscoveryState dcterms:description "Describes the state of the device discovery process, i.e., of the process charged to discover new devices on a Home Area network. It can either be active, if the discovery process is on going, or idle, if not."@en;
                      a owl:Class;
                      rdfs:subClassOf [owl:someValuesFrom dogont:ActiveDiscoveryStateValue ; 
                                       owl:onProperty dogont:hasStateValue ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom dogont:IdleStateValue ; 
                                       owl:onProperty dogont:hasStateValue ; 
                                       a owl:Restriction],
                                      dogont:DiscreteState.
dogont:DiscreteControlFunctionality a owl:Class;
                                    rdfs:comment "Functionalities not continuous, with fixed values";
                                    rdfs:label "DiscreteFunctionality";
                                    rdfs:subClassOf [owl:onProperty dogont:hasCommand ; 
                                                     owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     a owl:Restriction],
                                                    dogont:ControlFunctionality.
dogont:DiscreteNotificationFunctionality a owl:Class;
                                         rdfs:comment "Notification of fixed values";
                                         rdfs:label "DiscreteNotificationFunctionality";
                                         rdfs:subClassOf dogont:NotificationFunctionality.
dogont:DiscreteOutputFunctionality a owl:Class;
                                   rdfs:subClassOf dogont:DiscreteControlFunctionality.
dogont:DiscreteState a owl:Class;
                     rdfs:comment "States not continuous, with fixed values";
                     rdfs:label "DiscreteState";
                     rdfs:subClassOf [owl:onProperty dogont:hasStateValue ; 
                                      owl:allValuesFrom dogont:DiscreteValue ; 
                                      a owl:Restriction],
                                     dogont:State.
dogont:DiscreteValue a owl:Class;
                     rdfs:subClassOf dogont:StateValue.
dogont:Dishwasher a owl:Class;
                  rdfs:comment "A machine for washing dishes";
                  rdfs:label "Dishwasher";
