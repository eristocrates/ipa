                                       owl:hasValue "noPersonInside" ; 
                                       a owl:Restriction],
                                      dogont:DiscreteValue.
dogont:FreezingApplianceState a owl:Class;
                              rdfs:subClassOf [owl:someValuesFrom dogont:SuperFreezingStateValue ; 
                                               owl:onProperty dogont:hasStateValue ; 
                                               a owl:Restriction],
                                              dogont:GenericApplianceState.
dogont:FrequencyMeasurementFunctionality a owl:Class;
                                         rdfs:subClassOf [owl:someValuesFrom dogont:GetFrequencyCommand ; 
                                                          owl:onProperty dogont:hasCommand ; 
                                                          a owl:Restriction],
                                                         dogont:QueryFunctionality.
dogont:FrequencyMeasurementNotification a owl:Class;
