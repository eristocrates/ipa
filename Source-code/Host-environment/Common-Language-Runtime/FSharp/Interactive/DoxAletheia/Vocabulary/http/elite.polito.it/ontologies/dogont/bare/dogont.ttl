dogont:PushLinkAuthenticationState dcterms:description "Describes the possible states in which the push-link authentication process can be, which are either active, i.e., the manager is registering access credentials on the bridge whose push-button has been pressed by the user, or idle, i.e., doing nothing"@en;
                                   a owl:Class;
                                   rdfs:subClassOf [owl:someValuesFrom dogont:AuthenticatedStateValue ; 
                                                    owl:onProperty dogont:hasStateValue ; 
                                                    a owl:Restriction],
                                                   [owl:someValuesFrom dogont:ActivePushLinkAuthenticationStateValue ; 
                                                    owl:onProperty dogont:hasStateValue ; 
                                                    a owl:Restriction],
                                                   [owl:someValuesFrom dogont:NeedingAuthenticationStateValue ; 
                                                    owl:onProperty dogont:hasStateValue ; 
                                                    a owl:Restriction],
                                                   dogont:DiscreteState.
dogont:PushLinkFunctionality a owl:Class;
                             rdfs:subClassOf [owl:someValuesFrom dogont:StopPushLinkAuthenticationCommand ; 
