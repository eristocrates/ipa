                                      dogont:ElectricityMeter.
dogont:FrequencyStateValue a owl:Class;
                           rdfs:subClassOf dogont:ContinuousValue.
dogont:Fridge a owl:Class;
              rdfs:comment "A refrigerator in which the coolant is pumped around by an electric motor";
              rdfs:label "Fridge";
              rdfs:subClassOf [owl:someValuesFrom dogont:SuperCoolingFunctionality ; 
                               owl:onProperty dogont:hasFunctionality ; 
                               a owl:Restriction],
                              [owl:someValuesFrom dogont:ThermostatControlFunctionality ; 
                               owl:onProperty dogont:hasFunctionality ; 
                               a owl:Restriction],
                              dogont:WhiteGoods,
                              [owl:someValuesFrom dogont:SuperCoolingNotificationFunctionality ; 
                               owl:onProperty dogont:hasFunctionality ; 
                               a owl:Restriction],
                              [owl:someValuesFrom dogont:ThermostatNotificationFunctionality ; 
                               owl:onProperty dogont:hasFunctionality ; 
                               a owl:Restriction];
              owl:disjointWith dogont:WashingMachine,
                               dogont:Stove,
                               dogont:Oven.
dogont:Functionality a owl:Class;
                     rdfs:comment "Capability of a controllable building thing";
                     rdfs:label "Functionality".
dogont:Furniture a owl:Class;
                 rdfs:comment "Furnishings that make a room or other area ready for occupancy";
                 rdfs:label "Furniture";
                 rdfs:subClassOf [owl:onProperty dogont:isIn ; 
                                  owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  a owl:Restriction],
                                 dogont:UnControllable.
dogont:Garage a owl:Class;
              rdfs:comment "The garage of the buinding";
              rdfs:label "Garage";
              rdfs:subClassOf [owl:onProperty dogont:hasFloor ; 
                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction],
                              [owl:onProperty dogont:hasCeiling ; 
                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction],
                              dogont:BuildingEnvironment;
              owl:disjointWith dogont:Garden,
                               dogont:Room.
dogont:Garden a owl:Class;
              rdfs:comment "The garden of the building";
              rdfs:label "Garden";
              rdfs:subClassOf dogont:BuildingEnvironment;
              owl:disjointWith dogont:Room.
dogont:GasCooker a owl:Class;
                 rdfs:comment "Gas Cooker";
                 rdfs:label "GasCooker";
                 rdfs:subClassOf [owl:someValuesFrom dogont:EnableDisableGasFunctionality ; 
                                  owl:onProperty dogont:hasFunctionality ; 
                                  a owl:Restriction],
                                 dogont:Cooker;
                 owl:disjointWith dogont:Hotplate.
dogont:GasHeater a owl:Class;
                 rdfs:comment "Heater that combusts gas";
                 rdfs:label "GasHeater";
                 rdfs:subClassOf dogont:Heater;
                 owl:disjointWith dogont:GasoilHeater,
                                  dogont:PelletHeater.
dogont:GasM3MeasurementNotification a owl:Class;
                                    rdfs:subClassOf [owl:onProperty dogont:notificationParamName ; 
                                                     owl:hasValue "consumedGasCubeMeters^^Measure" ; 
                                                     a owl:Restriction],
                                                    [owl:onProperty dogont:nParams ; 
                                                     owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     a owl:Restriction],
                                                    [owl:onProperty dogont:notificationName ; 
                                                     owl:hasValue "newConsumedM3GasValue" ; 
                                                     a owl:Restriction],
                                                    dogont:ParametricNotification.
dogont:GasMeasurementFunctionality a owl:Class;
                                   rdfs:subClassOf [owl:someValuesFrom dogont:GetConsumedM3Gas ; 
                                                    owl:onProperty dogont:hasCommand ; 
                                                    a owl:Restriction],
                                                   dogont:QueryFunctionality.
dogont:GasMeasurementNotificationFunctionality a owl:Class;
                                               rdfs:subClassOf [owl:someValuesFrom dogont:GasM3MeasurementNotification ; 
                                                                owl:onProperty dogont:hasNotification ; 
                                                                a owl:Restriction],
                                                               dogont:ContinuousNotificationFunctionality.
dogont:GasMeasurementState a owl:Class;
                           rdfs:subClassOf [owl:someValuesFrom dogont:GasStateValue ; 
                                            owl:onProperty dogont:hasStateValue ; 
                                            a owl:Restriction],
                                           dogont:ContinuousState.
dogont:GasMeter a owl:Class;
                rdfs:subClassOf [owl:someValuesFrom dogont:GasMeasurementFunctionality ; 
                                 owl:onProperty dogont:hasFunctionality ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom dogont:GasMeasurementNotificationFunctionality ; 
                                 owl:onProperty dogont:hasFunctionality ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom dogont:GasMeasurementState ; 
                                 owl:onProperty dogont:hasState ; 
                                 a owl:Restriction],
                                dogont:Meter.
dogont:GasSensor a owl:Class;
                 rdfs:comment "Sensor that detects the presence of gas";
                 rdfs:label "GasSensor";
                 rdfs:subClassOf [owl:onProperty dogont:hasState ; 
                                  owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom dogont:OnOffNotificationFunctionality ; 
                                  owl:onProperty dogont:hasFunctionality ; 
                                  a owl:Restriction],
                                 dogont:GasSystem,
                                 dogont:Sensor,
                                 [owl:someValuesFrom dogont:SensingState ; 
                                  owl:onProperty dogont:hasState ; 
                                  a owl:Restriction];
                 owl:disjointWith dogont:InfraredSensor,
                                  dogont:WindowSensor,
                                  dogont:PressureSensor,
                                  dogont:SmokeSensor,
                                  dogont:OccupancySensor,
                                  dogont:SingleFlowSensor.
dogont:GasStateValue a owl:Class;
                     rdfs:subClassOf dogont:ContinuousValue.
dogont:GasSystem a owl:Class;
                 rdfs:comment "System that detects the presence of gas";
                 rdfs:label "GasSystem";
                 rdfs:subClassOf dogont:SecuritySystem.
