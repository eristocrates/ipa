                                                              a owl:Restriction],
                                                             dogont:DiscreteNotificationFunctionality;
                                             owl:disjointWith dogont:NetworkNotificationFunctionality,
                                                              dogont:SingleValuedNotificationFunctionality.
dogont:DoubleValuedState a owl:Class;
