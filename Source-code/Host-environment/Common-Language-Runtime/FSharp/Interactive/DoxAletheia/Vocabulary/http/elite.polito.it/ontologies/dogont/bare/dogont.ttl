dogont:GetPressureMCommand a owl:Class;
                           rdfs:subClassOf [owl:onProperty dogont:nParams ; 
                                            owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                            a owl:Restriction],
                                           dogont:NonVoidCommand,
                                           [owl:onProperty dogont:returnType ; 
                                            owl:hasValue "Measure" ; 
                                            a owl:Restriction],
                                           [owl:onProperty dogont:commandParamName ; 
                                            owl:hasValue "sensorURI^^String" ; 
                                            a owl:Restriction],
                                           [owl:onProperty dogont:realCommandName ; 
                                            owl:hasValue "getPressureFrom" ; 
                                            a owl:Restriction],
                                           dogont:ParametricCommand;
