                                              a owl:Restriction],
                                             dogont:HVACSystem,
                                             [owl:someValuesFrom dogont:SceneNotificationFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:OnOffFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:LevelControlNotificationFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:LevelControlFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction],
                                             dogont:Control,
                                             [owl:someValuesFrom dogont:GroupFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:ThermostatNotificationFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:OnOffNotificationFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:HeatingAndCoolingUnitState ; 
                                              owl:onProperty dogont:hasState ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:SpeedNotificationFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom dogont:QueryFunctionality ; 
                                              owl:onProperty dogont:hasFunctionality ; 
                                              a owl:Restriction];
