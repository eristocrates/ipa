dogont:FrequencyMeasurementNotificationFunctionality a owl:Class;
                                                     rdfs:subClassOf [owl:someValuesFrom dogont:FrequencyMeasurementNotification ; 
                                                                      owl:onProperty dogont:hasNotification ; 
                                                                      a owl:Restriction],
                                                                     dogont:ContinuousNotificationFunctionality.
dogont:FrequencyMeasurementState a owl:Class;
                                 rdfs:subClassOf [owl:someValuesFrom dogont:FrequencyStateValue ; 
                                                  owl:onProperty dogont:hasStateValue ; 
                                                  a owl:Restriction],
                                                 dogont:ContinuousState.
dogont:FrequencyMeter a owl:Class;
                      rdfs:subClassOf [owl:someValuesFrom dogont:FrequencyMeasurementNotificationFunctionality ; 
                                       owl:onProperty dogont:hasFunctionality ; 
                                       a owl:Restriction],
