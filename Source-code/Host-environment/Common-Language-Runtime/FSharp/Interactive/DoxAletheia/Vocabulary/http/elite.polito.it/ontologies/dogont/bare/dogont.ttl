                                           dogont:SpeedDownCommand,
                                           dogont:IncreaseQualityCommand,
                                           dogont:StoreSceneCommand,
                                           dogont:GoToTrackCommand,
                                           dogont:SpeedUpCommand,
                                           dogont:ToggleCommand,
