dogont:AlertNotification a owl:Class;
                         rdfs:subClassOf [owl:onProperty dogont:notificationName ; 
                                          owl:hasValue "newAlert" ; 
                                          a owl:Restriction],
                                         [owl:onProperty dogont:nParams ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty dogont:notificationParamName ; 
                                          owl:hasValue "alert^^Object" ; 
                                          a owl:Restriction],
                                         dogont:ParametricNotification.
dogont:AlertNotificationFunctionality a owl:Class;
                                      rdfs:subClassOf [owl:someValuesFrom dogont:AlertNotification ; 
