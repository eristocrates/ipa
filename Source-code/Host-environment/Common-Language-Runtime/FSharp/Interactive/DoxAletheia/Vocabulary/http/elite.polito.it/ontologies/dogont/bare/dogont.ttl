dogont:Appliances a owl:Class;
                  rdfs:comment "Durable goods for home or office use";
                  rdfs:label "Appliances";
                  rdfs:subClassOf [owl:onProperty dogont:isIn ; 
                                   owl:cardinality "1"^^xsd:nonNegativeInteger ; 
