dogont:DeleteSceneCommand a owl:Class;
                          rdfs:subClassOf dogont:VoidCommand,
                                          [owl:onProperty dogont:realCommandName ; 
                                           owl:hasValue "deleteScene" ; 
                                           a owl:Restriction],
                                          dogont:ParametricCommand,
                                          [owl:onProperty dogont:nParams ; 
                                           owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                           a owl:Restriction],
                                          [owl:onProperty dogont:commandParamName ; 
                                           owl:hasValue "sceneNumber^^Integer" ; 
                                           a owl:Restriction];
                          owl:disjointWith dogont:IncreaseLuminosityCommand,
                                           dogont:GetRelativeHumidityMCommand,
