dogont:HeatingAndCoolingUnitState a owl:Class;
                                  rdfs:subClassOf [owl:someValuesFrom dogont:HeatingStateValue ; 
                                                   owl:onProperty dogont:hasStateValue ; 
                                                   a owl:Restriction],
                                                  [owl:onProperty dogont:hasStateValue ; 
                                                   owl:minCardinality "3"^^xsd:nonNegativeInteger ; 
                                                   a owl:Restriction],
                                                  [owl:someValuesFrom dogont:OffStateValue ; 
                                                   owl:onProperty dogont:hasStateValue ; 
                                                   a owl:Restriction],
                                                  dogont:DiscreteState,
                                                  [owl:someValuesFrom dogont:CoolingStateValue ; 
                                                   owl:onProperty dogont:hasStateValue ; 
                                                   a owl:Restriction],
                                                  [owl:someValuesFrom dogont:AutoRegulationStateValue ; 
