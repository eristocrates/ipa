@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix opus: <http://lsdis.cs.uga.edu/projects/semdis/opus#>.

<http://knowledgeweb.semanticweb.org/semanticportal/OWL/Documentation_Ontology.owl#Chapter> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
opus: <http://purl.org/dc/elements/1.1/creator> "Boanerges Aleman-Meza";
      a <http://www.w3.org/2002/07/owl#Ontology>;
      rdfs:comment """This file specifies in RDF Schema format the classes and properties for SwetoDblp.
    These classes and properties are based on the internal LSDIS Library portal engine.
    Contact Person is Boanerges Aleman-Meza (baleman at uga dot edu).
    """;
      rdfs:label "SwetoDblp Ontology";
      <http://www.w3.org/2002/07/owl#versionInfo> "2007-05-01".
opus:Article a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "An article from a journal or magazine.";
             rdfs:label "Article";
             rdfs:subClassOf opus:Publication;
             <http://www.w3.org/2002/07/owl#equivalentClass> <http://knowledgeweb.semanticweb.org/semanticportal/OWL/Documentation_Ontology.owl#Article_in_Journal>,
                                                             <http://sw-portal.deri.org/ontologies/swportal#Article>,
                                                             <http://purl.org/net/nknouf/ns/bibtex#Article>.
opus:Article_in_Proceedings a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "An article in the proceedings of a meeting, such as a conference, workhshop and symposium.";
                            rdfs:label "Article in Proceedings";
                            rdfs:subClassOf opus:Publication;
                            <http://www.w3.org/2002/07/owl#equivalentClass> <http://sw-portal.deri.org/ontologies/swportal#Inproceedings>,
                                                                            <http://purl.org/net/nknouf/ns/bibtex#Inproceedings>.
opus:Book a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A book with an explicit publisher.";
          rdfs:label "Book";
          rdfs:subClassOf opus:Publication;
          <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.marcont.org/ontology/marcont.owl#Book>,
                                                          <http://knowledgeweb.semanticweb.org/semanticportal/OWL/Documentation_Ontology.owl#Book>,
                                                          <http://swrc.ontoware.org/ontology#Book>,
                                                          <http://www.aktors.org/ontology/portal#Book>,
                                                          <http://purl.org/net/nknouf/ns/bibtex#Book>.
opus:Book_Chapter a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A part of a book, such as a chapter (or section/preface) and/or a range of pages.";
                  rdfs:label "Book Chapter";
                  rdfs:subClassOf opus:Publication;
                  <http://www.w3.org/2002/07/owl#equivalentClass> <http://knowledgeweb.semanticweb.org/semanticportal/OWL/Documentation_Ontology.owl#Article_in_Book>,
                                                                  <http://purl.org/net/nknouf/ns/bibtex#Inbook>.
opus:Doctoral_Dissertation a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A dissertation written to receive a PhD.";
                           rdfs:label "Doctoral Dissertation";
                           rdfs:subClassOf opus:Thesis;
                           <http://www.w3.org/2002/07/owl#equivalentClass> <http://knowledgeweb.semanticweb.org/semanticportal/OWL/Documentation_Ontology.owl#PhD_Thesis>,
                                                                           <http://swrc.ontoware.org/ontology#PhDThesis>,
                                                                           <http://sw-portal.deri.org/ontologies/swportal#PhDThesis>,
                                                                           <http://purl.org/net/nknouf/ns/bibtex#Phdthesis>.
opus:Edited_Book a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "An edited book with an explicit publisher.";
                 rdfs:label "Edited Book";
                 rdfs:subClassOf opus:Edited_Publication,
                                 opus:Book;
                 <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.aktors.org/ontology/portal#Edited-Book>.
opus:Edited_Publication a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "An edited publication, that is, it has one or more editors (edited books, etc)";
                        rdfs:label "Edited Publication";
                        rdfs:subClassOf opus:Publication.
opus:Journal a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A periodical presenting articles on a particular subject.";
             rdfs:label "Journal";
             rdfs:subClassOf opus:Serial_Publication;
             <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.aktors.org/ontology/portal#Journal>,
                                                             <http://sw-portal.deri.org/ontologies/swportal#Journal>.
opus:Masters_Thesis a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A thesis written to receive a Master's degree.";
                    rdfs:label "Masters Thesis";
                    rdfs:subClassOf opus:Thesis;
                    <http://www.w3.org/2002/07/owl#equivalentClass> <http://knowledgeweb.semanticweb.org/semanticportal/OWL/Documentation_Ontology.owl#Master_Thesis>,
                                                                    <http://swrc.ontoware.org/ontology#MasterThesis>,
                                                                    <http://sw-portal.deri.org/ontologies/swportal#MasterThesis>,
                                                                    <http://purl.org/net/nknouf/ns/bibtex#Mastersthesis>.
opus:Proceedings a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A written account of what transpired at a meeting.";
                 rdfs:label "Proceedings";
                 rdfs:subClassOf opus:Publication;
                 <http://www.w3.org/2002/07/owl#equivalentClass> <http://swrc.ontoware.org/ontology#Proceedings>,
                                                                 <http://sw-portal.deri.org/ontologies/swportal#Proceedings>,
                                                                 <http://purl.org/net/nknouf/ns/bibtex#Proceedings>.
opus:Publication a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Individual documents and collections of documents such as series, journals, etc.";
                 rdfs:label "Publication";
                 rdfs:subClassOf <http://xmlns.com/foaf/0.1/Document>;
                 <http://www.w3.org/2002/07/owl#equivalentClass> <http://knowledgeweb.semanticweb.org/semanticportal/OWL/Documentation_Ontology.owl#Publication>,
                                                                 <http://swrc.ontoware.org/ontology#Publication>,
                                                                 <http://www.aktors.org/ontology/portal#Publication>,
                                                                 <http://sw-portal.deri.org/ontologies/swportal#Publication>.
opus:Publishing_Organization a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "An organization that, among other things, creates publishing periodicals, books or music.";
                             rdfs:label "Publisher";
                             rdfs:subClassOf <http://xmlns.com/foaf/0.1/Organization>;
                             <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.aktors.org/ontology/portal#Publishing-House>.
opus:School a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "An organization where individuals receive education.";
            rdfs:label "School";
            rdfs:subClassOf <http://xmlns.com/foaf/0.1/Organization>.
opus:Serial_Publication a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A periodical that appears at scheduled times.";
                        rdfs:label "Serial Publication";
                        rdfs:subClassOf opus:Publication.
opus:Series a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Publication Series, such as LNCS, WEUR Workshops, etc. (at this time debatable whether this should be subclassof Publication)";
            rdfs:label "Series".
opus:Thesis a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A treatise advancing a new point of view resulting from research; usually a requirement for an advanced academic degree.";
            rdfs:label "Thesis";
            rdfs:subClassOf opus:Publication;
            <http://www.w3.org/2002/07/owl#equivalentClass> <http://knowledgeweb.semanticweb.org/semanticportal/OWL/Documentation_Ontology.owl#Thesis>,
                                                            <http://swrc.ontoware.org/ontology#Thesis>,
                                                            <http://sw-portal.deri.org/ontologies/swportal#Thesis>.
opus:University a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "An institution for higher learning with teaching and research facilities constituting a graduate school and professional schools that award master's degrees and doctorates and an undergraduate division that awards bachelor's degrees.";
                rdfs:label "University";
                rdfs:subClassOf opus:School;
                <http://www.w3.org/2002/07/owl#equivalentClass> <http://knowledgeweb.semanticweb.org/semanticportal/OWL/Organization_Ontology.owl#University>,
                                                                <http://swrc.ontoware.org/ontology#University>,
                                                                <http://www.aktors.org/ontology/portal#University>,
                                                                <http://sw-portal.deri.org/ontologies/swportal#University>.
opus:Webpage a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A webpage, it is subclass of Document because we want to emphasize that the URL of the webpage is used the URI.";
             rdfs:label "Webpage";
             rdfs:subClassOf <http://xmlns.com/foaf/0.1/Document>.
opus:abstract a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "The abstract of a document";
              rdfs:domain <http://xmlns.com/foaf/0.1/Document>;
              rdfs:label "abstract";
              rdfs:range xsd:string.
opus:affiliation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Indicates that a person is affiliated to a specific organization.";
                 rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                 rdfs:label "Affiliation";
                 rdfs:range <http://xmlns.com/foaf/0.1/Organization>;
                 <http://www.w3.org/2002/07/owl#equivalentProperty> <http://swrc.ontoware.org/ontology#affiliation>,
                                                                    <http://www.aktors.org/ontology/portal#has-affiliation>.
opus:at_organization a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Indicates that a publication originates or is related to a specific Organization.";
                     rdfs:domain opus:Publication;
                     rdfs:label "at organization";
                     rdfs:range <http://xmlns.com/foaf/0.1/Organization>.
opus:at_university a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Indicates that a publication originates or is related to a specific University.";
                   rdfs:domain opus:Publication;
                   rdfs:label "at university";
                   rdfs:range opus:University.
opus:author a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Indicates that a publication is authored by a specific person(s).";
            rdfs:domain opus:Publication;
            rdfs:label "Author";
            rdfs:range rdf:Seq.
opus:book_title a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "An alternative Book Title or the Book Title where an article appears, such as title of proceedings.";
                rdfs:domain opus:Publication;
                rdfs:label "book title";
                rdfs:range xsd:string;
                <http://www.w3.org/2002/07/owl#equivalentProperty> <http://swrc.ontoware.org/ontology#booktitle>,
                                                                   <http://purl.org/net/nknouf/ns/bibtex#hasBooktitle>.
opus:cdrom a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "The CDROM location of a Publication, as used by the ACM SIGMOD Anthology.";
           rdfs:domain opus:Publication;
           rdfs:label "cdrom";
           rdfs:range xsd:string.
opus:chapter a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "The chapter number of a publication";
             rdfs:domain opus:Book_Chapter;
             rdfs:label "chapter";
             rdfs:range xsd:string;
             <http://www.w3.org/2002/07/owl#equivalentProperty> <http://knowledgeweb.semanticweb.org/semanticportal/OWL/Documentation_Ontology.owl#Chapter>,
                                                                <http://swrc.ontoware.org/ontology#chapter>.
opus:chapter_of a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Indicates that a book chapter belongs to a specific book. It is debateable whether this should be subclass of Collection.";
                rdfs:domain opus:Book_Chapter;
                rdfs:label "Chapter Of";
                rdfs:range opus:Edited_Book.
opus:cites a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "Indicates that a publication cites another publication.";
           rdfs:domain opus:Publication;
           rdfs:label "Cites";
           <http://www.w3.org/2002/07/owl#equivalentProperty> <http://swrc.ontoware.org/ontology#cite>.
opus:coauthor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Indicates that a person is co-author with another person";
              rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
              rdfs:label "coauthor";
              rdfs:range <http://xmlns.com/foaf/0.1/Person>.
opus:coeditor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Indicates that a person is co-editor with another person";
              rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
              rdfs:label "coeditor";
              rdfs:range <http://xmlns.com/foaf/0.1/Person>.
opus:editor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Indicates that a publication has a specific editor(s).";
            rdfs:domain opus:Edited_Publication;
            rdfs:label "Editor";
            rdfs:range rdf:Seq.
opus:ee a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
        rdfs:comment "The Electronic Edition of a publication";
        rdfs:domain opus:Publication;
        rdfs:label "ee";
        rdfs:range xsd:string.
opus:eepresentation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "The Electronic Edition of a Presentation of a publication";
                    rdfs:domain opus:Publication;
                    rdfs:label "presentation";
                    rdfs:range xsd:string.
opus:gMonth a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "The month part of the date of a foaf:Document represented as xsd:gMonth value";
            rdfs:domain <http://xmlns.com/foaf/0.1/Document>;
            rdfs:label "gMonth";
            rdfs:range xsd:gMonth.
opus:in_series a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Indicates that a Publication is part of a Publication Series.";
               rdfs:domain opus:Publication;
               rdfs:label "In Series";
               rdfs:range opus:Series.
opus:isIncludedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Indicates that a publication is included in a specific proceedings publication.";
                  rdfs:domain opus:Article_in_Proceedings;
                  rdfs:label "is Included in Proceedings";
                  rdfs:range opus:Proceedings;
                  <http://www.w3.org/2002/07/owl#equivalentProperty> <http://sw-portal.deri.org/ontologies/swportal#containedInProceedings>.
opus:isbn a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "The ISBN of a publication.";
          rdfs:domain opus:Publication;
          rdfs:label "isbn";
          rdfs:range xsd:string;
          <http://www.w3.org/2002/07/owl#equivalentProperty> <http://swrc.ontoware.org/ontology#isbn>,
                                                             <http://purl.org/net/nknouf/ns/bibtex#hasISBN>.
opus:journal_name a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "The name of a Journal, such as where an article appears";
                  rdfs:domain opus:Journal;
                  rdfs:label "journal name";
                  rdfs:range xsd:string;
                  <http://www.w3.org/2002/07/owl#equivalentProperty> <http://purl.org/net/nknouf/ns/bibtex#hasJournal>.
opus:last_modified_date a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "The last modified date of a document.";
                        rdfs:domain <http://xmlns.com/foaf/0.1/Document>;
                        rdfs:label "last modified date";
                        rdfs:range xsd:string.
opus:month a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "The month part of the date of a foaf:Document.";
           rdfs:domain <http://xmlns.com/foaf/0.1/Document>;
           rdfs:label "month";
           rdfs:range xsd:string;
           <http://www.w3.org/2002/07/owl#equivalentProperty> <http://swrc.ontoware.org/ontology#month>,
                                                              <http://purl.org/net/nknouf/ns/bibtex#hasMonth>.
opus:number a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "The Number part of citation of a publication.";
            rdfs:domain opus:Publication;
            rdfs:label "number";
            rdfs:range xsd:string;
            <http://www.w3.org/2002/07/owl#equivalentProperty> <http://purl.org/net/nknouf/ns/bibtex#hasNumber>.
opus:pages a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "The Pages part of citation of a publication.";
           rdfs:domain opus:Publication;
           rdfs:label "pages";
           rdfs:range xsd:string;
           <http://www.w3.org/2002/07/owl#equivalentProperty> <http://swrc.ontoware.org/ontology#pages>,
                                                              <http://www.aktors.org/ontology/portal#has-page-numbers>,
                                                              <http://purl.org/net/nknouf/ns/bibtex#hasPages>.
opus:sameAffiliation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Indicates that a person has same affiliation than another person (this is not necessarily transitive)";
                     rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                     rdfs:label "sameAffiliation";
                     rdfs:range <http://xmlns.com/foaf/0.1/Person>.
opus:volume a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "The Volume part of citation of a publication.";
            rdfs:domain opus:Publication;
            rdfs:label "volume";
            rdfs:range xsd:string;
            <http://www.w3.org/2002/07/owl#equivalentProperty> <http://swrc.ontoware.org/ontology#volume>.
opus:year a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "The year part of the date of a foaf:Document.";
          rdfs:domain <http://xmlns.com/foaf/0.1/Document>;
          rdfs:label "year";
          rdfs:range xsd:gYear;
          <http://www.w3.org/2002/07/owl#equivalentProperty> <http://swrc.ontoware.org/ontology#year>.
<http://purl.org/net/nknouf/ns/bibtex#hasBooktitle> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://purl.org/net/nknouf/ns/bibtex#hasISBN> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://purl.org/net/nknouf/ns/bibtex#hasJournal> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://purl.org/net/nknouf/ns/bibtex#hasMonth> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://purl.org/net/nknouf/ns/bibtex#hasNumber> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://purl.org/net/nknouf/ns/bibtex#hasPages> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://sw-portal.deri.org/ontologies/swportal#containedInProceedings> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://swrc.ontoware.org/ontology#affiliation> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://swrc.ontoware.org/ontology#booktitle> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://swrc.ontoware.org/ontology#chapter> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://swrc.ontoware.org/ontology#cite> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://swrc.ontoware.org/ontology#isbn> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://swrc.ontoware.org/ontology#month> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://swrc.ontoware.org/ontology#pages> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://swrc.ontoware.org/ontology#volume> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://swrc.ontoware.org/ontology#year> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://www.aktors.org/ontology/portal#has-affiliation> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://www.aktors.org/ontology/portal#has-page-numbers> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
