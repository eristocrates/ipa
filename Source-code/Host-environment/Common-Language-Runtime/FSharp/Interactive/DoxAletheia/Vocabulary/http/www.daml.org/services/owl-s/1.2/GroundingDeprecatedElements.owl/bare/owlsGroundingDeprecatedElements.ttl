@base <http://www.daml.org/services/owl-s/1.2/GroundingDeprecatedElements.owl>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix shadow-rdf: <http://www.daml.org/services/owl-s/1.2/generic/ObjectList.owl#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix service: <http://www.daml.org/services/owl-s/1.2/Service.owl#>.
@prefix process: <http://www.daml.org/services/owl-s/1.2/Process.owl#>.
@prefix : <http://www.daml.org/services/owl-s/1.2/GroundingDeprecatedElements.owl#>.
@prefix owlsGroundingDeprecatedElements: <http://www.daml.org/services/owl-s/1.2/GroundingDeprecatedElements.owl>.

<http://www.daml.org/services/owl-s/1.2/Grounding.owl> a owl:Ontology.
owlsGroundingDeprecatedElements: a owl:Ontology;
                                 rdfs:comment """
    Upper-level OWL ontology for Groundings that employ WSDL.
    Part of the OWL-S ontology; see http://www.daml.org/services/.

    This version is intended for use with WSDL 1.1.  The OWL-S
    Coalition plans to produce a future version for use with WSDL 2.0,
    when it has been finalized (or nearly so).

    Note that other approaches to grounding may be accommodated
    within the OWL-S framework.  This is the only approach produced
    to date by the OWL-S Coalition.

    For notes on version history, see 
        http://www.daml.org/services/owl-s/1.2/status.html.    
  """;
                                 owl:imports <http://www.daml.org/services/owl-s/1.2/Process.owl>,
                                             <http://www.daml.org/services/owl-s/1.2/Grounding.owl>;
                                 owl:versionInfo """
    $Id: GroundingDeprecatedElements.owl,v 1.2 2005/05/23 06:56:42 martin Exp $
  """.
:WsdlInputMessageMapList a owl:Class;
                         rdfs:comment " Deprecated as of version 1.1; no longer needed ",
                                      " A list of WsdlInputMessageMap instances ";
                         rdfs:subClassOf shadow-rdf:List,
                                         [a owl:Restriction ; 
                                          owl:onProperty shadow-rdf:first ; 
                                          owl:allValuesFrom :WsdlInputMessageMap],
                                         [a owl:Restriction ; 
                                          owl:onProperty shadow-rdf:rest ; 
                                          owl:allValuesFrom :WsdlInputMessageMapList].
:WsdlOutputMessageMapList a owl:Class;
                          rdfs:comment " Deprecated as of version 1.1; no longer needed ",
                                       " A list of WsdlOutputMessageMap instances ";
                          rdfs:subClassOf shadow-rdf:List,
                                          [a owl:Restriction ; 
                                           owl:onProperty shadow-rdf:first ; 
                                           owl:allValuesFrom :WsdlOutputMessageMap],
                                          [a owl:Restriction ; 
                                           owl:onProperty shadow-rdf:rest ; 
                                           owl:allValuesFrom :WsdlOutputMessageMapList].
:damlsParameter a owl:ObjectProperty;
                rdfs:comment """
    Deprecated as of OWL-S 1.0.  owlsParameter should be used.
  """;
                owl:equivalentProperty <http://www.daml.org/services/owl-s/1.2/Grounding.owl#owlsParameter>.
:otherReference a owl:DatatypeProperty;
                rdfs:comment """
    A URI indicating a relevant standards document (other than that
    for WSDL).
    Deprecated as of DAML-S 0.9; no longer recommended or supported.
  """;
                rdfs:domain <http://www.daml.org/services/owl-s/1.2/Grounding.owl#WsdlAtomicProcessGrounding>;
                rdfs:range xsd:anyURI.
:wsdlInputMessageParts a owl:ObjectProperty,
                         owl:FunctionalProperty;
                       rdfs:comment """
    Deprecated as of DAML-S 0.9.
  """;
                       owl:equivalentProperty :wsdlInputs.
:wsdlInputs a owl:ObjectProperty,
              owl:FunctionalProperty;
            rdfs:comment """
    Deprecated as of OWL-S 1.0.  wsdlInput should be used.
  """,
                         """
    A list of WsdlMessageMap instances, one for each
    message part of the WSDL input message.
  """;
            rdfs:domain <http://www.daml.org/services/owl-s/1.2/Grounding.owl#WsdlAtomicProcessGrounding>;
            rdfs:range :WsdlInputMessageMapList.
:wsdlOutputMessageParts a owl:ObjectProperty,
                          owl:FunctionalProperty;
                        rdfs:comment """
    Deprecated as of DAML-S 0.9; wsdlOutputs should now be used.
  """;
                        owl:equivalentProperty :wsdlOutputs.
:wsdlOutputs a owl:ObjectProperty,
               owl:FunctionalProperty;
             rdfs:comment """
    Deprecated as of OWL-S 1.0.  wsdlOutput should be used.
  """,
                          """
    A list of WsdlMessageMap instances, one for each
    output of the atomic process.
  """;
             rdfs:domain <http://www.daml.org/services/owl-s/1.2/Grounding.owl#WsdlAtomicProcessGrounding>;
             rdfs:range :WsdlOutputMessageMapList.
:wsdlReference a owl:DatatypeProperty,
                 owl:FunctionalProperty;
               rdfs:comment """
    Deprecated as of DAML-S 0.9; wsdlVersion should now be used.
  """;
               rdfs:domain <http://www.daml.org/services/owl-s/1.2/Grounding.owl#WsdlAtomicProcessGrounding>;
               rdfs:range xsd:anyURI.
<http://www.daml.org/services/owl-s/1.2/Process.owl> a owl:Ontology.
