turismo:Visita-turistica a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Una visita turística es cada una de las partes de las que se compone una ruta turística. Una visita turística tiene como objetivo uno y sólo un recurso de Zaragoza que forma parte del itinerario de la ruta. Las visitas turísticas están ordenadas temporalmente y el sistema procura minimizar la distancia entre unas y otras de acuerdo a las características del perfil."@es;
                         rdfs:label "Visita turística"@es;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> turismo:Recurso-de-zaragoza ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> <http://www.loa-cnr.it/ontologies/FunctionalParticipation#target> ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> <http://www.loa-cnr.it/ontologies/TemporalRelations#temporally-coincides> ; 
                                          <http://www.w3.org/2002/07/owl#allValuesFrom> turismo:Evento-de-zaragoza ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#onProperty> <http://www.loa-cnr.it/ontologies/TemporalRelations#follows> ; 
                                          <http://www.w3.org/2002/07/owl#allValuesFrom> turismo:Visita-turistica ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         <http://www.loa-cnr.it/ontologies/ExtendedDnS#activity>,
                                         [<http://www.w3.org/2002/07/owl#onProperty> <http://www.loa-cnr.it/ontologies/ExtendedDnS#setting> ; 
                                          <http://www.w3.org/2002/07/owl#someValuesFrom> turismo:Ruta-turistica ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> <http://www.loa-cnr.it/ontologies/FunctionalParticipation#target> ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> turismo:Visita-turistica ; 
                                                                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.loa-cnr.it/ontologies/TemporalRelations#follows> ; 
                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> turismo:Visita-turistica ; 
                                                                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.loa-cnr.it/ontologies/TemporalRelations#precedes> ; 
                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                          a <http://www.w3.org/2002/07/owl#Class>],
                                         [<http://www.w3.org/2002/07/owl#allValuesFrom> turismo:Visita-turistica ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> <http://www.loa-cnr.it/ontologies/TemporalRelations#precedes> ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> turismo:Dia-de-visita-turistica ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> <http://www.loa-cnr.it/ontologies/CommonSenseMapping#happens-at> ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>].
turismo:Visitar-tiempo-corto turismo:necessity-relevance "0.5"^^xsd:float;
                             a turismo:Preferencia-de-ruta;
                             rdfs:label "Durée breve de visite"@fr,
                                        "Short time of visit"@en,
                                        "Tempo de visita breve"@pt,
                                        "Tempo di visita breve"@it,
                                        "Tiempo de visita corto"@es.
turismo:Visitar-tiempo-largo turismo:necessity-relevance "1.6"^^xsd:float;
                             a turismo:Preferencia-de-ruta;
                             rdfs:label "Durée longue de visite"@fr,
                                        "Long time of visit"@en,
                                        "Tempo di visita lungo"@it,
                                        "Tempo longo de visita"@pt,
                                        "Tiempo de visita largo"@es.
turismo:Zona-verde a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Espacio verde en la ciudad de Zaragoza como puede ser parques, zonas ajardinadas, etc."@es;
                   rdfs:label "Zona verde"@es;
                   rdfs:subClassOf turismo:Recurso-turistico.
turismo:address a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                rdfs:comment "Guarda la dirección postal del recurso";
                rdfs:label "Dirección Postal".
turismo:begining-date a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Día de inicio de cada temporada del año. Se distinguen las temporadas de invierno y de verano. Es importante para los horarios de los monumentos."@es;
                      rdfs:domain turismo:Temporada;
                      rdfs:label "Fecha de inicio";
                      rdfs:range xsd:date.
turismo:closing-time a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Hora de cierre del horario de visita de un punto de interés. Por ejemplo, de un museo o de una iglesia."@es;
                     rdfs:domain turismo:Horario-de-visita;
                     rdfs:label "Horario de cierre"@es;
                     rdfs:range xsd:time.
turismo:date a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
               <http://www.w3.org/2002/07/owl#FunctionalProperty>;
             rdfs:comment "Indica la fecha de cada uno de los días de visita que el turista va a estar en Zaragoza. También se aplica a Días Festivos."@es;
             rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (turismo:Dia-Festivo
                                                                   turismo:Dia-de-visita-turistica) ; 
                          a <http://www.w3.org/2002/07/owl#Class>];
             rdfs:label "Fecha"@es;
             rdfs:range xsd:date.
turismo:ending-date a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "Día de finalización de las temporadas del año. Se contemplan temporada de verano y temporada de invierno."@es;
                    rdfs:domain turismo:Temporada;
                    rdfs:label "Fecha de finalización";
                    rdfs:range xsd:date.
turismo:final-date a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Día de finalización de un determinado evento en la ciudad de Zaragoza."@es;
                   rdfs:domain turismo:Evento-de-zaragoza;
                   rdfs:label "Día final";
                   rdfs:range xsd:date.
turismo:has-interest a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment """Esta relación entre recursos e intereses se obtiene a partir de un conjunto de reglas de negocio de turismo. Estas reglas permiten inferir a partir de las preferencias de los usuarios (edns:desire-towards, cúales son sus intereses turísticos. Lo mismo ocurre en el caso de los puntos de interés de la ciudad. Se deduce cuál es el interés potencial que tiene cada recurso para un turista. A partir de la descripción de los intereses de los perfiles y recursos, se calcula la relevancia o importancia subjetiva de cada recurso para un determinado perfil (\"matchmaking\")."""@es;
                     rdfs:label "Tiene interés"@en;
                     rdfs:range turismo:Interes-turistico;
                     rdfs:subPropertyOf <http://www.loa-cnr.it/ontologies/DOLCE-Lite#has-quality>.
turismo:has-no-interest a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment """Representa el valor negativo de la propiedad \"has-interest\"."""@es;
                        rdfs:domain _:B1e4bbdcb8fda8f102b0c7398cf3efbd7;
                        rdfs:label "No tiene interés"@en;
                        rdfs:range turismo:Interes-turistico.
turismo:horario a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                rdfs:comment "Guarda el texto con el horario de visita del recurso.";
                rdfs:label "Horario".
turismo:id-idezar a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                  rdfs:comment "Guarda el identificador del servicio de IDEZar"@es;
                  rdfs:label "Identificador de IDEZar".
turismo:initial-date a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Día de inicio de un determinado evento de Zaragoza. Por ejemplo, un musical o una exposición. En el caso de eventos puntuales, tanto el día de inicio como el final será el mismo."@es;
                     rdfs:domain turismo:Evento-de-zaragoza;
                     rdfs:label "Día inicial";
                     rdfs:range xsd:date.
turismo:interest-relevance a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "Indica el grado de interés objetivo de una determinada preferencia. Por ejemplo, cuál es la relevancia del gusto por la arquitectura o la preferencia por ir de compras."@es;
                           rdfs:domain turismo:Interes-turistico;
                           rdfs:label "Relevancia de los intereses turísticos";
                           rdfs:range xsd:float.
turismo:interest-towards a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Indica los recursos que el usuario quiere que figuren obligatoriamente en la ruta propuesta por el sistema"@es;
                         rdfs:domain turismo:Perfil-de-turista;
                         rdfs:label "Tiene interés en determinados recursos"@en;
                         rdfs:range turismo:Recurso-de-zaragoza.
turismo:necessity-relevance a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:comment "Representa el valor de cada una de las preferencias de ruta. Estas preferencias actúan como restricciones para el planificador. Los valores de estos recursos modifican los parámetros iniciales del sistema de planificador."@es;
                            rdfs:domain turismo:Preferencia-de-ruta;
                            rdfs:label "Relevancia de las preferencias de ruta";
                            rdfs:range xsd:float.
turismo:not-desire-towards a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment """Representa el valor negativo de la propiedad \"desire-towards\". Indica las actividades que el turista no quiere realizar. Esta propiedad, como \"desire-towards\" servirán de entrada para el cálculo de los intereses de los perfiles de turista en las reglas de negocio de turismo de la aplicación."""@es;
                           rdfs:domain turismo:Perfil-de-turista;
                           rdfs:label "No tiene preferencia"@en;
                           rdfs:range turismo:Preferencia-de-usuario.
turismo:not-interest-towards a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Indica los recursos que el usuario no quiere que figuren en la ruta propuesta por el sistema"@es;
                             rdfs:domain turismo:Perfil-de-turista;
                             rdfs:label "No tiene interés en determinados recursos"@en;
                             rdfs:range turismo:Recurso-de-zaragoza.
turismo:opening-time a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Hora de apertura del horario de visita de un punto de interés de la ciudad."@es;
                     rdfs:domain turismo:Horario-de-visita;
                     rdfs:label "Horario de apertura"@es;
                     rdfs:range xsd:time.
turismo:poi-relevance a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                        <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                      rdfs:comment "Es la relevancia o importancia objetiva de cada uno de los puntos de interés de la ciudad de Zaragoza."@es;
                      rdfs:domain turismo:Recurso-turistico;
                      rdfs:label "Relevancia de los Puntos de Interés"@es;
                      rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> ("25"^^xsd:int
                                                                         "50"^^xsd:int
                                                                         "75"^^xsd:int) ; 
                                  a <http://www.w3.org/2002/07/owl#DataRange>].
turismo:visit-duration a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "Tiempo estimado de duración de las visitas a los distintos monumentos y puntos de interés de la ciudad de Zaragoza. Se utiliza para el cálculo de la ruta."@es;
                       rdfs:domain turismo:Recurso-turistico;
                       rdfs:label "Duración de la visita"@es;
                       rdfs:range xsd:int.
<http://purl.org/dc/elements/1.1/coverage> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
