turismo:Dos-tenedores a turismo:Calificacion;
                      <http://www.w3.org/2002/07/owl#differentFrom> turismo:Sin-gluten,
                                                                    turismo:Tres-tenedores,
                                                                    turismo:Un-tenedor.
turismo:Edificio-historico a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Edificio de carácter histórico con interés cultural o arquitectónico."@es;
                           rdfs:label "Edificio histórico"@es;
                           rdfs:subClassOf turismo:Monumento.
turismo:Edificio-religioso a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Edificio de carácter religioso, como pueden ser iglesias, conventos, catedrales, etc."@es;
                           rdfs:label "Edificio religioso"@es;
                           rdfs:subClassOf turismo:Monumento.
turismo:Entorno-natural a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Zona de verde de excepcional singularidad debido a su paisaje, protección medioambiental e interés turístico."@es;
                        rdfs:label "Entorno natural"@es;
                        rdfs:subClassOf turismo:Zona-verde.
turismo:Escultura a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Fuentes y estatuas"@es;
                  rdfs:label "Escultura"@es;
                  rdfs:subClassOf turismo:Monumento.
turismo:Estilo-artistico a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "El estilo es el conjunto de características que individualizan la tendencia artística de una época: barroco, mudéjar, renacentista, etc. La descripción de los estilos de cada monumento se ha extraído de la base de datos de Monumentos."@es;
                         rdfs:label "Estilo artístico"@es;
                         rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DOLCE-Lite#quality>;
                         <http://www.w3.org/2002/07/owl#disjointWith> turismo:Accesibilidad-de-movilidad-reducida.
turismo:Estilo-barroco a turismo:Estilo-artistico;
                       rdfs:label "Style baroque"@fr,
                                  "Estilo barroco"@es,
                                  "Estilo barroco"@pt,
                                  "Stile barocco"@it,
                                  "Baroque style"@en;
                       <http://www.w3.org/2002/07/owl#differentFrom> turismo:Estilo-gotico,
                                                                     turismo:Estilo-contemporaneo,
                                                                     turismo:Estilo-mudejar,
                                                                     turismo:Estilo-modernista,
                                                                     turismo:Estilo-renacentista,
                                                                     turismo:Estilo-romano.
turismo:Estilo-contemporaneo a turismo:Estilo-artistico;
                             rdfs:label "Estilo contemporáneo"@es,
                                        "Stile contemporaneo"@it,
                                        "Style contemporain"@fr,
                                        "Contemporary style"@en,
                                        "Estilo contemporâneo"@pt;
                             <http://www.w3.org/2002/07/owl#differentFrom> turismo:Estilo-romano,
                                                                           turismo:Estilo-gotico,
