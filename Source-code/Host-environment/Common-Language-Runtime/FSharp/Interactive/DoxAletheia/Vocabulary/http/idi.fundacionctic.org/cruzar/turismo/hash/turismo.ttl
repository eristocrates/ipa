<http://idi.fundacionctic.org/cruzar/turismo> <http://purl.org/dc/elements/1.1/creator> "Departamento I+D+i (Fundación CTIC)";
                                              a <http://www.w3.org/2002/07/owl#Ontology>;
                                              rdfs:comment """Esta ontología se ha construido dentro del proyecto financiado por el Ayuntamiento de Zaragoza: \"Un visitante, una ruta\", una aplicación informática para el cálculo de rutas turísticas en la ciudad de Zaragoza en base al perfil y contexto del usuario."""@es;
                                              rdfs:label "Ontología de Turismo para el Ayuntamiento de Zaragoza"@es;
                                              <http://www.w3.org/2002/07/owl#versionInfo> "turismo.owl, v.1.0"@es.
turismo:Accesibilidad-completa a turismo:Accesibilidad-de-movilidad-reducida;
                               rdfs:label "Accesibilidad completa"@es,
                                          "Accessibilità completa"@it,
                                          "Accessibilité complète"@fr,
                                          "Acessibilidade completa"@pt,
                                          "Full accessibility"@en,
                                          "Voll Zugänglichkeit"@de;
                               <http://www.w3.org/2002/07/owl#differentFrom> turismo:Accesibilidad-con-acompanyante,
                                                                             turismo:Accesibilidad-con-muletas.
turismo:Accesibilidad-con-acompanyante a turismo:Accesibilidad-de-movilidad-reducida;
                                       rdfs:label "Accesible con acompañante"@es,
                                                  "Accessibile con addetto"@it,
                                                  "Accessible avec accompagnateur"@fr,
                                                  "Accessible with attendant"@en,
                                                  "Acessível com acompanhante"@pt;
                                       <http://www.w3.org/2002/07/owl#differentFrom> turismo:Accesibilidad-completa,
                                                                                     turismo:Accesibilidad-con-muletas.
turismo:Accesibilidad-con-muletas a turismo:Accesibilidad-de-movilidad-reducida;
                                  rdfs:label "Accesibile con le gruccie"@it,
                                             "Accesible con muletas"@es,
                                             "Accesible with crutches"@en,
                                             "Accessible avec des béquilles"@fr,
                                             "Acessível com muletas"@pt,
                                             "Zugänglichkeit auf Krücken"@de;
                                  <http://www.w3.org/2002/07/owl#differentFrom> turismo:Accesibilidad-completa,
                                                                                turismo:Accesibilidad-con-acompanyante.
turismo:Accesibilidad-de-movilidad-reducida a <http://www.w3.org/2002/07/owl#Class>;
                                            rdfs:comment "La accesibilidad es el grado con el que algo puede ser usado, visitado o accedido por todas las personas, independientemente de sus capacidades técnicas o físicas. En el caso de personas con movilidad reducida (que implique el uso de ayudas técnicas como muletas, sillas de ruedas, etc.), el grado de accesibilidad se mide de acuerdo a la facilidad de desplazamiento de los turistas por el entorno de los distintos recursos de la ciudad. La descripción del grado de accesibilidad de cada monumento se ha extraído de la base de datos de Monumentos."@es;
                                            rdfs:label "Accesibilidad de movilidad reducida"@es;
                                            rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DOLCE-Lite#quality>;
                                            <http://www.w3.org/2002/07/owl#disjointWith> turismo:Estilo-artistico.
turismo:Alojamiento a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Establecimiento de hostelería en Zaragoza en el que se proporciona alojamiento. La elección de un alojamiento determinado modifica el lugar de inicio de la ruta, tomando como punto de partida el alojamiento en el que se hospeda el usuario."@es;
                    rdfs:label "Alojamiento"@es;
                    rdfs:subClassOf turismo:Recurso-hostelero.
turismo:Calificacion a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Calificación oficial proporcionada por el Patronato de Turismo para los distintos restaurantes de la ciudad de Zaragoza."@es;
                     rdfs:label "Calificación"@es;
                     rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DOLCE-Lite#quality>.
turismo:Caminar-velocidad-lenta turismo:necessity-relevance "1.75"^^xsd:float;
                                a turismo:Preferencia-de-ruta;
                                rdfs:label "Slow walking"@en,
                                           "Velocidad de paseo lenta"@es,
                                           "Velocidade lenta de passeio"@pt,
                                           "Velocità bassa di passeggio"@it,
                                           "Vitesse lente de marche"@fr.
turismo:Caminar-velocidad-rapida turismo:necessity-relevance "0.75"^^xsd:float;
                                 a turismo:Preferencia-de-ruta;
                                 rdfs:label "Fast walking"@en,
                                            "Velocidad de paseo rápida"@es,
                                            "Velocidade ligeira de passeio"@pt,
                                            "Velocità leggera di passeggio"@it,
                                            "Vitesse légère de marche"@fr.
