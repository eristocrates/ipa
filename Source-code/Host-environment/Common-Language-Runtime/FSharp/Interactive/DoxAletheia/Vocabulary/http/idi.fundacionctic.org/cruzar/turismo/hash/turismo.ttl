turismo:Dia-Festivo a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Día no laborable relacionado con alguna fiesta local o nacional: Fiesta del Pilar, Navidad, etc. Estos días requieren un tratamiento independiente ya que los recursos turísticos tienen estos días un horario especial."@es;
                    rdfs:label "Día festivo"@es;
                    rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DOLCE-Lite#temporal-region>;
                    <http://www.w3.org/2002/07/owl#disjointWith> turismo:Dia-de-la-semana,
                                                                 turismo:Dia-de-visita-turistica,
                                                                 turismo:Temporada,
                                                                 <http://www.loa-cnr.it/ontologies/DOLCE-Lite#time-interval>.
turismo:Dia-de-la-semana a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Cada uno de los días de la semana"@es;
                         rdfs:label "Día de la semana"@es;
                         rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DOLCE-Lite#temporal-region>;
                         <http://www.w3.org/2002/07/owl#disjointWith> turismo:Dia-Festivo,
                                                                      turismo:Dia-de-visita-turistica,
                                                                      turismo:Temporada,
                                                                      <http://www.loa-cnr.it/ontologies/DOLCE-Lite#time-interval>.
turismo:Dia-de-visita-turistica a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Cada uno de los días de visita turística por la ciudad de Zaragoza que escoge el turista. Para cada uno de estos días, el sistema construirá una ruta específica atendiendo a su perfil y a la disponibilidad de los recursos de la ciudad."@es;
                                rdfs:label "Día de visita turística"@es;
                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> turismo:Temporada ; 
                                                 <http://www.w3.org/2002/07/owl#onProperty> <http://www.loa-cnr.it/ontologies/DOLCE-Lite#part-of> ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                <http://www.loa-cnr.it/ontologies/DOLCE-Lite#temporal-region>,
                                                [<http://www.w3.org/2002/07/owl#onProperty> <http://www.loa-cnr.it/ontologies/DOLCE-Lite#part-of> ; 
                                                 <http://www.w3.org/2002/07/owl#someValuesFrom> turismo:Temporada ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>];
                                <http://www.w3.org/2002/07/owl#disjointWith> <http://www.loa-cnr.it/ontologies/DOLCE-Lite#time-interval>,
                                                                             turismo:Dia-de-la-semana,
                                                                             turismo:Dia-Festivo,
                                                                             turismo:Temporada.
turismo:Dia-de-visita-turistica_6 turismo:date "2007-04-06"^^xsd:date;
                                  a turismo:Dia-de-visita-turistica.
turismo:Dia-de-visita-turistica_7 turismo:date "2007-04-07"^^xsd:date;
                                  a turismo:Dia-de-visita-turistica.
turismo:Domingo <http://www.loa-cnr.it/ontologies/DOLCE-Lite#part> turismo:Horario-de-visita_11;
                a turismo:Dia-de-la-semana;
                rdfs:label "Domingo"@es;
                <http://www.w3.org/2002/07/owl#differentFrom> turismo:Jueves,
