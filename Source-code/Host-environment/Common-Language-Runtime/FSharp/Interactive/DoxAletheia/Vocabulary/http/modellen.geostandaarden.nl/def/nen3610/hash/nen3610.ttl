<http://modellen.geostandaarden.nl/def/nen3610> a <http://www.w3.org/2002/07/owl#Ontology>;
                                                <http://www.w3.org/2002/07/owl#imports> <http://modellen.geostandaarden.nl/def/nen3610/Waardelijsten>,
                                                                                        <http://modellen.geostandaarden.nl/def/nen3610/Basisinformatie-elementen>,
                                                                                        <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel>;
                                                <http://www.w3.org/ns/shacl#declare> [<http://www.w3.org/ns/shacl#prefix> "nen3610" ; 
