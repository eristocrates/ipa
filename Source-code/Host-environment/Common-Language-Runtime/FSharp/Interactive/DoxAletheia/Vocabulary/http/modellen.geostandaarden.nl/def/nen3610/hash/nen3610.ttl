                        rdfs:label "Transportruimte";
                        rdfs:subClassOf nen3610:FunctioneleRuimte;
                        <http://www.w3.org/2004/02/skos/core#notation> "Transportruimte".
nen3610:Verharding <http://bp4mc2.org/def/mim#alias> "Verharding";
