nen3610:Transportruimte <http://bp4mc2.org/def/mim#datumOpname> "20220601";
                        <http://bp4mc2.org/def/mim#herkomst> "nen 3610";
                        <http://bp4mc2.org/def/mim#herkomstDefinitie> "nen 3610";
                        <http://bp4mc2.org/def/mim#indicatieAbstractObject> true;
                        <http://bp4mc2.org/def/mim#toelichting> "Transportlijnen worden onder andere gerealiseerd door wegen, spoorwegen, waterwegen, luchtverbindingen.";
                        <http://purl.org/dc/terms/subject> <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/transportruimte>;
                        a <http://www.w3.org/2002/07/owl#Class>;
