                rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel>;
                rdfs:label "Leiding";
                rdfs:subClassOf nen3610:Constructie;
                <http://www.w3.org/2004/02/skos/core#notation> "Leiding".
