nen3610:Begroeiing <http://bp4mc2.org/def/mim#alias> "Begroeiing";
                   <http://bp4mc2.org/def/mim#datumOpname> "20220601";
                   <http://bp4mc2.org/def/mim#herkomst> "nen 3610";
                   <http://bp4mc2.org/def/mim#herkomstDefinitie> "nen 3610";
                   <http://bp4mc2.org/def/mim#indicatieAbstractObject> true;
                   <http://bp4mc2.org/def/mim#toelichting> "Begroeiing kan dus spontaan of natuurlijk zijn (vegetatie), maar ook door menselijk toedoen tot stand zijn gekomen (aanplant of beplanting) of combinaties daarvan.";
                   <http://purl.org/dc/terms/subject> <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/begroeiing>;
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Planten die op natuurlijke wijze zijn ontstaan of door mensen zijn aangeplant.";
                   rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel>;
                   rdfs:label "Begroeiing";
                   rdfs:subClassOf nen3610:ReeelObject;
                   <http://www.w3.org/2004/02/skos/core#notation> "Begroeiing".
nen3610:Bodem <http://bp4mc2.org/def/mim#alias> "Bodem";
              <http://bp4mc2.org/def/mim#datumOpname> "20220601";
              <http://bp4mc2.org/def/mim#herkomst> "nen 3610";
              <http://bp4mc2.org/def/mim#herkomstDefinitie> "nen 3610";
              <http://bp4mc2.org/def/mim#indicatieAbstractObject> true;
              <http://bp4mc2.org/def/mim#toelichting> "Bodem verwijst naar een typering en/of benoeming van het aardoppervlak, waarbij de bodem doorloopt onder het oppervlaktewater.  Bodem omvat ook de daaronder liggende bodemmaterialen met indelingen die kunnen verschillen per vakgebied zoals bijvoorbeeld bodemkunde, geologie, geohydrologie en geomorfologie.";
              <http://purl.org/dc/terms/subject> <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/bodem>;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Bovenste deel van de aarde, exclusief oppervlaktewater.";
              rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel>;
              rdfs:label "Bodem";
              rdfs:subClassOf nen3610:ReeelObject;
              <http://www.w3.org/2004/02/skos/core#notation> "Bodem".
nen3610:Constructie <http://bp4mc2.org/def/mim#datumOpname> "20220601";
                    <http://bp4mc2.org/def/mim#herkomst> "nen 3610";
                    <http://bp4mc2.org/def/mim#herkomstDefinitie> "nen 3610";
                    <http://bp4mc2.org/def/mim#indicatieAbstractObject> true;
                    <http://bp4mc2.org/def/mim#toelichting> "Constructie kan boven- en ondergrondse objecten betreffen. Voorbeelden zijn: huis, brug, asfalt, waterleiding, fabriek, mijnstelsel.";
                    <http://purl.org/dc/terms/subject> <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/constructie>;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Gebouwd object dat direct of indirect met de bodem is verbonden en bedoeld is om ter plaatse te functioneren.";
                    rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel>;
                    rdfs:label "Constructie";
                    rdfs:subClassOf nen3610:ReeelObject;
                    <http://www.w3.org/2004/02/skos/core#notation> "Constructie".
nen3610:FunctioneleRuimte <http://bp4mc2.org/def/mim#alias> "Functionele ruimte";
                          <http://bp4mc2.org/def/mim#datumOpname> "20220601";
                          <http://bp4mc2.org/def/mim#herkomst> "nen 3610";
                          <http://bp4mc2.org/def/mim#herkomstDefinitie> "nen 3610";
                          <http://bp4mc2.org/def/mim#indicatieAbstractObject> true;
                          <http://bp4mc2.org/def/mim#toelichting> "Een functionele ruimte wordt gebruikt om een (gebruiks)functie aan een ruimte toe te kennen. Het functionele gebruik van de ruimte volgt niet altijd de fysieke begrenzing van re�le objecten.";
                          <http://purl.org/dc/terms/subject> <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/functionele_ruimte>;
                          a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Ruimte met een specifieke functie.";
                          rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel>;
                          rdfs:label "FunctioneleRuimte";
                          rdfs:subClassOf nen3610:VirtueleRuimte;
                          <http://www.w3.org/2004/02/skos/core#notation> "FunctioneleRuimte".
nen3610:Gebouw <http://bp4mc2.org/def/mim#alias> "Gebouw";
               <http://bp4mc2.org/def/mim#datumOpname> "20220601";
               <http://bp4mc2.org/def/mim#herkomst> "nen 3610";
               <http://bp4mc2.org/def/mim#herkomstDefinitie> "nen 3610";
               <http://bp4mc2.org/def/mim#indicatieAbstractObject> true;
               <http://bp4mc2.org/def/mim#toelichting> "Voorbeelden zijn: huis, schuur, flatgebouw, huizenblok, fabriek.";
               <http://purl.org/dc/terms/subject> <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/gebouw>;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Overdekte en geheel of gedeeltelijk met wanden omsloten constructie bedoeld voor het in een afgeschermde omgeving onderbrengen van mensen, dieren of voorwerpen of voor de productie van goederen.";
               rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel>;
               rdfs:label "Gebouw";
               rdfs:subClassOf nen3610:Constructie;
               <http://www.w3.org/2004/02/skos/core#notation> "Gebouw".
nen3610:GeoObject <http://bp4mc2.org/def/mim#alias> "Geo-object";
                  <http://bp4mc2.org/def/mim#datumOpname> "20220601";
                  <http://bp4mc2.org/def/mim#herkomst> "nen 3610";
                  <http://bp4mc2.org/def/mim#herkomstDefinitie> "nen 3610";
                  <http://bp4mc2.org/def/mim#indicatieAbstractObject> true;
                  <http://bp4mc2.org/def/mim#toelichting> "Van dit objecttype worden geen directe instanties gemaakt. Indien een object een geo-object is, is het altijd een instantie van een subklasse van GeoObject. Alle subklassen van GeoObject hebben conform MIM het stereotype �Objecttype�. Voor publicatie conform NEN-EN-ISO 19109:2015 is het stereotype �FeatureType� verplicht. Binnen de context van NEN 3610 is �Objecttype� het equivalent van �FeatureType�.";
                  <http://purl.org/dc/terms/subject> <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/geo-object>;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Een fenomeen in de werkelijkheid dat direct of indirect is geassocieerd met een locatie relatief ten opzichte van de aarde.";
                  rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel>;
                  rdfs:label "GeoObject";
                  <http://www.w3.org/2004/02/skos/core#notation> "GeoObject".
nen3610:GeografischeRuimte <http://bp4mc2.org/def/mim#alias> "Geografische ruimte";
                           <http://bp4mc2.org/def/mim#datumOpname> "20220601";
                           <http://bp4mc2.org/def/mim#herkomst> "nen 3610";
                           <http://bp4mc2.org/def/mim#herkomstDefinitie> "nen 3610";
                           <http://bp4mc2.org/def/mim#indicatieAbstractObject> true;
                           <http://bp4mc2.org/def/mim#toelichting> "De grenzen zijn niet altijd exact vastgesteld. Voorbeelden zijn: Noordoostpolder, Midden-Nederland, rivierengebied, Veluwe, Zuid-Limburg, kustgebied. ";
                           <http://purl.org/dc/terms/subject> <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/geografische_ruimte>;
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Ruimte die bekendstaat onder een vanuit de historie of het gebruik bekende benaming of een fysisch-geografische samenhang, al dan niet met zijn omgeving, kent.";
                           rdfs:isDefinedBy <http://modellen.geostandaarden.nl/def/nen3610/SemantischModel>;
                           rdfs:label "GeografischeRuimte";
                           rdfs:subClassOf nen3610:VirtueleRuimte;
                           <http://www.w3.org/2004/02/skos/core#notation> "GeografischeRuimte".
