<http://modellen.geostandaarden.nl/nen3610/id/shape/RegistratieveRuimte> <http://bp4mc2.org/def/mim#alias> "Registratieve ruimte";
                                                                         <http://bp4mc2.org/def/mim#datumOpname> "20220601";
