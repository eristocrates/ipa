@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rml: <http://w3id.org/rml/>.

<http://creativecommons.org/ns#license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/issued> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/ontology/bibo/status> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rml:BlankNode a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Denotes a blank node, used with termType"@en;
              rdfs:isDefinedBy <http://w3id.org/rml/core/>;
              rdfs:label "Blank Node".
rml:ChildMap a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Represents a child map"@en;
             rdfs:isDefinedBy <http://w3id.org/rml/core/>;
             rdfs:label "Child Map";
             rdfs:subClassOf rml:ExpressionMap.
rml:DatatypeMap a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Represents a datatype map"@en;
                rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                rdfs:label "Datatype Map";
                rdfs:subClassOf rml:ExpressionMap.
rml:ExpressionMap a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Represents an expression map"@en;
                  rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                  rdfs:label "Expression Map".
rml:GraphMap a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Represents a graph map."@en;
             rdfs:isDefinedBy <http://w3id.org/rml/core/>;
             rdfs:label "Graph Map";
             rdfs:subClassOf rml:TermMap.
rml:IRI a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:comment "Denotes an IRI, used with termpType."@en;
        rdfs:isDefinedBy <http://w3id.org/rml/core/>;
        rdfs:label "IRI".
rml:Join a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "Represents a join condition."@en;
         rdfs:isDefinedBy <http://w3id.org/rml/core/>;
         rdfs:label "Join".
rml:LanguageMap a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Represents a language map";
                rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                rdfs:label "Language Map";
                rdfs:subClassOf rml:ExpressionMap.
rml:Literal a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Denotes a Literal, used with termType."@en;
            rdfs:isDefinedBy <http://w3id.org/rml/core/>;
            rdfs:label "Literal".
rml:LogicalSource a <http://www.w3.org/2002/07/owl#Class>.
rml:LogicalTarget a <http://www.w3.org/2002/07/owl#Class>.
rml:ObjectMap a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Represents an object map."@en;
              rdfs:isDefinedBy <http://w3id.org/rml/core/>;
              rdfs:label "Object Map";
              rdfs:subClassOf rml:TermMap.
rml:ParentMap a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Represents a parent map"@en;
              rdfs:isDefinedBy <http://w3id.org/rml/core/>;
              rdfs:label "Parent Map";
              rdfs:subClassOf rml:ExpressionMap.
rml:PredicateMap a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Represents a predicate map."@en;
                 rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                 rdfs:label "Predicate Map";
                 rdfs:subClassOf rml:TermMap.
rml:PredicateObjectMap a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Represents a predicate-object map."@en;
                       rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                       rdfs:label "Predicate Object Map".
rml:RefObjectMap a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Denotes a reference to an object map."@en;
                 rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                 rdfs:label "Reference Object Map".
rml:Strategy a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Denotes a strategy to perform a action (e.g. gather for collections and containers, joins)."@en;
             rdfs:isDefinedBy <http://w3id.org/rml/core/>;
             rdfs:label "Strategy".
rml:SubjectMap a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Represents a subject map."@en;
               rdfs:isDefinedBy <http://w3id.org/rml/core/>;
               rdfs:label "Subject Map";
               rdfs:subClassOf rml:TermMap.
rml:TermMap a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A function that generates any number of RDF terms from a logical source record."@en;
            rdfs:isDefinedBy <http://w3id.org/rml/core/>;
            rdfs:label "Term Map"@en;
            rdfs:subClassOf rml:ExpressionMap.
rml:TriplesMap a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Represents a triples map."@en;
               rdfs:isDefinedBy <http://w3id.org/rml/core/>;
               rdfs:label "Triples Map".
rml:child a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "Names a source record in the child source of a join."@en;
          rdfs:domain rml:Join;
          rdfs:isDefinedBy <http://w3id.org/rml/core/>;
          rdfs:label "child";
          rdfs:range xsd:string.
rml:childMap a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Names a child map in the child source of a join."@en;
             rdfs:domain rml:Join;
             rdfs:isDefinedBy <http://w3id.org/rml/core/>;
             rdfs:label "child map";
             rdfs:range rml:ChildMap.
rml:class a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "The subject value generated for a logical source record will be asserted as an instance of this RDFS class."@en;
          rdfs:domain rml:SubjectMap;
          rdfs:isDefinedBy <http://w3id.org/rml/core/>;
          rdfs:label "class";
          rdfs:range rdfs:Class.
rml:constant a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
             rdfs:comment "A property for indicating whether a expression map is a constant-valued expression map."@en;
             rdfs:domain rml:ExpressionMap;
             rdfs:isDefinedBy <http://w3id.org/rml/core/>;
             rdfs:label "constant".
rml:core <http://purl.org/dc/terms/contributor> "Samaneh Jozashoori",
                                                "Christophe Debruyne",
                                                "David Chaves Fraga",
                                                "Pano Maria",
                                                "Ana Iglesias Molina",
                                                "Dylan Van Assche",
                                                "Julián Arenas Guerrero",
                                                "Ben de Meester",
                                                "Franck Michel",
                                                "Anastasia Dimou";
         <http://purl.org/dc/terms/created> "2023-03-14";
         <http://purl.org/dc/terms/description> "Generic Mapping Language for RDF (RDB/CSV/TSV/XML/JSON/... to RDF) - Vocabulary description"@en;
         <http://purl.org/dc/terms/license> <http://purl.org/NET/rdflicense/cc-by4.0>;
         <http://purl.org/dc/terms/modified> "2023-06-15";
         <http://purl.org/dc/terms/publisher> <https://www.w3.org/community/kg-construct/>;
         <http://purl.org/dc/terms/title> "RML: Generic Mapping Language for RDF"@en;
         <http://purl.org/ontology/bibo/status> "draft";
         <http://purl.org/vocab/vann/preferredNamespacePrefix> "rml";
         <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/rml/";
         a <http://www.w3.org/2002/07/owl#Ontology>;
         <http://www.w3.org/2002/07/owl#versionIRI> rml:core;
         <http://www.w3.org/2002/07/owl#versionInfo> "0.1.0".
rml:datatype a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Specifies the datatype of the object component for the generated triple."@en;
             rdfs:domain rml:ObjectMap;
             rdfs:isDefinedBy <http://w3id.org/rml/core/>;
             rdfs:label "datatype".
rml:datatypeMap a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "A DatatypetMap element to generate the datatype component of the object component from a logical source record."@en;
                rdfs:domain rml:ObjectMap;
                rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                rdfs:label "datatype map";
                rdfs:range rml:DatatypeMap.
rml:graph a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "An IRI reference for use as the graph name of all triples generated with the SubjectMap or PredicateObjectMap."@en;
          rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (rml:PredicateObjectMap
                                                                rml:SubjectMap) ; 
                       a <http://www.w3.org/2002/07/owl#Class>];
          rdfs:isDefinedBy <http://w3id.org/rml/core/>;
          rdfs:label "graph".
rml:graphMap a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Specifies a GraphMap. When used with a SubjectMap element, all the RDF triples generated from a logical row will be stored in the specified named graph. Otherwise, the RDF triple generated using the (predicate, object) pair will be stored in the specified named graph."@en;
             rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (rml:PredicateObjectMap
                                                                   rml:SubjectMap) ; 
                          a <http://www.w3.org/2002/07/owl#Class>];
             rdfs:isDefinedBy <http://w3id.org/rml/core/>;
             rdfs:label "graph map";
             rdfs:range rml:GraphMap.
rml:joinCondition a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Specifies the join condition for joining the child logical source with the parent logical source of the foreign key constraint."@en;
                  rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                  rdfs:label "join condition";
                  rdfs:range rml:Join.
rml:language a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "Specified the language for the object component for the generated triple."@en;
             rdfs:domain rml:ObjectMap;
             rdfs:isDefinedBy <http://w3id.org/rml/core/>;
             rdfs:label "language";
             rdfs:range xsd:string.
rml:languageMap a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "A LanguagetMap element to generate the language tag of the object component from a logical source record."@en;
                rdfs:domain rml:ObjectMap;
                rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                rdfs:label "language map";
                rdfs:range rml:LanguageMap.
rml:logicalSource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Represents the logical source to be mapped."@en;
                  rdfs:domain rml:TriplesMap;
                  rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                  rdfs:label "logical source";
                  rdfs:range rml:LogicalSource.
rml:logicalTarget a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Represents the logical target to where triples are exported to.";
                  rdfs:domain rml:TermMap;
                  rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                  rdfs:label "logical target";
                  rdfs:range rml:LogicalTarget.
rml:object a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "Specifies the object for the generated triple from the logical source record."@en;
           rdfs:domain rml:PredicateObjectMap;
           rdfs:isDefinedBy <http://w3id.org/rml/core/>;
           rdfs:label "object";
           rdfs:range rdfs:Resource.
rml:objectMap a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "An ObjectMap element to generate the object component of the (predicate, object) pair from a logical source record."@en;
              rdfs:domain rml:PredicateObjectMap;
              rdfs:isDefinedBy <http://w3id.org/rml/core/>;
              rdfs:label "object map".
rml:parent a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "Names a source record in the parent source of a join."@en;
           rdfs:domain rml:Join;
           rdfs:isDefinedBy <http://w3id.org/rml/core/>;
           rdfs:label "parent";
           rdfs:range xsd:string.
rml:parentMap a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Names a parent map in the parent source of a join."@en;
              rdfs:domain rml:Join;
              rdfs:isDefinedBy <http://w3id.org/rml/core/>;
              rdfs:label "parent map";
              rdfs:range rml:ParentMap.
rml:parentTriplesMap a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Specifies the TriplesMap element corresponding to the parent logical source of the foreign key constraint."@en;
                     rdfs:domain rml:RefObjectMap;
                     rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                     rdfs:label "parent triples map";
                     rdfs:range rml:TriplesMap.
rml:predicate a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Specifies the predicate for the generated triple from the logical source record."@en;
              rdfs:domain rml:PredicateObjectMap;
              rdfs:isDefinedBy <http://w3id.org/rml/core/>;
              rdfs:label "predicate".
rml:predicateMap a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "A PredicateMap element to generate the predicate component of the (predicate, object) pair from a logical source record."@en;
                 rdfs:domain rml:PredicateObjectMap;
                 rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                 rdfs:label "predicate map";
                 rdfs:range rml:PredicateMap.
rml:predicateObjectMap a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "A PredicateObjectMap element to generate (predicate, object) pair from a logical source record."@en;
                       rdfs:domain rml:TriplesMap;
                       rdfs:isDefinedBy <http://w3id.org/rml/core/>;
                       rdfs:label "predicate object map";
                       rdfs:range rml:PredicateObjectMap.
rml:reference a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "A valid expression that selects values from the source data. The reference should conform to the syntax rules/grammar of the specified Reference Formulation.";
              rdfs:domain rml:ExpressionMap;
              rdfs:isDefinedBy <http://w3id.org/rml/core/>;
              rdfs:label "reference";
              rdfs:range xsd:string.
rml:strategy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "A Strategy element to indicate how to perform an action (e.g. gather for collections and containers, join)."@en;
             rdfs:isDefinedBy <http://w3id.org/rml/core/>;
             rdfs:label "strategy";
             rdfs:range rml:Strategy.
rml:subject a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "An IRI reference for use as subject for all the RDF triples generated from a logical source record."@en;
            rdfs:domain rml:TriplesMap;
            rdfs:isDefinedBy <http://w3id.org/rml/core/>;
            rdfs:label "subject".
rml:subjectMap a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "A SubjectMap element to generate a subject from a logical source record."@en;
               rdfs:domain rml:TriplesMap;
               rdfs:isDefinedBy <http://w3id.org/rml/core/>;
               rdfs:label "subject map";
               rdfs:range rml:SubjectMap.
rml:template a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "A template (format string) to specify how to generate a value for a expression map, using one or more records from a logical source record."@en;
             rdfs:domain rml:ExpressionMap;
             rdfs:isDefinedBy <http://w3id.org/rml/core/>;
             rdfs:label "template";
             rdfs:range xsd:string.
rml:termType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "A string indicating whether subject or object generated using the value from a source record name specified should be an IRI reference, blank node, or a literal."@en;
             rdfs:domain rml:TermMap;
             rdfs:isDefinedBy <http://w3id.org/rml/core/>;
             rdfs:label "term type";
             rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (rml:BlankNode
                                                                  rml:IRI
                                                                  rml:Literal) ; 
                         a <http://www.w3.org/2002/07/owl#Class>].
<http://www.linkedmodel.org/schema/vaem#acronym> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:Class a <http://www.w3.org/2002/07/owl#Class>.
rdfs:Resource a <http://www.w3.org/2002/07/owl#Class>.
<http://xmlns.com/foaf/0.1/name> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
