@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix owl_time: <http://www.w3.org/2006/time#>.

xsd:dateTimeStamp a rdfs:Datatype;
                  rdfs:label "dateTimeStamp";
                  rdfs:subClassOf rdfs:Literal.
<http://www.w3.org/2006/time> <http://purl.org/dc/terms/contributor> <mailto:chris.little@metoffice.gov.uk>;
                              <http://purl.org/dc/terms/created> "2006-09-27"^^xsd:date;
                              <http://purl.org/dc/terms/creator> <http://orcid.org/0000-0002-3884-3420>,
                                                                 <mailto:panfeng66@gmail.com>,
                                                                 <https://en.wikipedia.org/wiki/Jerry_Hobbs>;
                              <http://purl.org/dc/terms/isVersionOf> <http://www.w3.org/TR/owl-time>;
                              <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/>;
                              <http://purl.org/dc/terms/modified> "2017-04-06"^^xsd:date;
                              <http://purl.org/dc/terms/rights> "Copyright © 2006-2017 W3C, OGC. W3C and OGC liability, trademark and document use rules apply."@en;
                              a <http://www.w3.org/2002/07/owl#Ontology>;
                              rdfs:label "OWL-Time"@en;
                              rdfs:seeAlso <http://www.w3.org/TR/owl-time>,
                                           <http://dx.doi.org/10.3233/SW-150187>,
                                           <http://www.semantic-web-journal.net/content/time-ontology-extended-non-gregorian-calendar-applications>;
                              <http://www.w3.org/2002/07/owl#priorVersion> owl_time:2006;
                              <http://www.w3.org/2002/07/owl#versionIRI> owl_time:2016;
                              <http://www.w3.org/2004/02/skos/core#changeNote> "2016-12-20 - adjust range of time:timeZone to time:TimeZone, moved up from the tzont ontology.  ",
                                                                               "2016-06-15 - initial update of OWL-Time - modified to support arbitrary temporal reference systems. ",
                                                                               "2017-02 - intervalIn, intervalDisjoint, monthOfYear added; TemporalUnit subclass of TemporalDuration",
                                                                               """2016-12-20 - restore time:Year and time:January which were present in the 2006 version of the ontology, but now marked \"deprecated\". """,
                                                                               "2017-04-06 - hasTime, hasXSDDuration added; Number removed; all duration elements changed to xsd:decimal";
                              <http://www.w3.org/2004/02/skos/core#historyNote> """Update of OWL-Time ontology, extended to support general temporal reference systems. 

Ontology engineering by Simon J D Cox"""@en.
owl_time:DateTimeDescription a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Description of date and time structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of year, month, day properties restricted to corresponding XML Schema types xsd:gYear, xsd:gMonth and xsd:gDay, respectively."@en;
                             rdfs:label "Date-Time description"@en;
                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> owl_time:hasTRS ; 
                                              <http://www.w3.org/2002/07/owl#hasValue> <http://www.opengis.net/def/uom/ISO-8601/0/Gregorian> ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#onProperty> owl_time:year ; 
                                              <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:gYear ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#onProperty> owl_time:month ; 
                                              <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:gMonth ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#onProperty> owl_time:day ; 
                                              <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:gDay ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             owl_time:GeneralDateTimeDescription;
                             <http://www.w3.org/2004/02/skos/core#definition> "Description of date and time structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of year, month, day properties restricted to corresponding XML Schema types xsd:gYear, xsd:gMonth and xsd:gDay, respectively."@en.
owl_time:DateTimeInterval a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "DateTimeInterval is a subclass of ProperInterval, defined using the multi-element DateTimeDescription."@en;
                          rdfs:label "Date-time interval"@en;
                          rdfs:subClassOf owl_time:ProperInterval;
                          <http://www.w3.org/2004/02/skos/core#definition> "DateTimeInterval is a subclass of ProperInterval, defined using the multi-element DateTimeDescription."@en;
                          <http://www.w3.org/2004/02/skos/core#note> ":DateTimeInterval can only be used for an interval whose limits coincide with a date-time element aligned to the calendar and timezone indicated. For example, while both have a duration of one day, the 24-hour interval beginning at midnight at the beginning of 8 May in Central Europe can be expressed as a :DateTimeInterval, but the 24-hour interval starting at 1:30pm cannot."@en.
owl_time:DayOfWeek a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The day of week"@en;
                   rdfs:label "Day of week"@en;
                   rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                   <http://www.w3.org/2004/02/skos/core#changeNote> """Remove enumeration from definition, in order to allow other days to be used when required in other calendars. 
NOTE: existing days are still present as members of the class, but the class membership is now open. 

In the original OWL-Time the following constraint appeared: 
  owl:oneOf (
      time:Monday
      time:Tuesday
      time:Wednesday
      time:Thursday
      time:Friday
      time:Saturday
      time:Sunday
    ) ;"""@en;
                   <http://www.w3.org/2004/02/skos/core#definition> "The day of week"@en;
                   <http://www.w3.org/2004/02/skos/core#note> "Membership of the class :DayOfWeek is open, to allow for alternative week lengths and different day names."@en.
owl_time:Duration a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Duration of a temporal extent expressed as a number scaled by a temporal unit"@en;
                  rdfs:label "Time duration"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> owl_time:unitType ; 
                                   <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#onProperty> owl_time:numericDuration ; 
                                   <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  owl_time:TemporalDuration;
                  <http://www.w3.org/2004/02/skos/core#definition> "Duration of a temporal extent expressed as a number scaled by a temporal unit"@en;
                  <http://www.w3.org/2004/02/skos/core#note> "Alternative to time:DurationDescription to support description of a temporal duration other than using a calendar/clock system."@en.
owl_time:DurationDescription a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Description of temporal extent structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of each of the numeric properties is restricted to xsd:decimal"@en;
                             rdfs:label "Duration description"@en;
                             rdfs:subClassOf owl_time:GeneralDurationDescription,
                                             [<http://www.w3.org/2002/07/owl#onProperty> owl_time:months ; 
                                              <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:decimal ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#onProperty> owl_time:weeks ; 
                                              <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:decimal ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#onProperty> owl_time:days ; 
                                              <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:decimal ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#onProperty> owl_time:hours ; 
                                              <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:decimal ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#onProperty> owl_time:hasTRS ; 
                                              <http://www.w3.org/2002/07/owl#hasValue> <http://www.opengis.net/def/uom/ISO-8601/0/Gregorian> ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#onProperty> owl_time:seconds ; 
                                              <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:decimal ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#onProperty> owl_time:minutes ; 
                                              <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:decimal ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#onProperty> owl_time:years ; 
                                              <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:decimal ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>];
                             <http://www.w3.org/2004/02/skos/core#definition> "Description of temporal extent structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of each of the numeric properties is restricted to xsd:decimal"@en;
                             <http://www.w3.org/2004/02/skos/core#note> """In the Gregorian calendar the length of the month is not fixed. Therefore, a value like \"2.5 months\" cannot be exactly compared with a similar duration expressed in terms of weeks or days."""@en.
owl_time:Friday a owl_time:DayOfWeek;
                rdfs:label "Friday"@en;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Venerdì"@it,
                                                                "Vendredi"@fr,
                                                                "Viernes"@es,
                                                                "Friday"@en,
                                                                "Piątek"@pl,
                                                                "Vrijdag"@nl,
                                                                "Freitag"@de,
                                                                "金曜日"@ja,
                                                                "Пятница"@ru,
                                                                "الجمعة"@ar,
                                                                "星期五"@zh,
                                                                "Sexta-feira"@pt.
owl_time:GeneralDateTimeDescription a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:comment "Description of date and time structured with separate values for the various elements of a calendar-clock system"@en;
                                    rdfs:label "Generalized date-time description"@en;
                                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> owl_time:dayOfWeek ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:timeZone ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:minute ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:unitType ; 
                                                     <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:day ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:hour ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:week ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    owl_time:TemporalPosition,
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:year ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:monthOfYear ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:second ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:month ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:dayOfYear ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>];
                                    <http://www.w3.org/2004/02/skos/core#definition> "Description of date and time structured with separate values for the various elements of a calendar-clock system"@en;
                                    <http://www.w3.org/2004/02/skos/core#note> "Some combinations of properties are redundant - for example, within a specified :year if :dayOfYear is provided then :day and :month can be computed, and vice versa. Individual values should be consistent with each other and the calendar, indicated through the value of the :hasTRS property.".
owl_time:GeneralDurationDescription a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:comment "Description of temporal extent structured with separate values for the various elements of a calendar-clock system."@en;
                                    rdfs:label "Generalized duration description"@en;
                                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> owl_time:years ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:months ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:hasTRS ; 
                                                     <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    owl_time:TemporalDuration,
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:weeks ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:days ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:hours ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:seconds ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> owl_time:minutes ; 
                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>];
                                    <http://www.w3.org/2004/02/skos/core#definition> "Description of temporal extent structured with separate values for the various elements of a calendar-clock system."@en;
                                    <http://www.w3.org/2004/02/skos/core#note> """The extent of a time duration expressed as a GeneralDurationDescription depends on the Temporal Reference System. In some calendars the length of the week or month is not constant within the year. Therefore, a value like \"2.5 months\" may not necessarily be exactly compared with a similar duration expressed in terms of weeks or days. When non-earth-based calendars are considered even more care must be taken in comparing durations."""@en.
owl_time:Instant a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A temporal entity with zero extent or duration"@en;
                 rdfs:label "Time instant"@en;
                 rdfs:subClassOf owl_time:TemporalEntity;
                 <http://www.w3.org/2004/02/skos/core#definition> "A temporal entity with zero extent or duration"@en.
owl_time:Interval a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A temporal entity with an extent or duration"@en;
                  rdfs:label "Time interval"@en;
                  rdfs:subClassOf owl_time:TemporalEntity;
                  <http://www.w3.org/2004/02/skos/core#definition> "A temporal entity with an extent or duration"@en.
owl_time:January a <http://www.w3.org/2002/07/owl#DeprecatedClass>,
                   <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "January";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> owl_time:month ; 
                                  <http://www.w3.org/2002/07/owl#hasValue> "--01" ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> owl_time:unitType ; 
                                  <http://www.w3.org/2002/07/owl#hasValue> owl_time:unitMonth ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 owl_time:DateTimeDescription;
                 <http://www.w3.org/2002/07/owl#deprecated> true;
                 <http://www.w3.org/2004/02/skos/core#historyNote> "This class was present in the 2006 version of OWL-Time. It was presented as an example of how DateTimeDescription could be specialized, but does not belong in the revised ontology. ".
owl_time:Monday a owl_time:DayOfWeek;
                rdfs:label "Monday"@en;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Monday"@en,
                                                                "Lunes"@es,
                                                                "Lundi"@fr,
                                                                "Montag"@de,
                                                                "الاثنين"@ar,
                                                                "月曜日"@ja,
                                                                "Lunedì"@it,
                                                                "Понедельник"@ru,
                                                                "Maandag"@nl,
                                                                "Poniedziałek"@pl,
                                                                "星期一"@zh,
                                                                "Segunda-feira"@pt.
owl_time:MonthOfYear a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "The month of the year"@en;
                     rdfs:label "Month of year"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> owl_time:month ; 
                                      <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onProperty> owl_time:second ; 
                                      <http://www.w3.org/2002/07/owl#cardinality> "0"^^xsd:nonNegativeInteger ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onProperty> owl_time:day ; 
                                      <http://www.w3.org/2002/07/owl#cardinality> "0"^^xsd:nonNegativeInteger ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onProperty> owl_time:minute ; 
                                      <http://www.w3.org/2002/07/owl#cardinality> "0"^^xsd:nonNegativeInteger ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onProperty> owl_time:week ; 
                                      <http://www.w3.org/2002/07/owl#cardinality> "0"^^xsd:nonNegativeInteger ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onProperty> owl_time:unitType ; 
                                      <http://www.w3.org/2002/07/owl#hasValue> owl_time:unitMonth ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onProperty> owl_time:year ; 
                                      <http://www.w3.org/2002/07/owl#cardinality> "0"^^xsd:nonNegativeInteger ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     owl_time:DateTimeDescription,
                                     [<http://www.w3.org/2002/07/owl#onProperty> owl_time:hour ; 
                                      <http://www.w3.org/2002/07/owl#cardinality> "0"^^xsd:nonNegativeInteger ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>];
                     <http://www.w3.org/2004/02/skos/core#definition> "The month of the year"@en;
                     <http://www.w3.org/2004/02/skos/core#editorialNote> "Feature at risk - added in 2017 revision, and not yet widely used. "@en;
                     <http://www.w3.org/2004/02/skos/core#note> "Membership of the class :MonthOfYear is open, to allow for alternative annual calendars and different month names."@en.
owl_time:ProperInterval a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en;
                        rdfs:label "Proper interval"@en;
                        rdfs:subClassOf owl_time:Interval;
                        <http://www.w3.org/2002/07/owl#disjointWith> owl_time:Instant;
                        <http://www.w3.org/2004/02/skos/core#definition> "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en.
owl_time:Saturday a owl_time:DayOfWeek;
                  rdfs:label "Saturday"@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "السبت"@ar,
                                                                  "土曜日"@ja,
                                                                  "Sabato"@it,
                                                                  "Sábado"@pt,
                                                                  "Sábado"@es,
                                                                  "Zaterdag"@nl,
                                                                  "Суббота"@ru,
                                                                  "Sobota"@pl,
                                                                  "星期六"@zh,
                                                                  "Samedi"@fr,
                                                                  "Saturday"@en,
                                                                  "Samstag"@de.
owl_time:Sunday a owl_time:DayOfWeek;
                rdfs:label "Sunday"@en;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Zondag"@nl,
                                                                "Sunday"@en,
                                                                "Воскресенье"@ru,
