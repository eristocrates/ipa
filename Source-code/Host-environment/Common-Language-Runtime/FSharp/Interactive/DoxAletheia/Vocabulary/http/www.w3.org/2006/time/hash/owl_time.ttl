                                                                   "一個月"@zh,
                                                                   "شهر واحد"@ar,
                                                                   "一か月"@jp,
                                                                   "monat"@de;
                   owl_time:days 0 ;
                   owl_time:hours 0 ;
                   owl_time:minutes 0 ;
                   owl_time:months 1 ;
                   owl_time:seconds 0 ;
                   owl_time:weeks 0 ;
                   owl_time:years 0 .
owl_time:unitSecond a owl_time:TemporalUnit;
                    rdfs:label "Second (unit of temporal duration)"@en;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "segundo"@es,
                                                                    "segundo"@pt,
                                                                    "seconde"@nl,
                                                                    "seconde"@fr,
                                                                    "Sekunde"@de,
                                                                    "second"@en,
                                                                    "ثانية واحدة"@ar,
                                                                    "一秒"@zh,
                                                                    "一秒"@jp,
                                                                    "일초"@kr,
                                                                    "Sekundę"@pl,
                                                                    "secondo"@it;
                    owl_time:days 0 ;
                    owl_time:hours 0 ;
                    owl_time:minutes 0 ;
                    owl_time:months 0 ;
                    owl_time:seconds 1 ;
                    owl_time:weeks 0 ;
                    owl_time:years 0 .
owl_time:unitType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "The temporal unit which provides the precision of a date-time value or scale of a temporal extent"@en;
                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (owl_time:GeneralDateTimeDescription
                                                                        owl_time:Duration) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:label "temporal unit type"@en;
                  rdfs:range owl_time:TemporalUnit.
owl_time:unitWeek a owl_time:TemporalUnit;
                  rdfs:label "Week (unit of temporal duration)"@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "一週間"@jp,
                                                                  "week"@en,
                                                                  "week"@nl,
                                                                  "settimana"@it,
                                                                  "semana"@pt,
                                                                  "semana"@es,
                                                                  "одна неделя"@ru,
                                                                  "tydzień"@pl,
                                                                  "일주일"@kr,
                                                                  "一周"@zh,
                                                                  "semaine"@fr,
                                                                  "سبوع واحد"@ar,
                                                                  "Woche"@de;
                  owl_time:days 0 ;
                  owl_time:hours 0 ;
                  owl_time:minutes 0 ;
                  owl_time:months 0 ;
                  owl_time:seconds 0 ;
                  owl_time:weeks 1 ;
                  owl_time:years 0 .
owl_time:unitYear a owl_time:TemporalUnit;
                  rdfs:label "Year (unit of temporal duration)"@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "anno"@it,
                                                                  "سنة واحدة"@ar,
                                                                  "一年"@zh,
                                                                  "jaar"@nl,
                                                                  "Jahr"@de,
                                                                  "Rok"@pl,
                                                                  "один год"@ru,
                                                                  "un año"@es,
                                                                  "year"@en,
                                                                  "an"@fr,
                                                                  "1 년"@kr,
                                                                  "1年"@jp,
                                                                  "ano"@pt;
                  owl_time:days 0 ;
                  owl_time:hours 0 ;
                  owl_time:minutes 0 ;
                  owl_time:months 0 ;
                  owl_time:seconds 0 ;
                  owl_time:weeks 0 ;
                  owl_time:years 1 .
owl_time:week a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Week number within the year."@en;
              rdfs:domain owl_time:GeneralDateTimeDescription;
              rdfs:label "week"@en;
              rdfs:range xsd:nonNegativeInteger;
              <http://www.w3.org/2004/02/skos/core#note> "Weeks are numbered differently depending on the calendar in use and the local language or cultural conventions (locale). ISO-8601 specifies that the first week of the year includes at least four days, and that Monday is the first day of the week. In that system, week 1 is the week that contains the first Thursday in the year."@en.
owl_time:weeks a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "length of, or element of the length of, a temporal extent expressed in weeks"@en;
               rdfs:domain owl_time:GeneralDurationDescription;
               rdfs:label "weeks duration"@en;
               rdfs:range xsd:decimal.
owl_time:xsdDateTime a <http://www.w3.org/2002/07/owl#DeprecatedProperty>,
                       <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Value of DateTimeInterval expressed as a compact value."@en;
                     rdfs:domain owl_time:DateTimeInterval;
                     rdfs:label "has XSD date-time"@en;
                     rdfs:range xsd:dateTime;
                     <http://www.w3.org/2002/07/owl#deprecated> true;
                     <http://www.w3.org/2004/02/skos/core#note> "Using xsd:dateTime in this place means that the duration of the interval is implicit: it corresponds to the length of the smallest non-zero element of the date-time literal. However, this rule cannot be used for intervals whose duration is more than one rank smaller than the starting time - e.g. the first minute or second of a day, the first hour of a month, or the first day of a year. In these cases the desired interval cannot be distinguished from the interval corresponding to the next rank up. Because of this essential ambiguity, use of this property is not recommended and it is deprecated."@en.
owl_time:year a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment """Year position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar year from any calendar. """@en;
              rdfs:domain owl_time:GeneralDateTimeDescription;
              rdfs:label "year"@en.
owl_time:years a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "length of, or element of the length of, a temporal extent expressed in years"@en;
               rdfs:domain owl_time:GeneralDurationDescription;
               rdfs:label "years duration"@en;
               rdfs:range xsd:decimal.
