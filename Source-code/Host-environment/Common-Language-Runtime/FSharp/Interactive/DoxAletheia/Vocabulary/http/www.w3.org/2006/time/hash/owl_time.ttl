                                                                    "minuto"@it,
                                                                    "minuto"@es,
                                                                    "분"@kr,
                                                                    "等一下"@zh,
                                                                    "一分"@jp,
                                                                    "minute"@fr,
                                                                    "minute"@en,
                                                                    "minuta"@pl;
                    owl_time:days 0 ;
                    owl_time:hours 0 ;
                    owl_time:minutes 1 ;
                    owl_time:months 0 ;
                    owl_time:seconds 0 ;
                    owl_time:weeks 0 ;
                    owl_time:years 0 .
owl_time:unitMonth a owl_time:TemporalUnit;
                   rdfs:label "Month (unit of temporal duration)"@en;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "month"@en,
                                                                   "mese"@it,
                                                                   "mois"@fr,
                                                                   "mes"@es,
