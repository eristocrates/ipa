                                                                  "heure"@fr;
                  owl_time:days 0 ;
                  owl_time:hours 1 ;
                  owl_time:minutes 0 ;
                  owl_time:months 0 ;
                  owl_time:seconds 0 ;
                  owl_time:weeks 0 ;
                  owl_time:years 0 .
owl_time:unitMinute a owl_time:TemporalUnit;
                    rdfs:label "Minute (unit of temporal duration)"@en;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "دقيقة واحدة"@ar,
                                                                    "minuut"@nl,
                                                                    "одна минута"@ru,
                                                                    "Minute"@de,
