                                                                 "jour"@fr,
                                                                 "一天"@zh;
                 owl_time:days 1 ;
                 owl_time:hours 0 ;
                 owl_time:minutes 0 ;
                 owl_time:months 0 ;
                 owl_time:seconds 0 ;
                 owl_time:weeks 0 ;
                 owl_time:years 0 .
owl_time:unitHour a owl_time:TemporalUnit;
