owl_time:after a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Gives directionality to time. If a temporal entity T1 is after another temporal entity T2, then the beginning of T1 is after the end of T2."@en;
               rdfs:domain owl_time:TemporalEntity;
               rdfs:label "after"@en;
               rdfs:range owl_time:TemporalEntity;
               <http://www.w3.org/2002/07/owl#inverseOf> owl_time:before;
               <http://www.w3.org/2004/02/skos/core#definition> "Gives directionality to time. If a temporal entity T1 is after another temporal entity T2, then the beginning of T1 is after the end of T2."@en.
owl_time:before a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                  <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment """Gives directionality to time. If a temporal entity T1 is before another temporal entity T2, then the end of T1 is before the beginning of T2. Thus, \"before\" can be considered to be basic to instants and derived for intervals."""@en;
                rdfs:domain owl_time:TemporalEntity;
                rdfs:label "before"@en;
                rdfs:range owl_time:TemporalEntity;
                <http://www.w3.org/2002/07/owl#inverseOf> owl_time:after;
                <http://www.w3.org/2004/02/skos/core#definition> """Gives directionality to time. If a temporal entity T1 is before another temporal entity T2, then the end of T1 is before the beginning of T2. Thus, \"before\" can be considered to be basic to instants and derived for intervals."""@en.
owl_time:day a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment """Day position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar day from any calendar. """@en;
             rdfs:domain owl_time:GeneralDateTimeDescription;
             rdfs:label "day"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """Day position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar day from any calendar. """@en.
owl_time:dayOfWeek a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "The day of week, whose value is a member of the class time:DayOfWeek"@en;
                   rdfs:domain owl_time:GeneralDateTimeDescription;
                   rdfs:label "day of week"@en;
                   rdfs:range owl_time:DayOfWeek;
                   <http://www.w3.org/2004/02/skos/core#definition> "The day of week, whose value is a member of the class time:DayOfWeek"@en.
owl_time:dayOfYear a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "The number of the day within the year"@en;
                   rdfs:domain owl_time:GeneralDateTimeDescription;
                   rdfs:label "day of year"@en;
                   rdfs:range xsd:nonNegativeInteger;
                   <http://www.w3.org/2004/02/skos/core#definition> "The number of the day within the year"@en.
owl_time:days a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "length of, or element of the length of, a temporal extent expressed in days"@en;
              rdfs:domain owl_time:GeneralDurationDescription;
              rdfs:label "days duration"@en;
              rdfs:range xsd:decimal;
              <http://www.w3.org/2004/02/skos/core#definition> "length of, or element of the length of, a temporal extent expressed in days"@en.
owl_time:generalDay a rdfs:Datatype;
                    rdfs:comment """Day of month - formulated as a text string with a pattern constraint to reproduce the same lexical form as gDay, except that values up to 99 are permitted, in order to support calendars with more than 31 days in a month. 
Note that the value-space is not defined, so a generic OWL2 processor cannot compute ordering relationships of values of this type."""@en;
                    rdfs:label "Generalized day"@en;
                    <http://www.w3.org/2002/07/owl#onDatatype> xsd:string;
                    <http://www.w3.org/2002/07/owl#withRestrictions> ([xsd:pattern "---(0[1-9]|[1-9][0-9])(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?"]);
                    <http://www.w3.org/2004/02/skos/core#definition> "Day of month - generalization of xsd:gDay, formulated as a text string with a pattern constraint to reproduce the same lexical form as gDay, except that values up to 99 are permitted, in order to support calendars with more than 31 days in a month. Note that the value-space is not defined, so a generic OWL2 processor cannot compute ordering relationships of values of this type. "@en.
owl_time:generalMonth a rdfs:Datatype;
                      rdfs:comment """Month of year - formulated as a text string with a pattern constraint to reproduce the same lexical form as gMonth, except that values up to 20 are permitted, in order to support calendars with more than 12 months in the year. 
Note that the value-space is not defined, so a generic OWL2 processor cannot compute ordering relationships of values of this type."""@en;
                      rdfs:label "Generalized month"@en;
                      <http://www.w3.org/2002/07/owl#onDatatype> xsd:string;
                      <http://www.w3.org/2002/07/owl#withRestrictions> ([xsd:pattern "--(0[1-9]|1[0-9]|20)(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?"]);
                      <http://www.w3.org/2004/02/skos/core#definition> "Month of year - generalization of xsd:gMonth, formulated as a text string with a pattern constraint to reproduce the same lexical form as gMonth, except that values up to 20 are permitted, in order to support calendars with more than 12 months in the year. Note that the value-space is not defined, so a generic OWL2 processor cannot compute ordering relationships of values of this type."@en.
owl_time:generalYear a rdfs:Datatype;
                     rdfs:comment """Year number - formulated as a text string with a pattern constraint to reproduce the same lexical form as gYear, but not restricted to values from the Gregorian calendar. 
Note that the value-space is not defined, so a generic OWL2 processor cannot compute ordering relationships of values of this type."""@en;
                     rdfs:label "Generalized year"@en;
                     rdfs:subClassOf rdfs:Resource;
                     <http://www.w3.org/2002/07/owl#onDatatype> xsd:string;
                     <http://www.w3.org/2002/07/owl#withRestrictions> ([xsd:pattern "-?([1-9][0-9]{3,}|0[0-9]{3})(Z|(\\+|-)((0[0-9]|1[0-3]):[0-5][0-9]|14:00))?"]);
                     <http://www.w3.org/2004/02/skos/core#definition> "Year number - generalization of xsd:gYear, formulated as a text string with a pattern constraint to reproduce the same lexical form as gYear. Note that the value-space is not defined, so a generic OWL2 processor cannot compute ordering relationships of values of this type."@en.
owl_time:hasBeginning a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Beginning of a temporal entity"@en;
                      rdfs:domain owl_time:TemporalEntity;
                      rdfs:label "has beginning"@en;
                      rdfs:range owl_time:Instant;
                      rdfs:subPropertyOf owl_time:hasTime;
                      <http://www.w3.org/2004/02/skos/core#definition> "Beginning of a temporal entity."@en.
owl_time:hasDateTimeDescription a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "Value of DateTimeInterval expressed as a structured value. The beginning and end of the interval coincide with the limits of the shortest element in the description."@en;
                                rdfs:domain owl_time:DateTimeInterval;
                                rdfs:label "has Date-Time description"@en;
