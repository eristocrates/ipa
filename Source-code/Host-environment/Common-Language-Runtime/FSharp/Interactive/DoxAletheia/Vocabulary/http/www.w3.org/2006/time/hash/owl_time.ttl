                                                                   "Mittwoch"@de,
                                                                   "Miércoles"@es,
                                                                   "Wednesday"@en.
owl_time:Year a <http://www.w3.org/2002/07/owl#DeprecatedClass>,
                <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Year duration";
              rdfs:label "Year"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> owl_time:years ; 
                               <http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> owl_time:minutes ; 
                               <http://www.w3.org/2002/07/owl#cardinality> 0  ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> owl_time:months ; 
                               <http://www.w3.org/2002/07/owl#cardinality> 0  ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> owl_time:hours ; 
                               <http://www.w3.org/2002/07/owl#cardinality> 0  ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              owl_time:DurationDescription,
                              [<http://www.w3.org/2002/07/owl#onProperty> owl_time:seconds ; 
                               <http://www.w3.org/2002/07/owl#cardinality> 0  ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> owl_time:weeks ; 
                               <http://www.w3.org/2002/07/owl#cardinality> 0  ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> owl_time:days ; 
                               <http://www.w3.org/2002/07/owl#cardinality> 0  ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2002/07/owl#deprecated> true;
              <http://www.w3.org/2004/02/skos/core#definition> "Year duration";
              <http://www.w3.org/2004/02/skos/core#historyNote> """Year was proposed in the 2006 version of OWL-Time as an example of how DurationDescription could be specialized to allow for a duration to be restricted to a number of years. 

It is deprecated in this edition of OWL-Time. """;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Anno"@it,
                                                              "سنة"@ar,
                                                              "Rok"@pl,
                                                              "Jaar"@nl,
                                                              "Año"@es,
                                                              "Jahr"@de,
