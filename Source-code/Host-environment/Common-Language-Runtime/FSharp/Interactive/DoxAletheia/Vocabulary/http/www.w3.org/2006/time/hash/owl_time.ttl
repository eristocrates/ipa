               rdfs:comment "length of, or element of the length of, a temporal extent expressed in hours"@en;
               rdfs:domain owl_time:GeneralDurationDescription;
               rdfs:label "hours duration"@en;
               rdfs:range xsd:decimal;
               <http://www.w3.org/2004/02/skos/core#definition> "length of, or element of the length of, a temporal extent expressed in hours"@en.
owl_time:inDateTime a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Position of an instant, expressed using a structured description"@en;
                    rdfs:domain owl_time:Instant;
                    rdfs:label "in date-time description"@en;
                    rdfs:range owl_time:GeneralDateTimeDescription;
                    rdfs:subPropertyOf owl_time:inTemporalPosition;
                    <http://www.w3.org/2004/02/skos/core#definition> "Position of an instant, expressed using a structured description"@en.
owl_time:inTemporalPosition a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "Position of a time instant"@en;
                            rdfs:domain owl_time:Instant;
                            rdfs:label "Temporal position"@en;
                            rdfs:range owl_time:TemporalPosition;
                            <http://www.w3.org/2004/02/skos/core#definition> "Position of a time instant"@en.
owl_time:inTimePosition a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Position of an instant, expressed as a temporal coordinate or nominal value"@en;
                        rdfs:domain owl_time:Instant;
                        rdfs:label "Time position"@en;
                        rdfs:range owl_time:TimePosition;
                        rdfs:subPropertyOf owl_time:inTemporalPosition;
                        <http://www.w3.org/2004/02/skos/core#definition> "Position of a time instant expressed as a TimePosition"@en.
owl_time:inXSDDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Position of an instant, expressed using xsd:date"@en;
                   rdfs:domain owl_time:Instant;
                   rdfs:label "in XSD date"@en;
                   rdfs:range xsd:date;
                   <http://www.w3.org/2004/02/skos/core#definition> "Position of an instant, expressed using xsd:date"@en.
owl_time:inXSDDateTime a <http://www.w3.org/2002/07/owl#DeprecatedProperty>,
                         <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "Position of an instant, expressed using xsd:dateTime"@en;
                       rdfs:domain owl_time:Instant;
                       rdfs:label "in XSD Date-Time"@en;
                       rdfs:range xsd:dateTime;
                       <http://www.w3.org/2002/07/owl#deprecated> true;
                       <http://www.w3.org/2004/02/skos/core#definition> "Position of an instant, expressed using xsd:dateTime"@en;
                       <http://www.w3.org/2004/02/skos/core#note> "The property :inXSDDateTime is replaced by :inXSDDateTimeStamp which makes the time-zone field mandatory."@en.
owl_time:inXSDDateTimeStamp a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:comment "Position of an instant, expressed using xsd:dateTimeStamp"@en;
                            rdfs:domain owl_time:Instant;
                            rdfs:label "in XSD Date-Time-Stamp"@en;
                            rdfs:range xsd:dateTimeStamp;
                            <http://www.w3.org/2004/02/skos/core#definition> "Position of an instant, expressed using xsd:dateTimeStamp"@en.
owl_time:inXSDgYear a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "Position of an instant, expressed using xsd:gYear"@en;
                    rdfs:domain owl_time:Instant;
                    rdfs:label "in XSD g-Year"@en;
                    rdfs:range xsd:gYear;
                    <http://www.w3.org/2004/02/skos/core#definition> "Position of an instant, expressed using xsd:gYear"@en.
owl_time:inXSDgYearMonth a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "Position of an instant, expressed using xsd:gYearMonth"@en;
                         rdfs:domain owl_time:Instant;
                         rdfs:label "in XSD g-YearMonth"@en;
                         rdfs:range xsd:gYearMonth;
                         <http://www.w3.org/2004/02/skos/core#definition> "Position of an instant, expressed using xsd:gYearMonth"@en.
owl_time:inside a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "An instant that falls inside the interval. It is not intended to include beginnings and ends of intervals."@en;
                rdfs:domain owl_time:Interval;
                rdfs:label "has time instant inside"@en;
                rdfs:range owl_time:Instant;
                <http://www.w3.org/2004/02/skos/core#definition> "An instant that falls inside the interval. It is not intended to include beginnings and ends of intervals."@en.
owl_time:intervalAfter a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "If a proper interval T1 is intervalAfter another proper interval T2, then the beginning of T1 is after the end of T2."@en;
                       rdfs:domain owl_time:ProperInterval;
                       rdfs:label "interval after"@en;
                       rdfs:range owl_time:ProperInterval;
                       rdfs:subPropertyOf owl_time:intervalDisjoint,
                                          owl_time:after;
                       <http://www.w3.org/2002/07/owl#inverseOf> owl_time:intervalBefore;
                       <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalAfter another proper interval T2, then the beginning of T1 is after the end of T2."@en.
owl_time:intervalBefore a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "If a proper interval T1 is intervalBefore another proper interval T2, then the end of T1 is before the beginning of T2."@en;
                        rdfs:domain owl_time:ProperInterval;
                        rdfs:label "interval before"@en;
                        rdfs:range owl_time:ProperInterval;
                        rdfs:subPropertyOf owl_time:intervalDisjoint,
                                           owl_time:before;
                        <http://www.w3.org/2002/07/owl#inverseOf> owl_time:intervalAfter;
                        <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalBefore another proper interval T2, then the end of T1 is before the beginning of T2."@en.
owl_time:intervalContains a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "If a proper interval T1 is intervalContains another proper interval T2, then the beginning of T1 is before the beginning of T2, and the end of T1 is after the end of T2."@en;
                          rdfs:domain owl_time:ProperInterval;
                          rdfs:label "interval contains"@en;
                          rdfs:range owl_time:ProperInterval;
                          <http://www.w3.org/2002/07/owl#inverseOf> owl_time:intervalDuring;
                          <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalContains another proper interval T2, then the beginning of T1 is before the beginning of T2, and the end of T1 is after the end of T2."@en.
owl_time:intervalDisjoint a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "If a proper interval T1 is intervalDisjoint another proper interval T2, then the beginning of T1 is after the end of T2, or the end of T1 is before the beginning of T2, i.e. the intervals do not overlap in any way, but their ordering relationship is not known."@en;
                          rdfs:domain owl_time:ProperInterval;
                          rdfs:label "interval disjoint"@en;
                          rdfs:range owl_time:ProperInterval;
                          <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalDisjoint another proper interval T2, then the beginning of T1 is after the end of T2, or the end of T1 is before the beginning of T2, i.e. the intervals do not overlap in any way, but their ordering relationship is not known."@en;
                          <http://www.w3.org/2004/02/skos/core#note> "This interval relation is not included in the 13 basic relationships defined in Allen (1984), but is defined in (T.3) as the union of :intervalDuring v :intervalStarts v :intervalFinishes"@en.
owl_time:intervalDuring a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "If a proper interval T1 is intervalDuring another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en;
                        rdfs:domain owl_time:ProperInterval;
                        rdfs:label "interval during"@en;
                        rdfs:range owl_time:ProperInterval;
                        rdfs:subPropertyOf owl_time:intervalIn;
                        <http://www.w3.org/2002/07/owl#inverseOf> owl_time:intervalContains;
                        <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalDuring another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en.
owl_time:intervalEquals a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "If a proper interval T1 is intervalEquals another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is coincident with the end of T2."@en;
                        rdfs:domain owl_time:ProperInterval;
                        rdfs:label "interval equals"@en;
                        rdfs:range owl_time:ProperInterval;
                        <http://www.w3.org/2002/07/owl#propertyDisjointWith> owl_time:intervalIn;
                        <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalEquals another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is coincident with the end of T2."@en.
owl_time:intervalFinishedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "If a proper interval T1 is intervalFinishedBy another proper interval T2, then the beginning of T1 is before the beginning of T2, and the end of T1 is coincident with the end of T2."@en;
                            rdfs:domain owl_time:ProperInterval;
                            rdfs:label "interval finished by"@en;
                            rdfs:range owl_time:ProperInterval;
                            <http://www.w3.org/2002/07/owl#inverseOf> owl_time:intervalFinishes;
                            <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalFinishedBy another proper interval T2, then the beginning of T1 is before the beginning of T2, and the end of T1 is coincident with the end of T2."@en.
owl_time:intervalFinishes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "If a proper interval T1 is intervalFinishes another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is coincident with the end of T2."@en;
                          rdfs:domain owl_time:ProperInterval;
                          rdfs:label "interval finishes"@en;
                          rdfs:range owl_time:ProperInterval;
                          rdfs:subPropertyOf owl_time:intervalIn;
                          <http://www.w3.org/2002/07/owl#inverseOf> owl_time:intervalFinishedBy;
                          <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalFinishes another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is coincident with the end of T2."@en.
owl_time:intervalIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "If a proper interval T1 is intervalIn another proper interval T2, then the beginning of T1 is after the beginning of T2 or is coincident with the beginning of T2, and the end of T1 is before the end of T2, or is coincident with the end of T2, except that end of T1 may not be coincident with the end of T2 if the beginning of T1 is coincident with the beginning of T2."@en;
                    rdfs:domain owl_time:ProperInterval;
                    rdfs:label "interval in"@en;
                    rdfs:range owl_time:ProperInterval;
                    <http://www.w3.org/2002/07/owl#propertyDisjointWith> owl_time:intervalEquals;
                    <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalIn another proper interval T2, then the beginning of T1 is after the beginning of T2 or is coincident with the beginning of T2, and the end of T1 is before the end of T2, or is coincident with the end of T2, except that end of T1 may not be coincident with the end of T2 if the beginning of T1 is coincident with the beginning of T2."@en;
                    <http://www.w3.org/2004/02/skos/core#note> "This interval relation is not included in the 13 basic relationships defined in Allen (1984), but is referred to as 'an important relationship' in Allen and Ferguson (1997). It is the disjoint union of :intervalStarts v :intervalDuring v :intervalFinishes"@en.
owl_time:intervalMeets a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "If a proper interval T1 is intervalMeets another proper interval T2, then the end of T1 is coincident with the beginning of T2."@en;
                       rdfs:domain owl_time:ProperInterval;
                       rdfs:label "interval meets"@en;
                       rdfs:range owl_time:ProperInterval;
                       <http://www.w3.org/2002/07/owl#inverseOf> owl_time:intervalMetBy;
                       <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalMeets another proper interval T2, then the end of T1 is coincident with the beginning of T2."@en.
owl_time:intervalMetBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "If a proper interval T1 is intervalMetBy another proper interval T2, then the beginning of T1 is coincident with the end of T2."@en;
                       rdfs:domain owl_time:ProperInterval;
                       rdfs:label "interval met by"@en;
                       rdfs:range owl_time:ProperInterval;
                       <http://www.w3.org/2002/07/owl#inverseOf> owl_time:intervalMeets;
                       <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalMetBy another proper interval T2, then the beginning of T1 is coincident with the end of T2."@en.
owl_time:intervalOverlappedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "If a proper interval T1 is intervalOverlappedBy another proper interval T2, then the beginning of T1 is after the beginning of T2, the beginning of T1 is before the end of T2, and the end of T1 is after the end of T2."@en;
                              rdfs:domain owl_time:ProperInterval;
                              rdfs:label "interval overlapped by"@en;
                              rdfs:range owl_time:ProperInterval;
                              <http://www.w3.org/2002/07/owl#inverseOf> owl_time:intervalOverlaps;
                              <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalOverlappedBy another proper interval T2, then the beginning of T1 is after the beginning of T2, the beginning of T1 is before the end of T2, and the end of T1 is after the end of T2."@en.
owl_time:intervalOverlaps a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "If a proper interval T1 is intervalOverlaps another proper interval T2, then the beginning of T1 is before the beginning of T2, the end of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en;
                          rdfs:domain owl_time:ProperInterval;
                          rdfs:label "interval overlaps"@en;
                          rdfs:range owl_time:ProperInterval;
                          <http://www.w3.org/2002/07/owl#inverseOf> owl_time:intervalOverlappedBy;
                          <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalOverlaps another proper interval T2, then the beginning of T1 is before the beginning of T2, the end of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en.
owl_time:intervalStartedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "If a proper interval T1 is intervalStarted another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is after the end of T2."@en;
                           rdfs:domain owl_time:ProperInterval;
                           rdfs:label "interval started by"@en;
                           rdfs:range owl_time:ProperInterval;
                           <http://www.w3.org/2002/07/owl#inverseOf> owl_time:intervalStarts;
                           <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalStarted another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is after the end of T2."@en.
owl_time:intervalStarts a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "If a proper interval T1 is intervalStarts another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is before the end of T2."@en;
                        rdfs:domain owl_time:ProperInterval;
                        rdfs:label "interval starts"@en;
                        rdfs:range owl_time:ProperInterval;
                        rdfs:subPropertyOf owl_time:intervalIn;
                        <http://www.w3.org/2002/07/owl#inverseOf> owl_time:intervalStartedBy;
                        <http://www.w3.org/2004/02/skos/core#definition> "If a proper interval T1 is intervalStarts another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is before the end of T2."@en.
owl_time:minute a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Minute position in a calendar-clock system."@en;
                rdfs:domain owl_time:GeneralDateTimeDescription;
                rdfs:label "minute"@en;
                rdfs:range xsd:nonNegativeInteger;
                <http://www.w3.org/2004/02/skos/core#definition> "Minute position in a calendar-clock system."@en.
owl_time:minutes a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "length, or element of, a temporal extent expressed in minutes"@en;
                 rdfs:domain owl_time:GeneralDurationDescription;
                 rdfs:label "minutes"@en;
                 rdfs:range xsd:decimal;
                 <http://www.w3.org/2004/02/skos/core#definition> "length, or element of, a temporal extent expressed in minutes"@en.
owl_time:month a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment """Month position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar month from any calendar. """@en;
               rdfs:domain owl_time:GeneralDateTimeDescription;
               rdfs:label "month"@en;
               <http://www.w3.org/2004/02/skos/core#definition> """Month position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar month from any calendar. """@en.
owl_time:monthOfYear a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "The month of the year, whose value is a member of the class time:MonthOfYear"@en;
                     rdfs:domain owl_time:GeneralDateTimeDescription;
                     rdfs:label "month of year"@en;
                     rdfs:range owl_time:MonthOfYear;
                     <http://www.w3.org/2004/02/skos/core#definition> "The month of the year, whose value is a member of the class time:MonthOfYear"@en;
                     <http://www.w3.org/2004/02/skos/core#editorialNote> "Feature at risk - added in 2017 revision, and not yet widely used. "@en.
owl_time:months a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "length of, or element of the length of, a temporal extent expressed in months"@en;
                rdfs:domain owl_time:GeneralDurationDescription;
                rdfs:label "months duration"@en;
                rdfs:range xsd:decimal;
                <http://www.w3.org/2004/02/skos/core#definition> "length of, or element of the length of, a temporal extent expressed in months"@en.
owl_time:nominalPosition a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "The (nominal) value indicating temporal position in an ordinal reference system "@en;
                         rdfs:domain owl_time:TimePosition;
                         rdfs:label "Name of temporal position"@en;
                         rdfs:range xsd:string;
                         <http://www.w3.org/2004/02/skos/core#definition> "The (nominal) value indicating temporal position in an ordinal reference system "@en.
owl_time:numericDuration a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "Value of a temporal extent expressed as a decimal number scaled by a temporal unit"@en;
                         rdfs:domain owl_time:Duration;
                         rdfs:label "Numeric value of temporal duration"@en;
                         rdfs:range xsd:decimal;
                         <http://www.w3.org/2004/02/skos/core#definition> "Value of a temporal extent expressed as a decimal number scaled by a temporal unit"@en.
owl_time:numericPosition a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "The (numeric) value indicating position within a temporal coordinate system "@en;
                         rdfs:domain owl_time:TimePosition;
                         rdfs:label "Numeric value of temporal position"@en;
                         rdfs:range xsd:decimal;
                         <http://www.w3.org/2004/02/skos/core#definition> "The (numeric) value indicating position within a temporal coordinate system "@en.
owl_time:second a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Second position in a calendar-clock system."@en;
                rdfs:domain owl_time:GeneralDateTimeDescription;
                rdfs:label "second"@en;
                rdfs:range xsd:decimal.
owl_time:seconds a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "length of, or element of the length of, a temporal extent expressed in seconds"@en;
                 rdfs:domain owl_time:GeneralDurationDescription;
                 rdfs:label "seconds duration"@en;
                 rdfs:range xsd:decimal;
                 rdfs:seeAlso <http://www.bipm.org/en/publications/si-brochure/second.html>.
owl_time:timeZone a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "The time zone for clock elements in the temporal position"@en;
                  rdfs:domain owl_time:GeneralDateTimeDescription;
                  rdfs:label "in time zone"@en;
                  rdfs:range owl_time:TimeZone;
                  <http://www.w3.org/2004/02/skos/core#historyNote> """In the original 2006 version of OWL-Time, the range of time:timeZone was a TimeZone class in a separate namespace \"http://www.w3.org/2006/timezone#\". 
An alignment axiom 
	tzont:TimeZone rdfs:subClassOf time:TimeZone . 
allows data encoded according to the previous version to be consistent with the updated ontology. """;
                  <http://www.w3.org/2004/02/skos/core#note> """IANA maintains a database of timezones. These are well maintained and generally considered authoritative, but individual items are not available at individual URIs, so cannot be used directly in data expressed using OWL-Time.

DBPedia provides a set of resources corresponding to the IANA timezones, with a URI for each (e.g. http://dbpedia.org/resource/Australia/Eucla). The World Clock service also provides a list of time zones with the description of each available as an individual webpage with a convenient individual URI (e.g. https://www.timeanddate.com/time/zones/acwst). These or other, similar, resources might be used as a value of the time:timeZone property.""".
owl_time:unitDay a owl_time:TemporalUnit;
                 rdfs:label "Day (unit of temporal duration)"@en;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Tag"@de,
