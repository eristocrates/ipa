owl_time:hour a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Hour position in a calendar-clock system."@en;
              rdfs:domain owl_time:GeneralDateTimeDescription;
              rdfs:label "hour"@en;
              rdfs:range xsd:nonNegativeInteger;
