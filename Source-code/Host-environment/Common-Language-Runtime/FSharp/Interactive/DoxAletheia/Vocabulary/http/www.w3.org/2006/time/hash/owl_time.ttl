                                                                 "火曜日"@ja,
                                                                 "Wtorek"@pl,
                                                                 "Tuesday"@en,
                                                                 "Martes"@es,
                                                                 "星期二"@zh,
                                                                 "Martedì"@it.
owl_time:Wednesday a owl_time:DayOfWeek;
