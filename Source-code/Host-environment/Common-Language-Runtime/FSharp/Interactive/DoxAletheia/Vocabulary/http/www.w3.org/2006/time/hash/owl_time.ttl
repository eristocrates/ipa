owl_time:hasDuration a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Duration of a temporal entity, expressed as a scaled value or nominal value"@en;
                     rdfs:label "has duration"@en;
                     rdfs:range owl_time:Duration;
                     rdfs:subPropertyOf owl_time:hasTemporalDuration;
                     <http://www.w3.org/2004/02/skos/core#definition> "Duration of a temporal entity, event or activity, or thing, expressed as a scaled value"@en.
owl_time:hasDurationDescription a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "Duration of a temporal entity, expressed using a structured description"@en;
                                rdfs:label "has duration description"@en;
                                rdfs:range owl_time:GeneralDurationDescription;
                                rdfs:subPropertyOf owl_time:hasTemporalDuration;
                                <http://www.w3.org/2004/02/skos/core#definition> "Duration of a temporal entity, expressed using a structured description"@en.
owl_time:hasEnd a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "End of a temporal entity."@en;
                rdfs:domain owl_time:TemporalEntity;
                rdfs:label "has end"@en;
                rdfs:range owl_time:Instant;
                rdfs:subPropertyOf owl_time:hasTime;
                <http://www.w3.org/2004/02/skos/core#definition> "End of a temporal entity."@en.
owl_time:hasTRS a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                rdfs:comment "The temporal reference system used by a temporal position or extent description. "@en;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (owl_time:TemporalPosition
                                                                      owl_time:GeneralDurationDescription) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:label "Temporal reference system used"@en;
                rdfs:range owl_time:TRS;
                <http://www.w3.org/2004/02/skos/core#definition> "The temporal reference system used by a temporal position or extent description. "@en.
owl_time:hasTemporalDuration a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Duration of a temporal entity."@en;
                             rdfs:domain owl_time:TemporalEntity;
                             rdfs:label "has temporal duration"@en;
                             rdfs:range owl_time:TemporalDuration;
                             <http://www.w3.org/2004/02/skos/core#definition> "Duration of a temporal entity."@en.
owl_time:hasTime a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Supports the association of a temporal entity (instant or interval) to any thing"@en;
                 rdfs:label "has time"@en;
                 rdfs:range owl_time:TemporalEntity;
                 <http://www.w3.org/2004/02/skos/core#definition> "Supports the association of a temporal entity (instant or interval) to any thing"@en;
                 <http://www.w3.org/2004/02/skos/core#editorialNote> "Feature at risk - added in 2017 revision, and not yet widely used. "@en.
owl_time:hasXSDDuration a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
