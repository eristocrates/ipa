<http://www.w3.org/2007/uwa/context/location.owl#availableLocationProviders> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                             rdfs:comment "This property represents the LocationProviders that are currently available in a network, device or the Delivery Context itself as whole";
                                                                             rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.w3.org/2007/uwa/context/network.owl#Network>
                                                                                                                                   <http://www.w3.org/2007/uwa/context/deliverycontext.owl#Device>
                                                                                                                                   <http://www.w3.org/2007/uwa/context/deliverycontext.owl#DeliveryContext>) ; 
