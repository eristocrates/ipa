               rdfs:label "MMS User Agent";
               rdfs:subClassOf [owl:onProperty push:mmsVersions ; 
                                owl:minCardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               push:PushClient;
               common:relatedUAProfEntity "MmsCharacteristics".
push:PushClient a owl:Class;
                rdfs:comment "This class represents user agents capable of receiving and processing push requests";
                rdfs:label "Push Client";
                rdfs:subClassOf soft:UserAgent;
                common:informativeReference "http://www.openmobilealliance.biz/document/OMA-ORG-Dictionary-V2_6-20070614-A.pdf";
                common:relatedUAProfEntity "PushCharacteristics".
push:WapPushClient a owl:Class;
                   rdfs:comment "A user agent capable of managing WAP Push incoming messages";
                   rdfs:label "WAP Push Client";
                   rdfs:subClassOf [owl:onProperty push:wapPushVersions ; 
                                    owl:minCardinality "1"^^xsd:int ; 
                                    a owl:Restriction],
                                   push:PushClient;
                   common:relatedUAProfEntity "PushCharacteristics".
push:applicationIds a owl:DatatypeProperty;
                    rdfs:comment """This property represents the list of types of Push-enabled applications supported by the device. Application identifiers are represented on absolute URI format. A wildcard (\"*\") may be used to indicate support for any application""";
                    rdfs:domain soft:DeviceSoftware;
                    rdfs:label "Push Application Ids";
                    rdfs:range xsd:string;
                    common:normativeReference "http://www.openmobilealliance.org/tech/omna/omna-push-app-id.htm"^^xsd:anyURI.
push:defaultMmsClient a owl:FunctionalProperty,
                        owl:ObjectProperty;
                      rdfs:comment "The default MMS client on the device";
                      rdfs:domain soft:DeviceSoftware;
                      rdfs:label "Default MMS Client";
                      rdfs:range push:MmsClient;
                      rdfs:subPropertyOf dcn:defaultComponent,
                                         soft:availableUserAgents;
                      common:relatedUAProfEntity "MmsCharacteristics".
push:defaultWapPushClient a owl:FunctionalProperty,
                            owl:ObjectProperty;
                          rdfs:comment "The default WAP Push Client on a device";
                          rdfs:domain soft:DeviceSoftware;
                          rdfs:label "Default WAP Push Client";
                          rdfs:range push:WapPushClient;
                          rdfs:subPropertyOf dcn:defaultComponent,
                                             soft:availableUserAgents;
                          common:relatedUAProfEntity "PushCharacteristics".
push:maxMmsMessageSize a owl:FunctionalProperty,
                         owl:DatatypeProperty;
                       rdfs:comment "The maximum size of an interchanged message in byes";
                       rdfs:domain push:MmsClient;
                       rdfs:label "MMS Maximum Message Size";
                       rdfs:range xsd:unsignedLong;
                       rdfs:subPropertyOf soft:maxDeliveryUnitSize;
                       common:relatedUAProfEntity "MmsMaxMessageSize".
push:maxWapPushMessageSize a owl:FunctionalProperty,
                             owl:DatatypeProperty;
                           rdfs:comment "THe maximum message size supported by the WAP Push User Agent in bytes";
                           rdfs:domain push:WapPushClient;
                           rdfs:label "WAP Push Maximum Message Size";
                           rdfs:range xsd:unsignedLong;
                           rdfs:subPropertyOf soft:maxDeliveryUnitSize;
                           common:relatedUAProfEntity "Push-MsgSize".
push:maxWapPushRequests a owl:FunctionalProperty,
                          owl:DatatypeProperty;
                        rdfs:comment "The maximum number of WAP Push requests that the WAP Push User Agent is capable to deal with";
                        rdfs:domain push:WapPushClient;
                        rdfs:label "WAP Push Maximum Number of Requests";
                        rdfs:range xsd:int;
                        common:relatedUAProfEntity "Push-MaxPushReq".
push:mmsVersions a owl:DatatypeProperty;
                 rdfs:comment "The supported MMS versions";
                 rdfs:domain push:MmsClient;
                 rdfs:label "MMS versions";
                 rdfs:range xsd:string;
                 common:relatedUAProfEntity "MmsVersion".
push:wapPushVersions a owl:DatatypeProperty;
                     rdfs:comment "Represents the versions of the (WAP) Push enabler supported";
                     rdfs:domain push:WapPushClient;
                     rdfs:label "WAP Push Versions";
                     rdfs:range xsd:string;
                     common:relatedUAProfEntity "Push-Version".
soft:Api a owl:Class;
         rdfs:comment "This is a generic class that represents an application programming interface";
         rdfs:label "API";
         rdfs:subClassOf [owl:onProperty common:version ; 
                          owl:maxCardinality "1"^^xsd:int ; 
                          a owl:Restriction],
                         [owl:onProperty common:name ; 
                          owl:cardinality "1"^^xsd:int ; 
                          a owl:Restriction],
                         soft:Context_SoftwareEntity.
soft:Application a owl:Class;
                 rdfs:comment "This class represents an application program";
                 rdfs:label "Application Program";
                 rdfs:subClassOf soft:Program.
soft:AudioFormat a owl:Class;
                 rdfs:comment "This class represents a particular audio format, such as MP3 or WAV";
                 rdfs:label "Audio Format";
                 rdfs:subClassOf soft:Format.
soft:AudioPlayer a owl:Class;
                 rdfs:comment "This class represents a user agent capable of dealing with audio formats";
                 rdfs:label "Audio Player";
                 rdfs:subClassOf [owl:someValuesFrom soft:AudioFormat ; 
                                  owl:onProperty soft:supportedFormats ; 
                                  a owl:Restriction],
                                 soft:MediaPlayer.
soft:AudioRecorder a owl:Class;
                   rdfs:comment "This class represents a user agent capable of recording audio";
                   rdfs:label "Audio Recorder";
                   rdfs:subClassOf [owl:someValuesFrom soft:AudioFormat ; 
                                    owl:onProperty soft:supportedFormats ; 
                                    a owl:Restriction],
                                   soft:MediaRecorder.
soft:Certificate a owl:Class;
                 rdfs:comment "This class represents a digital certificate";
                 rdfs:label "Certificate";
                 rdfs:subClassOf [owl:onProperty soft:issuer ; 
                                  owl:cardinality "1"^^xsd:int ; 
                                  a owl:Restriction],
                                 [owl:onProperty soft:notAfter ; 
                                  owl:cardinality "1"^^xsd:int ; 
                                  a owl:Restriction],
                                 [owl:onProperty soft:subject ; 
                                  owl:cardinality "1"^^xsd:int ; 
                                  a owl:Restriction],
                                 [owl:onProperty soft:notBefore ; 
                                  owl:cardinality "1"^^xsd:int ; 
                                  a owl:Restriction],
                                 soft:Context_SoftwareEntity.
soft:Context_SoftwareEntity a owl:Class;
                            rdfs:comment "This class subsumes all the entities in the ontology that have to do with software-specific characterisitics";
                            rdfs:label "Context Software Entity";
                            rdfs:subClassOf dcn:Context_Entity.
soft:DeviceSoftware a owl:Class;
                    rdfs:comment "This class represents the software in a device";
                    rdfs:label "Device Software";
                    rdfs:subClassOf soft:SoftwareAspect,
                                    soft:Context_SoftwareEntity;
                    common:relatedUAProfEntity "SoftwarePlatform".
soft:EmailClient a owl:Class;
                 rdfs:comment "This class represents a user agent capable of sending and receiving e-mail";
                 rdfs:label "E-Mail Client";
                 rdfs:subClassOf soft:UserAgent.
soft:Feature_VIRTUALKEYBOARD a common:Feature;
                             rdfs:comment "Virtual keyboard feature indicates that exists a virtual keyboard that facilitiates user input";
                             rdfs:label "Virtual Keyboard";
                             common:id "__Feature_VirtualKeyboard";
                             common:name "VirtualKeyboard";
                             common:normativeStatus common:Normative.
soft:Font a owl:Class;
          rdfs:comment "This class represents fonts";
          rdfs:label "Font";
          rdfs:subClassOf [owl:onProperty soft:fontSize ; 
                           owl:cardinality "1"^^xsd:int ; 
                           a owl:Restriction],
                          [owl:onProperty soft:fontFamily ; 
                           owl:cardinality "1"^^xsd:int ; 
                           a owl:Restriction],
                          [owl:onProperty soft:fontFamily ; 
                           owl:allValuesFrom soft:FontFamily ; 
                           a owl:Restriction],
                          [owl:onProperty soft:fontStyle ; 
                           owl:allValuesFrom soft:FontStyle ; 
                           a owl:Restriction],
                          soft:Context_SoftwareEntity.
soft:FontFamily a owl:Class;
                rdfs:comment "This class represents  Font Familiies";
                rdfs:label "Font Family";
                rdfs:subClassOf [owl:onProperty common:name ; 
                                 owl:minCardinality "1"^^xsd:int ; 
                                 a owl:Restriction],
                                soft:Context_SoftwareEntity;
                common:normativeReference "http://www.w3.org/TR/CSS21/fonts.html#font-family-prop"^^xsd:anyURI.
soft:FontFamily_CURSIVE a soft:FontFamily;
                        rdfs:comment "Generic Cursive Family";
                        rdfs:label "Cursive";
                        common:id "__FontFamily_Cursive";
                        common:name "Cursive";
                        common:normativeReference "http://www.w3.org/TR/CSS21/fonts.html#cursive-def"^^xsd:anyURI;
                        common:normativeStatus common:Normative.
soft:FontFamily_FANTASY a soft:FontFamily;
                        rdfs:comment "Generic Fantasy Family";
                        rdfs:label "Fantasy";
                        common:id "__FontFamily_Fantasy";
                        common:name "Fantasy";
                        common:normativeReference "http://www.w3.org/TR/CSS21/fonts.html#fantasive-def"^^xsd:anyURI;
                        common:normativeStatus common:Normative.
soft:FontFamily_MONOSPACE a soft:FontFamily;
                          rdfs:comment "Generic Monospace Family";
                          rdfs:label "Monospace";
                          common:id "__FontFamily_MonoSpace";
                          common:name "Monospace";
                          common:normativeReference "http://www.w3.org/TR/CSS21/fonts.html#monospace-def"^^xsd:anyURI;
                          common:normativeStatus common:Normative.
soft:FontFamily_SANS_SERIF a soft:FontFamily;
                           rdfs:comment "Generic Sans Serif Family";
                           rdfs:label "Sans Serif";
                           common:id "__FontFamily_SansSerif";
                           common:name "Sansserif";
                           common:normativeReference "http://www.w3.org/TR/CSS21/fonts.html#sans-serif-def"^^xsd:anyURI;
                           common:normativeStatus common:Normative.
soft:FontFamily_SERIF a soft:FontFamily;
                      rdfs:comment "Generic Serif Family";
                      rdfs:label "Serif";
                      common:id "__FontFamily_Serif";
                      common:name "Serif";
                      common:normativeReference "http://www.w3.org/TR/CSS21/fonts.html#serif-def"^^xsd:anyURI;
                      common:normativeStatus common:Normative.
soft:FontStyle a owl:Class;
               rdfs:comment "This class denotes font styles";
               rdfs:label "Font Style";
               rdfs:subClassOf [owl:onProperty common:name ; 
                                owl:minCardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               soft:Context_SoftwareEntity;
               common:normativeReference "http://www.w3.org/TR/CSS21/fonts.html#font-styling"^^xsd:anyURI.
soft:FontStyle_ITALICS a soft:FontStyle;
                       rdfs:comment "Italics style";
                       rdfs:label "Italics";
                       common:id "__FontStyle_Italics";
                       common:name "Italics";
                       common:normativeStatus common:Normative.
soft:FontStyle_NORMAL a soft:FontStyle;
                      rdfs:comment "Normal Style";
                      rdfs:label "Normal";
                      common:id "__FontStyle_Normal";
                      common:name "Normal";
                      common:normativeStatus common:Normative.
soft:FontStyle_OBLIQUE a soft:FontStyle;
                       rdfs:comment "Oblique Style";
                       rdfs:label "Oblique";
                       common:id "__FontStyle_Oblique";
                       common:name "Oblique";
                       common:normativeStatus common:Normative.
soft:Format a owl:Class;
            rdfs:comment "This class represents formats that can be used to represent something";
            rdfs:label "Format";
            rdfs:subClassOf [owl:onProperty common:version ; 
                             owl:maxCardinality "1"^^xsd:int ; 
                             a owl:Restriction],
                            [owl:onProperty common:name ; 
                             owl:minCardinality "1"^^xsd:int ; 
                             a owl:Restriction],
                            soft:Context_SoftwareEntity.
soft:HandlingAssociation a owl:Class;
                         rdfs:comment "This class represents the relationship between an entity (MIME Type, URI Scheme, etc.)  and a program capable of handling such entity";
                         rdfs:label "Handling Association";
                         rdfs:subClassOf [owl:someValuesFrom dcn:Context_Entity ; 
                                          owl:onProperty soft:handledElement ; 
                                          a owl:Restriction],
                                         [owl:onProperty soft:handler ; 
                                          owl:cardinality "1"^^xsd:int ; 
                                          a owl:Restriction],
                                         [owl:someValuesFrom soft:Program ; 
                                          owl:onProperty soft:handler ; 
                                          a owl:Restriction],
                                         [owl:onProperty soft:handledElement ; 
                                          owl:cardinality "1"^^xsd:int ; 
                                          a owl:Restriction],
                                         soft:Context_SoftwareEntity.
soft:ImageFormat a owl:Class;
                 rdfs:comment "This class represents a particular image format, such as jpeg, gif or png";
                 rdfs:label "Image Format";
                 rdfs:subClassOf soft:Format.
soft:MP3 a soft:AudioFormat;
         rdfs:comment "MP3 audio format";
         common:id "_MP3";
         common:name "MPEG-3".
soft:MP4 a soft:VideoFormat;
         rdfs:comment "The MP4 video format";
         common:id "_MP4";
         common:name "MPEG-4",
                     "MP4";
         common:version "4".
soft:MediaPlayer a owl:Class;
                 rdfs:comment "This class represents any kind of user agent capable of playing media";
                 rdfs:label "Media Player";
                 rdfs:subClassOf soft:UserAgent.
soft:MediaRecorder a owl:Class;
                   rdfs:comment "This class represents a user agent capable of recording different kind of media, such as a audio or video";
                   rdfs:label "Media Recorder";
                   rdfs:subClassOf soft:UserAgent.
soft:OperatingSystem a owl:Class;
                     rdfs:comment "This class represents operating systems";
                     rdfs:label "Operating System";
                     rdfs:subClassOf soft:Program.
soft:PDF a soft:Format;
         common:id "_PDF";
         common:name "PDF".
soft:PJPG a soft:ImageFormat;
          rdfs:comment "The progressive JPEG file image format image type.";
          common:id "_PJPG";
          common:name "PJPG".
soft:Plugin a owl:Class;
            rdfs:comment "This class represents a plugin, i.e. a software piece which extends the functionality offered by a host application (web browser, drawing application, etc)";
            rdfs:label "Plugin";
            rdfs:subClassOf [owl:onProperty common:name ; 
                             owl:cardinality "1"^^xsd:int ; 
                             a owl:Restriction],
                            [owl:onProperty common:version ; 
                             owl:maxCardinality "1"^^xsd:int ; 
                             a owl:Restriction],
                            soft:SoftwareAspect,
                            soft:Context_SoftwareEntity.
soft:Program a owl:Class;
             rdfs:comment "This class represents a computer program";
             rdfs:label "Program";
             rdfs:subClassOf [owl:onProperty common:vendor ; 
                              owl:maxCardinality "1"^^xsd:int ; 
                              a owl:Restriction],
                             [owl:onProperty common:name ; 
                              owl:cardinality "1"^^xsd:int ; 
                              a owl:Restriction],
                             [owl:onProperty common:version ; 
                              owl:maxCardinality "1"^^xsd:int ; 
                              a owl:Restriction],
                             soft:SoftwareAspect,
                             soft:Context_SoftwareEntity.
soft:Program_Disjoint a common:AllDisjointSet;
                      common:disjointClass "soft:RuntimeEnvironment",
                                           "soft:OperatingSystem",
                                           "soft:Application".
soft:RuntimeEnvironment a owl:Class;
                        rdfs:comment "This class represents a runtime environment present in a device. It can be a JRE, Brew or any other technology";
                        rdfs:label "Runtime Environment";
                        rdfs:subClassOf soft:Program.
soft:SiblingDisjoint2 a common:AllDisjointSet;
                      common:disjointClass "soft:Format",
                                           "soft:Api".
soft:SiblingDisjoint4 a common:AllDisjointSet;
                      common:disjointSet soft:SiblingDisjoint2,
                                         soft:Sibling_Disjoint1,
                                         soft:Sibling_Disjoint3.
soft:Sibling_Disjoint1 a common:AllDisjointSet;
                       common:disjointClass "soft:Certificate",
                                            "soft:Font",
                                            "soft:FontFamily",
                                            "soft:FontStyle",
                                            "soft:HandlingAssociation".
soft:Sibling_Disjoint3 a common:AllDisjointSet;
                       common:disjointClass "soft:Program",
                                            "soft:Plugin",
                                            "soft:DeviceSoftware".
soft:SoftwareAspect a owl:Class;
                    rdfs:comment "This class represents a software aspect";
                    rdfs:label "Software Aspect";
                    rdfs:subClassOf dcn:Aspect.
soft:TermGroup_Software a common:TermGroup;
                        rdfs:comment "It is a set of properties, classes and instances that model the software elements of a Delivery Context";
                        rdfs:label "Software";
                        common:normativeStatus common:Utility;
                        common:termGroupPrefix "soft".
soft:UserAgent a owl:Class;
               rdfs:comment "This class represents a client within a device";
               rdfs:label "User Agent";
               rdfs:subClassOf soft:Application;
               common:informativeReference "http://www.w3.org/TR/di-gloss/#def-user-agent".
soft:VideoFormat a owl:Class;
                 rdfs:comment "This class represents a particular video format, such as AVI or MP4";
                 rdfs:label "Video Format";
                 rdfs:subClassOf soft:Format.
soft:VideoPlayer a owl:Class;
                 rdfs:comment "This class represents user agents capable of dealing with video formats";
                 rdfs:label "Video Player";
                 rdfs:subClassOf [owl:someValuesFrom soft:VideoFormat ; 
                                  owl:onProperty soft:supportedFormats ; 
                                  a owl:Restriction],
                                 soft:MediaPlayer.
soft:VideoRecorder a owl:Class;
                   rdfs:comment "This class represents a user agent capable of recording video";
                   rdfs:label "Video Recorder";
                   rdfs:subClassOf [owl:someValuesFrom soft:VideoFormat ; 
                                    owl:onProperty soft:supportedFormats ; 
                                    a owl:Restriction],
                                   soft:MediaRecorder.
soft:X509Certificate a owl:Class;
                     rdfs:comment "This class represents an X.509 certificate";
                     rdfs:label "X.509 Certificate";
                     rdfs:subClassOf [owl:onProperty common:serialNumber ; 
                                      owl:maxCardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     soft:Certificate.
soft:XmlFormat a owl:Class;
               rdfs:comment "This class represents formats that are represented using XML";
               rdfs:label "XML Format";
               rdfs:subClassOf [owl:onProperty soft:namespace ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               soft:Format.
soft:acceptedCharacterSets a owl:ObjectProperty;
                           rdfs:comment "This property represents the charsets accepted  by a user agent";
                           rdfs:domain soft:Program;
                           rdfs:label "Accepted Character Sets";
                           rdfs:range common:CharacterSet;
                           rdfs:subPropertyOf common:supports;
                           common:relatedUAProfEntity "MmsCcppAcceptCharSet",
                                                      "Push-Accept-Charset",
                                                      "CcppAccept-Charset".
soft:acceptedTransferEncodings a owl:ObjectProperty;
                               rdfs:comment "The accepted transfer encodings supported by a user agent.";
                               rdfs:domain soft:Program;
                               rdfs:label "Accepted Transfer Encodings";
                               rdfs:range common:TransferEncoding;
                               rdfs:subPropertyOf common:supports;
                               common:relatedUAProfEntity "CcppAccept-Encoding",
                                                          "Push-Accept-Encoding",
                                                          "MmsCcppAcceptEncoding".
soft:apis a owl:ObjectProperty;
          rdfs:comment "The  APIs supported by a user agent";
          rdfs:domain soft:UserAgent;
          rdfs:label "APIs";
          rdfs:range soft:Api;
          rdfs:subPropertyOf common:supports.
soft:applicationProtocols a owl:ObjectProperty;
                          rdfs:comment "This property represents the  application protocols by a program";
                          rdfs:domain soft:Program;
                          rdfs:label "Supported Application Protocols";
                          rdfs:range common:ApplicationProtocol;
                          rdfs:subPropertyOf common:supports;
                          common:relatedUAProfEntity "Push-SupportedBearers".
soft:availableUserAgents a owl:ObjectProperty;
                         rdfs:comment "This property represents the available User Agents on a device";
                         rdfs:domain soft:DeviceSoftware;
                         rdfs:label "Available User Agents";
                         rdfs:range soft:UserAgent;
                         rdfs:subPropertyOf common:available,
                                            dcn:component.
soft:certificates a owl:ObjectProperty;
                  rdfs:comment "Installed certificates in a device or user agent";
                  rdfs:domain [owl:unionOf (soft:DeviceSoftware
                                            soft:UserAgent) ; 
                               a owl:Class];
                  rdfs:label "Certificates";
                  rdfs:range soft:Certificate;
                  rdfs:subPropertyOf common:available.
soft:characterColumns a owl:FunctionalProperty,
                        owl:DatatypeProperty;
                      rdfs:comment "The typical number of characters that can be displayed in a single row on the device display. This is an estimate using the default font for the device";
                      rdfs:domain dcn:Device;
                      rdfs:label "Character Columns";
                      rdfs:range xsd:int;
                      common:relatedUAProfEntity "ScreenSizeChar".
soft:characterRows a owl:FunctionalProperty,
                     owl:DatatypeProperty;
                   rdfs:comment "The typical number of rows of characters that can be displayed on the device display. This is an estimate using the default font for the device";
                   rdfs:domain dcn:Device;
                   rdfs:label "Character Rows";
                   rdfs:range xsd:int;
                   common:relatedUAProfEntity "ScreenSizeChar".
soft:contentType a owl:ObjectProperty;
                 rdfs:comment "These are the MIME types associated with this type of format";
                 rdfs:domain soft:Format;
                 rdfs:label "MIME Type";
                 rdfs:range common:ContentType.
soft:defaultHandler a owl:ObjectProperty;
                    rdfs:comment "This property represents a default handler";
                    rdfs:domain soft:DeviceSoftware;
                    rdfs:label "Default Handler";
                    rdfs:range soft:HandlingAssociation;
                    rdfs:subPropertyOf common:default.
soft:deviceSoftware a owl:FunctionalProperty,
                      owl:ObjectProperty;
                    rdfs:comment "This property represents the software on the device";
                    rdfs:domain dcn:Device;
                    rdfs:label "Device Software";
                    rdfs:range soft:DeviceSoftware.
soft:fontFamily a owl:FunctionalProperty,
                  owl:ObjectProperty;
                rdfs:comment "The font family of a font";
                rdfs:domain soft:Font;
                rdfs:label "Font Family";
                rdfs:range soft:FontFamily.
soft:fontSize a owl:FunctionalProperty,
                owl:DatatypeProperty;
              rdfs:comment "The absolute size of a font measured in points";
              rdfs:domain soft:Font;
              rdfs:label "Font Size";
              rdfs:range xsd:int.
soft:fontStyle a owl:FunctionalProperty,
                 owl:ObjectProperty;
               rdfs:comment "This property represents the font style of a font";
               rdfs:domain soft:Font;
               rdfs:label "Font Style";
               rdfs:range soft:FontStyle.
soft:fonts a owl:ObjectProperty;
           rdfs:comment "The fonts provided by a Context Entity. It can be the Device Software in general, a Web Browser or other program";
           rdfs:domain [owl:unionOf (soft:Program
                                     soft:DeviceSoftware) ; 
                        a owl:Class];
           rdfs:label "Fonts";
           rdfs:range soft:Font;
           rdfs:subPropertyOf common:available.
soft:gif87 a soft:ImageFormat;
           common:id "_GIF87";
           common:name "GIF87",
                       "GIF";
           common:version "87".
soft:gif89a a soft:ImageFormat;
            common:id "_GIF89A";
            common:name "GIF89a";
            common:version "89a".
soft:handledElement a owl:FunctionalProperty,
                      owl:ObjectProperty;
                    rdfs:comment "This property represents the handled element in a handler relationship";
                    rdfs:domain soft:HandlingAssociation;
                    rdfs:label "Handled Element".
soft:handler a owl:FunctionalProperty,
               owl:ObjectProperty;
             rdfs:comment "This property represents a program that acts as a handler";
             rdfs:domain soft:HandlingAssociation;
             rdfs:label "Handler";
             rdfs:range soft:Program.
soft:issuer a owl:DatatypeProperty;
            rdfs:comment "The issuer of a certificate";
            rdfs:domain soft:Certificate;
            rdfs:label "Issuer";
            rdfs:range xsd:string.
soft:jpeg a soft:ImageFormat;
          rdfs:comment "The JPEG file image format image type.";
          common:id "_JPEG";
          common:name "JPEG",
                      "JPG".
soft:maxDeliveryUnitSize a owl:FunctionalProperty,
                           owl:DatatypeProperty;
                         rdfs:comment "The maximum message size for a delivery unit supported by a user agent measured in bytes. A Delivery Unit can be defined as a set of material transferred between two cooperating  programs as the response to a single request";
                         rdfs:domain soft:UserAgent;
                         rdfs:label "Maximum Delivery Unit Size";
                         rdfs:range xsd:unsignedLong.
soft:namespace a owl:FunctionalProperty,
                 owl:DatatypeProperty;
               rdfs:comment "The namespace of an XML format";
               rdfs:domain soft:XmlFormat;
               rdfs:label "Namespace";
               rdfs:range xsd:anyURI.
soft:notAfter a owl:FunctionalProperty,
                owl:DatatypeProperty;
              rdfs:comment "This property conveys a date that indicates that the certificate in question will not be valid after that date";
              rdfs:domain soft:Certificate;
              rdfs:label "Not After";
              rdfs:range xsd:dateTime.
soft:notBefore a owl:FunctionalProperty,
                 owl:DatatypeProperty;
               rdfs:comment "This property indicates that this certificate is valid not before this date";
               rdfs:domain soft:Certificate;
               rdfs:label "Not Before";
               rdfs:range xsd:dateTime.
soft:operatingSystem a owl:FunctionalProperty,
                       owl:ObjectProperty;
                     rdfs:comment "This is the active operating system";
                     rdfs:domain soft:DeviceSoftware;
                     rdfs:label "Active Operating System";
                     rdfs:range soft:OperatingSystem;
                     rdfs:subPropertyOf dcn:activeComponent.
soft:png a soft:ImageFormat;
         rdfs:comment "The PNG file image format image type.";
         common:id "_PNG";
         common:name "PNG".
soft:preferredFormats a owl:ObjectProperty;
                      rdfs:comment "The best supported formats";
                      rdfs:label "Preferred Formats";
                      rdfs:range soft:Format;
                      rdfs:subPropertyOf soft:supportedFormats.
soft:subject a owl:FunctionalProperty,
               owl:DatatypeProperty;
             rdfs:comment "The subject of a certificate";
