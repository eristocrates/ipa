java:Sibling_Disjoint2 a common:AllDisjointSet;
                       common:disjointClass "java:J2meOptionalPackage",
                                            "java:JavaRuntimeEnvironment".
java:TermGroup_Java a common:TermGroup;
                    rdfs:comment "These terms model a minimal set of properties and classes that allow to represent the features of a Delivery Context related to the support of Java technologies";
                    rdfs:label "Java";
                    common:normativeStatus common:Utility;
                    common:termGroupPrefix "java".
java:availableJREs a owl:ObjectProperty;
                   rdfs:comment "The available Java Runtime Environments";
                   rdfs:domain soft:DeviceSoftware;
                   rdfs:label "Available Java Runtime Environments";
                   rdfs:range java:JavaRuntimeEnvironment;
                   rdfs:subPropertyOf common:available,
                                      dcn:component.
java:defaultJRE a owl:FunctionalProperty,
