net:NonTransparentProxy a owl:Class;
                        rdfs:comment "An HTTP a proxy that modifies the request or response in order to provide some added service to the user agent, such as group annotation services, media type transformation, protocol reduction, or anonymity filtering.";
                        rdfs:label "Non Transparent HTTP Proxy";
