net:Network a owl:Class;
            rdfs:comment "This class represents a  Network in the Delivery Context";
            rdfs:label "Network";
            rdfs:subClassOf [owl:someValuesFrom net:NetworkMode ; 
                             owl:onProperty net:networkMode ; 
                             a owl:Restriction],
                            net:Context_NetworkEntity,
                            dcn:Aspect.
net:NetworkBearer a owl:Class;
                  rdfs:comment "This class represents a network bearer in a delivery context";
                  rdfs:label "Network Bearer";
                  rdfs:subClassOf net:Context_NetworkEntity,
                                  [owl:onProperty net:bearerTechnology ; 
                                   owl:allValuesFrom net:NetworkBearerTechnology ; 
                                   a owl:Restriction],
                                  [owl:onProperty net:currentDownloadBandwidth ; 
                                   owl:maxCardinality "1"^^xsd:int ; 
                                   a owl:Restriction],
                                  [owl:onProperty net:currentUploadBandwidth ; 
                                   owl:maxCardinality "1"^^xsd:int ; 
                                   a owl:Restriction],
                                  [owl:onProperty net:bearerTechnology ; 
                                   owl:cardinality "1"^^xsd:int ; 
                                   a owl:Restriction],
                                  dcn:Aspect;
                  common:relatedUAProfEntity "NetworkCharacteristics".
net:NetworkBearerTechnology a owl:Class;
                            rdfs:comment "This class represents network bearer technologies";
                            rdfs:label "Network Bearer Technology";
                            rdfs:subClassOf [owl:onProperty common:id ; 
                                             owl:cardinality "1"^^xsd:int ; 
                                             a owl:Restriction],
                                            [owl:onProperty common:name ; 
                                             owl:minCardinality "1"^^xsd:int ; 
                                             a owl:Restriction],
                                            net:Context_NetworkEntity;
                            common:relatedUAProfEntity "NetworkCharacteristics".
net:NetworkMode a owl:Class;
                rdfs:comment "A mode of operation of a network which includes network technology and operation frequency bands";
                rdfs:label "Newtwork Mode";
                rdfs:subClassOf [owl:onProperty net:operationBands ; 
                                 owl:minCardinality "1"^^xsd:int ; 
                                 a owl:Restriction],
                                [owl:onProperty net:networkTechnology ; 
                                 owl:cardinality "1"^^xsd:int ; 
                                 a owl:Restriction],
                                [owl:onProperty net:networkTechnology ; 
                                 owl:allValuesFrom net:NetworkTechnology ; 
                                 a owl:Restriction],
                                net:Context_NetworkEntity.
net:NetworkSupport a owl:Class;
                   rdfs:comment "This class represents the network characteristics of a device";
                   rdfs:label "Network Support";
                   rdfs:subClassOf [owl:someValuesFrom net:NetworkBearer ; 
                                    owl:onProperty net:supportedNetworkBearers ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom net:NetworkMode ; 
                                    owl:onProperty net:supportedNetworkModes ; 
                                    a owl:Restriction],
                                   net:Context_NetworkEntity.
net:NetworkTechnology a owl:Class;
                      rdfs:comment "This class represents different network technologies";
                      rdfs:label "Network Technology";
                      rdfs:subClassOf [owl:onProperty common:name ; 
                                       owl:minCardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty common:id ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      net:Context_NetworkEntity;
                      common:relatedUAProfEntity "NetworkCharacteristics".
net:NetworkType_AMPS a net:NetworkTechnology;
