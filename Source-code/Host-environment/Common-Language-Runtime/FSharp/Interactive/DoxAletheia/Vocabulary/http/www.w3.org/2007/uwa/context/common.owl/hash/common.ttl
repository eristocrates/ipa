                            rdfs:domain dcn:Device;
                            rdfs:label "JavaMaxMemorySize";
                            rdfs:range xsd:unsignedLong.
<http://www.w3.org/2007/uwa/context/location.owl#AllSibling_Disjoint> a common:AllDisjointSet;
                                                                      common:disjointClass "loc:Position",
                                                                                           "loc:LocationProvider",
                                                                                           "loc:LocationMethod",
                                                                                           "loc:Location",
                                                                                           "loc:GeoCoordinates",
                                                                                           "loc:GeoCoordinateRS".
<http://www.w3.org/2007/uwa/context/location.owl#AngleOfArrivalLocMethod> a owl:Class;
                                                                          rdfs:comment "Location method Angle of Arrival for cellular / terrestrial RF system";
                                                                          rdfs:label "Angle Of Arrival Method";
                                                                          rdfs:subClassOf <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod>.
<http://www.w3.org/2007/uwa/context/location.owl#AssistedLocMethod> a owl:Class;
                                                                    rdfs:comment "Location method is assisted by the other party (Terminal assisted for Network based, Network assisted for terminal based)";
                                                                    rdfs:label "Assisted Method";
                                                                    rdfs:subClassOf <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod>.
<http://www.w3.org/2007/uwa/context/location.owl#BluetoothBinaryLocMeth> a <http://www.w3.org/2007/uwa/context/location.owl#UnassistedLocMethod>,
                                                                           <http://www.w3.org/2007/uwa/context/location.owl#TerminalBasedLocMethod>,
                                                                           <http://www.w3.org/2007/uwa/context/location.owl#ShortRangeLocMethod>;
                                                                         rdfs:comment """A room-oriented approach, uses a proximity detection method. An
access point is installed in every room. For each tag, the system than
finds the nearest AP, and respectively indicates its room location""";
                                                                         common:name "BluetoothBinaryLocationMethod".
<http://www.w3.org/2007/uwa/context/location.owl#CellIdLocMethod> a owl:Class;
                                                                  rdfs:comment "Location method Cell-ID for cellular (in GSM, this is the same as CGI, Cell Global Identity)";
                                                                  rdfs:label "Cell Id Method";
                                                                  rdfs:subClassOf <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod>.
<http://www.w3.org/2007/uwa/context/location.owl#CellularStandardAngleOfArrival> a <http://www.w3.org/2007/uwa/context/location.owl#UnassistedLocMethod>,
                                                                                   <http://www.w3.org/2007/uwa/context/location.owl#NetworkBasedLocMethod>,
                                                                                   <http://www.w3.org/2007/uwa/context/location.owl#AngleOfArrivalLocMethod>;
                                                                                 rdfs:comment "Standard angle of arrival location method in a cellular network";
                                                                                 common:id "CellularStandardAngleOfArrival";
                                                                                 common:name "CellularStandardAngleOfArrival";
                                                                                 common:normativeStatus common:Utility.
<http://www.w3.org/2007/uwa/context/location.owl#Context_LocationEntity> a owl:Class;
                                                                         rdfs:comment "This class reprensents the set of all delivery context entities that has to do with location";
                                                                         rdfs:label "Context Location Entity";
                                                                         rdfs:subClassOf dcn:Context_Entity.
<http://www.w3.org/2007/uwa/context/location.owl#E-OTD> a <http://www.w3.org/2007/uwa/context/location.owl#AssistedLocMethod>,
                                                          <http://www.w3.org/2007/uwa/context/location.owl#NetworkBasedLocMethod>,
                                                          <http://www.w3.org/2007/uwa/context/location.owl#TimeOfArrivalLocMethod>,
                                                          <http://www.w3.org/2007/uwa/context/location.owl#TimeDifferenceLocMethod>;
                                                        rdfs:comment "E-OTD systems operate by placing location receivers or reference beacons, overlaid on the wireless network as a location measurement units (LMU) at multiple sites geographically dispersed in a wide area.";
                                                        common:name "E-OTD".
<http://www.w3.org/2007/uwa/context/location.owl#Feature_ALTITUDE> a common:Feature;
