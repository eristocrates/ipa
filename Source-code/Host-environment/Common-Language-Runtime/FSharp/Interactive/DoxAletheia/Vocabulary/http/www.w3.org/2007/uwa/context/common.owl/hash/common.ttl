                                                                      rdfs:subClassOf <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod>.
<http://www.w3.org/2007/uwa/context/location.owl#WGS84Coordinates> a <http://www.w3.org/2002/07/owl#Class>;
                                                                   rdfs:comment "This class represents WGS84 coordinates";
