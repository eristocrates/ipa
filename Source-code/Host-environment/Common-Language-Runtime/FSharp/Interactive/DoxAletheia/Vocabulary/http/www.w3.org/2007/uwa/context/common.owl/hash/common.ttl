                                     a owl:Restriction],
                                    common:Context_CommonEntity;
                    common:normativeReference "http://tools.ietf.org/html/rfc2045#section-2.2"^^xsd:anyURI;
                    common:relatedUAProfEntity "InputCharset",
                                               "OutputCharset",
                                               "CcppAccept-Charset".
