                                                                common:name "Speed";
                                                                common:normativeStatus common:Normative.
<http://www.w3.org/2007/uwa/context/location.owl#GSMCellGlobalIdentity> a <http://www.w3.org/2007/uwa/context/location.owl#AssistedLocMethod>,
                                                                          <http://www.w3.org/2007/uwa/context/location.owl#TerminalBasedLocMethod>,
                                                                          <http://www.w3.org/2007/uwa/context/location.owl#CellIdLocMethod>;
                                                                        common:name "GSMCellGlobalIdentity".
<http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS> a owl:Class;
                                                                  rdfs:comment "This class represents a geographical coordinate system";
                                                                  rdfs:label "Geographical Coordinate Reference System";
                                                                  rdfs:subClassOf [owl:onProperty common:name ; 
                                                                                   owl:maxCardinality "1"^^xsd:int ; 
                                                                                   a owl:Restriction],
                                                                                  [owl:onProperty common:id ; 
                                                                                   owl:cardinality "1"^^xsd:int ; 
                                                                                   a owl:Restriction],
                                                                                  <http://www.w3.org/2007/uwa/context/location.owl#Context_LocationEntity>.
<http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS_UTM> a <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS>;
                                                                      rdfs:comment "The Universal Traversal Marcator coordinate reference system";
                                                                      rdfs:label "UTM";
                                                                      common:id "__GeocordinateRS_UTM";
                                                                      common:name "UTM";
                                                                      common:normativeStatus common:Utility.
<http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS_WGS84> a <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS>;
                                                                        rdfs:comment "The WGS 84 geographic coordinates reference system";
                                                                        rdfs:label "WGS 84";
                                                                        common:id "__GeoCordinateRS_WGS84";
                                                                        common:name "WGS84";
                                                                        common:normativeStatus common:Normative.
<http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinates> a owl:Class;
                                                                 rdfs:comment "This class represents geographical coordinates that allow to locate precisely a point on the Earth surface";
                                                                 rdfs:label "Geographical Coordinates";
                                                                 rdfs:subClassOf [owl:someValuesFrom <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS> ; 
                                                                                  owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#geoReferenceSystem> ; 
                                                                                  a owl:Restriction],
                                                                                 [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#geoReferenceSystem> ; 
                                                                                  owl:cardinality "1"^^xsd:int ; 
                                                                                  a owl:Restriction],
                                                                                 <http://www.w3.org/2007/uwa/context/location.owl#Context_LocationEntity>.
<http://www.w3.org/2007/uwa/context/location.owl#LocMeth_Disjoint1> a common:AllDisjointSet;
                                                                    common:disjointClass "loc:AssistedLocMethod",
                                                                                         "loc:UnassistedLocMethod".
<http://www.w3.org/2007/uwa/context/location.owl#LocMeth_Disjoint2> a common:AllDisjointSet;
                                                                    common:disjointClass "loc:TerminalBasedLocMethod",
                                                                                         "loc:NetworkBasedLocMethod".
<http://www.w3.org/2007/uwa/context/location.owl#Location> a owl:Class;
                                                           rdfs:comment "This class represents all the information about a location";
                                                           rdfs:label "Location";
                                                           rdfs:subClassOf [owl:someValuesFrom <http://www.w3.org/2007/uwa/context/location.owl#Position> ; 
                                                                            owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#position> ; 
                                                                            a owl:Restriction],
                                                                           <http://www.w3.org/2007/uwa/context/location.owl#Context_LocationEntity>.
<http://www.w3.org/2007/uwa/context/location.owl#LocationMethod> a owl:Class;
                                                                 rdfs:comment "It represents an specific mechanism used to calculate the location of a thing";
                                                                 rdfs:label "Location Method";
                                                                 rdfs:subClassOf [owl:onProperty common:name ; 
                                                                                  owl:minCardinality "1"^^xsd:int ; 
                                                                                  a owl:Restriction],
                                                                                 <http://www.w3.org/2007/uwa/context/location.owl#Context_LocationEntity>.
<http://www.w3.org/2007/uwa/context/location.owl#LocationProvider> a owl:Class;
                                                                   rdfs:comment "Represents an entity capable of providing location information";
                                                                   rdfs:label "Location Provider";
                                                                   rdfs:subClassOf [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#locationMethod> ; 
                                                                                    owl:allValuesFrom <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod> ; 
                                                                                    a owl:Restriction],
                                                                                   [owl:someValuesFrom <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod> ; 
                                                                                    owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#locationMethod> ; 
                                                                                    a owl:Restriction],
                                                                                   [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#supportedGeoCoordinateRS> ; 
                                                                                    owl:allValuesFrom <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS> ; 
                                                                                    a owl:Restriction],
                                                                                   [owl:someValuesFrom <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS> ; 
                                                                                    owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#supportedGeoCoordinateRS> ; 
                                                                                    a owl:Restriction],
                                                                                   <http://www.w3.org/2007/uwa/context/location.owl#Context_LocationEntity>.
<http://www.w3.org/2007/uwa/context/location.owl#NetworkBasedLocMethod> a owl:Class;
                                                                        rdfs:comment "Location method is of type network based. This means that the final location result is calculated in the network";
                                                                        rdfs:label "Network Based Method";
                                                                        rdfs:subClassOf <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod>.
<http://www.w3.org/2007/uwa/context/location.owl#Position> a owl:Class;
                                                           rdfs:comment "This class represents a position, which it is composed by the coordinates of a point on the Earth surface, together with the speed, course, and the corresponding accuracies and timestamp";
                                                           rdfs:label "Position";
                                                           rdfs:subClassOf [owl:unionOf ([owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#coordinates> ; 
                                                                                         owl:cardinality "1"^^xsd:int ; 
                                                                                         a owl:Restriction]
                                                                                         [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#iso6709String> ; 
                                                                                         owl:cardinality "1"^^xsd:int ; 
                                                                                         a owl:Restriction]) ; 
                                                                            a owl:Class],
                                                                           [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#coordinates> ; 
                                                                            owl:allValuesFrom <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinates> ; 
                                                                            a owl:Restriction],
                                                                           <http://www.w3.org/2007/uwa/context/location.owl#Context_LocationEntity>.
<http://www.w3.org/2007/uwa/context/location.owl#SatelliteLocMethod> a owl:Class;
                                                                     rdfs:comment "The location method uses satellites to assist in obtaining the location";
                                                                     rdfs:label "Satellite  Method";
                                                                     rdfs:subClassOf <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod>.
<http://www.w3.org/2007/uwa/context/location.owl#ShortRangeLocMethod> a owl:Class;
                                                                      rdfs:comment "Location method Short-range positioning system (for example, Bluetooth LP)";
                                                                      rdfs:label "Short Range Method";
                                                                      rdfs:subClassOf <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod>.
<http://www.w3.org/2007/uwa/context/location.owl#TDOA> a <http://www.w3.org/2007/uwa/context/location.owl#UnassistedLocMethod>,
                                                         <http://www.w3.org/2007/uwa/context/location.owl#NetworkBasedLocMethod>,
                                                         <http://www.w3.org/2007/uwa/context/location.owl#TimeOfArrivalLocMethod>,
                                                         <http://www.w3.org/2007/uwa/context/location.owl#TimeDifferenceLocMethod>;
                                                       rdfs:comment "The TDOA technique works by measuring the exact time of arrival of a handset radio signal at three or more separate cell sites.";
                                                       common:name "TDOA".
<http://www.w3.org/2007/uwa/context/location.owl#TermGroup_Location> a common:TermGroup;
                                                                     rdfs:comment "This group of terms is aimed at defining a set of classes, properties and instances that have to do with Geographic Location";
                                                                     rdfs:label "Location";
                                                                     common:normativeStatus common:Utility;
                                                                     common:termGroupPrefix "loc".
<http://www.w3.org/2007/uwa/context/location.owl#TerminalBasedLocMethod> a owl:Class;
                                                                         rdfs:comment "Location method is of type terminal based. This means that the final location result is calculated in the terminal";
                                                                         rdfs:label "Terminal Based Method";
                                                                         rdfs:subClassOf <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod>.
<http://www.w3.org/2007/uwa/context/location.owl#TerminallGPSUnAssisted> a <http://www.w3.org/2007/uwa/context/location.owl#TerminalBasedLocMethod>,
                                                                           <http://www.w3.org/2007/uwa/context/location.owl#UnassistedLocMethod>,
                                                                           <http://www.w3.org/2007/uwa/context/location.owl#SatelliteLocMethod>;
                                                                         rdfs:comment "Location method GPS assisted with no network cooperation";
                                                                         common:name "TerminallGPSUnAssisted".
<http://www.w3.org/2007/uwa/context/location.owl#TimeDifferenceLocMethod> a owl:Class;
                                                                          rdfs:comment "Location method Time Difference for cellular / terrestrial RF system";
                                                                          rdfs:label "Time Difference Method";
                                                                          rdfs:subClassOf <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod>.
<http://www.w3.org/2007/uwa/context/location.owl#TimeOfArrivalLocMethod> a owl:Class;
                                                                         rdfs:comment "Location method Time of Arrival (TOA) for cellular / terrestrial RF system";
                                                                         rdfs:label "Time of Arrival Method";
                                                                         rdfs:subClassOf <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod>.
<http://www.w3.org/2007/uwa/context/location.owl#UTMCoordinates> a owl:Class;
                                                                 rdfs:comment "This class represents UTM coordinates";
                                                                 rdfs:label "UTM Coordinates";
                                                                 rdfs:subClassOf [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#geoReferenceSystem> ; 
                                                                                  owl:hasValue <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS_UTM> ; 
                                                                                  a owl:Restriction],
                                                                                 [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#latitudeZone> ; 
                                                                                  owl:cardinality "1"^^xsd:int ; 
                                                                                  a owl:Restriction],
                                                                                 [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#datum> ; 
                                                                                  owl:cardinality "1"^^xsd:int ; 
                                                                                  a owl:Restriction],
                                                                                 <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinates>,
                                                                                 [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#longitudeZone> ; 
                                                                                  owl:cardinality "1"^^xsd:int ; 
                                                                                  a owl:Restriction],
                                                                                 [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#easting> ; 
                                                                                  owl:cardinality "1"^^xsd:int ; 
                                                                                  a owl:Restriction],
                                                                                 [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#northing> ; 
                                                                                  owl:cardinality "1"^^xsd:int ; 
                                                                                  a owl:Restriction];
                                                                 common:normativeStatus common:Informative.
<http://www.w3.org/2007/uwa/context/location.owl#UnassistedLocMethod> a owl:Class;
                                                                      rdfs:comment "Location method is unassisted it does not need other party in order to obtain the location";
                                                                      rdfs:label "Unassisted Method";
                                                                      rdfs:subClassOf <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod>.
<http://www.w3.org/2007/uwa/context/location.owl#WGS84Coordinates> a owl:Class;
                                                                   rdfs:comment "This class represents WGS84 coordinates";
                                                                   rdfs:label "WGS84 Coordinates";
                                                                   rdfs:subClassOf [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#geoReferenceSystem> ; 
                                                                                    owl:hasValue <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS_WGS84> ; 
                                                                                    a owl:Restriction],
                                                                                   [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#latitude> ; 
                                                                                    owl:cardinality "1"^^xsd:int ; 
                                                                                    a owl:Restriction],
                                                                                   [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#longitude> ; 
                                                                                    owl:cardinality "1"^^xsd:int ; 
                                                                                    a owl:Restriction],
                                                                                   [owl:onProperty <http://www.w3.org/2007/uwa/context/location.owl#datum> ; 
                                                                                    owl:hasValue "WGS84" ; 
                                                                                    a owl:Restriction],
                                                                                   <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinates>.
<http://www.w3.org/2007/uwa/context/location.owl#altitude> a owl:FunctionalProperty,
                                                             owl:DatatypeProperty;
                                                           rdfs:comment "The altitude as defined by the WGS84 coordinate system";
                                                           rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#WGS84Coordinates>;
                                                           rdfs:label "Altitude";
                                                           rdfs:range xsd:float.
<http://www.w3.org/2007/uwa/context/location.owl#availableLocationProviders> a owl:ObjectProperty;
                                                                             rdfs:comment "This property represents the LocationProviders that are currently available in a network, device or the Delivery Context itself as whole";
                                                                             rdfs:domain [owl:unionOf (net:Network
                                                                                                       dcn:Device
                                                                                                       dcn:DeliveryContext) ; 
                                                                                          a owl:Class];
                                                                             rdfs:label "Available Location Providers";
                                                                             rdfs:range <http://www.w3.org/2007/uwa/context/location.owl#LocationProvider>;
                                                                             rdfs:subPropertyOf common:available,
                                                                                                <http://www.w3.org/2007/uwa/context/location.owl#supportedLocationProviders>.
<http://www.w3.org/2007/uwa/context/location.owl#coordinates> a owl:FunctionalProperty,
                                                                owl:ObjectProperty;
                                                              rdfs:comment "The coordinates of a point";
                                                              rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#Position>;
                                                              rdfs:label "Coordinates";
                                                              rdfs:range <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinates>.
<http://www.w3.org/2007/uwa/context/location.owl#course> a owl:FunctionalProperty,
                                                           owl:DatatypeProperty;
                                                         rdfs:comment "The course made good in degrees relative to true north. The value is always in the range [0.0,360.0) degrees";
                                                         rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#Position>;
                                                         rdfs:label "Course";
                                                         rdfs:range xsd:double.
<http://www.w3.org/2007/uwa/context/location.owl#currentLocation> a owl:FunctionalProperty,
                                                                    owl:ObjectProperty;
                                                                  rdfs:comment "The current location associated to the environment component of this Delivery Context";
                                                                  rdfs:domain dcn:Environment;
                                                                  rdfs:label "Current Location";
                                                                  rdfs:range <http://www.w3.org/2007/uwa/context/location.owl#Location>.
<http://www.w3.org/2007/uwa/context/location.owl#datum> a owl:FunctionalProperty,
                                                          owl:DatatypeProperty;
                                                        rdfs:comment "The datum that express the reference of the coordinates";
                                                        rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinates>;
                                                        rdfs:label "Datum";
                                                        rdfs:range xsd:string.
<http://www.w3.org/2007/uwa/context/location.owl#easting> a owl:FunctionalProperty,
                                                            owl:DatatypeProperty;
                                                          rdfs:comment "The easting (x) component of the UTM coordinates measured in metres";
                                                          rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#UTMCoordinates>;
                                                          rdfs:label "Easting";
                                                          rdfs:range xsd:float;
                                                          common:normativeStatus common:Informative.
<http://www.w3.org/2007/uwa/context/location.owl#estimatedPosition> a owl:FunctionalProperty,
                                                                      owl:ObjectProperty;
                                                                    rdfs:comment "The estimated position provided by a location provider";
                                                                    rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#LocationProvider>;
                                                                    rdfs:label "Estimated Position";
                                                                    rdfs:range <http://www.w3.org/2007/uwa/context/location.owl#Position>.
<http://www.w3.org/2007/uwa/context/location.owl#geoReferenceSystem> a owl:ObjectProperty;
                                                                     rdfs:comment "This property represents the reference system in which are expressed the geographical coordinates";
                                                                     rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinates>;
                                                                     rdfs:label "Georeference System";
                                                                     rdfs:range <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS>.
<http://www.w3.org/2007/uwa/context/location.owl#horizontalAccuracy> a owl:FunctionalProperty,
                                                                       owl:DatatypeProperty;
                                                                     rdfs:comment "Stimate of the horizontal accuracy of the location in metres";
                                                                     rdfs:domain [owl:unionOf (<http://www.w3.org/2007/uwa/context/location.owl#Position>
                                                                                               <http://www.w3.org/2007/uwa/context/location.owl#LocationProvider>) ; 
                                                                                  a owl:Class];
                                                                     rdfs:label "Horizontal Accuracy";
                                                                     rdfs:range xsd:int.
<http://www.w3.org/2007/uwa/context/location.owl#iso6709String> a owl:FunctionalProperty,
                                                                  owl:DatatypeProperty;
                                                                rdfs:comment "The position represented as an ISO6709:1983 String";
                                                                rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#Position>;
                                                                rdfs:label "ISO 6709:1983 String";
                                                                rdfs:range xsd:string.
<http://www.w3.org/2007/uwa/context/location.owl#lastKnownLocation> a owl:FunctionalProperty,
                                                                      owl:ObjectProperty;
                                                                    rdfs:comment "The last known location associated to a Delivery Context";
                                                                    rdfs:domain dcn:Environment;
                                                                    rdfs:label "Last Known Location";
                                                                    rdfs:range <http://www.w3.org/2007/uwa/context/location.owl#Location>.
<http://www.w3.org/2007/uwa/context/location.owl#latitude> a owl:FunctionalProperty,
                                                             owl:DatatypeProperty;
                                                           rdfs:comment "Latitude as defined by the WGS84 coordinate reference system";
                                                           rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#WGS84Coordinates>;
                                                           rdfs:label "Latitude";
                                                           rdfs:range xsd:float.
<http://www.w3.org/2007/uwa/context/location.owl#latitudeZone> a owl:FunctionalProperty,
                                                                 owl:DatatypeProperty;
                                                               rdfs:comment "This property represent the UTM latitude zone";
                                                               rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#UTMCoordinates>;
                                                               rdfs:label "UTM Latitude Zone";
                                                               rdfs:range xsd:string;
                                                               common:normativeStatus common:Informative.
<http://www.w3.org/2007/uwa/context/location.owl#locationCostsMoney> a owl:FunctionalProperty,
                                                                       owl:DatatypeProperty;
                                                                     rdfs:comment "This property indicates whether the location provider has a cost for the user";
                                                                     rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#LocationProvider>;
                                                                     rdfs:label "Location Costs Money";
                                                                     rdfs:range xsd:boolean.
<http://www.w3.org/2007/uwa/context/location.owl#locationMethod> a owl:FunctionalProperty,
                                                                   owl:ObjectProperty;
                                                                 rdfs:comment "The location method used by a LocationProvider for determining the current location";
                                                                 rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#LocationProvider>;
                                                                 rdfs:label "Location Method";
                                                                 rdfs:range <http://www.w3.org/2007/uwa/context/location.owl#LocationMethod>.
<http://www.w3.org/2007/uwa/context/location.owl#longitude> a owl:FunctionalProperty,
                                                              owl:DatatypeProperty;
                                                            rdfs:comment "The longitude as defined by the WGS84 coordinate system";
                                                            rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#WGS84Coordinates>;
                                                            rdfs:label "Longitude";
                                                            rdfs:range xsd:float.
<http://www.w3.org/2007/uwa/context/location.owl#longitudeZone> a owl:FunctionalProperty,
                                                                  owl:DatatypeProperty;
                                                                rdfs:comment "This property represents the longitude zone according to the UTM coordinate system";
                                                                rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#UTMCoordinates>;
                                                                rdfs:label "UTM Longitude Zone";
                                                                rdfs:range xsd:int;
                                                                common:normativeStatus common:Informative.
<http://www.w3.org/2007/uwa/context/location.owl#northing> a owl:FunctionalProperty,
                                                             owl:DatatypeProperty;
                                                           rdfs:comment "The northing component of the UTM coordinates measured in metres";
                                                           rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#UTMCoordinates>;
                                                           rdfs:label "Northing";
                                                           rdfs:range xsd:float;
                                                           common:normativeStatus common:Informative.
<http://www.w3.org/2007/uwa/context/location.owl#position> a owl:FunctionalProperty,
                                                             owl:ObjectProperty;
                                                           rdfs:comment "The position associated to a Location";
                                                           rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#Location>;
                                                           rdfs:label "Position";
                                                           rdfs:range <http://www.w3.org/2007/uwa/context/location.owl#Position>.
<http://www.w3.org/2007/uwa/context/location.owl#speed> a owl:FunctionalProperty,
                                                          owl:DatatypeProperty;
                                                        rdfs:comment "Observed speed in meters per second";
                                                        rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#Position>;
                                                        rdfs:label "Speed";
                                                        rdfs:range xsd:double.
<http://www.w3.org/2007/uwa/context/location.owl#supportedGeoCoordinateRS> a owl:ObjectProperty;
                                                                           rdfs:comment "Indicates what are goegraphical coordinate systems supported by the location provider";
                                                                           rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#LocationProvider>;
                                                                           rdfs:label "Geographical Coordinate Systems";
                                                                           rdfs:range <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS>;
                                                                           rdfs:subPropertyOf common:supports.
<http://www.w3.org/2007/uwa/context/location.owl#supportedLocationProviders> a owl:ObjectProperty;
                                                                             rdfs:comment "This property is a list of the Location Providers supported by a Device or a Network";
                                                                             rdfs:domain [owl:unionOf (dcn:Device
                                                                                                       net:Network) ; 
                                                                                          a owl:Class];
                                                                             rdfs:label "Supported Location Providers";
                                                                             rdfs:range <http://www.w3.org/2007/uwa/context/location.owl#LocationProvider>;
                                                                             rdfs:subPropertyOf common:supports.
<http://www.w3.org/2007/uwa/context/location.owl#timestamp> a owl:FunctionalProperty,
                                                              owl:DatatypeProperty;
                                                            rdfs:comment "A timestamp that indicates when it was obtained the position in question";
                                                            rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#Position>;
                                                            rdfs:label "Location Timestamp";
                                                            rdfs:range xsd:dateTime.
<http://www.w3.org/2007/uwa/context/location.owl#typicalResponseTime> a owl:DatatypeProperty;
                                                                      rdfs:comment "This property represents the typical response time in seconds of a location provider from the instant in which the location is requested to the moment in which the location is returned";
                                                                      rdfs:domain <http://www.w3.org/2007/uwa/context/location.owl#LocationProvider>;
                                                                      rdfs:label "Typical Response Time";
                                                                      rdfs:range xsd:int.
<http://www.w3.org/2007/uwa/context/location.owl#utmCoordinates> a owl:FunctionalProperty,
                                                                   owl:ObjectProperty;
                                                                 rdfs:comment "Coordinates of a point expressed in the  UTM reference system";
                                                                 rdfs:label "UTM Coordinates";
