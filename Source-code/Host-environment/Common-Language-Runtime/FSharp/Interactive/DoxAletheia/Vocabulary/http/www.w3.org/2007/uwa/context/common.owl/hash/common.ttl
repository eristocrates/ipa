<http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice_FOUR_WAY_SCROLLER> a <http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice>;
                                                                                rdfs:comment "Scroll up and down and side to side";
                                                                                rdfs:label "Four Way Scroller";
                                                                                common:id "__InputDevice_FourWayScroller";
                                                                                common:normativeStatus common:Normative.
<http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice_JOG_DIAL> a <http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice>;
                                                                       rdfs:comment "A jog dial, jog wheel, shuttle dial, or shuttle wheel is a type of knob, ring, wheel, or dial which allows the user to shuttle or jog";
                                                                       rdfs:label "Jog Dial";
                                                                       common:id "__InputDevice_JogDial";
                                                                       common:normativeStatus common:Normative.
<http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice_MOUSE> a <http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice>;
                                                                    rdfs:comment "Represents a typical two button mouse found on a PC device";
                                                                    rdfs:label "Mouse";
                                                                    common:id "__InputDevice_Mouse";
                                                                    common:normativeStatus common:Normative.
<http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice_NUMERIC_KEYPAD> a <http://www.w3.org/2007/uwa/context/hardware.owl#Keyboard>;
                                                                             rdfs:comment "A keyboard with only numeric input";
                                                                             rdfs:label "Numeric Keypad";
                                                                             common:id "__InputDevice_NumericKeypad";
