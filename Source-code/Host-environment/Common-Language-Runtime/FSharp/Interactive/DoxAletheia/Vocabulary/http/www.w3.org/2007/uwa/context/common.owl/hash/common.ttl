            rdfs:label "Memory";
            rdfs:range hard:MemoryUnit;
            rdfs:subPropertyOf hard:hardwareComponent.
hard:muted a owl:FunctionalProperty,
             owl:DatatypeProperty;
           rdfs:comment "Indicates if a speaker or microphone is muted or not";
           rdfs:domain [owl:unionOf (hard:Speaker
                                     hard:Microphone) ; 
                        a owl:Class];
           rdfs:label "Muted";
           rdfs:range xsd:boolean.
hard:outputCharacterSets a owl:ObjectProperty;
