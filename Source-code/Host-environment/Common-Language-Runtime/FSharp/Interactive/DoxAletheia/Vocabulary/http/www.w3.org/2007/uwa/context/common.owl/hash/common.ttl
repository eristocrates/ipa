                         rdfs:comment "This property represents a maximum download bandwidth measured in Kbits/s";
                         rdfs:domain net:BandwidthSupport;
                         rdfs:label "Maximum download Bandwidth";
                         rdfs:range xsd:int.
net:maxUploadBandwidth a owl:FunctionalProperty,
                         owl:DatatypeProperty;
                       rdfs:comment "This property represents a maximum upload bandwidth measured in Kbits/s";
                       rdfs:domain net:BandwidthSupport;
                       rdfs:label "Maximum Upload Bandwidth";
                       rdfs:range xsd:int.
net:mcc a owl:FunctionalProperty,
          owl:DatatypeProperty;
        rdfs:comment "This property identifies univoquely the country of a mobile network";
        rdfs:domain net:PLMNetwork;
        rdfs:label "Mobile Country Code";
        rdfs:range xsd:string;
        common:normativeReference "http://www.itu.int/itudoc/itu-t/ob-lists/icc/e212_685.pdf"^^xsd:anyURI.
net:minDownloadBandwith a owl:FunctionalProperty,
                          owl:DatatypeProperty;
                        rdfs:comment "This property represents a minimum download bandwidth that can be offered and measured in Kbits/s";
                        rdfs:domain net:BandwidthSupport;
                        rdfs:label "Minimum Download Bandwidth";
                        rdfs:range xsd:int.
net:minUploadBandwidth a owl:FunctionalProperty,
                         owl:DatatypeProperty;
                       rdfs:comment "This property represents a minimum upload bandwidth that can be offered measured in Kbits/s";
                       rdfs:domain net:BandwidthSupport;
                       rdfs:label "Minimum Upload Bandwidth";
                       rdfs:range xsd:int.
net:mnc a owl:FunctionalProperty,
          owl:DatatypeProperty;
        rdfs:comment """A Mobile Network Code (MNC) is used in combination with a Mobile Country Code (MCC) (also known as a \"MCC / MNC tuple\") to uniquely identify a mobile phone operator/carrier using the GSM, CDMA, iDEN, TETRA and UMTS public land mobile networks and some satellite mobile networks""";
        rdfs:domain net:PLMNetwork;
        rdfs:label "Mobile Network Code";
        rdfs:range xsd:string.
net:networkMode a owl:ObjectProperty;
                rdfs:comment "This property represents the network mode of a Network";
                rdfs:domain net:Network;
                rdfs:label "Network Mode";
                rdfs:range net:NetworkMode.
net:networkSupport a owl:FunctionalProperty,
                     owl:ObjectProperty;
                   rdfs:comment "The network-related characteristics of a device";
                   rdfs:domain dcn:Device;
                   rdfs:label "Network Support";
                   rdfs:range net:NetworkSupport.
net:networkTechnology a owl:FunctionalProperty,
                        owl:ObjectProperty;
                      rdfs:comment "This property holds a network technology";
                      rdfs:domain net:NetworkMode;
                      rdfs:label "Network Technology";
                      rdfs:range net:NetworkTechnology.
net:operationBands a owl:DatatypeProperty;
                   rdfs:comment "The frequencies of operation of a network. Frequencies are expressed in  Mhz";
                   rdfs:domain net:NetworkMode;
                   rdfs:label "Operation Band";
                   rdfs:range xsd:int.
net:preferredNetworkBearer a owl:FunctionalProperty,
                             owl:ObjectProperty;
                           rdfs:comment "This property represents the preferred network bearer for a Network";
                           rdfs:domain net:Network;
                           rdfs:label "Preferred Network Bearer";
                           rdfs:range net:NetworkBearer;
                           rdfs:subPropertyOf net:supportedNetworkBearers.
net:presentNetworks a owl:ObjectProperty;
                    rdfs:comment "The networks that are present in the current Environment";
                    rdfs:domain dcn:Environment;
                    rdfs:label "Present Networks";
                    rdfs:range net:Network.
net:proxy a owl:ObjectProperty;
          rdfs:comment "This property represents one or more proxies that can be present while using a Network Bearer";
          rdfs:domain net:NetworkBearer;
          rdfs:label "Proxy";
          rdfs:range net:HttpProxy;
          rdfs:subPropertyOf dcn:activeComponent.
net:signalStrength a owl:FunctionalProperty,
