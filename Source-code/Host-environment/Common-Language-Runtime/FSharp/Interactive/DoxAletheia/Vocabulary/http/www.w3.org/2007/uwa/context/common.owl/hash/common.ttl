                      common:relatedUAProfEntity "SupportedBluetoothVersion".
hard:builtInMemory a owl:FunctionalProperty,
                     owl:ObjectProperty;
                   rdfs:comment "This property represents the memory built into the device and which is not removable during normal operation";
                   rdfs:domain hard:DeviceHardware;
                   rdfs:label "Built-in Memory";
