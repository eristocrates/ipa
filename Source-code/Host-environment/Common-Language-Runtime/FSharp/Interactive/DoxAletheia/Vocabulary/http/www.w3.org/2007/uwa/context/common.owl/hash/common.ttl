<http://www.w3.org/2007/uwa/context/network.owl#minUploadBandwidth> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                      <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                    rdfs:comment "This property represents a minimum upload bandwidth that can be offered measured in Kbits/s";
                                                                    rdfs:domain <http://www.w3.org/2007/uwa/context/network.owl#BandwidthSupport>;
