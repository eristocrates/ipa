                           rdfs:comment "This property represents the current upload bandwidth offered by a Network Bearer measured in Kbits/s";
                           rdfs:domain net:NetworkBearer;
                           rdfs:label "Current Upload Bandwidth";
                           rdfs:range xsd:int.
net:defaultNetworkBearer a owl:ObjectProperty;
                         rdfs:comment "This property represents the default Network Bearer for a Device";
