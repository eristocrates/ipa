                                                                   rdfs:label "Connected Networks";
                                                                   rdfs:range <http://www.w3.org/2007/uwa/context/network.owl#Network>.
<http://www.w3.org/2007/uwa/context/network.owl#currentDownloadBandwidth> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                            <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                          rdfs:comment "This property represents the current download bandwidth offered by a network bearer measured in Kbits/s";
                                                                          rdfs:domain <http://www.w3.org/2007/uwa/context/network.owl#NetworkBearer>;
                                                                          rdfs:label "Current Download Bandwidth";
                                                                          rdfs:range xsd:int.
<http://www.w3.org/2007/uwa/context/network.owl#currentUploadBandwidth> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                          <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                        rdfs:comment "This property represents the current upload bandwidth offered by a Network Bearer measured in Kbits/s";
                                                                        rdfs:domain <http://www.w3.org/2007/uwa/context/network.owl#NetworkBearer>;
