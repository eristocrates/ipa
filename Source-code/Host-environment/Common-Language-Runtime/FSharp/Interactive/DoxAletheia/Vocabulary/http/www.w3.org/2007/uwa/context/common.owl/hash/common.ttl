common:AllDisjointSet a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "This is an utility class for representing groups of classes that are pairwise disjoint, following the approach specified by the OWL Abstract Syntax. This class has been created as a workaround to the absence in OWL 1 of an specific construct for establishing class disjointness between groups of classes";
                      rdfs:label "All Disjoint Set";
