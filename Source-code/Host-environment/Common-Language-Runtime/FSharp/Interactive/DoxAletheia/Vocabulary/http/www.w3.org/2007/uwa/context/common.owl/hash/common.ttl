<http://www.w3.org/2007/uwa/context/push.owl#maxMmsMessageSize> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                rdfs:comment "The maximum size of an interchanged message in byes";
