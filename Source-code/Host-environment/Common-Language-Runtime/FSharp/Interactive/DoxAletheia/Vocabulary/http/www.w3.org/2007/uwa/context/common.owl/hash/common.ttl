                     common:relatedUAProfEntity "CPUMaximumFrequency".
hard:meid a owl:FunctionalProperty,
            owl:DatatypeProperty;
          rdfs:comment "Mobile Equipment Identifier (MEID) is a globally unique number identifying a physical piece of CDMA mobile station equipment. The number format is defined by the 3GPP2 standard S.R0048 but in practical terms, it can be seen as an IMEI but with hexadecimal digits";
          rdfs:domain dcn:Device;
          rdfs:label "MEID";
          rdfs:range xsd:string;
          rdfs:subPropertyOf hard:deviceIdentifier.
hard:memory a owl:ObjectProperty;
            rdfs:comment "This property represents the hardware memory component/s of a device";
