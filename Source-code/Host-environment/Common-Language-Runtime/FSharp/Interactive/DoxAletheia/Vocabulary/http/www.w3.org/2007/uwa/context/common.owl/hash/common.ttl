web:XmlHttpRequest a web:WebBrowserApi;
                   rdfs:comment "XMLHttpRequest";
                   common:id "http://www.w3.org/TR/2008/WD-XMLHttpRequest-20080415/";
                   common:name "XMLHttpRequest Level 1";
                   common:normativeStatus common:Utility;
                   common:normativeURI "tp://www.w3.org/TR/2008/WD-XMLHttpRequest-20080415/"^^xsd:anyURI.
web:availableWREs a owl:ObjectProperty;
                  rdfs:comment "This property represents the Web Runtime Environments which are available on a device";
                  rdfs:domain soft:DeviceSoftware;
                  rdfs:label "Available Web Runtime Environments";
                  rdfs:range web:WebRuntime;
                  rdfs:subPropertyOf common:available,
                                     dcn:component.
web:cHTML a web:PageMarkup;
          rdfs:comment "Compact HTML";
          common:name "cHTML";
          common:version "1";
          web:publicIdentifier "-//W3C//DTD Compact HTML 1.0 Draft//EN".
web:cacheSize a owl:FunctionalProperty,
                owl:DatatypeProperty;
              rdfs:comment "The size of the cache (in bytes) implemented by the browser";
              rdfs:domain web:WebBrowserFeatures;
              rdfs:label "Cache Size";
              rdfs:range xsd:unsignedLong.
web:defaultWRE a owl:ObjectProperty;
               rdfs:comment "This property represents the default Web Runtime Environment on a device";
               rdfs:label "Default Web Runtime Environment";
               rdfs:subPropertyOf web:availableWREs.
web:defaultWebBrowser a owl:FunctionalProperty,
                        owl:ObjectProperty;
                      rdfs:comment "The default Web Browser in a device";
                      rdfs:domain soft:DeviceSoftware;
                      rdfs:label "Default Web Browser";
                      rdfs:range web:WebBrowser;
                      rdfs:subPropertyOf dcn:defaultComponent,
                                         soft:availableUserAgents.
web:i-HTML_7_0 a web:PageMarkup;
               rdfs:comment "Other i-Mode steps can be easily added";
               common:name "i-HTML7.0";
               common:version "7.0".
web:i-XHTML_1_0 a web:PageMarkup,
                  soft:XmlFormat;
                rdfs:comment "Japanese i-XHTML 1.0";
                common:name "i-XHTML";
                common:version "1.0";
                web:publicIdentifier "-//i-mode group (ja)//DTD XHTML i-XHTML(Locale/Ver.=ja/1.0) 1.0//EN".
web:javascriptEnabled a owl:FunctionalProperty,
                        owl:DatatypeProperty;
                      rdfs:comment "This property indicates whether Javascript is enabled or not in the web browser";
                      rdfs:domain web:WebBrowser;
                      rdfs:label "Javascript Enabled";
                      rdfs:range xsd:boolean.
web:markupModules a owl:ObjectProperty;
                  rdfs:comment "The modules used by a markup language";
                  rdfs:domain web:PageMarkup;
                  rdfs:label "Markup Modules";
                  rdfs:range web:MarkupModule.
web:maxCacheObjectSize a owl:FunctionalProperty,
                         owl:DatatypeProperty;
                       rdfs:comment "The maximum size of an object in the browser cache in bytes";
                       rdfs:domain web:WebBrowserFeatures;
                       rdfs:label "Maximum Cache Object Size";
                       rdfs:range xsd:unsignedLong.
web:maxDownloadableObjectSize a owl:FunctionalProperty,
                                owl:DatatypeProperty;
                              rdfs:comment "Maximum size in bytes for content (image, ringtone, etc.) downloaded via web browser";
                              rdfs:domain web:WebBrowserFeatures;
                              rdfs:label "Maximum Downloadable Object Size";
                              rdfs:range xsd:unsignedLong.
web:maxEmbeddedObjectSize a owl:FunctionalProperty,
                            owl:DatatypeProperty;
                          rdfs:comment "Maximum size in bytes for media embedded in web pages";
                          rdfs:domain web:WebBrowserFeatures;
                          rdfs:label "Maximum Embedded Object Size";
                          rdfs:range xsd:unsignedLong.
web:maxTotalPageWeight a owl:FunctionalProperty,
                         owl:DatatypeProperty;
                       rdfs:comment "The maximum page weight in bytes supported by a browser (this includes the markup and all the possible referenced objects in the page) such as images, styleSheets, script files, etc";
                       rdfs:domain web:WebBrowserFeatures;
                       rdfs:label "Maximum Total Page Weight";
                       rdfs:range xsd:unsignedLong;
                       common:relatedUAProfEntity "WmlDeckSize".
web:publicIdentifier a owl:FunctionalProperty,
                       owl:DatatypeProperty;
                     rdfs:comment "The public identifier of an XML format or module";
                     rdfs:domain [owl:unionOf (web:MarkupModule
                                               web:PageMarkup) ; 
                                  a owl:Class];
                     rdfs:label "Public Identifier";
                     rdfs:range xsd:string;
                     rdfs:subPropertyOf common:id.
web:rendersTables a owl:FunctionalProperty,
                    owl:DatatypeProperty;
                  rdfs:comment "This property indicates whether the browser renders tables or not";
                  rdfs:domain web:WebBrowserFeatures;
                  rdfs:label "Renders Tables";
                  rdfs:range xsd:boolean.
web:showsAcessKeys a owl:FunctionalProperty,
                     owl:DatatypeProperty;
                   rdfs:comment "This property indicates whether the browser displays automatically the character associated to access keys  or not";
                   rdfs:domain web:WebBrowserFeatures;
                   rdfs:label "Shows Access Keys";
                   rdfs:range xsd:boolean.
web:showsPageTitle a owl:FunctionalProperty,
                     owl:DatatypeProperty;
                   rdfs:comment "Indicates whether the browser displays the title of the current page or not";
                   rdfs:domain web:WebBrowserFeatures;
                   rdfs:label "Shows Page Title";
                   rdfs:range xsd:boolean.
web:supportsAccessKeys a owl:FunctionalProperty,
                         owl:DatatypeProperty;
                       rdfs:comment "This property indicates whether the browser supports access keys or not";
                       rdfs:domain web:WebBrowserFeatures;
                       rdfs:label "Supports Access Keys";
                       rdfs:range xsd:boolean.
web:supportsCookies a owl:FunctionalProperty,
                      owl:DatatypeProperty;
                    rdfs:comment "This property indicates whether the browser supports cookies or not";
                    rdfs:domain web:WebBrowserFeatures;
                    rdfs:label "Supports Cookies";
                    rdfs:range xsd:boolean;
                    common:relatedDDRCoreVoc "cookieSupport".
