owl:Thing rdfs:comment "".
common:AllDisjointSet a owl:Class;
                      rdfs:comment "This is an utility class for representing groups of classes that are pairwise disjoint, following the approach specified by the OWL Abstract Syntax. This class has been created as a workaround to the absence in OWL 1 of an specific construct for establishing class disjointness between groups of classes";
                      rdfs:label "All Disjoint Set";
                      rdfs:subClassOf [owl:unionOf ([owl:onProperty common:disjointClass ; 
                                                    owl:minCardinality "1"^^xsd:int ; 
                                                    a owl:Restriction]
                                                    [owl:someValuesFrom common:AllDisjointSet ; 
                                                    owl:onProperty common:disjointSet ; 
                                                    a owl:Restriction]) ; 
                                       a owl:Class],
                                      dcn:Associated_Entity;
                      common:informativeReference "http://www.w3.org/TR/2004/REC-owl-semantics-20040210/syntax.html#2.3.2.1";
                      common:normativeStatus common:Utility.
common:ApplicationProtocol a owl:Class;
                           rdfs:comment "This class represents application-level protocols";
                           rdfs:label "Application Protocol";
                           rdfs:subClassOf [owl:onProperty common:id ; 
                                            owl:cardinality "1"^^xsd:int ; 
                                            a owl:Restriction],
                                           common:Context_CommonEntity;
                           common:relatedUAProfEntity "Push-SupportedBearers".
common:ApplicationProtocol_21 a common:ApplicationProtocol;
                              rdfs:comment "W-HTTP";
                              common:id "__W-HTTP";
                              common:name "W-HTTP";
                              common:normativeStatus common:Utility.
