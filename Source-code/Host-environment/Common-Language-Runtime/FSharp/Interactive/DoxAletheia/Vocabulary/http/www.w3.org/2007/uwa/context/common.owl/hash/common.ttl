         rdfs:range xsd:string;
         rdfs:subPropertyOf common:id.
java:maxHeapSize a owl:FunctionalProperty,
                   owl:DatatypeProperty;
                 rdfs:comment "The maximum heap size in bytes supported by a Java Runtime Environment";
                 rdfs:domain java:JavaRuntimeEnvironment;
                 rdfs:label "Maximum Heap Size";
                 rdfs:range xsd:unsignedLong.
java:maxJarSize a owl:FunctionalProperty,
                  owl:DatatypeProperty;
                rdfs:comment "The maximum JAR size for a Java Application supported by a Java Runtime Environment";
                rdfs:domain java:JavaRuntimeEnvironment;
                rdfs:label "Maximum JAR size";
