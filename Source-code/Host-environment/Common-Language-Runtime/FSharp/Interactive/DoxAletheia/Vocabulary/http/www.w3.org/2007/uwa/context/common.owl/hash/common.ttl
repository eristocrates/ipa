                                                                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2007/uwa/context/location.owl#geoReferenceSystem> ; 
                                                                                    <http://www.w3.org/2002/07/owl#hasValue> <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinateRS_WGS84> ; 
                                                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                                   [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2007/uwa/context/location.owl#latitude> ; 
                                                                                    <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:int ; 
                                                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                                   [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2007/uwa/context/location.owl#longitude> ; 
                                                                                    <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:int ; 
                                                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                                   [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2007/uwa/context/location.owl#datum> ; 
                                                                                    <http://www.w3.org/2002/07/owl#hasValue> "WGS84" ; 
                                                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                                   <http://www.w3.org/2007/uwa/context/location.owl#GeoCoordinates>.
<http://www.w3.org/2007/uwa/context/location.owl#altitude> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                             <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                           rdfs:comment "The altitude as defined by the WGS84 coordinate system";
