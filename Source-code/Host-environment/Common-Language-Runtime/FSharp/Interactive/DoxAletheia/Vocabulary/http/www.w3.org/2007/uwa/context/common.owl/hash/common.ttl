<http://www.w3.org/2007/uwa/context/network.owl#signalStrength> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                rdfs:comment "This property indicates the relative (from 0 to 100) signal strength offered by a Network in this Context";
