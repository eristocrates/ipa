                                       [owl:onProperty common:name ; 
                                        owl:cardinality "1"^^xsd:int ; 
                                        a owl:Restriction],
                                       [owl:onProperty common:version ; 
                                        owl:maxCardinality "1"^^xsd:int ; 
                                        a owl:Restriction],
                                       java:Context_JavaEntity.
java:J2meOptionalPackage a owl:Class;
                         rdfs:comment "This class represents standard optional packages that can run ina J2ME runtime environment";
                         rdfs:label "J2ME Standard Optional Package";
                         rdfs:subClassOf [owl:onProperty java:jsr ; 
                                          owl:cardinality "1"^^xsd:int ; 
                                          a owl:Restriction],
                                         soft:Api,
                                         java:Context_JavaEntity.
java:J2meProfile a owl:Class;
                 rdfs:comment "This class represents J2ME Profiles";
                 rdfs:label "J2ME Profile";
                 rdfs:subClassOf [owl:onProperty common:name ; 
                                  owl:cardinality "1"^^xsd:int ; 
                                  a owl:Restriction],
                                 [owl:onProperty common:version ; 
                                  owl:maxCardinality "1"^^xsd:int ; 
                                  a owl:Restriction],
                                 [owl:onProperty java:jsr ; 
                                  owl:cardinality "1"^^xsd:int ; 
                                  a owl:Restriction],
                                 java:Context_JavaEntity;
                 common:relatedUAProfEntity "JavaPlatform".
java:J2meRuntimeEnvironment a owl:Class;
                            rdfs:comment "This class represents a J2ME runtime environment";
