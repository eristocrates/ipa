<http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice_QWERTY_KEYBOARD> a <http://www.w3.org/2007/uwa/context/hardware.owl#Keyboard>;
                                                                              rdfs:comment "Represents a full alphanumeric keyboard";
                                                                              rdfs:label "Qwerty Keyboard";
                                                                              common:id "__InputDevice_QwertyKeyboard";
                                                                              common:normativeStatus common:Normative.
<http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice_STYLUS> a <http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice>;
                                                                     rdfs:comment "Represents a stylus";
                                                                     rdfs:label "Stylus";
                                                                     common:id "__InputDevice_Stylus";
                                                                     common:normativeStatus common:Normative.
<http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice_TOUCH_SCREEN> a <http://www.w3.org/2007/uwa/context/hardware.owl#TactileDisplay>;
                                                                           rdfs:comment "Touch screen that allows pointing to an area on the screen";
                                                                           rdfs:label "Touch Screen";
                                                                           common:id "__InputDevice_TouchScreen";
                                                                           common:normativeStatus common:Normative.
<http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice_TRACK_BALL> a <http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice>;
                                                                         rdfs:comment "A little sphere that acts like a trackball mouse";
                                                                         rdfs:label "Track Ball";
                                                                         common:id "__InputDevice_TrackBall";
                                                                         common:normativeStatus common:Normative.
<http://www.w3.org/2007/uwa/context/hardware.owl#Keyboard> a <http://www.w3.org/2002/07/owl#Class>;
                                                           rdfs:comment "This class represents a keyboard in a device";
                                                           rdfs:label "Keyboard";
                                                           rdfs:subClassOf <http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice>.
<http://www.w3.org/2007/uwa/context/hardware.owl#MemoryCard> a <http://www.w3.org/2002/07/owl#Class>;
                                                             rdfs:comment "This class represents a storage card which can be attached to a device";
                                                             rdfs:label "Memory Card";
                                                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2007/uwa/context/hardware.owl#volatile> ; 
                                                                              <http://www.w3.org/2002/07/owl#hasValue> false ; 
                                                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                             <http://www.w3.org/2007/uwa/context/hardware.owl#MemoryUnit>.
<http://www.w3.org/2007/uwa/context/hardware.owl#MemoryUnit> a <http://www.w3.org/2002/07/owl#Class>;
                                                             rdfs:comment "This class represents some memory used in a device. It might, for example, be built-in memory that is part of the device, or it might be removable memory on some form of storage card";
                                                             rdfs:label "Memory Unit";
                                                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2007/uwa/context/hardware.owl#size> ; 
                                                                              <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:int ; 
                                                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                             <http://www.w3.org/2007/uwa/context/hardware.owl#HardwareComponent>.
<http://www.w3.org/2007/uwa/context/hardware.owl#Microphone> a <http://www.w3.org/2002/07/owl#Class>;
                                                             rdfs:comment "This class represents a microphone in a device";
                                                             rdfs:label "Microphone";
                                                             rdfs:subClassOf <http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice>.
<http://www.w3.org/2007/uwa/context/hardware.owl#NfcHardware> a <http://www.w3.org/2002/07/owl#Class>;
                                                              rdfs:comment "This class represents the NFC hardware on a device";
                                                              rdfs:label "NFC Hardware";
                                                              rdfs:subClassOf <http://www.w3.org/2007/uwa/context/hardware.owl#HardwareComponent>.
<http://www.w3.org/2007/uwa/context/hardware.owl#OutputDevice> a <http://www.w3.org/2002/07/owl#Class>;
                                                               rdfs:comment "This class represents an output mechanism that can be available in a device";
                                                               rdfs:label "Output Device";
                                                               rdfs:subClassOf <http://www.w3.org/2007/uwa/context/hardware.owl#HardwareComponent>.
<http://www.w3.org/2007/uwa/context/hardware.owl#PointingResolution> a <http://www.w3.org/2002/07/owl#Class>;
                                                                     rdfs:comment "This class represents the precision with which the pointing can be achieved on a  device";
                                                                     rdfs:label "Pointing Resolution";
                                                                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> common:id ; 
                                                                                      <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:int ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                                     <http://www.w3.org/2007/uwa/context/hardware.owl#Context_HardwareEntity>;
                                                                     common:relatedUAProfEntity "PointingResolution".
<http://www.w3.org/2007/uwa/context/hardware.owl#PointingResolution_CHAR> a <http://www.w3.org/2007/uwa/context/hardware.owl#PointingResolution>;
                                                                          rdfs:comment "The pointing device can select an individual character";
                                                                          rdfs:label "Character Pointing Resolution";
                                                                          common:id "__PointingResolution_Character";
                                                                          common:name "character";
                                                                          common:normativeStatus common:Normative.
<http://www.w3.org/2007/uwa/context/hardware.owl#PointingResolution_LINE> a <http://www.w3.org/2007/uwa/context/hardware.owl#PointingResolution>;
                                                                          rdfs:comment "The pointing device can select a line of text";
                                                                          rdfs:label "Line Pointing Resolution";
                                                                          common:id "__PointingResolution_Line";
                                                                          common:name "line";
                                                                          common:normativeStatus common:Normative.
<http://www.w3.org/2007/uwa/context/hardware.owl#PointingResolution_PIXEL> a <http://www.w3.org/2007/uwa/context/hardware.owl#PointingResolution>;
                                                                           rdfs:comment "The pointing device can select an individual pixel";
                                                                           rdfs:label "Pixel Pointing Resolution";
                                                                           common:id "__PointingResolution_Pixel";
                                                                           common:name "pixel";
                                                                           common:normativeStatus common:Normative.
<http://www.w3.org/2007/uwa/context/hardware.owl#Sibling_Disjoint> a common:AllDisjointSet;
                                                                   common:disjointClass "hard:BluetoothProfile",
                                                                                        "hard:PointingResolution",
                                                                                        "hard:BluetoothStatus",
                                                                                        "hard:HardwareStatus".
<http://www.w3.org/2007/uwa/context/hardware.owl#Sibling_Disjoint2> a common:AllDisjointSet;
                                                                    common:disjointClass "hard:NfcHardware",
                                                                                         "hard:Display",
                                                                                         "hard:BluetoothHardware",
                                                                                         "hard:Camera",
                                                                                         "hard:WiFiHardware",
                                                                                         "hard:Microphone",
                                                                                         "hard:DeviceHardware",
                                                                                         "hard:Battery",
                                                                                         "hard:CPU",
                                                                                         "hard:MemoryUnit",
                                                                                         "hard:Speaker",
                                                                                         "hard:CellularHardware";
                                                                    common:disjointSet <http://www.w3.org/2007/uwa/context/hardware.owl#Sibling_Disjoint>.
<http://www.w3.org/2007/uwa/context/hardware.owl#Speaker> a <http://www.w3.org/2002/07/owl#Class>;
                                                          rdfs:comment "This class represents a speaker component in a device";
                                                          rdfs:label "Speaker";
                                                          rdfs:subClassOf <http://www.w3.org/2007/uwa/context/hardware.owl#OutputDevice>.
<http://www.w3.org/2007/uwa/context/hardware.owl#TactileDisplay> a <http://www.w3.org/2002/07/owl#Class>;
                                                                 rdfs:comment "A display that is tac-sensitive, allowing users to interact directly with the objects shown on the screen";
                                                                 rdfs:label "Tactile Display";
                                                                 rdfs:subClassOf <http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice>,
                                                                                 <http://www.w3.org/2007/uwa/context/hardware.owl#Display>.
<http://www.w3.org/2007/uwa/context/hardware.owl#TermGroup_Hardware> a common:TermGroup;
                                                                     rdfs:comment "A group of terms with properties, classes and instances that model the hardware elements of a Delivery Context";
                                                                     rdfs:label "Hardware";
                                                                     common:normativeStatus common:Utility;
                                                                     common:termGroupPrefix "hard".
<http://www.w3.org/2007/uwa/context/hardware.owl#WiFiHardware> a <http://www.w3.org/2002/07/owl#Class>;
                                                               rdfs:comment "This class represents  hardware in a device that can be used to access to WiFi networks";
                                                               rdfs:label "WiFi Hardware";
                                                               rdfs:subClassOf <http://www.w3.org/2007/uwa/context/hardware.owl#HardwareComponent>.
<http://www.w3.org/2007/uwa/context/hardware.owl#availableSize> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                rdfs:comment "This property represents the amount of memory available for use, in bytes";
                                                                rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#MemoryUnit>;
                                                                rdfs:label "Available Memory Size";
                                                                rdfs:range xsd:unsignedLong.
<http://www.w3.org/2007/uwa/context/hardware.owl#battery> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                          rdfs:comment "This property represents one or more batteries in a device";
                                                          rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#DeviceHardware>;
                                                          rdfs:label "Battery";
                                                          rdfs:range <http://www.w3.org/2007/uwa/context/hardware.owl#Battery>;
                                                          rdfs:subPropertyOf <http://www.w3.org/2007/uwa/context/hardware.owl#hardwareComponent>.
<http://www.w3.org/2007/uwa/context/hardware.owl#batteryBeingCharged> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                        <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                      rdfs:comment "This property indicates whether the battery is currently being charged or not";
                                                                      rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#Battery>;
                                                                      rdfs:label "Battery Being Charged";
                                                                      rdfs:range xsd:boolean.
<http://www.w3.org/2007/uwa/context/hardware.owl#batteryCapacity> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                    <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                  rdfs:comment "The capacity of a battery, as an amount of electric charge that it can store, measured in ampere-hours";
                                                                  rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#Battery>;
                                                                  rdfs:label "Battery Capacity";
                                                                  rdfs:range xsd:float.
<http://www.w3.org/2007/uwa/context/hardware.owl#batteryLevel> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                 <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                               rdfs:comment "This property holds the percentage of the battery capacity that remains available";
                                                               rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#Battery>;
                                                               rdfs:label "Battery Level";
                                                               rdfs:range xsd:int.
<http://www.w3.org/2007/uwa/context/hardware.owl#bluetoothAddress> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                     <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                   rdfs:comment "The Bluetooth address of the device represented in hexadecimal format. he Bluetooth address will be 12 characters long. Valid characters are 0-9 and A-F";
                                                                   rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#BluetoothHardware>;
                                                                   rdfs:label "Bluetooth Address";
                                                                   rdfs:range xsd:string.
<http://www.w3.org/2007/uwa/context/hardware.owl#bluetoothName> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                rdfs:comment "The Bluetooth friendly name of the device";
                                                                rdfs:domain <http://www.w3.org/2007/uwa/context/deliverycontext.owl#Device>;
                                                                rdfs:label "Bluetooth Friendly Name";
                                                                rdfs:range xsd:string.
<http://www.w3.org/2007/uwa/context/hardware.owl#bluetoothStatus> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                    <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                  rdfs:comment "This property indicates the Bluetooth Status of a device";
                                                                  rdfs:domain <http://www.w3.org/2007/uwa/context/deliverycontext.owl#Device>;
                                                                  rdfs:label "Bluetooth Status";
                                                                  rdfs:range <http://www.w3.org/2007/uwa/context/hardware.owl#BluetoothStatus>.
<http://www.w3.org/2007/uwa/context/hardware.owl#bluetoothVersion> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                   rdfs:comment "This property represents the version/s of Bluetooth supported";
                                                                   rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#DeviceHardware>;
                                                                   rdfs:label "Supported Bluetooth Version";
                                                                   rdfs:range xsd:string;
                                                                   common:relatedUAProfEntity "SupportedBluetoothVersion".
<http://www.w3.org/2007/uwa/context/hardware.owl#builtInMemory> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                  <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                rdfs:comment "This property represents the memory built into the device and which is not removable during normal operation";
                                                                rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#DeviceHardware>;
                                                                rdfs:label "Built-in Memory";
                                                                rdfs:range <http://www.w3.org/2007/uwa/context/hardware.owl#MemoryUnit>;
                                                                rdfs:subPropertyOf <http://www.w3.org/2007/uwa/context/hardware.owl#memory>.
<http://www.w3.org/2007/uwa/context/hardware.owl#colorDepth> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                               <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                             rdfs:comment "Count the number of bits used for color definition";
                                                             rdfs:label "Color Depth";
                                                             rdfs:range xsd:int;
                                                             common:relatedDDRCoreVoc "displayColorDepth";
                                                             common:relatedUAProfEntity "BitsPerPixel".
<http://www.w3.org/2007/uwa/context/hardware.owl#cpu> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                      rdfs:comment "This property represents a CPU for a device";
                                                      rdfs:label "CPU";
                                                      rdfs:subPropertyOf <http://www.w3.org/2007/uwa/context/hardware.owl#hardwareComponent>.
<http://www.w3.org/2007/uwa/context/hardware.owl#currentOrientation> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                       <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                     rdfs:comment "This property represents the current orientation of a display";
                                                                     rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#Display>;
                                                                     rdfs:label "Orientation";
                                                                     rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> ("0"^^xsd:int
                                                                                                                        "90"^^xsd:int
                                                                                                                        "-90"^^xsd:int
                                                                                                                        "180"^^xsd:int) ; 
                                                                                 a <http://www.w3.org/2002/07/owl#DataRange>];
                                                                     rdfs:subPropertyOf <http://www.w3.org/2007/uwa/context/hardware.owl#supportedOrientations>.
<http://www.w3.org/2007/uwa/context/hardware.owl#deviceHardware> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                   <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                 rdfs:comment "This property represents the hardware associated with a device";
                                                                 rdfs:domain <http://www.w3.org/2007/uwa/context/deliverycontext.owl#Device>;
                                                                 rdfs:label "Device Hardware";
                                                                 rdfs:range <http://www.w3.org/2007/uwa/context/hardware.owl#DeviceHardware>.
<http://www.w3.org/2007/uwa/context/hardware.owl#deviceIdentifier> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                     <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                   rdfs:comment "Identifies univoquely a device";
                                                                   rdfs:domain <http://www.w3.org/2007/uwa/context/deliverycontext.owl#Device>;
                                                                   rdfs:label "Device Identifier";
                                                                   rdfs:range xsd:string;
                                                                   rdfs:subPropertyOf common:id.
<http://www.w3.org/2007/uwa/context/hardware.owl#display> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                          rdfs:comment "This property represents a display associated with a device";
                                                          rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#DeviceHardware>;
                                                          rdfs:label "Display";
                                                          rdfs:range <http://www.w3.org/2007/uwa/context/hardware.owl#Display>;
                                                          rdfs:subPropertyOf <http://www.w3.org/2007/uwa/context/hardware.owl#hardwareComponent>.
<http://www.w3.org/2007/uwa/context/hardware.owl#extensionMemory> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                  rdfs:comment "This property identifies additional memory that is provided to a device, typically in the form of removable memory cards";
                                                                  rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#DeviceHardware>;
                                                                  rdfs:label "Extension Memory";
                                                                  rdfs:range <http://www.w3.org/2007/uwa/context/hardware.owl#MemoryUnit>;
                                                                  rdfs:subPropertyOf <http://www.w3.org/2007/uwa/context/hardware.owl#memory>.
<http://www.w3.org/2007/uwa/context/hardware.owl#hardwareComponent> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                    rdfs:comment "This property represents a hardware component";
                                                                    rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#DeviceHardware>;
                                                                    rdfs:label "Hardware Component";
                                                                    rdfs:range <http://www.w3.org/2007/uwa/context/hardware.owl#HardwareComponent>;
                                                                    rdfs:subPropertyOf <http://www.w3.org/2007/uwa/context/deliverycontext.owl#component>.
<http://www.w3.org/2007/uwa/context/hardware.owl#height> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                           <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                         rdfs:comment "The total height of something as a linear measure in centimeters";
                                                         rdfs:label "Height";
                                                         rdfs:range xsd:float.
<http://www.w3.org/2007/uwa/context/hardware.owl#imei> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                         <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                       rdfs:comment "The International Mobile Equipment Identity or IMEI is a number unique to every GSM and UMTS mobile phone.";
                                                       rdfs:domain <http://www.w3.org/2007/uwa/context/deliverycontext.owl#Device>;
                                                       rdfs:label "IMEI";
                                                       rdfs:range xsd:string;
                                                       rdfs:subPropertyOf <http://www.w3.org/2007/uwa/context/hardware.owl#deviceIdentifier>.
<http://www.w3.org/2007/uwa/context/hardware.owl#inputCharacterSets> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                     rdfs:comment "This property defines the character sets supported by the device for input";
                                                                     rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#DeviceHardware>;
                                                                     rdfs:label "Input Character Sets";
                                                                     rdfs:range common:CharacterSet;
                                                                     rdfs:subPropertyOf common:supports;
                                                                     common:relatedUAProfEntity "InputCharSet".
<http://www.w3.org/2007/uwa/context/hardware.owl#inputDevice> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                              rdfs:comment "The input mechanisms supported by a device";
                                                              rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#DeviceHardware>;
                                                              rdfs:label "Input Devices";
                                                              rdfs:range <http://www.w3.org/2007/uwa/context/hardware.owl#InputDevice>;
                                                              rdfs:subPropertyOf common:supports;
                                                              common:relatedDDRCoreVoc "inputDevices";
                                                              common:relatedUAProfEntity "Keyboard".
<http://www.w3.org/2007/uwa/context/hardware.owl#isTethered> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                               <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                             rdfs:comment """This property states whether this Device is actuating \"tethered\" to another Device, giving the latter some kind of wireless connection""";
                                                             rdfs:domain <http://www.w3.org/2007/uwa/context/deliverycontext.owl#Device>;
                                                             rdfs:label "Tethered";
                                                             rdfs:range xsd:boolean.
<http://www.w3.org/2007/uwa/context/hardware.owl#maxCpuFrequency> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                    <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                  rdfs:comment "Processor maximum speed";
                                                                  rdfs:domain <http://www.w3.org/2007/uwa/context/hardware.owl#CPU>;
                                                                  rdfs:label "CPU Maximum Frequency";
                                                                  rdfs:range xsd:int;
                                                                  common:relatedUAProfEntity "CPUMaximumFrequency".
<http://www.w3.org/2007/uwa/context/hardware.owl#meid> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                         <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                       rdfs:comment "Mobile Equipment Identifier (MEID) is a globally unique number identifying a physical piece of CDMA mobile station equipment. The number format is defined by the 3GPP2 standard S.R0048 but in practical terms, it can be seen as an IMEI but with hexadecimal digits";
                                                       rdfs:domain <http://www.w3.org/2007/uwa/context/deliverycontext.owl#Device>;
                                                       rdfs:label "MEID";
