hard:thickness a owl:FunctionalProperty,
                 owl:DatatypeProperty;
               rdfs:comment "The thickness of something measured in centimeters";
               rdfs:label "Thickness";
               rdfs:range xsd:float.
hard:volatile a owl:FunctionalProperty,
                owl:DatatypeProperty;
              rdfs:comment "This property indicates if the memory unit is volatile or not";
              rdfs:domain hard:MemoryUnit;
              rdfs:label "Volatile";
              rdfs:range xsd:boolean.
hard:volumeLevel a owl:FunctionalProperty,
                   owl:DatatypeProperty;
