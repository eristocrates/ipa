                  common:languageCode "eng";
                  common:languageTag "en-US";
                  common:normativeStatus common:Utility.
common:Feature a owl:Class;
               rdfs:comment "This class represents features, which are distinguishing characteristics of an item";
               rdfs:label "Feature";
               rdfs:subClassOf [owl:onProperty common:id ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty common:name ; 
                                owl:minCardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               common:Context_CommonEntity.
common:FeatureRestriction a owl:Class;
                          rdfs:comment "This class represents feature restrictions related to an implementation";
                          rdfs:label "Feature Restriction";
                          rdfs:subClassOf [owl:onProperty common:name ; 
                                           owl:minCardinality "1"^^xsd:int ; 
                                           a owl:Restriction],
                                          [owl:onProperty common:id ; 
                                           owl:cardinality "1"^^xsd:int ; 
                                           a owl:Restriction],
                                          common:Context_CommonEntity.
common:Informative a common:NormativeStatus;
                   rdfs:comment """This instance represents an \"informative\" status""";
                   rdfs:label "Informative";
                   common:normativeStatus common:Utility.
common:InputModality a owl:Class;
                     rdfs:comment "This class represents input modalities";
                     rdfs:label "Input Modality";
                     rdfs:subClassOf common:Modality.
common:InputModality_GESTURE a common:InputModality;
                             rdfs:comment "Modality that consists of the realization of gestures to input information or commands to the system";
                             rdfs:label "Gesture Input Modality";
                             common:id "__InputModality_Gesture";
                             common:name "Gesture";
                             common:normativeStatus common:Normative.
common:InputModality_TACTILE a common:InputModality;
                             rdfs:comment "An input modality in which information is entered by touching some sensor or device";
                             rdfs:label "Tactile Input Modality";
                             common:id "__InputModality_TACTILE";
                             common:name "Tactile";
                             common:normativeStatus common:Normative.
common:InputModality_TYPING a common:InputModality;
                            rdfs:comment "An input modality in whoch the user enters information by typing using a keyboard or similar";
                            rdfs:label "Typing Input Modality";
                            common:id "__InputModality_Typing";
                            common:name "Typing";
                            common:normativeStatus common:Normative.
common:InputModality_VOICE a common:InputModality;
                           rdfs:comment "Modality that consists of input introduction by means of voice";
                           rdfs:label "Voice Input Modality";
                           common:id "__InputModality_Voice";
                           common:name "Voice";
                           common:normativeStatus common:Normative.
common:Language a owl:Class;
                rdfs:comment "This class represents languages";
                rdfs:label "Language";
                rdfs:subClassOf [owl:onProperty common:languageCode ; 
                                 owl:maxCardinality "1"^^xsd:int ; 
                                 a owl:Restriction],
                                [owl:onProperty common:languageTag ; 
                                 owl:cardinality "1"^^xsd:int ; 
                                 a owl:Restriction],
                                common:Context_CommonEntity.
common:MIME_TYPE_GIF a common:ContentType;
                     common:contentTypeName "image/gif";
                     common:normativeStatus common:Utility.
common:Modality a owl:Class;
                rdfs:comment "This class represents modalities, the type of communication channel used for interaction. It also covers the way an idea is expressed or perceived, or the manner in which an action is performed.";
                rdfs:label "Modality";
                rdfs:subClassOf [owl:onProperty common:id ; 
                                 owl:cardinality "1"^^xsd:int ; 
                                 a owl:Restriction],
                                common:Context_CommonEntity;
                common:informativeReference "http://www.w3.org/TR/2003/NOTE-mmi-reqs-20030108/#modality".
common:Normative a common:NormativeStatus;
                 rdfs:comment """This isntance represents a \"normative\" status""";
                 rdfs:label "Normative";
                 common:normativeStatus common:Utility.
common:NormativeStatus a owl:Class;
                       rdfs:comment "This class represents the normative status of an entity in the ontology. It is used  as an auxiliary element for automatic documentation generation";
                       rdfs:label "Normative Status";
                       rdfs:subClassOf [owl:oneOf (common:Normative
                                                   common:Informative
                                                   common:Utility) ; 
                                        a owl:Class],
                                       dcn:Associated_Entity;
                       common:normativeStatus common:Utility.
common:OutputModality a owl:Class;
                      rdfs:comment "This class represents output modalities";
                      rdfs:label "Output Modality";
                      rdfs:subClassOf common:Modality.
common:OutputModality_AURAL a common:OutputModality;
                            rdfs:comment "This modality indicates the ability to use audio as an output modality";
                            rdfs:label "Aural Output Modality";
                            common:id "__OutputModality_Aural";
                            common:name "Aural";
                            common:normativeStatus common:Normative.
common:OutputModality_TACTILE a common:OutputModality;
                              rdfs:comment "This is a tactile modality in which user receives information from the system by means of the tac";
                              rdfs:label "Tactile Output Modality";
                              common:id "__OutputModality_Tactile";
                              common:name "Tactile";
                              common:normativeStatus common:Normative.
common:OutputModality_VISUAL a common:OutputModality;
                             rdfs:comment "This is an output modality in which information is perceived visually by the user";
                             rdfs:label "Visual Output Modality";
                             common:id "__OutputModality_Visual";
                             common:name "Visual".
common:Sibling_Disjoint a common:AllDisjointSet;
                        rdfs:comment "";
                        rdfs:label "Common Sibling";
                        common:disjointClass "common:ApplicationProtocol",
                                             "common:CharacterSet",
                                             "common:TransferEncoding",
                                             "common:FeatureRestriction",
                                             "common:Vendor",
                                             "common:TimeZone",
                                             "common:Modality",
                                             "common:SoundMode",
                                             "common:UriScheme",
                                             "common:ContentType",
                                             "common:Language",
                                             "common:Feature";
                        common:normativeStatus common:Utility.
common:SoundMode a owl:Class;
                 rdfs:comment "This class represents the sound modes that can be chosen by the user of a device";
                 rdfs:label "Sound Mode";
                 rdfs:subClassOf [owl:onProperty common:id ; 
                                  owl:cardinality "1"^^xsd:int ; 
                                  a owl:Restriction],
                                 [owl:onProperty common:name ; 
                                  owl:maxCardinality "1"^^xsd:int ; 
                                  a owl:Restriction],
                                 common:Context_CommonEntity.
common:SoundMode_NORMAL a common:SoundMode;
                        rdfs:comment "Normal Sound Mode";
                        rdfs:label "Normal";
                        common:id "__SoundMode_Normal";
                        common:name "Normal";
                        common:normativeStatus common:Normative.
common:SoundMode_SILENCE a common:SoundMode;
                         rdfs:comment "Silence Sound Mode";
                         rdfs:label "Silence";
                         common:id "__SoundMode_Silence";
                         common:name "Silence";
                         common:normativeStatus common:Normative.
common:SpanishSpain a common:Language;
                    rdfs:comment "Spanish spoken Spain";
                    rdfs:label "Spanish-Spain";
                    common:languageCode "spa";
                    common:languageTag "es-ES";
                    common:normativeStatus common:Utility.
common:TermGroup a owl:Class;
                 rdfs:comment "This is an utility class that serves to represent the different term groups that compose the Delivery Context Ontology";
                 rdfs:label "Term Group";
                 rdfs:subClassOf dcn:Associated_Entity;
                 common:normativeStatus common:Utility.
common:TermGroup_Common a common:TermGroup;
                        rdfs:comment "They are a set of general purpose, generic classes, properties and instances which are used to support the modelling of the different aspects of a Delivery Context";
                        rdfs:label "Common";
                        common:normativeStatus common:Utility;
                        common:termGroupPrefix "common".
common:TimeZone a owl:Class;
                rdfs:comment "A time zone is an identifier for a specific location or region which translates into a combination of rules for calculating an UTC offset";
                rdfs:label "Timezone";
                rdfs:subClassOf [owl:unionOf ([owl:onProperty common:tzName ; 
                                              owl:cardinality "1"^^xsd:int ; 
                                              a owl:Restriction]
                                              [owl:onProperty common:timeZoneString ; 
                                              owl:cardinality "1"^^xsd:int ; 
                                              a owl:Restriction]) ; 
                                 a owl:Class],
                                common:Context_CommonEntity;
                common:informativeReference "http://www.w3.org/TR/2005/NOTE-timezone-20051013/".
common:TransferEncoding a owl:Class;
                        rdfs:comment "This class represents transfer encoding formats as specified by RFC 2045 and registered with IANA";
                        rdfs:label "Transfer Encoding";
                        rdfs:subClassOf [owl:onProperty common:transferEncodingName ; 
                                         owl:cardinality "1"^^xsd:int ; 
                                         a owl:Restriction],
                                        common:Context_CommonEntity;
                        common:normativeReference "http://tools.ietf.org/html/rfc2045#section-6"^^xsd:anyURI;
                        common:relatedUAProfEntity "CcppAccept-Encoding".
common:TransferEncoding_7bit a common:TransferEncoding;
                             common:name "";
                             common:normativeStatus common:Utility;
                             common:transferEncodingName "7bit".
common:TransferEncoding_8bit a common:TransferEncoding;
                             common:name "8bit";
                             common:transferEncodingName "8bit".
common:TransferEncoding_Base64 a common:TransferEncoding;
                               rdfs:comment "The base 64 transfer encoding format as specified in RFC4289";
                               common:name "base64";
                               common:transferEncodingName "base64".
common:TransferEncoding_Binary a common:TransferEncoding;
                               rdfs:comment "The binary encoding format as specified in RFC4289";
                               common:name "binary";
                               common:transferEncodingName "binary".
common:TransferEncoding_QuotedPrintable a common:TransferEncoding;
                                        rdfs:comment """The quoted printable transfer encoding format as specified in the RFC \"Multipurpose Internet Mail Extensions (MIME) Part Four""";
                                        common:name "quoted-printable";
                                        common:transferEncodingName "quoted-printable".
common:UTF-8 a common:CharacterSet;
             common:charsetName "UTF-8";
             common:name "UTF-8".
common:UriSchema_31 a common:UriScheme;
                    common:name "";
                    common:uriSchemeName "https".
common:UriSchema_32 a common:UriScheme;
                    common:name "";
                    common:uriSchemeName "tel".
common:UriSchema_34 a common:UriScheme;
                    common:name "";
                    common:uriSchemeName "mailto".
common:UriSchema_37 a common:UriScheme;
                    common:name "";
                    common:uriSchemeName "sips".
common:UriScheme a owl:Class;
                 rdfs:comment "This class represents URI Schemas as per RFC 3986";
                 rdfs:label "URI Schema";
                 rdfs:subClassOf [owl:onProperty common:uriSchemeName ; 
                                  owl:cardinality "1"^^xsd:int ; 
                                  a owl:Restriction],
                                 common:Context_CommonEntity;
                 common:normativeReference "http://tools.ietf.org/html/rfc3986"^^xsd:anyURI.
common:UriScheme_HTTP a common:UriScheme;
                      rdfs:comment """This instance represents the \"http\" URI Scheme""";
                      rdfs:label "HTTP Scheme";
                      common:name "HTTP Schema";
                      common:normativeReference "http://www.ietf.org/rfc/rfc2616.txt"^^xsd:anyURI;
                      common:normativeStatus common:Normative;
                      common:uriSchemeName "http".
common:Utility a common:NormativeStatus;
               rdfs:comment """This instance represents the \"utility\" status""";
               rdfs:label "Utility";
               common:normativeStatus common:Utility.
common:Vendor a owl:Class;
              rdfs:comment "This class represents a vendor, i.e an entity that commercializes a product";
              rdfs:label "Vendor";
              rdfs:subClassOf [owl:onProperty common:name ; 
                               owl:cardinality "1"^^xsd:int ; 
                               a owl:Restriction],
                              common:Context_CommonEntity.
common:active a owl:ObjectProperty;
              rdfs:comment "This property represents a generic relationship between a Context Entity and other Context Entities which are  active in the scope of the former. For instance, the active Bluetooth Profile of a Device or the active Font within an Application";
              rdfs:label "Active";
              rdfs:subPropertyOf common:available.
common:available a owl:ObjectProperty;
                 rdfs:comment "A generic property that represents Context Entities that are available";
                 rdfs:label "Available";
                 rdfs:subPropertyOf common:supports.
common:charsetName a owl:DatatypeProperty;
                   rdfs:comment "The name of a charset officially assigned by IANA";
                   rdfs:domain common:CharacterSet;
                   rdfs:label "Character Set Name";
                   rdfs:subPropertyOf common:id;
                   common:normativeReference "http://www.iana.org/assignments/character-sets"^^xsd:anyURI.
common:contentTypeName a owl:DatatypeProperty;
                       rdfs:comment "This property identifies unequivocally a content type. It is  the concatenation of the MIME Media type, subtype and optional parameters  according to the syntax specified on RFC 2045, section 5.1";
                       rdfs:domain common:ContentType;
                       rdfs:label "Content Type Name";
                       rdfs:subPropertyOf common:id;
                       common:normativeReference "http://tools.ietf.org/html/rfc2045#section-5.1"^^xsd:anyURI.
common:countryCode a owl:FunctionalProperty,
                     owl:DatatypeProperty;
                   rdfs:comment "This property represents a country code as per ISO 3166-1 alpha 3, so the country code is composed by a three letter code";
                   rdfs:label "Country Code";
                   rdfs:range xsd:string;
                   rdfs:subPropertyOf common:id;
                   common:normativeReference "http://www.iso.org/iso/list-en1-semic-2.txt"^^xsd:anyURI.
common:default a owl:ObjectProperty;
               rdfs:comment "This is a generic property that can be used to represent the relationship between a Context Entity and a default element for such entity";
               rdfs:label "Default";
               rdfs:subPropertyOf common:supports.
common:disjointClass a owl:DatatypeProperty;
                     rdfs:comment "This property contains the URI of a disjoint class in a AllDisjointSet. The URI is represented following the CURIE notation";
                     rdfs:domain common:AllDisjointSet;
                     rdfs:label "Disjoint Class";
                     rdfs:range xsd:string;
                     common:normativeStatus common:Utility.
common:disjointSet a owl:ObjectProperty;
                   rdfs:comment "This property is aimed at linking groups of disjoint classes between them";
                   rdfs:domain common:AllDisjointSet;
                   rdfs:label "Disjoint Set";
                   rdfs:range common:AllDisjointSet;
                   common:normativeStatus common:Utility.
common:id a owl:FunctionalProperty,
            owl:DatatypeProperty;
          rdfs:comment "A machine-readable alphanumeric string that univoquely identifies a Context Entity";
          rdfs:domain dcn:Context_Entity;
          rdfs:label "Id";
          rdfs:range xsd:string.
common:informativeReference a owl:AnnotationProperty,
                              owl:DatatypeProperty;
                            rdfs:comment "This annotation property serves for indicating informative references for an entity in the ontology. It can be used in order to support the (automatic) documentation generation process";
                            rdfs:label "Informative Reference";
                            common:normativeStatus common:Utility.
common:languageCode a owl:DatatypeProperty;
                    rdfs:comment "It represents a language code according to ISO 639 Part 3";
                    rdfs:domain common:Language;
                    rdfs:label "Language Code";
                    rdfs:range xsd:string;
                    common:normativeReference "http://www.sil.org/iso639-3/codes.asp"^^xsd:anyURI.
common:languageTag a owl:FunctionalProperty,
                     owl:DatatypeProperty;
                   rdfs:comment "A language tag according to the rules specified by RFC 4646";
                   rdfs:domain common:Language;
                   rdfs:label "Language Tag";
                   rdfs:range xsd:string;
                   rdfs:subPropertyOf common:id;
                   common:normativeReference "http://www.ietf.org/rfc/rfc4646.txt"^^xsd:anyURI.
common:model a owl:FunctionalProperty,
               owl:DatatypeProperty;
             rdfs:comment "The model identification assigned to something by its vendor";
             rdfs:label "Model";
             rdfs:range xsd:string;
             common:relatedDDRCoreVoc "model";
             common:relatedUAProfEntity "Model",
                                        "CPU".
common:name a owl:DatatypeProperty;
            rdfs:comment "The name of a delivery context entity";
            rdfs:domain dcn:Context_Entity;
            rdfs:label "Name";
            rdfs:range xsd:string;
            common:relatedUAProfEntity "OSName",
                                       "BrowserName".
common:normativeReference a owl:AnnotationProperty,
                            owl:DatatypeProperty;
                          rdfs:comment "This annotation property serves for indicating normative references for an entity in the ontology. It can be used in order to support the (automatic) documentation generation process";
                          rdfs:label "normativeReference";
                          rdfs:range xsd:anyURI;
                          common:normativeStatus common:Utility.
common:normativeStatus a owl:FunctionalProperty,
                         owl:AnnotationProperty,
                         owl:ObjectProperty;
                       rdfs:comment "This annotation property indicates the normative status of an entity in the ontology. The  criteria used is that classes and properties are normative by default. On the other hand instances are not normative by default";
                       rdfs:domain dcn:Context_Entity;
                       rdfs:label "Normative Status";
                       rdfs:range common:NormativeStatus;
                       common:normativeStatus common:Utility.
common:normativeURI a owl:FunctionalProperty,
                      owl:DatatypeProperty;
                    rdfs:comment "This property holds a URI that points to the normative specification of a software technology. One example are the estable  URIs that are associated to W3C Recommendations";
                    rdfs:domain soft:Context_SoftwareEntity;
                    rdfs:label "Normative URI";
                    rdfs:range xsd:anyURI.
common:pixelAspectRatio a owl:FunctionalProperty,
                          owl:DatatypeProperty;
                        rdfs:comment "The pixel aspect ratio as a decimal value, for example 1.33 for a 4:3 aspect. The pixel aspect ratio is the ratio of the resolution width in pixels, to the resolution height in pixels";
                        rdfs:label "Pixel Aspect Ratio";
                        rdfs:range xsd:float;
                        common:relatedUAProfEntity "PixelAspectRatio".
common:relatedDDRCoreVoc a owl:AnnotationProperty,
                           owl:DatatypeProperty;
                         rdfs:comment "The name of a  W3C DDR Core Vocabulary property to which a property in the ontology relates to";
                         rdfs:label "Related DDR Core Vocabulary Property";
                         rdfs:range xsd:string;
                         common:normativeStatus common:Informative.
common:relatedUAProfEntity a owl:AnnotationProperty,
                             owl:DatatypeProperty;
                           rdfs:comment "The name of the related UAProf entities";
                           rdfs:label "Related UAProf entity";
                           rdfs:range xsd:string;
                           common:normativeStatus common:Informative.
common:resolutionHeight a owl:FunctionalProperty,
                          owl:DatatypeProperty;
                        rdfs:comment "The total number of addressable pixels in the vertical direction of a rectangular element (such as Camera, Display, Image, Video, ...) when held in its default orientation";
                        rdfs:label "Resolution Height";
                        rdfs:range xsd:int;
                        common:relatedDDRCoreVoc "displayHeight";
                        common:relatedUAProfEntity "ScreenSize".
common:resolutionWidth a owl:FunctionalProperty,
                         owl:DatatypeProperty;
                       rdfs:comment "The total number of addressable pixels in the horizontal direction of a rectangular entity (such as Camera, Display, Image, Video, ...) when held in its default orientation. The Property does not apply to entities that are not rectangular or square";
                       rdfs:label "resolutionWidth";
                       rdfs:range xsd:int;
                       common:relatedDDRCoreVoc "displayWidth";
                       common:relatedUAProfEntity "ScreenSize".
common:restrictedElement a owl:FunctionalProperty,
                           owl:ObjectProperty;
                         rdfs:comment "The element to which a restriction applies";
                         rdfs:domain common:FeatureRestriction;
                         rdfs:label "Restricted Element".
common:restrictionValue a owl:DatatypeProperty;
                        rdfs:comment "The value of a feature restriction";
                        rdfs:domain common:FeatureRestriction;
                        rdfs:label "Restriction Value";
                        rdfs:range xsd:anySimpleType.
common:restrictions a owl:ObjectProperty;
                    rdfs:comment "The restrictions presented by a context entity";
                    rdfs:domain dcn:Context_Entity;
                    rdfs:label "Restrictions";
                    rdfs:range common:FeatureRestriction.
common:serialNumber a owl:FunctionalProperty,
                      owl:DatatypeProperty;
                    rdfs:comment "The serial number of something";
                    rdfs:label "Serial Number";
                    rdfs:range xsd:string;
                    rdfs:subPropertyOf common:id.
common:sip a common:UriScheme;
           common:name "sip";
           common:uriSchemeName "sip".
common:soundMode a owl:FunctionalProperty,
                   owl:ObjectProperty;
                 rdfs:comment "This property represents the sound mode currently setted on a device";
                 rdfs:domain dcn:Device;
                 rdfs:label "Sound Mode";
                 rdfs:range common:SoundMode.
common:standardNumber a owl:FunctionalProperty,
                        owl:DatatypeProperty;
                      rdfs:comment "This is a generic property that holds a  machine-readable string that identifies univoquely an standard, for example,  EN 302 409 or TS 102 221";
                      rdfs:label "Standard Number";
                      rdfs:range xsd:string.
common:supports a owl:ObjectProperty;
                rdfs:comment "A generic property that indicates what is supported by a Context Entity";
                rdfs:domain dcn:Context_Entity;
                rdfs:label "Supports";
                rdfs:range dcn:Context_Entity.
common:termGroupPrefix a owl:AnnotationProperty,
                         owl:DatatypeProperty;
                       rdfs:comment "The prefix used for a group of terms";
                       rdfs:domain common:TermGroup;
                       rdfs:label "Term Group Prefix";
                       rdfs:range xsd:string;
                       common:normativeStatus common:Utility.
common:termGroups a owl:AnnotationProperty,
                    owl:ObjectProperty;
                  rdfs:comment "An annotation property to indicate the term groups of the Delivery Context Ontology";
                  rdfs:label "termGroups";
                  rdfs:range common:TermGroup;
                  common:normativeStatus common:Utility.
common:timeZone a owl:ObjectProperty;
                rdfs:comment "This property represents a time zone";
                rdfs:label "Time Zone";
                rdfs:range common:TimeZone.
common:timeZoneString a owl:FunctionalProperty,
                        owl:DatatypeProperty;
                      rdfs:comment "This property is a string that denotes the timezone as per the rules defined by POSIX 1003.1 in Section 8.3";
                      rdfs:domain common:TimeZone;
                      rdfs:label "Time Zone String";
                      rdfs:range xsd:string.
common:transferEncodingName a owl:DatatypeProperty;
                            rdfs:comment "The name of a transfer encoding as officially defined by IANA";
                            rdfs:domain common:TransferEncoding;
                            rdfs:label "Transfer Encoding Name";
                            rdfs:subPropertyOf common:id;
                            common:normativeReference "http://www.iana.org/assignments/transfer-encodings/"^^xsd:anyURI.
common:tzName a owl:FunctionalProperty,
                owl:DatatypeProperty;
              rdfs:comment "This property represents the name of a Zone entry in the database commonly referred  to as the TZ database.  Specifically, in the database's  textual form,  the string refers to the name field of a zone line";
              rdfs:domain common:TimeZone;
              rdfs:label "TZ Name".
common:uriSchemeName a owl:DatatypeProperty;
                     rdfs:comment "The name of a URI scheme as officially defined by IANA";
                     rdfs:domain common:UriScheme;
                     rdfs:label "URI Scheme Name";
                     rdfs:subPropertyOf common:id;
                     common:normativeReference "http://www.iana.org/assignments/uri-schemes.html"^^xsd:anyURI.
common:vendor a owl:ObjectProperty,
                owl:FunctionalProperty;
              rdfs:comment "This property represents a vendor";
              rdfs:label "Vendor";
              rdfs:range common:Vendor;
              common:relatedDDRCoreVoc "vendor";
              common:relatedUAProfEntity "Vendor",
                                         "CPU",
                                         "OSVendor",
                                         "BrowserVendor".
common:version a owl:DatatypeProperty,
                 owl:FunctionalProperty;
               rdfs:comment "The version number assigned to something by its vendor";
               rdfs:label "Version";
               rdfs:range xsd:string;
               common:relatedDDRCoreVoc "version";
               common:relatedUAProfEntity "WmlScriptVersion",
                                          "WmlVersion",
                                          "JavaScriptVersion",
                                          "HtmlVersion",
                                          "OSVersion",
                                          "WapVersion",
                                          "XhtmlVersion",
                                          "WtaVersion",
                                          "BrowserVersion",
                                          "JVMVersion".
<http://www.w3.org/2007/uwa/context/deliverycontext.owl> dcterms:author "Jose M. Cantera",
                                                                        "Rhys Lewis";
                                                         a owl:Ontology;
                                                         rdfs:comment "The Delivery Context Ontology models the knowledge of the environment in which devices interact with the Web or other services";
                                                         owl:versionInfo "Delivery Context Ontology (Working Draft February 2009)";
                                                         common:termGroups net:TermGroup_Network,
                                                                           common:TermGroup_Common,
                                                                           hard:TermGroup_Hardware,
                                                                           <http://www.w3.org/2007/uwa/context/location.owl#TermGroup_Location>,
                                                                           soft:TermGroup_Software,
                                                                           java:TermGroup_Java,
                                                                           dcn:TermGroup_Main,
                                                                           web:TermGroup_Web.
dcn:AllDisjointSet_16 a common:AllDisjointSet;
                      common:disjointClass "common:Context_CommonEntity",
                                           "loc:Context_LocationEntity".
dcn:AllDisjointSet_17 a common:AllDisjointSet;
                      common:disjointClass "common:Context_CommonEntity",
                                           "net:Context_NetworkEntity".
dcn:AllDisjointSet_19 a common:AllDisjointSet;
                      common:disjointClass "hard:Context_HardwareEntity",
                                           "soft:Context_SoftwareEntity",
                                           "common:Context_CommonEntity".
dcn:Aspect a owl:Class;
           rdfs:comment "This class represents Aspects of the Context";
           rdfs:label "Aspect";
           rdfs:subClassOf dcn:Context_Entity;
           common:normativeReference "http://www.w3.org/TR/2008/REC-DDR-Simple-API-20081205/#aspect"^^xsd:anyURI.
dcn:Aspects_Disjoint a common:AllDisjointSet;
                     common:disjointClass "net:NetworkBearer",
                                          "net:Network",
                                          "soft:SoftwareAspect",
                                          "hard:HardwareComponent".
dcn:Associated_Disjoint a common:AllDisjointSet;
                        common:disjointClass "common:TermGroup",
                                             "common:NormativeStatus",
                                             "common:AllDisjointSet".
dcn:Associated_Entity a owl:Class;
                      rdfs:comment "This is the base class for associated entities in the ontology. Classes derived from this are not part of the delivery context. Rather, they provide information that could, for example, be used to help create normative documentation from the definitions for the delivery context";
                      rdfs:label "Associated Entity";
                      common:normativeStatus common:Utility.
dcn:Context_Entity a owl:Class;
                   rdfs:comment "This is the base class for the entities that define the Context and particularly the Delivery Context";
                   rdfs:label "Context Entity".
dcn:DeliveryContext a owl:Class;
                    rdfs:comment "This class represents the set of characteristics that describes the context in which materials are exchanged between a service and a device";
                    rdfs:label "Delivery Context";
                    rdfs:subClassOf [owl:onProperty dcn:currentDevice ; 
                                     owl:maxCardinality "1"^^xsd:int ; 
                                     a owl:Restriction],
                                    [owl:onProperty dcn:currentEnvironment ; 
                                     owl:maxCardinality "1"^^xsd:int ; 
                                     a owl:Restriction],
                                    [owl:onProperty dcn:currentRuntimeEnvironment ; 
                                     owl:maxCardinality "1"^^xsd:int ; 
                                     a owl:Restriction],
                                    dcn:Context_Entity,
                                    [owl:unionOf ([owl:someValuesFrom dcn:Device ; 
                                                  owl:onProperty dcn:currentDevice ; 
                                                  a owl:Restriction]
                                                  [owl:someValuesFrom soft:UserAgent ; 
                                                  owl:onProperty dcn:currentUserAgent ; 
                                                  a owl:Restriction]
                                                  [owl:someValuesFrom soft:RuntimeEnvironment ; 
                                                  owl:onProperty dcn:currentRuntimeEnvironment ; 
                                                  a owl:Restriction]) ; 
                                     a owl:Class],
                                    [owl:onProperty dcn:currentNetworkBearer ; 
                                     owl:maxCardinality "1"^^xsd:int ; 
                                     a owl:Restriction],
                                    dcn:Aspect,
                                    [owl:onProperty dcn:currentUserAgent ; 
                                     owl:maxCardinality "1"^^xsd:int ; 
                                     a owl:Restriction];
                    common:informativeReference "http://www.w3.org/TR/di-gloss/#def-delivery-context-v2".
dcn:Device a owl:Class;
           rdfs:comment "This class represents a device in the delivery context";
           rdfs:label "Device";
           rdfs:subClassOf [owl:onProperty common:model ; 
                            owl:maxCardinality "1"^^xsd:int ; 
                            a owl:Restriction],
                           [owl:onProperty common:soundMode ; 
                            owl:allValuesFrom common:SoundMode ; 
                            a owl:Restriction],
                           [owl:onProperty hard:deviceHardware ; 
                            owl:cardinality "1"^^xsd:int ; 
                            a owl:Restriction],
                           [owl:someValuesFrom soft:DeviceSoftware ; 
                            owl:onProperty soft:deviceSoftware ; 
                            a owl:Restriction],
                           [owl:onProperty soft:deviceSoftware ; 
                            owl:cardinality "1"^^xsd:int ; 
                            a owl:Restriction],
                           dcn:Aspect,
                           [owl:onProperty common:version ; 
                            owl:maxCardinality "1"^^xsd:int ; 
                            a owl:Restriction],
                           [owl:onProperty hard:bluetoothStatus ; 
                            owl:allValuesFrom hard:BluetoothStatus ; 
                            a owl:Restriction],
                           [owl:onProperty common:vendor ; 
                            owl:maxCardinality "1"^^xsd:int ; 
                            a owl:Restriction],
                           dcn:Context_Entity,
                           [owl:someValuesFrom hard:DeviceHardware ; 
                            owl:onProperty hard:deviceHardware ; 
                            a owl:Restriction].
dcn:Disjoint2 a common:AllDisjointSet;
              common:disjointClass "hard:Context_HardwareEntity";
              common:disjointSet dcn:Sibling_Disjoint.
dcn:Disjoint3 a common:AllDisjointSet;
              common:disjointClass "soft:Context_SoftwareEntity";
              common:disjointSet dcn:Sibling_Disjoint.
dcn:Disjoint4 a common:AllDisjointSet;
              common:disjointClass "net:Context_NetworkEntity";
              common:disjointSet dcn:Sibling_Disjoint.
dcn:Disjoint5 a common:AllDisjointSet;
              common:disjointClass "loc:Context_LocationEntity";
              common:disjointSet dcn:Sibling_Disjoint.
dcn:Environment a owl:Class;
                rdfs:comment "This class represents the physical environment in which an interaction takes place";
                rdfs:label "Environment";
                rdfs:subClassOf dcn:Context_Entity.
dcn:Sibling_Disjoint a common:AllDisjointSet;
                     rdfs:label "Main Disjoint Group";
                     common:disjointClass "dcn:DeliveryContext",
                                          "dcn:Device",
                                          "dcn:Environment".
dcn:TermGroup_Main a common:TermGroup;
                   rdfs:comment "These are the fundamental Aspects and Properties such as the Device or the Delivery Context itself";
                   rdfs:label "Main";
                   common:normativeStatus common:Utility;
                   common:termGroupPrefix "dcn".
dcn:Top_Disjoint a common:AllDisjointSet;
                 rdfs:comment "Global Disjoint";
                 rdfs:label "Top Level  Disjoint Group";
                 common:disjointClass "dcn:Associated_Entity",
                                      "dcn:Context_Entity";
                 common:normativeStatus common:Utility.
dcn:activeComponent a owl:ObjectProperty;
                    rdfs:comment "This is a generic property that represents what Components (Aspect instances) are active in the Context of an Aspect";
                    rdfs:domain dcn:Aspect;
                    rdfs:label "Active";
                    rdfs:range dcn:Aspect;
                    rdfs:subPropertyOf common:active,
                                       dcn:component.
dcn:component a owl:ObjectProperty;
              rdfs:comment "A generic property that represents the relationship between an Aspect of the Delivery Context and its Components (Aspect instances)";
              rdfs:domain dcn:Aspect;
              rdfs:label "Component";
              rdfs:range dcn:Aspect.
dcn:currentDevice a owl:FunctionalProperty,
                    owl:ObjectProperty;
                  rdfs:comment "This property represents the currently used device in a Delivery Context";
                  rdfs:domain dcn:DeliveryContext;
                  rdfs:label "Current Device";
                  rdfs:range dcn:Device;
                  rdfs:subPropertyOf dcn:activeComponent.
dcn:currentEnvironment a owl:FunctionalProperty,
                         owl:ObjectProperty;
                       rdfs:comment "The current physical environment associated to a Delivery Context";
                       rdfs:domain dcn:DeliveryContext;
                       rdfs:label "Environment";
                       rdfs:range dcn:Environment;
                       rdfs:subPropertyOf common:active.
dcn:currentNetworkBearer a owl:FunctionalProperty,
                           owl:ObjectProperty;
                         rdfs:comment "This property represents the currently used network bearer in a Delivery Context";
                         rdfs:domain dcn:DeliveryContext;
                         rdfs:label "Current Network Bearer";
                         rdfs:range net:NetworkBearer;
                         rdfs:subPropertyOf dcn:activeComponent.
dcn:currentRuntimeEnvironment a owl:FunctionalProperty,
                                owl:ObjectProperty;
                              rdfs:comment "This property represents the current runtime environment of a Delivery Context";
                              rdfs:domain dcn:DeliveryContext;
                              rdfs:label "Current Runtime Environment";
                              rdfs:range soft:RuntimeEnvironment;
                              rdfs:subPropertyOf dcn:activeComponent.
dcn:currentUserAgent a owl:FunctionalProperty,
                       owl:ObjectProperty;
                     rdfs:comment "The user agent currently used by the user and responsible of the current interaction in a Delivery Context";
                     rdfs:domain dcn:DeliveryContext;
                     rdfs:label "Current User Agent";
                     rdfs:range soft:UserAgent;
                     rdfs:subPropertyOf dcn:activeComponent.
dcn:defaultComponent a owl:ObjectProperty;
                     rdfs:comment "This is a generic property that represents a default Component (Aspect instance)";
                     rdfs:label "Default Component";
                     rdfs:range dcn:Aspect;
                     rdfs:subPropertyOf common:default,
                                        dcn:component.
dcn:globalDisjoints a common:AllDisjointSet;
                    common:disjointClass "common:Context_CommonEntity",
                                         "dcn:Aspect",
                                         "dcn:Environment";
                    common:disjointSet <http://www.w3.org/2007/uwa/context/location.owl#AllSibling_Disjoint>,
                                       soft:Sibling_Disjoint1,
                                       web:Sibling_Disjoint1,
                                       soft:SiblingDisjoint2,
                                       net:Sibling_Disjoint,
                                       hard:Sibling_Disjoint,
                                       java:Sibling_Disjoint.
dcn:usablePixelsX a owl:FunctionalProperty,
                    owl:DatatypeProperty;
                  rdfs:comment "The typical number of pixels in the X direction of the display which can be used within a delivery context. This may be less than the total number available due to the presence of additional items on the display";
                  rdfs:domain dcn:DeliveryContext;
                  rdfs:label "Usable Pixels X";
                  rdfs:range xsd:int;
                  common:relatedDDRCoreVoc "displayWidth";
                  common:relatedUAProfEntity "BrowserScreenSize".
dcn:usablePixelsY a owl:FunctionalProperty,
                    owl:DatatypeProperty;
                  rdfs:comment "The typical number of pixels in the Y direction of the display which can be used within a delivery context. This may be less than the total number available due to the presence of additional items on the display";
                  rdfs:domain dcn:DeliveryContext;
                  rdfs:label "Usable  Pixels Y";
                  rdfs:range xsd:int;
                  common:relatedDDRCoreVoc "displayHeight";
                  common:relatedUAProfEntity "BrowserScreenSize".
dcn:xx a soft:X509Certificate;
       soft:issuer "xxxx";
       soft:subject "xxxxx".
hard:Battery a owl:Class;
             rdfs:comment "This class represents a battery in a device";
             rdfs:label "Battery";
             rdfs:subClassOf hard:HardwareComponent.
hard:BluetoothHardware a owl:Class;
                       rdfs:comment "This class represents device hardware that can be used to access to Bluetooth technology";
                       rdfs:label "Bluetooth Hardware";
                       rdfs:subClassOf [owl:onProperty hard:supportedBluetoothProfiles ; 
                                        owl:allValuesFrom hard:BluetoothProfile ; 
                                        a owl:Restriction],
                                       hard:HardwareComponent.
hard:BluetoothProfile a owl:Class;
                      rdfs:comment "This class describes a specific Bluetooth profile used to support a particular user scenario";
                      rdfs:label "Bluetooth Profile";
                      rdfs:subClassOf [owl:onProperty common:id ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty common:name ; 
                                       owl:minCardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      hard:Context_HardwareEntity;
                      common:relatedUAProfEntity "BluetoothProfile".
hard:BluetoothProfile_dialup a hard:BluetoothProfile;
                             rdfs:comment "The Bluetooth profile that defines how devices provide modem services.";
                             common:name "Dialup Networking".
hard:BluetoothProfile_fileTransfer a hard:BluetoothProfile;
                                   rdfs:comment "The Bluetooth profile that defines how devices perform file transfer.";
                                   common:name "File Transfer".
hard:BluetoothProfile_genericAccess a hard:BluetoothProfile;
                                    rdfs:comment "The Bluetooth profile that defines the basic level of function that all devices must implement.";
                                    common:name "Generic Access".
hard:BluetoothProfile_genericObjExch a hard:BluetoothProfile;
                                     rdfs:comment "The Bluetooth profile that defines how the Infra Red Data Association's OBEX object exchange protocol is used to allow devices to exchange objects.";
                                     common:name "Generic Object Exchange".
hard:BluetoothProfile_headSet a hard:BluetoothProfile;
                              rdfs:comment "The Bluetooth profile that defines how headsets communicate with devices.";
                              common:name "Head Set".
hard:BluetoothProfile_objectPush a hard:BluetoothProfile;
                                 rdfs:comment "The Bluetooth profile that defines how predefined standard objects, such as virtual business cards, are pushed to another device.";
                                 common:name "Object Push".
hard:BluetoothProfile_serialPort a hard:BluetoothProfile;
                                 rdfs:comment "The Bluetooth profile that defines how devices provide serial port emulation for communication.";
                                 common:name "Serial Port".
hard:BluetoothStatus a owl:Class;
                     rdfs:comment "This class represents the possible statuses of Bluetooth in a device";
                     rdfs:label "Bluetooth Status";
                     rdfs:subClassOf [owl:onProperty common:id ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     hard:Context_HardwareEntity.
hard:BluetoothStatus_DISCOVERABLE a hard:BluetoothStatus;
                                  rdfs:comment "This status indicates that the device can be discovered by other Bluetooth devices";
                                  rdfs:label "Bluetooth Discoverable";
                                  common:id "__BTStatus_Discoverable";
                                  common:name "Discoverable";
                                  common:normativeStatus common:Normative.
hard:BluetoothStatus_HIDDEN a hard:BluetoothStatus;
                            rdfs:comment "This status indicates that the device cannot be discovered by other Bluetooth devices";
                            rdfs:label "Bluetooth Status Hidden";
                            common:id "__BTStatus_Hidden";
                            common:name "Hidden";
                            common:normativeStatus common:Normative.
hard:BluetoothStatus_PAIRED a hard:BluetoothStatus;
                            rdfs:comment "This status indicates that the device is paired to other Bluetooth device";
                            rdfs:label "Bluetooth Status Paired";
                            common:id "__BTStatus_Paired";
                            common:name "Paired";
                            common:normativeStatus common:Normative.
hard:BluetoothStatus_TEMP_DISCOVERABLE a hard:BluetoothStatus;
                                       rdfs:comment "This status indicates that the device can be temporarily discovered by other Bluetooth devices";
                                       rdfs:label "Bluetooth Status Temporarily Discoverable";
                                       common:id "__BTStatus_Temp_Discoverable";
                                       common:name "Temporary Discoverable";
                                       common:normativeStatus common:Normative.
hard:CPU a owl:Class;
         rdfs:comment "This class describes a central processing unit associated with a device";
         rdfs:label "CPU";
         rdfs:subClassOf hard:HardwareComponent;
         common:relatedUAProfEntity "CPU".
hard:Camera a owl:Class;
            rdfs:comment "This class represents a camera in a device";
            rdfs:label "Camera";
            rdfs:subClassOf hard:InputDevice.
hard:CellularHardware a owl:Class;
                      rdfs:comment "This class represents device hardware that can be used to access to mobile operator telephony networks";
                      rdfs:label "Cellular Hardware";
                      rdfs:subClassOf hard:HardwareComponent.
hard:CharacterDisplay a owl:Class;
                      rdfs:comment "This class represents a character oriented display";
                      rdfs:label "Character Display";
                      rdfs:subClassOf hard:Display.
hard:Context_HardwareEntity a owl:Class;
                            rdfs:comment "This is the base class for those ontology entities that have to do with hardware";
                            rdfs:label "Context Hardware Entity";
                            rdfs:subClassOf dcn:Context_Entity.
hard:DeviceHardware a owl:Class;
                    rdfs:comment "This class represents the hardware in a device";
                    rdfs:label "Device Hardware";
                    rdfs:subClassOf [owl:onProperty hard:pointingResolution ; 
                                     owl:allValuesFrom hard:PointingResolution ; 
                                     a owl:Restriction],
                                    [owl:onProperty hard:inputDevice ; 
                                     owl:allValuesFrom hard:InputDevice ; 
                                     a owl:Restriction],
                                    [owl:onProperty hard:primaryCamera ; 
                                     owl:maxCardinality "1"^^xsd:int ; 
                                     a owl:Restriction],
                                    hard:HardwareComponent;
                    common:relatedUAProfEntity "HardwarePlatform".
hard:Display a owl:Class;
             rdfs:comment "This class represents a visual display on a device";
             rdfs:label "Display";
             rdfs:subClassOf hard:OutputDevice;
             common:relatedUAProfEntity "HardwarePlatform".
hard:Feature_COLOR_DISPLAY a common:Feature;
                           rdfs:comment "This feature indicates that color display is supported";
                           rdfs:label "Color Display";
                           common:id "__Feature_ColorDisplay";
                           common:name "ColorDisplay";
                           common:normativeStatus common:Normative.
hard:Feature_MONOCHROME_DISPLAY a common:Feature;
                                rdfs:comment "This feature indicates that a display is monochrome";
                                rdfs:label "MonochromeDisplay";
                                common:id "__Feature_MonochromeDisplay";
                                common:name "MonochromeDisplay";
                                common:normativeStatus common:Normative.
hard:GraphicDisplay a owl:Class;
                    rdfs:comment "This class represents a graphic display";
                    rdfs:label "Graphic Display";
                    rdfs:subClassOf hard:Display.
hard:HardwareComponent a owl:Class;
                       rdfs:comment "This class represents a hardware component of a Device";
                       rdfs:label "Hardware Component";
                       rdfs:subClassOf [owl:onProperty hard:status ; 
                                        owl:allValuesFrom hard:HardwareStatus ; 
                                        a owl:Restriction],
                                       dcn:Aspect,
                                       hard:Context_HardwareEntity.
hard:HardwareStatus a owl:Class;
                    rdfs:comment "This class represents the status of a hardware component";
                    rdfs:label "Hardware Status";
                    rdfs:subClassOf hard:Context_HardwareEntity.
hard:HardwareStatus_OFF a hard:HardwareStatus;
                        rdfs:comment "This status indicates that the hardware component is off";
                        rdfs:label "Off";
                        common:id "__HardwareStatus_Off";
                        common:name "Off";
                        common:normativeStatus common:Normative.
hard:HardwareStatus_ON a hard:HardwareStatus;
                       rdfs:comment "This status indicates that the hardware component is on";
                       rdfs:label "On";
                       common:id "__HardwareStatus_On";
                       common:name "On";
                       common:normativeStatus common:Normative.
hard:HardwareStatus_STANDBY a hard:HardwareStatus;
                            rdfs:comment "This status indicates that harware component is in standby mode";
                            common:id "__HardwareStatus_STANDBY";
                            common:name "Standby".
hard:InfraredHardware a owl:Class;
                      rdfs:comment "This class represents the infrared hardware on a device";
                      rdfs:label "InfraredHardware";
                      rdfs:subClassOf hard:HardwareComponent.
hard:InputDevice a owl:Class;
                 rdfs:comment "This class represents an input mechanism that can be available in a device";
                 rdfs:label "Input Device";
                 rdfs:subClassOf [owl:onProperty common:id ; 
                                  owl:maxCardinality "1"^^xsd:int ; 
                                  a owl:Restriction],
                                 hard:HardwareComponent.
hard:InputDevice_CLICK_WHEEL a hard:InputDevice;
                             rdfs:comment "A wheel that is normally placed either below the screen or on the side of the device that lets the user quickly move up and down and click on link or items on the screen";
                             rdfs:label "Click Wheel";
                             common:id "__InputDevice_ClickWheel";
                             common:normativeStatus common:Normative.
hard:InputDevice_FOUR_WAY_SCROLLER a hard:InputDevice;
                                   rdfs:comment "Scroll up and down and side to side";
                                   rdfs:label "Four Way Scroller";
                                   common:id "__InputDevice_FourWayScroller";
                                   common:normativeStatus common:Normative.
hard:InputDevice_JOG_DIAL a hard:InputDevice;
                          rdfs:comment "A jog dial, jog wheel, shuttle dial, or shuttle wheel is a type of knob, ring, wheel, or dial which allows the user to shuttle or jog";
                          rdfs:label "Jog Dial";
                          common:id "__InputDevice_JogDial";
                          common:normativeStatus common:Normative.
hard:InputDevice_MOUSE a hard:InputDevice;
                       rdfs:comment "Represents a typical two button mouse found on a PC device";
                       rdfs:label "Mouse";
                       common:id "__InputDevice_Mouse";
                       common:normativeStatus common:Normative.
hard:InputDevice_NUMERIC_KEYPAD a hard:Keyboard;
                                rdfs:comment "A keyboard with only numeric input";
                                rdfs:label "Numeric Keypad";
                                common:id "__InputDevice_NumericKeypad";
                                common:normativeStatus common:Normative.
hard:InputDevice_PHONE_KEYPAD a hard:Keyboard;
                              rdfs:comment "A phone-style keypad where multiple symbols are available through multiple presses of a limited number of keys";
                              rdfs:label "Phone Keypad";
                              common:id "__InputDevice_PhoneKeypad";
                              common:name "__InputDevice_PhoneKeypad";
                              common:normativeStatus common:Normative.
hard:InputDevice_QWERTY_KEYBOARD a hard:Keyboard;
                                 rdfs:comment "Represents a full alphanumeric keyboard";
                                 rdfs:label "Qwerty Keyboard";
                                 common:id "__InputDevice_QwertyKeyboard";
                                 common:normativeStatus common:Normative.
hard:InputDevice_STYLUS a hard:InputDevice;
                        rdfs:comment "Represents a stylus";
                        rdfs:label "Stylus";
                        common:id "__InputDevice_Stylus";
                        common:normativeStatus common:Normative.
hard:InputDevice_TOUCH_SCREEN a hard:TactileDisplay;
                              rdfs:comment "Touch screen that allows pointing to an area on the screen";
                              rdfs:label "Touch Screen";
                              common:id "__InputDevice_TouchScreen";
                              common:normativeStatus common:Normative.
hard:InputDevice_TRACK_BALL a hard:InputDevice;
                            rdfs:comment "A little sphere that acts like a trackball mouse";
                            rdfs:label "Track Ball";
                            common:id "__InputDevice_TrackBall";
                            common:normativeStatus common:Normative.
hard:Keyboard a owl:Class;
              rdfs:comment "This class represents a keyboard in a device";
              rdfs:label "Keyboard";
              rdfs:subClassOf hard:InputDevice.
hard:MemoryCard a owl:Class;
                rdfs:comment "This class represents a storage card which can be attached to a device";
                rdfs:label "Memory Card";
                rdfs:subClassOf [owl:onProperty hard:volatile ; 
                                 owl:hasValue false ; 
                                 a owl:Restriction],
                                hard:MemoryUnit.
hard:MemoryUnit a owl:Class;
                rdfs:comment "This class represents some memory used in a device. It might, for example, be built-in memory that is part of the device, or it might be removable memory on some form of storage card";
                rdfs:label "Memory Unit";
                rdfs:subClassOf [owl:onProperty hard:size ; 
                                 owl:cardinality "1"^^xsd:int ; 
                                 a owl:Restriction],
                                hard:HardwareComponent.
hard:Microphone a owl:Class;
                rdfs:comment "This class represents a microphone in a device";
                rdfs:label "Microphone";
                rdfs:subClassOf hard:InputDevice.
hard:NfcHardware a owl:Class;
                 rdfs:comment "This class represents the NFC hardware on a device";
                 rdfs:label "NFC Hardware";
                 rdfs:subClassOf hard:HardwareComponent.
hard:OutputDevice a owl:Class;
                  rdfs:comment "This class represents an output mechanism that can be available in a device";
                  rdfs:label "Output Device";
                  rdfs:subClassOf hard:HardwareComponent.
hard:PointingResolution a owl:Class;
                        rdfs:comment "This class represents the precision with which the pointing can be achieved on a  device";
                        rdfs:label "Pointing Resolution";
                        rdfs:subClassOf [owl:onProperty common:id ; 
                                         owl:cardinality "1"^^xsd:int ; 
                                         a owl:Restriction],
                                        hard:Context_HardwareEntity;
                        common:relatedUAProfEntity "PointingResolution".
hard:PointingResolution_CHAR a hard:PointingResolution;
                             rdfs:comment "The pointing device can select an individual character";
                             rdfs:label "Character Pointing Resolution";
                             common:id "__PointingResolution_Character";
                             common:name "character";
                             common:normativeStatus common:Normative.
hard:PointingResolution_LINE a hard:PointingResolution;
                             rdfs:comment "The pointing device can select a line of text";
                             rdfs:label "Line Pointing Resolution";
                             common:id "__PointingResolution_Line";
                             common:name "line";
                             common:normativeStatus common:Normative.
hard:PointingResolution_PIXEL a hard:PointingResolution;
                              rdfs:comment "The pointing device can select an individual pixel";
                              rdfs:label "Pixel Pointing Resolution";
                              common:id "__PointingResolution_Pixel";
                              common:name "pixel";
                              common:normativeStatus common:Normative.
hard:Sibling_Disjoint a common:AllDisjointSet;
                      common:disjointClass "hard:BluetoothProfile",
                                           "hard:PointingResolution",
                                           "hard:BluetoothStatus",
                                           "hard:HardwareStatus".
hard:Sibling_Disjoint2 a common:AllDisjointSet;
                       common:disjointClass "hard:NfcHardware",
                                            "hard:Display",
                                            "hard:BluetoothHardware",
                                            "hard:Camera",
                                            "hard:WiFiHardware",
                                            "hard:Microphone",
                                            "hard:DeviceHardware",
                                            "hard:Battery",
                                            "hard:CPU",
                                            "hard:MemoryUnit",
                                            "hard:Speaker",
                                            "hard:CellularHardware";
                       common:disjointSet hard:Sibling_Disjoint.
hard:Speaker a owl:Class;
             rdfs:comment "This class represents a speaker component in a device";
             rdfs:label "Speaker";
             rdfs:subClassOf hard:OutputDevice.
hard:TactileDisplay a owl:Class;
                    rdfs:comment "A display that is tac-sensitive, allowing users to interact directly with the objects shown on the screen";
                    rdfs:label "Tactile Display";
                    rdfs:subClassOf hard:InputDevice,
                                    hard:Display.
hard:TermGroup_Hardware a common:TermGroup;
                        rdfs:comment "A group of terms with properties, classes and instances that model the hardware elements of a Delivery Context";
                        rdfs:label "Hardware";
                        common:normativeStatus common:Utility;
                        common:termGroupPrefix "hard".
hard:WiFiHardware a owl:Class;
                  rdfs:comment "This class represents  hardware in a device that can be used to access to WiFi networks";
                  rdfs:label "WiFi Hardware";
                  rdfs:subClassOf hard:HardwareComponent.
hard:availableSize a owl:FunctionalProperty,
                     owl:DatatypeProperty;
                   rdfs:comment "This property represents the amount of memory available for use, in bytes";
                   rdfs:domain hard:MemoryUnit;
                   rdfs:label "Available Memory Size";
                   rdfs:range xsd:unsignedLong.
hard:battery a owl:ObjectProperty;
             rdfs:comment "This property represents one or more batteries in a device";
             rdfs:domain hard:DeviceHardware;
             rdfs:label "Battery";
             rdfs:range hard:Battery;
             rdfs:subPropertyOf hard:hardwareComponent.
hard:batteryBeingCharged a owl:FunctionalProperty,
                           owl:DatatypeProperty;
                         rdfs:comment "This property indicates whether the battery is currently being charged or not";
                         rdfs:domain hard:Battery;
                         rdfs:label "Battery Being Charged";
                         rdfs:range xsd:boolean.
hard:batteryCapacity a owl:FunctionalProperty,
                       owl:DatatypeProperty;
                     rdfs:comment "The capacity of a battery, as an amount of electric charge that it can store, measured in ampere-hours";
                     rdfs:domain hard:Battery;
                     rdfs:label "Battery Capacity";
                     rdfs:range xsd:float.
hard:batteryLevel a owl:FunctionalProperty,
                    owl:DatatypeProperty;
                  rdfs:comment "This property holds the percentage of the battery capacity that remains available";
                  rdfs:domain hard:Battery;
                  rdfs:label "Battery Level";
                  rdfs:range xsd:int.
hard:bluetoothAddress a owl:FunctionalProperty,
                        owl:DatatypeProperty;
                      rdfs:comment "The Bluetooth address of the device represented in hexadecimal format. he Bluetooth address will be 12 characters long. Valid characters are 0-9 and A-F";
                      rdfs:domain hard:BluetoothHardware;
                      rdfs:label "Bluetooth Address";
                      rdfs:range xsd:string.
hard:bluetoothName a owl:FunctionalProperty,
                     owl:DatatypeProperty;
                   rdfs:comment "The Bluetooth friendly name of the device";
                   rdfs:domain dcn:Device;
                   rdfs:label "Bluetooth Friendly Name";
                   rdfs:range xsd:string.
hard:bluetoothStatus a owl:FunctionalProperty,
                       owl:ObjectProperty;
                     rdfs:comment "This property indicates the Bluetooth Status of a device";
