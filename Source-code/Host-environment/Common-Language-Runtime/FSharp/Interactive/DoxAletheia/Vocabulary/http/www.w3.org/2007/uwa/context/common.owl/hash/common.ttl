                            rdfs:subClassOf [owl:onProperty java:j2meProfiles ; 
                                             owl:minCardinality "1"^^xsd:int ; 
                                             a owl:Restriction],
                                            [owl:onProperty java:j2meConfigurations ; 
                                             owl:minCardinality "1"^^xsd:int ; 
                                             a owl:Restriction],
                                            [owl:onProperty java:javaPlatforms ; 
                                             owl:hasValue java:JavaPlatform_J2ME ; 
                                             a owl:Restriction],
                                            java:JavaRuntimeEnvironment;
                            common:relatedUAProfEntity "JavaPlatform".
