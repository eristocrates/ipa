                     rdfs:label "Bandwidth Support";
                     rdfs:range net:BandwidthSupport;
                     rdfs:subPropertyOf common:supports.
net:bearerNetwork a owl:FunctionalProperty,
                    owl:ObjectProperty;
                  rdfs:comment "The network that provides the infraestructure of a Network Bearer";
                  rdfs:domain net:NetworkBearer;
                  rdfs:label "Bearer Network";
                  rdfs:range net:Network.
net:bearerTechnology a owl:FunctionalProperty,
                       owl:ObjectProperty;
                     rdfs:comment "The technology used by a Network Bearer";
