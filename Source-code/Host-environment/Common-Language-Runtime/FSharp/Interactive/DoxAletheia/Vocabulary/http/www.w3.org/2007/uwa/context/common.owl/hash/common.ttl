java:J2meConfiguration a owl:Class;
                       rdfs:comment "This class represents J2ME configurations";
                       rdfs:label "J2ME Configuration";
                       rdfs:subClassOf [owl:onProperty java:jsr ; 
                                        owl:cardinality "1"^^xsd:int ; 
