                               <http://rdaregistry.info/Elements/u/P60142>;
            <http://www.w3.org/2002/07/owl#inverseOf> <http://rdaregistry.info/Elements/a/P50071>;
            <http://www.w3.org/2002/07/owl#sameAs> rdae:actor;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a performer contributing to an expression of a work by acting as a cast member or player in a musical or dramatic presentation, etc."@en.
rdae:P20013 <http://metadataregistry.org/uri/profile/RegAp/name> "onScreenPresenter"@en;
            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            a rdf:Property;
