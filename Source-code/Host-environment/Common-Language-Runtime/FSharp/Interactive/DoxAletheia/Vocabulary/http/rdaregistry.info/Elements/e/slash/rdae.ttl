@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdae: <http://rdaregistry.info/Elements/e/>.

<http://metadataregistry.org/uri/RegStatus/1001> a <http://www.w3.org/2004/02/skos/core#Concept>;
                                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Published"@en.
rdae: <http://purl.org/dc/elements/1.1/title> "RDA Expression properties"@en;
      <http://www.w3.org/2004/02/skos/core#note> "Properties derived from RDA elements and relationship designators with the domain of RDA Expression."@en.
rdae:P20001 <http://metadataregistry.org/uri/profile/RegAp/name> "contentType"@en;
            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            a rdf:Property;
            rdfs:domain <http://rdaregistry.info/Elements/c/C10006>;
            rdfs:isDefinedBy rdae:;
            rdfs:label "has content type"@en;
            rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60049>;
            <http://www.w3.org/2002/07/owl#sameAs> rdae:contentType;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a categorization reflecting the fundamental form of communication in which the content is expressed and the human sense through which it is intended to be perceived."@en;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "For content expressed in the form of an image or images, content type also reflects the number of spatial dimensions in which the content is intended to be perceived and the perceived presence or absence of movement."@en.
rdae:P20002 <http://metadataregistry.org/uri/profile/RegAp/name> "identifierForTheExpression"@en;
            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            a rdf:Property;
            rdfs:domain <http://rdaregistry.info/Elements/c/C10006>;
            rdfs:isDefinedBy rdae:;
            rdfs:label "has identifier for the expression"@en;
            rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60052>;
            <http://www.w3.org/2002/07/owl#sameAs> rdae:identifierForTheExpression;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a character string uniquely associated with an expression, or with a surrogate for an expression (e.g., an authority record)."@en;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "The identifier serves to differentiate that expression from other expressions."@en.
rdae:P20003 <http://metadataregistry.org/uri/profile/RegAp/name> "otherDistinguishingCharacteristicOfTheExpression"@en;
            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            a rdf:Property;
            rdfs:domain <http://rdaregistry.info/Elements/c/C10006>;
            rdfs:isDefinedBy rdae:;
            rdfs:label "has other distinguishing characteristic of the expression"@en;
            rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60054>;
            <http://www.w3.org/2002/07/owl#sameAs> rdae:otherDistinguishingCharacteristicOfTheExpression;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a characteristic other than content type, language of expression, or date of expression."@en;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "It serves to differentiate an expression from another expression of the same work."@en.
rdae:P20004 <http://metadataregistry.org/uri/profile/RegAp/name> "dateOfCapture"@en;
            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            a rdf:Property;
            rdfs:domain <http://rdaregistry.info/Elements/c/C10006>;
            rdfs:isDefinedBy rdae:;
            rdfs:label "has date of capture"@en;
            rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60074>;
            <http://www.w3.org/2002/07/owl#sameAs> rdae:dateOfCapture;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a date or range of dates associated with the capture (i.e., recording, filming, etc.) of the content of a resource."@en.
rdae:P20005 <http://metadataregistry.org/uri/profile/RegAp/name> "award"@en;
            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            a rdf:Property;
            rdfs:domain <http://rdaregistry.info/Elements/c/C10006>;
            rdfs:isDefinedBy rdae:;
            rdfs:label "has award"@en;
            rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60090>;
            <http://www.w3.org/2002/07/owl#sameAs> rdae:award;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a formal recognition of excellence, etc., given by an award- or prize-granting body, for the content of a resource."@en.
rdae:P20006 <http://metadataregistry.org/uri/profile/RegAp/name> "languageOfExpression"@en;
            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            a rdf:Property;
            rdfs:domain <http://rdaregistry.info/Elements/c/C10006>;
            rdfs:isDefinedBy rdae:;
            rdfs:label "has language of expression"@en;
            rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60099>;
            <http://www.w3.org/2002/07/owl#sameAs> rdae:languageOfExpression;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a language in which a work is expressed."@en.
rdae:P20007 <http://metadataregistry.org/uri/profile/RegAp/name> "languageOfTheContent"@en;
            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            a rdf:Property;
            rdfs:domain <http://rdaregistry.info/Elements/c/C10006>;
            rdfs:isDefinedBy rdae:;
            rdfs:label "has language of the content"@en;
            rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60099>;
            <http://www.w3.org/2002/07/owl#sameAs> rdae:languageOfTheContent;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a language used to express the content of a resource."@en.
rdae:P20008 <http://metadataregistry.org/uri/profile/RegAp/name> "artisticAndOrTechnicalCredit"@en;
            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            a rdf:Property;
            rdfs:domain <http://rdaregistry.info/Elements/c/C10006>;
            rdfs:isDefinedBy rdae:;
            rdfs:label "has artistic and/or technical credit"@en;
            rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60105>;
            <http://www.w3.org/2002/07/owl#sameAs> rdae:artisticAndOrTechnicalCredit;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a listing of persons, families, or corporate bodies making contributions to the artistic and/or technical production of a resource."@en.
rdae:P20009 <http://metadataregistry.org/uri/profile/RegAp/name> "adaptedAsAMotionPictureExpression"@en;
            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            a rdf:Property;
            rdfs:domain <http://rdaregistry.info/Elements/c/C10006>;
            rdfs:isDefinedBy rdae:;
            rdfs:label "is adapted as motion picture (expression)"@en;
            rdfs:range <http://rdaregistry.info/Elements/c/C10006>;
            rdfs:subPropertyOf rdae:P20153,
                               <http://rdaregistry.info/Elements/u/P60110>;
            <http://www.w3.org/2002/07/owl#inverseOf> rdae:P20125;
            <http://www.w3.org/2002/07/owl#sameAs> rdae:adaptedAsAMotionPictureExpression;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a motion picture based on the source expression."@en.
rdae:P20010 <http://metadataregistry.org/uri/profile/RegAp/name> "noteOnChangesInContentCharacteristics"@en;
            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            a rdf:Property;
            rdfs:domain <http://rdaregistry.info/Elements/c/C10006>;
            rdfs:isDefinedBy rdae:;
            rdfs:label "has note on changes in content characteristics"@en;
            rdfs:subPropertyOf <http://rdaregistry.info/Elements/u/P60123>,
                               rdae:P20071;
            <http://www.w3.org/2002/07/owl#sameAs> rdae:noteOnChangesInContentCharacteristics;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a note on changes in content characteristics that occur in subsequent issues or parts of a resource issued in successive parts or between iterations of an integrating resource."@en.
rdae:P20011 <http://metadataregistry.org/uri/profile/RegAp/name> "conductor"@en;
            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            a rdf:Property;
            rdfs:domain <http://rdaregistry.info/Elements/c/C10006>;
            rdfs:isDefinedBy rdae:;
            rdfs:label "has conductor"@en;
            rdfs:range <http://rdaregistry.info/Elements/c/C10002>;
            rdfs:subPropertyOf rdae:P20039,
                               <http://rdaregistry.info/Elements/u/P60141>;
            <http://www.w3.org/2002/07/owl#inverseOf> <http://rdaregistry.info/Elements/a/P50070>;
            <http://www.w3.org/2002/07/owl#sameAs> rdae:conductor;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an expression to a performer contributing to an expression of a musical work by leading a performing group (orchestra, chorus, opera, etc.) in a musical or dramatic presentation, etc."@en.
rdae:P20012 <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdae:P20070;
            <http://metadataregistry.org/uri/profile/RegAp/name> "actor"@en;
