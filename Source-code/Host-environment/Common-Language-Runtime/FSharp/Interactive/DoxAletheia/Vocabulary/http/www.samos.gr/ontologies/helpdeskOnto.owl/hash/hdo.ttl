@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix gr: <http://purl.org/goodrelations/v1#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#>.
@prefix hdo: <http://www.samos.gr/ontologies/helpdeskOnto.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix org: <http://www.w3.org/ns/org#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix schema: <http://schema.org/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix nsprov: <http://www.w3.org/ns/prov#>.
@prefix regorg: <http://www.w3.org/ns/regorg#>.

<http://linkeddata.ihu.edu.gr/id/company/090344143> a owl:NamedIndividual;
                                                    owl:sameAs hdo:NARA.
<http://publicspending.medialab.ntua.gr/describe/paymentAgents/090344143> a owl:NamedIndividual;
                                                                          owl:sameAs hdo:NARA.
dc11:description a owl:DatatypeProperty.
gr:ProductOrService a owl:Class.
gr:description a owl:DatatypeProperty.
<http://www.samos.gr/ontologies/helpdeskOnto.owl> dc11:creator "K. Kotis"@en;
                                                  dc11:title "HelpDesk support Ontology"@en;
                                                  dcterms:contributor "Nikolaos Loutas, PwC Principal Advisor"@en,
                                                                      "Christopher Gutteridge, University of Southampton Open Data Service"@en;
                                                  dcterms:created "2013-04-10"^^xsd:date;
                                                  dcterms:description "Simple ontology developed for integration purposes. Describe helpdesk entities used to record support tickets for diagnosis and resolve purpuses. The ontology re-uses a) W3C ORG and REGORG ontologies, b) DUL upper ontology, and c) GoodRelations ontology."@en;
                                                  dcterms:modified "2013-04-25"^^xsd:date;
                                                  vann:preferredNamespacePrefix "hdo"@en;
                                                  schema:affiliation "Samos Regional Unit, North Aegean Region Admin. Authority and Department of Digital Systems, University of Piraeus. Greece. +30 6974822712, http://gr.linkedin.com/in/kotis"@en;
                                                  a owl:Ontology;
                                                  rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                                                  rdfs:label "helpdeskOnto.owl"@en;
                                                  owl:imports <http://purl.org/goodrelations/v1>,
                                                              org:,
                                                              regorg:,
                                                              <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl>;
                                                  owl:priorVersion "0.1"@en;
                                                  owl:versionInfo "0.2"@en;
                                                  foaf:homepage "http://www.samos.gr/ontologies/helpdeskOnto.html"^^xsd:anyURI.
hdo:ItDepartment a owl:Class;
                 rdfs:comment "A department in the organization that is responsible for the Information Technology (IT) of the organization."@en;
                 rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                 rdfs:label "Information Technology (IT) department"@en;
                 rdfs:subClassOf org:OrganizationalUnit,
                                 regorg:RegisteredOrganization.
hdo:ItSupportTask a owl:Class;
                  rdfs:comment "A task is an action associated with tickets during an effort to solve an issue/problem in IT."@en;
                  rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                  rdfs:label "IT support task"@en;
                  rdfs:subClassOf [owl:someValuesFrom hdo:ItSupportTicket ; 
                                   owl:onProperty dul:associatedWith ; 
                                   a owl:Restriction],
                                  dul:Task.
hdo:ItSupportTicket a owl:Class;
                    rdfs:comment "Helpdesk support ticket to record some issue with IT to be diagnosed and resolved."@en;
                    rdfs:isDefinedBy <http://www.samos.gr/ontologies/helpdeskOnto.owl>;
                    rdfs:label "IT support Ticket"@en;
                    rdfs:subClassOf [owl:someValuesFrom hdo:ItSupportTask ; 
                                     owl:onProperty dul:associatedWith ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom gr:ProductOrService ; 
                                     owl:onProperty dul:associatedWith ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom hdo:ItDepartment ; 
                                     owl:onProperty nsprov:wasGeneratedBy ; 
                                     a owl:Restriction],
                                    dul:Diagnosis.
hdo:NARA a owl:NamedIndividual,
           org:FormalOrganization,
           regorg:RegisteredOrganization;
         rdfs:comment "This individual is defined for demonstration purposes only and is linked to existing definitions in other LOGD sets "@en;
         rdfs:label "ΠΕΡΙΦΕΡΕΙΑ ΒΟΡΕΙΟΥ ΑΙΓΑΙΟΥ"@el,
                    "North Aegean Regional Administration (NARA)"@en.
hdo:Samos_IT_department_at_NARA a owl:NamedIndividual,
                                  hdo:ItDepartment;
                                rdfs:comment "IT depertment at Samos regional unit of NARA"@en,
                                             "This individual is defined for demonstration purposes only"@en;
                                rdfs:label "Τμήμα Πληροφορικής Περιφερειακής Ενότητας Σάμου"@el,
                                           "Samos IT department at NARA"@en;
                                org:memberOf hdo:NARA.
hdo:taskDescription a owl:DatatypeProperty;
                    rdfs:comment "a task(ation) description"@en;
                    rdfs:domain hdo:ItSupportTask;
                    rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                    rdfs:label "task description"@en;
                    rdfs:range xsd:string;
                    rdfs:subPropertyOf dc11:description,
                                       gr:description.
hdo:taskId a owl:DatatypeProperty;
           rdfs:domain hdo:ItSupportTask;
           rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
           rdfs:label "task identification id"@en;
           rdfs:range xsd:int.
hdo:taskTicketId a owl:DatatypeProperty;
                 rdfs:comment "id number to link task to ticket"@en;
                 rdfs:domain hdo:ItSupportTask;
                 rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                 rdfs:label "task ticket identification id"@en;
                 rdfs:range xsd:int.
hdo:ticketDescription a owl:DatatypeProperty;
                      rdfs:domain hdo:ItSupportTicket;
                      rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                      rdfs:label "ticket description"@en;
                      rdfs:range xsd:string;
                      rdfs:subPropertyOf dc11:description,
                                         gr:description.
hdo:ticketId a owl:DatatypeProperty,
               owl:FunctionalProperty;
             rdfs:domain hdo:ItSupportTicket;
             rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
             rdfs:label "ticket id"@en;
             rdfs:range xsd:int.
hdo:ticketSolution a owl:DatatypeProperty;
                   rdfs:domain hdo:ItSupportTicket;
                   rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                   rdfs:label "ticket solution"@en;
                   rdfs:range xsd:string.
hdo:ticketTitle a owl:AnnotationProperty,
                  owl:DatatypeProperty;
                rdfs:domain hdo:ItSupportTicket;
                rdfs:isDefinedBy <http://www.samos.gr/ontologies/helpdeskOnto.owl>;
                rdfs:label "ticket title"@en;
                rdfs:range xsd:string;
                rdfs:subPropertyOf dc11:title.
