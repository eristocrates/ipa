@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix hdo: <http://www.samos.gr/ontologies/helpdeskOnto.owl#>.

<http://linkeddata.ihu.edu.gr/id/company/090344143> a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                                    <http://www.w3.org/2002/07/owl#sameAs> hdo:NARA.
<http://publicspending.medialab.ntua.gr/describe/paymentAgents/090344143> a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                                                          <http://www.w3.org/2002/07/owl#sameAs> hdo:NARA.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://purl.org/goodrelations/v1#ProductOrService> a <http://www.w3.org/2002/07/owl#Class>.
<http://purl.org/goodrelations/v1#description> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://www.samos.gr/ontologies/helpdeskOnto.owl> <http://purl.org/dc/elements/1.1/creator> "K. Kotis"@en;
                                                  <http://purl.org/dc/elements/1.1/title> "HelpDesk support Ontology"@en;
                                                  <http://purl.org/dc/terms/contributor> "Nikolaos Loutas, PwC Principal Advisor"@en,
                                                                                         "Christopher Gutteridge, University of Southampton Open Data Service"@en;
                                                  <http://purl.org/dc/terms/created> "2013-04-10"^^xsd:date;
                                                  <http://purl.org/dc/terms/description> "Simple ontology developed for integration purposes. Describe helpdesk entities used to record support tickets for diagnosis and resolve purpuses. The ontology re-uses a) W3C ORG and REGORG ontologies, b) DUL upper ontology, and c) GoodRelations ontology."@en;
                                                  <http://purl.org/dc/terms/modified> "2013-04-25"^^xsd:date;
                                                  <http://purl.org/vocab/vann/preferredNamespacePrefix> "hdo"@en;
                                                  <http://schema.org/affiliation> "Samos Regional Unit, North Aegean Region Admin. Authority and Department of Digital Systems, University of Piraeus. Greece. +30 6974822712, http://gr.linkedin.com/in/kotis"@en;
                                                  a <http://www.w3.org/2002/07/owl#Ontology>;
                                                  rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                                                  rdfs:label "helpdeskOnto.owl"@en;
                                                  <http://www.w3.org/2002/07/owl#imports> <http://purl.org/goodrelations/v1>,
                                                                                          <http://www.w3.org/ns/org#>,
                                                                                          <http://www.w3.org/ns/regorg#>,
                                                                                          <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl>;
                                                  <http://www.w3.org/2002/07/owl#priorVersion> "0.1"@en;
                                                  <http://www.w3.org/2002/07/owl#versionInfo> "0.2"@en;
                                                  <http://xmlns.com/foaf/0.1/homepage> "http://www.samos.gr/ontologies/helpdeskOnto.html"^^xsd:anyURI.
hdo:ItDepartment a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A department in the organization that is responsible for the Information Technology (IT) of the organization."@en;
                 rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                 rdfs:label "Information Technology (IT) department"@en;
                 rdfs:subClassOf <http://www.w3.org/ns/org#OrganizationalUnit>,
                                 <http://www.w3.org/ns/regorg#RegisteredOrganization>.
hdo:ItSupportTask a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A task is an action associated with tickets during an effort to solve an issue/problem in IT."@en;
                  rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                  rdfs:label "IT support task"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> hdo:ItSupportTicket ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Task>.
hdo:ItSupportTicket a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Helpdesk support ticket to record some issue with IT to be diagnosed and resolved."@en;
                    rdfs:isDefinedBy <http://www.samos.gr/ontologies/helpdeskOnto.owl>;
                    rdfs:label "IT support Ticket"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> hdo:ItSupportTask ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.org/goodrelations/v1#ProductOrService> ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#someValuesFrom> hdo:ItDepartment ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#wasGeneratedBy> ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Diagnosis>.
hdo:NARA a <http://www.w3.org/2002/07/owl#NamedIndividual>,
           <http://www.w3.org/ns/org#FormalOrganization>,
           <http://www.w3.org/ns/regorg#RegisteredOrganization>;
         rdfs:comment "This individual is defined for demonstration purposes only and is linked to existing definitions in other LOGD sets "@en;
         rdfs:label "ΠΕΡΙΦΕΡΕΙΑ ΒΟΡΕΙΟΥ ΑΙΓΑΙΟΥ"@el,
                    "North Aegean Regional Administration (NARA)"@en.
hdo:Samos_IT_department_at_NARA a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                  hdo:ItDepartment;
                                rdfs:comment "IT depertment at Samos regional unit of NARA"@en,
                                             "This individual is defined for demonstration purposes only"@en;
                                rdfs:label "Τμήμα Πληροφορικής Περιφερειακής Ενότητας Σάμου"@el,
                                           "Samos IT department at NARA"@en;
                                <http://www.w3.org/ns/org#memberOf> hdo:NARA.
hdo:taskDescription a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "a task(ation) description"@en;
                    rdfs:domain hdo:ItSupportTask;
                    rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                    rdfs:label "task description"@en;
                    rdfs:range xsd:string;
                    rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/description>,
                                       <http://purl.org/goodrelations/v1#description>.
hdo:taskId a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:domain hdo:ItSupportTask;
           rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
           rdfs:label "task identification id"@en;
           rdfs:range xsd:int.
hdo:taskTicketId a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "id number to link task to ticket"@en;
                 rdfs:domain hdo:ItSupportTask;
                 rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                 rdfs:label "task ticket identification id"@en;
                 rdfs:range xsd:int.
hdo:ticketDescription a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain hdo:ItSupportTicket;
                      rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                      rdfs:label "ticket description"@en;
                      rdfs:range xsd:string;
                      rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/description>,
                                         <http://purl.org/goodrelations/v1#description>.
hdo:ticketId a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
               <http://www.w3.org/2002/07/owl#FunctionalProperty>;
             rdfs:domain hdo:ItSupportTicket;
             rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
             rdfs:label "ticket id"@en;
             rdfs:range xsd:int.
hdo:ticketSolution a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:domain hdo:ItSupportTicket;
                   rdfs:isDefinedBy "http://www.samos.gr/ontologies/helpdeskOnto.owl";
                   rdfs:label "ticket solution"@en;
                   rdfs:range xsd:string.
hdo:ticketTitle a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain hdo:ItSupportTicket;
                rdfs:isDefinedBy <http://www.samos.gr/ontologies/helpdeskOnto.owl>;
                rdfs:label "ticket title"@en;
                rdfs:range xsd:string;
                rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/title>.
