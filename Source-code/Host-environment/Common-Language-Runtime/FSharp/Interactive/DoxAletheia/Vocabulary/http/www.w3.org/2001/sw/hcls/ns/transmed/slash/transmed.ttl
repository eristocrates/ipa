transmed:TMO_0026 <http://purl.org/dc/elements/1.1/description> "A regulatory authority is an institution created by legislation which acts to control what treatments can be prescribed."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "regulatory authority"@en;
                  rdfs:subClassOf transmed:TMO_0025.
