                                                                           "MSH:D004194",
                                                                           "NCIt:Disease_or_Disorder";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "disease"@en;
                  rdfs:subClassOf transmed:TMO_0084.
transmed:TMO_0048 <http://purl.org/dc/elements/1.1/description> "An allele is a specific variant of a gene."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "SO:0001023";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "allele"@en;
                  rdfs:subClassOf transmed:TMO_0172;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> transmed:TMO_0037 ; 
                                                                                                                   <http://www.w3.org/2002/07/owl#onProperty> transmed:TMO_0216 ; 
                                                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                   transmed:TMO_0215) ; 
                                                                   a <http://www.w3.org/2002/07/owl#Class>].
transmed:TMO_0049 <http://purl.org/dc/elements/1.1/description> "A metabolite role is the role played by a material entity that is a metabolic substrate, intermediate or product."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Galen:Metabolite",
                                                                           "CHEBI:25212",
                                                                           "NCIt:Metabolite",
                                                                           "LNC:LP20702-4",
                                                                           "UMLS:C0870883";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "metabolite role"@en;
                  rdfs:subClassOf transmed:TMO_0073.
transmed:TMO_0050 <http://purl.org/dc/elements/1.1/description> "Drug efficacy is a measure of the capabilty of a drug to produce an intended effect as a function of its concentration."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000124";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "drug efficacy"@en;
                  rdfs:subClassOf transmed:TMO_0100.
transmed:TMO_0051 <http://purl.obolibrary.org/obo/IAO_0000119> "NCI Thesaurus";
                  <http://purl.org/dc/elements/1.1/description> "Treatment safety is a condition that refers to an absence of harmful side effects resulting from use of the product and may be assessed by laboratory testing of biological samples, special tests and procedures, psychiatric evaluation, and/or physical examination of subjects."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000124";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "treatment safety value"@en;
                  rdfs:subClassOf transmed:TMO_0100.
transmed:TMO_0052 <http://purl.org/dc/elements/1.1/description> "A biomarker is a characteristic of a material entity that is objectively measured and evaluated as an indicator of normal biological processes, pathogenic processes, or pharmacologic responses to a therapeutic intervention."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000121",
                                                                           "UMLS:C1955886",
                                                                           "NCIt:Biomarker",
                                                                           "MSH:D054316";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "biomarker"@en;
                  rdfs:subClassOf transmed:TMO_0019.
transmed:TMO_0053 <http://purl.org/dc/elements/1.1/description> "Comparative effectiveness is a drug measure that provides information about which treatment works best, for whom, and under what circumstances."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000121";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "comparative effectiveness"@en;
                  rdfs:subClassOf transmed:TMO_0092.
transmed:TMO_0054 <http://purl.org/dc/elements/1.1/description> "Lifestyle is a description about an individual`s manner of living."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "SNOMEDCT:366925008",
                                                                           "NCIt:Lifestyle",
                                                                           "SNOMEDCT:134436002",
                                                                           "IAO:0000121",
                                                                           "MSH:D008019",
                                                                           "SNOMEDCT:367150003",
                                                                           "UMLS:C0023676";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "lifestyle"@en;
                  rdfs:subClassOf transmed:TMO_0097.
transmed:TMO_0055 <http://purl.org/dc/elements/1.1/description> "A health outcome is a medical measure of health or loss of health."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "linkedct:primary_outcomes",
                                                                           "IAO:0000121",
                                                                           "linkedct:secondary_outcomes";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "health outcome"@en;
                  rdfs:subClassOf transmed:TMO_0135.
transmed:TMO_0056 <http://purl.org/dc/elements/1.1/description> "Toxicity is a quality of a chemical substance which indicates the capacity to cause injury to an organism in a dose dependent manner."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UMLS:C0600688",
                                                                           "NCIt:Toxicity",
                                                                           "MSH:Q000633",
                                                                           "ACGT:Toxicity";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "toxicity"@en;
                  rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Quality>.
transmed:TMO_0057 <http://purl.org/dc/elements/1.1/description> "Dosage is the amount of a chemical administered to, or taken by, an organism and expressed as some function of the organism and of time (mg/kg body weight/day)."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIt:Dose",
                                                                           "EFO:0000428",
                                                                           "SNOMEDCT:260911001",
                                                                           "LNC:LP6801-7",
                                                                           "UMLS:C0178602";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "dosage"@en;
                  rdfs:subClassOf transmed:TMO_0113.
transmed:TMO_0058 <http://purl.org/dc/elements/1.1/description> "A syndrome is a group of signs and symptoms that characterize a particular abnormality."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ACGT:Syndrome",
                                                                           "EFO:0000428",
                                                                           "MSH:D013577",
                                                                           "UMLS:C0039082",
                                                                           "EFO:0000716",
                                                                           "NCIt:Syndrome",
                                                                           "DOID:225";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "syndrome"@en;
                  rdfs:subClassOf transmed:TMO_0084.
transmed:TMO_0059 <http://purl.org/dc/elements/1.1/description> "A hypothesis is an information content entity that describes a possible correlation between two or more variables."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UMLS:C1512571",
                                                                           "OBI:0000074",
                                                                           "NCIt:Hypothesis";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "hypothesis"@en;
                  rdfs:subClassOf transmed:TMO_0089.
transmed:TMO_0060 <http://purl.org/dc/elements/1.1/description> "A clinical subject role is the role played by an organism who is the subject of a clinical procedure or assessment."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "OCRe_clinical:Subject";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "clinical subject role"@en;
                  rdfs:subClassOf transmed:TMO_0006.
transmed:TMO_0061 <http://purl.org/dc/elements/1.1/description> "A side effect is an effect of an intervention, whether therapeutic or adverse, that is secondary to the intended effect of the intervention."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIt:Side_Effect";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "side effect"@en;
                  rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity>.
transmed:TMO_0062 <http://purl.org/dc/elements/1.1/description> "A pharmaceutical ingredient role is a role played by a chemical substance that is part of a pharmaceutical formulation."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "pharmaceutical ingredient role"@en;
                  rdfs:subClassOf transmed:TMO_0073.
transmed:TMO_0063 <http://purl.org/dc/elements/1.1/description> "A chemical substance is a material entity consisting of many chemical entities and typically has connected boundaries."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "chemical substance"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> transmed:TMO_0034 ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.obofoundry.org/ro/ro.owl#has_proper_part> ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  <http://www.ifomis.org/bfo/1.1/snap#MaterialEntity>.
transmed:TMO_0064 <http://purl.org/dc/elements/1.1/description> "An active ingredient role is a role played by a chemical substance which has the disposition to treat a certain disease and is part of a pharmaceutical formulation."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "active ingredient role"@en;
                  rdfs:subClassOf transmed:TMO_0062.
transmed:TMO_0065 <http://purl.org/dc/elements/1.1/description> "An inactive ingredient role is a role played by a chemical substance which is part of a pharmaceutical formulation but does not have the disposition to treat a certain disease."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "inactive ingredient role"@en;
                  rdfs:subClassOf transmed:TMO_0062.
transmed:TMO_0066 <http://purl.org/dc/elements/1.1/description> "A molecular target is a molecular entity that is the target of a transformation process."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "drugbank:targets";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "molecular target"@en;
                  rdfs:subClassOf transmed:TMO_0034;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (transmed:TMO_0034
                                                                                                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> transmed:TMO_0072 ; 
                                                                                                                   <http://www.w3.org/2002/07/owl#onProperty> <http://purl.obolibrary.org/obo/OBI_0000316> ; 
                                                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                   a <http://www.w3.org/2002/07/owl#Class>].
transmed:TMO_0067 a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "protein target"@en;
                  rdfs:subClassOf transmed:TMO_0035;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (transmed:TMO_0035
                                                                                                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> transmed:TMO_0072 ; 
                                                                                                                   <http://www.w3.org/2002/07/owl#onProperty> <http://purl.obolibrary.org/obo/OBI_0000316> ; 
                                                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                   a <http://www.w3.org/2002/07/owl#Class>].
transmed:TMO_0068 <http://purl.org/dc/elements/1.1/description> "A diagnostic criterion is a directive information entity for consideration during a diagnosis which, if satisfied, contributes to a diagnostic result"@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000124";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "diagnostic criterion"@en;
                  rdfs:subClassOf transmed:TMO_0151.
transmed:TMO_0069 <http://purl.org/dc/elements/1.1/description> "A diagnostic inclusion criterion is a diagnostic criterion for consideration during a diagnosis which, if satisfied, supports a diagnostic result."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000124";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "diagnostic inclusion criterion"@en;
                  rdfs:subClassOf transmed:TMO_0068.
transmed:TMO_0070 <http://purl.org/dc/elements/1.1/description> "A diagnostic exclusion criterion is a diagnostic criterion for consideration during a diagnosis which, if satisfied, excludes a diagnostic result."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000124";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "diagnostic exclusion criterion"@en;
                  rdfs:subClassOf transmed:TMO_0068.
transmed:TMO_0071 <http://purl.org/dc/elements/1.1/description> "A pharmaceutical ingredient is a chemical substance that is part of a formulated pharmaceutical that bears a pharmaceutical ingredient role."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "dailymed:ingredients";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "pharmaceutical ingredient"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> transmed:TMO_0001 ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.obofoundry.org/ro/ro.owl#part_of> ; 
