                                   <http://www.w3.org/2002/07/owl#onProperty> <http://purl.obolibrary.org/obo/OBI_0000316> ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> transmed:TMO_0124 ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.obofoundry.org/ro/ro.owl#has_proper_part> ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  transmed:TMO_0045;
                  <http://www.w3.org/2002/07/owl#disjointWith> transmed:TMO_0139,
                                                               transmed:TMO_0036.
transmed:TMO_0047 <http://purl.obolibrary.org/obo/IAO_0000119> """Richard Scheuermann, Werner Ceusters, Barry Smith in \"Toward an Ontological Treatment of Disease and Diagnosis\"""";
                  <http://purl.org/dc/elements/1.1/description> "A quality of an organism which predisposes it to undergo pathological processes because of one or more disorders in that organism."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ACGT:Disease",
                                                                           "LNC:LP21006-9",
                                                                           "DOID:4",
