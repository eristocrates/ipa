transmed:TMO_0093 <http://purl.org/dc/elements/1.1/description> "A measure is an information content entity that describes or quantifies some thing."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "measure"@en;
                  rdfs:subClassOf transmed:TMO_0109.
