                  rdfs:label "disease progression"@en;
                  rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity>.
transmed:TMO_0042 <http://purl.org/dc/elements/1.1/description> "The mechanism of action is a description of processes and behaviour of a biologically active molecule in its administration into a living system."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIt:Mechanism_of_Action";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "mechanism of action"@en;
                  rdfs:subClassOf transmed:TMO_0090.
transmed:TMO_0043 <http://purl.obolibrary.org/obo/IAO_0000119> "CDISC glossary";
                  <http://purl.org/dc/elements/1.1/description> "An adverse drug event is a any untoward medical occurrence in a patient or clinical investigation subject administered a pharmaceutical product and which does not necessarily have a causal relationship with this treatment. An adverse event (AE) can therefore be any unintended sign (including an abnormal laboratory finding), symptom,or disease temporally associated with the use of a medicinal (investigational) product, whether or not related to the medicinal (investigational) product."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "sider:side_effects",
                                                                           "SNOMEDCT:406644009",
                                                                           "MSH:D004362";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "adverse drug event"@en;
                  rdfs:subClassOf transmed:TMO_0061.
transmed:TMO_0044 <http://purl.obolibrary.org/obo/IAO_0000119> "NCI Thesaurus";
                  <http://purl.org/dc/elements/1.1/description> "A pathway is a representation of a set or series of interactions, often forming a network, which biologists have found useful to group together for organizational, historic, biophysical, or other reasons."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IEV:0000001",
                                                                           "NCIt:Pathway",
                                                                           "GRO:Pathway",
                                                                           "Galen:Pathway",
                                                                           "MI:0619";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "pathway"@en;
                  rdfs:subClassOf transmed:TMO_0090.
transmed:TMO_0045 <http://purl.org/dc/elements/1.1/description> "A population is a collection of organisms."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000120",
                                                                           "dcterms:AgentClass",
                                                                           "OCRe_research:Population";
