transmed:TMO_0022 <http://purl.obolibrary.org/obo/IAO_0000119> """Richard Scheuermann, Werner Ceusters, Barry Smith in \"Toward an Ontological Treatment of Disease and Diagnosis\"""";
                  <http://purl.org/dc/elements/1.1/description> "A quality of a patient, a material entity that is part of a patient, or a processual entity that a patient participates in, any one of which is observed in a physical examination and is deemed by the clinician to be of clinical significance."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UMLS:C0311392",
                                                                           "SNOMEDCT:72670004",
                                                                           "NCIt:Sign";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "sign"@en;
                  rdfs:subClassOf transmed:TMO_0019.
transmed:TMO_0023 <http://purl.obolibrary.org/obo/IAO_0000119> """Richard Scheuermann, Werner Ceusters, Barry Smith in \"Toward an Ontological Treatment of Disease and Diagnosis\"""";
                  <http://purl.org/dc/elements/1.1/description> "A quality of a patient that is observed by the patient or a processual entity experienced by the patient, either of which is hypothesized by the patient to be a realization of a disease."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UMLS:C1457887",
                                                                           "NCIt:Symptom",
                                                                           "CPR:symptom",
                                                                           "ACGT:Symptom";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "symptom"@en;
                  rdfs:subClassOf transmed:TMO_0019.
transmed:TMO_0024 <http://purl.org/dc/elements/1.1/description> "A medical measure is a measure that describes or is a measure of medically relevant entities."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "medical measure"@en;
                  rdfs:subClassOf transmed:TMO_0010.
transmed:TMO_0025 <http://purl.org/dc/elements/1.1/description> "An institution is an entity created by legislation or by practice which acts legally in the same way as a person."@en;
