                  rdfs:label "population"@en;
                  rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#MaterialEntity>.
transmed:TMO_0046 <http://purl.org/dc/elements/1.1/description> "An arm of clinical study is a population that participates in a clinical trial and is subject to some intervention."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "linkedct:trial_arm_group",
                                                                           "IAO:0000120";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "arm of clinical study"@en;
