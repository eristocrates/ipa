                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "absent phenotype"@en;
                  rdfs:subClassOf transmed:TMO_0019.
transmed:TMO_0005 <http://purl.org/dc/elements/1.1/description> "A genetic description is a description of the genetic composition of some entity."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "genetic description"@en;
                  rdfs:subClassOf transmed:TMO_0089.
