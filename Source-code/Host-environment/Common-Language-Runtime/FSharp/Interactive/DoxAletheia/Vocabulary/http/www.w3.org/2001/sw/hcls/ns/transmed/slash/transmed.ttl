                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "patent"@en;
                  rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000310>.
transmed:TMO_0013 <http://purl.org/dc/elements/1.1/description> "An exclusion criterion for clinical trial is a clinical trial criterion which, if satisfied, supports the exclusion of candidate patients."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000124";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "exclusion criterion for clinical trial"@en;
                  rdfs:subClassOf transmed:TMO_0077.
transmed:TMO_0014 <http://purl.org/dc/elements/1.1/description> "A inclusion criterion for clinical trial is a clinical trial criterion which, if satisfied, supports the inclusion of candidate patients."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000124";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "inclusion criterion for clinical trial"@en;
                  rdfs:subClassOf transmed:TMO_0077.
transmed:TMO_0015 <http://purl.org/dc/elements/1.1/description> "A diagnostic result is a medical measure of determining the nature of a  problem or illness through medical procedure."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000124";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "diagnostic result"@en;
                  rdfs:subClassOf transmed:TMO_0136.
transmed:TMO_0016 <http://purl.org/dc/elements/1.1/description> "A clinical protocol is a directive information entity about the objective(s), design, methodology, statistical considerations, and organization of a clinical procedure."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000124";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "clinical protocol"@en;
                  rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000033>.
transmed:TMO_0017 <http://purl.org/dc/elements/1.1/description> "Evidence is a group of indicators that are relevant in some decision-making process."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000123",
                                                                           "UMLS:C0332120",
                                                                           "NCIt:Evidence";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "evidence"@en;
                  rdfs:subClassOf transmed:TMO_0109.
transmed:TMO_0018 <http://purl.org/dc/elements/1.1/description> "An environmental description is a description concerning some aspect of a physical environment."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "IAO:0000123";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "environmental description"@en;
                  rdfs:subClassOf transmed:TMO_0089.
transmed:TMO_0019 <http://purl.org/dc/elements/1.1/description> "A phenotype is an observable characteristic of an organism."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "phenotype"@en;
                  rdfs:subClassOf transmed:TMO_0084.
transmed:TMO_0020 <http://purl.org/dc/elements/1.1/description> "A personal medical history is a medical record consisting of a collection of information obtained from the patient and from other sources concerning the patient's health."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "pchr:Encounter",
                                                                           "UMLS:C0262926",
