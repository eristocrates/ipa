transmed:TMO_0117 <http://purl.org/dc/elements/1.1/description> "A magnitude of a genetic marker refers to the the significance of some genetic marker"@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "magnitude of a genetic marker"@en;
                  rdfs:subClassOf transmed:TMO_0102.
transmed:TMO_0118 <http://purl.org/dc/elements/1.1/description> "An indicator is an entity for which its observation/detection is used in some objective."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "indicator"@en;
                  rdfs:subClassOf transmed:TMO_0109.
transmed:TMO_0119 <http://purl.org/dc/elements/1.1/description> "A sequence position is a identifier for an item in a sequence of items and whose numeric value relates to the position of the item from the start of the sequence."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "sequence position"@en;
                  rdfs:subClassOf transmed:TMO_0159.
transmed:TMO_0120 a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "numerical quantity selected from a continuous variable"@en;
                  rdfs:subClassOf transmed:TMO_0099.
transmed:TMO_0121 a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "numerical quantity selected from a discrete variable"@en;
                  rdfs:subClassOf transmed:TMO_0099.
transmed:TMO_0122 <http://purl.org/dc/elements/1.1/description> "A chromosomal nucleotide sequence position is an ordinal number which reflects the position of a nucleotide in relation to the first nucleotide of the same chromosome."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "chromosomal sequence position"@en;
                  rdfs:subClassOf transmed:TMO_0126.
transmed:TMO_0123 <http://purl.org/dc/elements/1.1/description> "An amino acid sequence position indicates the position of an amino acid residue in relation to the start of the peptide chain."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "amino acid sequence position"@en;
                  rdfs:subClassOf transmed:TMO_0119.
transmed:TMO_0124 a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "human"@en;
                  rdfs:subClassOf transmed:TMO_0144;
                  <http://www.w3.org/2002/07/owl#disjointWith> transmed:TMO_0145.
transmed:TMO_0125 <http://purl.org/dc/elements/1.1/description> "A nucleotide sequence position indicates the position of a nucleotide residue in relation to the start of the nucleic acid."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "nucleotide sequence position"@en;
                  rdfs:subClassOf transmed:TMO_0119.
transmed:TMO_0126 <http://purl.org/dc/elements/1.1/description> "A dexoyribonucleotide sequence position is an ordinal number which reflects the position of a deoxyribonucleotide in relation to the first deoxyribonucleotide of the same deoxyribonucleic acid (DNA)."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "deoxyribonucleotide sequence position"@en;
                  rdfs:subClassOf transmed:TMO_0125.
transmed:TMO_0127 <http://purl.org/dc/elements/1.1/description> "A ribonucleotide sequence position is an ordinal number which reflects the position of a ribonucleotide in relation to the first ribonucleotide of the same ribonucleic acid (RNA)."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "ribonucleotide sequence position"@en;
                  rdfs:subClassOf transmed:TMO_0125.
transmed:TMO_0128 <http://purl.org/dc/elements/1.1/description> "A sequence is an ordered list of objects of a specified type."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "sequence"@en;
                  rdfs:subClassOf transmed:TMO_0089.
transmed:TMO_0129 <http://purl.org/dc/elements/1.1/description> "An amino acid sequence is a sequence of amino acids in which a word (1 more more sequence of characters) represents an amino acid and their adjacency indicates their connectivity."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "protein sequence"@en,
                             "amino acid sequence"@en;
                  rdfs:subClassOf transmed:TMO_0128;
                  <http://www.w3.org/2002/07/owl#disjointWith> transmed:TMO_0130.
transmed:TMO_0130 <http://purl.org/dc/elements/1.1/description> "A nucleotide sequence is a sequence of nucleotides in which a word (1 more more sequence of characters) represents a nucleotide and their adjacency indicates their connectivity."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "nucleotide sequence"@en;
                  rdfs:subClassOf transmed:TMO_0128.
transmed:TMO_0131 <http://purl.org/dc/elements/1.1/description> "a DNA sequence is a sequence of characters that represents the composition and connectivity of a a DNA molecule."@en;
