                  rdfs:subClassOf transmed:TMO_0059.
transmed:TMO_0008 <http://purl.org/dc/elements/1.1/description> "A patient role is a role played a human subject that receives medical attention, care or treatment or who is registered with a medical institution with the purpose of receiving medical care when necessary."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "patient role"@en;
                  rdfs:subClassOf transmed:TMO_0060.
transmed:TMO_0009 <http://purl.org/dc/elements/1.1/description> "An medical expert role is a role played by a human in a clinical context who is involved in the assessment or administration of treatment or its results."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "OCRe_clinical:Clinician";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "medical expert role"@en;
                  rdfs:subClassOf transmed:TMO_0074.
transmed:TMO_0010 <http://purl.org/dc/elements/1.1/description> "A biomedical measure is an information content entity that describes or is a measure of biomedically relevant entities."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "biomedical measure"@en;
                  rdfs:subClassOf transmed:TMO_0093.
transmed:TMO_0011 <http://purl.org/dc/elements/1.1/description> "A molecular structure description is a description of a molecule in terms of its composition and connectivity."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Examples: connection table, fragment, pharmacophore.";
                  rdfs:label "molecular structure description"@en;
                  rdfs:subClassOf transmed:TMO_0106.
transmed:TMO_0012 <http://purl.obolibrary.org/obo/IAO_0000119> "American Heritage(R) Stedman's Medical Dictionary";
                  <http://purl.org/dc/elements/1.1/description> "A patent is an information entity granted by a patent office which confers upon the patenter the sole right to make, use and sell an invention for a set period of time."@en;
