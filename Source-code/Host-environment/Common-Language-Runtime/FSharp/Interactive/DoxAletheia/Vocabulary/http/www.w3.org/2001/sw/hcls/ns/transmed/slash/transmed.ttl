                  rdfs:subClassOf transmed:TMO_0029.
transmed:TMO_0033 <http://purl.org/dc/elements/1.1/description> "A drug measure is a biomedical measure that describes or is a measure of drugs or their activies."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "drug measure"@en;
                  rdfs:subClassOf transmed:TMO_0010.
transmed:TMO_0034 <http://purl.org/dc/elements/1.1/description> "Any constitutionally or isotopically distinct atom, molecule, ion, ion pair, radical, radical ion, complex, conformer etc., identifiable as a separately distinguishable entity."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GRO:MolecularEntity",
                                                                           "CHEBI:23367";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "molecular entity"@en;
                  rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#MaterialEntity>.
transmed:TMO_0035 <http://purl.org/dc/elements/1.1/description> "A biological macromolecule that is composed of amino acids linked in a linear sequence (a polypeptide chain)."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GRO:Protein",
