                  rdfs:label "pharmaceutical product"@en;
                  rdfs:subClassOf transmed:TMO_0001.
transmed:TMO_0003 <http://purl.org/dc/elements/1.1/description> "An inactive ingredient is a pharmaceutical ingredient that is part of a pharmaceutical formulation but does not have the disposition to treat a certain disease."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HL7V3.0:IACT";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "inactive ingredient"@en;
                  rdfs:subClassOf transmed:TMO_0071;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (transmed:TMO_0071
                                                                                                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> transmed:TMO_0065 ; 
