                                                                                                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> transmed:TMO_0001 ; 
                                                                                                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.obofoundry.org/ro/ro.owl#part_of> ; 
                                                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                   a <http://www.w3.org/2002/07/owl#Class>].
transmed:TMO_0072 <http://purl.org/dc/elements/1.1/description> "A molecular target role is a role played by a chemical entity in which it is a specific target of an intervention that aims to change it behavior."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "molecular target role"@en;
                  rdfs:subClassOf transmed:TMO_0073.
transmed:TMO_0073 <http://purl.org/dc/elements/1.1/description> "A chemical entity role is a role played by a chemical entity."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "chemical entity role"@en;
                  rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Role>;
                  <http://www.w3.org/2002/07/owl#disjointWith> transmed:TMO_0006,
                                                               transmed:TMO_0221,
                                                               transmed:TMO_0074,
                                                               <http://purl.obolibrary.org/obo/IAO_0000442>.
transmed:TMO_0074 <http://purl.org/dc/elements/1.1/description> "An expert role is a role played by a knowledgeable person."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "expert role"@en;
                  rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Role>;
                  <http://www.w3.org/2002/07/owl#disjointWith> transmed:TMO_0006,
                                                               transmed:TMO_0073,
                                                               transmed:TMO_0221,
                                                               <http://purl.obolibrary.org/obo/IAO_0000442>.
transmed:TMO_0075 <http://purl.org/dc/elements/1.1/description> "A planned process is a process in which specific objectives are realized in a plan designed by some agent."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "OBI:0000011",
                                                                           "BIRNLex:11021";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "planned process"@en;
                  rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/span#ProcessualEntity>.
transmed:TMO_0076 <http://purl.org/dc/elements/1.1/description> "An assay is a planned process with the objective to obtain information about a material entity."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "OBI:0000070",
                                                                           "MSH:Q000032",
                                                                           "Galen:Assay",
                                                                           "cto_asyont:Assay",
                                                                           "PATO:0000003",
                                                                           "SNOMEDCT:272392009",
                                                                           "EFO:0001455",
                                                                           "NCIt:Assay",
                                                                           "UMLS:C1510438",
                                                                           "BIRNLex:11025";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "assay"@en;
                  rdfs:subClassOf transmed:TMO_0075.
transmed:TMO_0077 <http://purl.org/dc/elements/1.1/description> "A clinical trial criterion is a directive information entity which, if satisfied, contributes to the inclusion or exclusion of candidate patients."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "clinical trial criterion"@en;
                  rdfs:subClassOf transmed:TMO_0151.
transmed:TMO_0078 <http://purl.org/dc/elements/1.1/description> "An enzyme is a protein that catalyzes (increases the rate of) a chemical reaction."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "drugbank:enzymes";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "enzyme"@en;
                  rdfs:subClassOf transmed:TMO_0035.
transmed:TMO_0079 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:label "in relation to"@en.
transmed:TMO_0080 <http://purl.org/dc/elements/1.1/description> "In this context, a genotype is a material entity made up of two DNA regions on two homologous chromosomes in a diploid cell. One chromosome is derived from the father and one is derived from the mother. The two DNA regions are located at the same genetic locus on each of the two chromosomes."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "genotype"@en;
                  rdfs:subClassOf transmed:TMO_0228.
transmed:TMO_0081 <http://purl.org/dc/elements/1.1/description> "A haplotype a variant DNA region which contains several smaller variant DNA regions which tend to be inherited together."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "haplotype"@en;
                  rdfs:subClassOf transmed:TMO_0172.
transmed:TMO_0082 <http://purl.org/dc/elements/1.1/description> "A gene variant is a variant of another gene based on some difference in sequence (composition and connectivity)"@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "gene variant"@en;
                  rdfs:subClassOf transmed:TMO_0109.
transmed:TMO_0083 <http://purl.org/dc/elements/1.1/description> "Ethinicity is the quality of an organism that describes membership in a social group based on a common heritage."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "ethnicity"@en;
                  rdfs:subClassOf transmed:TMO_0084.
transmed:TMO_0084 a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "organismal quality"@en;
                  rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Quality>.
transmed:TMO_0085 <http://purl.org/dc/elements/1.1/description> "Age is the temporal quality of an organism that refers to the length of time elapsed since it came into existence. For most animals and humans, age refers to the length of time elapsed since birth."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "age"@en;
                  rdfs:subClassOf transmed:TMO_0084.
transmed:TMO_0086 <http://purl.org/dc/elements/1.1/description> "Sex is an quality that inheres in an organism for which sexual differentiation is required for sexual reproduction."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "sex"@en;
                  rdfs:subClassOf transmed:TMO_0084.
transmed:TMO_0087 <http://purl.org/dc/elements/1.1/description> "Male is a sex quality for which sex organs contain only male gametes"@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "male"@en;
                  rdfs:subClassOf transmed:TMO_0086;
                  <http://www.w3.org/2002/07/owl#disjointWith> transmed:TMO_0088.
transmed:TMO_0088 <http://purl.org/dc/elements/1.1/description> "Female is a sex quality for which sex organs contain only female gametes"@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "female"@en;
                  rdfs:subClassOf transmed:TMO_0086.
transmed:TMO_0089 a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "description"@en;
