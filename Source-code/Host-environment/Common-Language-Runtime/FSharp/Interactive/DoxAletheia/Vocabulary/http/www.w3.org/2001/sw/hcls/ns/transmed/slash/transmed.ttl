                  rdfs:label "formulated pharmaceutical"@en;
                  rdfs:subClassOf transmed:TMO_0063,
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> transmed:TMO_0071 ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.obofoundry.org/ro/ro.owl#has_proper_part> ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>].
transmed:TMO_0002 <http://purl.org/dc/elements/1.1/description> "A pharmaceutical product is a formulated pharmaceutical that has been approved to treat patients."@en;
