transmed:TMO_0000 <http://purl.org/dc/elements/1.1/description> "An active ingredient is a pharmaceutical ingredient that has the disposition to treat a certain disease."@en;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HL7V3.0:ACTI";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "active ingredient"@en;
                  rdfs:subClassOf transmed:TMO_0071;
