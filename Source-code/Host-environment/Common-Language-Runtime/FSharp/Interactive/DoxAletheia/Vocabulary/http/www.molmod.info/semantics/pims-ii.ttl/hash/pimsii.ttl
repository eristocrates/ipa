@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix pimsii: <http://www.molmod.info/semantics/pims-ii.ttl#>.

<http://www.molmod.info/semantics/pims-ii.ttl> <http://purl.org/dc/elements/1.1/description> "The Physicalistic Interpretation of Modelling and Simulation - Interoperability Infrastructure (PIMS-II) is a mid-level ontology with a focus on documenting cognitive processes and epistemic metadata"@en;
                                               <http://purl.org/dc/terms/bibliographicCitation> "Cite this vocabulary as: M. T. Horsch, PIMS-II ontology, http://www.molmod.info/semantics/pims-ii/, version II.1.12a, 2023. Also reference at least one the following papers: (a) http://ceur-ws.org/Vol-2969/paper3-FOUST.pdf (b) http://ceur-ws.org/Vol-3249/paper2-CAOS.pdf"@en;
                                               <http://purl.org/dc/terms/created> "2023-05-04"^^xsd:date;
                                               <http://purl.org/dc/terms/creator> "Martin Thomas Horsch (ORCID 0000-0002-9464-6739)";
                                               <http://purl.org/dc/terms/issued> "2023-05-04"^^xsd:date;
                                               <http://purl.org/dc/terms/license> "https://www.gnu.org/licenses/lgpl-3.0.en.html";
                                               <http://purl.org/dc/terms/publisher> "Innovation Centre for Process Data Technology (Inprodat e.V.)";
                                               <http://purl.org/dc/terms/references> <http://www.molmod.info/semantics/pims-ii-latex-symbols.tex>;
                                               <http://purl.org/dc/terms/title> "Physicalistic Interpretation of Modelling and Simulation - Interoperability Infrastructure (PIMS-II)";
                                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "pims-ii";
                                               <http://purl.org/vocab/vann/preferredNamespaceUri> "http://www.molmod.info/semantics/pims-ii.ttl#";
                                               a <http://www.w3.org/2002/07/owl#Ontology>;
                                               <http://www.w3.org/2002/07/owl#versionIRI> <http://www.molmod.info/semantics/pims-ii/II.1.12a/>;
                                               <http://www.w3.org/2002/07/owl#versionInfo> "PIMS-II version II.1.12a".
pimsii:AbsoluteLaw a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Absolute law, i.e., a law where the necessary entailment of the consequent(s) by the antecedent is expressed in terms of absolute logical/physical necessity";
                   rdfs:label "AbsoluteLaw"@en;
                   rdfs:subClassOf pimsii:Law.
pimsii:AbsoluteModalIRI a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Absolute modal IRI, i.e., the IRI of a relation that is defined by absolute necessity or possibility of another relation. Absolute necessity means 'logical or physical necessity', and absolute possibility means 'logical or physical possibility'. Accordingly, absolute modal relations do not require the specification of a modal context, i.e., the frame of reference for understanding what 'necessity' and 'possibility' mean does not need to be specified. ";
                        rdfs:label "AbsoluteModalIRI"@en;
                        rdfs:subClassOf pimsii:ModalIRI.
pimsii:AbstractModelPropertyClaim a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "Abstract model property claim (CMPC), i.e., a model property claim that is not immediately applied to the corresponding property of a real physical system"@en;
                                  rdfs:label "AbstractModelPropertyClaim"@en;
                                  rdfs:subClassOf pimsii:ModelPropertyClaim;
                                  <http://www.w3.org/2004/02/skos/core#altLabel> "AMPC"@en.
pimsii:Accumulation a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Accumulation, i.e., an information-processing step in which the given information is extended/complemented such that the input (sign) and one or multiple additional representamina (cf. relation isIncludedInAccumulation) are jointly constitutive of the output (interpretant); this includes conditional accumulation, where the choice and the way in which information is combined depends on an accumulation condition (cf. relation isAccumulationConditionIn)";
                    rdfs:label "Accumulation"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAccumulationInputIn] ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObjectInAccumulation] ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAccumulationOutputIn] ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isIncludedInAccumulation] ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    pimsii:InformationProcessing.
pimsii:Action a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Action, i.e., a process that is conducted/undertaken by an agent - the action has exactly one agent";
              rdfs:label "Action"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Agent ; 
                               <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAgentIn] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              pimsii:Process.
pimsii:Agent a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Agent, i.e., an object that interacts with its surroundings by a) perceiving and b) doing, i.e., an object that carries out actions, including perceptive actions"@en;
             rdfs:label "Agent"@en;
             rdfs:subClassOf pimsii:Object.
pimsii:Articulation a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Articulation (collective expression), i.e., a semiotic collective the semiotic members (i.e., realizations) of which are not semiotic collectives, but individual literal (written or digital) or non-literal (e.g., spoken) items with the same semiotic function (or undergoing evaluation whether such a function is present)";
                    rdfs:label "Articulation"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:realizes] ; 
                                     <http://www.w3.org/2002/07/owl#minCardinality> 2  ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    pimsii:SemioticCollective;
                    <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:SemioticCollective ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSemioticMemberOf] ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                    <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#complementOf> pimsii:SemioticCollective] ; 
                                                                     <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:realizes] ; 
                                                                     a <http://www.w3.org/2002/07/owl#Restriction>];
                    <http://www.w3.org/2004/02/skos/core#altLabel> "AN"@en.
pimsii:Assessment a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Assessment (of a cognitive step), i.e., a ground that provides an explanation including a proposition on the extent (quantitatively or qualitatively) to which the grounded cognitive step is reliable/accurate/valid (or similar), why that is the case, and how that relates to the reliability/accuracy/etc. of the preceding step";
                  rdfs:label "Assessment"@en;
                  rdfs:subClassOf pimsii:Ground;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:CognitiveStep ; 
                                                                   <http://www.w3.org/2002/07/owl#onProperty> pimsii:isAssessmentFor ; 
                                                                   a <http://www.w3.org/2002/07/owl#Restriction>].
pimsii:Assignment a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Assignment, i.e., an equality articulation by which a value is assigned to a variable with respect to a particular referent (e.g., T = 200 K for substance o as it was measured in a particular cognitive step); therein, T is the variable, related to the assignment by [inverseOf isVariableInAssignment], 200 K is the value, related to the assignment by [inverseOf isValueInAssignment], and o is the referent, related to the assignment by isAssignmentFor";
                  rdfs:label "Assignment"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Variable ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isVariableInAssignment] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Value ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isValueInAssignment] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> pimsii:isAssignmentFor ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  pimsii:DigitalConventional,
                                  pimsii:EqualityArticulation;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "ASG"@en.
pimsii:BasicGround a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Basic ground, i.e., a ground that is assumed to be valid and reliable a priori; a cognitive step for which there is a basic ground is a presupposition"@en;
                   rdfs:label "BasicGround"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> pimsii:isGroundFor ; 
                                    <http://www.w3.org/2002/07/owl#allValuesFrom> pimsii:Presupposition ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   pimsii:Ground.
pimsii:CanonicalTUCAN a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Canonical TUCAN, i.e., the material identifier as developed within the NFDI4Chem project"@en;
                      rdfs:label "CanonicalTUCAN"@en;
                      rdfs:subClassOf pimsii:MaterialIdentifier.
pimsii:Claim a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Claim, i.e., a proposition that is expressed by an interlocutor or believed/held by an intelligent agent";
             rdfs:label "Claim"@en;
             rdfs:subClassOf pimsii:Proposition;
             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:Proposition
                                                                                                              [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Interlocutor ; 
                                                                                                                                                       <http://www.w3.org/2002/07/owl#onProperty> pimsii:isAssertedBy ; 
                                                                                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                                                       [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:IntelligentAgent ; 
                                                                                                                                                       <http://www.w3.org/2002/07/owl#onProperty> pimsii:isClaimOf ; 
                                                                                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>])])].
pimsii:Cognition a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Cognition, i.e., a process dealing with representamina (signs) consisting either of a single cognitive step, of multiple steps that are connected to each other as a cognitive chain, or of an anchor point for epistemic grounding";
                 rdfs:label "Cognition"@en;
                 rdfs:subClassOf pimsii:Process;
                 <http://www.w3.org/2002/07/owl#unionOf> (pimsii:CognitiveStep
                                                          pimsii:CognitiveChain).
pimsii:CognitiveAction a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Cognitive action, i.e., a cognition that is conducted/undertaken by an agent; the agent of a cognitive action is called its interpreter";
                       rdfs:label "CognitiveAction"@en;
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Agent ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isInterpreterIn] ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       pimsii:Cognition,
                                       pimsii:Action;
                       <http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:Cognition
                                                                       pimsii:Action).
pimsii:CognitiveChain a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Cognitive chain, i.e., a cognition that consists of multiple (sub)steps";
                      rdfs:label "CognitiveChain"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isStepInCognitiveChain] ; 
                                       <http://www.w3.org/2002/07/owl#minCardinality> 2  ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      pimsii:Cognition.
pimsii:CognitiveRupture a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Cognitive rupture, i.e., a cognitive step that constitutes a break in the chain of epistemic grounding";
                        rdfs:label "CognitiveRupture"@en;
                        rdfs:subClassOf pimsii:CognitiveStep.
pimsii:CognitiveStep a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Cognitive step, i.e., an elementary cognition that can form an part of a cognitive chain";
                     rdfs:label "CognitiveStep"@en;
                     rdfs:subClassOf pimsii:Cognition;
                     <http://www.w3.org/2002/07/owl#disjointUnionOf> (pimsii:CognitiveRupture
                                                                      pimsii:Metonymization
                                                                      pimsii:Presupposition
                                                                      pimsii:Semiosis).
pimsii:CognitiveWorkflow a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Cognitive workflow, i.e., a purposefully conducted cognitive chain";
                         rdfs:label "CognitiveWorkflow"@en;
                         rdfs:subClassOf pimsii:CognitiveAction,
                                         pimsii:CognitiveChain,
                                         pimsii:PurposefulAction;
                         <http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:CognitiveChain
                                                                         pimsii:PurposefulAction).
pimsii:Collective a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Collective, i.e., an object that has multiple items as members"@en;
                  rdfs:label "Collective"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMemberOf] ; 
                                   <http://www.w3.org/2002/07/owl#minCardinality> 2  ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  pimsii:Object;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMemberOf] ; 
                                                                   a <http://www.w3.org/2002/07/owl#Restriction>];
                  <http://www.w3.org/2002/07/owl#unionOf> (pimsii:MereotopologicalCollective
                                                           pimsii:SemioticCollective).
pimsii:CollectiveLiteral a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Collective literal, i.e., a semiotic collective the members of which all have a digital, printed, or written textual/numerical form in that they are all instances/copies of the same RDFS literal (or multiple RDFS literals that are very similar, e.g., different ways of spelling/abbreviating the same word or denoting the same number); n.b., collective literals are not permitted to have other semiotic collectives as their semiotic members";
                         rdfs:label "CollectiveLiteral"@en;
                         rdfs:subClassOf pimsii:Articulation;
                         <http://www.w3.org/2002/07/owl#disjointWith> pimsii:CollectiveUtterance;
                         <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> pimsii:isLiterally ; 
                                                                          <http://www.w3.org/2002/07/owl#minCardinality> 1  ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>].
pimsii:CollectiveUtterance a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Collective utterance, i.e., a semiotic collective the members of which do not have digital, printed, or written textual/numerical form and the members of which are all attributed the same semantics and pragmatics; n.b., collective utterances are not permitted to have other semiotic collectives as their semiotic members";
                           rdfs:label "CollectiveUtterance"@en;
                           rdfs:subClassOf pimsii:Articulation;
                           <http://www.w3.org/2002/07/owl#disjointWith> pimsii:CollectiveLiteral.
pimsii:Communication a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Communication, i.e., a cognitive process wherein multiple interlocutors engage in an exchange with another; a communication involves at least one expressive act (with a well defined role, i.e. in terms of participation)";
                     rdfs:label "Communication"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isInterlocutorIn] ; 
                                      <http://www.w3.org/2002/07/owl#minCardinality> 2  ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:ExpressiveAct ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isParticipantIn] ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     pimsii:Cognition.
pimsii:ConceptualIRI a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Conceptual IRI, i.e., the internationalized resource identifier of a concept (i.e., of an owl:Class)";
                     rdfs:label "ConceptualIRI"@en;
                     rdfs:subClassOf pimsii:IRI;
                     <http://www.w3.org/2002/07/owl#disjointWith> pimsii:RelationalIRI.
pimsii:ConceptualKnowledgeClaim a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Conceptual knowledge claim (CKC), i.e., a knowledge claim establishing the ontological status of a lexeme"@en;
                                rdfs:label "ConceptualKnowledgeClaim"@en;
                                rdfs:subClassOf pimsii:KnowledgeClaim;
                                <http://www.w3.org/2002/07/owl#disjointWith> pimsii:PropertyClaim;
                                <http://www.w3.org/2004/02/skos/core#altLabel> "CKC"@en.
pimsii:ConcreteModelPropertyClaim a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "Concrete model property claim (CMPC), i.e., a model property claim that is immediately also applied to the corresponding property of a real physical system"@en;
                                  rdfs:label "ConcretePropertyClaim"@en;
                                  rdfs:subClassOf pimsii:ModelPropertyClaim,
                                                  pimsii:PhysicalPropertyClaim;
                                  <http://www.w3.org/2004/02/skos/core#altLabel> "CMPC"@en.
pimsii:ContextualIRI a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Contextual IRI, i.e., the internationalized resource identifier of a modal context, i.e., the frame of reference for a qualified-modal semiotic collective; that context defines how exactly necessity and possibility are to be understood";
                     rdfs:label "ContextualIRI"@en;
                     rdfs:subClassOf pimsii:IRI;
                     <http://www.w3.org/2002/07/owl#disjointWith> pimsii:RelationalIRI.
pimsii:Conventional a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Conventional, i.e., a semiotic collective articulation the members of which jointly fulfill a certain semiotic function by social convention; e.g., many spoken or written occurrences of the words 'enthalpy of vaporization' or 'latent heat' may act together as a property in this sense";
                    rdfs:label "Conventional"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> pimsii:isRepresentamenFor ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    pimsii:Articulation;
                    <http://www.w3.org/2004/02/skos/core#altLabel> "CV"@en.
pimsii:DataItem a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Data item, i.e., a digital articulation given as a tuple of digital conventionals"@en;
                rdfs:label "DataItem"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSemioticallyConstitutiveOf] ; 
                                 <http://www.w3.org/2002/07/owl#onClass> pimsii:DigitalConventional ; 
                                 <http://www.w3.org/2002/07/owl#minQualifiedCardinality> 2  ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                pimsii:DigitalArticulation;
                <http://www.w3.org/2004/02/skos/core#altLabel> "DI"@en;
                <http://www.w3.org/2004/02/skos/core#example> "e.g., a key-value dyad with a left-hand side and a right-hand side"@en.
pimsii:Dataset a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Dataset, i.e., a digital articulation that is composed of multiple data items that are similar in shape, kind, and content type"@en;
               rdfs:label "Dataset"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSemioticallyConstitutiveOf] ; 
                                <http://www.w3.org/2002/07/owl#onClass> pimsii:DataItem ; 
                                <http://www.w3.org/2002/07/owl#minQualifiedCardinality> 2  ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               pimsii:DigitalArticulation.
pimsii:DigitalArticulation a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Digital articulation, i.e., an articulation the members of which are copies of the same digital content (a file, assignment of a value to a variable, a data set, etc.)"@en;
                           rdfs:label "DigitalArticulation"@en;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSemioticallyConstitutiveOf] ; 
                                            <http://www.w3.org/2002/07/owl#onClass> pimsii:CollectiveLiteral ; 
                                            <http://www.w3.org/2002/07/owl#minQualifiedCardinality> 2  ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           pimsii:Articulation;
                           <http://www.w3.org/2004/02/skos/core#altLabel> "DAN"@en.
pimsii:DigitalConventional a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Digital conventional, i.e., a conventional that is a digital articulation"@en;
                           rdfs:label "DigitalConventional"@en;
                           rdfs:subClassOf pimsii:Conventional,
                                           pimsii:DigitalArticulation;
                           <http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:Conventional
                                                                           pimsii:DigitalArticulation);
                           <http://www.w3.org/2004/02/skos/core#altLabel> "DCV"@en.
pimsii:Duplication a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Duplication, i.e., an information-processing step in which the given information is reproduced, copied, converted into a different, but equivalent format, or any similar procedure; e.g., this may be based on a legisign to which the original (sign) and the duplicate (interpretant) jointly conform or on a semiotic collective of which they both semiotic members";
                   rdfs:label "Duplication"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isOriginalIn] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObjectInDuplication] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isDuplicateIn] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   pimsii:InformationProcessing.
pimsii:Dyad a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Dyad, i.e., a data item by which two conventionals are grouped together; e.g., an equality or inequality articulation";
            rdfs:label "Dyad"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:DigitalConventional ; 
                             <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isFirstInDyad] ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:DigitalConventional ; 
                             <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSecondInDyad] ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            pimsii:DataItem.
pimsii:EPRC a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "EPRC, i.e., an exact-agreement provenance-conscious reproducibility claim"@en;
            rdfs:label "EPRC"@en;
            rdfs:subClassOf pimsii:ExactAgreementReproducibilityClaim,
                            pimsii:ProvenanceConsciousReproducibilityClaim;
            <http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:ExactAgreementReproducibilityClaim
                                                            pimsii:ProvenanceConsciousReproducibilityClaim).
pimsii:EPTRC a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "EPTRC, i.e., an exact-agreement provenance-conscious team-change reproducibility claim"@en;
             rdfs:label "EPTRC"@en;
             rdfs:subClassOf pimsii:EPRC,
                             pimsii:ETRC,
                             pimsii:PTRC;
             <http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:ExactAgreementReproducibilityClaim
                                                             pimsii:ProvenanceConsciousReproducibilityClaim
                                                             pimsii:TeamChangeReproducibilityClaim).
pimsii:ETRC a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "ETRC, i.e., an exact-agreement team-change reproducibility claim"@en;
            rdfs:label "ETRC"@en;
            rdfs:subClassOf pimsii:ExactAgreementReproducibilityClaim,
                            pimsii:TeamChangeReproducibilityClaim;
            <http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:ExactAgreementReproducibilityClaim
                                                            pimsii:TeamChangeReproducibilityClaim).
pimsii:EqualityArticulation a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Equality articulation, i.e., a dyad by which two terms are asserted to be equal or to become equal";
                            rdfs:label "EqualityArticulation"@en;
                            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Term ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isLeftHandSideIn] ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Term ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isRightHandSideIn] ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            pimsii:Dyad;
                            <http://www.w3.org/2004/02/skos/core#altLabel> "EAN"@en.
pimsii:Evaluation a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Evaluation, i.e., a reflection ex post (Reflexion des Vollzugs following Baumann and Tulatz) or redetermination, carried out after an action has terminated, either by the same agent or by somebody else";
                  rdfs:label "Evaluation"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isTelosInEvaluation] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isEvaluatedIn] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  pimsii:Telesis,
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isEvaluationOutcomeIn] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (pimsii:Telesis
                                                                                                                            pimsii:Undertaking)] ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:directlyGrounds] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:GoalDirectedAgent
                                                                                                                                   pimsii:Interlocutor)] ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isEvaluatorIn] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  pimsii:Interpretation;
                  <http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:Telesis
                                                                  pimsii:Interpretation);
                  <http://www.w3.org/2004/02/skos/core#altLabel> "EVA"@en.
pimsii:ExactAgreementReproducibilityClaim a <http://www.w3.org/2002/07/owl#Class>;
                                          rdfs:comment "Exact-agreement reproducibility claim (ERC), i.e., a reproducibility claim obtained as an outcome of an attempt at obtaining exactly the same outcome as the original study"@en;
                                          rdfs:label "ExactAgreementReproducibilityClaim"@en;
                                          rdfs:subClassOf pimsii:ReproducibilityClaim;
                                          <http://www.w3.org/2004/02/skos/core#altLabel> "ERC"@en;
                                          <http://www.w3.org/2004/02/skos/core#scopeNote> "The criterion for an ERC is that it has no outcome paradata - all the outcome metadata are orthodata"@en.
pimsii:Examination a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Examination (by pattern matching & similar), i.e., an observation by which a legisign (specifying patterns or rules) is applied to an examined object, yielding an examination outcome that expresses in what way or to what extent the object matches the legisign";
                   rdfs:label "Examination"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isLegisignIn] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isExaminedIn] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isExaminationOutcomeIn] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   pimsii:Observation;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "EXA"@en.
pimsii:ExperimentalWorkflow a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "experimental workflow, i.e., a cognition that is purposefully conducted in a controlled environment and has at least one measurement as a step";
                            rdfs:label "ExperimentalWorkflow"@en;
                            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Measurement ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isStepInCognitiveChain] ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            pimsii:CognitiveWorkflow.
pimsii:ExpressiveAct a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Expressive act, i.e., a purposeful communication (e.g., a speech act or an analogous digital act of communicating) issued by its agent, the speaker (understood in a generalized sense, i.e., not limited to speech) - the purpose of the action consists of its illocutionary and perlocutionary intent";
                     rdfs:label "ExpressiveAct"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Interlocutor ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSpeakerIn] ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     pimsii:Communication,
                                     pimsii:CognitiveAction,
                                     pimsii:PurposefulAction.
pimsii:GoalDirectedAgent a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "'Goal-directed agents are intelligent agents that have an internal representation of the goals they [tend to] achieve' (Conte, doi:10.1007/978-1-4614-1800-9_158, 2009)"@en;
                         rdfs:label "GoalDirectedAgent"@en;
                         rdfs:subClassOf pimsii:IntelligentAgent;
                         <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Intention ; 
                                                                          <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isGoalFor] ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>];
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Goal-directedness requires an explicit internal representation of intentions/objectives/goals of the agent; that is what distinguishes it from goal orientation. In PIMS-II, goal orientation is denoted by the relation isGoalOf (which does not require an internal mental representation of the goal), whereas conscious goal directedness is denoted by the relation isGoalFor."@en.
pimsii:GoalOrientedAgent a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Goal-oriented agent, i.e., an agent that exhibits the tendency 'to achieve a certain state of the world' (Conte, doi:10.1007/978-1-4614-1800-9_158, 2009)"@en;
                         rdfs:label "GoalOrientedAgent"@en;
                         rdfs:subClassOf pimsii:Agent;
                         <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Intention ; 
                                                                          <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isGoalOf] ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>];
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "A goal of a goal-oriented agent is a descriptor/representamen for that state of the world, and it is also a descriptor/representament for the agent itself. Goal orientation can emerge by a multitude of mechanisms, including natural selection. It does *not* require the agent to be consciously aware of its goals. In PIMS-II, goal orientation is denoted by the relation isGoalOf (which does not require an internal mental representation of the goal), whereas conscious goal directedness is denoted by the relation isGoalFor."@en.
pimsii:Ground a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Ground (of a cognitive step), i.e., a proposition that justifies a cognitive step by explaning it and stating from what preceding step (which directly grounds that step) a sign-object relation is carried over, and in what way";
              rdfs:label "Ground"@en;
              rdfs:subClassOf pimsii:Proposition;
              <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:CognitiveStep ; 
                                                               <http://www.w3.org/2002/07/owl#onProperty> pimsii:isGroundFor ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>].
pimsii:GroundedCognition a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Grounded cognition, i.e., a cognition that is logically preceded by a presupposition such that there is a grounding chain establishing its epistemic status as a grounded cognition";
                         rdfs:label "GroundedCognition"@en;
                         rdfs:subClassOf pimsii:Cognition;
                         <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#unionOf> (pimsii:Presupposition
                                                                                                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Presupposition ; 
                                                                                                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:logicallyPrecedes] ; 
                                                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>])],
                                                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:GroundingChain ; 
                                                                          <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isJustificationFor] ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>].
pimsii:GroundingChain a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Grounding chain, i.e., a cognitive chain that establishes epistemic grounding";
                      rdfs:label "GroundingChain"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isStepInCognitiveChain] ; 
                                       <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (pimsii:GroundingStep
                                                                                                                               pimsii:Presupposition)] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      pimsii:CognitiveChain.
pimsii:GroundingInterpretation a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Grounding interpretation, i.e., an interpretation where the sign is a ground for the considered cognitive step, the object is the considered cognitive step, and the interpretant is a ground for a subsequent cognitive step";
                               rdfs:label "GroundingInterpretation"@en;
                               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:groundsPresentStepIn] ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isPresentStepInGrounding] ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:groundsNextStepIn] ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               pimsii:GroundingStep,
                                               pimsii:Interpretation;
                               <http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:GroundingStep
                                                                               pimsii:Semiosis).
pimsii:GroundingMetonymization a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Grounding metonymization, i.e., a metonymization where a the old referent is a cognitive step (i.e., the grounding step) that grounds another (i.e., the grounded step), which is the new referent; the referent for both is a ground (i.e., the grounding proposition) that is a ground for the grounded step";
                               rdfs:label "GroundingMetonymization"@en;
                               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isGroundingStepIn] ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isGroundingPropositionIn] ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isGroundedStepIn] ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               pimsii:GroundingStep,
                                               pimsii:Metonymization;
                               <http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:GroundingStep
                                                                               pimsii:SemanticChange).
pimsii:GroundingStep a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Grounding step, i.e., a triadic cognition that establishes epistemic grounding";
                     rdfs:label "GroundingStep"@en;
                     rdfs:subClassOf pimsii:TriadicCognition;
                     <http://www.w3.org/2002/07/owl#disjointUnionOf> (pimsii:GroundingMetonymization
                                                                      pimsii:GroundingInterpretation).
pimsii:IRI a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Internationalized resource identifier (IRI) as defined by RFC 3987; an IRI object should be related by 'isLiterally' to an xs:string containing the IRI literal";
           rdfs:label "IRI"@en;
           rdfs:subClassOf pimsii:CollectiveLiteral,
                           pimsii:DigitalArticulation;
           <http://www.w3.org/2002/07/owl#unionOf> (pimsii:ConceptualIRI
                                                    pimsii:ContextualIRI
                                                    pimsii:IndividualIRI
                                                    pimsii:RelationalIRI).
pimsii:IndividualIRI a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Individual IRI, i.e., the internationalized resource identifier of an individual (owl:Thing or pims-ii:Object)";
                     rdfs:label "IndividualIRI"@en;
                     rdfs:subClassOf pimsii:IRI,
                                     pimsii:UniqueIdentifier;
                     <http://www.w3.org/2002/07/owl#disjointWith> pimsii:RelationalIRI.
pimsii:InformationProcessing a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Information processing, i.e., an interpretation in which information is handled, revised, reformatted, extended, or narrowed down (or anything comparable to such actions), e.g., preprocessing or postprocessing in a simulation workflow";
                             rdfs:label "InformationProcessing"@en;
                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isInformationProcessingInputIn] ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObjectInInformationProcessing] ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isInformationProcessingOutputIn] ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             pimsii:Interpretation.
pimsii:IntelligentAgent a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Intelligent agent, i.e., a goal-oriented agent that can internally make/hold claims (knowledge, beliefs, etc.). This requires the agent to have some kind of internal representation of its surroundings, and to store and process information about its surroundings. (Note that this does not require the agent to be queryable for its claims; for that purpose, use KnowledgeBase.)";
                        rdfs:label "IntelligentAgent"@en;
                        rdfs:subClassOf pimsii:GoalOrientedAgent.
pimsii:Intention a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Intention, i.e., a proposition that constitutes an aim or goal"@en;
                 rdfs:label "Intention"@en;
                 rdfs:subClassOf pimsii:Proposition.
pimsii:Interlocutor a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Interlocutor, i.e., an agent that can be addressed and is capable of addressing others in a communication process"@en;
                    rdfs:label "Interlocutor"@en;
                    rdfs:subClassOf pimsii:Agent;
                    <http://www.w3.org/2004/02/skos/core#altLabel> "IO"@en.
pimsii:Interpretation a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Interpretation, i.e., a semiosis where the sign-object relation is carried over from the preceding cognitive step, without the need for the represented object to be present physically";
                      rdfs:label "Interpretation"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSignInInterpretation] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObjectInInterpretation] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isInterpretantInInterpretation] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      pimsii:Semiosis;
                      <http://www.w3.org/2004/02/skos/core#altLabel> "IPR"@en.
pimsii:InvestigationSetup a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Investigation setup, i.e., a metonymization where a sign (e.g., a model and/or open question) that has come up for an 'object of application' (the old referent, e.g., the system to which a use case refers) is reassigned to an 'object of investigation' to which dedicated studies can be applied, such as a system that will be simulated or investigated experimentally; n.b., there needs to be a causal connection between the old and the new referent, i.e., between the object of application and the object of investigation";
                          rdfs:label "InvestigationSetup"@en;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObjectOfApplicationIn] ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSignInInvestigation] ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObjectOfInvestigationIn] ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          pimsii:Metonymization.
pimsii:Item a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Item, i.e., a connected region of spacetime that does not consist of multiple connected components"@en;
            rdfs:label "Item"@en;
            rdfs:subClassOf pimsii:Object;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Alternative definition: An item is an object that cannot be split into two spatiotemporally disconnected parts"@en.
pimsii:KnowledgeBase a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Knowledge base, i.e., an interlocutor that makes a consistent set of claims and will respond consistently if queried; n.b., that propositional content which 'isHeldBy' a knowledge base needs to be invariable over the whole 4D spacetime in which the knowledge base exist. Since technical knowledge bases do happen to change their propositional content over time, it may make sense either to define proper parts with a short temporal extension or to take care with what a knowledge base is stated to hold. Other kinds of propositional content (varying over time or depending on who makes the query) can be said to be asserted rather than held by the knowledge base.";
                     rdfs:label "KnowledgeBase"@en;
                     rdfs:subClassOf pimsii:Interlocutor.
pimsii:KnowledgeBasedAgent a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Knowledge-based agent, i.e., an intelligent agent that uses a knowledge base to store and process its opinions/claims/worldview"@en;
                           rdfs:label "KnowledgeBasedAgent"@en;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:KnowledgeBase ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMereologicallyConstitutiveOf] ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           pimsii:IntelligentAgent.
pimsii:KnowledgeClaim a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Knowledge claim (KC), i.e., a claim about something with respect to its knowledge status"@en;
                      rdfs:label "KnowledgeClaim"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Question ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> pimsii:hasSubjectMatter ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Semiosis ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> pimsii:isInterpretantIn ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      pimsii:Claim;
                      <http://www.w3.org/2002/07/owl#disjointWith> pimsii:ValidityClaim;
                      <http://www.w3.org/2004/02/skos/core#altLabel> "KC"@en;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "The subject matter of a knowledge claim must be a (single) question, namely the one that is answered by the claim; in particular, therefore, its subject matter may not be a sum (plurality) of unrelated questions - in such a case, split it up into multiple independent knowledge claims"@en,
                                                                      "A knowledge claim states 'what data mean,' i.e., in what way some agent of the academic discourse has given some data an interpretation as constituting knowledge. A knowledge claim asserts what was found from research data: 'Research data δ made agent a know φ,' which can be expanded as 'the interpreation of research data δ by interpreter a yielded the knowledge claim φ as an interpretant.'"@en.
pimsii:Law a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Law, i.e., a proposition consisting of an antecedent and one or multiple consequent(s) such that the antecedent is stated to necessarily imply the consequent(s)";
           rdfs:label "Law"@en;
           rdfs:subClassOf pimsii:Rule;
           <http://www.w3.org/2002/07/owl#disjointUnionOf> (pimsii:AbsoluteLaw
                                                            pimsii:QualifiedLaw).
pimsii:Lexeme a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Lexeme, i.e., a semiotic collective the members of which are all instances/utterances/copies of the same word (or a fragment or group of words that fulfills the corresponding function) which acts as a conventional articulation due to social convention; different ways of writing the word, such as an abbreviation and the full version, may belong to the same lexeme";
              rdfs:label "Lexeme"@en;
              rdfs:subClassOf pimsii:CollectiveLiteral,
                              pimsii:Conventional.
pimsii:MaterialIdentifier a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Name or label that identifies the material of its referent, or the material that some semiotic collective is about"@en;
                          rdfs:label "MaterialIdentifier"@en;
                          rdfs:subClassOf pimsii:Name;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "in particular, the TUCAN identifiers from NFDI4Chem can be used".
pimsii:MathematicalOperator a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Mathematical operator, i.e., a lexeme that articulates a mathematical operation, such as the collective containing realizations of '*', '·', 'times', etc.";
                            rdfs:label "MathematicalOperator"@en;
                            rdfs:subClassOf pimsii:Lexeme.
pimsii:Measurement a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Measurement, i.e., an observation that follows a standard procedure, so that it can be expected to yield an objective (rather than subjective) outcome";
                   rdfs:label "Measurement"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMeasurementInputIn] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMeasuredObjectIn] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMeasurementOutcomeIn] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   pimsii:Observation.
pimsii:MeasurementUnit a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Measurement unit, i.e., a 'real scalar quantity, defined and adopted by convention' (EMMO, ISO 80000-1)";
                       rdfs:label "MeasurementUnit"@en;
                       rdfs:subClassOf pimsii:Lexeme.
pimsii:MereotopologicalCollective a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "Mereotopological collective, i.e., a region of spacetime that consists of multiple connected components, which are its mereotopological members"@en;
                                  rdfs:label "MereotopologicalCollective"@en;
                                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMereotopologicalMemberOf] ; 
                                                   <http://www.w3.org/2002/07/owl#minCardinality> 2  ; 
                                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                                  pimsii:Collective;
                                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Item ; 
                                                                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMereotopologicalMemberOf] ; 
                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>].
pimsii:Metonymization a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Metonymization, i.e., a semantic change where there is a causal connection between the old and the new referent, so that the criterion of a 'real causal connection' (between signs and objects) from Peircean semiotics is preserved";
                      rdfs:label "Metonymization"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isOldReferentInMetonymization] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:changesReferentInMetonymization] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isNewReferentInMetonymization] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      pimsii:SemanticChange.
pimsii:ModalIRI a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Modal IRI, i.e., the IRI of a relation that is defined by (absolute or qualified) necessity or possibility of another relation";
                rdfs:label "ModalIRI"@en;
                rdfs:subClassOf pimsii:RelationalIRI;
                <http://www.w3.org/2002/07/owl#disjointUnionOf> (pimsii:AbsoluteModalIRI
                                                                 pimsii:QualifiedModalIRI).
pimsii:ModelPropertyClaim a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Model property claim (MPC), i.e., a PC concerning a property of a model"@en;
                          rdfs:label "PropertyClaim"@en;
                          rdfs:subClassOf pimsii:PropertyClaim;
                          <http://www.w3.org/2002/07/owl#disjointUnionOf> (pimsii:AbstractModelPropertyClaim
                                                                           pimsii:ConcreteModelPropertyClaim);
                          <http://www.w3.org/2004/02/skos/core#altLabel> "MPC"@en;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "Claim expressed through a PC: 'From data δ, property p of object o under conditions c was found by agent a to have the value v'"@en.
pimsii:Modelling a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Modelling, i.e., an interpretation in which the sign is the basis for the modelling process (e.g., an unparameterized or previously parameterized model, knowledge about the modelled system, etc.), the object is the modelled system, and the interpretant is the modelling output (e.g., a parameterized model)";
                 rdfs:label "Modelling"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isModellingInputIn] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isModelledIn] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isModellingOutputIn] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 pimsii:Interpretation.
pimsii:Name a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Name, i.e., a lexeme that acts as a rigid designator due to social convention";
            rdfs:label "Name"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                             <http://www.w3.org/2002/07/owl#onProperty> pimsii:isNameFor ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            pimsii:Lexeme.
pimsii:NegativeKnowledgeClaim a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Negative knowledge claim (NKC), i.e., a knowledge claim that expresses what we don't know, a gap or limitation of our knowledge"@en;
                              rdfs:label "NegativeKnowledgeClaim"@en;
                              rdfs:subClassOf pimsii:KnowledgeClaim;
                              <http://www.w3.org/2004/02/skos/core#altLabel> "NKC"@en.
pimsii:Number a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Number, i.e., a lexeme that is numerical in nature, such as the collective containing realizations of 'two', '2', and '2.0'";
              rdfs:label "Number"@en;
              rdfs:subClassOf pimsii:Lexeme.
pimsii:Object a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Object (PIMS-II top class) = cognizable entity"@en;
              rdfs:label "Object"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                               <http://www.w3.org/2002/07/owl#onProperty> pimsii:isSpatiotemporallyDisconnectedFrom ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                               <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:temporallyPrecedes] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                               <http://www.w3.org/2002/07/owl#onProperty> pimsii:hasProperPart ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                               <http://www.w3.org/2002/07/owl#onProperty> pimsii:temporallyPrecedes ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2002/07/owl#disjointUnionOf> (pimsii:Item
                                                               pimsii:MereotopologicalCollective);
              <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                                               <http://www.w3.org/2002/07/owl#onProperty> pimsii:isProperPartOf ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2004/02/skos/core#scopeNote> "following Peirce, all that exists is regarded as cognizable, i.e., all in principle be referred to by a sign, hence the label 'Object'"@en.
pimsii:Observation a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Observation, i.e., a perception by which characteristic aspects of an object (e.g., a target property or some more complex kind of behaviour) are purposefully investigated through specific means of perception; the procedure and evaluation may occur based on subjective judgement or according to an agreed procedure";
                   rdfs:label "Observation"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObservationInputIn] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObservedIn] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObservationOutcomeIn] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   pimsii:Perception,
                                   pimsii:PurposefulAction.
pimsii:Optimization a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Optimization, i.e., an interpretation in which the sign is the optimization problem, the object is that which the optimization problem is ultimately about, and the interpretant is the optimization output";
                    rdfs:label "Optimization"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:OptimizationProblem ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isOptimizationProblemIn] ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObjectInOptimization] ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isOptimizationOutputIn] ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    pimsii:Interpretation.
pimsii:OptimizationProblem a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Optimization problem, i.e., an intention expressed or expressible in terms of one or multiple objectives (objective space) and one or multiple design parameters (parameter space)"@en;
                           rdfs:label "OptimizationProblem"@en;
                           rdfs:subClassOf pimsii:Intention;
                           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Conventional ; 
                                                                            <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isDesignParameterWithin] ; 
                                                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Conventional ; 
                                                                            <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isOptimizationObjectiveWithin] ; 
                                                                            a <http://www.w3.org/2002/07/owl#Restriction>].
pimsii:OwnClaim a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Own claim, i.e., a claim that is asserted by a self reference (i.e., a/the present interlocutor)"@en;
                rdfs:label "OwnClaim"@en;
                rdfs:subClassOf pimsii:Claim;
                <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:ReferenceToSelf ; 
                                                                 <http://www.w3.org/2002/07/owl#onProperty> pimsii:isAssertedBy ; 
                                                                 a <http://www.w3.org/2002/07/owl#Restriction>];
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Specifically this could be used as a concept to be applied to propositional content of the present knowledge base"@en.
pimsii:PTRC a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "PTRC, i.e., a provenance-conscious team-change reproducibility claim"@en;
            rdfs:label "PTRC"@en;
            rdfs:subClassOf pimsii:ProvenanceConsciousReproducibilityClaim,
                            pimsii:TeamChangeReproducibilityClaim;
            <http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:ProvenanceConsciousReproducibilityClaim
                                                            pimsii:TeamChangeReproducibilityClaim).
pimsii:PartToWhole a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Part-to-whole synecdoche, i.e., a metonymization where the old referent is a spatiotemporal proper part of the new referent (additionally, the old and new referent need to be connected causally)";
                   rdfs:label "PartToWhole"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isOldReferentInPartToWhole] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:changesReferentInPartToWhole] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isNewReferentInPartToWhole] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   pimsii:Synecdoche.
pimsii:Perception a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Perception, i.e., a semiosis in which the referent is a participant (as a perceived object) and therefore needs to be physically present"@en;
                  rdfs:label "Perception"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSignInPerception] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isPerceivedIn] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isInterpretantInPerception] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  pimsii:Semiosis;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "PCN"@en;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "the perception is conducted by an agent, namely, the interpreter who perceives the object"@en.
pimsii:Person a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Person, i.e., an interlocutor that is socially identified as a natural or legal person by social convention that involves using a name (or multiple names) for it as rigid designators";
              rdfs:label "Person"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Name ; 
                               <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isNameFor] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              pimsii:Interlocutor.
pimsii:PhysicalPropertyClaim a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Physical property claim (PPC), i.e., a PC concerning a property of a physical system"@en;
                             rdfs:label "PropertyClaim"@en;
                             rdfs:subClassOf pimsii:PropertyClaim;
                             <http://www.w3.org/2004/02/skos/core#altLabel> "PPC"@en;
                             <http://www.w3.org/2004/02/skos/core#scopeNote> "Claim expressed through a PC: 'From data δ, property p of object o under conditions c was found by agent a to have the value v'"@en.
pimsii:Planning a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Planning, i.e., a reflection ex ante or predetermination, carried out by analysing the perceived present situation in advance of potentially undertaking an action";
                rdfs:label "Planning"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isTelosInPlanning] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSituationInPlanning] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isResolutionInPlanning] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                pimsii:Telesis,
                                pimsii:Perception.
pimsii:Plurality a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Plurality, i.e., a semiotic collective the semiotic members of which are a representational element (referent or representamen) together, whereby all act/contribute in the same way - this latter point distinguishes a plurality from a structure; e.g., the referent of the expression 'the four seasons/quarters of the year' (for a given year, within a given spatial region) is a plurality, and each of the four seasons/quarters is one of its semiotic members";
                 rdfs:label "Plurality"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMemberOfPlurality] ; 
                                  <http://www.w3.org/2002/07/owl#minCardinality> 2  ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 pimsii:SemioticCollective;
                 <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (pimsii:Plurality
                                                                                                                                                        pimsii:Structure)] ; 
                                                               <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSemioticMemberOf] ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMemberOfPlurality] ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2004/02/skos/core#altLabel> "PL"@en.
pimsii:Presupposition a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Presupposition, i.e., a cognition that has a basic ground, so that it is accepted a priori as an ultimate anchor point for epistemic grounding; any cognition that is logically preceded by a presupposition is a grounded cognition";
                      rdfs:label "Presupposition"@en;
                      rdfs:subClassOf pimsii:GroundedCognition;
                      <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:BasicGround ; 
                                                                       <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isGroundFor] ; 
                                                                       a <http://www.w3.org/2002/07/owl#Restriction>].
pimsii:Process a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Process, i.e., a connected region that has at least one participant, an entity with which it overlaps spatiotemporally and that plays a certain role in the process"@en;
               rdfs:label "Process"@en;
               rdfs:subClassOf pimsii:Item;
               <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                                                <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isParticipantIn] ; 
                                                                a <http://www.w3.org/2002/07/owl#Restriction>];
               <http://www.w3.org/2004/02/skos/core#scopeNote> "n.b., 'participation' here does not imply agency, anything that somehow plays a role in the process, and does so by virtue of overlapping with it spatiotemporally, is a participant in it"@en.
pimsii:ProofBasedValidityClaim a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Proof-based validity claim (PVC), i.e., a validity claim obtained by formal verification, i.e., by deductive logical and mathematical reasoning"@en;
                               rdfs:label "ProofBasedValidityClaim"@en;
                               rdfs:subClassOf pimsii:ValidityClaim;
                               <http://www.w3.org/2002/07/owl#disjointWith> pimsii:ReproducibilityClaim,
                                                                            pimsii:TestBasedValidityClaim;
                               <http://www.w3.org/2004/02/skos/core#altLabel> "PVC"@en.
pimsii:Property a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Property, i.e., a variable that is employed for the possible outcome of observations and similar processes (this may include different words used for the same property, in one or multiple languages, and different ways of expressing these words)";
                rdfs:label "Property"@en;
                rdfs:subClassOf pimsii:Variable.
pimsii:PropertyClaim a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Property claim (PC), i.e., a knowledge claim concerning a property"@en;
                     rdfs:label "PropertyClaim"@en;
                     rdfs:subClassOf pimsii:KnowledgeClaim;
                     <http://www.w3.org/2002/07/owl#disjointWith> pimsii:ConceptualKnowledgeClaim;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "PC"@en;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Claim expressed through a PC: 'From data δ, property p of object o under conditions c was found by agent a to have the value v'"@en.
pimsii:Proposition a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Proposition, i.e., a semiotic collective the members of which are collective literals and collective utterances understood to be attributed some joint semantic and/or pragmatic content, or undergoing evaluation jointly for the presence of such a content"@en;
                   rdfs:label "Proposition"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:CollectiveLiteral ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:articulatesLiterally] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#onProperty> pimsii:isAbout ; 
                                    <http://www.w3.org/2002/07/owl#minCardinality> 1  ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   pimsii:SemioticCollective,
                                   [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSemioticMemberOf] ; 
                                    <http://www.w3.org/2002/07/owl#allValuesFrom> pimsii:Articulation ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>];
                   <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Articulation ; 
                                                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:articulates] ; 
                                                                    a <http://www.w3.org/2002/07/owl#Restriction>];
                   <http://www.w3.org/2004/02/skos/core#altLabel> "PN"@en;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Note that this here includes any kind of semiotic collective that fits the given definition; the semantic/pragmatic content may be assertive, but also interrogative or of any other character - in particular, by this definition, 'Question' is a subclass of 'Proposition'"@en.
pimsii:ProvenanceConsciousReproducibilityClaim a <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:comment "Provenance-conscious reproducibility claim (PRC), i.e., a reproducibility claim obtained from an attempt that was subject to the requirement to retain the original research process or aspects of it"@en;
                                               rdfs:label "ProvenanceConsciousReproducibilityClaim"@en;
                                               rdfs:subClassOf pimsii:ReproducibilityClaim;
                                               <http://www.w3.org/2004/02/skos/core#altLabel> "PRC"@en;
                                               <http://www.w3.org/2004/02/skos/core#scopeNote> "The criterion for a PRC is that there are provenance orthodata, not only provenance paradata"@en.
pimsii:PurposefulAction a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Purposeful action, i.e., an action carried out with an aim of which its agent (hence, a goal-directed agent) is aware"@en;
                        rdfs:label "PurposefulAction"@en;
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAgentIn] ; 
                                         <http://www.w3.org/2002/07/owl#allValuesFrom> pimsii:GoalDirectedAgent ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Intention ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAimIn] ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        pimsii:Action.
pimsii:QualifiedLaw a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Qualified law, i.e., a law where the necessary entailment of the consequent(s) by the antecedent is expressed in terms of qualified necessity, to be understood in terms of its modal context";
                    rdfs:label "QualifiedLaw"@en;
                    rdfs:subClassOf pimsii:Law;
                    <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:ContextualIRI ; 
                                                                     <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isContextWithinLaw] ; 
                                                                     a <http://www.w3.org/2002/07/owl#Restriction>];
                    <http://www.w3.org/2004/02/skos/core#altLabel> "QL"@en.
pimsii:QualifiedModalIRI a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Qualified modal IRI, i.e., the IRI of a relation that is defined by qualified necessity or possibility of another relation"@en;
                         rdfs:label "QualifiedModalIRI"@en;
                         rdfs:subClassOf pimsii:ModalIRI;
                         <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:ContextualIRI ; 
                                                                          <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isContextOfRelation] ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>];
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Qualified modal relations require the specification of a modal context, i.e., a frame of reference for understanding what 'necessity' and 'possibility' exactly mean."@en.
pimsii:QuantityValue a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Quantity value, i.e., a value that has a numerical magnitude and a physical unit"@en;
                     rdfs:label "QuantityValue"@en;
                     rdfs:subClassOf pimsii:Value;
                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Number ; 
                                                                                                                      <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMagnitudeOf] ; 
                                                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:MeasurementUnit ; 
                                                                                                                      <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isUnitOf] ; 
                                                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>])].
pimsii:Query a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Query, i.e., a digital articulation of a question"@en;
             rdfs:label "Query"@en;
             rdfs:subClassOf pimsii:DigitalArticulation;
             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (pimsii:DigitalArticulation
                                                                                                              [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Question ; 
                                                                                                              <http://www.w3.org/2002/07/owl#onProperty> pimsii:articulates ; 
                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>])].
pimsii:Question a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Question, i.e., a topical proposition the semantics/pragmatics of which are of interrogative character"@en;
                rdfs:label "Question"@en;
                rdfs:subClassOf pimsii:Topical;
                <http://www.w3.org/2004/02/skos/core#altLabel> "QN"@en;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "A question contains interrogative pronouns or other interrogative elements, such as blank nodes when articulated as a query"@en,
                                                                "Questions are articulated digitally by queries"@en.
pimsii:RationalAgent a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A rational agent is an intelligent agent that exhibits rationality, i.e., a tendency toward maximizing a quantity: The performance measure of the agent."@en;
                     rdfs:label "RationalAgent"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:OptimizationProblem ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isGoalOf] ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     pimsii:IntelligentAgent;
                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Property ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isPerformanceMeasureOf] ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>];
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Similar as in the case of goal-orientation, rationality does *not* require the agent to be aware of its performance measure."@en.
pimsii:ReferenceToSelf a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Reference to self, i.e., an entity for the interlocutor who *is* the present system, i.e., the system containing the present triples, etc., and whose claims are to be accepted as the present system's 'own claims.' A self-reference is an entity that is either identical with the system at hand, namely, the digital infrastructure or other interlocutor that stores the present semantic content, or a component of it"@en;
                       rdfs:label "ReferenceToSelf"@en;
                       rdfs:subClassOf pimsii:Interlocutor;
                       <http://www.w3.org/2004/02/skos/core#example> "If the present triples are processed by a research data infrastructure with a federated architecture, consisting of several repositories (which are interlocutors, i.e., they can be queried and communicate with the outside world), both the research data infrastructure as a whole and the individual repositories are self-references"@en;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "This is relevant for distinguishing anybody's claims from the present system's own claims: If and only if a proposition is asserted by a self-reference, it is an own claim"@en.
pimsii:RelationalIRI a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Relational IRI, i.e., the internationalized resource identifier of a something that can play the role of the predicate in a triple; this includes 'rdf:type', object properties, datatype properties, their negations";
                     rdfs:label "RelationalIRI"@en;
                     rdfs:subClassOf pimsii:IRI;
                     <http://www.w3.org/2002/07/owl#disjointWith> pimsii:ConceptualIRI,
                                                                  pimsii:ContextualIRI,
                                                                  pimsii:IndividualIRI.
pimsii:ReproducibilityClaim a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Reproducibility claim (RC), i.e., a validity claim obtained as an outcome of a reproduction attempt/reproducibility study"@en;
                            rdfs:label "ReproducibilityClaim"@en;
                            rdfs:subClassOf pimsii:QualifiedLaw,
                                            pimsii:ValidityClaim;
                            <http://www.w3.org/2002/07/owl#disjointWith> pimsii:ProofBasedValidityClaim,
                                                                         pimsii:TestBasedValidityClaim;
                            <http://www.w3.org/2004/02/skos/core#altLabel> "RC"@en.
pimsii:ResearchQuestion a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Research question, i.e., a question that could, has been, or is being addressed by scientific research and e.g. could be answered by a knowledge claim formulated on the grounds of scientific research data"@en;
                        rdfs:label "ResearchQuestion"@en;
                        rdfs:subClassOf pimsii:Question;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "RQN"@en.
pimsii:Rule a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Rule, i.e., a proposition consisting of an antecedent and one or multiple consequent(s) such that the antecedent is stated to imply the consequent(s)";
            rdfs:label "Rule"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Proposition ; 
                             <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAntecedentWithin] ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Proposition ; 
                             <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isConsequentWithin] ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Dyad ; 
                             <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:articulates] ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:DigitalArticulation ; 
                             <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isOrthodataWithin] ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            pimsii:Proposition.
pimsii:Selection a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Selection, i.e., an information-processing step in which the given information is narrowed down such that the output (interpretant) is constitutive of the input (sign); this includes conditional selection, where one component of the input or another is retained depending on a selection condition (cf. relation isSelectionConditionIn)";
                 rdfs:label "Selection"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSelectionInputIn] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObjectInSelection] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSelectionOutputIn] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 pimsii:InformationProcessing.
pimsii:SemanticChange a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Semantic change, i.e., a triadic cognition by which a representamen is assigned a new referent";
                      rdfs:label "SemanticChange"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isOldReferentIn] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:changesReferentIn] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isNewReferentIn] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      pimsii:TriadicCognition.
pimsii:Semiosis a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Semiosis, i.e., a triadic congition that relates 'the sign', 'the object', and 'the interpretant' to each other; a semiosis is either a perception (if the object needs to be present and participate physically in the process) or an interpretation (if the physical participation of the object is not inherently necessary)";
                rdfs:label "Semiosis"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSignIn] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObjectIn] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isInterpretantIn] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                pimsii:TriadicCognition;
                <http://www.w3.org/2002/07/owl#disjointUnionOf> (pimsii:Perception
                                                                 pimsii:Interpretation).
pimsii:SemioticCollective a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Semiotic collective, i.e., a collective the semiotic members of which act together as one representational element (i.e., referent or representamen) in a cognitive process";
                          rdfs:label "SemioticCollective"@en;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSemioticMemberOf] ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> 2  ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          pimsii:Collective;
                          <http://www.w3.org/2002/07/owl#disjointUnionOf> (pimsii:Articulation
                                                                           pimsii:Proposition
                                                                           pimsii:Structure
                                                                           pimsii:Plurality);
                          <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Item ; 
                                                                           <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSemioticMemberOf] ; 
                                                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                          [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:CognitiveStep ; 
                                                                           <http://www.w3.org/2002/07/owl#onProperty> pimsii:isRepresentationalElementIn ; 
                                                                           a <http://www.w3.org/2002/07/owl#Restriction>];
                          <http://www.w3.org/2004/02/skos/core#altLabel> "SCO"@en.
pimsii:Simulation a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Simulation, i.e., a purposefully conducted numerical interpretation of simulation input (model, etc.), where the interpretant is the simulation result";
                  rdfs:label "Simulation"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSimulationInputIn] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSimulatedIn] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSimulationOutputIn] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  pimsii:Interpretation,
                                  pimsii:PurposefulAction.
pimsii:SimulationWorkflow a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "simulation workflow, i.e., a cognitive workflow in which simulation plays a major role";
                          rdfs:label "SimulationWorkflow"@en;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Simulation ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isStepInCognitiveChain] ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          pimsii:CognitiveWorkflow.
pimsii:Steering a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Steering, i.e., a reflection in actu (Reflexion im Vollzug following Baumann and Tulatz) or determination, carried out while undertaking an action and playing a role in that action by proper participation";
                rdfs:label "Steering"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isTelosInSteering] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isActionInSteering] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isResolutionInSteering] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                pimsii:Telesis,
                                pimsii:Perception.
pimsii:Structure a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Structure, i.e., a semiotic collective the semiotic members of which complement each other, contributing in different ways (or, at least, not all int the same way) to their joint action as a referent or a representamen";
                 rdfs:label "Structure"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMemberOfStructure] ; 
                                  <http://www.w3.org/2002/07/owl#minCardinality> 2  ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 pimsii:SemioticCollective;
                 <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Structure ; 
                                                               <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSemioticMemberOf] ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isMemberOfStructure] ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>].
pimsii:Synecdoche a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Synecdoche, i.e., a metonymization where a sign is reassigned to a part of its old referent (WholeToPart) or vice versa (PartToWhole)";
                  rdfs:label "Synecdoche"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isOldReferentInSynecdoche] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:changesReferentInSynecdoche] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isNewReferentInSynecdoche] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  pimsii:Metonymization;
                  <http://www.w3.org/2002/07/owl#disjointUnionOf> (pimsii:PartToWhole
                                                                   pimsii:WholeToPart).
pimsii:TeamChangeReproducibilityClaim a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "Team-change reproducibility claim (TRC), i.e., a reproducibility claim obtained as an outcome of a reproducibility study conducted by an independent team"@en;
                                      rdfs:label "TeamChangeReproducibilityClaim"@en;
                                      rdfs:subClassOf pimsii:ReproducibilityClaim;
                                      <http://www.w3.org/2004/02/skos/core#altLabel> "TRC"@en;
                                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Criterion: Interpreter(s) disjoint with the interpreter(s) from the original research process"@en.
pimsii:Telesis a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Telesis (teleological semiosis), i.e., a semiosis where the sign is a telos (aim), the object is an action, claim, or situation against which that aim is evaluated, and the interpretant is a resolution, e.g., a revised objective, plan, or similar evaluation outcome";
               rdfs:label "Telesis"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isTelosIn] ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isResolutionInTelesis] ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               pimsii:Semiosis,
                               pimsii:CognitiveAction,
                               [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObjectInTelesis] ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>];
               <http://www.w3.org/2002/07/owl#disjointUnionOf> (pimsii:Planning
                                                                pimsii:Steering
                                                                pimsii:Evaluation);
               <http://www.w3.org/2004/02/skos/core#altLabel> "TEL"@en.
pimsii:Term a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Term, i.e., a conventional that can evaluate to a value; terms include variables, values, and any mathematically and semantically valid ways of combining variables, values, and mathematical operators - note that it is required for a term to potentially take a value";
            rdfs:label "Term"@en;
            rdfs:subClassOf pimsii:Conventional;
            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Value ; 
                                                             <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAdmissibleValueFor] ; 
                                                             a <http://www.w3.org/2002/07/owl#Restriction>].
pimsii:TestBasedValidityClaim a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Test-based validity claim (TVC), i.e., a validity claim obtained from validation or testing"@en;
                              rdfs:label "TestBasedValidityClaim"@en;
                              rdfs:subClassOf pimsii:ValidityClaim;
                              <http://www.w3.org/2002/07/owl#disjointWith> pimsii:ProofBasedValidityClaim,
                                                                           pimsii:ReproducibilityClaim;
                              <http://www.w3.org/2004/02/skos/core#altLabel> "TVC"@en;
                              <http://www.w3.org/2004/02/skos/core#scopeNote> "Validation and testing are an integral part of the activity by which the validated knowledge claim and/or the associated data are produced, as opposed to reproducibility studies which are done subsequently in a separate activity"@en.
pimsii:Topical a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Topical proposition, i.e., something that can be understood as stating the topic of something"@en;
               rdfs:label "Topical"@en;
               rdfs:subClassOf pimsii:Proposition;
               <http://www.w3.org/2004/02/skos/core#altLabel> "TL"@en;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "In particular, all questions are topical propositions, since they state the topic of their potential answer"@en,
                                                               "A topic can be a product of (sub-)topics, that is the case if two aspects of something are being addressed jointly, with a genuine interaction between multiple factors; in this case, the whole topic is a topical product (subclass of topical), and its factors are related to it by pims-ii:isTopicalFactorIn. But something can also address multiple contributions to its subject matter independently, without a genuine interaction between the parts; in that case, the whole topic is a topical sum (disjoint with topical), its parts are topicals, and they are related to the whole by pims-ii:isTopicalSummandIn"@en.
pimsii:TopicalProduct a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Topical product, i.e., a topical proposition with multiple topical factors"@en;
                      rdfs:label "TopicalProduct"@en;
                      rdfs:subClassOf pimsii:Topical;
                      <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (pimsii:Topical
                                                                                                                                                                pimsii:TopicalSum)] ; 
                                                                       <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isTopicalFactorIn] ; 
                                                                       a <http://www.w3.org/2002/07/owl#Restriction>].
pimsii:TopicalSum a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Topical sum, i.e., a plurality of topical propositions, where the individual elements (summands) don't genuinely interact but are just standing beside each other as independent, unrelated (or not very closely related) parts of what is addressed"@en;
                  rdfs:label "TopicalSum"@en;
                  rdfs:subClassOf pimsii:Plurality;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Topical ; 
                                                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isTopicalSummandIn] ; 
                                                                   a <http://www.w3.org/2002/07/owl#Restriction>];
                  <http://www.w3.org/2004/02/skos/core#altLabel> "TLS"@en.
pimsii:TriadicCognition a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Triadic cognition, i.e., a cognitive step of the type s-o-s' (semiosis) or o-s-o' (semantic change), thus containing three elements, in line with the approach by Peirce";
                        rdfs:label "TriadicCognition"@en;
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Ground ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isGroundFor] ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        pimsii:CognitiveStep,
                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isFirstElementIn] ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSecondElementIn] ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isThirdElementIn] ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        pimsii:CognitiveAction;
                        <http://www.w3.org/2002/07/owl#disjointUnionOf> (pimsii:SemanticChange
                                                                         pimsii:Semiosis).
pimsii:Triple a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Triple, i.e., a subject-predicate-object triple (connected by relations to the IRIs of the subject, predicate, and object)";
              rdfs:label "Triple"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:IRI ; 
                               <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSubjectWithinTriple] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:IRI ; 
                               <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isPredicateWithinTriple] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:IRI ; 
                               <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObjectWithinTriple] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              pimsii:DataItem.
pimsii:Undertaking a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Undertaking, i.e., a metonymization by which a resolution, which was previously determined (by telesis) in response to the pre-existing situation, is actively taken up by the agent, motivating an action";
                   rdfs:label "Undertaking"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSituationInUndertaking] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isResolutionInUndertaking] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isActionInUndertaking] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Telesis ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:directlyGrounds] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   pimsii:Metonymization.
pimsii:UniqueIdentifier a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Unique identifier, i.e., a rigid designator that is applied to exactly one object";
                        rdfs:label "UniqueIdentifier"@en;
                        rdfs:subClassOf pimsii:Name.
pimsii:Validation a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Validation, i.e., an evaluation of a cognition yielding a validity claim as its interpretant"@en;
                  rdfs:label "Validation"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Intention ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isTelosInValidation] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:CognitiveAction ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isValidatedIn] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:ValidityClaim ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isValidationOutcomeIn] ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  pimsii:Evaluation;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "VAL"@en.
pimsii:ValidityClaim a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Validity claim (VC), i.e., a claim about another claim, saying something about that claim's (in-)accuracy or somebody's (dis-)trust in the claim"@en;
                     rdfs:label "ValidityClaim"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Claim ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> pimsii:isAbout ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     pimsii:Claim;
                     <http://www.w3.org/2002/07/owl#disjointWith> pimsii:KnowledgeClaim;
                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Validation ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> pimsii:isValidationOutcomeIn ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>];
                     <http://www.w3.org/2004/02/skos/core#altLabel> "VC"@en.
pimsii:Value a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Value, i.e., an articulation that is by social convention understood to be potentially assignable to a variable";
             rdfs:label "Value"@en;
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Variable ; 
                              <http://www.w3.org/2002/07/owl#onProperty> pimsii:isAdmissibleValueFor ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             pimsii:Term.
pimsii:Variable a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Variable, i.e., a conventional that is employed for something to which values can be assigned (this may include different notations for the same variable including, e.g., computational representations); this is to be understood very generally, e.g., a variable may be an array or set of elements or have another kind of internal structure";
                rdfs:label "Variable"@en;
                rdfs:subClassOf pimsii:Term.
pimsii:Visualization a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Visualization, i.e., an interpretation in which the object is the visualized system and the interpretant is a visual representation of the object - the sign is a pre-existing representamen for the same object, e.g., a simulation result";
                     rdfs:label "Visualization"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isVisualizationInputIn] ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isVisualizedObjectIn] ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isVisualizationOutputIn] ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     pimsii:Interpretation.
pimsii:WholeToPart a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Whole-to-part synecdoche, i.e., a metonymization where the new referent is a spatiotemporal proper part of the old referent (additionally, the old and new referent need to be connected causally)";
                   rdfs:label "WholeToPart"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isOldReferentInWholeToPart] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:changesReferentInWholeToPart] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isNewReferentInWholeToPart] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   pimsii:Synecdoche.
pimsii:affirmsCognition a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "(x affirmsCognition y) means that x is about the cognition y, affirming its validity"@en;
                        rdfs:label "affirmsCognition"@en;
                        rdfs:range pimsii:Cognition;
                        rdfs:subPropertyOf pimsii:isAbout;
                        <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:providesJustification
                                                                            pimsii:isJustificationFor);
                        <http://www.w3.org/2004/02/skos/core#altLabel> "\\hat{A}_\\kappa"@en.
pimsii:articulates a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "(x articulates y) means that x is a semiotic member of the proposition y, giving a literal or non-literal (e.g., spoken) expression to its propositional content; n.b., x may also express other propositions beside y"@en;
                   rdfs:domain pimsii:Articulation;
                   rdfs:label "articulates"@en;
                   rdfs:range pimsii:Proposition;
                   rdfs:subPropertyOf pimsii:isSemioticMemberOf;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "\\lhd_a"@en.
pimsii:articulatesLiterally a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "(x articulatesLiterally y) means that x is a collective literal expressing the proposition y, and possibly additional propositions beside y";
                            rdfs:domain pimsii:CollectiveLiteral;
                            rdfs:label "articulatesLiterally"@en;
                            rdfs:range pimsii:Proposition;
                            rdfs:subPropertyOf pimsii:articulates.
pimsii:articulatesNonliterally a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "(x articulatesNonliterally y) means that x is a collective non-literal expression (e.g., an utterance) of proposition y, and possibly additional propositions beside y";
                               rdfs:domain [<http://www.w3.org/2002/07/owl#complementOf> pimsii:CollectiveLiteral],
                                           pimsii:Articulation;
                               rdfs:label "articulatesNonliterally"@en;
                               rdfs:range pimsii:Proposition;
                               rdfs:subPropertyOf pimsii:articulates.
pimsii:changesReferentIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "(x changesReferentIn y) == y is a semantic change where x acts as the representamen, i.e., the second element";
                         rdfs:label "changesReferentIn"@en;
                         rdfs:range pimsii:SemanticChange;
                         rdfs:subPropertyOf pimsii:isSecondElementIn,
                                            pimsii:isRepresentamenIn.
pimsii:changesReferentInMetonymization a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:comment "(x changesReferentInMetonymization y) == y is a metonymization where x acts as the representamen, i.e., the second element";
                                       rdfs:label "changesReferentInMetonymization"@en;
                                       rdfs:range pimsii:Metonymization;
                                       rdfs:subPropertyOf pimsii:changesReferentIn.
pimsii:changesReferentInPartToWhole a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "(x changesReferentInPartToWhole y) == y is a part-to-whole synecdoche where x acts as the representamen, i.e., the second element";
                                    rdfs:label "changesReferentInPartToWhole"@en;
                                    rdfs:range pimsii:PartToWhole;
                                    rdfs:subPropertyOf pimsii:changesReferentInSynecdoche.
pimsii:changesReferentInSynecdoche a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "(x changesReferentInSynecdoche y) == y is a synecdoche where x acts as the representamen, i.e., the second element";
                                   rdfs:label "changesReferentInSynecdoche"@en;
                                   rdfs:range pimsii:Synecdoche;
                                   rdfs:subPropertyOf pimsii:changesReferentInMetonymization.
pimsii:changesReferentInWholeToPart a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "(x changesReferentInWholeToPart y) == y is a whole-to-part synecdoche where x acts as the representamen, i.e., the second element";
                                    rdfs:label "changesReferentInWholeToPart"@en;
                                    rdfs:range pimsii:WholeToPart;
                                    rdfs:subPropertyOf pimsii:changesReferentInSynecdoche.
pimsii:describesMethodAppliedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "(x describesMethodAppliedIn y) means that x describes y in terms of the method that is employed"@en;
                                rdfs:domain [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Agent ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> pimsii:describesMethodEmployedBy ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            pimsii:Articulation;
                                rdfs:label "describesMethodAppliedIn"@en;
                                rdfs:range pimsii:Action;
                                rdfs:subPropertyOf pimsii:isRepresentamenFor;
                                <http://www.w3.org/2004/02/skos/core#altLabel> "\\v{R}"@en.
pimsii:describesMethodEmployedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "(x describesMethodEmployedBy y) means that the agent y follows a methodology described by x in carrying out an action"@en;
                                 rdfs:domain [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> pimsii:isRepresentamenFor ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             pimsii:Articulation;
                                 rdfs:label "describesMethodEmployedBy"@en;
                                 rdfs:range pimsii:Agent;
                                 rdfs:subPropertyOf pimsii:msIRHPIP;
                                 <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:describesMethodAppliedIn
                                                                                     [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAgentIn]).
pimsii:directlyGrounds a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "(x directlyGrounds y) == x is the cognitive step (or basic ground) that directly precedes y logically, such that a dyadic representation relation from y is taken over from x (or assumed to be grounded a priori due to x)";
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (pimsii:TriadicCognition
                                                                             pimsii:Presupposition)];
                       rdfs:label "directlyGrounds"@en;
                       rdfs:range pimsii:CognitiveStep;
                       rdfs:subPropertyOf pimsii:directlyPrecedesCognitiveStep,
                                          pimsii:logicallyPrecedes;
                       <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:isGroundingStepIn
                                                                           [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isGroundedStepIn]);
                       <http://www.w3.org/2004/02/skos/core#altLabel> "\\hookrightarrow"@en.
pimsii:directlyPrecedesByRupture a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "(x directlyPrecedesByRupture y) == x is the cognitive step that directly precedes y logically (and typically, y takes over a dyadic representation relation from x), but either x or y constitutes a cognitive rupture, i.e., it interrupts the chain of grounding";
                                 rdfs:domain pimsii:CognitiveStep;
                                 rdfs:label "directlyPrecedesByRupture"@en;
                                 rdfs:range pimsii:CognitiveStep;
                                 rdfs:subPropertyOf pimsii:directlyPrecedesCognitiveStep.
pimsii:directlyPrecedesCognitiveStep a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:comment "(x directlyPrecedesCognitiveStep y) == x is the cognitive step (or basic ground) that directly precedes y logically; typically, this means that y takes over a dyadic representation relation from x";
                                     rdfs:label "directlyPrecedesCognitiveStep"@en;
                                     rdfs:subPropertyOf pimsii:directlyPrecedesStep.
pimsii:directlyPrecedesStep a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "(x directlyPrecedesStep y) means that x and y are processes such that y can commence when x (and possibly other steps that also directly precede y) has finished"@en;
                            rdfs:domain pimsii:Process;
                            rdfs:label "directlyPrecedesStep"@en;
                            rdfs:range pimsii:Process;
                            rdfs:subPropertyOf pimsii:precedesStep,
                                               pimsii:hasDirectCausalConnectionWith;
                            <http://www.w3.org/2004/02/skos/core#altLabel> "\\ddot\\hookrightarrow"@en;
                            <http://www.w3.org/2004/02/skos/core#scopeNote> "(x directlyPrecedesStep y) implies that there is a direct causal connection between x and y"@en.
pimsii:doesNotOverlapWith a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                            <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                          rdfs:comment "(x doesNotOverlapWith y) is the negation of (x overlapsWith y); i.e., the spatiotemporal intersection of x and y is empty"@en;
                          rdfs:label "doesNotOverlapWith"@en;
                          rdfs:subPropertyOf pimsii:isMereosemioticallyRelatedTo;
                          <http://www.w3.org/2004/02/skos/core#altLabel> "\\lnot(\\dot{P}^-\\dot{P})"@en.
pimsii:doesNotTemporallyOverlapWith a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                      <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                                    rdfs:comment "(x doesNotTemporallyOverlapWith y) is the negation of (x temporallyOverlapsWith y); i.e., there is no temporal overlap between x and y"@en;
                                    rdfs:label "doesNotTemporallyOverlapWith"@en;
                                    rdfs:subPropertyOf pimsii:doesNotOverlapWith;
                                    <http://www.w3.org/2004/02/skos/core#altLabel> "\\lnot(\\equiv_t\\dot{P}^-\\dot{P})"@en.
pimsii:groundsNextStepIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "(x groundsNextStepIn y) == y is a grounding interpretation where x is the third element, i.e., a ground for the subsequent cognitive step; thereby, x also serves as a ground for y itself";
                         rdfs:domain pimsii:Ground;
                         rdfs:label "groundsNextStepIn"@en;
                         rdfs:range pimsii:GroundingInterpretation;
                         rdfs:subPropertyOf pimsii:isInterpretantInInterpretation,
                                            pimsii:isGroundFor.
pimsii:groundsPresentStepIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "(x groundsPresentStepIn y) == y is a grounding interpretation where x is the first element, i.e., a ground for the considered cognitive step";
                            rdfs:domain pimsii:Ground;
                            rdfs:label "groundsPresentStepIn"@en;
                            rdfs:range pimsii:GroundingInterpretation;
                            rdfs:subPropertyOf pimsii:isSignInInterpretation.
pimsii:hasAbsoluteNecessityMode a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "(x hasAbsoluteNecessityMode y) means that x is a relational IRI and y is an absolute modal IRI for 'necessarily x'"@en;
                                rdfs:domain pimsii:RelationalIRI;
                                rdfs:label "hasAbsoluteNecessityMode"@en;
                                rdfs:range pimsii:AbsoluteModalIRI;
                                rdfs:subPropertyOf pimsii:hasNecessityMode.
pimsii:hasAbsolutePossibilityMode a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "(x hasAbsolutePossibilityMode y) means that x is a relational IRI and y is an absolute modal IRI for 'possibly x'"@en;
                                  rdfs:domain pimsii:RelationalIRI;
                                  rdfs:label "hasAbsolutePossibilityMode"@en;
                                  rdfs:range pimsii:AbsoluteModalIRI;
                                  rdfs:subPropertyOf pimsii:hasPossibilityMode.
pimsii:hasCausalConnectionWith a <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                                 <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                                 <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                                 <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "'Real causal connection' relation following Peirce, here, given by the transitive closure of 'hasDirectCausalConnectionWith'"@en;
                               rdfs:label "hasCausalConnectionWith"@en;
                               rdfs:subPropertyOf pimsii:isMereosemioticallyRelatedTo;
                               <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:isNewReferentInMetonymization
                                                                                   [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isOldReferentInMetonymization]),
                                                                                  (pimsii:isOldReferentInMetonymization
                                                                                   [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isNewReferentInMetonymization]);
                               <http://www.w3.org/2004/02/skos/core#altLabel> "\\dot{C}^\\star"@en;
                               <http://www.w3.org/2004/02/skos/core#scopeNote> "this is to be understood broadly, as in Peirce, and can be a very indirect connection; here, this is relevant as follows: a) in a grounded cognition, there are only dyadic representation relations between representamina and their referents that have a real causal connection with each other; b) in a metonymization, there must be a real causal connection between the old and the new referent"@en.
pimsii:hasDirectCausalConnectionWith a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                       <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                                       <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                                     rdfs:comment "Direct causal connection (in a broad sense)"@en;
                                     rdfs:label "hasDirectCausalConnectionWith"@en;
                                     rdfs:subPropertyOf pimsii:hasCausalConnectionWith;
                                     <http://www.w3.org/2004/02/skos/core#altLabel> "\\dot{C}"@en;
                                     <http://www.w3.org/2004/02/skos/core#scopeNote> "in particular, x and y are directly causally connected if (x isParticipantIn y), or if x and y are both steps in a process where x directly precedes y; however, spatiotemporal parthood is not enough to justify causal connectedness - x must actually play a role in bringing about y, or vice versa"@en.
pimsii:hasImproperPart a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                         <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                         <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                       rdfs:comment "Spatiotemporal (mereological) improper parthood relation; in other words, it is the reflexive closure of proper parthood: (x hasImproperPart y) means that all points within y are also within x";
                       rdfs:label "hasImproperPart"@en;
                       rdfs:subPropertyOf pimsii:overlapsWith;
                       <http://www.w3.org/2002/07/owl#inverseOf> pimsii:isImproperPartOf.
pimsii:hasNecessityMode a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "(x hasNecessityMode y) means that x is a relational IRI and y is a modal IRI for 'necessarily x'"@en;
                        rdfs:domain pimsii:RelationalIRI;
                        rdfs:label "hasNecessityMode"@en;
                        rdfs:range pimsii:ModalIRI;
                        rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:hasNegation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "(x hasNegation y) means that x and y are IRIs that can possibly occur in the predicate (middle) position of a triple, and that y is 'not x'; n.b., this is not a symmetrical relation, since 'not not x' is syntactically different from x";
                   rdfs:domain pimsii:RelationalIRI;
                   rdfs:label "hasNegation"@en;
                   rdfs:range pimsii:RelationalIRI;
                   rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:hasPossibilityMode a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x hasPossibilityMode y) means that x is a relational IRI and y is a modal IRI for 'possibly x'"@en;
                          rdfs:domain pimsii:RelationalIRI;
                          rdfs:label "hasPossibilityMode"@en;
                          rdfs:range pimsii:ModalIRI;
                          rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:hasProperPart a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                       <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                     rdfs:comment "(x hasProperPart y) means that y is an improper part of x such that x and y are not the same, in other words, all points within y are also within x, but not vice versa"@en;
                     rdfs:label "hasProperPart"@en;
                     rdfs:subPropertyOf pimsii:hasImproperPart;
                     <http://www.w3.org/2002/07/owl#inverseOf> pimsii:isProperPartOf;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "\\dot{P}^-"@en;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Spatiotemporal (mereological) proper parthood relation"@en.
pimsii:hasQualifiedNecessityMode a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "(x hasQualifiedNecessityMode y) means that x is a relational IRI and y is a qualified modal IRI for 'necessarily x'"@en;
                                 rdfs:domain pimsii:RelationalIRI;
                                 rdfs:label "hasQualifiedNecessityMode"@en;
                                 rdfs:range pimsii:QualifiedModalIRI;
                                 rdfs:subPropertyOf pimsii:hasNecessityMode.
pimsii:hasQualifiedPossibilityMode a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "(x hasQualifiedPossibilityMode y) means that x is a relational IRI and y is a qualified modal IRI for 'possibly x'"@en;
                                   rdfs:domain pimsii:RelationalIRI;
                                   rdfs:label "hasQualifiedPossibilityMode"@en;
                                   rdfs:range pimsii:QualifiedModalIRI;
                                   rdfs:subPropertyOf pimsii:hasPossibilityMode.
pimsii:hasRepresentamen a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Dyadic representation relation; (x hasRepresentamen y) means that there is a cognitive step z such that (x isReferentIn z) and (y isRepresentamenIn z)"@en;
                        rdfs:label "hasRepresentamen"@en;
                        rdfs:subPropertyOf pimsii:msHRHPIP,
                                           pimsii:msHPIPHR,
                                           pimsii:msHRIRHR;
                        <http://www.w3.org/2002/07/owl#inverseOf> pimsii:isRepresentamenFor;
                        <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:isReferentIn
                                                                            [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isRepresentamenIn]);
                        <http://www.w3.org/2004/02/skos/core#altLabel> "R^-"@en.
pimsii:hasSubjectMatter a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                          <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                        rdfs:comment "(x hasSubjectMatter y) means that x is a proposition or articulation that addresses the topic or sum (i.e., plurality) of topics y, i.e., that has y as its subject matter"@en;
                        rdfs:label "hasSubjectMatter"@en;
                        rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (pimsii:Topical
                                                                             pimsii:TopicalSum)];
                        rdfs:subPropertyOf pimsii:isAbout;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "A"@en;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "following Yablo, there is such a thing as *the* subject matter of something, in other words, hasSubjectMatter is a functional property"@en.
pimsii:isAbout a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "(x isAbout y) means that x is a proposition and y is the object that x is related to by aboutness"@en;
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (pimsii:Articulation
                                                                     pimsii:Proposition)];
               rdfs:label "isAbout"@en;
               rdfs:subPropertyOf pimsii:isRepresentamenFor;
               <http://www.w3.org/2004/02/skos/core#altLabel> "\\hat{A}"@en;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "it can make sense to use a structure or plurality to indicate the complex ways in which x can be about a combination of interrelated objects"@en.
pimsii:isAccumulationConditionIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "(x isAccumulationConditionIn y) == in the accumulation process y, the condition x controls in what way the input and the additionally included elements interact to yield a combined output";
                                 rdfs:domain pimsii:Proposition;
                                 rdfs:label "isAccumulationConditionIn"@en;
                                 rdfs:range pimsii:Accumulation;
                                 rdfs:subPropertyOf pimsii:isRepresentamenFor.
pimsii:isAccumulationInputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "(x isAccumulationInputIn y) == y is an accumulation where x is the input (initially given information), i.e., the first element; n.b., in an accumulation, the input needs to be constitutive of the output";
                             rdfs:label "isAccumulationInputIn"@en;
                             rdfs:range pimsii:Accumulation;
                             rdfs:subPropertyOf pimsii:isInformationProcessingInputIn.
pimsii:isAccumulationOutputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isAccumulationOutputIn y) == y is an accumulation where x is the output (combined information), i.e., the third element; n.b., in a selection, the input and any additionally included elements need to be constitutive of the output";
                              rdfs:label "isAccumulationOutputIn"@en;
                              rdfs:range pimsii:Accumulation;
                              rdfs:subPropertyOf pimsii:isInformationProcessingOutputIn.
pimsii:isActionInSteering a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x isActionInSteering y) == y is a steering operation (reflection in actu) where x is an ongoing action, i.e., the second element, against which the telos is evaluated";
                          rdfs:domain pimsii:Action;
                          rdfs:label "isActionInSteering"@en;
                          rdfs:range pimsii:Steering;
                          rdfs:subPropertyOf [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isProperParticipantIn],
                                             pimsii:isObjectInTelesis,
                                             pimsii:isPerceivedIn.
pimsii:isActionInUndertaking a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "(x isActionInUndertaking y) == y is an undertaking where x is the action that is undertaken, i.e., the third element";
                             rdfs:domain pimsii:Action;
                             rdfs:label "isActionInUndertaking"@en;
                             rdfs:range pimsii:Undertaking;
                             rdfs:subPropertyOf [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:temporallyPrecedes],
                                                pimsii:isNewReferentInMetonymization.
pimsii:isAdmissibleUnitFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "(x isAdmissibleUnitFor y) means that x is a unit that can be associated with the variable y; subsumption under msHPIPIR is explained as follows: There is a sign z for the variable y (where z is a description of admissible values of y) of which x is constitutive (and with which x hence overlaps)";
                           rdfs:domain pimsii:MeasurementUnit;
                           rdfs:label "isAdmissibleUnitFor"@en;
                           rdfs:range pimsii:Variable;
                           rdfs:subPropertyOf pimsii:msHPIPIR.
pimsii:isAdmissibleValueFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "(x isAdmissibleValueFor y) means that y is a term that could in principle evaluate to the value x; subsumption under msIPIRIR is explained as follows: There is a sign z for the term y (where z is the range of admissible values of y), for which in turn there is another sign z' (where z' lists members of z, explicitly including x) of which x is a part";
                            rdfs:domain pimsii:Value;
                            rdfs:label "isAdmissibleValueFor"@en;
                            rdfs:range pimsii:Term;
                            rdfs:subPropertyOf pimsii:msIPIRIR.
pimsii:isAgentIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "(x isAgentIn y) means that x is *the* agent that conducts/undertakes the action y; n.b., an action has exactly one agent (which can be a straightforward item, or a plurality, a structure, or similar)";
                 rdfs:domain pimsii:Agent;
                 rdfs:label "isAgentIn"@en;
                 rdfs:range pimsii:Action;
                 rdfs:subPropertyOf pimsii:isParticipantIn;
                 <http://www.w3.org/2004/02/skos/core#altLabel> "\\ddot{P}_a"@en.
pimsii:isAimIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "(x isAimIn y) means that y is a purposeful action, and x is one of the aims followed by the agent of y by undertaking y"@en;
               rdfs:domain [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:GoalDirectedAgent ; 
                            <http://www.w3.org/2002/07/owl#onProperty> pimsii:isGoalFor ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           pimsii:Intention;
               rdfs:label "isAimIn"@en;
               rdfs:range pimsii:Action;
               rdfs:subPropertyOf pimsii:isRepresentamenFor;
               <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:isResolutionInUndertaking
                                                                   [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isActionInUndertaking]),
                                                                  (pimsii:isTelosInSteering
                                                                   [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isActionInSteering]);
               <http://www.w3.org/2004/02/skos/core#altLabel> "R_\\alpha"@en.
pimsii:isAntecedentWithin a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x isAntecedentWithin y) means that x is the antecedent from the rule y";
                          rdfs:domain pimsii:Proposition;
                          rdfs:label "isAntecedentWithin"@en;
                          rdfs:range pimsii:Rule;
                          rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:isAssertedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "(x isAssertedBy y) means that x is a claim that is affirmatively expressed/stated/uttered by the interlocutor y"@en;
                    rdfs:domain pimsii:Claim;
                    rdfs:label "isAssertedBy"@en;
                    rdfs:range pimsii:Interlocutor;
                    rdfs:subPropertyOf pimsii:isExpressedBy;
                    <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:isAssertedIn
                                                                        [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSpeakerIn]);
                    <http://www.w3.org/2004/02/skos/core#altLabel> "B"@en.
pimsii:isAssertedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "(x isAssertedIn y) means that x is a claim that is affirmatively expressed/stated/uttered in the expressive act y (by its speaker)"@en;
                    rdfs:domain pimsii:Claim;
                    rdfs:label "isAssertedIn"@en;
                    rdfs:range pimsii:ExpressiveAct;
                    rdfs:subPropertyOf pimsii:isExpressedIn.
pimsii:isAssessmentFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "(g isAssessmentFor y) means that g is a ground for the cognitive step y, explaining how y is grounded in a way that provides a proposition on its validity, accuracy, and/or reliability, relating it to that of the previous step that directly grounds y";
                       rdfs:domain pimsii:Assessment;
                       rdfs:label "isAssessmentFor"@en;
                       rdfs:range pimsii:CognitiveStep;
                       rdfs:subPropertyOf pimsii:isGroundFor.
pimsii:isAssignmentFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "(d isAssignmentFor o) means that d: x = y is an assignment that refers to o"@en;
                       rdfs:domain pimsii:Assignment;
                       rdfs:label "isAssignmentFor"@en;
                       rdfs:subPropertyOf pimsii:isAbout;
                       <http://www.w3.org/2004/02/skos/core#altLabel> "\\hat{A}_D"@en;
                       <http://www.w3.org/2004/02/skos/core#example> "e.g., x may be thermodynamic temperature, y may be a temperature value, and o may be an object of which the temperature has been measured"@en.
pimsii:isCausallyDisconnectedFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                    <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                                  rdfs:comment "(x isCausallyDisconnectedFrom y) means that between x and y there is no 'real causal connection' in the Peircean sense; therefore, x and y cannot be the old and new referents in a metonymization; similarly, x cannot act as a representamen for y in a grounded cognition (if it does, then the cognition is not grounded)";
                                  rdfs:label "isCausallyDisconnectedFrom"@en;
                                  rdfs:subPropertyOf pimsii:isMereosemioticallyRelatedTo.
pimsii:isClaimOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "(x isClaimOf y) means that the x is a proposition that has some kind of belief-like or knowledge-like epistemic status for the intelligent agent y"@en;
                 rdfs:domain pimsii:Claim;
                 rdfs:label "isClaimOf"@en;
                 rdfs:range pimsii:IntelligentAgent;
                 rdfs:subPropertyOf pimsii:overlapsWith;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "the agent y explicitly stores x, hence requiring spatiotemporal overlap between x and y"@en.
pimsii:isCognitiveSubstepOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "In certain cases, multiple cognitive steps can be combined to yield one; e.g., the substep a: s - o - s' and the substep b: s' - o - s'' can be combined to yield a single triad, (a o b) = c: s - o - s''; in that case, c can be an element of a higher-order cognitive chain (of which it is a step), and a and b are its cognitive substeps";
                            rdfs:domain pimsii:CognitiveStep;
                            rdfs:label "isCognitiveSubstepOf"@en;
                            rdfs:range pimsii:CognitiveStep,
                                       pimsii:CognitiveChain;
                            rdfs:subPropertyOf pimsii:isStepInCognitiveChain.
pimsii:isConsequentWithin a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x isConsequentWithin y) means that x is a consequent from the rule y";
                          rdfs:domain pimsii:Proposition;
                          rdfs:label "isConsequentWithin"@en;
                          rdfs:range pimsii:Rule;
                          rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:isConstitutiveOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "(x isConstitutiveOf y) means that, by virtue of an interaction requiring spatiotemporal overlap, x contributes causally to y fulfilling a certain function, exhibiting certain properties, or relating to other objects in the way it does, thereby creating a direct causal connection between x and y"@en;
                        rdfs:label "isConstitutiveOf"@en;
                        rdfs:subPropertyOf pimsii:underlies,
                                           pimsii:hasDirectCausalConnectionWith,
                                           pimsii:overlapsWith;
                        <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:isIncludedInAccumulation
                                                                            [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAccumulationOutputIn]),
                                                                           (pimsii:isSelectionOutputIn
                                                                            [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSelectionInputIn]),
                                                                           (pimsii:isAccumulationInputIn
                                                                            [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAccumulationOutputIn]);
                        <http://www.w3.org/2004/02/skos/core#altLabel> "\\ddot{C}"@en.
pimsii:isContextOfRelation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "(x isContextOfRelation y) means that x is an IRI for the modal context of qualified possibility/necessity in the relative modal IRI y"@en;
                           rdfs:domain pimsii:ContextualIRI;
                           rdfs:label "isContextOfRelation"@en;
                           rdfs:range pimsii:QualifiedModalIRI;
                           rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:isContextWithinLaw a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x isContextWithinLaw y) means that x is an IRI for the modal context of relatively necessary implication in the relative law y"@en;
                          rdfs:domain pimsii:ContextualIRI;
                          rdfs:label "isContextWithinLaw"@en;
                          rdfs:range pimsii:QualifiedLaw;
                          rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:isDesignParameterWithin a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "(x isDesignParameterWithin y) == x is one of the parameters that make up the design space considered in the optimization problem y"@en;
                               rdfs:domain pimsii:Conventional;
                               rdfs:label "isDesignParameterWithin"@en;
                               rdfs:range pimsii:OptimizationProblem;
                               rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:isDuplicateIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "(x isDuplicateIn y) == y is a duplication step where x is the output (duplicate), i.e., the third element";
                     rdfs:label "isDuplicateIn"@en;
                     rdfs:range pimsii:Duplication;
                     rdfs:subPropertyOf pimsii:isInformationProcessingOutputIn.
pimsii:isEvaluatedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "(x isEvaluatedIn y) == y is an evaluation (reflection ex post) where x is the action undergoing evaluation, i.e., the second element; n.b., the action needs to temporally precede the evaluation";
                     rdfs:domain pimsii:Action;
                     rdfs:label "isEvaluatedIn"@en;
                     rdfs:range pimsii:Evaluation;
                     rdfs:subPropertyOf pimsii:isObjectInTelesis,
                                        pimsii:isObjectInInterpretation,
                                        pimsii:temporallyPrecedes.
pimsii:isEvaluationOutcomeIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "(x isEvaluationOutcomeIn y) == y is a an evaluation (reflection ex post) where x is the resolution (evaluation outcome), i.e., the third element";
                             rdfs:label "isEvaluationOutcomeIn"@en;
                             rdfs:range pimsii:Evaluation;
                             rdfs:subPropertyOf pimsii:isResolutionInTelesis,
                                                pimsii:isInterpretantInInterpretation.
pimsii:isEvaluatorIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "(x isEvaluatorIn y) means that y is an evaluation and x is the interpreter in it"@en;
                     rdfs:domain pimsii:GoalDirectedAgent,
                                 pimsii:Interlocutor;
                     rdfs:label "isEvaluatorIn"@en;
                     rdfs:range pimsii:Evaluation;
                     rdfs:subPropertyOf pimsii:isInterpreterIn;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "\\ddot{P}_e"@en.
pimsii:isExaminationOutcomeIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isExaminationOutcomeIn y) == y is an examination where x is the examination outcome, i.e., the third element (e.g., yes the object agrees with the legisign, or it does so under this or that condition, etc.)";
                              rdfs:label "isExaminationOutcomeIn"@en;
                              rdfs:range pimsii:Examination;
                              rdfs:subPropertyOf pimsii:isObservationOutcomeIn.
pimsii:isExaminedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "(x isExaminedIn y) == y is an examination where x acts as the examined object, i.e., the second element, for which it is assessed to what extent (in which way, under what additional conditions, etc.) it conforms with the legisign";
                    rdfs:label "isExaminedIn"@en;
                    rdfs:range pimsii:Examination;
                    rdfs:subPropertyOf pimsii:isObservedIn.
pimsii:isExpressedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "(x isExpressedBy y) means that x is expressed/stated/uttered by the interlocutor y; n.b., this does not necessarily mean that y affirms x (for that, use the subproperty isAssertedBy)";
                     rdfs:label "isExpressedBy"@en;
                     rdfs:range pimsii:Interlocutor;
                     rdfs:subPropertyOf pimsii:overlapsWith;
                     <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:isExpressedIn
                                                                         [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isSpeakerIn]);
                     <http://www.w3.org/2004/02/skos/core#altLabel> "\\dot{B}"@en.
pimsii:isExpressedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "(x isExpressedIn y) means that x is expressed/stated/uttered in the expressive act y (by its speaker), possibly but not necessarily in an affirmative way";
                     rdfs:label "isExpressedIn"@en;
                     rdfs:range pimsii:ExpressiveAct;
                     rdfs:subPropertyOf pimsii:isParticipantInCognition.
pimsii:isFirstElementIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "(x isFirstElementIn y) means that x acts as the first element in y, which is a triadic cognition"@en;
                        rdfs:label "isFirstElementIn"@en;
                        rdfs:range pimsii:TriadicCognition;
                        rdfs:subPropertyOf pimsii:isRepresentationalElementIn;
                        <http://www.w3.org/2002/07/owl#propertyChainAxiom> ([<http://www.w3.org/2002/07/owl#inverseOf> rdf:first]
                                                                            [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isTriadOf]);
                        <http://www.w3.org/2004/02/skos/core#altLabel> "\\dot{E}"@en.
pimsii:isFirstInDyad a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "(x isFirstInDyad d) means that x is the first element of the dyad d";
                     rdfs:domain pimsii:Conventional;
                     rdfs:label "isFirstInDyad"@en;
                     rdfs:range pimsii:Dyad;
                     rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "\\dot{E}_D"@en.
pimsii:isFusionOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "x isFusionOf (y1 y2 ... yn) means that x is the spatiotemporal union (i.e., fusion) of all the elements included in the list (y1 y2 ... yn)"@en;
                  rdfs:label "isFusionOf"@en;
                  rdfs:range rdf:List;
                  rdfs:subPropertyOf pimsii:isRelatedToList;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "\\sigma"@en.
pimsii:isGoalFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "(x isGoalFor y) means that to the goal-directed agent y, the telos x represents something that is to be reached."@en;
                 rdfs:domain pimsii:Intention;
                 rdfs:label "isGoalFor"@en;
                 rdfs:range pimsii:GoalDirectedAgent;
                 rdfs:subPropertyOf pimsii:isGoalOf,
                                    pimsii:overlapsWith;
                 <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:isAimIn
                                                                     [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAgentIn]),
                                                                    (pimsii:isTelosInSteering
                                                                     [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAgentIn]),
                                                                    (pimsii:isResolutionInUndertaking
                                                                     [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isAgentIn]);
                 <http://www.w3.org/2004/02/skos/core#altLabel> "\\dot{G}"@en;
                 <http://www.w3.org/2004/02/skos/core#example> "In (x isGoalFor y), if the agent x wants to go to Paris, y is not physically the city of Paris as a 4D object, but rather the associated intention, i.e., a mental or textual representation of the agent achieving the objective and reaching Paris."@en;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "A goal is both a representamen for a state of affairs desired by the agent and a representamen for the agent itself."@en.
pimsii:isGoalOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "(x isGoalOf y) means that y is a goal-oriented agent with the tendency to work toward a state of affairs that is described/represented by y; accordingly, the goal y is also a representamen for the agent itself; this does *not* imply that the agent x is aware of pursuing y as a goal, or that y is somehow included in x as a mental representation - for that purpose, use the relation 'isGoalFor'";
                rdfs:domain pimsii:Intention;
                rdfs:label "isGoalOf"@en;
                rdfs:range pimsii:GoalOrientedAgent;
                rdfs:subPropertyOf pimsii:isRepresentamenFor.
pimsii:isGroundFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "(g isGroundFor y) means that g is a representamen for the cognitive step y, explaining how y is grounded"@en;
                   rdfs:domain pimsii:Ground;
                   rdfs:label "isGroundFor"@en;
                   rdfs:range pimsii:CognitiveStep;
                   rdfs:subPropertyOf pimsii:isAbout;
                   <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:isGroundingPropositionIn
                                                                       [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isGroundedStepIn]),
                                                                      (pimsii:groundsPresentStepIn
                                                                       [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isPresentStepInGrounding]);
                   <http://www.w3.org/2004/02/skos/core#altLabel> "\\ddot{R}"@en;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "for g isGroundFor y, where x grounds y, there is a grounding metonymization where x is the old referent and y is the new referent of g"@en.
pimsii:isGroundedStepIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "(x isGroundedStepIn y) == y is a grounding step where x is the grounded step, i.e., the third element";
                        rdfs:domain pimsii:CognitiveStep;
                        rdfs:label "isGroundedStepIn"@en;
                        rdfs:range pimsii:GroundingMetonymization;
                        rdfs:subPropertyOf pimsii:isNewReferentInMetonymization.
pimsii:isGroundingPropositionIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "(x isGroundingPropositionIn y) == y is a grounding step where x is the grounding proposition, i.e., the second element; therein, x is a ground for the grounded step, and x is also a ground for y itself";
                                rdfs:domain pimsii:Ground;
                                rdfs:label "isGroundingPropositionIn"@en;
                                rdfs:range pimsii:GroundingMetonymization;
                                rdfs:subPropertyOf pimsii:changesReferentInMetonymization,
                                                   pimsii:isGroundFor.
pimsii:isGroundingStepIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "(x isGroundingStepIn y) == y is a grounding step where x is the grounding step, i.e., the first element";
                         rdfs:domain pimsii:CognitiveStep;
                         rdfs:label "isGroundingStepIn"@en;
                         rdfs:range pimsii:GroundingMetonymization;
                         rdfs:subPropertyOf pimsii:isOldReferentInMetonymization.
pimsii:isHeldBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "(x isHeldBy y) means that the claim x is consistently asserted by the knowledge base y whenever it is queried about it; if y extends significantly through time and changes opinion about x (i.e., it does not assert it consistently over the whole time), it cannot be said to hold x as a claim, merely to assert it; in this case, it may be advisable to define a (temporal) part y' of y which can then be said to hold x as a claim";
                rdfs:domain pimsii:Claim;
                rdfs:label "isHeldBy"@en;
                rdfs:range pimsii:KnowledgeBase;
                rdfs:subPropertyOf pimsii:isAssertedBy.
pimsii:isImproperPartOf a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                          <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                          <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                        rdfs:comment "Spatiotemporal (mereological) improper parthood relation; in other words, it is the reflexive closure of proper parthood: (x isImproperPartOf y) means that all points within x are also within y"@en;
                        rdfs:label "isImproperPartOf"@en;
                        rdfs:subPropertyOf pimsii:overlapsWith;
                        <http://www.w3.org/2002/07/owl#inverseOf> pimsii:hasImproperPart;
                        <http://www.w3.org/2002/07/owl#propertyChainAxiom> ([<http://www.w3.org/2002/07/owl#inverseOf> rdf:first]
                                                                            [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isFusionOf]);
                        <http://www.w3.org/2004/02/skos/core#altLabel> "P".
pimsii:isIncludedInAccumulation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "(x isIncludedInAccumulation y) == y is an accumulation where x is combined with the accumulation input, yielding an output that x is constitutive of; n.b., x needs to act as a representamen for the object (e.g., as an interpretant from a preceding cognitive step with the same object)";
                                rdfs:label "isIncludedInAccumulation"@en;
                                rdfs:range pimsii:Accumulation;
                                rdfs:subPropertyOf pimsii:isParticipantIn.
pimsii:isInformationProcessingInputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                      rdfs:comment "(x isInformationProcessingInputIn y) == y is an information-processing step where x is the input, i.e., the first element";
                                      rdfs:label "isInformationProcessingInputIn"@en;
                                      rdfs:range pimsii:InformationProcessing;
                                      rdfs:subPropertyOf pimsii:isSignInInterpretation.
pimsii:isInformationProcessingOutputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:comment "(x isInformationProcessingOutputIn y) == y is an information-processing step where x is the output, i.e., the third element";
                                       rdfs:label "isInformationProcessingOutputIn"@en;
                                       rdfs:range pimsii:InformationProcessing;
                                       rdfs:subPropertyOf pimsii:isInterpretantInInterpretation.
pimsii:isInitialStepIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "(x isInitialStepIn y) means that y is a step in x (i.e., a subprocess of x) that is not preceded by any other step";
                       rdfs:domain pimsii:Process;
                       rdfs:label "isInitialStepIn"@en;
                       rdfs:range pimsii:Process;
                       rdfs:subPropertyOf pimsii:isStepIn.
pimsii:isInterlocutorIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "(x isInterlocutorIn y) means that x engages, jointly with other interlocutors, in the communication y";
                        rdfs:domain pimsii:Interlocutor;
                        rdfs:label "isInterlocutorIn"@en;
                        rdfs:range pimsii:Communication;
                        rdfs:subPropertyOf pimsii:isParticipantIn.
pimsii:isInterpretantIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "(x isInterpretantIn y) == y is a semiosis where x acts as the interpretant, i.e., the third element";
                        rdfs:label "isInterpretantIn"@en;
                        rdfs:range pimsii:Semiosis;
                        rdfs:subPropertyOf pimsii:isThirdElementIn,
                                           pimsii:isRepresentamenIn.
pimsii:isInterpretantInInterpretation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                      rdfs:comment "(x isInterpretantInInterpretation y) == y is an interpretation where x acts as the interpretant, i.e., the third element";
                                      rdfs:label "isInterpretantInInterpretation"@en;
                                      rdfs:range pimsii:Interpretation;
                                      rdfs:subPropertyOf pimsii:isInterpretantIn.
pimsii:isInterpretantInPerception a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "(x isInterpretantInPerception y) == y is a perception where x acts as the interpretant, i.e., the third element";
                                  rdfs:label "isInterpretantInPerception"@en;
                                  rdfs:range pimsii:Perception;
                                  rdfs:subPropertyOf pimsii:isInterpretantIn.
pimsii:isInterpreterIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "(x isInterpreterIn y) means that x is the (unique) agent who conducts/undertakes the cognitive action y";
                       rdfs:domain pimsii:Agent;
                       rdfs:label "isInterpreterIn"@en;
                       rdfs:range pimsii:CognitiveAction;
                       rdfs:subPropertyOf pimsii:isAgentIn,
                                          pimsii:isParticipantInCognition.
pimsii:isJustificationFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x isJustificationFor y) means that x is a grounding chain that provides epsitemic grounding for the cognition y, which thereby becomes a grounded cognition";
                          rdfs:domain pimsii:GroundingChain;
                          rdfs:label "isJustificationFor"@en;
                          rdfs:range pimsii:GroundedCognition;
                          rdfs:subPropertyOf pimsii:isRepresentamenFor.
pimsii:isLeftHandSideIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "(x isLeftHandSideIn a) mans that a: x = y is an equality articulation with the term x as its left-hand side";
                        rdfs:domain pimsii:Term;
                        rdfs:label "isLeftHandSideIn"@en;
                        rdfs:range pimsii:EqualityArticulation;
                        rdfs:subPropertyOf pimsii:isFirstInDyad;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "\\dot{E}_="@en.
pimsii:isLegisignIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "(x isLegisignIn y) == y is an examination where x is applied to an object as a legisign, i.e., the first element, specifying patterns or rules the compliance with which is being assessed";
                    rdfs:label "isLegisignIn"@en;
                    rdfs:range pimsii:Examination;
                    rdfs:subPropertyOf pimsii:isObservationInputIn.
pimsii:isListenerIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "(x isListenerIn y) means that x is one of the interlocutors listening to the speaker's expressive act y";
                    rdfs:domain pimsii:Interlocutor;
                    rdfs:label "isListenerIn"@en;
                    rdfs:range pimsii:ExpressiveAct;
                    rdfs:subPropertyOf pimsii:isInterlocutorIn.
pimsii:isLiterally a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "points to the expression of a collective literal as an RDFS literal (e.g., xs:string or xs:decimal)";
                   rdfs:domain pimsii:CollectiveLiteral;
                   rdfs:label "isLiterally"@en.
pimsii:isMagnitudeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "(x isMagnitudeOf y) means that x is the numerical magnitude of y, e.g., in 200 kPa, x would be 200";
                     rdfs:domain pimsii:Number;
                     rdfs:label "isMagnitudeOf"@en;
                     rdfs:range pimsii:Value;
                     rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:isMaximizationObjectiveIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "(x isMaximizationObjectiveIn y) == x is a maximization objective/criterion considered in the optimization problem y"@en;
                                 rdfs:domain pimsii:Conventional;
                                 rdfs:label "isMaximizationObjectiveIn"@en;
                                 rdfs:range pimsii:Optimization;
                                 rdfs:subPropertyOf pimsii:isOptimizationObjectiveWithin.
pimsii:isMeasuredObjectIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x isMeasuredObjectIn y) == y is a measurement where x acts as the object, i.e., the second element, that is subject to the measurement and for which a property is determined";
                          rdfs:label "isMeasuredObjectIn"@en;
                          rdfs:range pimsii:Measurement;
                          rdfs:subPropertyOf pimsii:isObservedIn.
pimsii:isMeasurementInputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "(x isMeasurementInputIn y) == y is a measurement where x serves as the input (sign), i.e., the first element, constituting the precondition in terms of available information and similar items";
                            rdfs:label "isMeasurementInputIn"@en;
                            rdfs:range pimsii:Measurement;
                            rdfs:subPropertyOf pimsii:isObservationInputIn.
pimsii:isMeasurementOutcomeIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isMeasurementOutcomeIn y) == y is a measurement where x is the measurement outcome, i.e., the third element (e.g., the value that is determined for the considered property of the measured object, the measurement error, and any other outcome)";
                              rdfs:label "isMeasurementOutcomeIn"@en;
                              rdfs:range pimsii:Measurement;
                              rdfs:subPropertyOf pimsii:isObservationOutcomeIn.
pimsii:isMemberOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "membership relation, i.e., relation between an item/member and a collective"@en;
                  rdfs:label "isMemberOf"@en;
                  rdfs:range pimsii:Collective;
                  rdfs:subPropertyOf pimsii:isProperPartOf,
                                     pimsii:isConstitutiveOf;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "\\leq"@en.
pimsii:isMemberOfPlurality a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "(x isMemberOfPlurality y) means that x is a semiotic member of the plurality y, and that it participates in semiosis in the same way as its co-members x', x'', ... of the plurality y";
                           rdfs:domain [<http://www.w3.org/2002/07/owl#complementOf> [<http://www.w3.org/2002/07/owl#unionOf> (pimsii:Plurality
                                                                                                                               pimsii:Structure)]];
                           rdfs:label "isMemberOfPlurality"@en;
                           rdfs:range pimsii:Plurality;
                           rdfs:subPropertyOf pimsii:isSemioticMemberOf;
                           <http://www.w3.org/2004/02/skos/core#altLabel> "\\lhd_p"@en.
pimsii:isMemberOfStructure a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "(x isMemberOfStructure y) means that x is a semiotic member of the structure y, and that it participates in semiosis differently from all of its co-members x', x'', ... of the structure y";
                           rdfs:domain [<http://www.w3.org/2002/07/owl#complementOf> pimsii:Structure];
                           rdfs:label "isMemberOfStructure"@en;
                           rdfs:range pimsii:Structure;
                           rdfs:subPropertyOf pimsii:isSemioticMemberOf;
                           <http://www.w3.org/2004/02/skos/core#altLabel> "\\prec"@en.
pimsii:isMereologicallyConstitutiveOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                      rdfs:comment "(x isMereologicallyConstitutiveOf y) means that x is constitutive of y by virtue of the way in which it is a proper part of y in 4D spacetime, e.g., as a necessary component of an item that was designed for a certain purpose";
                                      rdfs:label "isMereologicallyConstitutiveOf"@en;
                                      rdfs:subPropertyOf pimsii:isConstitutiveOf,
                                                         pimsii:isProperPartOf.
pimsii:isMereosemioticallyRelatedTo a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                      <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                                      <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                                      <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                                    rdfs:comment "Top mereosemiotic relation: Direct or indirect connection through mereotopological and semiotic relations"@en;
                                    rdfs:label "isMereosemioticallyRelatedTo"@en.
pimsii:isMereotopologicalMemberOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "(x isMereotopologicalMemberOf y) means that x is one out of several mereotopologically connected components of y";
                                  rdfs:domain pimsii:Item;
                                  rdfs:label "isMereotopologicalMemberOf"@en;
                                  rdfs:range pimsii:MereotopologicalCollective;
                                  rdfs:subPropertyOf pimsii:isMemberOf,
                                                     pimsii:isMereologicallyConstitutiveOf.
pimsii:isMinimizationObjectiveIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "(x isMaximizationObjectiveIn y) == x is a maximization objective/criterion considered in the optimization problem y"@en;
                                 rdfs:domain pimsii:Conventional;
                                 rdfs:label "isMaximizationObjectiveIn"@en;
                                 rdfs:range pimsii:Optimization;
                                 rdfs:subPropertyOf pimsii:isOptimizationObjectiveWithin.
pimsii:isModelledIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "(x isModelledIn y) == y is a modelling (model construction or parameterization) step where x acts as the modelled object (system, substance, process, or similar), i.e., the second element";
                    rdfs:label "isModelledIn"@en;
                    rdfs:range pimsii:Modelling;
                    rdfs:subPropertyOf pimsii:isObjectInInterpretation.
pimsii:isModellingInputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x isModellingInputIn y) == y is a modelling (model construction or parameterization) step where x is the input (previous or unparameterized model, knowledge about the modelled system, etc.), i.e., the first element";
                          rdfs:label "isModellingInputIn"@en;
                          rdfs:range pimsii:Modelling;
                          rdfs:subPropertyOf pimsii:isSignInInterpretation.
pimsii:isModellingOutputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "(x isModellingOutputIn y) == y is a modelling (model construction or parameterization) step where x is the modelling output (e.g., a parameterized or improved model), i.e., the third element";
                           rdfs:label "isModellingOutputIn"@en;
                           rdfs:range pimsii:Modelling;
                           rdfs:subPropertyOf pimsii:isInterpretantInInterpretation.
pimsii:isNameFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "(x isNameFor y), to be applied in the frequent special case where x is represented by a name for x, i.e., where social convention has established y as a rigid designator for x";
                 rdfs:domain pimsii:Name;
                 rdfs:label "isNameFor"@en;
                 rdfs:subPropertyOf pimsii:isRepresentamenFor.
pimsii:isNewReferentIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "(x isNewReferentIn y) == y is a semantic change where x acts as the new referent, i.e., the third element";
                       rdfs:label "isNewReferentIn"@en;
                       rdfs:range pimsii:SemanticChange;
                       rdfs:subPropertyOf pimsii:isThirdElementIn,
                                          pimsii:isReferentIn.
pimsii:isNewReferentInMetonymization a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:comment "(x isNewReferentInMetonymization y) == y is a metonymization where x acts as the new referent, i.e., the third element; the old and the new referent need to have a causal connection";
                                     rdfs:label "isNewReferentInMetonymization"@en;
                                     rdfs:range pimsii:Metonymization;
                                     rdfs:subPropertyOf pimsii:isNewReferentIn.
pimsii:isNewReferentInPartToWhole a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "(x isNewReferentInPartToWhole y) == y is a part-to-whole synecdoche where x acts as the new referent (the whole), i.e., the third element";
                                  rdfs:label "isNewReferentInPartToWhole"@en;
                                  rdfs:range pimsii:PartToWhole;
                                  rdfs:subPropertyOf pimsii:isNewReferentInSynecdoche.
pimsii:isNewReferentInSynecdoche a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "(x isNewReferentInSynecdoche y) == y is a synecdoche where x acts as the new referent, i.e., the third element; the old and the new referent need to have a causal connection (n.b., the mereological relation in terms of proper parthood as such is insufficient)";
                                 rdfs:label "isNewReferentInSynecdoche"@en;
                                 rdfs:range pimsii:Synecdoche;
                                 rdfs:subPropertyOf pimsii:isNewReferentInMetonymization.
pimsii:isNewReferentInWholeToPart a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "(x isNewReferentInWholeToPart y) == y is a whole-to-part synecdoche where x acts as the new referent (the part), i.e., the third element";
                                  rdfs:label "isNewReferentInWholeToPart"@en;
                                  rdfs:range pimsii:WholeToPart;
                                  rdfs:subPropertyOf pimsii:isNewReferentInSynecdoche.
pimsii:isObjectIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "(x isObjectIn y) == y is a semiosis where x acts as the object, i.e., the second element";
                  rdfs:label "isObjectIn"@en;
                  rdfs:range pimsii:Semiosis;
                  rdfs:subPropertyOf pimsii:isSecondElementIn,
                                     pimsii:isReferentIn.
pimsii:isObjectInAccumulation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isObjectInAccumulation y) == y is an accumulation where x is the object that the input and the output both represent, i.e., the second element";
                              rdfs:label "isObjectInAccumulation"@en;
                              rdfs:range pimsii:Accumulation;
                              rdfs:subPropertyOf pimsii:isObjectInInformationProcessing.
pimsii:isObjectInDuplication a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "(x isObjectInDuplication y) == y is a duplication step where x is the object that the original and the duplicate both represent, i.e., the second element";
                             rdfs:label "isObjectInDuplication"@en;
                             rdfs:range pimsii:Duplication;
                             rdfs:subPropertyOf pimsii:isObjectInInformationProcessing.
pimsii:isObjectInInformationProcessing a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:comment "(x isObjectInInformationProcessing y) == y is an information-processing step where x is the object that the input and the output both represent, i.e., the second element";
                                       rdfs:label "isObjectInInformationProcessing"@en;
                                       rdfs:range pimsii:InformationProcessing;
                                       rdfs:subPropertyOf pimsii:isObjectInInterpretation.
pimsii:isObjectInInterpretation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "(x isObjectInInterpretation y) == y is an interpretation where x acts as the object, i.e., the second element; there is no need to the object of an interpretation to be present and participate in the interpretation process physically";
                                rdfs:label "isObjectInInterpretation"@en;
                                rdfs:range pimsii:Interpretation;
                                rdfs:subPropertyOf pimsii:isObjectIn.
pimsii:isObjectInOptimization a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isObjectInOptimization y) == y is an optimization where x is that which the optimization is ultimately about, i.e., the second element";
                              rdfs:label "isObjectInOptimization"@en;
                              rdfs:range pimsii:Optimization;
                              rdfs:subPropertyOf pimsii:isObjectInInterpretation.
pimsii:isObjectInSelection a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "(x isObjectInSelection y) == y is a selection where x is the object that the input and the output both represent, i.e., the second element";
                           rdfs:label "isObjectInSelection"@en;
                           rdfs:range pimsii:Selection;
                           rdfs:subPropertyOf pimsii:isObjectInInformationProcessing.
pimsii:isObjectInTelesis a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "(x isObjectInTelesis y) == y is a telesis where x acts as the object (action, claim, or situation against which an objective is evaluated), i.e., the second element";
                         rdfs:label "isObjectInTelesis"@en;
                         rdfs:range pimsii:Telesis;
                         rdfs:subPropertyOf pimsii:isObjectIn.
pimsii:isObjectOfApplicationIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "(x isObjectOfApplicationIn y) == y is an investigation-setup action where x acts as the object of application (e.g., the system to which a use case refers), i.e., the first element; n.b., there needs to be a causal connection between the object of application and the object of investigation";
                               rdfs:label "isObjectOfApplicationIn"@en;
                               rdfs:range pimsii:InvestigationSetup;
                               rdfs:subPropertyOf pimsii:isOldReferentInMetonymization.
pimsii:isObjectOfInvestigationIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "(x isObjectOfInvestigationIn y) == y is an investigation-setup action where x acts as the object of investigation (e.g., the item subject to an experiment or a simulated process or system), i.e., as the third element; n.b., there needs to be a causal connection between the object of application and the object of investigation";
                                 rdfs:label "isObjectOfInvestigationIn"@en;
                                 rdfs:range pimsii:InvestigationSetup;
                                 rdfs:subPropertyOf pimsii:isNewReferentInMetonymization.
pimsii:isObjectWithinTriple a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "(x isObjectWithinTriple y) means that y is a subject-predicate-object triple wherein x is the IRI of the object";
                            rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (pimsii:IndividualIRI
                                                                                  pimsii:ConceptualIRI)];
                            rdfs:label "isObjectWithinTriple"@en;
                            rdfs:range pimsii:Triple;
                            rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:isObservationInputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "(x isObservationInputIn y) == y is an observation where x designates input and/or advance knowledge relevant to the observation, i.e., the first element";
                            rdfs:label "isObservationInputIn"@en;
                            rdfs:range pimsii:Observation;
                            rdfs:subPropertyOf pimsii:isSignInPerception.
pimsii:isObservationOutcomeIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isObservationOutcomeIn y) == y is an observation where x is the observation outcome (the observed value of the target property), i.e., the third element";
                              rdfs:label "isObservationOutcomeIn"@en;
                              rdfs:range pimsii:Observation;
                              rdfs:subPropertyOf pimsii:isInterpretantInPerception.
pimsii:isObservedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "(x isObservedIn y) == y is an observation where x acts as the observed object, i.e., the second element, for which the value of a property is to be determined";
                    rdfs:label "isObservedIn"@en;
                    rdfs:range pimsii:Observation;
                    rdfs:subPropertyOf pimsii:isPerceivedIn.
pimsii:isOldReferentIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "(x isOldReferentIn y) == y is a semantic change where x acts as the old referent, i.e., the first element";
                       rdfs:label "isOldReferentIn"@en;
                       rdfs:range pimsii:SemanticChange;
                       rdfs:subPropertyOf pimsii:isFirstElementIn,
                                          pimsii:isReferentIn.
pimsii:isOldReferentInMetonymization a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:comment "(x isOldReferentInMetonymization y) == y is a metonymization where x acts as the old referent, i.e., the first element; the old and the new referent need to have a causal connection";
                                     rdfs:label "isOldReferentInMetonymization"@en;
                                     rdfs:range pimsii:Metonymization;
                                     rdfs:subPropertyOf pimsii:isOldReferentIn.
pimsii:isOldReferentInPartToWhole a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "(x isOldReferentInPartToWhole y) == y is a part-to-whole synecdoche where x acts as the old referent (the part), i.e., the first element";
                                  rdfs:label "isOldReferentInPartToWhole"@en;
                                  rdfs:range pimsii:PartToWhole;
                                  rdfs:subPropertyOf pimsii:isOldReferentInSynecdoche.
pimsii:isOldReferentInSynecdoche a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "(x isOldReferentInSynecdoche y) == y is a synecdoche where x acts as the old referent, i.e., the first element; the old and the new referent need to have a causal connection (n.b., the mereological relation in terms of proper parthood as such is insufficient)";
                                 rdfs:label "isOldReferentInSynecdoche"@en;
                                 rdfs:range pimsii:Synecdoche;
                                 rdfs:subPropertyOf pimsii:isOldReferentInMetonymization.
pimsii:isOldReferentInWholeToPart a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "(x isOldReferentInWholeToPart y) == y is a whole-to-part synecdoche where x acts as the old referent (the whole), i.e., the first element";
                                  rdfs:label "isOldReferentInWholeToPart"@en;
                                  rdfs:range pimsii:WholeToPart;
                                  rdfs:subPropertyOf pimsii:isOldReferentInSynecdoche.
pimsii:isOptimizationObjectiveWithin a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:comment "(x isOptimizationObjectiveWithin y) == x is one of the optimization criteria that make up the objective space considered in the optimization problem y"@en;
                                     rdfs:domain pimsii:Conventional;
                                     rdfs:label "isOptimizationObjectiveWithin"@en;
                                     rdfs:range pimsii:OptimizationProblem;
                                     rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:isOptimizationOutputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isOptimizationOutputIn y) == y is an optimization where x is the optimization output, i.e., the third element";
                              rdfs:label "isOptimizationOutputIn"@en;
                              rdfs:range pimsii:Optimization;
                              rdfs:subPropertyOf pimsii:isInterpretantInInterpretation.
pimsii:isOptimizationProblemIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "(x isOptimizationProblemIn y) == y is an optimization where x is the optimization problem, i.e., the first element."@en;
                               rdfs:domain pimsii:OptimizationProblem;
                               rdfs:label "isOptimizationProblemIn"@en;
                               rdfs:range pimsii:Optimization;
                               rdfs:subPropertyOf pimsii:isSignInInterpretation,
                                                  pimsii:isAimIn;
                               <http://www.w3.org/2004/02/skos/core#scopeNote> "In (x isOptimizationProblemIn y), x is the aim/intention pursued by carrying out the optimization process y."@en.
pimsii:isOriginalIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "(x isOriginalIn y) == y is a duplication step where x is the input (original version), i.e., the first element";
                    rdfs:label "isOriginalIn"@en;
                    rdfs:range pimsii:Duplication;
                    rdfs:subPropertyOf pimsii:isInformationProcessingInputIn.
pimsii:isOrthodataWithin a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "(x isOrthodataWithin y) means that x articulates a substantial aspect of either the antecedent or the consequent side of the rule y"@en;
                         rdfs:domain pimsii:DigitalArticulation;
                         rdfs:label "isOrthodataWithin"@en;
                         rdfs:range pimsii:Rule;
                         rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "\\v{C}_\\perp"@en.
pimsii:isParadataWithin a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "(x isParadataWithin y) means that x articulates something explicitly said to be unsubstantial to the rule y, and thereby semiotically constitutive of it, e.g., by a mechanism of logical subtraction"@en;
                        rdfs:domain pimsii:DigitalArticulation;
                        rdfs:label "isParadataWithin"@en;
                        rdfs:range pimsii:Rule;
                        rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "\\v{C}_\\parallel"@en.
pimsii:isParticipantIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "(x isParticipantIn y) means that y is a process in which x plays a certain role (e.g., x is a well-defined step within y, or x is an object that undergoes some change within y, or x is a sign that is read or an object that is perceived within y); this requires a spatiotemporal overlap between x and y";
                       rdfs:label "isParticipantIn"@en;
                       rdfs:range pimsii:Process;
                       rdfs:subPropertyOf pimsii:overlapsWith,
                                          pimsii:hasDirectCausalConnectionWith.
pimsii:isParticipantInCognition a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "(x isParticipantInCognition y) means that y is a cognition in which x is necessarily physically present and plays one of the roles characteristic for participation in a cognitive process as formalized by this ontology; this includes participation as a representamen, as a perceived object, as a step of a cognitive chain, or as an interpreter";
                                rdfs:label "isParticipantInCognition"@en;
                                rdfs:range pimsii:Cognition;
                                rdfs:subPropertyOf pimsii:isParticipantIn;
                                <http://www.w3.org/2004/02/skos/core#altLabel> "\\ddot{P}_\\kappa"@en.
pimsii:isPerceivedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "(x isPerceivedIn y) == y is a perception where x acts as the perceived object, i.e., the second element; the perceived object is a (mereotopological) participant of the perception, in other words, it needs to be physically present so that it can be perceived";
                     rdfs:label "isPerceivedIn"@en;
                     rdfs:range pimsii:Perception;
                     rdfs:subPropertyOf pimsii:isObjectIn,
                                        pimsii:isParticipantInCognition.
pimsii:isPerformanceMeasureOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isPerformanceMeasureOf y) means that x is the single/unique performance measure of the rational agent y."@en;
                              rdfs:domain pimsii:Property;
                              rdfs:label "isPerformanceMeasureOf"@en;
                              rdfs:range pimsii:RationalAgent;
                              rdfs:subPropertyOf pimsii:isRepresentamenFor;
                              <http://www.w3.org/2004/02/skos/core#scopeNote> "This does not require the agent to be aware of its performance measure or to somehow contain it or an internal representation of it."@en.
pimsii:isPredicateWithinTriple a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "(x isPredicateWithinTriple y) means that y is a subject-predicate-object triple wherein x is the IRI of the predicate";
                               rdfs:domain pimsii:RelationalIRI;
                               rdfs:label "isPredicateWithinTriple"@en;
                               rdfs:range pimsii:Triple;
                               rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:isPresentStepInGrounding a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "(x isPresentStepInGrounding y) == y is a grounding interpretation where x is the second element, i.e., the considered cognitive step";
                                rdfs:domain pimsii:CognitiveStep;
                                rdfs:label "isPresentStepInGrounding"@en;
                                rdfs:range pimsii:GroundingInterpretation;
                                rdfs:subPropertyOf pimsii:isObjectInInterpretation.
pimsii:isProperPartOf a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                        <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Spatiotemporal (mereological) proper parthood relation; (x isProperPartOf y) means that x is an improper part of y such that x and y are not the same, in other words, all points within x are also within y, but not vice versa";
                      rdfs:label "isProperPartOf"@en;
                      rdfs:subPropertyOf pimsii:isTemporallyIncludedIn,
                                         pimsii:isImproperPartOf;
                      <http://www.w3.org/2002/07/owl#inverseOf> pimsii:hasProperPart;
                      <http://www.w3.org/2002/07/owl#propertyChainAxiom> ([<http://www.w3.org/2002/07/owl#inverseOf> rdf:first]
                                                                          [<http://www.w3.org/2002/07/owl#inverseOf> rdf:rest]
                                                                          [<http://www.w3.org/2002/07/owl#inverseOf> rdf:rest]
                                                                          [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isFusionOf]),
                                                                         (pimsii:isNewReferentInWholeToPart
                                                                          [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isOldReferentInWholeToPart]),
                                                                         ([<http://www.w3.org/2002/07/owl#inverseOf> rdf:first]
                                                                          [<http://www.w3.org/2002/07/owl#inverseOf> rdf:rest]
                                                                          [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isFusionOf]),
                                                                         (pimsii:isOldReferentInPartToWhole
                                                                          [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isNewReferentInPartToWhole]).
pimsii:isProperParticipantIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "(x isProperParticipantIn y) is the conjunction of (x isProperPartOf y) and (x isParticipantIn y)";
                             rdfs:label "isProperParticipantIn"@en;
                             rdfs:range pimsii:Process;
                             rdfs:subPropertyOf pimsii:isProperPartOf,
                                                pimsii:isParticipantIn.
pimsii:isReferenceFrameFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "(s isReferenceFrameFor s') means that s is a representamen that provides relevant context, such as presuppositions or preconditions, to the representamen s'"@en;
                           rdfs:label "isReferenceFrameFor"@en;
                           rdfs:subPropertyOf pimsii:sharesReferentWith;
                           <http://www.w3.org/2004/02/skos/core#altLabel> "\\dddot{R}"@en.
pimsii:isReferentIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "(x isReferentIn y) == x occurs in the cognitive step y in the function of the/a referent of a representamen"@en;
                    rdfs:label "isReferentIn"@en;
                    rdfs:range pimsii:CognitiveStep;
                    rdfs:subPropertyOf pimsii:isRepresentationalElementIn.
pimsii:isRelatedToList a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Top property for multi-argument predicates that are implemented as 'x isRelatedToList (y1 y2 ... yn)', i.e., such that the object is an rdf:List"@en;
                       rdfs:label "isRelatedToList"@en;
                       rdfs:range rdf:List.
pimsii:isRepresentamenFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Dyadic representation relation; (x isRepresentamenFor y) means that there is a cognitive step z such that (x isRepresentamenIn z) and (y isReferentIn z)";
                          rdfs:label "isRepresentamenFor"@en;
                          rdfs:subPropertyOf pimsii:msIRHPIP,
                                             pimsii:msHPIPIR,
                                             pimsii:msIRHRIR;
                          <http://www.w3.org/2002/07/owl#inverseOf> pimsii:hasRepresentamen;
                          <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:isIncludedInAccumulation
                                                                              [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isObjectInAccumulation]),
                                                                             (pimsii:groundsNextStepIn
                                                                              [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isPresentStepInGrounding]),
                                                                             (pimsii:isGroundingPropositionIn
                                                                              [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isGroundingStepIn]),
                                                                             (pimsii:isRepresentamenIn
                                                                              [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isReferentIn]).
pimsii:isRepresentamenIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "(x isRepresentamenIn y) == x participates in the cognitive step y in the role of the/a representamen"@en;
                         rdfs:label "isRepresentamenIn"@en;
                         rdfs:range pimsii:CognitiveStep;
                         rdfs:subPropertyOf pimsii:isRepresentationalElementIn,
                                            pimsii:isParticipantInCognition.
pimsii:isRepresentationalElementIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "(x isRepresentationalElementIn y) == x acts as a representamen or referent in the cognitive step y";
                                   rdfs:label "isRepresentationalElementIn"@en;
                                   rdfs:range pimsii:CognitiveStep;
                                   rdfs:subPropertyOf pimsii:isMereosemioticallyRelatedTo.
pimsii:isResolutionInPlanning a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isResolutionInPlanning y) == y is a telesis carried out in advance of potentially undertaking an action, where x is the planning outcome, i.e., the third element";
                              rdfs:label "isResolutionInPlanning"@en;
                              rdfs:range pimsii:Planning;
                              rdfs:subPropertyOf pimsii:isResolutionInTelesis,
                                                 pimsii:isInterpretantInPerception.
pimsii:isResolutionInSteering a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isResolutionInSteering y) == y is a steering operation (reflection in actu) where x is the resolution, i.e., the third element";
                              rdfs:label "isResolutionInSteering"@en;
                              rdfs:range pimsii:Steering;
                              rdfs:subPropertyOf pimsii:isResolutionInTelesis,
                                                 pimsii:isInterpretantInPerception.
pimsii:isResolutionInTelesis a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "(x isResolutionInTelesis y) == y is a telesis where x acts as the resolution (a plan, revised objective, or other comparable sort of evaluation outcome), i.e., the third element";
                             rdfs:domain pimsii:Intention;
                             rdfs:label "isResolutionInTelesis"@en;
                             rdfs:range pimsii:Telesis;
                             rdfs:subPropertyOf pimsii:isInterpretantIn.
pimsii:isResolutionInUndertaking a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "(x isResolutionInUndertaking y) == y is an undertaking where x is the resolution (obtained from a previous telesis), i.e., the second element";
                                 rdfs:domain pimsii:Intention;
                                 rdfs:label "isResolutionInUndertaking"@en;
                                 rdfs:range pimsii:Undertaking;
                                 rdfs:subPropertyOf pimsii:changesReferentInMetonymization.
pimsii:isResultOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "(x isResultOf y) if x is an outcome/result of the cognitive process y"@en;
                  rdfs:domain [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Interpretation ; 
                               <http://www.w3.org/2002/07/owl#onProperty> pimsii:isInterpretantIn ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
                  rdfs:label "isResultOf"@en;
                  rdfs:range pimsii:Cognition;
                  rdfs:subPropertyOf pimsii:isParticipantInCognition;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "\\bar{R}"@en;
                  <http://www.w3.org/2004/02/skos/core#example> "outcomes/results of a research process can be a research data set, one or multiple knowledge claims, or some combination thereof such as a FAIR digital object"@en;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "an outcome/result of a cognition must occur in the role of the interpretant somewhere within that cognition"@en.
pimsii:isRightHandSideIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "(y isRightHandSideIn a) mans that a: x = y is an equality articulation with the term y as its right-hand side"@en;
                         rdfs:domain pimsii:Term;
                         rdfs:label "isRightHandSideIn"@en;
                         rdfs:range pimsii:EqualityArticulation;
                         rdfs:subPropertyOf pimsii:isSecondInDyad;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "\\ddot{E}_="@en.
pimsii:isSecondElementIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "(x isSecondElementIn y) means that x acts as the second element in y, which is a triadic cognition"@en;
                         rdfs:label "isSecondElementIn"@en;
                         rdfs:range pimsii:TriadicCognition;
                         rdfs:subPropertyOf pimsii:isRepresentationalElementIn;
                         <http://www.w3.org/2002/07/owl#propertyChainAxiom> ([<http://www.w3.org/2002/07/owl#inverseOf> rdf:first]
                                                                             [<http://www.w3.org/2002/07/owl#inverseOf> rdf:rest]
                                                                             [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isTriadOf]);
                         <http://www.w3.org/2004/02/skos/core#altLabel> "\\ddot{E}"@en.
pimsii:isSecondInDyad a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "(y isSecondInDyad d) means that y is the second element of the dyad d";
                      rdfs:domain pimsii:Conventional;
                      rdfs:label "isSecondInDyad"@en;
                      rdfs:range pimsii:Dyad;
                      rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf;
                      <http://www.w3.org/2004/02/skos/core#altLabel> "\\ddot{E}_D"@en.
pimsii:isSelectionConditionIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isSelectionConditionIn y) == in the selection process y, the condition x controls what constitutive element(s) of the input are retained as part of the output";
                              rdfs:domain pimsii:Proposition;
                              rdfs:label "isSelectionConditionIn"@en;
                              rdfs:range pimsii:Selection;
                              rdfs:subPropertyOf pimsii:isRepresentamenFor.
pimsii:isSelectionInputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x isSelectionInputIn y) == y is a selection where x is the input (initially given information), i.e., the first element; n.b., in a selection, the output needs to be constitutive of the input";
                          rdfs:label "isSelectionInputIn"@en;
                          rdfs:range pimsii:Selection;
                          rdfs:subPropertyOf pimsii:isInformationProcessingInputIn.
pimsii:isSelectionOutputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "(x isSelectionOutputIn y) == y is a selection where x is the output (retained information), i.e., the third element; n.b., in a selection, the output needs to be constitutive of the input";
                           rdfs:label "isSelectionOutputIn"@en;
                           rdfs:range pimsii:Selection;
                           rdfs:subPropertyOf pimsii:isInformationProcessingOutputIn.
pimsii:isSemioticMemberOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x isSemioticMemberOf y) means that x acts as a representamen or as a referent jointly with other co-members of the same semiotic collective y";
                          rdfs:domain [<http://www.w3.org/2002/07/owl#complementOf> pimsii:Plurality];
                          rdfs:label "isSemioticMemberOf"@en;
                          rdfs:range pimsii:SemioticCollective;
                          rdfs:subPropertyOf pimsii:isMemberOf,
                                             pimsii:isSemioticallyConstitutiveOf;
                          <http://www.w3.org/2004/02/skos/core#altLabel> "\\ddot\\leq"@en.
pimsii:isSemioticallyConstitutiveOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "(x isSemioticallyConstitutiveOf y) means that the evaluation or association with x plays a role in the way in which y functions as a representamen - n.b, this does not entail physical parthood; e.g., if 'q = 2f(p)' is given, the expression 'f(p) = ... (some term involving q)' may be seen as semiotically constituive of the first expression, precisely because it contains the right-hand side that was missing";
                                    rdfs:label "isSemioticallyConstitutiveOf"@en;
                                    rdfs:range [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Object ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> pimsii:isRepresentamenFor ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>];
                                    rdfs:subPropertyOf pimsii:isConstitutiveOf;
                                    <http://www.w3.org/2004/02/skos/core#altLabel> "\\v{C}"@en.
pimsii:isSignIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "(x isSignIn y) == y is a semiosis where x acts as the sign, i.e., the first element";
                rdfs:label "isSignIn"@en;
                rdfs:range pimsii:Semiosis;
                rdfs:subPropertyOf pimsii:isFirstElementIn,
                                   pimsii:isRepresentamenIn.
pimsii:isSignInInterpretation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isSignInInterpretation y) == y is an interpretation where x acts as the sign, i.e., the first element";
                              rdfs:label "isSignInInterpretation"@en;
                              rdfs:range pimsii:Interpretation;
                              rdfs:subPropertyOf pimsii:isSignIn.
pimsii:isSignInInvestigation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "(x isSignInInvestigation y) == y is an investigation-setup action where x acts as a representamen, i.e., the second element, both for the object of application (to which it is initially applied) and the object of investigation (to which it is reassigned such that the investigation can take place)";
                             rdfs:label "isSignInInvestigation"@en;
                             rdfs:range pimsii:InvestigationSetup;
                             rdfs:subPropertyOf pimsii:changesReferentInMetonymization.
pimsii:isSignInPerception a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x isSignInPerception y) == y is a perception where x acts as the sign, i.e., the first element";
                          rdfs:label "isSignInPerception"@en;
                          rdfs:range pimsii:Perception;
                          rdfs:subPropertyOf pimsii:isSignIn.
pimsii:isSimulatedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "(x isSimulatedIn y) == y is a simulation where x acts as the simulated object (system, substance, process, or similar), i.e., the second element";
                     rdfs:label "isSimulatedIn"@en;
                     rdfs:range pimsii:Simulation;
                     rdfs:subPropertyOf pimsii:isObjectInInterpretation.
pimsii:isSimulationInputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "(x isSimulationInputIn y) == y is a simulation where x is the simulation input (model, etc.), i.e., the first element";
                           rdfs:label "isSimulationInputIn"@en;
                           rdfs:range pimsii:Simulation;
                           rdfs:subPropertyOf pimsii:isSignInInterpretation.
pimsii:isSimulationOutputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "(x isSimulationOutputIn y) == y is a simulation where x is the simulation output (computed property, higher-level model, or similar), i.e., the third element";
                            rdfs:label "isSimulationOutputIn"@en;
                            rdfs:range pimsii:Simulation;
                            rdfs:subPropertyOf pimsii:isInterpretantInInterpretation.
pimsii:isSituationInPlanning a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "(x isSituationInPlanning y) == y is a telesis carried out in advance of potentially undertaking an action, where x is the perceived present situation, i.e., the second element, against which the telos is evaluated";
                             rdfs:label "isSituationInPlanning"@en;
                             rdfs:range pimsii:Planning;
                             rdfs:subPropertyOf pimsii:isObjectInTelesis,
                                                pimsii:isPerceivedIn.
pimsii:isSituationInUndertaking a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "(x isSituationInUndertaking y) == y is an undertaking wherein x is the pre-existing situation, i.e., the first element";
                                rdfs:label "isSituationInUndertaking"@en;
                                rdfs:range pimsii:Undertaking;
                                rdfs:subPropertyOf pimsii:isOldReferentInMetonymization.
pimsii:isSpatiotemporallyConnectedWith a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                         <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                                         <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                                       rdfs:comment "(x isSpatiotemporallyConnectedWith y) means that x and y overlap or are directly adjacent to each other at some point; i.e., there is a point p_x in x and a point p_y in y such that you can go from p_x to p_y without ever leaving the fusion (x U y)";
                                       rdfs:label "isSpatiotemporallyConnectedWith"@en;
                                       rdfs:subPropertyOf pimsii:isTemporallyConnectedWith;
                                       <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:hasImproperPart
                                                                                           pimsii:isSpatiotemporallyConnectedWith).
pimsii:isSpatiotemporallyDisconnectedFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                            <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                                          rdfs:comment "(x isSpatiotemporallyDisconnectedFrom y) is the negation of (x isSpatiotemporallyConnectedWith y); i.e., to go from any point in x to any point in y, it is necessary to leave the fusion (x U y)";
                                          rdfs:label "isSpatiotemporallyDisconnectedFrom"@en;
                                          rdfs:subPropertyOf pimsii:doesNotOverlapWith.
pimsii:isSpeakerIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "(x isSpeakerIn y) means that x is (the only) speaker in the expressive act y, where the role of the speaker is to be understood as that of an agent that conducts/undertakes the expressive act, i.e., it is not limited to vocal speech"@en;
                   rdfs:domain pimsii:Interlocutor;
                   rdfs:label "isSpeakerIn"@en;
                   rdfs:range pimsii:ExpressiveAct;
                   rdfs:subPropertyOf pimsii:isInterlocutorIn,
                                      pimsii:isAgentIn.
pimsii:isStepIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "(x isStepIn y) means that x and y are processes, where x is a proper part of y that plays a well-defined role within y (e.g., a task within a project, the execution of a single command within the execution of a program, etc.)";
                rdfs:domain pimsii:Process;
                rdfs:label "isStepIn"@en;
                rdfs:range [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Process ; 
                            <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isInitialStepIn] ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#someValuesFrom> pimsii:Process ; 
                            <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isTerminalStepIn] ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           pimsii:Process;
                rdfs:subPropertyOf pimsii:isProperParticipantIn.
pimsii:isStepInCognitiveChain a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isStepInCognitiveChain y) means that y is a cognitive chain that consists of multiple logically connected cognitive steps (following Peirce, these are typically triads, i.e., semioses and semantic changes), and that x is one of these steps";
                              rdfs:domain pimsii:CognitiveStep,
                                          pimsii:CognitiveChain;
                              rdfs:label "isStepInCognitiveChain"@en;
                              rdfs:subPropertyOf pimsii:isStepIn,
                                                 pimsii:isParticipantInCognition.
pimsii:isSubjectWithinTriple a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "(x isSubjectWithinTriple y) means that y is a subject-predicate-object triple wherein x is the IRI of the subject";
                             rdfs:domain pimsii:IndividualIRI;
                             rdfs:label "isSubjectWithinTriple"@en;
                             rdfs:range pimsii:Triple;
                             rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf.
pimsii:isTargetPropertyIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x isTargetPropertyIn y) means that cognitive action x targets y as the property for which a value is to be determined by observation or by theoretical or computational methods"@en;
                          rdfs:domain pimsii:Property;
                          rdfs:label "isTargetPropertyIn"@en;
                          rdfs:range pimsii:CognitiveAction;
                          rdfs:subPropertyOf pimsii:isRepresentamenFor;
                          <http://www.w3.org/2004/02/skos/core#altLabel> "\\tilde{R}"@en.
pimsii:isTelosIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "(x isTelosIn y) == y is a telesis where x acts as the telos (initial guiding objective), i.e., the first element";
                 rdfs:domain pimsii:Intention;
                 rdfs:label "isTelosIn"@en;
                 rdfs:range pimsii:Telesis;
                 rdfs:subPropertyOf pimsii:isSignIn.
pimsii:isTelosInEvaluation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "(x isTelosInEvaluation y) == y is an evaluation (reflection ex post) where x acts as the telos (initial guiding objective), i.e., the first element";
                           rdfs:label "isTelosInEvaluation"@en;
                           rdfs:range pimsii:Evaluation;
                           rdfs:subPropertyOf pimsii:isTelosIn,
                                              pimsii:isSignInInterpretation.
pimsii:isTelosInPlanning a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "(x isTelosInPlanning y) == y is a telesis carried out in advance of potentially undertaking an action, where x acts as the telos (initial guiding objective), i.e., the first element";
                         rdfs:label "isTelosInPlanning"@en;
                         rdfs:range pimsii:Planning;
                         rdfs:subPropertyOf pimsii:isTelosIn,
                                            pimsii:isSignInPerception.
pimsii:isTelosInSteering a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "(x isTelosInSteering y) == y is a steering operation (reflection in actu) where x acts as the telos (initial guiding objective), i.e., the first element";
                         rdfs:label "isTelosInSteering"@en;
                         rdfs:range pimsii:Steering;
                         rdfs:subPropertyOf pimsii:isTelosIn,
                                            pimsii:isSignInPerception.
pimsii:isTelosInValidation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "(x isTelosInValidation y) means that y is a validation where x acts as the telos (initial guiding objective), i.e., the first element"@en;
                           rdfs:label "Validation"@en;
                           rdfs:range pimsii:Validation;
                           rdfs:subPropertyOf pimsii:isTelosInEvaluation.
pimsii:isTemporallyConnectedWith a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                   <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                                   <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                                 rdfs:comment "(x isTemporallyConnectedWith y) means that there is a point in time where both x and y exist";
                                 rdfs:label "isTemporallyConnectedWith"@en;
                                 rdfs:subPropertyOf pimsii:isMereosemioticallyRelatedTo;
                                 <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:isSpatiotemporallyConnectedWith
                                                                                     pimsii:temporallyCoextendsWith),
                                                                                    (pimsii:temporallyCoextendsWith
                                                                                     pimsii:isSpatiotemporallyConnectedWith).
pimsii:isTemporallyIncludedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                              rdfs:comment "(x isTemporallyIncludedIn y) means that the temporal extension of x is a proper part of the temporal extension of y";
                              rdfs:label "isTemporallyIncludedIn"@en;
                              rdfs:subPropertyOf pimsii:temporallyOverlapsWith;
                              <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:isProperPartOf
                                                                                  pimsii:temporallyCoextendsWith),
                                                                                 (pimsii:temporallyCoextendsWith
                                                                                  pimsii:isProperPartOf).
pimsii:isTerminalStepIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "(x isTerminalStepIn y) means that y is a step in x (i.e., a subprocess of x) that does not precede any other step";
                        rdfs:domain pimsii:Process;
                        rdfs:label "isTerminalStepIn"@en;
                        rdfs:range pimsii:Process;
                        rdfs:subPropertyOf pimsii:isStepIn.
pimsii:isThirdElementIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "(x isThirdElementIn y) means that x acts as the third element in y, which is a triadic cognition"@en;
                        rdfs:label "isThirdElementIn"@en;
                        rdfs:range pimsii:TriadicCognition;
                        rdfs:subPropertyOf pimsii:isRepresentationalElementIn;
                        <http://www.w3.org/2002/07/owl#propertyChainAxiom> ([<http://www.w3.org/2002/07/owl#inverseOf> rdf:first]
                                                                            [<http://www.w3.org/2002/07/owl#inverseOf> rdf:rest]
                                                                            [<http://www.w3.org/2002/07/owl#inverseOf> rdf:rest]
                                                                            [<http://www.w3.org/2002/07/owl#inverseOf> pimsii:isTriadOf]);
                        <http://www.w3.org/2004/02/skos/core#altLabel> "\\dddot{E}"@en.
pimsii:isToolIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "(x isToolIn y) means that x is employed by an agent during the action y"@en;
                rdfs:label "isToolIn"@en;
                rdfs:range pimsii:Action;
                rdfs:subPropertyOf pimsii:isParticipantIn;
                <http://www.w3.org/2004/02/skos/core#altLabel> "\\ddot{P}_\\epsilon"@en.
pimsii:isTopicalFactorIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "(x isTopicalFactorIn y) means that x is combined with other subtopics into the topical proposition y, such that x and the other subtopics are not just standing beside each other, but exhibiting some meaningful interaction"@en;
                         rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (pimsii:Topical
                                                                               pimsii:TopicalSum)];
                         rdfs:label "isTopicalFactorIn"@en;
                         rdfs:range pimsii:TopicalProduct;
                         rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "\\v{C}_T"@en.
pimsii:isTopicalSummandIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "(x isTopicalSummandIn y) means that x is one of the topics contained in y, a collection of topics that are not immediately closely related to each other"@en;
                          rdfs:domain pimsii:Topical;
                          rdfs:label "isTopicalSummandIn"@en;
                          rdfs:range pimsii:TopicalSum;
                          rdfs:subPropertyOf pimsii:isMemberOfPlurality;
                          <http://www.w3.org/2004/02/skos/core#altLabel> "\\lhd_T"@en;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "If multiple topics are combined in a way that relates them closely to each other, with some meaningful interaction between them, the relation isTopicalFactorIn should be used, and the whole should then be a topical product, not a topical sum".
pimsii:isTriadOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "'x isTriadOf (e1 e2 e3)' is a shorthand for 'e1 isFirstElementIn x; e2 isSecondElementIn x; e3 isThirdElementIn x'"@en;
                 rdfs:domain pimsii:TriadicCognition;
                 rdfs:label "isTriadOf"@en;
                 rdfs:range rdf:List;
                 rdfs:subPropertyOf pimsii:isRelatedToList;
                 <http://www.w3.org/2004/02/skos/core#altLabel> "3"@en.
pimsii:isUnitOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "(x isUnitOf y) means that x is the unit of y, e.g., in 200 kPa, x would be kPa";
                rdfs:domain pimsii:MeasurementUnit;
                rdfs:label "isUnitOf"@en;
                rdfs:range pimsii:Value;
                rdfs:subPropertyOf pimsii:isSemioticallyConstitutiveOf;
                <http://www.w3.org/2004/02/skos/core#altLabel> "\\v{C}_u"@en.
pimsii:isValidatedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "(x isValidatedIn y) means that y is a validation where x is the cognitive action undergoing validation, i.e., the second element"@en;
                     rdfs:domain pimsii:CognitiveAction;
                     rdfs:label "isEvaluatedIn"@en;
                     rdfs:range pimsii:Validation;
                     rdfs:subPropertyOf pimsii:isEvaluatedIn.
pimsii:isValidationOutcomeIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "(x isValidationOutcomeIn y) means that x is the validity claim, i.e., the third element, obtained as an interpretant from the validation y"@en;
                             rdfs:domain pimsii:ValidityClaim;
                             rdfs:label "isValidationOutcomeIn"@en;
                             rdfs:range pimsii:Validation;
                             rdfs:subPropertyOf pimsii:isEvaluationOutcomeIn.
pimsii:isValueInAssignment a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "(y isValueInAssignment a) mans that a: x = y is an assignment where the value y is assigned to a variable x";
                           rdfs:domain pimsii:Value;
                           rdfs:label "isValueInAssignment"@en;
                           rdfs:range pimsii:Assignment;
                           rdfs:subPropertyOf pimsii:isRightHandSideIn;
                           <http://www.w3.org/2004/02/skos/core#altLabel> "\\ddot{D}"@en.
pimsii:isVariableInAssignment a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isVariableInAssignment a) mans that a: x = y is an assignment where a value y is assigned to the variable x";
                              rdfs:domain pimsii:Variable;
                              rdfs:label "isVariableInAssignment"@en;
                              rdfs:range pimsii:Assignment;
                              rdfs:subPropertyOf pimsii:isLeftHandSideIn;
                              <http://www.w3.org/2004/02/skos/core#altLabel> "\\dot{D}"@en.
pimsii:isVisualizationInputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "(x isVisualizationInputIn y) == y is a visualization process where x is the input (a pre-existing representamen for the visualized object, e.g., a simulation result), i.e., the first element";
                              rdfs:label "isVisualizationInputIn"@en;
                              rdfs:range pimsii:Visualization;
                              rdfs:subPropertyOf pimsii:isSignInInterpretation.
pimsii:isVisualizationOutputIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "(x isVisualizationOutputIn y) == y is a visualization where x is the visualization output, i.e., the third element";
                               rdfs:label "isVisualizationOutputIn"@en;
                               rdfs:range pimsii:Visualization;
                               rdfs:subPropertyOf pimsii:isInterpretantInInterpretation.
pimsii:isVisualizedObjectIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "(x isVisualizedObjectIn y) == y is a visualization process wherein x is the visualized object, i.e., the second element";
                            rdfs:label "isVisualizedObjectIn"@en;
                            rdfs:range pimsii:Visualization;
                            rdfs:subPropertyOf pimsii:isObjectInInterpretation.
pimsii:logicallyPrecedes a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                           <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                         rdfs:comment "(x logicallyPrecedes y) means that x and y are cognitive steps that are connected by a cognitive chain, leading from x and y, that does not contain a cognitive rupture"@en;
                         rdfs:domain pimsii:Cognition;
                         rdfs:label "logicallyPrecedes"@en;
                         rdfs:range pimsii:Cognition;
                         rdfs:subPropertyOf pimsii:precedesStep;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "\\hookrightarrow^+"@en;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "'logicallyPrecedes' is the transitive closure of 'directlyGrounds'"@en.
pimsii:msHPHR a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "(X msHPHR Z) == hasProperPart o hasRepresentamen == there is a Y such that (Y isProperPartOf X) and (Z isRepresentamenFor Y)";
              rdfs:label "msHPHR"@en;
              rdfs:subPropertyOf pimsii:msHPIPHR,
                                 pimsii:msHPHRHPIP;
              <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msIRIP;
              <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:hasProperPart
                                                                  pimsii:hasRepresentamen).
pimsii:msHPHRHP a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "chain relation msHPHR o hasProperPart";
                rdfs:label "msHPHRHP"@en;
                rdfs:subPropertyOf pimsii:msHPIPHRHP,
                                   pimsii:msHPHRHPIP;
                <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msIPIRIP;
