                                                                    pimsii:sharesReferentWith).
pimsii:msHPIRIP a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "chain relation msHPIR o isProperPartOf";
                rdfs:label "msHPIRIP"@en;
                rdfs:subPropertyOf pimsii:msHPIPIRIP,
                                   pimsii:msHPIRHPIP;
