                rdfs:subPropertyOf pimsii:msHRHPIPHR;
                <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msIRIPIR;
                <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:msHRHP
                                                                    pimsii:hasRepresentamen).
pimsii:msHRHPIP a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "(X msHRHPIP Z) == hasRepresentamen o hasProperPart o isProperPartOf == there is a Y such that (Y isRepresentamenFor X) and (Y overlapsWith Z)";
                rdfs:label "msHRHPIP"@en;
                rdfs:subPropertyOf pimsii:isMereosemioticallyRelatedTo;
