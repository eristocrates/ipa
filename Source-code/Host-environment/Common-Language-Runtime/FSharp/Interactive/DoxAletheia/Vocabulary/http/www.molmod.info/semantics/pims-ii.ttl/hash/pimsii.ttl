                rdfs:comment "chain relation msIRIR o isRepresentamenFor";
                rdfs:label "msIRIRIR"@en;
                rdfs:subPropertyOf pimsii:isMereosemioticallyRelatedTo;
                <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msHRHRHR;
                <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:msIRIR
                                                                    pimsii:isRepresentamenFor).
pimsii:overlapsWith a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                      <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                      <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                    rdfs:comment "(x overlapsWith y) means that x and y share a spatiotemporal region where x and y intersect";
                    rdfs:label "overlapsWith"@en;
                    rdfs:subPropertyOf pimsii:isSpatiotemporallyConnectedWith,
                                       pimsii:temporallyOverlapsWith;
                    <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:hasImproperPart
                                                                        pimsii:isImproperPartOf).
pimsii:precedesStep a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                      <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                    rdfs:comment "'precedesStep' is the transitive closure of 'directlyPrecedesStep'; (x precedesStep y) means that the processes x and y are, possibly indirectly, causally connected such that x needs to be concluded before y can commence";
                    rdfs:domain pimsii:Process;
                    rdfs:label "precedesStep"@en;
                    rdfs:range pimsii:Process;
                    rdfs:subPropertyOf pimsii:temporallyPrecedes,
                                       pimsii:hasCausalConnectionWith.
pimsii:providesJustification a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "(x providesJustification y) means that x is about some cognition z, providing a justification of it by referring to y, i.e., a grounding chain that establishes the epistemic status of z; thereby, x does not only affirm z, but also its grounding chain y";
                             rdfs:label "providesJustification"@en;
                             rdfs:range pimsii:GroundingChain;
                             rdfs:subPropertyOf pimsii:affirmsCognition.
pimsii:realizes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "(x realizes y) means that x, which is not a semiotic collective, is a literal or non-literal realization of the expression y";
                rdfs:domain [<http://www.w3.org/2002/07/owl#complementOf> pimsii:SemioticCollective];
                rdfs:label "realizes"@en;
                rdfs:range pimsii:Articulation;
                rdfs:subPropertyOf pimsii:isSemioticMemberOf.
pimsii:sharesReferentWith a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                            <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                          rdfs:comment "(X sharesReferentWith Z) == there is a Y such that both X and Z isRepresentamenFor Y";
                          rdfs:label "sharesReferentWith"@en;
                          rdfs:subPropertyOf pimsii:msIRHRHPIP,
                                             pimsii:msHPIPIRHR.
pimsii:sharesRepresentamenWith a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                 <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                               rdfs:comment "(X sharesRepresentamenWith Z) == there is a Y such that Y isRepresentamenFor both X and Z";
                               rdfs:label "sharesRepresentamenWith"@en;
                               rdfs:subPropertyOf pimsii:msHRIRHPIP,
                                                  pimsii:msHPIPHRIR.
pimsii:temporallyCoextendsWith a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                 <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                                 <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                                 <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                               rdfs:comment "(x temporallyCoextendsWith y) means that x and y have exactly the same extension in time, i.e., disregarding their spatial extension";
                               rdfs:label "temporallyCoextendsWith"@en;
                               rdfs:subPropertyOf pimsii:temporallyOverlapsWith.
pimsii:temporallyOverlapsWith a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                                <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                              rdfs:comment "(x temporallyOverlapsWith y) means that there is an (extended) interval in time where both x and y exist";
                              rdfs:label "temporallyOverlapsWith"@en;
                              rdfs:subPropertyOf pimsii:isTemporallyConnectedWith;
                              <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:overlapsWith
                                                                                  pimsii:temporallyCoextendsWith),
                                                                                 (pimsii:temporallyCoextendsWith
                                                                                  pimsii:overlapsWith).
pimsii:temporallyPrecedes a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                            <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                          rdfs:comment "(x temporallyPrecedes y) means that every point in x is earlier in time than every point in y; the spacetime regions x and y may be connected, but they cannot overlap temporally";
                          rdfs:label "temporallyPrecedes"@en;
                          rdfs:subPropertyOf pimsii:doesNotTemporallyOverlapWith;
                          <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:temporallyPrecedes
                                                                              pimsii:hasProperPart),
                                                                             (pimsii:isProperPartOf
                                                                              pimsii:temporallyPrecedes),
                                                                             (pimsii:temporallyPrecedes
                                                                              pimsii:temporallyCoextendsWith),
                                                                             (pimsii:temporallyCoextendsWith
                                                                              pimsii:temporallyPrecedes).
pimsii:underlies a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                   <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                 rdfs:comment "the relation 'underlies' is the transitive closure of the relation 'isConstitutiveOf'";
                 rdfs:label "underlies"@en;
                 rdfs:subPropertyOf pimsii:hasCausalConnectionWith.
rdf:List a rdfs:Class;
         rdfs:comment "the first element is related to the list by rdf:first, the second by (rdf:rest o rdf:first), the third by (rdf:rest o rdf:rest o rdf:first), and so on; where the list ends, it is related by rdf:rest to rdf:nil"@en;
         <http://www.w3.org/2004/02/skos/core#example> "See also: https://ontola.io/blog/ordered-data-in-rdf/"@en;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Syntactic construct (x1 x2 x3 x4) used within the resource description framework (RDF) for a list"@en.
rdf:first rdfs:comment "relates a rdf:List to its first element"@en;
          rdfs:domain rdf:List;
          <http://www.w3.org/2004/02/skos/core#example> "e.g., if L = (x y z), this would be 'L rdf:first x'"@en.
rdf:rest rdfs:comment "relates a rdf:List to the part that remains when its first element is removed"@en;
         rdfs:domain rdf:List;
         <http://www.w3.org/2004/02/skos/core#example> "e.g., if L = (x y z), this would be 'L rdf:rest (y z)'; if a list has only one element, the rest is rdf:nil, e.g., if L = (x), such that 'L rdf:first x', this would be 'L rdf:rest rdf:nil'"@en.
