                  <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msIPHRHPIP;
                  <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:overlapsWith
                                                                      pimsii:msIRHP).
pimsii:msHPIPIRHR a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "chain relation overlapsWith o sharesReferentWith";
                  rdfs:label "msHPIPIRHR"@en;
                  rdfs:subPropertyOf pimsii:isMereosemioticallyRelatedTo;
                  <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msIRHRHPIP;
                  <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:overlapsWith
                                                                      pimsii:sharesReferentWith).
pimsii:msHPIPIRIP a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "chain relation overlapsWith o msIRIP";
                  rdfs:label "msHPIPIRIP"@en;
                  rdfs:subPropertyOf pimsii:isMereosemioticallyRelatedTo;
                  <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msHPHRHPIP;
                  <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:overlapsWith
                                                                      pimsii:msIRIP).
pimsii:msHPIPIRIR a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "chain relation overlapsWith o msIRIR";
                  rdfs:label "msHPIPIRIR"@en;
                  rdfs:subPropertyOf pimsii:isMereosemioticallyRelatedTo;
                  <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msHRHRHPIP;
                  <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:overlapsWith
                                                                      pimsii:msIRIR).
pimsii:msHPIR a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "(X msHPIR Z) == hasProperPart o isRepresentamenFor == there is a Y such that (Y isProperPartOf X) and (Y is RepresentamenFor Z)";
              rdfs:label "msHPIR"@en;
              rdfs:subPropertyOf pimsii:msHPIPIR,
                                 pimsii:msHPIRHPIP;
