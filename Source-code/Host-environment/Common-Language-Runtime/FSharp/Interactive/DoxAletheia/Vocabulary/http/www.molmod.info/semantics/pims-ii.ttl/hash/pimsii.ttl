                  <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msIRHPIPIR;
                  <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:msHRHP
                                                                      pimsii:msIPHR),
