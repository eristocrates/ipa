                <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msHPIRIP;
                <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:msHPHR
                                                                    pimsii:isProperPartOf).
pimsii:msHPHRIR a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "chain relation hasProperPart o sharesRepresentamenWith";
                rdfs:label "msHPHRIR"@en;
