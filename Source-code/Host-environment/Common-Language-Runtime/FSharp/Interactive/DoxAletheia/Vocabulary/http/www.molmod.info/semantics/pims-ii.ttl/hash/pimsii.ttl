                                                                    pimsii:hasRepresentamen).
pimsii:msHPIPHRHP a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "chain relation overlapsWith o msHRHP";
                  rdfs:label "msHPIPHRHP"@en;
                  rdfs:subPropertyOf pimsii:isMereosemioticallyRelatedTo;
                  <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msIPIRHPIP;
                  <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:overlapsWith
                                                                      pimsii:msHRHP).
pimsii:msHPIPHRHR a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "chain relation overlapsWith o msHRHR";
