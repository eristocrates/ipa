                <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msHRIRIP;
                <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:msHPHR
                                                                    pimsii:isRepresentamenFor),
                                                                   (pimsii:hasProperPart
                                                                    pimsii:sharesRepresentamenWith).
pimsii:msHPIPHR a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "(X msHPIPHR Z) == hasProperPart o isProperPartOf o hasRepresentamen == there is a Y such that (X overlapsWith Y) and (Z isRepresentamenFor Y)";
                rdfs:label "msHPIPHR"@en;
                rdfs:subPropertyOf pimsii:isMereosemioticallyRelatedTo;
