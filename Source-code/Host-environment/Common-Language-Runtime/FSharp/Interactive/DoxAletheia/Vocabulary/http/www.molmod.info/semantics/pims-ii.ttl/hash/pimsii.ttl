                                                                    pimsii:hasRepresentamen).
pimsii:msHPHRIP a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "chain relation msHPHR o hasProperPart";
                rdfs:label "msHPHRIP"@en;
