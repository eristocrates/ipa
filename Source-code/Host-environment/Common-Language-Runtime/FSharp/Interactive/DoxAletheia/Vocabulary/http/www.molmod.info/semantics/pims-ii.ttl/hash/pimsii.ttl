                <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:msHPIR
                                                                    pimsii:isProperPartOf).
pimsii:msHPIRIR a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "chain relation msHPIR o isRepresentamenFor";
                rdfs:label "msHPIRIR"@en;
                rdfs:subPropertyOf pimsii:msHPIPIRIR;
                <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msHRHRIP;
                <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:msHPIR
                                                                    pimsii:isRepresentamenFor).
pimsii:msHRHP a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "(X msHRHP Z) == hasRepresentamen o hasProperPart == there is a Y such that (Y isRepresentamenFor X) and (Z isProperPartOf Y)";
              rdfs:label "msHRHP"@en;
              rdfs:subPropertyOf pimsii:msHRHPIP,
                                 pimsii:msHPIPHRHP;
              <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msIPIR;
              <http://www.w3.org/2002/07/owl#propertyChainAxiom> (pimsii:hasRepresentamen
                                                                  pimsii:hasProperPart).
