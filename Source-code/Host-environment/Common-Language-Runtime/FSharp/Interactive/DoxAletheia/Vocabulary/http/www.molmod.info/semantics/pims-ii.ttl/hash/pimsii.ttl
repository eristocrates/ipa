                                                                      pimsii:overlapsWith
                                                                      pimsii:isRepresentamenFor).
pimsii:msHRHPIR a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "chain relation msHRHP o isRepresentamenFor";
                rdfs:label "msHRHPIR"@en;
                rdfs:subPropertyOf pimsii:msHRHPIPIR;
                <http://www.w3.org/2002/07/owl#inverseOf> pimsii:msHRIPIR;
