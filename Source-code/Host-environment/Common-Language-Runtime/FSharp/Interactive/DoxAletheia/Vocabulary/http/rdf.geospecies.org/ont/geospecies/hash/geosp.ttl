                              rdfs:label "Managed".
geospecies:nativeness_native dc11:description "The organism either evolved in this region or arrived by non-anthropogenic means";
                             a owl:NamedIndividual,
                               geospecies:Nativeness,
                               owl:Thing;
                             rdfs:isDefinedBy <http://rdf.geospecies.org/ont/geospecies.owl>;
                             rdfs:label "Native".
geospecies:nativeness_naturalised dc11:description "The organism reproduces naturally and forms part of the local ecology";
                                  a owl:NamedIndividual,
                                    geospecies:Nativeness,
                                    owl:Thing;
                                  rdfs:isDefinedBy <http://rdf.geospecies.org/ont/geospecies.owl>;
                                  rdfs:label "Naturalised".
geospecies:speciesHasHabitatAssociation a owl:ObjectProperty;
                                        rdfs:domain geospecies:SpeciesConcept;
                                        rdfs:isDefinedBy <http://rdf.geospecies.org/ont/geospecies.owl>;
                                        rdfs:label "hasHabitatAssociation";
                                        rdfs:range geospecies:Habitat_Classification.
geospecies:wasObservedIn a owl:ObjectProperty;
                         rdfs:domain geospecies:SpeciesConcept;
                         rdfs:isDefinedBy <http://rdf.geospecies.org/ont/geospecies.owl>;
                         rdfs:label "wasObservedIn";
                         rdfs:range geonames:Feature.
<http://rdf.geospecies.org/ont/geospecies.owl> dc11:creator "Peter J. DeVries";
                                               dc11:date "2012-10-02";
                                               dc11:title "GeoSpecies Ontology";
                                               a owl:Ontology;
                                               rdfs:comment "This is an early version of the new ontology. Use it as a vocabulary, since is still under development. The demonstration SPARQL queries will work without the ontology loaded into your triple store.";
                                               rdfs:isDefinedBy <http://rdf.geospecies.org/ont/geospecies.owl>;
                                               rdfs:seeAlso <http://lod.geospecies.org/ontology/void.rdf>,
                                                            <http://labs.mondeca.com/dataset/lov/lov.rdf>,
                                                            <http://lod.taxonconcept.org/ontology/txn.owl>,
                                                            <http://lod.geospecies.org/ontology/doc/index.html>.
doap:homepage a owl:ObjectProperty,
                owl:AnnotationProperty;
              rdfs:label "homepage".
geonames:Feature a owl:Class;
                 rdfs:comment "An entity that has a geonames feature id"^^rdf:XMLLiteral;
                 rdfs:label "Feature";
                 rdfs:subClassOf owl:Thing.
rdfs:comment a owl:AnnotationProperty.
rdfs:isDefinedBy a owl:AnnotationProperty.
rdfs:label a owl:AnnotationProperty.
rdfs:seeAlso a owl:AnnotationProperty.
owl:Thing a owl:Class.
owl:versionInfo a owl:AnnotationProperty.
skos:Concept a owl:Class.
skos:ConceptScheme a owl:Class.
skos:prefLabel a owl:DatatypeProperty.
foaf:Document a owl:Class.
foaf:Person a owl:Class.
foaf:Project a owl:Class;
             rdfs:label "Project2".
foaf:name a owl:DatatypeProperty.
