                                                <http://www.w3.org/2003/11/swrl#>,
                                                <http://www.hozo.jp/owl/EXPOApr19.xml/>,
                                                <http://swrc.ontoware.org/ontology>;
        <http://www.w3.org/2002/07/owl#priorVersion> "1.0"^^xsd:double;
