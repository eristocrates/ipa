                                                  "Soeren Auer"@en,
                                                  "Christoph Lange"@en;
        <http://purl.org/dc/elements/1.1/description> " SemSur, the Semantic Survey Ontology, is a core ontology for describing individual research problems, approaches, implementations and evaluations in a structured, comparable way."^^rdfs:Literal;
        <http://purl.org/dc/elements/1.1/rights> "Copyright 2018 ";
        <http://purl.org/dc/elements/1.1/title> "The Semantic Survey Ontology (semsur)"^^rdfs:Literal;
        <http://purl.org/dc/terms/issued> "2018-01-08"^^xsd:date;
        <http://purl.org/dc/terms/modified> "2018-04-11"^^xsd:date;
        <http://purl.org/dc/terms/title> "SemSur, Version 2.0"@en;
