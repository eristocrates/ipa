semsur:KnoFuss:_A_Comprehensive_Architecture_for_Knowledge_Fusion semsur:proposeFramework <http://purl.org/semsur/KnoFuss>;
                                                                  semsur:subject "Link Discovery";
                                                                  dc11:creator <http://purl.org/semsur/Andriy_Nikolov>,
                                                                               <http://purl.org/semsur/Enrico_Motta>,
                                                                               <http://purl.org/semsur/Victoria_Uren>;
                                                                  swrc:abstract "We propose a knowledge fusion architecture KnoFuss based on the application of problem-solving methods technology, which allows methods for subtasks of the fusion process to be combined and the best methods to be selected, depending on the domain and task at hand.";
                                                                  swrc:publisher <http://purl.org/semsur/K-CAP>;
                                                                  swrc:title "KnoFuss: A Comprehensive Architecture for Knowledge Fusion";
                                                                  swrc:year 2007 ;
                                                                  a owl:NamedIndividual,
