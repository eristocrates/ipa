        <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/SemSur/"^^<http://purl.org/dc/terms/URI>;
        a <http://www.w3.org/2002/07/owl#Ontology>;
        <http://www.w3.org/2002/07/owl#imports> <http://purl.org/spar/deo>,
                                                <http://swrl.stanford.edu/ontologies/3.3/swrla.owl>,
                                                <http://purl.org/spar/doco>,
