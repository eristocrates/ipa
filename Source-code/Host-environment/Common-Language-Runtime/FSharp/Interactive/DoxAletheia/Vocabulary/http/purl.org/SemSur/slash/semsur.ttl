                                          <http://purl.org/dc/terms/modified> "2008-01-14"^^xsd:date;
                                          a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:comment "An entity primarily responsible for making the resource."@en;
                                          rdfs:domain <http://swrc.ontoware.org/ontology#Publication>,
                                                      [<http://www.w3.org/2002/07/owl#onProperty> <http://swrc.ontoware.org/ontology#cite> ; 
                                                       <http://www.w3.org/2002/07/owl#allValuesFrom> <http://swrc.ontoware.org/ontology#Publication> ; 
                                                       a <http://www.w3.org/2002/07/owl#Restriction>];
                                          rdfs:isDefinedBy <http://purl.org/dc/elements/1.1/>;
                                          rdfs:label "Creator"@en;
                                          rdfs:range <http://purl.org/dc/terms/Agent>,
                                                     <http://xmlns.com/foaf/0.1/Person>,
