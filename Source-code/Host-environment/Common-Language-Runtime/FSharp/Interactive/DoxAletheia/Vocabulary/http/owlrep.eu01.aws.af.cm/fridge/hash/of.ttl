@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix of: <http://owlrep.eu01.aws.af.cm/fridge#>.
@prefix ssnx: <http://purl.oclc.org/NET/ssnx/ssn#>.
@prefix gr: <http://purl.org/goodrelations/v1#>.
@prefix ofrd: <http://purl.org/opdm/refrigerator#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix schema: <http://schema.org/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

<http://owlrep.eu01.aws.af.cm/fridge> dc11:creator "Christian Mayr";
                                      dc11:subject "fridge plugwise energy measurement";
                                      a owl:Ontology;
                                      rdfs:comment "Ontology for Open Fridge project";
                                      rdfs:isDefinedBy "http://owlrep.eu01.aws.af.cm/fridge";
                                      rdfs:label "Open Fridge vocabulary";
                                      owl:imports schema:,
                                                  ofrd:,
                                                  <http://purl.oclc.org/NET/ssnx/ssn>;
                                      owl:versionInfo "Version: Freezing Snowy Owl",
                                                      "V 0.6.0, Release 2012-12-30".
of:EnergyObservation a owl:Class;
                     rdfs:comment "An energy observation is the main class of the measurment system. The observation connects to the sensing device, the measurement property, the observed appliance, the measurment result, and the time of measurement.";
                     rdfs:label "Energy Observation";
                     rdfs:subClassOf [owl:intersectionOf (ssnx:Observation
                                                          [owl:onProperty ssnx:observedProperty ; 
                                                          owl:allValuesFrom of:Power ; 
                                                          a owl:Restriction]
                                                          [owl:someValuesFrom of:EnergySensingDevice ; 
                                                          owl:onProperty ssnx:observedBy ; 
                                                          a owl:Restriction]
                                                          [owl:someValuesFrom ssnx:SensorOutput ; 
                                                          owl:onProperty ssnx:observationResult ; 
                                                          a owl:Restriction]
                                                          [owl:someValuesFrom <http://www.loa-cnr.it/ontologies/DUL.owl#SpatioTemporalRegion> ; 
                                                          owl:onProperty ssnx:endTime ; 
                                                          a owl:Restriction]
                                                          [owl:someValuesFrom <http://www.loa-cnr.it/ontologies/DUL.owl#SpatioTemporalRegion> ; 
                                                          owl:onProperty ssnx:startTime ; 
                                                          a owl:Restriction]
                                                          [owl:someValuesFrom ofrd:Fridge ; 
                                                          owl:onProperty ssnx:featureOfInterest ; 
                                                          a owl:Restriction]) ; 
                                      a owl:Class],
                                     owl:Thing.
of:EnergySensingDevice a owl:Class;
                       rdfs:comment "An energy sensing device is sensing device for sensing energy consumption data";
                       rdfs:label "Energy Sensing Device";
                       rdfs:subClassOf [owl:onProperty ssnx:ofFeature ; 
                                        owl:hasValue of:Power ; 
                                        a owl:Restriction],
                                       [owl:intersectionOf (ssnx:SensingDevice
                                                            [owl:someValuesFrom of:EnergyObservation ; 
                                                            owl:onProperty ssnx:observedBy ; 
                                                            a owl:Restriction]) ; 
                                        a owl:Class],
                                       owl:Thing.
of:OpenFridgeHousehold a owl:Class;
                       rdfs:comment "Information about the household of the open fridge user";
                       rdfs:label "Open Fridge Household";
                       rdfs:subClassOf schema:Residence,
                                       owl:Thing.
of:OpenFridgeUser a owl:Class;
                  rdfs:comment "The main user of the system, which lives in a household with a energy consumption measuring system.";
                  rdfs:label "Open Fridge User";
                  rdfs:subClassOf [owl:unionOf (schema:Person
                                                [owl:intersectionOf (<http://www.loa-cnr.it/ontologies/DUL.owl#Person>
                                                                    [owl:onProperty of:hasHousehold ; 
                                                                    owl:allValuesFrom of:OpenFridgeHousehold ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class]) ; 
                                   a owl:Class],
                                  owl:Thing.
of:Power a owl:Class;
         rdfs:comment "Power is the observed measurment property";
         rdfs:label "Power";
         rdfs:subClassOf ssnx:MeasurementProperty,
                         owl:Thing.
of:dateBringIntoService a owl:DatatypeProperty;
                        rdfs:comment "The date when an product or service was bought or brought into service.";
                        rdfs:domain gr:ProductOrService;
                        rdfs:range xsd:date.
of:energySensingDeviceID a owl:DatatypeProperty;
                         rdfs:comment "The appliance ID of an energy sensing device";
                         rdfs:domain of:EnergySensingDevice;
                         rdfs:range xsd:string.
of:hasHousehold a owl:ObjectProperty;
                rdfs:comment "Open fridge user has an open fridge household";
                rdfs:domain of:OpenFridgeUser;
                rdfs:range of:OpenFridgeHousehold.
of:numberOfPeople a owl:DatatypeProperty;
                  rdfs:comment "Number of people that live in the household";
                  rdfs:domain of:OpenFridgeHousehold;
                  rdfs:range xsd:int.
of:observationProperty a owl:DatatypeProperty;
                       rdfs:comment "Property of a fridge in the time period of observation.";
                       rdfs:domain ssnx:Observation.
of:observationPropertyFillingLevel a owl:DatatypeProperty;
                                   rdfs:comment "The average filling level of a fridge in the time period of observation.";
                                   rdfs:range xsd:int;
                                   rdfs:subPropertyOf of:observationProperty.
of:observationPropertyNumberOfOpening a owl:DatatypeProperty;
                                      rdfs:comment "The number of door openings of a fridge in the time period of observation.";
                                      rdfs:range xsd:int;
                                      rdfs:subPropertyOf of:observationProperty.
of:observationPropertyRoomTemperature a owl:DatatypeProperty;
                                      rdfs:comment "The average temperature of the room where the refrigerator stands observed in a time period.";
                                      rdfs:range xsd:float;
                                      rdfs:subPropertyOf of:observationProperty.
of:observationPropertyTemperature a owl:DatatypeProperty;
                                  rdfs:comment "The average temperature of a fridge in the time period of observation.";
                                  rdfs:range xsd:float;
                                  rdfs:subPropertyOf of:observationProperty.
of:ownsFridge a owl:ObjectProperty;
              rdfs:comment "An open user owns a refrigerator.";
              rdfs:domain [owl:unionOf (<http://www.loa-cnr.it/ontologies/DUL.owl#Person>
                                        schema:Person) ; 
                           a owl:Class];
              rdfs:range ofrd:Fridge.
of:standSouth a owl:DatatypeProperty;
              rdfs:comment "Is the refrigerator located to the southwards or not.";
              rdfs:domain ofrd:Fridge;
              rdfs:range xsd:boolean.
ssnx:FeatureOfInterest a rdfs:Class.
ssnx:MeasurementProperty a rdfs:Class.
ssnx:Observation a rdfs:Class.
ssnx:SensingDevice a rdfs:Class.
ssnx:ofFeature a rdf:Property.
gr:ActualProductOrServiceInstance a rdfs:Class.
gr:Individual a rdfs:Class;
              rdfs:subClassOf gr:ActualProductOrServiceInstance.
ofrd:Fridge a rdfs:Class;
            rdfs:subClassOf ssnx:FeatureOfInterest.
schema:Person a rdfs:Class.
schema:Residence a rdfs:Class.
<http://www.loa-cnr.it/ontologies/DUL.owl#Person> a rdfs:Class.
