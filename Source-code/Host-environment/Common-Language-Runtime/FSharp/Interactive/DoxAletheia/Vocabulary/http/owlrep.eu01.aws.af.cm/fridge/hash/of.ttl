@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix of: <http://owlrep.eu01.aws.af.cm/fridge#>.

<http://owlrep.eu01.aws.af.cm/fridge> <http://purl.org/dc/elements/1.1/creator> "Christian Mayr";
                                      <http://purl.org/dc/elements/1.1/subject> "fridge plugwise energy measurement";
                                      a <http://www.w3.org/2002/07/owl#Ontology>;
                                      rdfs:comment "Ontology for Open Fridge project";
                                      rdfs:isDefinedBy "http://owlrep.eu01.aws.af.cm/fridge";
                                      rdfs:label "Open Fridge vocabulary";
                                      <http://www.w3.org/2002/07/owl#imports> <http://schema.org/>,
                                                                              <http://purl.org/opdm/refrigerator#>,
                                                                              <http://purl.oclc.org/NET/ssnx/ssn>;
                                      <http://www.w3.org/2002/07/owl#versionInfo> "Version: Freezing Snowy Owl",
                                                                                  "V 0.6.0, Release 2012-12-30".
of:EnergyObservation a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "An energy observation is the main class of the measurment system. The observation connects to the sensing device, the measurement property, the observed appliance, the measurment result, and the time of measurement.";
                     rdfs:label "Energy Observation";
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.oclc.org/NET/ssnx/ssn#Observation>
                                                                                      [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observedProperty> ; 
                                                                                      <http://www.w3.org/2002/07/owl#allValuesFrom> of:Power ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> of:EnergySensingDevice ; 
                                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observedBy> ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/ssn#SensorOutput> ; 
                                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observationResult> ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.loa-cnr.it/ontologies/DUL.owl#SpatioTemporalRegion> ; 
                                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#endTime> ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.loa-cnr.it/ontologies/DUL.owl#SpatioTemporalRegion> ; 
                                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#startTime> ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.org/opdm/refrigerator#Fridge> ; 
                                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#featureOfInterest> ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                      a <http://www.w3.org/2002/07/owl#Class>],
                                     <http://www.w3.org/2002/07/owl#Thing>.
of:EnergySensingDevice a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "An energy sensing device is sensing device for sensing energy consumption data";
                       rdfs:label "Energy Sensing Device";
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#ofFeature> ; 
                                        <http://www.w3.org/2002/07/owl#hasValue> of:Power ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.oclc.org/NET/ssnx/ssn#SensingDevice>
                                                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> of:EnergyObservation ; 
                                                                                        <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observedBy> ; 
                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                        a <http://www.w3.org/2002/07/owl#Class>],
                                       <http://www.w3.org/2002/07/owl#Thing>.
of:OpenFridgeHousehold a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Information about the household of the open fridge user";
                       rdfs:label "Open Fridge Household";
                       rdfs:subClassOf <http://schema.org/Residence>,
                                       <http://www.w3.org/2002/07/owl#Thing>.
of:OpenFridgeUser a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The main user of the system, which lives in a household with a energy consumption measuring system.";
                  rdfs:label "Open Fridge User";
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> (<http://schema.org/Person>
                                                                            [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://www.loa-cnr.it/ontologies/DUL.owl#Person>
                                                                                                                            [<http://www.w3.org/2002/07/owl#onProperty> of:hasHousehold ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#allValuesFrom> of:OpenFridgeHousehold ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>]) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>],
                                  <http://www.w3.org/2002/07/owl#Thing>.
of:Power a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "Power is the observed measurment property";
         rdfs:label "Power";
         rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#MeasurementProperty>,
                         <http://www.w3.org/2002/07/owl#Thing>.
of:dateBringIntoService a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "The date when an product or service was bought or brought into service.";
                        rdfs:domain <http://purl.org/goodrelations/v1#ProductOrService>;
                        rdfs:range xsd:date.
of:energySensingDeviceID a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "The appliance ID of an energy sensing device";
                         rdfs:domain of:EnergySensingDevice;
                         rdfs:range xsd:string.
of:hasHousehold a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Open fridge user has an open fridge household";
                rdfs:domain of:OpenFridgeUser;
                rdfs:range of:OpenFridgeHousehold.
of:numberOfPeople a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Number of people that live in the household";
                  rdfs:domain of:OpenFridgeHousehold;
                  rdfs:range xsd:int.
of:observationProperty a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "Property of a fridge in the time period of observation.";
                       rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Observation>.
of:observationPropertyFillingLevel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                   rdfs:comment "The average filling level of a fridge in the time period of observation.";
                                   rdfs:range xsd:int;
                                   rdfs:subPropertyOf of:observationProperty.
of:observationPropertyNumberOfOpening a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                      rdfs:comment "The number of door openings of a fridge in the time period of observation.";
                                      rdfs:range xsd:int;
                                      rdfs:subPropertyOf of:observationProperty.
of:observationPropertyRoomTemperature a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                      rdfs:comment "The average temperature of the room where the refrigerator stands observed in a time period.";
                                      rdfs:range xsd:float;
                                      rdfs:subPropertyOf of:observationProperty.
of:observationPropertyTemperature a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                  rdfs:comment "The average temperature of a fridge in the time period of observation.";
                                  rdfs:range xsd:float;
                                  rdfs:subPropertyOf of:observationProperty.
of:ownsFridge a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "An open user owns a refrigerator.";
              rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.loa-cnr.it/ontologies/DUL.owl#Person>
                                                                    <http://schema.org/Person>) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
              rdfs:range <http://purl.org/opdm/refrigerator#Fridge>.
of:standSouth a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Is the refrigerator located to the southwards or not.";
              rdfs:domain <http://purl.org/opdm/refrigerator#Fridge>;
              rdfs:range xsd:boolean.
<http://purl.oclc.org/NET/ssnx/ssn#FeatureOfInterest> a rdfs:Class.
<http://purl.oclc.org/NET/ssnx/ssn#MeasurementProperty> a rdfs:Class.
<http://purl.oclc.org/NET/ssnx/ssn#Observation> a rdfs:Class.
<http://purl.oclc.org/NET/ssnx/ssn#SensingDevice> a rdfs:Class.
<http://purl.oclc.org/NET/ssnx/ssn#ofFeature> a rdf:Property.
<http://purl.org/goodrelations/v1#ActualProductOrServiceInstance> a rdfs:Class.
<http://purl.org/goodrelations/v1#Individual> a rdfs:Class;
                                              rdfs:subClassOf <http://purl.org/goodrelations/v1#ActualProductOrServiceInstance>.
<http://purl.org/opdm/refrigerator#Fridge> a rdfs:Class;
                                           rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#FeatureOfInterest>.
<http://schema.org/Person> a rdfs:Class.
<http://schema.org/Residence> a rdfs:Class.
<http://www.loa-cnr.it/ontologies/DUL.owl#Person> a rdfs:Class.
