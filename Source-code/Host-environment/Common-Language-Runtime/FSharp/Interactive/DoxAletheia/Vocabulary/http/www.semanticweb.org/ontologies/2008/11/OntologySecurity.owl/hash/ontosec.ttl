ontosec:vCard a owl:Class;
              rdfs:comment "vCard is a virtual electronic business card format.";
              rdfs:subClassOf ontosec:StandardFiles.
<http://www.semanticweb.org/ontologies/2008/11/OntologyServices.owl#Services> a owl:Class;
                                                                              rdfs:comment "Security services ontology"@en;
                                                                              rdfs:subClassOf owl:Thing.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#AccessControl> a <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#AccessToUntrustedWebSite> a owl:Class;
                                                                                               rdfs:comment "Several attacks may be achieved after access to hacked web sites like cross site scripting (XSS) for example.";
                                                                                               rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ApplicationAPIAttack> a owl:Class;
                                                                                           rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#BatteryLimitation> a owl:Class;
                                                                                        rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PhysicalVulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Bluetooth> a <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerableServiceAutoStart>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#BruteForce> a owl:Class;
                                                                                 rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ByPassingAuthentication>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#BufferOverFlow> a owl:Class;
                                                                                     rdfs:comment "By passing data through an API where it is known that the API is designed to receive X bytes and we are passing X+N bytes, it can be arranged that the N bytes overflow into an area that was used by other storage (if it is a heap overflow) or will cause the return address to be corrupted (if it is a stack overflow). OMTP";
                                                                                     rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MalformedInput>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ByPassingAuthentication> a owl:Class;
                                                                                              rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CodeInjection> a owl:Class;
                                                                                    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MalformedInput>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CommunicationVulnerability> a owl:Class;
                                                                                                 rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> a owl:Class;
                                                                                     rdfs:subClassOf owl:Thing.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CryptographicAttack> a owl:Class;
                                                                                          rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#DefaultPIN> a owl:Class;
                                                                                 rdfs:comment "Always set to manufacturer default values";
                                                                                 rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#InsecureDefaultSettings>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#DefaultPassword> a owl:Class;
                                                                                      rdfs:comment "Always set to manufacturer default values";
                                                                                      rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#InsecureDefaultSettings>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#DevicePortability> a owl:Class;
                                                                                        rdfs:comment "The easy portability of the device make it vulnerable to rabbers and theft.";
                                                                                        rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PhysicalVulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#DoS> a owl:Class;
                                                                          rdfs:comment "Most common type involves flooding a host until it cannot respond to legitimate traffic.";
                                                                          rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Eavesdropping> a owl:Class;
                                                                                    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack>;
                                                                                    owl:equivalentClass <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Interception>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Emanation> a owl:Class;
                                                                                rdfs:comment """The fact of making internal data available to third parties by radio.. In that case,the issuer is the passive victim of the attack.
Almost all electrical devices emit radiation to the exterior that can be intercepted by other equipment (radio receivers) causing a leak of information. This threat is frequently but inaccurately called, a TEMPEST attack (“Transient Electromagnetic Pulse Standard”).""";
                                                                                rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PhysicalVulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#EquipmentDos> a owl:Class;
                                                                                   rdfs:comment "The attacker causes an overload or a disruption in the system such that network functions  in an abnormal manner. The abnormal behavior could be legitimate subscribers not receiving service, illegitimate subscribers receiving service or the entire network may disabled as a result of the attack.";
                                                                                   rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ExternalBatteryRemovel> a owl:Class;
                                                                                             rdfs:comment "Bypassing security barries may be performed through a battery removal. For example in a DRM situation, a song may have been played, but if the rights count is not decremented until the end of the song, then removing the power source could result in the user playing the song indefinitely(OMPT).";
                                                                                             rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ExternalMemoryCardRemoval> a owl:Class;
                                                                                                rdfs:comment "Bypassing security barries may be performed through a battery removal. For example in a DRM situation, a song may have been played, but if the rights count is not decremented until the end of the song, then removing the memory card could result in the user playing the song indefinitely(OMPT).";
                                                                                                rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#FOTAUnAuthorizedReFlash> a owl:Class;
                                                                                              rdfs:comment "UnAuthorized reflash via Firmware Over The Air. FOTA consists in replacing one version of the general OS(s) with another over the Air.";
                                                                                              rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Fabrication> a owl:Class;
                                                                                  rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack>;
                                                                                  owl:equivalentClass <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Replay>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#FormatStringAttack> a owl:Class;
                                                                                         rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MalformedInput>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareAttack> a owl:Class;
                                                                                     rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareCloning> a owl:Class;
                                                                                      rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#InputOutputLimitation> a owl:Class;
                                                                                            rdfs:comment "Limited screen display and small keypad ad some aggravation to attacks like phishing for example.";
                                                                                            rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PhysicalVulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#InsecureDefaultSettings> a owl:Class;
                                                                                              rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInConfig>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Interception> a owl:Class;
                                                                                   rdfs:comment "The attacker intercepts information without modifing or deleting them. This is a passive attack. This affects the privacy of the subscriber and the network operator.";
                                                                                   rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Interruption> a owl:Class;
                                                                                   rdfs:comment "The attacker caused an Interruption by destroying resources. The attacker may delete a subscriber data in the entity such as an HLR.";
                                                                                   rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MalformedInput> a owl:Class;
                                                                                     rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MissingErrorHandling> a owl:Class;
                                                                                           rdfs:comment "Missing error handling may reveal hidden coding details.";
                                                                                           rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInDevelopment>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MissingInputValidation> a owl:Class;
                                                                                             rdfs:comment "Leaving inputs to a lightweight validation i's one of the most relevant applicationn vulnerability.";
                                                                                             rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInDevelopment>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#MultipleServicesIntegration> a owl:Class;
                                                                                                  rdfs:comment "The integration of several networkign services like access to PAN, LAN and WAN in the same divice makes hard the set up of access control policies. This integration  agravates also the multi-session attacks.";
                                                                                                  rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CommunicationVulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NAKAttack> a owl:Class;
                                                                                rdfs:comment "Concurrent processes may cause logical breaks. These breaks could be exploited by malicious code to get access to protected resources.";
                                                                                rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack> a owl:Class;
                                                                                                  rdfs:comment "These attacks belong to the mobile network operator. Most of them require physical air interface equipments like fake base station or modified antenna.";
                                                                                                  rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NotAuthenticatedSoftInstallation> a owl:Class;
                                                                                                       rdfs:comment "Several untrusted softwares are available for free download or through the trasnfer from an other device. These softwares may be infected with viruses or have trojans. They may also come up with bad code that leads to denial of service.";
                                                                                                       rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#OTASoftwareUpdate> a owl:Class;
                                                                                        rdfs:comment "Software Update can be performed Over The Air without user konwledge or confirmation. These softwares may be infected or trojanized.";
                                                                                        rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PhysicalVulnerability> a owl:Class;
                                                                                            rdfs:comment "Features related to the physical aspect of the device and its properties.";
                                                                                            rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PowerAnalysis> a owl:Class;
                                                                                    rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SideChannelAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ProcessingPowerLimitation> a owl:Class;
                                                                                                rdfs:comment "Limited Processing power is boundary for cryptographic enhanced tasks.";
                                                                                                rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#PhysicalVulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Replay> a owl:Class;
                                                                             rdfs:comment "In this case the attacker may insert spurious objects into the system. The attacker may insert fake signaling messages, the effects could result in the attacker masquerading as an authority.";
                                                                             rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#NetworkInfrastructureAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#RoamingConfigChallenges> a owl:Class;
                                                                                              rdfs:comment "Switching from one network to an other should respect security policies.";
                                                                                              rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CommunicationVulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SideChannelAttack> a owl:Class;
                                                                                        rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#HardwareAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SmartCardUpdate> a owl:Class;
                                                                                      rdfs:comment "The procedure of updating the SIM card is a heavy task for the operator.";
                                                                                      rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CommunicationVulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareAttack> a owl:Class;
                                                                                     rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareVulnerability> a owl:Class;
                                                                                            rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#StatisticalAttack> a owl:Class;
                                                                                        rdfs:comment "A cryptanalysis that exploits the predictibility of a particular data segment or a prdicatable relationships among different data segments in a cipher codestream to deduce the plaintext without the knowledge of the decryption key or to substantially reduce the search space such that a brute force attack is feasable.";
                                                                                        rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CryptographicAttack>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#TestWithEmulatorOnly> a owl:Class;
                                                                                           rdfs:comment "After developement, applications should be tested with real and different devices and not only with emulators.";
                                                                                           rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInDevelopment>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> a owl:Class;
                                                                             rdfs:subClassOf [owl:someValuesFrom xsd:string ; 
                                                                                              owl:onProperty ontosec:hasThreatType ; 
                                                                                              a owl:Restriction],
                                                                                             [owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability> ; 
                                                                                              owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#enabledBy> ; 
                                                                                              a owl:Restriction],
                                                                                             [owl:someValuesFrom ontosec:Asset ; 
                                                                                              owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threatens> ; 
                                                                                              a owl:Restriction],
                                                                                             [owl:someValuesFrom xsd:string ; 
                                                                                              owl:onProperty ontosec:hasThreatType ; 
                                                                                              a owl:Restriction],
                                                                                             [owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability> ; 
                                                                                              owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#enabledBy> ; 
                                                                                              a owl:Restriction],
                                                                                             [owl:someValuesFrom ontosec:Asset ; 
                                                                                              owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threatens> ; 
                                                                                              a owl:Restriction],
                                                                                             owl:Thing.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threatens> a owl:ObjectProperty;
                                                                                rdfs:domain <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat>;
                                                                                owl:inverseOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#victimOf>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#UnsafeMessageAcceptance> a owl:Class;
                                                                                              rdfs:comment "Non authenticated SMS or MMS may deal to denial fo service or virus infection.";
                                                                                              rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#UnsafeStorageDevicePlugging> a owl:Class;
                                                                                                  rdfs:comment "Exchanging Memory card may lead to virus infection.";
                                                                                                  rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#UseofUntrustedAPI> a owl:Class;
                                                                                        rdfs:comment "Some API, components may be downloaded and used by developers without any security garantee.";
                                                                                        rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInDevelopment>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#UseofVulnerableProgLanguage> a owl:Class;
                                                                                                  rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInDevelopment>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability> a owl:Class;
                                                                                    rdfs:subClassOf [owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> ; 
                                                                                                     owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#isExploitedBy> ; 
                                                                                                     a owl:Restriction],
                                                                                                    [owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> ; 
                                                                                                     owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#isCorrectedBy> ; 
                                                                                                     a owl:Restriction],
                                                                                                    [owl:someValuesFrom ontosec:Asset ; 
                                                                                                     owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#existsOn> ; 
                                                                                                     a owl:Restriction],
                                                                                                    [owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> ; 
                                                                                                     owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#isExploitedBy> ; 
                                                                                                     a owl:Restriction],
                                                                                                    [owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure> ; 
                                                                                                     owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#isCorrectedBy> ; 
                                                                                                     a owl:Restriction],
                                                                                                    [owl:someValuesFrom ontosec:Asset ; 
                                                                                                     owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#existsOn> ; 
                                                                                                     a owl:Restriction],
                                                                                                    owl:Thing.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInConfig> a owl:Class;
                                                                                            rdfs:comment "Some default configurations of services may be exploited by hackers.";
                                                                                            rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareVulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInDevelopment> a owl:Class;
                                                                                                 rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareVulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerabilityInUse> a owl:Class;
                                                                                         rdfs:comment "Vulnerabilities during the use of the application or service.";
                                                                                         rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SoftwareVulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#VulnerableServiceAutoStart> a owl:Class;
                                                                                                 rdfs:comment "Some services like Bluetooth for example starts automatically which may lead to intrusion and access controls attacks.";
                                                                                                 rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#InsecureDefaultSettings>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#WirelessTransmission> a owl:Class;
                                                                                           rdfs:comment "Wireless transmission could be exploited by hacker to eavesdrop traffic, analyse authentication tokens and sensitive information in general.";
                                                                                           rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CommunicationVulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#enabledBy> a owl:ObjectProperty;
                                                                                rdfs:domain <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat>;
                                                                                rdfs:range <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#existsOn> a owl:ObjectProperty;
                                                                               rdfs:domain <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#hasVulnerability> a owl:ObjectProperty;
                                                                                       rdfs:range <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#isCorrectedBy> a owl:ObjectProperty;
                                                                                    rdfs:domain <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability>;
                                                                                    rdfs:range <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#isExploitedBy> a owl:ObjectProperty;
                                                                                    rdfs:domain <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Vulnerability>;
                                                                                    rdfs:range <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat>;
                                                                                    owl:inverseOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#enabledBy>.
<http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#victimOf> a owl:ObjectProperty;
                                                                               rdfs:range <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat>.
owl:Thing a owl:Class;
          rdfs:comment "".
