                                                      [owl:someValuesFrom ontosec:CommChannel ; 
                                                      owl:onProperty ontosec:Use ; 
                                                      a owl:Restriction]) ; 
                                  a owl:Class].
ontosec:WiFi a owl:Class;
             rdfs:subClassOf ontosec:LANetwork.
ontosec:WithoutVerification a ontosec:AuthenticationLevel.
