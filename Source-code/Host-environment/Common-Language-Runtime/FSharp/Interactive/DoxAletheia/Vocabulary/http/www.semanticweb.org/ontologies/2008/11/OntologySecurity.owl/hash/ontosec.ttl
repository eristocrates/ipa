                   rdfs:comment "Additional and required types for the ontology";
                   rdfs:subClassOf owl:Thing.
ontosec:VeriSignTesting-BasedACSRootSymbian a ontosec:X509Certificate.
ontosec:Verisign a ontosec:CertificationAuthority.
ontosec:VibrationKit a owl:Class;
                     rdfs:subClassOf ontosec:Output.
ontosec:VideoInput a owl:Class;
                   rdfs:subClassOf ontosec:Input.
ontosec:Videos a owl:Class;
               rdfs:subClassOf ontosec:StandardFiles.
ontosec:Voice a owl:Class;
              rdfs:subClassOf ontosec:Manual.
ontosec:WANetwork a owl:Class;
