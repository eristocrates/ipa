                          rdfs:subClassOf ontosec:BestPractises.
ontosec:TestPhase a owl:Class;
                  rdfs:subClassOf ontosec:ApplicationLifeCyclePhase.
ontosec:ThreatType a owl:Class;
                   rdfs:subClassOf ontosec:ValueTypes.
ontosec:Time a owl:Class;
             rdfs:subClassOf ontosec:Duration.
ontosec:TimeAnalysis a owl:Class;
                     rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#SideChannelAttack>.
ontosec:TimeBasedOTP a owl:Class;
                     rdfs:comment "A client and server time synchronization is required for the authentication token verification.";
                     rdfs:subClassOf ontosec:O.T.P.
ontosec:TimeStampToken a owl:Class;
                       rdfs:comment "A digital signature that makes possible the verification of the sending time of a message.";
                       rdfs:subClassOf ontosec:AuthenticationToken.
ontosec:Timeliness a owl:Class;
                   rdfs:subClassOf ontosec:Usability.
ontosec:TopSecret a ontosec:ConfidentialityLevel.
ontosec:TouchScreen a owl:Class;
                    rdfs:subClassOf ontosec:Input;
                    owl:equivalentClass [owl:intersectionOf (ontosec:DisplayScreen
                                                             ontosec:KeyPad) ; 
                                         a owl:Class],
                                        [owl:intersectionOf (ontosec:DisplayScreen
                                                             ontosec:KeyPad) ; 
                                         a owl:Class].
ontosec:Training a owl:Class;
                 rdfs:comment "Requirement for additional training to use some tools or to do some technalical or management tasks.";
                 rdfs:subClassOf ontosec:Cost.
ontosec:Transaction a owl:Class;
                    rdfs:subClassOf ontosec:Duration.
ontosec:TransmittedData a owl:Class;
                        rdfs:comment "Messaging data or data transferred through Internet connection";
                        rdfs:subClassOf ontosec:Data.
ontosec:TrustedAPIAttack a owl:Class;
                         rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ApplicationAPIAttack>.
ontosec:TrustedThirdParty a owl:Class;
                          rdfs:comment "security authority or its agent, trusted by other entities with respect to security-related activities. In the context of ISO/IEC 9798, a trusted third party is trusted by a claimant and/or a verifier for the purposes of authentication.  ISO/IEC 9798";
                          rdfs:subClassOf [owl:someValuesFrom ontosec:TrustedThirdParty ; 
                                           owl:onProperty ontosec:hasTrustIn ; 
                                           a owl:Restriction],
                                          [owl:someValuesFrom ontosec:Certificate ; 
                                           owl:onProperty ontosec:Issue ; 
                                           a owl:Restriction],
                                          [owl:someValuesFrom ontosec:SourceCodeVerification ; 
                                           owl:onProperty ontosec:Provide ; 
                                           a owl:Restriction],
                                          [owl:someValuesFrom ontosec:TrustedThirdParty ; 
                                           owl:onProperty ontosec:hasTrustIn ; 
                                           a owl:Restriction],
                                          [owl:someValuesFrom ontosec:Certificate ; 
                                           owl:onProperty ontosec:Issue ; 
                                           a owl:Restriction],
                                          [owl:someValuesFrom ontosec:SourceCodeVerification ; 
                                           owl:onProperty ontosec:Provide ; 
                                           a owl:Restriction],
                                          ontosec:Actor.
ontosec:TrustedThirdPartyCertificate dc11:format "A certificate which is issued by a trusted third party.";
                                     a owl:Class;
                                     rdfs:subClassOf ontosec:Certificate.
ontosec:TunneledPassword a owl:Class;
                         rdfs:subClassOf ontosec:AuthenticationProtocolType.
ontosec:TypeSafe-Unsafe a ontosec:CodingStandards;
                        rdfs:comment "Don't mix type safe and type-unsafe API".
ontosec:TypeSafeAPIUse a owl:Class;
                       rdfs:subClassOf ontosec:BestPractises.
ontosec:UICC a owl:Class;
             rdfs:comment "The UICC is a generic platform for smart card applications. It has been standardised by ETSI EP SCP (ETSI Project Smart Card Platform) with the aim of defining a physical and logical platform for all smart card applications and to develop advanced security methods for financial transactions, to take an example. Mobey forum";
             rdfs:subClassOf ontosec:SmartCard.
ontosec:UMTS a owl:Class;
             rdfs:subClassOf ontosec:3G.
ontosec:USIM a owl:Class;
             rdfs:comment "A (U)SIM is a special type of smart card that typically contains a processor and between 16 to 128 KB of persistent Electronically Erasable, Programmable ROM (EEPROM). It also includes RAM for program execution and ROM for the operating system, user authentication and data encryption algorithms, and other applications.";
             rdfs:subClassOf ontosec:SmartCard.
ontosec:UnTrustedAPIAttack a owl:Class;
                           rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ApplicationAPIAttack>.
ontosec:UnifiedTestingInitiativeRootCertificate a owl:Class;
                                                rdfs:subClassOf ontosec:DeviceCapabilities.
ontosec:UnsafeDataTypeAttack a owl:Class;
                             rdfs:subClassOf ontosec:TrustedAPIAttack.
ontosec:Usability a owl:Class;
                  rdfs:comment "A good response time of the application.";
                  rdfs:subClassOf ontosec:Quality.
ontosec:Use a owl:TransitiveProperty,
              owl:ObjectProperty;
            rdfs:subPropertyOf ontosec:Relationship.
ontosec:UsePhase a owl:Class;
                 rdfs:subClassOf ontosec:ApplicationLifeCyclePhase.
ontosec:VPN a owl:Class;
            rdfs:comment "Virtula private network. FIPS 140-2";
            rdfs:subClassOf [owl:someValuesFrom [owl:unionOf (ontosec:IPSec
                                                              ontosec:SSL
                                                              ontosec:TLS) ; 
                                                 a owl:Class] ; 
                             owl:onProperty ontosec:Use ; 
                             a owl:Restriction],
                            [owl:someValuesFrom [owl:unionOf (ontosec:IPSec
                                                              ontosec:SSL
                                                              ontosec:TLS) ; 
                                                 a owl:Class] ; 
                             owl:onProperty ontosec:Use ; 
                             a owl:Restriction],
                            ontosec:SecurityInfrastructure.
