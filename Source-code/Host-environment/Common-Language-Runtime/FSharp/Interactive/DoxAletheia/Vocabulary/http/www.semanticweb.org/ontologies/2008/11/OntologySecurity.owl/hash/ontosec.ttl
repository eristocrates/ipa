                                       ontosec:ResourceMonitoring.
ontosec:BestPractises a owl:Class;
                      rdfs:subClassOf ontosec:Standards.
ontosec:BiometricIdentifier a owl:Class;
                            rdfs:comment "Biometric identifier is one of the most secure and more reliable ways to authenticate a person’s identity is to verify that person’s innate biological characteristics, which are referred to as biometrics. Each person’s fingerprints, DNA, iris and retinal cell patterns, facial geometry, and heat signature are near unique to that person. These biometric measures, if properly recorded, validated, and embedded in identity credentials that are logically bound to a single person’s identity, can provide the highest degree of identity authentication (From NIST information security Report)";
                            rdfs:subClassOf [owl:someValuesFrom ontosec:Portability ; 
                                             owl:onProperty ontosec:Hurt ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom ontosec:Resource ; 
                                             owl:onProperty ontosec:Use ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom ontosec:Portability ; 
                                             owl:onProperty ontosec:Hurt ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom ontosec:Resource ; 
                                             owl:onProperty ontosec:Use ; 
                                             a owl:Restriction],
                                            ontosec:AuthenticationToken.
ontosec:BlockCipherAlgorithm a owl:Class;
                             rdfs:subClassOf [owl:someValuesFrom xsd:hexBinary ; 
                                              owl:onProperty ontosec:hasPadding ; 
                                              a owl:Restriction],
                                             [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onClass ontosec:ChainingMode ; 
                                              owl:onProperty ontosec:hasChainingMode ; 
                                              a owl:Restriction],
                                             [owl:allValuesFrom xsd:hexBinary ; 
                                              owl:onProperty ontosec:hasInitialisationVector ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom xsd:hexBinary ; 
                                              owl:onProperty ontosec:hasPadding ; 
                                              a owl:Restriction],
                                             [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty ontosec:HasBlockSize ; 
                                              a owl:Restriction],
                                             [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty ontosec:HasBlockSize ; 
                                              a owl:Restriction],
                                             ontosec:SymmetricAlgorithm,
                                             [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onClass ontosec:ChainingMode ; 
                                              owl:onProperty ontosec:hasChainingMode ; 
                                              a owl:Restriction],
                                             [owl:allValuesFrom xsd:hexBinary ; 
                                              owl:onProperty ontosec:hasInitialisationVector ; 
                                              a owl:Restriction].
ontosec:Blowfish a owl:Class;
                 rdfs:subClassOf ontosec:BlockCipherAlgorithm.
ontosec:Bluetooth a owl:Class;
                  rdfs:comment "Bluetooth is a Personal Area Network (PAN) standard that enables wireless connections between electronic devices in the 2.4 GHz range over short distances, as an alternative to cables. Designed to be power efficient, Bluetooth has become a common feature in cell phones. Since wireless communications are inherently insecure, a number of basic security provisions have been defined for this standard to mitigate the risks involved. NIST";
                  rdfs:subClassOf ontosec:PANetwork.
ontosec:Break a owl:ObjectProperty;
              rdfs:subPropertyOf ontosec:QualitySatisfaction.
ontosec:ByPassingTrialCounter a owl:Class;
                              rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#ByPassingAuthentication>.
ontosec:CBC a owl:Class;
            rdfs:subClassOf ontosec:ChainingMode.
ontosec:CBC-MAC a owl:Class;
                rdfs:comment "The simplest way to make a key-dependent one-way hash function is to encrypt a message with a block algorithm in CBC or CFB modes . The hash is the last encrypted block, encrypted once more in CBC or CFB modes.";
                rdfs:subClassOf ontosec:MACAlgorithm.
ontosec:CFB a owl:Class;
            rdfs:subClassOf ontosec:ChainingMode.
ontosec:COMSET a owl:Class;
               rdfs:subClassOf ontosec:KeyExchangeProtocol.
ontosec:CardMemory a owl:Class;
                   rdfs:subClassOf ontosec:Add-OnMemory.
ontosec:CardType a owl:Class;
                 rdfs:subClassOf ontosec:ValueTypes.
ontosec:Certificate dc11:format """A digital certificate is a text document that contains general information about its holder with the associated public key and general informations about the validity of the certificate. The digital certificate is signed by the certification authority that has issued it and can be verified a digital signature.
The digital certificates, together with the identity data and public key, are stored on a USB-compatible token or a conventional smart card for use as part of strong authentication. When users try to log on to the corporate network, they connect their token with the USB slot or their smart card with the card reader.The digital certificate and public key are sent to the authentication authority via internet. To ensure that the public key sent actually belongs to the person attempting to log on to the corporate networks, the independent certification authority confirms that the public key matches the secret key it has stored""";
                    a owl:Class;
                    rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty ontosec:hasValidity ; 
                                     a owl:Restriction],
                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty ontosec:hasValidity ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom ontosec:DigitalSignatureAlgorithm ; 
                                     owl:onProperty ontosec:hasSignatureAlgorithm ; 
                                     a owl:Restriction],
                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty ontosec:hasSubjectName ; 
                                     a owl:Restriction],
                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty ontosec:hasDigitalSignatureData ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom ontosec:CertificateFormat ; 
                                     owl:onProperty ontosec:hasFormat ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom ontosec:CertificationAuthority ; 
                                     owl:onProperty ontosec:hasIssuer ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom ontosec:CertificateFormat ; 
                                     owl:onProperty ontosec:hasFormat ; 
                                     a owl:Restriction],
                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty ontosec:hasSubjectName ; 
                                     a owl:Restriction],
                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty ontosec:hasDigitalSignatureData ; 
                                     a owl:Restriction],
                                    ontosec:AuthenticationToken,
                                    [owl:someValuesFrom ontosec:CertificationAuthority ; 
                                     owl:onProperty ontosec:hasIssuer ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom ontosec:DigitalSignatureAlgorithm ; 
                                     owl:onProperty ontosec:hasSignatureAlgorithm ; 
                                     a owl:Restriction].
