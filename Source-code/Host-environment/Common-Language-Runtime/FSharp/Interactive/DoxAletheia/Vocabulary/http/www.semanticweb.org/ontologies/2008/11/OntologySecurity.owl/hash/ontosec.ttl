                        rdfs:subClassOf ontosec:CertificateFormat.
ontosec:Yahalom a owl:Class;
                rdfs:subClassOf ontosec:AuthenticationProtocol.
ontosec:Yarrow a owl:Class;
               rdfs:subClassOf ontosec:PRNGAlgorithm.
ontosec:ZeroKnowledgePassword a owl:Class;
