                                             [owl:someValuesFrom ontosec:Confidentiality ; 
                                              owl:onProperty ontosec:Satisfice ; 
                                              a owl:Restriction],
                                             ontosec:CoreCounterMeasure.
ontosec:ActiveThreat a ontosec:ThreatType.
ontosec:Actor a owl:Class;
              rdfs:comment "Actors participating in the realisation and implementation of security services";
