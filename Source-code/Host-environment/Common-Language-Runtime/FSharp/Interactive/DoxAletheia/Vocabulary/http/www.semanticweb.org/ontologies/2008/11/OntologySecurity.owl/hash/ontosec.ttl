                       rdfs:range xsd:string.
ontosec:hasThreatType a owl:DatatypeProperty;
                      rdfs:comment "A Threat type may be a passive or an active threat.";
                      rdfs:domain <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat>;
                      rdfs:range xsd:string.
ontosec:hasTrustIn a owl:ReflexiveProperty,
