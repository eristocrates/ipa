ontosec:AccessControl a owl:Class;
                      rdfs:subClassOf <http://www.semanticweb.org/ontologies/2008/11/OntologyServices.owl#Services>.
ontosec:AccessControlList a owl:Class;
                          rdfs:comment "List of permissions attached to an object.";
                          rdfs:subClassOf ontosec:AccessControlMethods.
ontosec:AccessControlMethods a owl:Class;
                             rdfs:subClassOf [owl:someValuesFrom ontosec:AccessControl ; 
                                              owl:onProperty ontosec:Satisfice ; 
