                                               a owl:Restriction],
                                              ontosec:Actor.
ontosec:AppliedTo a owl:ObjectProperty;
                  rdfs:subPropertyOf ontosec:Relationship.
ontosec:Asset a owl:Class;
              rdfs:comment "The set of assets that should be protected";
              rdfs:subClassOf [owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> ; 
                               owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#victimOf> ; 
                               a owl:Restriction],
                              [owl:someValuesFrom <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#Threat> ; 
                               owl:onProperty <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#victimOf> ; 
                               a owl:Restriction],
                              owl:Thing.
ontosec:AssociatedOriented a ontosec:NonRepudiationType.
ontosec:AsymmetricAlgorithm a owl:Class;
                            rdfs:subClassOf [owl:allValuesFrom [owl:intersectionOf (ontosec:PrivateKey
                                                                                    ontosec:PublicKey) ; 
                                                                a owl:Class] ; 
                                             owl:onProperty ontosec:Use ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom ontosec:Efficiency ; 
                                             owl:onProperty ontosec:Hurt ; 
                                             a owl:Restriction],
                                            [owl:allValuesFrom [owl:intersectionOf (ontosec:PrivateKey
                                                                                    ontosec:PublicKey) ; 
                                                                a owl:Class] ; 
                                             owl:onProperty ontosec:Use ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom ontosec:Efficiency ; 
                                             owl:onProperty ontosec:Hurt ; 
                                             a owl:Restriction],
                                            ontosec:Algorithm.
ontosec:AsymmetricEncryption a owl:Class;
                             rdfs:comment "Type of encryption in which an encryption key (the public key) is used to encrypt a message, and another encryption key (the private key) is used to decrypt the message.";
                             rdfs:subClassOf [owl:someValuesFrom ontosec:KeyExchangeProtocol ; 
                                              owl:onProperty ontosec:Use ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom ontosec:AsymmetricAlgorithm ; 
                                              owl:onProperty ontosec:Use ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom ontosec:KeyExchangeProtocol ; 
                                              owl:onProperty ontosec:Use ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom ontosec:AsymmetricAlgorithm ; 
                                              owl:onProperty ontosec:Use ; 
                                              a owl:Restriction],
                                             ontosec:Encryption.
ontosec:Authentication a owl:Class;
                       rdfs:subClassOf [owl:someValuesFrom ontosec:DomainEntities ; 
                                        owl:onProperty ontosec:AppliedTo ; 
                                        a owl:Restriction],
                                       [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onClass ontosec:AuthenticationLevel ; 
                                        owl:onProperty ontosec:hasLevel ; 
