ontosec:DigitalSignature a owl:Class;
                         rdfs:comment """A digital signature is represented in a computer as a string of binary
digits. A digital signature is computed using a set of rules and a set of parameters such that the identity of the signatory and integrity of the data can be verified. An algorithm provides the capability to generate and verify signatures. Signature generation makes use of a private key to generate a digital signature. Signature verification makes use of a public key which corresponds to, but is not the same as, the private key. (http://csrc.nist.gov/publications/fips/fips186-2/fips186-2-change1.pdf)""";
                         rdfs:subClassOf [owl:someValuesFrom ontosec:NonRepudiation ; 
                                          owl:onProperty ontosec:Satisfice ; 
                                          a owl:Restriction],
                                         [owl:someValuesFrom ontosec:Authentication ; 
                                          owl:onProperty ontosec:Satisfice ; 
                                          a owl:Restriction],
                                         [owl:unionOf ([owl:someValuesFrom ontosec:MACAlgorithm ; 
                                                       owl:onProperty ontosec:Use ; 
                                                       a owl:Restriction]
                                                       [owl:someValuesFrom [owl:intersectionOf (ontosec:CryptographicHashFunction
                                                                                               ontosec:DigitalSignatureAlgorithm) ; 
                                                                           a owl:Class] ; 
                                                       owl:onProperty ontosec:Use ; 
                                                       a owl:Restriction]) ; 
                                          a owl:Class],
                                         [owl:someValuesFrom ontosec:NonRepudiation ; 
                                          owl:onProperty ontosec:Satisfice ; 
                                          a owl:Restriction],
                                         [owl:someValuesFrom ontosec:Authentication ; 
                                          owl:onProperty ontosec:Satisfice ; 
                                          a owl:Restriction],
                                         [owl:unionOf ([owl:someValuesFrom ontosec:MACAlgorithm ; 
                                                       owl:onProperty ontosec:Use ; 
                                                       a owl:Restriction]
                                                       [owl:someValuesFrom [owl:intersectionOf (ontosec:CryptographicHashFunction
                                                                                               ontosec:DigitalSignatureAlgorithm) ; 
                                                                           a owl:Class] ; 
                                                       owl:onProperty ontosec:Use ; 
                                                       a owl:Restriction]) ; 
                                          a owl:Class],
                                         ontosec:CoreCounterMeasure.
ontosec:DigitalSignatureAlgorithm a owl:Class;
                                  rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onClass ontosec:PrivateKey ; 
                                                   owl:onProperty ontosec:Use ; 
                                                   a owl:Restriction],
                                                  [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onClass ontosec:PrivateKey ; 
