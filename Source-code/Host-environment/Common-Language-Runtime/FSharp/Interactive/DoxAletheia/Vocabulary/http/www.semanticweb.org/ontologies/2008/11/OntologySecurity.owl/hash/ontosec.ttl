ontosec:ApplicationData a owl:Class;
                        rdfs:subClassOf ontosec:Data.
ontosec:ApplicationLifeCyclePhase a owl:Class;
                                  rdfs:subClassOf ontosec:ValueTypes.
ontosec:ApplicationServerSide a owl:Class;
                              rdfs:comment "The application server side may be a web server or a data base back end that the device connects to.";
                              rdfs:subClassOf [owl:someValuesFrom ontosec:Backup ; 
                                               owl:onProperty ontosec:ImplementMechanism ; 
                                               a owl:Restriction],
                                              [owl:someValuesFrom ontosec:Journaling ; 
                                               owl:onProperty ontosec:ImplementMechanism ; 
                                               a owl:Restriction],
                                              [owl:someValuesFrom ontosec:Backup ; 
