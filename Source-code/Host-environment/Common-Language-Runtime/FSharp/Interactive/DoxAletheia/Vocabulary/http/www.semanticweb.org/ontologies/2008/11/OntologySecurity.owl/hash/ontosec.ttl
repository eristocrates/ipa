ontosec:StandardFiles a owl:Class;
                      rdfs:subClassOf ontosec:LocalFiles.
ontosec:Standards a owl:Class;
                  rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure>.
ontosec:Static_password a owl:Class;
                        rdfs:comment "The standard couple of login and password authentication";
                        rdfs:subClassOf ontosec:Password.
ontosec:Steganography a owl:Class;
                      rdfs:comment "Steganography is the art and science of writing hidden messages in such a way that no-one, apart from the sender and intended recipient, suspects the existence of the message, a form of security through obscurity. Wikipedia";
                      rdfs:subClassOf ontosec:Encryption.
ontosec:SteganographyAlgorithm a owl:Class;
                               rdfs:subClassOf ontosec:Algorithm.
ontosec:Store a owl:ObjectProperty;
              rdfs:subPropertyOf ontosec:Relationship.
ontosec:StoredData a owl:Class;
                   rdfs:comment "Data stored either in the device or on the memory card.";
                   rdfs:subClassOf [owl:intersectionOf ([owl:unionOf (ontosec:ApplicationData
                                                                     ontosec:ConfigurationData) ; 
                                                        a owl:Class]
                                                        [owl:someValuesFrom [owl:unionOf (ontosec:LocalDataBase
                                                                                         ontosec:LocalFiles) ; 
                                                                            a owl:Class] ; 
                                                        owl:onProperty ontosec:hasDataStructure ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class],
                                   [owl:intersectionOf ([owl:unionOf (ontosec:ApplicationData
                                                                     ontosec:ConfigurationData) ; 
                                                        a owl:Class]
                                                        [owl:someValuesFrom [owl:unionOf (ontosec:LocalDataBase
                                                                                         ontosec:LocalFiles) ; 
                                                                            a owl:Class] ; 
                                                        owl:onProperty ontosec:hasDataStructure ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class],
                                   ontosec:Data.
ontosec:StreamCipherAlgorithm a owl:Class;
                              rdfs:subClassOf ontosec:SymmetricAlgorithm.
ontosec:SymbianSigned a ontosec:CertificationAuthority.
ontosec:SymmetricAlgorithm a owl:Class;
                           rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onClass ontosec:SecretKey ; 
                                            owl:onProperty ontosec:hasKey ; 
                                            a owl:Restriction],
                                           [owl:someValuesFrom ontosec:Efficiency ; 
                                            owl:onProperty ontosec:Help ; 
                                            a owl:Restriction],
                                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onClass ontosec:SecretKey ; 
                                            owl:onProperty ontosec:hasKey ; 
                                            a owl:Restriction],
                                           [owl:someValuesFrom ontosec:Efficiency ; 
                                            owl:onProperty ontosec:Help ; 
                                            a owl:Restriction],
                                           ontosec:Algorithm.
ontosec:SymmetricEncryption a owl:Class;
                            rdfs:comment "Also known as conventional, secret-key, and single-key algorithms; the encryption and decryption key are either the same or can be calculated from one another. Block ciphers and stream ciphers are both used for symmetric encryption.";
                            rdfs:subClassOf [owl:someValuesFrom ontosec:SymmetricAlgorithm ; 
                                             owl:onProperty ontosec:Use ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom ontosec:SymmetricAlgorithm ; 
                                             owl:onProperty ontosec:Use ; 
                                             a owl:Restriction],
                                            ontosec:Encryption.
ontosec:SymmetricKeyPoP a owl:Class;
                        rdfs:subClassOf ontosec:AuthenticationProtocolType.
ontosec:TLS a owl:Class;
            rdfs:comment "Transport Layer Security is an IETF standard that is intended to replace the SSL protocol. (IETF Working Group)";
            rdfs:subClassOf ontosec:SecureNetworkCommunication.
ontosec:TRNG a owl:Class;
             rdfs:comment "True Random Number Generation : extract randomness from physical phenomena and introduce it into computing device.";
             rdfs:subClassOf [owl:someValuesFrom ontosec:Input ; 
                              owl:onProperty ontosec:Use ; 
                              a owl:Restriction],
                             [owl:someValuesFrom ontosec:Input ; 
                              owl:onProperty ontosec:Use ; 
                              a owl:Restriction],
                             ontosec:KeyGeneration.
ontosec:Technical a owl:Class;
                  rdfs:comment "All limitations related to technologies like the network bandwidth or processor capabilities.";
                  rdfs:subClassOf ontosec:Constraints.
ontosec:Techniques a owl:Class;
                   rdfs:subClassOf <http://www.semanticweb.org/ontologies/2009/1/3/VulnThreatAttack.owl#CounterMeasure>.
