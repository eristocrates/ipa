                                                       a rdfs:Datatype] ; 
                                      a owl:Restriction].
lswpm:randomtestpoints a owl:Class;
                       rdfs:label "random test points";
                       rdfs:subClassOf lslife:LifemapperParameter;
                       owl:equivalentClass [owl:onProperty lslife:hasDefaultValue ; 
                                            owl:hasValue 0  ; 
                                            a owl:Restriction],
                                           [owl:onProperty lswmo:hasParameterName ; 
                                            owl:hasValue "randomtestpoints" ; 
                                            a owl:Restriction],
                                           [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty lswmo:boundToValue ; 
                                            owl:onDataRange [owl:withRestrictions ([xsd:maxInclusive 100 ]
                                                                                   [xsd:minInclusive 0 ]) ; 
                                                             owl:onDatatype xsd:integer ; 
                                                             a rdfs:Datatype] ; 
                                            a owl:Restriction].
lswpm:removeduplicates a owl:Class;
                       rdfs:label "remove duplicates";
