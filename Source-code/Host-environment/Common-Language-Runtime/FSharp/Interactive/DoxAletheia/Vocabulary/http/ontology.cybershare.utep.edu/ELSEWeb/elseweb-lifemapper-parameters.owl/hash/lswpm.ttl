                       owl:equivalentClass [owl:onProperty lslife:hasDefaultValue ; 
                                            owl:hasValue 1  ; 
                                            a owl:Restriction],
                                           [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty lswmo:boundToValue ; 
                                            owl:onDataRange [owl:withRestrictions ([xsd:minInclusive 0 ]
                                                                                   [xsd:maxInclusive 1 ]) ; 
                                                             owl:onDatatype xsd:integer ; 
                                                             a rdfs:Datatype] ; 
                                            a owl:Restriction],
                                           [owl:onProperty lswmo:hasParameterName ; 
                                            owl:hasValue "removeduplicates" ; 
                                            a owl:Restriction].
lswpm:replicates a owl:Class;
                 rdfs:label "replicates";
