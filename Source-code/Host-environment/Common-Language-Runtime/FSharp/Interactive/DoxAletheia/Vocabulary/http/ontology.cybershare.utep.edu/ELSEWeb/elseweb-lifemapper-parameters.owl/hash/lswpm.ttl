lslife:LifemapperAlgorithm sio:example "ANN";
                           a owl:Class;
                           rdfs:comment "A species distribution modelling algorithm implemented in a service offered by Lifemapper.";
                           rdfs:label "lifemapper algorithm".
lslife:LifemapperParameter sio:comment "An input parameter required to run an algorithm provided by Lifemapper in a web service.";
                           a owl:Class;
                           rdfs:label "lifemapper parameter".
lslife:LifemapperParameters sio:comment "A set of parameters required as an input to a specific modelling algorithm offered as a Web service by Lifemapper.";
                            sio:example "The set of parameters needed by the ANN algorithm.";
                            a owl:Class;
                            rdfs:label "lifemapper parameters".
lslife:hasAlgorithmCode a owl:DatatypeProperty;
                        rdfs:label "has algorithm code".
lslife:hasDefaultValue a owl:DatatypeProperty;
                       rdfs:label "has default value".
lswmo:boundToValue a owl:DatatypeProperty;
                   rdfs:label "bound to value".
lswmo:hasAlgorithmName a owl:DatatypeProperty;
                       rdfs:label "has algorithm name".
lswmo:hasParameterMember a owl:ObjectProperty;
                         rdfs:label "has parameter member".
lswmo:hasParameterName a owl:DatatypeProperty;
                       rdfs:label "has parameter name".
