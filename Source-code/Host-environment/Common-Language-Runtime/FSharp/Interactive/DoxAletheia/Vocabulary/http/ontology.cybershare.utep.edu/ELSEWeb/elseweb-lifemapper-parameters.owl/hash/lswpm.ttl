@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix lswpm: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl#>.
@prefix lslife: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#>.
@prefix lswmo: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix sio: <http://semanticscience.org/resource/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

lswpm:ANN lslife:hasAlgorithmCode "ANN";
          lswmo:hasAlgorithmName "Artificial Neural Network";
          a owl:NamedIndividual,
            lslife:LifemapperAlgorithm.
lswpm:ATT_MAXENT lslife:hasAlgorithmCode "ATT_MAXENT";
                 lswmo:hasAlgorithmName "Maximum Entropy - ATT Implementation";
                 a owl:NamedIndividual,
                   lslife:LifemapperAlgorithm.
lswpm:Artificial-Neural-Network_parameters a owl:Class;
                                           rdfs:label "artificial neuronal network parameters";
                                           rdfs:subClassOf lslife:LifemapperParameters;
                                           owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lswpm:Choice ; 
                                                                                    owl:onProperty lswmo:hasParameterMember ; 
                                                                                    a owl:Restriction]
                                                                                    [owl:someValuesFrom lswpm:Epoch ; 
                                                                                    owl:onProperty lswmo:hasParameterMember ; 
                                                                                    a owl:Restriction]
                                                                                    [owl:someValuesFrom lswpm:HiddenLayerNeurons ; 
                                                                                    owl:onProperty lswmo:hasParameterMember ; 
                                                                                    a owl:Restriction]
                                                                                    [owl:someValuesFrom lswpm:LearningRate ; 
                                                                                    owl:onProperty lswmo:hasParameterMember ; 
                                                                                    a owl:Restriction]
                                                                                    [owl:someValuesFrom lswpm:MinimumError ; 
                                                                                    owl:onProperty lswmo:hasParameterMember ; 
                                                                                    a owl:Restriction]
                                                                                    [owl:someValuesFrom lswpm:Momentum ; 
                                                                                    owl:onProperty lswmo:hasParameterMember ; 
                                                                                    a owl:Restriction]) ; 
                                                                a owl:Class].
lswpm:AutoFeatures a owl:Class;
                   rdfs:label "auto features";
                   rdfs:subClassOf lslife:LifemapperParameter;
                   owl:equivalentClass [owl:onProperty lswmo:hasParameterName ; 
                                        owl:hasValue "AutoFeatures" ; 
                                        a owl:Restriction],
                                       [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty lswmo:boundToValue ; 
                                        owl:onDataRange [owl:withRestrictions ([xsd:minInclusive 0 ]
                                                                               [xsd:maxInclusive 1 ]) ; 
                                                         owl:onDatatype xsd:integer ; 
                                                         a rdfs:Datatype] ; 
                                        a owl:Restriction],
                                       [owl:onProperty lslife:hasDefaultValue ; 
                                        owl:hasValue 1  ; 
                                        a owl:Restriction].
lswpm:BIOCLIM lslife:hasAlgorithmCode "BIOCLIM";
              lswmo:hasAlgorithmName "Bioclim";
              a owl:NamedIndividual,
                lslife:LifemapperAlgorithm.
lswpm:Bioclim_parameters a owl:Class;
                         rdfs:label "bioclim parameters";
                         rdfs:subClassOf lslife:LifemapperParameters;
                         owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lswpm:StandardDeviationCutoff ; 
                                                                  owl:onProperty lswmo:hasParameterMember ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
lswpm:C a owl:Class;
        rdfs:label "c";
        rdfs:subClassOf lslife:LifemapperParameter;
        owl:equivalentClass [owl:onProperty lslife:hasDefaultValue ; 
                             owl:hasValue "1.0"^^xsd:float ; 
                             a owl:Restriction],
                            [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onProperty lswmo:boundToValue ; 
                             owl:onDataRange [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:double]) ; 
                                              owl:onDatatype xsd:double ; 
                                              a rdfs:Datatype] ; 
                             a owl:Restriction],
                            [owl:onProperty lswmo:hasParameterName ; 
                             owl:hasValue "C" ; 
                             a owl:Restriction].
lswpm:CSMBS lslife:hasAlgorithmCode "CSMBS";
            lswmo:hasAlgorithmName "Climate Space Model";
            a owl:NamedIndividual,
              lslife:LifemapperAlgorithm.
lswpm:Choice a owl:Class;
             rdfs:label "choice";
             rdfs:subClassOf lslife:LifemapperParameter;
             owl:equivalentClass [owl:onProperty lswmo:hasParameterName ; 
                                  owl:hasValue "Choice" ; 
                                  a owl:Restriction],
                                 [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty lswmo:boundToValue ; 
                                  owl:onDataRange [owl:withRestrictions ([xsd:minInclusive 0 ]
                                                                         [xsd:maxInclusive 1 ]) ; 
                                                   owl:onDatatype xsd:integer ; 
                                                   a rdfs:Datatype] ; 
                                  a owl:Restriction],
                                 [owl:onProperty lslife:hasDefaultValue ; 
                                  owl:hasValue 1  ; 
                                  a owl:Restriction].
lswpm:Climate-Space-Model_parameters a owl:Class;
                                     rdfs:label "climate space model parameters";
                                     rdfs:subClassOf lslife:LifemapperParameters;
                                     owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lswpm:MinComponents ; 
                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                              a owl:Restriction]
                                                                              [owl:someValuesFrom lswpm:Randomisations ; 
                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                              a owl:Restriction]
                                                                              [owl:someValuesFrom lswpm:StandardDeviations ; 
                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                              a owl:Restriction]
                                                                              [owl:someValuesFrom lswpm:VerboseDebugging ; 
                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                              a owl:Restriction]) ; 
                                                          a owl:Class].
lswpm:Coef0 a owl:Class;
            rdfs:label "coef0";
            rdfs:subClassOf lslife:LifemapperParameter;
            owl:equivalentClass [owl:onProperty lswmo:hasParameterName ; 
                                 owl:hasValue "Coef0" ; 
                                 a owl:Restriction],
                                [owl:onProperty lslife:hasDefaultValue ; 
                                 owl:hasValue "0.0"^^xsd:float ; 
                                 a owl:Restriction].
lswpm:CommissionSampleSize a owl:Class;
                           rdfs:label "comission sample size";
                           rdfs:subClassOf lslife:LifemapperParameter;
                           owl:equivalentClass [owl:onProperty lslife:hasDefaultValue ; 
                                                owl:hasValue 10000  ; 
                                                a owl:Restriction],
                                               [owl:onProperty lswmo:hasParameterName ; 
                                                owl:hasValue "CommissionSampleSize" ; 
                                                a owl:Restriction],
                                               [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                owl:onProperty lswmo:boundToValue ; 
                                                owl:onDataRange [owl:withRestrictions ([xsd:minInclusive 1 ]) ; 
                                                                 owl:onDatatype xsd:integer ; 
                                                                 a rdfs:Datatype] ; 
                                                a owl:Restriction].
lswpm:CommissionThreshold a owl:Class;
                          rdfs:label "comission threshold";
                          rdfs:subClassOf lslife:LifemapperParameter;
                          owl:equivalentClass [owl:onProperty lslife:hasDefaultValue ; 
                                               owl:hasValue "50.0"^^xsd:float ; 
                                               a owl:Restriction],
                                              [owl:onProperty lswmo:hasParameterName ; 
                                               owl:hasValue "CommissionThreshold" ; 
                                               a owl:Restriction],
                                              [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty lswmo:boundToValue ; 
                                               owl:onDataRange [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:double]
                                                                                      [xsd:maxInclusive "100.0"^^xsd:double]) ; 
                                                                owl:onDatatype xsd:double ; 
                                                                a rdfs:Datatype] ; 
                                               a owl:Restriction].
lswpm:ConvergenceLimit a owl:Class;
                       rdfs:label "convergence limit";
                       rdfs:subClassOf lslife:LifemapperParameter;
                       owl:equivalentClass [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty lswmo:boundToValue ; 
                                            owl:onDataRange [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:double]
                                                                                   [xsd:maxInclusive "1.0"^^xsd:double]) ; 
                                                             owl:onDatatype xsd:double ; 
                                                             a rdfs:Datatype] ; 
                                            a owl:Restriction],
                                           [owl:onProperty lswmo:hasParameterName ; 
                                            owl:hasValue "ConvergenceLimit" ; 
                                            a owl:Restriction],
                                           [owl:onProperty lslife:hasDefaultValue ; 
                                            owl:hasValue "0.01"^^xsd:float ; 
                                            a owl:Restriction].
lswpm:DG_GARP lslife:hasAlgorithmCode "DG_GARP";
              lswmo:hasAlgorithmName "GARP - DesktopGARP implementation";
              a owl:NamedIndividual,
                lslife:LifemapperAlgorithm.
lswpm:DG_GARP_BS lslife:hasAlgorithmCode "DG_GARP_BS";
                 lswmo:hasAlgorithmName "GARP with Best Subsets - DesktopGARP implementation";
                 a owl:NamedIndividual,
                   lslife:LifemapperAlgorithm.
lswpm:Degree a owl:Class;
             rdfs:label "degree";
             rdfs:subClassOf lslife:LifemapperParameter;
             owl:equivalentClass [owl:onProperty lslife:hasDefaultValue ; 
                                  owl:hasValue 3  ; 
                                  a owl:Restriction],
                                 [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty lswmo:boundToValue ; 
                                  owl:onDataRange [owl:withRestrictions ([xsd:minInclusive 0 ]) ; 
                                                   owl:onDatatype xsd:integer ; 
                                                   a rdfs:Datatype] ; 
                                  a owl:Restriction],
                                 [owl:onProperty lswmo:hasParameterName ; 
                                  owl:hasValue "Degree" ; 
                                  a owl:Restriction].
lswpm:DistanceType a owl:Class;
                   rdfs:label "distance type";
                   rdfs:subClassOf lslife:LifemapperParameter;
                   owl:equivalentClass [owl:onProperty lslife:hasDefaultValue ; 
                                        owl:hasValue 1  ; 
                                        a owl:Restriction],
                                       [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty lswmo:boundToValue ; 
                                        owl:onDataRange [owl:withRestrictions ([xsd:maxInclusive 4 ]
                                                                               [xsd:minInclusive 1 ]) ; 
                                                         owl:onDatatype xsd:integer ; 
                                                         a rdfs:Datatype] ; 
                                        a owl:Restriction],
                                       [owl:onProperty lswmo:hasParameterName ; 
                                        owl:hasValue "DistanceType" ; 
                                        a owl:Restriction].
lswpm:ENVDIST lslife:hasAlgorithmCode "ENVDIST";
              lswmo:hasAlgorithmName "Environmental Distance";
              a owl:NamedIndividual,
                lslife:LifemapperAlgorithm.
lswpm:Environmental-Distance_parameters a owl:Class;
                                        rdfs:label "environmental distance parameters";
                                        rdfs:subClassOf lslife:LifemapperParameters;
                                        owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lswpm:DistanceType ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:someValuesFrom lswpm:MaxDistance ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:someValuesFrom lswpm:NearestPoints ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]) ; 
                                                             a owl:Class].
lswpm:Epoch a owl:Class;
            rdfs:label "epoch";
            rdfs:subClassOf lslife:LifemapperParameter;
            owl:equivalentClass [owl:onProperty lswmo:hasParameterName ; 
                                 owl:hasValue "Epoch" ; 
                                 a owl:Restriction],
                                [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty lswmo:boundToValue ; 
                                 owl:onDataRange [owl:withRestrictions ([xsd:minInclusive 1 ]) ; 
                                                  owl:onDatatype xsd:integer ; 
                                                  a rdfs:Datatype] ; 
                                 a owl:Restriction],
                                [owl:onProperty lslife:hasDefaultValue ; 
                                 owl:hasValue 5000000  ; 
                                 a owl:Restriction].
lswpm:GARP lslife:hasAlgorithmCode "GARP";
           lswmo:hasAlgorithmName "GARP";
           a owl:NamedIndividual,
             lslife:LifemapperAlgorithm.
lswpm:GARP---DesktopGARP-implementation_parameters a owl:Class;
                                                   rdfs:label "garp desktop garp implementation parameters";
                                                   rdfs:subClassOf lslife:LifemapperParameters;
                                                   owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lswpm:ConvergenceLimit ; 
                                                                                            owl:onProperty lswmo:hasParameterMember ; 
                                                                                            a owl:Restriction]
                                                                                            [owl:someValuesFrom lswpm:MaxGenerations ; 
                                                                                            owl:onProperty lswmo:hasParameterMember ; 
                                                                                            a owl:Restriction]
                                                                                            [owl:someValuesFrom lswpm:PopulationSize ; 
                                                                                            owl:onProperty lswmo:hasParameterMember ; 
                                                                                            a owl:Restriction]
                                                                                            [owl:someValuesFrom lswpm:Resamples ; 
                                                                                            owl:onProperty lswmo:hasParameterMember ; 
                                                                                            a owl:Restriction]) ; 
                                                                        a owl:Class].
lswpm:GARP-with-Best-Subsets---DesktopGARP-implementation_parameters a owl:Class;
                                                                     rdfs:label "garp with best subsets desktop garp implementation parameters";
                                                                     rdfs:subClassOf lslife:LifemapperParameters;
                                                                     owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lswpm:CommissionSampleSize ; 
                                                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                                                              a owl:Restriction]
                                                                                                              [owl:someValuesFrom lswpm:CommissionThreshold ; 
                                                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                                                              a owl:Restriction]
                                                                                                              [owl:someValuesFrom lswpm:ConvergenceLimit ; 
                                                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                                                              a owl:Restriction]
                                                                                                              [owl:someValuesFrom lswpm:HardOmissionThreshold ; 
                                                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                                                              a owl:Restriction]
                                                                                                              [owl:someValuesFrom lswpm:MaxGenerations ; 
                                                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                                                              a owl:Restriction]
                                                                                                              [owl:someValuesFrom lswpm:MaxThreads ; 
                                                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                                                              a owl:Restriction]
                                                                                                              [owl:someValuesFrom lswpm:ModelsUnderOmissionThreshold ; 
                                                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                                                              a owl:Restriction]
                                                                                                              [owl:someValuesFrom lswpm:PopulationSize ; 
                                                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                                                              a owl:Restriction]
                                                                                                              [owl:someValuesFrom lswpm:Resamples ; 
                                                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                                                              a owl:Restriction]
                                                                                                              [owl:someValuesFrom lswpm:TotalRuns ; 
                                                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                                                              a owl:Restriction]
                                                                                                              [owl:someValuesFrom lswpm:TrainingProportion ; 
                                                                                                              owl:onProperty lswmo:hasParameterMember ; 
                                                                                                              a owl:Restriction]) ; 
                                                                                          a owl:Class].
lswpm:GARP-with-Best-Subsets_parameters a owl:Class;
                                        rdfs:label "garp with best subsets parameters";
                                        rdfs:subClassOf lslife:LifemapperParameters;
                                        owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lswpm:CommissionSampleSize ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:someValuesFrom lswpm:CommissionThreshold ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:someValuesFrom lswpm:ConvergenceLimit ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:someValuesFrom lswpm:HardOmissionThreshold ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:someValuesFrom lswpm:MaxGenerations ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:someValuesFrom lswpm:MaxThreads ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:someValuesFrom lswpm:ModelsUnderOmissionThreshold ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:someValuesFrom lswpm:PopulationSize ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:someValuesFrom lswpm:Resamples ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:someValuesFrom lswpm:TotalRuns ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:someValuesFrom lswpm:TrainingProportion ; 
                                                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                                                 a owl:Restriction]) ; 
                                                             a owl:Class].
lswpm:GARP_BS lslife:hasAlgorithmCode "GARP_BS";
              lswmo:hasAlgorithmName "GARP with Best Subsets";
              a owl:NamedIndividual,
                lslife:LifemapperAlgorithm.
lswpm:GARP_parameters a owl:Class;
                      rdfs:label "garp parameters";
                      rdfs:subClassOf lslife:LifemapperParameters;
                      owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lswpm:ConvergenceLimit ; 
                                                               owl:onProperty lswmo:hasParameterMember ; 
                                                               a owl:Restriction]
                                                               [owl:someValuesFrom lswpm:MaxGenerations ; 
                                                               owl:onProperty lswmo:hasParameterMember ; 
                                                               a owl:Restriction]
                                                               [owl:someValuesFrom lswpm:PopulationSize ; 
                                                               owl:onProperty lswmo:hasParameterMember ; 
                                                               a owl:Restriction]
                                                               [owl:someValuesFrom lswpm:Resamples ; 
                                                               owl:onProperty lswmo:hasParameterMember ; 
                                                               a owl:Restriction]) ; 
                                           a owl:Class].
lswpm:Gamma a owl:Class;
            rdfs:label "gamma";
            rdfs:subClassOf lslife:LifemapperParameter;
            owl:equivalentClass [owl:onProperty lslife:hasDefaultValue ; 
                                 owl:hasValue "0.0"^^xsd:float ; 
                                 a owl:Restriction],
                                [owl:onProperty lswmo:hasParameterName ; 
                                 owl:hasValue "Gamma" ; 
                                 a owl:Restriction].
lswpm:HardOmissionThreshold a owl:Class;
                            rdfs:label "hard omission threshold";
                            rdfs:subClassOf lslife:LifemapperParameter;
                            owl:equivalentClass [owl:onProperty lslife:hasDefaultValue ; 
                                                 owl:hasValue "100.0"^^xsd:float ; 
                                                 a owl:Restriction],
                                                [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 owl:onProperty lswmo:boundToValue ; 
                                                 owl:onDataRange [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:double]
                                                                                        [xsd:maxInclusive "100.0"^^xsd:double]) ; 
                                                                  owl:onDatatype xsd:double ; 
                                                                  a rdfs:Datatype] ; 
                                                 a owl:Restriction],
                                                [owl:onProperty lswmo:hasParameterName ; 
                                                 owl:hasValue "HardOmissionThreshold" ; 
                                                 a owl:Restriction].
lswpm:HiddenLayerNeurons a owl:Class;
                         rdfs:label "hidden layer neurons";
                         rdfs:subClassOf lslife:LifemapperParameter;
                         owl:equivalentClass [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty lswmo:boundToValue ; 
                                              owl:onDataRange [owl:withRestrictions ([xsd:minInclusive 1 ]) ; 
                                                               owl:onDatatype xsd:integer ; 
                                                               a rdfs:Datatype] ; 
                                              a owl:Restriction],
                                             [owl:onProperty lswmo:hasParameterName ; 
                                              owl:hasValue "HiddenLayerNeurons" ; 
                                              a owl:Restriction],
                                             [owl:onProperty lslife:hasDefaultValue ; 
                                              owl:hasValue 14  ; 
                                              a owl:Restriction].
lswpm:HingeFeatures a owl:Class;
                    rdfs:label "hinge features";
                    rdfs:subClassOf lslife:LifemapperParameter;
                    owl:equivalentClass [owl:onProperty lswmo:hasParameterName ; 
                                         owl:hasValue "HingeFeatures" ; 
                                         a owl:Restriction],
                                        [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty lswmo:boundToValue ; 
                                         owl:onDataRange [owl:withRestrictions ([xsd:minInclusive 0 ]
                                                                                [xsd:maxInclusive 1 ]) ; 
                                                          owl:onDatatype xsd:integer ; 
                                                          a rdfs:Datatype] ; 
                                         a owl:Restriction],
                                        [owl:onProperty lslife:hasDefaultValue ; 
                                         owl:hasValue 1  ; 
                                         a owl:Restriction].
lswpm:IncludePresencePointsInBackground a owl:Class;
                                        rdfs:label "include presence points in background";
                                        rdfs:subClassOf lslife:LifemapperParameter;
                                        owl:equivalentClass [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty lswmo:boundToValue ; 
                                                             owl:onDataRange [owl:withRestrictions ([xsd:minInclusive 0 ]
                                                                                                    [xsd:maxInclusive 1 ]) ; 
                                                                              owl:onDatatype xsd:integer ; 
                                                                              a rdfs:Datatype] ; 
                                                             a owl:Restriction],
                                                            [owl:onProperty lswmo:hasParameterName ; 
                                                             owl:hasValue "IncludePresencePointsInBackground" ; 
                                                             a owl:Restriction],
                                                            [owl:onProperty lslife:hasDefaultValue ; 
                                                             owl:hasValue 1  ; 
                                                             a owl:Restriction].
lswpm:KernelType a owl:Class;
                 rdfs:label "kernel type";
                 rdfs:subClassOf lslife:LifemapperParameter;
                 owl:equivalentClass [owl:onProperty lswmo:hasParameterName ; 
                                      owl:hasValue "KernelType" ; 
                                      a owl:Restriction],
                                     [owl:onProperty lslife:hasDefaultValue ; 
                                      owl:hasValue 2  ; 
                                      a owl:Restriction],
                                     [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty lswmo:boundToValue ; 
                                      owl:onDataRange [owl:withRestrictions ([xsd:maxInclusive 4 ]
                                                                             [xsd:minInclusive 0 ]) ; 
                                                       owl:onDatatype xsd:integer ; 
                                                       a rdfs:Datatype] ; 
                                      a owl:Restriction].
lswpm:LearningRate a owl:Class;
                   rdfs:label "learning rate";
                   rdfs:subClassOf lslife:LifemapperParameter;
                   owl:equivalentClass [owl:onProperty lslife:hasDefaultValue ; 
                                        owl:hasValue "0.3"^^xsd:float ; 
                                        a owl:Restriction],
                                       [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty lswmo:boundToValue ; 
                                        owl:onDataRange [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:double]
                                                                               [xsd:maxInclusive "1.0"^^xsd:double]) ; 
                                                         owl:onDatatype xsd:double ; 
                                                         a rdfs:Datatype] ; 
                                        a owl:Restriction],
                                       [owl:onProperty lswmo:hasParameterName ; 
                                        owl:hasValue "LearningRate" ; 
                                        a owl:Restriction].
lswpm:MaxDistance a owl:Class;
                  rdfs:label "max distance";
                  rdfs:subClassOf lslife:LifemapperParameter;
                  owl:equivalentClass [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty lswmo:boundToValue ; 
                                       owl:onDataRange [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:double]
                                                                              [xsd:maxInclusive "1.0"^^xsd:double]) ; 
                                                        owl:onDatatype xsd:double ; 
                                                        a rdfs:Datatype] ; 
