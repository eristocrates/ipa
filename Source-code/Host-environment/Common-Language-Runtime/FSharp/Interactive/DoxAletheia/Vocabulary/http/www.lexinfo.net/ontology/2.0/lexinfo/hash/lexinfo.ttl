@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

ccrel:license a owl:AnnotationProperty.
lemon:Argument a owl:Class;
               rdfs:label "Аргумент"@ru.
lemon:Component rdfs:label "Компонента"@ru.
lemon:Form rdfs:label "Форма"@ru.
lemon:Frame a owl:Class;
            rdfs:label "Рамка"@ru.
lemon:LexicalCondition rdfs:label "Лексическое условие"@ru.
lemon:LexicalContext rdfs:label "Лексический контекст"@ru.
lemon:LexicalEntry rdfs:label "Лексическая единица"@ru.
lemon:Lexicon rdfs:label "Лексикон"@ru.
lemon:MorphPattern rdfs:label "Морфологический шаблон"@ru.
lemon:MorphTransform rdfs:label "Морфологическое преобразование"@ru.
lemon:Node rdfs:label "Узел"@ru.
lemon:NodeConstituent rdfs:label "Составляющая"@ru.
lemon:Part a owl:Class;
           rdfs:label "Часть слова"@ru.
lemon:Phrase a owl:Class;
             rdfs:label "Фраза"@ru.
lemon:PropertyValue a owl:Class;
                    rdfs:label "Свойство"@ru.
lemon:Prototype rdfs:label "Прототип"@ru.
lemon:RaisableArgument a owl:Class;
                       rdfs:subClassOf lemon:Argument.
lemon:SenseCondition rdfs:label "Условие"@ru.
lemon:SenseContext a owl:Class;
                   rdfs:label "Контекст"@ru.
lemon:SenseDefinition rdfs:label "Определение"@ru.
lemon:SynRoleMarker rdfs:label "Маркер синтаксической роли"@ru.
lemon:UsageExample rdfs:label "Пример использования"@ru.
lemon:Word a owl:Class;
           rdfs:label "Слово"@ru.
lemon:broader a owl:ObjectProperty.
lemon:context a owl:ObjectProperty.
lemon:definition a owl:ObjectProperty.
lemon:equivalent a owl:ObjectProperty.
lemon:formVariant a owl:ObjectProperty.
lemon:generates rdfs:label "Порождает"@ru.
lemon:incompatible a owl:ObjectProperty.
lemon:lexicalVariant a owl:ObjectProperty.
lemon:marker a owl:ObjectProperty;
             rdfs:label "маркер"@ru.
lemon:narrower a owl:ObjectProperty.
lemon:optional a owl:DatatypeProperty.
lemon:pattern rdfs:label "Шаблон"@ru.
lemon:property a owl:ObjectProperty.
lemon:representation a owl:DatatypeProperty.
lemon:senseRelation a owl:ObjectProperty.
lemon:separator dcr:datcat isocat:DC-1863;
                a owl:DatatypeProperty;
                rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>.
lemon:synArg a owl:ObjectProperty.
lemon:synBehavior a owl:ObjectProperty.
<http://purl.org/dc/elements/1.1/#creator> a owl:AnnotationProperty.
dcterms:contributor a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:description a owl:AnnotationProperty.
dcterms:issued a owl:AnnotationProperty.
dcterms:modified a owl:AnnotationProperty.
dcterms:rights a owl:AnnotationProperty.
dcterms:title a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
voaf:Vocabulary a owl:Class.
dcr:datcat a owl:AnnotationProperty.
<http://www.lexinfo.net/ontology/2.0/lexinfo> ccrel:license <https://creativecommons.org/licenses/by/4.0/>;
                                              dcterms:contributor <http://www.cimiano.de/philipp>,
                                                                  <http://john.mccr.ae/>,
                                                                  <http://www.paulbuitelaar.net/>;
                                              dcterms:creator <http://john.mccr.ae/>;
                                              dcterms:description "Онтология типов, значений и свойств, используемых совместно с онтологией lemon, частично является производной от ISOcat."@ru,
                                                                  "An ontology of types, values and properties to be used with the lemon model, partially derived from ISOcat."@en;
                                              dcterms:issued "2010-11-22"^^xsd:date;
                                              dcterms:modified "2016-07-13"^^xsd:date;
                                              dcterms:publisher <http://john.mccr.ae/>;
                                              dcterms:rights "Copyright 2010 Monnet Project"@en,
                                                             <https://creativecommons.org/licenses/by/4.0/>;
                                              dcterms:title "LexInfo"@en;
                                              vann:preferredNamespacePrefix "lexinfo";
                                              vann:preferredNamespaceUri "http://www.lexinfo.net/ontology/2.0/lexinfo#"^^xsd:anyURI;
                                              a owl:Ontology,
                                                voaf:Vocabulary,
                                                owl:NamedIndividual;
                                              rdfs:comment "An ontology of types, values and properties to be used with the lemon model, partially derived from ISOcat."@en;
                                              rdfs:label "LexInfo"@en;
                                              owl:imports <http://lemon-model.net/lemon>;
                                              owl:versionInfo "2.0"@en.
lexinfo:AbbreviatedForm a owl:Class;
                        rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                        rdfs:label "Сокращенная форма"@ru;
                        rdfs:subClassOf lexinfo:TermType.
lexinfo:AccusativePostPositiveArgument a owl:Class;
                                       rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                       rdfs:subClassOf lexinfo:PostPositiveArgument;
                                       owl:equivalentClass [owl:intersectionOf (lexinfo:PostPositiveArgument
                                                                                [owl:hasValue lexinfo:accusativeCase ; 
                                                                                owl:onProperty lemon:marker ; 
                                                                                a owl:Restriction]) ; 
                                                            a owl:Class].
lexinfo:AdjectivalComplementFrame a owl:Class;
                                  rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                  rdfs:subClassOf lexinfo:VerbFrame;
                                  owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                           [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onProperty lexinfo:predicativeAdjective ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class].
lexinfo:Adjective a owl:Class;
                  rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                  rdfs:label "Прилагательное"@ru;
                  rdfs:subClassOf [owl:allValuesFrom lexinfo:AdjectiveFrame ; 
                                   owl:onProperty lemon:synBehavior ; 
                                   a owl:Restriction],
                                  lemon:Word;
                  owl:equivalentClass [owl:someValuesFrom lexinfo:AdjectivePOS ; 
                                       owl:onProperty lexinfo:partOfSpeech ; 
                                       a owl:Restriction].
lexinfo:AdjectiveAccusativePostPositiveFrame lexinfo:example "wird wurden unseren irrtum GEWAHR"@de;
                                             a owl:Class;
                                             rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                             rdfs:subClassOf lexinfo:AdjectivePostPositiveFrame;
                                             owl:equivalentClass [owl:intersectionOf (lexinfo:AdjectivePostPositiveFrame
                                                                                      [owl:someValuesFrom lexinfo:AccusativePostPositiveArgument ; 
                                                                                      owl:onProperty lexinfo:postPositiveArg ; 
                                                                                      a owl:Restriction]) ; 
                                                                  a owl:Class].
lexinfo:AdjectiveAttributiveFrame lexinfo:example "the RED ball"@en;
                                  a owl:Class;
                                  rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                  rdfs:subClassOf lexinfo:AdjectiveFrame;
                                  owl:equivalentClass [owl:intersectionOf (lexinfo:AdjectiveFrame
                                                                           [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onProperty lexinfo:attributiveArg ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class].
lexinfo:AdjectiveComparativeFrame lexinfo:example "new york is BIGGER THAN berlin"@en;
                                  a owl:Class;
                                  rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                  rdfs:subClassOf lexinfo:AdjectiveFrame;
                                  owl:equivalentClass [owl:intersectionOf (lexinfo:AdjectiveFrame
                                                                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onProperty lexinfo:comparativeAdjunct ; 
                                                                           a owl:Restriction]
                                                                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onProperty lexinfo:copulativeSubject ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class].
lexinfo:AdjectiveDativePostPositiveFrame lexinfo:example "er ist seinem bruder ÄHNLICH"@de;
                                         a owl:Class;
                                         rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                         rdfs:subClassOf lexinfo:AdjectivePostPositiveFrame;
                                         owl:equivalentClass [owl:intersectionOf (lexinfo:AdjectivePostPositiveFrame
                                                                                  [owl:someValuesFrom lexinfo:DativePostPositiveArgument ; 
                                                                                  owl:onProperty lexinfo:postPositiveArg ; 
                                                                                  a owl:Restriction]) ; 
                                                              a owl:Class].
lexinfo:AdjectiveFrame a owl:Class;
                       rdfs:subClassOf lemon:Frame.
lexinfo:AdjectiveGenitivePostPositiveFrame lexinfo:example "er ist des hochverrats SCHULDIG"@de;
                                           a owl:Class;
                                           rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                           rdfs:subClassOf lexinfo:AdjectivePostPositiveFrame;
                                           owl:equivalentClass [owl:intersectionOf (lexinfo:AdjectivePostPositiveFrame
                                                                                    [owl:someValuesFrom lexinfo:GenitivePostPositiveArgument ; 
                                                                                    owl:onProperty lexinfo:postPositiveArg ; 
                                                                                    a owl:Restriction]) ; 
                                                                a owl:Class].
lexinfo:AdjectiveImpersonalFrame lexinfo:example "es ist mir HEISS"@de;
                                 a owl:Class;
                                 rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                 rdfs:subClassOf lexinfo:AdjectiveFrame;
                                 owl:equivalentClass [owl:intersectionOf (lexinfo:AdjectiveFrame
                                                                          [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                          owl:onProperty lexinfo:object ; 
                                                                          a owl:Restriction]
                                                                          [owl:cardinality "0"^^xsd:nonNegativeInteger ; 
                                                                          owl:onProperty lexinfo:copulativeSubject ; 
                                                                          a owl:Restriction]) ; 
                                                      a owl:Class].
lexinfo:AdjectivePOS a owl:Class;
                     rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                     rdfs:subClassOf lexinfo:PartOfSpeech.
lexinfo:AdjectivePPFrame lexinfo:example "he is RELATED TO her"@en;
                         a owl:Class;
                         rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                         rdfs:subClassOf lexinfo:AdjectiveFrame;
                         owl:equivalentClass [owl:intersectionOf (lexinfo:AdjectivePredicativeFrame
                                                                  lexinfo:PrepositionalFrame) ; 
                                              a owl:Class].
lexinfo:AdjectivePhrase a owl:Class;
                        rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                        rdfs:subClassOf lemon:Phrase;
                        owl:equivalentClass [owl:intersectionOf (lemon:Phrase
                                                                 [owl:someValuesFrom lexinfo:Adjective ; 
                                                                 owl:onProperty lexinfo:head ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
lexinfo:AdjectivePostPositiveFrame lexinfo:example "that is something INTERESTING"@en;
                                   a owl:Class;
                                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                   rdfs:subClassOf lexinfo:AdjectiveFrame;
                                   owl:equivalentClass [owl:intersectionOf (lexinfo:AdjectiveFrame
                                                                            [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                            owl:onProperty lexinfo:copulativeArg ; 
                                                                            a owl:Restriction]
                                                                            [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                            owl:onProperty lexinfo:postPositiveArg ; 
                                                                            a owl:Restriction]) ; 
                                                        a owl:Class].
lexinfo:AdjectivePredicateFrame a owl:Class;
                                rdfs:comment "Note this frame should be used when both attributive and predicative use of the adjective is allowed"@en;
                                rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                rdfs:subClassOf lexinfo:AdjectiveFrame;
                                owl:equivalentClass [owl:intersectionOf (lexinfo:AdjectiveAttributiveFrame
                                                                         lexinfo:AdjectivePredicativeFrame) ; 
                                                     a owl:Class].
lexinfo:AdjectivePredicativeFrame lexinfo:example "he is HAPPY"@en;
                                  a owl:Class;
                                  rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                  rdfs:subClassOf lexinfo:AdjectiveFrame;
                                  owl:equivalentClass [owl:intersectionOf (lexinfo:AdjectiveFrame
                                                                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onProperty lexinfo:copulativeSubject ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class].
lexinfo:AdjectiveScaleFrame lexinfo:example "Everest is 8,848m HIGH"@en;
                            a owl:Class;
                            rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                            rdfs:subClassOf lexinfo:AdjectiveFrame;
                            owl:equivalentClass [owl:intersectionOf ([owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     owl:onProperty lexinfo:adverbialComplement ; 
                                                                     a owl:Restriction]
                                                                     [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     owl:onProperty lexinfo:copulativeSubject ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class].
lexinfo:AdjectiveSuperlativeFrame lexinfo:example "tokyo is the BIGGEST of all metropoles"@en;
                                  a owl:Class;
                                  rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                  rdfs:subClassOf lexinfo:AdjectiveFrame;
                                  owl:equivalentClass [owl:intersectionOf (lexinfo:AdjectiveFrame
                                                                           [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onProperty lexinfo:superlativeAdjunct ; 
                                                                           a owl:Restriction]
                                                                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onProperty lexinfo:copulativeSubject ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class].
lexinfo:Adjunct a owl:Class;
                rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                rdfs:subClassOf [owl:hasValue true ; 
                                 owl:onProperty lemon:optional ; 
                                 a owl:Restriction],
                                lemon:Argument.
lexinfo:Adposition a owl:Class;
                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                   rdfs:label "Прелог или послелог"@ru;
                   rdfs:subClassOf lemon:Word;
                   owl:equivalentClass [owl:someValuesFrom lexinfo:AdpositionPOS ; 
                                        owl:onProperty lexinfo:partOfSpeech ; 
                                        a owl:Restriction].
lexinfo:AdpositionPOS a owl:Class;
                      rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                      rdfs:subClassOf lexinfo:PartOfSpeech.
lexinfo:AdpositionalObject a owl:Class;
                           rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                           rdfs:subClassOf [owl:someValuesFrom lexinfo:Adposition ; 
                                            owl:onProperty lemon:marker ; 
                                            a owl:Restriction],
                                           lexinfo:Object;
                           owl:equivalentClass [owl:intersectionOf (lexinfo:Object
                                                                    [owl:someValuesFrom lexinfo:Adposition ; 
                                                                    owl:onProperty lemon:marker ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class].
lexinfo:Adverb a owl:Class;
               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
               rdfs:label "Наречие"@ru;
               rdfs:subClassOf lemon:Word;
               owl:equivalentClass [owl:someValuesFrom lexinfo:AdverbPOS ; 
                                    owl:onProperty lexinfo:partOfSpeech ; 
                                    a owl:Restriction].
lexinfo:AdverbPOS a owl:Class;
                  rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                  rdfs:subClassOf lexinfo:PartOfSpeech.
lexinfo:AdverbialComplementFrame a owl:Class;
                                 rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                 rdfs:subClassOf lexinfo:VerbFrame;
                                 owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                          [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                          owl:onProperty lexinfo:predicativeAdverb ; 
                                                                          a owl:Restriction]) ; 
                                                      a owl:Class].
lexinfo:Affix a owl:Class;
              rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
              rdfs:label "Аффикс"@ru;
              rdfs:subClassOf lemon:Part;
              owl:equivalentClass [owl:hasValue lexinfo:affix ; 
                                   owl:onProperty lexinfo:termElement ; 
                                   a owl:Restriction].
lexinfo:Animacy a owl:Class;
                rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                rdfs:label "Одушевленность"@ru;
                rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:ArbitraryControl a owl:Class;
                         rdfs:comment "Indicates either the subject or object of the main clause may be the omitted argument of the subclause"@en;
                         rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                         rdfs:subClassOf lexinfo:Control.
lexinfo:Article a owl:Class;
                rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                rdfs:label "Артикль"@ru;
                rdfs:subClassOf lexinfo:Determiner;
                owl:equivalentClass [owl:someValuesFrom lexinfo:ArticlePOS ; 
                                     owl:onProperty lexinfo:partOfSpeech ; 
                                     a owl:Restriction].
lexinfo:ArticlePOS a owl:Class;
                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                   rdfs:subClassOf lexinfo:DeterminerPOS.
lexinfo:Aspect a owl:Class;
               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
               rdfs:label "Вид"@ru;
               rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:AttributiveArgument a owl:Class;
                            rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                            rdfs:subClassOf lemon:Argument.
lexinfo:CJK_compound <http://purl.org/dc/elements/1.1/#creator> "Wright, Sue Ellen";
                     dcr:datcat isocat:DC-356;
                     a lexinfo:TermType,
                       owl:NamedIndividual,
                       owl:Thing;
                     rdfs:comment "A lexical unit in a CJKV language that is represented by at least two CJKV characters.";
                     rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                     rdfs:label "словосочетание в CJKV"@ru,
                                "compound(cjkv)";
                     owl:versionInfo "1:0".
lexinfo:Case a owl:Class;
             rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
             rdfs:label "Падеж"@ru;
             rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:ClausalArgument a owl:Class;
                        rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                        rdfs:subClassOf lemon:Argument.
lexinfo:Cliticness a owl:Class;
                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                   rdfs:label "Клитика"@ru;
                   rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:CommonNoun a owl:Class;
                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                   rdfs:label "Имя нарицательное"@ru;
                   rdfs:subClassOf lexinfo:Noun;
                   owl:equivalentClass [owl:hasValue lexinfo:commonNoun ; 
                                        owl:onProperty lexinfo:partOfSpeech ; 
                                        a owl:Restriction].
lexinfo:ComparativeAdjunct a owl:Class;
                           rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                           rdfs:subClassOf lexinfo:Adjunct.
lexinfo:Complement a owl:Class;
                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                   rdfs:subClassOf lemon:Argument.
lexinfo:Conjunction a owl:Class;
                    rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                    rdfs:label "Союз"@ru;
                    rdfs:subClassOf lemon:Word;
                    owl:equivalentClass [owl:someValuesFrom lexinfo:ConjunctionPOS ; 
                                         owl:onProperty lexinfo:partOfSpeech ; 
                                         a owl:Restriction].
lexinfo:ConjunctionPOS a owl:Class;
                       rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                       rdfs:subClassOf lexinfo:PartOfSpeech.
lexinfo:Control a owl:Class;
                rdfs:comment "Control indicates how a an argument from a main clause will be utilized in a subclause. This class includes both control structures and raising structures"@en;
                rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                rdfs:subClassOf lemon:Frame.
lexinfo:Dating a owl:Class;
               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
               rdfs:label "Датирование"@ru;
               rdfs:subClassOf lemon:PropertyValue.
lexinfo:DativePostPositiveArgument a owl:Class;
                                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                   rdfs:subClassOf lexinfo:PostPositiveArgument;
                                   owl:equivalentClass [owl:intersectionOf (lexinfo:PostPositiveArgument
                                                                            [owl:hasValue lexinfo:dativeCase ; 
                                                                            owl:onProperty lemon:marker ; 
                                                                            a owl:Restriction]) ; 
                                                        a owl:Class].
lexinfo:DativeTransitiveFrame lexinfo:example "ich DANKE dir"@de;
                              a owl:Class;
                              rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                              rdfs:subClassOf lexinfo:VerbFrame;
                              owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                       [owl:cardinality "0"^^xsd:nonNegativeInteger ; 
                                                                       owl:onProperty lexinfo:directObject ; 
                                                                       a owl:Restriction]
                                                                       [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                       owl:onProperty lexinfo:indirectObject ; 
                                                                       a owl:Restriction]
                                                                       [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                       owl:onProperty lexinfo:subject ; 
                                                                       a owl:Restriction]) ; 
                                                   a owl:Class].
lexinfo:DeclarativeClause a owl:Class;
                          rdfs:comment """A clause beginning with the declarative conjunction (\"that\" in English)"""@en;
                          rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                          rdfs:subClassOf lexinfo:ClausalArgument.
lexinfo:DeclarativeFrame a owl:Class;
                         rdfs:comment """Declarative frames take a clause as an argument, this argument is marker with the declarative conjunction (\"that\" in English)"""@en;
                         rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                         rdfs:subClassOf lexinfo:VerbFrame;
                         owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                  [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                  owl:onProperty lexinfo:declarativeClause ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
lexinfo:Definiteness a owl:Class;
                     rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                     rdfs:label "Определенность"@ru;
                     rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:Degree a owl:Class;
               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
               rdfs:label "Степень"@ru;
               rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:Determiner a owl:Class;
                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                   rdfs:label "Детерминанта"@ru;
                   rdfs:subClassOf lemon:Word;
                   owl:equivalentClass [owl:someValuesFrom lexinfo:DeterminerPOS ; 
                                        owl:onProperty lexinfo:partOfSpeech ; 
                                        a owl:Restriction].
lexinfo:DeterminerPOS a owl:Class;
                      rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                      rdfs:subClassOf lexinfo:PartOfSpeech.
lexinfo:DirectObject a owl:Class;
                     rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                     rdfs:label "Прямое дополнение"@ru;
                     rdfs:subClassOf lexinfo:Object.
lexinfo:DitransitiveDoubleAccusativeFrame lexinfo:example "das KOSTET ihn sein leben"@de;
                                          a owl:Class;
                                          rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                          rdfs:subClassOf lexinfo:VerbFrame;
                                          owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                                   [owl:cardinality "2"^^xsd:nonNegativeInteger ; 
                                                                                   owl:onProperty lexinfo:directObject ; 
                                                                                   a owl:Restriction]
                                                                                   [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                                   owl:onProperty lexinfo:subject ; 
                                                                                   a owl:Restriction]) ; 
                                                               a owl:Class].
lexinfo:DitransitiveFrame lexinfo:example "i GAVE him it"@en,
                                          "mein vater SCHREIBT ihr einen brief"@de;
                          a owl:Class;
                          rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                          rdfs:subClassOf lexinfo:VerbFrame;
                          owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                   [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                   owl:onProperty lexinfo:directObject ; 
                                                                   a owl:Restriction]
                                                                   [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                   owl:onProperty lexinfo:indirectObject ; 
                                                                   a owl:Restriction]
                                                                   [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                   owl:onProperty lexinfo:subject ; 
                                                                   a owl:Restriction]) ; 
                                               a owl:Class].
lexinfo:DitransitiveFrame_For lexinfo:example """she BOUGHT him it
she BOUGHT it FOR him"""@en;
                              lexinfo:languageSpecific "en";
                              a owl:Class;
                              rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                              rdfs:subClassOf lexinfo:DitransitiveFrame.
lexinfo:DitransitiveFrame_To lexinfo:example """he GAVE his mother a present
he GAVE a present TO his mother"""@en;
                             lexinfo:languageSpecific "en";
                             a owl:Class;
                             rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                             rdfs:subClassOf lexinfo:DitransitiveFrame.
lexinfo:Finiteness a owl:Class;
                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                   rdfs:label "Конечность"@ru;
                   rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:Frequency a owl:Class;
                  rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                  rdfs:label "Частота использования"@ru;
                  rdfs:subClassOf lemon:SenseContext.
lexinfo:FusedPreposition a owl:Class;
                         rdfs:comment """A word that is a fusion of a preposition and some other word... examples include the German words \"zum\" and \"daran\""""@en;
                         rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                         rdfs:label "Слитный предлог"@ru;
                         rdfs:subClassOf lemon:Word;
                         owl:equivalentClass [owl:someValuesFrom lexinfo:FusedPrepositionPOS ; 
                                              owl:onProperty lexinfo:partOfSpeech ; 
                                              a owl:Restriction].
lexinfo:FusedPrepositionPOS a owl:Class;
                            rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                            rdfs:subClassOf lexinfo:PartOfSpeech.
lexinfo:Gender a owl:Class;
               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
               rdfs:label "Род"@ru;
               rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:GenitiveDitransitiveFrame lexinfo:example "man KLAGTE ihn des diebstahls AN"@de;
                                  a owl:Class;
                                  rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                  rdfs:subClassOf lexinfo:VerbFrame;
                                  owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onProperty lexinfo:directObject ; 
                                                                           a owl:Restriction]
                                                                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onProperty lexinfo:genitiveObject ; 
                                                                           a owl:Restriction]
                                                                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onProperty lexinfo:subject ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class].
lexinfo:GenitiveObject a owl:Class;
                       rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                       rdfs:label "Дополнение в родительном падеже"@ru;
                       rdfs:subClassOf lexinfo:Object;
                       owl:equivalentClass [owl:hasValue lexinfo:genitiveCase ; 
                                            owl:onProperty lemon:marker ; 
                                            a owl:Restriction].
lexinfo:GenitivePostPositiveArgument a owl:Class;
                                     rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                     rdfs:subClassOf lexinfo:PostPositiveArgument;
                                     owl:equivalentClass [owl:intersectionOf (lexinfo:PostPositiveArgument
                                                                              [owl:hasValue lexinfo:genitiveCase ; 
                                                                              owl:onProperty lemon:marker ; 
                                                                              a owl:Restriction]) ; 
                                                          a owl:Class].
lexinfo:GenitiveTransitiveFrame lexinfo:example "wir BEDENKEN jenes mannes"@de;
                                a owl:Class;
                                rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                rdfs:subClassOf lexinfo:VerbFrame;
                                owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                         [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
