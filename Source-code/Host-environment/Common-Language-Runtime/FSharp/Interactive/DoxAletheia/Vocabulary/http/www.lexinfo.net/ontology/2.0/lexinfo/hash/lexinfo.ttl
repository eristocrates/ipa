                                                                   owl:onProperty lexinfo:subject ; 
                                                                   a owl:Restriction]) ; 
                                               a owl:Class].
lexinfo:IntransitiveInfinitiveACFrame lexinfo:example "I HELPED [to save the child]"@en;
