                                                                     [owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     owl:onClass lexinfo:PossessiveAdjunct ; 
                                                                     owl:onProperty lexinfo:possessiveAdjunct ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class].
lexinfo:NounPredicateFrame lexinfo:example "he is a MAN"@en;
                           a owl:Class;
                           rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                           rdfs:subClassOf lexinfo:NounFrame;
                           owl:equivalentClass [owl:intersectionOf (lexinfo:NounFrame
                                                                    [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                    owl:onProperty lexinfo:copulativeArg ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class].
lexinfo:Number a owl:Class;
               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
               rdfs:label "Число"@ru;
               rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:Numeral a owl:Class;
                rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                rdfs:label "Имя числительное"@ru;
                rdfs:subClassOf lemon:Word;
                owl:equivalentClass [owl:someValuesFrom lexinfo:NumeralPOS ; 
                                     owl:onProperty lexinfo:partOfSpeech ; 
                                     a owl:Restriction].
lexinfo:NumeralPOS a owl:Class;
                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                   rdfs:subClassOf lexinfo:PartOfSpeech.
lexinfo:Object a owl:Class;
               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
               rdfs:label "Объект"@ru,
                          "Дополнение"@ru;
               rdfs:subClassOf [owl:hasValue false ; 
                                owl:onProperty lemon:optional ; 
                                a owl:Restriction],
                               lemon:Argument.
lexinfo:ObjectComplement a owl:Class;
                         rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                         rdfs:subClassOf lexinfo:Complement.
lexinfo:ObjectControl a owl:Class;
                      rdfs:comment "Indicates the object of the main clause is also the (omitted) object of the subclause"@en;
                      rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                      rdfs:subClassOf lexinfo:Control.
lexinfo:PPFrame a owl:Class;
                rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                rdfs:subClassOf lexinfo:VerbFrame;
                owl:equivalentClass [owl:intersectionOf (lexinfo:PrepositionalFrame
                                                         lexinfo:VerbFrame) ; 
                                     a owl:Class].
lexinfo:PartOfSpeech a owl:Class;
                     rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                     rdfs:label "Часть речи"@ru;
                     rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:Particle a owl:Class;
                 rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                 rdfs:label "Частица"@ru;
                 rdfs:subClassOf lemon:Word;
                 owl:equivalentClass [owl:someValuesFrom lexinfo:ParticlePOS ; 
                                      owl:onProperty lexinfo:partOfSpeech ; 
                                      a owl:Restriction].
lexinfo:ParticlePOS a owl:Class;
                    rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                    rdfs:subClassOf lexinfo:PartOfSpeech.
lexinfo:Person a owl:Class;
               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
               rdfs:label "Лицо"@ru;
               rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:PossessiveAdjunct a owl:Class;
                          rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                          rdfs:subClassOf lexinfo:Adjunct.
lexinfo:PostPositiveArgument a owl:Class;
                             rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                             rdfs:subClassOf lemon:Argument.
lexinfo:Postposition a owl:Class;
                     rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                     rdfs:label "Послелог"@ru;
                     rdfs:subClassOf lexinfo:Adposition;
                     owl:equivalentClass [owl:hasValue lexinfo:postposition ; 
                                          owl:onProperty lexinfo:partOfSpeech ; 
                                          a owl:Restriction].
lexinfo:PredicativeAdjective a owl:Class;
                             rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                             rdfs:subClassOf lexinfo:Complement.
lexinfo:PredicativeAdverb a owl:Class;
                          rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                          rdfs:subClassOf lexinfo:Complement.
lexinfo:PredicativeNominative a owl:Class;
                              rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                              rdfs:subClassOf lexinfo:Complement.
lexinfo:Prefix a owl:Class;
               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
               rdfs:label "Приставка"@ru;
               rdfs:subClassOf lexinfo:Affix;
               owl:equivalentClass [owl:hasValue lexinfo:prefix ; 
                                    owl:onProperty lexinfo:termElement ; 
                                    a owl:Restriction].
lexinfo:Preposition a owl:Class;
                    rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                    rdfs:label "Предлог"@ru;
                    rdfs:subClassOf lexinfo:Adposition;
                    owl:equivalentClass [owl:hasValue lexinfo:preposition ; 
                                         owl:onProperty lexinfo:partOfSpeech ; 
                                         a owl:Restriction].
lexinfo:PrepositionFrame a owl:Class;
                         rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                         rdfs:subClassOf lemon:Frame.
lexinfo:PrepositionPhrase a owl:Class;
                          rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                          rdfs:subClassOf lemon:Phrase;
                          owl:equivalentClass [owl:intersectionOf (lemon:Phrase
                                                                   [owl:someValuesFrom lexinfo:Preposition ; 
                                                                   owl:onProperty lexinfo:head ; 
                                                                   a owl:Restriction]) ; 
                                               a owl:Class].
lexinfo:PrepositionalAdjunct a owl:Class;
                             rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                             rdfs:subClassOf [owl:someValuesFrom lexinfo:Preposition ; 
                                              owl:onProperty lemon:marker ; 
                                              a owl:Restriction],
                                             lexinfo:Adjunct.
lexinfo:PrepositionalFrame a owl:Class;
                           rdfs:comment "Abstract frame for words that take a prepositional phrase as an argument"@en;
                           rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                           rdfs:subClassOf lemon:Frame;
                           owl:equivalentClass [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                owl:onProperty lexinfo:prepositionalAdjunct ; 
                                                a owl:Restriction].
lexinfo:PrepositionalInterrogativeFrame a owl:Class;
                                        rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                        rdfs:subClassOf lexinfo:VerbFrame;
                                        owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                                 [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                                 owl:onProperty lexinfo:prepositionalInterrogativeClause ; 
                                                                                 a owl:Restriction]) ; 
                                                             a owl:Class].
lexinfo:PrepositionalObject a owl:Class;
                            rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                            rdfs:label "Предложное дополнение"@ru;
                            rdfs:subClassOf lexinfo:AdpositionalObject;
                            owl:equivalentClass [owl:intersectionOf (lexinfo:AdpositionalObject
                                                                     [owl:someValuesFrom lexinfo:Preposition ; 
                                                                     owl:onProperty lemon:marker ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class].
lexinfo:PrepositionalPhraseFrame lexinfo:example "he is IN london"@en;
                                 a owl:Class;
                                 rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                 rdfs:subClassOf lexinfo:PrepositionFrame;
                                 owl:equivalentClass [owl:intersectionOf (lexinfo:PrepositionFrame
                                                                          [owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                          owl:onClass lexinfo:PrepositionalAdjunct ; 
                                                                          owl:onProperty lexinfo:complement ; 
                                                                          a owl:Restriction]
                                                                          [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                          owl:onProperty lexinfo:copulativeSubject ; 
                                                                          a owl:Restriction]) ; 
                                                      a owl:Class].
lexinfo:Pronoun a owl:Class;
                rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                rdfs:label "Местоимение"@ru;
                rdfs:subClassOf lemon:Word;
                owl:equivalentClass [owl:someValuesFrom lexinfo:PronounPOS ; 
                                     owl:onProperty lexinfo:partOfSpeech ; 
                                     a owl:Restriction].
lexinfo:PronounPOS a owl:Class;
                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                   rdfs:subClassOf lexinfo:PartOfSpeech.
lexinfo:ProperNoun a owl:Class;
                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                   rdfs:label "Имя собственное"@ru;
                   rdfs:subClassOf lexinfo:Noun;
                   owl:equivalentClass [owl:hasValue lexinfo:properNoun ; 
                                        owl:onProperty lexinfo:partOfSpeech ; 
                                        a owl:Restriction].
lexinfo:RaisableSubject a owl:Class;
                        rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                        rdfs:subClassOf lexinfo:Subject;
                        owl:equivalentClass [owl:intersectionOf (lemon:RaisableArgument
                                                                 lexinfo:Subject) ; 
                                             a owl:Class].
lexinfo:RaisingSubject a owl:Class;
                       rdfs:comment "Indicates the syntactic subject of the main clause is in fact the subject of the subclause. The main clause should then be interpreted as being impersonal."@en;
                       rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                       rdfs:subClassOf lexinfo:Control;
                       owl:equivalentClass [owl:someValuesFrom lexinfo:RaisableSubject ; 
                                            owl:onProperty lexinfo:subject ; 
                                            a owl:Restriction].
lexinfo:ReciprocalFrame lexinfo:example "mary and john MET"@en;
                        a owl:Class;
                        rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                        rdfs:subClassOf lexinfo:VerbFrame;
                        owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                 [owl:minCardinality "2"^^xsd:nonNegativeInteger ; 
                                                                 owl:onProperty lexinfo:subject ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
lexinfo:ReferentType a owl:Class;
                     rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                     rdfs:label "Принадлежность"@ru;
                     rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:ReflexiveDativeTransitiveFrame lexinfo:example "ich TUE mir WEH"@de;
                                       a owl:Class;
                                       rdfs:comment "ist diese frame echt?"@de;
                                       rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                       rdfs:subClassOf lexinfo:ReflexiveFrame;
                                       owl:equivalentClass [owl:intersectionOf (lexinfo:DativeTransitiveFrame
                                                                                lexinfo:ReflexiveFrame) ; 
                                                            a owl:Class].
lexinfo:ReflexiveDitransitiveFrame lexinfo:example "das habe ich mir EINGEBILDET"@de;
                                   a owl:Class;
                                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                   rdfs:subClassOf lexinfo:ReflexiveFrame;
                                   owl:equivalentClass [owl:intersectionOf (lexinfo:DitransitiveFrame
                                                                            lexinfo:ReflexiveFrame
                                                                            [owl:someValuesFrom lexinfo:ReflexiveObject ; 
                                                                            owl:onProperty lexinfo:directObject ; 
                                                                            a owl:Restriction]) ; 
                                                        a owl:Class].
lexinfo:ReflexiveFrame a owl:Class;
                       rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                       rdfs:subClassOf lexinfo:VerbFrame;
                       owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                [owl:someValuesFrom lexinfo:ReflexiveObject ; 
                                                                owl:onProperty lexinfo:object ; 
                                                                a owl:Restriction]) ; 
                                            a owl:Class].
lexinfo:ReflexiveObject a owl:Class;
                        rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                        rdfs:label "Рефлексивное дополнение"@ru;
                        rdfs:subClassOf lexinfo:Object.
lexinfo:ReflexiveReciprocalFrame lexinfo:example "hans und marie TREFFEN sich"@de;
                                 a owl:Class;
                                 rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                 rdfs:subClassOf lexinfo:ReflexiveFrame;
                                 owl:equivalentClass [owl:intersectionOf (lexinfo:ReciprocalFrame
                                                                          lexinfo:ReflexiveFrame) ; 
                                                      a owl:Class].
lexinfo:ReflexiveTransitiveFrame lexinfo:example "elle se COUCHE"@fr,
                                                 "er ERHOLT sich"@de;
                                 a owl:Class;
                                 rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                 rdfs:subClassOf lexinfo:ReflexiveFrame;
                                 owl:equivalentClass [owl:intersectionOf (lexinfo:ReflexiveFrame
                                                                          lexinfo:TransitiveFrame) ; 
                                                      a owl:Class].
lexinfo:ReflexiveTransitivePPFrame lexinfo:example "elle se APPROCHE DE la gare"@fr,
                                                   "ich ERRINERE mich AN seinen vater"@de;
                                   a owl:Class;
                                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                   rdfs:subClassOf lexinfo:ReflexiveFrame;
                                   owl:equivalentClass [owl:intersectionOf (lexinfo:ReflexiveFrame
                                                                            lexinfo:TransitivePPFrame) ; 
                                                        a owl:Class].
lexinfo:Register a owl:Class;
                 rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                 rdfs:label "Регистр"@ru;
                 rdfs:subClassOf lemon:SenseContext.
lexinfo:SententialFrame a owl:Class;
                        rdfs:comment "Sentential frames take a clause as argument, no conjunction is used and the syntax of the clause is the same as a main clause"@en;
                        rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                        rdfs:subClassOf lexinfo:VerbFrame;
                        owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                 [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                 owl:onProperty lexinfo:sententialClause ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
lexinfo:Subject a owl:Class;
                rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                rdfs:label "Подлежащее"@ru;
                rdfs:subClassOf [owl:hasValue false ; 
                                 owl:onProperty lemon:optional ; 
                                 a owl:Restriction],
                                lemon:Argument.
lexinfo:SubjectControl a owl:Class;
                       rdfs:comment "Indicates the subject of the main clause is the (omitted) subject of the subclause"@en;
                       rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                       rdfs:subClassOf lexinfo:Control.
lexinfo:SubjectlessFrame a owl:Class;
                         rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                         rdfs:subClassOf lexinfo:VerbFrame;
                         owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                  [owl:cardinality "0"^^xsd:nonNegativeInteger ; 
                                                                  owl:onProperty lexinfo:subject ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
lexinfo:SubjectlessIntransitiveFrame lexinfo:example "mir SCHWINDELT"@de;
                                     a owl:Class;
                                     rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                     rdfs:subClassOf lexinfo:SubjectlessFrame;
                                     owl:equivalentClass [owl:intersectionOf (lexinfo:SubjectlessFrame
                                                                              [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                              owl:onProperty lexinfo:indirectObject ; 
                                                                              a owl:Restriction]) ; 
                                                          a owl:Class].
lexinfo:SubjectlessIntransitivePPFrame lexinfo:example "mir TRÄUMT VON jener zeit"@de;
                                       a owl:Class;
                                       rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                       rdfs:subClassOf lexinfo:SubjectlessIntransitiveFrame;
                                       owl:equivalentClass [owl:intersectionOf (lexinfo:PPFrame
                                                                                lexinfo:SubjectlessIntransitiveFrame) ; 
                                                            a owl:Class].
lexinfo:SubjectlessTransitiveFrame lexinfo:example "mich FRIERT"@de;
                                   a owl:Class;
                                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                   rdfs:subClassOf lexinfo:SubjectlessFrame;
                                   owl:equivalentClass [owl:intersectionOf (lexinfo:SubjectlessFrame
                                                                            [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                            owl:onProperty lexinfo:directObject ; 
                                                                            a owl:Restriction]) ; 
                                                        a owl:Class].
lexinfo:SubjectlessTransitivePPFrame lexinfo:example "mich EKELT VOR fleisch"@de;
                                     a owl:Class;
                                     rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                     rdfs:subClassOf lexinfo:SubjectlessTransitiveFrame,
                                                     lexinfo:PPFrame;
                                     owl:equivalentClass [owl:intersectionOf (lexinfo:PPFrame
                                                                              lexinfo:SubjectlessTransitiveFrame) ; 
                                                          a owl:Class].
lexinfo:SubjunctiveClause a owl:Class;
                          rdfs:comment "A subclause that is in the subjunctive mood"@en;
                          rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                          rdfs:subClassOf lexinfo:ClausalArgument.
lexinfo:Suffix a owl:Class;
               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
               rdfs:label "Окончание"@ru;
               rdfs:subClassOf lexinfo:Affix;
               owl:equivalentClass [owl:hasValue lexinfo:suffix ; 
                                    owl:onProperty lexinfo:termElement ; 
                                    a owl:Restriction].
lexinfo:SuperlativeAdjunct a owl:Class;
                           rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                           rdfs:subClassOf lexinfo:Adjunct.
lexinfo:Symbol a owl:Class;
               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
               rdfs:label "Символ"@ru;
               rdfs:subClassOf lemon:Word;
               owl:equivalentClass [owl:someValuesFrom lexinfo:SymbolPOS ; 
                                    owl:onProperty lexinfo:partOfSpeech ; 
                                    a owl:Restriction].
lexinfo:SymbolPOS a owl:Class;
                  rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                  rdfs:subClassOf lexinfo:PartOfSpeech.
lexinfo:TemporalQualifier a owl:Class;
                          rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                          rdfs:label "Временной классификатор"@ru;
                          rdfs:subClassOf lemon:SenseContext.
lexinfo:Tense a owl:Class;
              rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
              rdfs:label "Видовременная форма"@ru;
              rdfs:subClassOf lexinfo:MorphosyntacticProperty.
lexinfo:TermElement a owl:Class;
                    rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                    rdfs:subClassOf lemon:PropertyValue.
lexinfo:TermType a owl:Class;
                 rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                 rdfs:label "Тип термина"@ru;
                 rdfs:subClassOf lemon:PropertyValue.
lexinfo:TransitiveAdjectivalComplementFrame lexinfo:example "they PAINTED it red"@en;
                                            a owl:Class;
                                            rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                            rdfs:subClassOf lexinfo:TransitiveFrame;
                                            owl:equivalentClass [owl:intersectionOf (lexinfo:AdjectivalComplementFrame
                                                                                     lexinfo:TransitiveFrame) ; 
                                                                 a owl:Class].
lexinfo:TransitiveAdverbialComplementFrame lexinfo:example "she PUT the cheese back"@en;
                                           a owl:Class;
                                           rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                           rdfs:subClassOf lexinfo:TransitiveFrame;
                                           owl:equivalentClass [owl:intersectionOf (lexinfo:AdverbialComplementFrame
                                                                                    lexinfo:TransitiveFrame) ; 
                                                                a owl:Class].
lexinfo:TransitiveDeclarativeFrame lexinfo:example "he CONVINCED her [that she should go]"@en;
                                   a owl:Class;
                                   rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                   rdfs:subClassOf lexinfo:DeclarativeFrame;
                                   owl:equivalentClass [owl:intersectionOf (lexinfo:DeclarativeFrame
                                                                            lexinfo:TransitiveFrame) ; 
                                                        a owl:Class].
lexinfo:TransitiveFrame lexinfo:example "the dog BIT the man"@en;
                        a owl:Class;
                        rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                        rdfs:subClassOf lexinfo:VerbFrame;
                        owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                 owl:onProperty lexinfo:directObject ; 
                                                                 a owl:Restriction]
                                                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                 owl:onProperty lexinfo:subject ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
lexinfo:TransitiveInfinitiveACFrame lexinfo:example "they CONVINCED him [to go]"@en;
                                    a owl:Class;
                                    rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                    rdfs:subClassOf lexinfo:InfinitiveFrame;
                                    owl:equivalentClass [owl:intersectionOf (lexinfo:ArbitraryControl
                                                                             lexinfo:InfinitiveFrame
                                                                             lexinfo:TransitiveFrame) ; 
                                                         a owl:Class].
lexinfo:TransitiveInfinitiveOCFrame lexinfo:example "i WANT john [to go]"@en;
                                    a owl:Class;
                                    rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                    rdfs:subClassOf lexinfo:InfinitiveFrame;
                                    owl:equivalentClass [owl:intersectionOf (lexinfo:InfinitiveFrame
                                                                             lexinfo:ObjectControl
                                                                             lexinfo:TransitiveFrame) ; 
                                                         a owl:Class].
lexinfo:TransitiveInfinitiveSCFrame lexinfo:example "john PROMISED mary [to resign]"@en;
                                    a owl:Class;
                                    rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                    rdfs:subClassOf lexinfo:InfinitiveFrame;
                                    owl:equivalentClass [owl:intersectionOf (lexinfo:InfinitiveFrame
                                                                             lexinfo:SubjectControl
                                                                             lexinfo:TransitiveFrame) ; 
                                                         a owl:Class].
lexinfo:TransitiveInterrogativeFrame lexinfo:example "he ASKED her [what he should do]"@en;
                                     a owl:Class;
                                     rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                     rdfs:subClassOf lexinfo:InterrogativeFrame;
                                     owl:equivalentClass [owl:intersectionOf (lexinfo:InterrogativeFrame
                                                                              lexinfo:TransitiveFrame) ; 
                                                          a owl:Class].
lexinfo:TransitiveInterrogativeInfinitiveFrame lexinfo:example "he ASKED her [what to do]"@en;
                                               a owl:Class;
                                               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                               rdfs:subClassOf lexinfo:InterrogativeInfinitiveFrame.
lexinfo:TransitiveNominalComplementFrame lexinfo:example "they ELECTED him president"@en;
                                         a owl:Class;
                                         rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                         rdfs:subClassOf lexinfo:TransitiveFrame;
                                         owl:equivalentClass [owl:intersectionOf (lexinfo:NominalComplementFrame
                                                                                  lexinfo:TransitiveFrame) ; 
                                                              a owl:Class].
lexinfo:TransitivePPFrame lexinfo:example "she ADDED salt TO the stew"@en;
                          a owl:Class;
                          rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                          rdfs:subClassOf lexinfo:TransitiveFrame;
                          owl:equivalentClass [owl:intersectionOf (lexinfo:PPFrame
                                                                   lexinfo:TransitiveFrame) ; 
                                               a owl:Class].
lexinfo:TransitiveSententialFrame lexinfo:example "he TOLD the audience he was leaving"@en;
                                  a owl:Class;
                                  rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                  rdfs:subClassOf lexinfo:SententialFrame;
