lexinfo:IndirectObject a owl:Class;
                       rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                       rdfs:label "Косвенное дополнение"@ru;
                       rdfs:subClassOf lexinfo:Object.
lexinfo:InfinitiveClause a owl:Class;
                         rdfs:comment "A clause whose main verb is infinitive"@en;
                         rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                         rdfs:subClassOf lexinfo:ClausalArgument.
lexinfo:InfinitiveFrame a owl:Class;
                        rdfs:comment "Infinitive frames take an infinitive clause as an argument"@en;
                        rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
