lexinfo:IntransitiveInfinitiveRSFrame lexinfo:example "he SEEMED [to be happy]"@en;
                                      a owl:Class;
                                      rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
