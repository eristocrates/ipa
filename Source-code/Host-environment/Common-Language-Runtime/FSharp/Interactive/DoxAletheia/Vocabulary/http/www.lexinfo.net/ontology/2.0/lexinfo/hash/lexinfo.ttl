lexinfo:Infix a owl:Class;
              rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
              rdfs:label "Суффикс"@ru;
              rdfs:subClassOf lexinfo:Affix;
              owl:equivalentClass [owl:someValuesFrom lexinfo:Infix ; 
