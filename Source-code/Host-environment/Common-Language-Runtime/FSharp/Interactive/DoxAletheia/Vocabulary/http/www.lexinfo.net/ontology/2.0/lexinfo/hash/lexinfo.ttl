                                                                         [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                         owl:onProperty lexinfo:subject ; 
                                                                         a owl:Restriction]) ; 
                                                     a owl:Class].
lexinfo:Gerund a owl:Class;
               rdfs:comment """A clause, whose head is a non-finite verb form, which is used in place of an argument. In English these use the \"-ing\" suffix"""@en;
               rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
               rdfs:subClassOf lexinfo:ClausalArgument.
lexinfo:GerundACFrame a owl:Class;
                      rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                      rdfs:subClassOf lexinfo:GerundFrame;
                      owl:equivalentClass [owl:intersectionOf (lexinfo:ArbitraryControl
                                                               lexinfo:GerundFrame) ; 
                                           a owl:Class].
lexinfo:GerundFrame a owl:Class;
                    rdfs:comment "Indicates one of the arguments is a gerund clause"@en;
                    rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                    rdfs:subClassOf lexinfo:VerbFrame;
                    owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                             [owl:someValuesFrom lexinfo:Gerund ; 
                                                             owl:onProperty lemon:synArg ; 
                                                             a owl:Restriction]) ; 
                                         a owl:Class].
lexinfo:GerundOCFrame a owl:Class;
                      rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                      rdfs:subClassOf lexinfo:GerundFrame;
                      owl:equivalentClass [owl:intersectionOf (lexinfo:GerundFrame
                                                               lexinfo:ObjectControl) ; 
                                           a owl:Class].
lexinfo:GerundSCFrame a owl:Class;
                      rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                      rdfs:subClassOf lexinfo:GerundFrame;
                      owl:equivalentClass [owl:intersectionOf (lexinfo:GerundFrame
                                                               lexinfo:SubjectControl) ; 
                                           a owl:Class].
lexinfo:ImpersonalFrame a owl:Class;
                        rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                        rdfs:subClassOf lexinfo:VerbFrame;
                        owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
                                                                 [owl:cardinality "0"^^xsd:nonNegativeInteger ; 
                                                                 owl:onProperty lexinfo:subject ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
lexinfo:ImpersonalIntransitiveFrame a owl:Class;
                                    rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                                    rdfs:subClassOf lexinfo:ImpersonalFrame;
                                    owl:equivalentClass [owl:intersectionOf (lexinfo:ImpersonalFrame
                                                                             [owl:cardinality "0"^^xsd:nonNegativeInteger ; 
                                                                             owl:onProperty lexinfo:object ; 
                                                                             a owl:Restriction]) ; 
                                                         a owl:Class].
