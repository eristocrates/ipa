                                          a owl:Restriction].
lexinfo:InterrogativeClause a owl:Class;
                            rdfs:comment """A subclause that begins interrogative construction (\"wh\"-word in English)"""@en;
                            rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                            rdfs:subClassOf lexinfo:ClausalArgument.
lexinfo:InterrogativeFrame a owl:Class;
                           rdfs:comment """Indicates the frame has a subframe indicated with the appropriate interrogative (e.g., \"who\", \"where\", \"how\")"""@en;
                           rdfs:isDefinedBy <http://www.lexinfo.net/ontology/2.0/lexinfo>;
                           rdfs:subClassOf lexinfo:VerbFrame;
                           owl:equivalentClass [owl:intersectionOf (lexinfo:VerbFrame
