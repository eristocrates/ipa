uniprot: a owl:Ontology;
         rdfs:comment "Properties and classes used for protein annotation.".
uniprot:API a uniprot:Mass_Measurement_Method,
              owl:Thing;
            rdfs:comment "Mass measurement using Atmospheric Pressure Ionization";
            rdfs:label "Atmospheric Pressure Ionization".
uniprot:Absorption_Annotation a owl:Class;
                              rdfs:comment "Indicates the wavelength in nm at which photoreactive proteins such as opsins and DNA photolyases show maximal absorption.";
                              rdfs:label "Absorption";
                              rdfs:subClassOf uniprot:Biophysicochemical_Annotation.
uniprot:Active_Site_Annotation a owl:Class;
                               rdfs:comment "Amino acid(s) involved in the activity of an enzyme.";
                               rdfs:label "Active Site";
                               rdfs:seeAlso "http://www.uniprot.org/manual/act_site"^^xsd:anyURI;
                               rdfs:subClassOf uniprot:Site_Annotation.
uniprot:Allergen_Annotation a owl:Class;
                            rdfs:comment "Information relevant to allergenic proteins.";
                            rdfs:label "Allergen";
                            rdfs:seeAlso "http://www.uniprot.org/manual/allergenic_properties"^^xsd:anyURI;
                            rdfs:subClassOf uniprot:Annotation.
uniprot:Alternative_Initiation_Annotation a owl:Class;
                                          rdfs:label "Alternative Initiation";
                                          rdfs:subClassOf uniprot:Alternative_Products_Annotation.
uniprot:Alternative_Products_Annotation a owl:Class;
                                        rdfs:comment "Description of the existence of related protein sequences produced by alternative splicing of the same gene or by the use of alternative initiation codons.";
                                        rdfs:label "Alternative Products";
                                        rdfs:seeAlso "http://www.uniprot.org/manual/alternative_products"^^xsd:anyURI;
                                        rdfs:subClassOf uniprot:Annotation.
uniprot:Alternative_Promoter_Usage_Annotation a owl:Class;
                                              rdfs:label "Alternative Promoter Usage";
                                              rdfs:subClassOf uniprot:Alternative_Products_Annotation.
uniprot:Alternative_Sequence_Annotation a owl:Class;
                                        rdfs:comment "Description of sequence variants produced by alternative splicing.";
                                        rdfs:label "Splice Variant";
                                        rdfs:seeAlso "http://www.uniprot.org/manual/var_seq"^^xsd:anyURI;
                                        rdfs:subClassOf uniprot:Natural_Variation_Annotation.
uniprot:Alternative_Splicing_Annotation a owl:Class;
                                        rdfs:label "Alternative Splicing";
                                        rdfs:subClassOf uniprot:Alternative_Products_Annotation.
uniprot:Annotation a owl:Class;
                   rdfs:comment "Description of a resource on a specific topic.".
uniprot:Apicoplast a uniprot:Organelle,
                     owl:Thing;
                   rdfs:label "Apicoplast".
uniprot:Attribution a owl:Class;
                    rdfs:comment "Entity used to attach evidence or provenance to a rdf statement via reification."@en.
uniprot:Beta_Strand_Annotation a owl:Class;
                               rdfs:comment "Beta strand regions within the experimentally determined protein structure";
                               rdfs:label "Strand";
                               rdfs:seeAlso "http://www.uniprot.org/manual/strand"^^xsd:anyURI;
                               rdfs:subClassOf uniprot:Secondary_Structure_Annotation.
uniprot:Binding_Site_Annotation a owl:Class;
                                rdfs:comment "Binding site for any chemical group (co-enzyme, prosthetic group, etc.).";
                                rdfs:label "Binding Site";
                                rdfs:seeAlso "http://www.uniprot.org/manual/binding"^^xsd:anyURI;
                                rdfs:subClassOf uniprot:Site_Annotation.
uniprot:Biophysicochemical_Annotation a owl:Class;
                                      rdfs:comment "Biophysical and physicochemical data such as pH dependence, temperature dependence, kinetic parameters, redox potentials, and maximal absorption.";
                                      rdfs:label "Biophysicochemical Property";
                                      rdfs:seeAlso "http://purl.uniprot.org/core/biophysicochemical_properties"^^xsd:anyURI;
                                      rdfs:subClassOf uniprot:Annotation.
uniprot:Biotechnology_Annotation a owl:Class;
                                 rdfs:comment "Description of the use of a specific protein in a biotechnological process.";
                                 rdfs:label "Biotechnology";
                                 rdfs:seeAlso "http://www.uniprot.org/manual/biotechnological_use"^^xsd:anyURI;
                                 rdfs:subClassOf uniprot:Annotation.
uniprot:Book_Citation a owl:Class;
                      rdfs:comment "A chapter from a book.";
                      rdfs:label "Book Citation";
                      rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty uniprot:name ; 
                                       a owl:Restriction],
                                      [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty uniprot:name ; 
                                       a owl:Restriction],
                                      uniprot:Published_Citation.
uniprot:By_Similarity a uniprot:Status,
                        owl:Thing;
                      rdfs:label "By Similarity".
uniprot:Calcium_Binding_Annotation a owl:Class;
                                   rdfs:comment "Extent of a calcium-binding region.";
                                   rdfs:label "Calcium Binding";
                                   rdfs:seeAlso "http://www.uniprot.org/manual/ca_bind"^^xsd:anyURI;
                                   rdfs:subClassOf uniprot:Region_Annotation.
uniprot:Catalytic_Activity_Annotation a owl:Class;
                                      rdfs:comment "Description of the reactions catalyzed by an enzyme.";
                                      rdfs:label "Catalytic Activity";
                                      rdfs:seeAlso "http://www.uniprot.org/manual/catalytic_activity"^^xsd:anyURI;
                                      rdfs:subClassOf uniprot:Annotation.
uniprot:Caution_Annotation a owl:Class;
                           rdfs:comment "Warning about possible errors and/or grounds for confusion.";
                           rdfs:label "Caution";
                           rdfs:seeAlso "http://www.uniprot.org/manual/caution"^^xsd:anyURI;
                           rdfs:subClassOf uniprot:Annotation.
uniprot:Cellular_Component a owl:Class;
                           rdfs:label "Cellular Component";
                           rdfs:subClassOf uniprot:Subcellular_Location.
uniprot:Chain_Annotation a owl:Class;
                         rdfs:comment "Extent of a polypeptide chain in the mature protein.";
                         rdfs:label "Chain";
                         rdfs:seeAlso "http://www.uniprot.org/manual/chain"^^xsd:anyURI;
                         rdfs:subClassOf uniprot:Molecule_Processing_Annotation.
uniprot:Chloroplast a uniprot:Organelle,
                      owl:Thing;
                    rdfs:label "Chloroplast".
uniprot:Citation a owl:Class;
                 rdfs:comment "Description of a publication from which data was obtained.";
                 rdfs:seeAlso "http://www.uniprot.org/manual/references"^^xsd:anyURI;
                 rdfs:subClassOf [owl:unionOf ([owl:someValuesFrom xsd:date ; 
                                               owl:onProperty uniprot:date ; 
                                               a owl:Restriction]
                                               [owl:someValuesFrom xsd:gYear ; 
                                               owl:onProperty uniprot:date ; 
                                               a owl:Restriction]
                                               [owl:someValuesFrom xsd:gYearMonth ; 
                                               owl:onProperty uniprot:date ; 
                                               a owl:Restriction]) ; 
                                  a owl:Class],
                                 [owl:unionOf ([owl:someValuesFrom xsd:date ; 
                                               owl:onProperty uniprot:date ; 
                                               a owl:Restriction]
                                               [owl:someValuesFrom xsd:gYear ; 
                                               owl:onProperty uniprot:date ; 
                                               a owl:Restriction]
                                               [owl:someValuesFrom xsd:gYearMonth ; 
                                               owl:onProperty uniprot:date ; 
                                               a owl:Restriction]) ; 
                                  a owl:Class];
                 owl:disjointWith uniprot:Sequence,
                                  uniprot:Range,
                                  uniprot:Protein.
uniprot:Citation_Statement a owl:Class;
                           rdfs:comment "The relationship between a resource and a citation.";
                           rdfs:label "Citation Statement";
                           rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (uniprot:Strain
                                                                            uniprot:Tissue
                                                                            uniprot:Transposon) ; 
                                                               a owl:Class] ; 
                                            owl:onProperty uniprot:context ; 
                                            a owl:Restriction],
                                           [owl:allValuesFrom [owl:unionOf (uniprot:Strain
                                                                            uniprot:Tissue
                                                                            uniprot:Transposon) ; 
                                                               a owl:Class] ; 
                                            owl:onProperty uniprot:context ; 
                                            a owl:Restriction],
                                           rdf:Statement.
uniprot:Class a uniprot:Rank,
                owl:Thing;
              rdfs:label "Taxonomy rank Class".
uniprot:Cluster a owl:Class;
                rdfs:comment "Cluster of proteins with similar sequences.";
                rdfs:seeAlso "http://www.uniprot.org/uniref/"^^xsd:anyURI;
                rdfs:subClassOf [owl:allValuesFrom uniprot:Sequence ; 
                                 owl:onProperty uniprot:member ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom uniprot:Sequence ; 
                                 owl:onProperty uniprot:member ; 
                                 a owl:Restriction],
                                owl:Thing;
                owl:disjointWith uniprot:Sequence,
                                 uniprot:Protein.
uniprot:Cofactor_Annotation a owl:Class;
                            rdfs:comment "Description of an enzyme cofactor.";
                            rdfs:label "Cofactor";
                            rdfs:seeAlso "http://www.uniprot.org/manual/cofactor"^^xsd:anyURI;
                            rdfs:subClassOf uniprot:Annotation.
uniprot:Coiled_Coil_Annotation a owl:Class;
                               rdfs:comment "Extent of a coiled-coil region.";
                               rdfs:label "Coiled-Coil";
                               rdfs:seeAlso "http://www.uniprot.org/manual/coiled"^^xsd:anyURI;
                               rdfs:subClassOf uniprot:Region_Annotation.
uniprot:Compositional_Bias_Annotation a owl:Class;
                                      rdfs:comment "Extent of a compositionally biased region.";
                                      rdfs:label "Compositionally Biased Region";
                                      rdfs:seeAlso "http://www.uniprot.org/manual/compbias"^^xsd:anyURI;
                                      rdfs:subClassOf uniprot:Region_Annotation.
uniprot:Concept a owl:Class;
                rdfs:comment "A concept used to classify resources.";
                rdfs:label "Concept";
                rdfs:subClassOf [owl:allValuesFrom uniprot:Concept ; 
                                 owl:onProperty uniprot:replaces ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom uniprot:Concept ; 
                                 owl:onProperty uniprot:replaces ; 
                                 a owl:Restriction],
                                owl:Class.
uniprot:Cross-link_Annotation a owl:Class;
                              rdfs:comment "Posttranslationally formed amino acid bonds.";
                              rdfs:label "Crosslink";
                              rdfs:seeAlso "http://www.uniprot.org/manual/crosslnk"^^xsd:anyURI;
                              rdfs:subClassOf uniprot:Modification_Annotation.
uniprot:Cyanelle a uniprot:Organelle,
                   owl:Thing;
                 rdfs:label "Cyanelle".
uniprot:DNA a owl:Class;
            rdfs:subClassOf uniprot:Molecule.
uniprot:Database a owl:Class;
                 rdfs:comment "Metadata for a life science database.";
                 rdfs:seeAlso "http://www.uniprot.org/manual/cross_references"^^xsd:anyURI;
                 rdfs:subClassOf owl:Class.
uniprot:Developmental_Stage_Annotation a owl:Class;
                                       rdfs:comment "Description of the developmentally-specific expression of a protein.";
                                       rdfs:label "Developmental Stage";
                                       rdfs:seeAlso "http://www.uniprot.org/manual/developmental_stage"^^xsd:anyURI;
                                       rdfs:subClassOf uniprot:Annotation.
uniprot:Disease_Annotation a owl:Class;
                           rdfs:comment "Description of the diseases associated with a deficiency of a protein.";
                           rdfs:label "Disease";
                           rdfs:seeAlso "http://www.uniprot.org/manual/involvement_in_disease"^^xsd:anyURI;
                           rdfs:subClassOf uniprot:Annotation.
uniprot:Disruption_Phenotype_Annotation a owl:Class;
                                        rdfs:label "Disruption Phenotype";
                                        rdfs:seeAlso "http://www.uniprot.org/manual/disruption_phenotype"^^xsd:anyURI;
                                        rdfs:subClassOf uniprot:Annotation.
uniprot:Disulfide_Bond_Annotation a owl:Class;
                                  rdfs:comment "Describes residues which are linked by an intra-chain disulfide bond. If the endpoints are identical, the disulfide bond is an interchain one.";
                                  rdfs:label "Disulfide Bond";
                                  rdfs:seeAlso "http://www.uniprot.org/manual/disulfid"^^xsd:anyURI;
                                  rdfs:subClassOf uniprot:Modification_Annotation.
uniprot:Domain_Annotation a owl:Class;
                          rdfs:comment "Description of the domain structure of a protein.";
                          rdfs:label "Domain";
                          rdfs:seeAlso "http://www.uniprot.org/manual/domain_cc"^^xsd:anyURI;
                          rdfs:subClassOf uniprot:Annotation.
uniprot:Domain_Assignment_Statement a owl:Class;
                                    rdfs:comment "The relationship between a protein and a protein domain.";
                                    rdfs:label "Domain Assignment Statement";
                                    rdfs:subClassOf rdf:Statement.
uniprot:Domain_Extent_Annotation a owl:Class;
                                 rdfs:comment "Extent of a domain, which is defined as a specific combination of secondary structures organized into a characteristic three-dimensional structure or fold.";
                                 rdfs:label "Domain Extent";
                                 rdfs:seeAlso "http://www.uniprot.org/manual/domain"^^xsd:anyURI;
                                 rdfs:subClassOf uniprot:Region_Annotation.
uniprot:ESI a uniprot:Mass_Measurement_Method,
              owl:Thing;
            rdfs:label "Electrospray Ionization";
            rdfs:seeAlso "iki:Electrospray_ionization"^^xsd:anyURI.
uniprot:Electron_Microscopy a uniprot:Structure_Determination_Method,
                              owl:Thing;
                            rdfs:comment "The electron microscope is a microscope that can magnify very small details with high resolving power due to the use of electrons rather than light to scatter off material, magnifying at levels up to 500,000 times.";
                            rdfs:label "Electron Microscopy";
                            rdfs:seeAlso "iki:Electron_microscopy"^^xsd:anyURI.
uniprot:Electronic_Citation a owl:Class;
                            rdfs:comment "An electronic publication.";
                            rdfs:label "Electronic Citation";
                            rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty uniprot:name ; 
                                             a owl:Restriction],
                                            [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty uniprot:name ; 
                                             a owl:Restriction],
                                            uniprot:Published_Citation.
uniprot:Endpoint_Statement a owl:Class;
                           rdfs:comment "Metadata for an endpoint of a range on a sequence.";
                           rdfs:label "Endpoint Statement";
                           rdfs:subClassOf rdf:Statement.
uniprot:Enzyme a owl:Class;
               rdfs:comment "A specific catalytic activity, defined by the Enzyme Commission of the Nomenclature Committee of the International Union of Biochemistry and Molecular Biology (IUBMB).";
               rdfs:label "Enzyme";
               rdfs:seeAlso "http://www.expasy.org/enzyme/"^^xsd:anyURI;
               rdfs:subClassOf [owl:allValuesFrom uniprot:Enzyme ; 
                                owl:onProperty uniprot:replaces ; 
                                a owl:Restriction],
                               [owl:allValuesFrom uniprot:Enzyme ; 
                                owl:onProperty uniprot:replacedBy ; 
                                a owl:Restriction],
                               [owl:allValuesFrom uniprot:Enzyme ; 
                                owl:onProperty uniprot:replaces ; 
                                a owl:Restriction],
                               [owl:allValuesFrom uniprot:Enzyme ; 
                                owl:onProperty uniprot:replacedBy ; 
                                a owl:Restriction],
                               owl:Class.
uniprot:Enzyme_Regulation_Annotation a owl:Class;
                                     rdfs:comment "Description of an enzyme regulatory mechanism.";
                                     rdfs:label "Enzyme Regulation";
                                     rdfs:seeAlso "http://www.uniprot.org/manual/enzyme_regulation"^^xsd:anyURI;
