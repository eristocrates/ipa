                               rdfs:subClassOf uniprot:Annotation.
uniprot:Range a owl:Class;
              rdfs:comment "A range of amino acids on a protein  sequence.";
              owl:equivalentClass [owl:unionOf ([owl:intersectionOf ([owl:onDataRange xsd:int ; 
                                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                    owl:onProperty uniprot:begin ; 
                                                                    a owl:Restriction]
                                                                    [owl:onDataRange xsd:int ; 
                                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                    owl:onProperty uniprot:end ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class]
                                                [owl:intersectionOf ([owl:onDataRange xsd:int ; 
                                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                    owl:onProperty uniprot:end ; 
                                                                    a owl:Restriction]
                                                                    [owl:onDataRange xsd:int ; 
                                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                    owl:onProperty uniprot:begin ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class]) ; 
                                   a owl:Class],
                                  [owl:unionOf ([owl:intersectionOf ([owl:onDataRange xsd:int ; 
                                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                    owl:onProperty uniprot:begin ; 
                                                                    a owl:Restriction]
                                                                    [owl:onDataRange xsd:int ; 
                                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                    owl:onProperty uniprot:end ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class]
                                                [owl:intersectionOf ([owl:onDataRange xsd:int ; 
                                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                    owl:onProperty uniprot:end ; 
                                                                    a owl:Restriction]
                                                                    [owl:onDataRange xsd:int ; 
                                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
