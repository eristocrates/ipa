                                                          uniprot:Evidence_at_Protein_Level_Existence
                                                          uniprot:Predicted_Existence) ; 
                                               a owl:Class],
                                              [owl:oneOf (uniprot:Evidence_at_Transcript_Level_Existence
                                                          uniprot:Inferred_from_Homology_Existence
