                rdfs:range <http://xmlns.com/foaf/0.1/Person>;
                rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/participant>.
poder:hasStudent a <http://www.w3.org/2002/07/owl#ObjectProperty>,
