                rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                rdfs:label "Sexo"@es,
                           "Gender"@en;
                rdfs:range poder:Gender.
poder:hasGrandChild a <http://www.w3.org/2002/07/owl#ObjectProperty>,
