                    rdfs:range rdfs:Literal;
                    rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/familyName>.
poder:personParticipant a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                          rdf:Property;
                        rdfs:comment "Un miembro de una organización"@es,
                                     "A a member of an organization"@en;
