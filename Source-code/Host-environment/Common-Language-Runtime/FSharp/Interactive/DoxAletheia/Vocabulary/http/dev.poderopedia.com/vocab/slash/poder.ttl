                           rdfs:subPropertyOf poder:organizationParticipant.
poder:schema <http://purl.org/dc/terms/abstract> "Este documento describe un vocabulario para expresar información acerca de personas, y sus relaciones con organizaciones y empresas"@es,
                                                 "This document describes a vocabulary to express information about people and their relations with Organizations, Companies, etc."@en;
             <http://purl.org/dc/terms/date> "2012-05-17"^^xsd:date;
             <http://purl.org/dc/terms/title> "PoderVocab: Un vocabulario para Poderopedia"@es,
                                              "PoderVocab: A vocabulary for Poderopedia"@en;
             a <http://www.w3.org/2002/07/owl#Ontology>;
             rdfs:label "PoderVocab: Un vocabulario para Poderopedia"@es,
                        "PoderVocab: A vocabulary for Poderopedia"@en;
             <http://www.w3.org/2002/07/owl#versionInfo> "0.8".
poder:subsidiaryCompanyOf a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                            rdf:Property;
                          rdfs:comment "Relación entre empresas donde la primera es la filial de la segunda"@es,
                                       "Relation between companies where one is the subsidiary of the second"@en;
                          rdfs:domain poder:Company;
                          rdfs:label "Empresa filial de"@es,
                                     "Subsidiary company of"@en;
                          rdfs:range poder:Company.
poder:targetCompany a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                      rdf:Property;
                    rdfs:domain poder:AcquisitionCompanyConnection;
                    rdfs:label "Compañía target"@es,
                               "Target company"@en;
                    rdfs:range poder:Company;
                    rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/participant>.
<http://purl.org/dc/terms/source> a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                                    rdf:Property;
                                  rdfs:comment "Un recurso relacionado de donde  resource from which the described resource is derived."@es,
                                               "A related resource from which the described resource is derived."@en;
                                  rdfs:label "Fuente"@es,
                                             "Source"@en.
<http://purl.org/vocab/bio/0.1/Birth> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "The event of a person entering into life."@en;
                                      rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                      rdfs:label "Birth"@en;
                                      rdfs:subClassOf <http://purl.org/vocab/bio/0.1/IndividualEvent>.
<http://purl.org/vocab/bio/0.1/Death> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "The event of a person's life ending."@en;
                                      rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                      rdfs:label "Death"@en;
                                      rdfs:subClassOf <http://purl.org/vocab/bio/0.1/IndividualEvent>.
<http://purl.org/vocab/bio/0.1/Event> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "Suceso importante en la vida de una persona, grupo u organización"@es,
                                                   "An event is an occurrence that brings about a change in the state of affairs for one or more people and/or other agents. Events are assumed to occur over a period of time and may not have precise start and end points."@en;
                                      rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                      rdfs:label "Evento"@es,
                                                 "Event"@en;
                                      rdfs:subClassOf poder:SourcedEntity.
<http://purl.org/vocab/bio/0.1/IndividualEvent> a <http://www.w3.org/2002/07/owl#Class>;
                                                rdfs:comment "A type of event that is principally about a single person, group or organization. Other agents may be involved but the event is most significant for the principal agent."@en;
                                                rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                                rdfs:label "Individual Event"@en;
                                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/vocab/bio/0.1/principal> ; 
                                                                 <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                <http://purl.org/vocab/bio/0.1/Event>.
<http://purl.org/vocab/bio/0.1/Relationship> a <http://www.w3.org/2002/07/owl#Class>;
                                             rdfs:comment "A particular type of connection existing between people, groups or organizations related to or having dealings with each other."@en;
                                             rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                             rdfs:label "Agent Relationship"@en.
<http://purl.org/vocab/bio/0.1/birth> a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                        rdf:Property;
                                      rdfs:comment "An birth event associated with a person, group or organization."@en,
                                                   "El evento del nacimiento de una persona, grupo u organización"@es;
                                      rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
                                      rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                      rdfs:label "Birth Event"@en,
                                                 "Nacimiento"@es;
                                      rdfs:range <http://purl.org/vocab/bio/0.1/Birth>;
                                      rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/event>,
                                                         <http://www.w3.org/2002/07/owl#differentFrom>.
<http://purl.org/vocab/bio/0.1/concludingEvent> a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                                  rdf:Property;
                                                rdfs:comment "Un evento que marca el final de un intervalo o relación"@es,
                                                             "An event that marks the end of an interval and/or relationship. The event changes of the state of affairs that held during the interval. For example a period of study may be concluded by a Graduation event."@en;
                                                rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                                rdfs:label "Evento final"@es,
                                                           "Concluding Event"@en;
                                                rdfs:range <http://purl.org/vocab/bio/0.1/Event>.
<http://purl.org/vocab/bio/0.1/date> a rdf:Property;
                                     rdfs:comment "La fecha cuando un evento ocurrió"@es,
                                                  "The date at which an event occurred."@en;
                                     rdfs:domain <http://purl.org/vocab/bio/0.1/Event>;
                                     rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                     rdfs:label "Fecha",
                                                "Date"@en;
                                     rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/date>.
<http://purl.org/vocab/bio/0.1/death> a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                        rdf:Property;
                                      rdfs:comment "An death event associated with a person, group or organization."@en,
                                                   "El evento de la muerte de una persona, grupo u organización"@es;
                                      rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
                                      rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                      rdfs:label "Death Event"@en,
                                                 "Muerte"@es;
                                      rdfs:range <http://purl.org/vocab/bio/0.1/Death>;
                                      rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#differentFrom>,
                                                         <http://purl.org/vocab/bio/0.1/event>.
<http://purl.org/vocab/bio/0.1/initiatingEvent> a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                                  rdf:Property;
                                                rdfs:comment "Un evento que indica el comienzo de un intervalo o relación"@es,
                                                             "An event that marks the start of an interval and/or relationship. The event contributes to and/or causes of the state of affairs that hold during the interval. For example a period of study may be initiated by an Enrolment event."@en;
                                                rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                                rdfs:label "Evento inicial"@es,
                                                           "Initiating Event"@en;
                                                rdfs:range <http://purl.org/vocab/bio/0.1/Event>.
<http://purl.org/vocab/bio/0.1/participant> a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                              rdf:Property;
                                            rdfs:comment "A person, group or organization that participates in a relationship for some time."@en;
                                            rdfs:domain <http://purl.org/vocab/bio/0.1/Relationship>;
                                            rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                            rdfs:label "Participant"@en;
                                            rdfs:range <http://xmlns.com/foaf/0.1/Agent>;
                                            rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#differentFrom>;
                                            <http://www.w3.org/2002/07/owl#inverseOf> <http://purl.org/vocab/bio/0.1/relationship>.
<http://purl.org/vocab/bio/0.1/place> a rdf:Property;
                                      rdfs:comment "Lugar donde ocurre un evento"@es,
                                                   "The place at which an event occurred."@en;
                                      rdfs:domain <http://purl.org/vocab/bio/0.1/Event>;
                                      rdfs:label "Lugar",
                                                 "Place"@en;
                                      rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>.
<http://purl.org/vocab/bio/0.1/relationship> a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                               rdf:Property;
                                             rdfs:comment "A relationship that a person, group or organization participates in for some time."@en;
                                             rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
                                             rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                             rdfs:label "Relationship"@en;
                                             rdfs:range <http://purl.org/vocab/bio/0.1/Relationship>;
                                             <http://www.w3.org/2002/07/owl#inverseOf> <http://purl.org/vocab/bio/0.1/participant>.
rdfs:comment a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
               rdf:Property;
             rdfs:comment "A description of the subject resource.";
             rdfs:domain rdfs:Resource;
             rdfs:label "comment";
             rdfs:range rdfs:Literal.
<http://xmlns.com/foaf/0.1/Agent> a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "An agent (human or not)"@en,
                                               "Un agente (humano o no)"@es;
                                  rdfs:label "Agente"@es,
                                             "Agent"@en.
<http://xmlns.com/foaf/0.1/Organization> a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:label "Organización"@es,
                                                    "Organization"@en;
                                         rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent>;
                                         <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.w3.org/ns/org#Organization>.
<http://xmlns.com/foaf/0.1/Person> a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "Una persona"@es,
                                                "A person"@en;
                                   rdfs:label "Persona"@es,
                                              "Person"@en;
                                   rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent>.
<http://xmlns.com/foaf/0.1/based_near> a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                         rdf:Property;
                                       rdfs:comment "A location that something is based near, for some broadly human notion of near.";
                                       rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
                                       rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/>;
                                       rdfs:label "based near";
                                       rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>.
<http://xmlns.com/foaf/0.1/firstName> a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                                        rdf:Property;
                                      rdfs:comment "El primer nombre de una persona"@es,
                                                   "The first name of a person."@en;
                                      rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                                      rdfs:label "Primer nombre"@es,
                                                 "firstName"@en;
                                      rdfs:range rdfs:Literal.
<http://xmlns.com/foaf/0.1/givenName> a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                                        rdf:Property;
                                      rdfs:comment "El nombre dado a una persona"@es,
                                                   "The given name of some person."@en;
                                      rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/>;
                                      rdfs:label "Otro nombre"@es,
                                                 "Given name"@en.
