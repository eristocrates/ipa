@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix poder: <http://dev.poderopedia.com/vocab/>.
@prefix bio: <http://purl.org/vocab/bio/0.1/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix org: <http://www.w3.org/ns/org#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix wgspos: <http://www.w3.org/2003/01/geo/wgs84_pos#>.

poder:AcademicConnection a owl:Class;
                         rdfs:comment "La relación entre una persona y una organización académica (colegio, universidad, etc)"@es,
                                      "The connection between a person and an Educational Organization (university, school, etc)"@en;
                         rdfs:label "Conexión académica"@es,
                                    "Academic Connection"@en;
                         rdfs:subClassOf poder:Connection.
poder:AcademicOrganization a owl:Class;
                           rdfs:comment "Una organización educational, como una escuela o una universidad"@es,
                                        "An educational organization, such a school or university"@en;
                           rdfs:label "Organización académica"@es,
                                      "Academic Organization"@en;
                           rdfs:subClassOf foaf:Organization.
poder:Acquaintance rdfs:label "Conocidos"@es,
                              "Acquaintance"@en;
                   rdfs:subClassOf poder:SocialConnection.
poder:AcquisitionCompanyConnection a owl:Class;
                                   rdfs:label "Adquisición de empresa"@es,
                                              "Company acquisition"@en;
                                   rdfs:subClassOf poder:CompanyConnection.
poder:AlumniEducationalConnection a owl:Class;
                                  rdfs:label "Ex-alumno"@es,
                                             "Alumni"@en;
                                  rdfs:subClassOf poder:EducationalConnection.
poder:AssociationConnection a owl:Class;
                            rdfs:comment "La relación entre una entidad y una organización (Opus Dei, un Think Tank) sin necesariamente estar afiliado"@es,
                                         "The connection between an entity and a Organization (Opus Dei, a Think Tank) without been affiliated to it necessarily"@en;
                            rdfs:label "Conexión de asociación"@es,
                                       "Association Connection"@en;
                            rdfs:subClassOf poder:Connection.
poder:Biography a owl:Class;
                rdfs:label "Biografía genérica"@es,
                           "Generic biography"@en;
                rdfs:subClassOf poder:SourcedEntity.
poder:CivilUnion a owl:Class;
                 rdfs:label "Unión civil"@es,
                            "Civil union"@en;
                 rdfs:subClassOf poder:SentimentalRelationshipConnection.
poder:Classmate rdfs:label "Compañero de curso o clases"@es,
                           "Classmate"@en;
                rdfs:subClassOf poder:SocialConnection.
poder:Company a owl:Class;
              rdfs:comment "A for profit organization",
                           "Una organización con fines de lucro"@es;
              rdfs:label "Empresa"@es,
                         "Company"@en;
              rdfs:subClassOf foaf:Organization.
poder:CompanyConnection a owl:Class;
                        rdfs:comment "La relación entre dos compañías"@es,
                                     "The connection between two companies"@en;
                        rdfs:label "Conexión entre compañías"@es,
                                   "Company Connection"@en;
                        rdfs:subClassOf poder:Connection.
poder:Connection a owl:Class;
                 rdfs:comment "Una conexión genérica entre dos o más entidades durante un cierto período de tiempo"@es,
                              "A generic connection between two or more entities during a certain period of time"@en;
                 rdfs:label "Conexión genérica"@es,
                            "Generic connection"@en;
                 rdfs:subClassOf poder:SourcedEntity,
                                 bio:Relationship.
poder:Country a owl:Class;
              rdfs:comment "Área geográfica y una entidad políticamente independiente con su propio gobierno, administración, etc."@es,
                           "A region legally defined as a distinct entity in political geography"@en;
              rdfs:label "País"@es,
                         "Country"@en;
              rdfs:subClassOf wgspos:SpatialThing.
poder:Dating a owl:Class;
             rdfs:label "Noviazgo"@es,
                        "Dating"@en;
             rdfs:subClassOf poder:SentimentalRelationshipConnection.
poder:Documentation a owl:Class;
                    rdfs:comment "Clase que describe documentos relacionados con una persona u organización, incluyendo su fecha de publicación"@es,
                                 "Class that describes documents related to a person or organization, including its release date"@en;
                    rdfs:label "Documentación"@es,
                               "Documentation"@en;
                    rdfs:subClassOf poder:RelatedData.
poder:DomesticPartnership a owl:Class;
                          rdfs:label "Pareja de hecho"@es,
                                     "Domestic partnership"@en;
                          rdfs:subClassOf poder:SentimentalRelationshipConnection.
poder:EducationalConnection a owl:Class;
                            rdfs:comment "Esta relación indica que una persona estudió (al menos por un tiempo) en una institución académica"@es,
                                         "These connections reflects that a person studied (at least for some time) in an academic organization."@en;
                            rdfs:label "Conexión educacional (estudios)"@es,
                                       "Educational connection"@en;
                            rdfs:subClassOf poder:Connection.
poder:FinancialInformation a owl:Class;
                           rdfs:comment "Cualquier información financiera relacionada con una organización (ej., utilidades anuales)"@es,
                                        "Any financial information related to an organization (e.g., anual profit)"@en;
                           rdfs:label "Información financiera"@es,
                                      "Financial Report"@en;
                           rdfs:subClassOf poder:SourcedEntity.
poder:FinancierAssociationConnection rdfs:label "Financista"@es,
                                                "Financier"@en;
                                     rdfs:subClassOf poder:AssociationConnection.
poder:Friendship rdfs:label "Amistad"@es,
                            "Friendship"@en;
                 rdfs:subClassOf poder:SocialConnection.
poder:Gender a owl:Class;
             rdfs:comment "Sexo de una persona"@es,
                          "Gender of a person"@en;
             rdfs:label "Sexo"@es,
                        "Gender"@en.
poder:GraduateEducationalConnection a owl:Class;
                                    rdfs:label "Titulado"@es,
                                               "Graduate"@en;
                                    rdfs:subClassOf poder:EducationalConnection.
poder:InternationalOrganization a owl:Class;
                                rdfs:comment "Una organización internacional, como NU, UNESCO, etc."@es,
                                             "An international organization, like UN, UNESCO, etc."@en;
                                rdfs:label "Organización internacional"@es,
                                           "International Organization"@en;
                                rdfs:subClassOf foaf:Organization.
poder:LongBiography a owl:Class;
                    rdfs:comment "Descripción extendida de una persona, organización, etc"@es,
                                 "Long description of a person, organization, etc"@en;
                    rdfs:label "Biografía larga"@es,
                               "Long biography"@en;
                    rdfs:subClassOf poder:Biography;
                    owl:disjointWith poder:ShortBiography.
poder:Marriage a owl:Class;
               rdfs:label "Matrimonio"@es,
                          "Marriage"@en;
               rdfs:subClassOf poder:SentimentalRelationshipConnection.
poder:MembershipAssociationConnection rdfs:comment "Miembro oficial de una organización (club social, grupo religioso, etc.)"@es,
                                                   "Official member of an organization (social club, religious group, etc.)"@en;
                                      rdfs:label "Miembro"@es,
                                                 "Member"@en;
                                      rdfs:subClassOf poder:AssociationConnection.
poder:MergeCompanyConnection a owl:Class;
                             rdfs:comment "La relación entre una persona y una organización académica (colegio, universidad, etc)"@es,
                                          "The connection between an entity and an Educational Organization (university, school, etc)"@en;
                             rdfs:label "Conexión económica"@es,
                                        "Economic Connection"@en;
                             rdfs:subClassOf poder:CompanyConnection.
poder:NewsEvent a owl:Class;
                rdfs:comment "Un evento de relevancia periodística"@es,
                             "An event relevant from the point of view of journalism"@en;
                rdfs:label "Evento noticioso"@es,
                           "News event"@en;
                rdfs:subClassOf bio:Event.
poder:NewsEventConnection a owl:Class;
                          rdfs:comment "Describe la relación de una persona con un evento noticioso durante un período de tiempo"@es,
                                       "Describes the relation of a person with a news event during a specific period of time"@en;
                          rdfs:label "Conexión con evento noticioso"@es,
                                     "News event connection"@en;
                          rdfs:subClassOf poder:Connection.
poder:NonGovernmentalOrganization a owl:Class;
                                  rdfs:comment "Una organización no gubernamental (ONG)"@es,
                                               "An non-governmental organization (NGO)"@en;
                                  rdfs:label "Organización no gubernamental"@es,
                                             "Non Governmental Organization"@en;
                                  rdfs:subClassOf foaf:Organization.
poder:NumericDatum a owl:Class;
                   rdfs:comment "Información numérica para una organización, para cierto año"@es,
                                "Numeric datum for an organization for a certain year"@en;
                   rdfs:label "Dato numérico"@es,
                              "Numeric datum"@en;
                   rdfs:subClassOf poder:RelatedData.
poder:OtherAssociationConnection rdfs:label "Otro"@es,
                                            "Other"@en;
                                 rdfs:subClassOf poder:AssociationConnection.
poder:PoliticalConnection a owl:Class;
                          rdfs:comment "Relación entre una organización política y otra entidad"@es,
                                       "Connection between a political organization and other entities"@en;
                          rdfs:label "Conexión política"@es,
                                     "Political connection"@en;
                          rdfs:subClassOf poder:AssociationConnection.
poder:PoliticalOrganization a owl:Class;
                            rdfs:comment "Una organización política, como partidos políticos."@es,
                                         "An Political organization, like parties."@en;
                            rdfs:label "Organización política"@es,
                                       "Political Organization"@en;
                            rdfs:subClassOf foaf:Organization.
poder:ProgrammaticOrganization a owl:Class;
                               rdfs:comment "Una organización programática, como los think tanks, etc."@es,
                                            "An programmatic organization, like think tanks."@en;
                               rdfs:label "Organización programática"@es,
                                          "Programmatic Organization"@en;
                               rdfs:subClassOf foaf:Organization.
poder:RelatedData a owl:Class;
                  rdfs:comment "Clase que describe datos relacionados con una organización, incluyendo su fecha relevante"@es,
                               "Class that describes any type of data related to an organization including a relevant date"@en;
                  rdfs:label "Datos relacionados"@es,
                             "Related Data"@en.
poder:ReligiousOrganization a owl:Class;
                            rdfs:comment "Una organización religiosa, como Opus Dei, Iglesia católica, etc."@es,
                                         "An religious organization, like Opus Dei, Catholic church, etc."@en;
                            rdfs:label "Organización religiosa"@es,
                                       "Religious Organization"@en;
                            rdfs:subClassOf foaf:Organization.
poder:RestrictedAccessOrganization a owl:Class;
                                   rdfs:comment "Una organización de acceso restringod, como clubes sociales, de golf, etc."@es,
                                                "A restricted access organization, like social clubs, golf clubs, etc."@en;
                                   rdfs:label "Organización de acceso restringido"@es,
                                              "Restricted access organization"@en;
                                   rdfs:subClassOf foaf:Organization.
poder:Sector a owl:Class;
             rdfs:comment "Sector productivo relacionado con una persona"@es,
                          "Productive sector related to an agent"@en;
             rdfs:label "Sector"@es,
                        "Sector"@en.
poder:SentimentalRelationshipConnection a owl:Class;
                                        rdfs:comment "Clase de los estados civiles en los que puede estar una persona"@es,
                                                     "Class of possible marital status a person can be"@en;
                                        rdfs:label "Estado civil"@es,
                                                   "Marital Status"@en;
                                        rdfs:subClassOf poder:Connection.
poder:ShortBiography a owl:Class;
                     rdfs:comment "Descripción abreviada de una persona, organización, etc"@es,
                                  "Short description of a person, organization, etc"@en;
                     rdfs:label "Biografía corta"@es,
                                "Short biography"@en;
                     rdfs:subClassOf poder:Biography;
                     owl:disjointWith poder:LongBiography.
poder:SocialConnection a owl:Class;
                       rdfs:comment "Relación entre dos personas descritas con un contexto (amistad, conocidos, etc)"@es,
                                    "Connection between a two people, like friendship, acquaintances, etc."@en;
                       rdfs:label "Conexión social"@es,
                                  "Social connection"@en;
                       rdfs:subClassOf poder:Connection.
poder:SourcedEntity a owl:Class;
                    rdfs:comment "Clase abstracta de caulquier entidad cuya información tenga una fuente"@es,
                                 "Abstract class  of any entity that has a source where its information was taken from"@en;
                    rdfs:label "Entidad con fuente"@es,
                               "Sourced Entity"@en.
poder:StudentEducationalConnection a owl:Class;
                                   rdfs:label "Estudiante"@es,
                                              "Student"@en;
                                   rdfs:subClassOf poder:EducationalConnection.
poder:SympathizerAssociationConnection rdfs:label "Simpatizante"@es,
                                                  "Sympathizer"@en;
                                       rdfs:subClassOf poder:AssociationConnection.
poder:WorkConnection a owl:Class;
                     rdfs:comment "La relación entre una persona y una organización académica (colegio, universidad, etc)"@es,
                                  "The connection between an entity and an Educational Organization (university, school, etc)"@en;
                     rdfs:label "Conexión económica"@es,
                                "Economic Connection"@en;
                     rdfs:subClassOf poder:Connection.
poder:WorkRole a rdfs:Class,
                 owl:Class;
               rdfs:label "Puesto de trabajo"@es,
                          "Work role"@en.
poder:academicParticipant a owl:ObjectProperty,
                            rdf:Property;
                          rdfs:comment "Una organización académica (escuela, universidad) que participa de esta conexión"@es,
                                       "An academic organization (school, university) who is part of this connection"@en;
                          rdfs:domain poder:AcademicConnection;
                          rdfs:label "Organización académica participante"@es,
                                     "Academic organization participant"@en;
                          rdfs:range poder:AcademicOrganization;
                          rdfs:subPropertyOf bio:participant.
poder:alias a rdf:Property,
              owl:DatatypeProperty;
            rdfs:comment "Un alias de una persona"@es,
                         "An alias for a person"@en;
            rdfs:domain foaf:Agent;
            rdfs:label "Alias"@es,
                       "Alias"@en;
            rdfs:range rdfs:Literal;
            rdfs:subPropertyOf skos:altLabel,
                               foaf:name.
poder:buyerCompany a owl:ObjectProperty,
                     rdf:Property;
                   rdfs:domain poder:AcquisitionCompanyConnection;
                   rdfs:label "Comprador"@es,
                              "Buyer"@en;
                   rdfs:range poder:Company;
                   rdfs:subPropertyOf bio:participant.
poder:ceo a poder:WorkRole;
          rdfs:label "Gerente General"@es,
                     "CEO"@en.
poder:commercialRepresentativesOf a owl:ObjectProperty,
                                    rdf:Property;
                                  rdfs:comment "Relación entre empresas donde la primera es la filial de la segunda"@es,
                                               "Relation between companies where one is the subsidiary of the second"@en;
                                  rdfs:domain poder:Company;
                                  rdfs:label "Representatens comerciales de"@es,
                                             "Commercial representatives of"@en;
                                  rdfs:range poder:Company.
poder:connectedVia a owl:ObjectProperty,
                     rdf:Property;
                   rdfs:comment "Entidad por la cual 2 personas se conocen (colegio, universidad, iglesia, etc.)"@es,
                                "Entity from where two persons know each other (school, college, church, etc.)"@en;
                   rdfs:domain poder:SocialConnection;
                   rdfs:label "Conectados via"@es,
                              "Connected via"@en;
                   rdfs:range foaf:Agent.
poder:connectionEndDate a owl:ObjectProperty,
                          rdf:Property;
                        rdfs:comment "Fecha cuando temrinó la conexión entre entidades"@es,
                                     "Date when connection between entities ended"@en;
                        rdfs:domain poder:Connection;
                        rdfs:label "Fecha de fin de connección"@es,
                                   "Connection end date"@en;
                        rdfs:subPropertyOf bio:concludingEvent.
poder:connectionStartDate a owl:ObjectProperty,
                            rdf:Property;
                          rdfs:comment "Fecha cuando comenzó la conexión entre entidades"@es,
                                       "Date when connection between entities started"@en;
                          rdfs:domain poder:Connection;
                          rdfs:label "Fecha de inicio de connección"@es,
                                     "Connection start date"@en;
                          rdfs:subPropertyOf bio:initiatingEvent.
poder:countryOfResidence a owl:ObjectProperty,
                           rdf:Property;
                         rdfs:comment "Ubicación de los headquarters"@es,
                                      "Country where the organization's headquarters are located"@en;
                         rdfs:domain foaf:Agent;
                         rdfs:label "País de residencia"@es,
                                    "Country of residence"@en;
                         rdfs:range poder:Country;
                         rdfs:subPropertyOf foaf:based_near.
poder:cto a poder:WorkRole;
          rdfs:label "Gerente de Tecnología"@es,
                     "CTO"@en.
poder:declarationOfInterests a owl:ObjectProperty,
                               rdf:Property;
                             rdfs:domain poder:WorkConnection;
                             rdfs:label "Declaración de intereses"@es,
                                        "Declaration of interests"@en;
                             rdfs:range foaf:Document.
poder:declarationOfPatrimony a owl:ObjectProperty,
                               rdf:Property;
                             rdfs:domain poder:WorkConnection;
                             rdfs:label "Declaración de Patrimonio"@es,
                                        "Declaration of Patrimony"@en;
                             rdfs:range foaf:Document.
poder:depiction a owl:ObjectProperty,
                  rdf:Property;
                rdfs:comment "Una representación visual de una persona u organización"@es,
                             "A depiction of some organization or person."@en;
                rdfs:domain foaf:Agent;
                rdfs:label "imagen"@es,
                           "depiction"@en;
                rdfs:range foaf:Document.
poder:firstLastName a owl:DatatypeProperty,
                      rdf:Property;
                    rdfs:domain foaf:Person;
                    rdfs:label "Primer apellido"@es,
                               "First last name"@en;
                    rdfs:range rdfs:Literal;
                    rdfs:subPropertyOf foaf:familyName.
poder:hasAcademicOrganization a owl:ObjectProperty,
                                rdf:Property;
                              rdfs:comment "Entidad por la cual 2 personas se conocen (colegio, universidad, iglesia, etc.)"@es,
                                           "Entity from where two persons know each other (school, college, church, etc.)"@en;
                              rdfs:domain poder:EducationalConnection;
                              rdfs:label "Organización académica"@es,
                                         "Academic organization"@en;
                              rdfs:range poder:AcademicOrganization;
                              rdfs:subPropertyOf bio:participant.
poder:hasAlternativeMainSector a owl:DatatypeProperty,
                                 rdf:Property;
                               rdfs:comment "Sector principal no listado en hasMainSector"@es,
                                            "Main sector not listed in hasMainSector"@en;
                               rdfs:domain foaf:Agent;
                               rdfs:label "Otro sector principal"@es,
                                          "Has other main sector"@en;
                               rdfs:range rdfs:Literal.
poder:hasAlternativeOtherSector a owl:DatatypeProperty,
                                  rdf:Property;
                                rdfs:comment "Otro sector no listado en hasOtherSector"@es,
                                             "Other sector not listed in hasOtherSector"@en;
                                rdfs:domain foaf:Agent;
                                rdfs:label "Otro sector secundario"@es,
                                           "Has other main sector"@en;
                                rdfs:range rdfs:Literal.
poder:hasAnotherPhilantropySector a owl:DatatypeProperty,
                                    rdf:Property;
                                  rdfs:comment "Sectores relationados a ONGs no listados"@es,
                                               "Sectors related to NGOs not lister previously"@en;
                                  rdfs:domain poder:NonGovernmentalOrganization;
                                  rdfs:label "Tiene otro Sector Org No Gubernamentales]"@es,
                                             "Has another Non Government Organization Sector"@en;
                                  rdfs:range rdfs:Literal.
poder:hasAuntOrUncle a owl:ObjectProperty,
                       rdf:Property;
                     rdfs:comment "Describe la relación donde una persona (objeto) es el/la hermano/a de uno de los padres de esta persona"@es,
                                  "Describes relation where a person (object) is the sibling of one of the parents of this person"@en;
                     rdfs:domain foaf:Person;
                     rdfs:label "Tío/a"@es,
                                "Has Aunt or Uncle"@en;
                     rdfs:range foaf:Person;
                     owl:inverseOf poder:hasNieceOrNephew.
poder:hasChild a owl:ObjectProperty,
                 rdf:Property;
               rdfs:comment "Describe la relación donde una persona (objeto) es el padre o madre de esta persona"@es,
                            "Describes relation where a person (object) is a parent of this person"@en;
               rdfs:domain foaf:Person;
               rdfs:label "Padre/Madre"@es,
                          "Has Parent"@en;
               rdfs:range foaf:Person;
               owl:inverseOf poder:hasParent.
poder:hasCousin a owl:SymmetricProperty,
                  owl:ObjectProperty,
                  rdf:Property;
                rdfs:comment "Describe la relación donde una persona (objeto) es primo o prima de esta persona"@es,
                             "Describes relation where a person (object) is the cousin (their parents are siblings) of this person"@en;
                rdfs:domain foaf:Person;
                rdfs:label "Primo/a"@es,
                           "Has cousin"@en;
                rdfs:range foaf:Person.
poder:hasDocumentURL a owl:ObjectProperty,
                       rdf:Property;
                     rdfs:comment "URL donde se encuentra el documento"@es,
                                  "URL where the document is located"@en;
                     rdfs:domain poder:Documentation;
                     rdfs:label "URL de documento"@es,
                                "Document URL"@en;
                     rdfs:range foaf:Document.
poder:hasDocumentation a owl:ObjectProperty,
                         rdf:Property;
                       rdfs:comment "Asocia un agente con documentación relacionada"@es,
                                    "Associates an agent with related documentation"@en;
                       rdfs:domain foaf:Agent;
                       rdfs:label "Tiene documentación"@es,
                                  "Has documentation"@en;
                       rdfs:range poder:Documentation.
poder:hasEconomicOrganizationParticipant a owl:ObjectProperty,
                                           rdf:Property;
                                         rdfs:comment "Organización o empresa relacionada con esta connexión económica"@es,
                                                      "Organization or company associated with this economic connection"@en;
                                         rdfs:domain poder:WorkConnection;
                                         rdfs:label "Organización/empresa relacionada"@es,
                                                    "Organization/Company involved"@en;
                                         rdfs:range foaf:Organization.
poder:hasFinancialInformationYear a rdfs:DatatypeProperty,
                                    rdf:Property;
                                  rdfs:domain poder:FinancialInformation;
                                  rdfs:label "Fecha de la información financiera"@es,
                                             "Date of financial information"@en;
                                  rdfs:range xsd:gYear.
poder:hasGender a owl:ObjectProperty,
                  rdf:Property;
                rdfs:comment "Sexo de esta persona"@es,
                             "Gender of this person"@en;
                rdfs:domain foaf:Person;
                rdfs:label "Sexo"@es,
                           "Gender"@en;
                rdfs:range poder:Gender.
poder:hasGrandChild a owl:ObjectProperty,
                      rdf:Property;
                    rdfs:comment "Describe la relación donde una persona (objeto) es hijo/a del hijo/a de la persona"@es,
                                 "Describes relation where a person (object) is the child of the person's child"@en;
                    rdfs:domain foaf:Person;
                    rdfs:label "Nieto/a"@es,
                               "Has grandchild"@en;
                    rdfs:range foaf:Person;
                    owl:inverseOf poder:hasGrandparent.
poder:hasGrandparent a owl:ObjectProperty,
                       rdf:Property;
                     rdfs:comment "Describe la relación donde una persona (objeto) es padre o madre del padre o madre de la persona"@es,
                                  "Describes relation where a person (object) is the parent of the person's parent"@en;
                     rdfs:domain foaf:Person;
                     rdfs:label "Abuelo/a"@es,
                                "Has grandparent"@en;
                     rdfs:range foaf:Person;
                     owl:inverseOf poder:hasGrandChild.
poder:hasLegalConstitution a owl:ObjectProperty,
                             rdf:Property;
                           rdfs:domain poder:Company;
                           rdfs:label "Constitución legal"@es,
                                      "Legal constitution"@en;
                           rdfs:range foaf:Document.
poder:hasLogo a owl:ObjectProperty,
                rdf:Property;
              rdfs:comment "Logo de la organización"@es,
                           "Logo of the organization"@en;
              rdfs:domain foaf:Organization;
              rdfs:label "Logo"@es,
                         "Logo"@en;
              rdfs:range foaf:Image.
poder:hasLongBiography a owl:ObjectProperty,
                         rdfs:Predicate;
                       rdfs:domain foaf:Agent;
                       rdfs:label "Biografía larga"@es,
                                  "Long biography"@en;
                       rdfs:range poder:LongBiography.
poder:hasMainSector a owl:ObjectProperty,
                      rdf:Property;
                    rdfs:comment "Sector principal relacionado con la organización"@es,
                                 "Main sector related to the organization"@en;
                    rdfs:domain foaf:Agent;
                    rdfs:label "Sector principal"@es,
                               "Has main sector"@en;
                    rdfs:range poder:Sector.
poder:hasMap a owl:ObjectProperty,
               rdf:Property;
             rdfs:domain poder:Company;
             rdfs:label "Mapa"@es,
                        "Map"@en;
             rdfs:range foaf:Document.
poder:hasNieceOrNephew a owl:ObjectProperty,
                         rdf:Property;
                       rdfs:comment "Describe la relación donde una persona (objeto) es el/la hijo/a de uno de los hermano/as de esta persona"@es,
                                    "Describes relation where a person (object) is the child of one of the siblings of this person"@en;
                       rdfs:domain foaf:Person;
                       rdfs:label "Sobrino/a"@es,
                                  "Has niece or nephew"@en;
                       rdfs:range foaf:Person;
                       owl:inverseOf poder:hasAuntOrUncle.
poder:hasNumberEmployees a owl:ObjectProperty,
                           rdf:Property;
                         rdfs:label "Número de empleados"@es,
                                    "Number of Employees"@en;
                         rdfs:subPropertyOf poder:hasNumericDatum.
poder:hasNumericDatum a owl:ObjectProperty,
                        rdf:Property;
                      rdfs:domain foaf:Organization;
                      rdfs:label "Tiene dato numérico"@es,
                                 "Has numerical datum"@en;
                      rdfs:range poder:NumericDatum.
poder:hasOrganigramDocumentation a owl:ObjectProperty,
                                   rdf:Property;
                                 rdfs:comment "Documentos que describen el organigrama este agente"@es,
                                              "Documents describing the organigram this agent"@en;
                                 rdfs:label "Documentación de organigrama"@es,
                                            "Organigram Documentation"@en;
                                 rdfs:subPropertyOf poder:hasDocumentation.
poder:hasOtherDocumentation a owl:ObjectProperty,
                              rdf:Property;
                            rdfs:comment "Documentos misceláneos relacionadas con este agente"@es,
                                         "Miscelaneous document related to this agent"@en;
                            rdfs:label "Otra documentación"@es,
                                       "Other documentation"@en;
                            rdfs:subPropertyOf poder:hasDocumentation.
poder:hasOtherSector a owl:ObjectProperty,
                       rdf:Property;
                     rdfs:comment "Otros sectores relacionados con la organización"@es,
                                  "Other sector related to the organization"@en;
                     rdfs:domain foaf:Agent;
                     rdfs:label "Sector secundario"@es,
                                "Secondary sector"@en;
                     rdfs:range poder:Sector.
poder:hasParent a owl:ObjectProperty,
                  rdf:Property;
                rdfs:comment "Describe la relación donde una persona (objeto) es el padre o madre de esta persona"@es,
                             "Describes relation where a person (object) is a parent of this person"@en;
                rdfs:domain foaf:Person;
                rdfs:label "Padre/Madre"@es,
                           "Has Parent"@en;
                rdfs:range foaf:Person;
                owl:inverseOf poder:hasChild.
poder:hasPhilantropySector a owl:ObjectProperty,
                             rdf:Property;
                           rdfs:comment "Sectores relationados a ONGs"@es,
                                        "Sectors related to NGOs"@en;
                           rdfs:domain poder:NonGovernmentalOrganization;
                           rdfs:label "Tiene área de filantropía"@es,
                                      "Has Philantropy Sector"@en;
                           rdfs:range poder:PhilantropySector.
poder:hasRelevantDate a owl:DatatypeProperty,
                        rdf:Property;
                      rdfs:comment "Fecha relevante a este dato (ej., fecha de publicación, última modificación, etc)"@es,
                                   "Date related to this data (e.g., release date, last modification, etc.)"@en;
                      rdfs:domain poder:RelatedData;
                      rdfs:label "Fecha relevante"@es,
                                 "Relevant date"@en;
                      rdfs:range xsd:date;
                      rdfs:subPropertyOf dcterms:coverage.
poder:hasSanctionDocumentation a owl:ObjectProperty,
                                 rdf:Property;
                               rdfs:comment "Documentos que describen sanciones legales relacionadas con este agente"@es,
                                            "Documents describing legal sanctions related to this agent"@en;
                               rdfs:label "Documentación acerca de sanciones"@es,
                                          "Documents about sanctions"@en;
                               rdfs:subPropertyOf poder:hasDocumentation.
poder:hasShortBiography a owl:ObjectProperty,
                          rdfs:Predicate;
                        rdfs:domain foaf:Agent;
                        rdfs:label "Biografía corta"@es,
                                   "Short biography"@en;
                        rdfs:range poder:ShortBiography.
poder:hasSibling a owl:SymmetricProperty,
                   owl:TransitiveProperty,
                   owl:ObjectProperty,
                   rdf:Property;
                 rdfs:comment "Describes relation where a person (object) is the sibling (i.e., they have at least one parent in common) of this person"@en,
                              "Describe la relación donde una persona (objeto) es el hermano o hermana (i.e, tienen al menos un padre en común) de esta persona"@es;
                 rdfs:domain foaf:Person;
                 rdfs:label "Hermano/a"@es,
                            "Has sibling"@en;
                 rdfs:range foaf:Person.
poder:hasSocialReason a owl:DatatypeProperty,
                        rdf:Property;
                      rdfs:comment "Un alias de una persona"@es,
                                   "An alias for a person"@en;
                      rdfs:domain foaf:Organization;
                      rdfs:label "Razón social"@es,
                                 "Name"@en;
                      rdfs:range rdfs:Literal;
                      rdfs:subPropertyOf dcterms:title.
poder:hasSource a owl:ObjectProperty,
                  rdf:Property;
                rdfs:comment "Fuente de donde se obtuvo la información acerca de una conexión"@es,
                             "Source where the information about a connection was obtained"@en;
                rdfs:domain poder:SourcedEntity;
                rdfs:label "Fuente"@es,
                           "Source"@en;
                rdfs:range foaf:Document;
                rdfs:subPropertyOf dcterms:source.
poder:hasSpouse a owl:ObjectProperty,
                  rdf:Property;
                rdfs:comment "Connexión entre dos personas que establece un matrimonio, convivencia, unión civil, relación sentimental, etc."@es,
                             "Connection between two people that establishes a marriage, domestic partnership, civil union, sentimental relationship, etc."@en;
                rdfs:domain poder:SentimentalRelationshipConnection;
                rdfs:label "Cónyuge"@es,
                           "Spouse"@en;
                rdfs:range foaf:Person;
                rdfs:subPropertyOf bio:participant.
poder:hasStudent a owl:ObjectProperty,
                   rdf:Property;
                 rdfs:comment "Persona en una conexión educacional"@es,
                              "Person involved in an Education Connection"@en;
                 rdfs:domain poder:EducationalConnection;
                 rdfs:label "Estudiante"@es,
                            "Student"@en;
                 rdfs:range foaf:Person;
                 rdfs:subPropertyOf bio:participant.
poder:hasTaxId a owl:DatatypeProperty,
                 rdf:Property;
               rdfs:comment "ID que identifica a una organización o persona para efecto de los impuestos"@es,
                            "ID that identifies an organization or person for tax purposes"@en;
               rdfs:domain foaf:Agent;
               rdfs:label "Rol Único Tributario (RUT)"@es,
                          "Tax ID"@en;
               rdfs:range rdfs:Literal;
               rdfs:subPropertyOf dcterms:identifier.
poder:hasTickerSymbol a owl:DatatypeProperty,
                        rdf:Property;
                      rdfs:domain poder:Company;
                      rdfs:label "Ticket de bolsa"@es,
                                 "Ticker symbol"@en;
                      rdfs:range rdfs:Literal.
poder:hasUrl a owl:ObjectProperty,
               rdf:Property;
             rdfs:comment "Cualquier URL relaciontada con esa organización o persona (incluyendo social media, sitios corporativos, etc)"@es,
                          "Any URL related to this organization or person (including social media, corporate sites, etc.)"@en;
             rdfs:domain foaf:Agent;
             rdfs:label "Página web"@es,
                        "Has URL"@en;
             rdfs:range foaf:Document;
             rdfs:subClassOf foaf:page.
poder:hasValue a rdfs:DatatypeProperty,
                 rdf:Property;
               rdfs:domain poder:FinancialInformation;
               rdfs:label "Valor en un reporte financiero"@es,
                          "Value in a financial information"@en;
               rdfs:range rdfs:Literal.
poder:hasWorkRole a owl:ObjectProperty,
                    rdf:Property;
                  rdfs:comment "Puesto o rol de la persona en esta connexión económica"@es,
                               "Position or role of the person in this economic connection"@en;
                  rdfs:domain poder:WorkConnection;
                  rdfs:label "Relación laboral"@es,
                             "Work role"@en;
                  rdfs:range poder:WorkRole.
poder:mergeCompany a owl:ObjectProperty,
                     rdf:Propertym;
                   rdfs:domain poder:MergeCompanyConnection;
                   rdfs:label "Compañía fusionada"@es,
                              "Merge company"@en;
                   rdfs:range poder:Company;
                   rdfs:subPropertyOf bio:participant.
poder:newsEventParticipant a owl:ObjectProperty,
                             rdf:Property;
                           rdfs:comment "Un evento noticioso que participa de esta conexión"@es,
                                        "A news event which is part of this connection"@en;
                           rdfs:domain poder:NewsEventConnection;
                           rdfs:label "Evento noticioso participante"@es,
                                      "A news event participant in this connection"@en;
                           rdfs:range poder:NewsEvent;
                           rdfs:subPropertyOf bio:participant.
poder:organizationParticipant a owl:ObjectProperty,
                                rdf:Property;
                              rdfs:comment "Una organización académica (escuela, universidad) que participa de esta conexión"@es,
                                           "An academic organization (school, university) who is part of this connection"@en;
                              rdfs:domain poder:AssociationConnection;
                              rdfs:label "Organización participante"@es,
                                         "Participant organization"@en;
                              rdfs:range foaf:Organization;
                              rdfs:subPropertyOf bio:participant.
poder:otherLastName a owl:DatatypeProperty,
                      rdf:Property;
                    rdfs:comment "Otro apellido, que no es el primero"@es,
                                 "Other last name, different from the first one"@en;
                    rdfs:domain foaf:Person;
                    rdfs:label "Otro apellido"@es,
                               "Other last name"@en;
                    rdfs:range rdfs:Literal;
                    rdfs:subPropertyOf foaf:familyName.
poder:personParticipant a owl:ObjectProperty,
                          rdf:Property;
                        rdfs:comment "Un miembro de una organización"@es,
                                     "A a member of an organization"@en;
                        rdfs:domain poder:AssociationConnection;
                        rdfs:label "Persona miembro"@es,
                                   "Member person"@en;
                        rdfs:range foaf:Person;
                        rdfs:subPropertyOf bio:participant.
poder:politicalParticipant a owl:ObjectProperty,
                             rdf:Property;
                           rdfs:comment "Una organización política que participa de esta conexión"@es,
                                        "A political organization who is part of this connection"@en;
                           rdfs:domain poder:PoliticalConnection;
                           rdfs:label "Organización política participante"@es,
                                      "Political Organizacion participant"@en;
                           rdfs:range poder:PoliticalOrganization;
                           rdfs:subPropertyOf poder:organizationParticipant.
poder:schema dcterms:abstract "Este documento describe un vocabulario para expresar información acerca de personas, y sus relaciones con organizaciones y empresas"@es,
                              "This document describes a vocabulary to express information about people and their relations with Organizations, Companies, etc."@en;
             dcterms:date "2012-05-17"^^xsd:date;
             dcterms:title "PoderVocab: Un vocabulario para Poderopedia"@es,
                           "PoderVocab: A vocabulary for Poderopedia"@en;
             a owl:Ontology;
             rdfs:label "PoderVocab: Un vocabulario para Poderopedia"@es,
                        "PoderVocab: A vocabulary for Poderopedia"@en;
             owl:versionInfo "0.8".
poder:subsidiaryCompanyOf a owl:ObjectProperty,
                            rdf:Property;
                          rdfs:comment "Relación entre empresas donde la primera es la filial de la segunda"@es,
                                       "Relation between companies where one is the subsidiary of the second"@en;
                          rdfs:domain poder:Company;
                          rdfs:label "Empresa filial de"@es,
                                     "Subsidiary company of"@en;
                          rdfs:range poder:Company.
poder:targetCompany a owl:ObjectProperty,
                      rdf:Property;
                    rdfs:domain poder:AcquisitionCompanyConnection;
                    rdfs:label "Compañía target"@es,
                               "Target company"@en;
                    rdfs:range poder:Company;
                    rdfs:subPropertyOf bio:participant.
dcterms:source a owl:DatatypeProperty,
                 rdf:Property;
               rdfs:comment "Un recurso relacionado de donde  resource from which the described resource is derived."@es,
                            "A related resource from which the described resource is derived."@en;
               rdfs:label "Fuente"@es,
                          "Source"@en.
bio:Birth a owl:Class;
          rdfs:comment "The event of a person entering into life."@en;
          rdfs:isDefinedBy bio:;
          rdfs:label "Birth"@en;
          rdfs:subClassOf bio:IndividualEvent.
bio:Death a owl:Class;
          rdfs:comment "The event of a person's life ending."@en;
          rdfs:isDefinedBy bio:;
          rdfs:label "Death"@en;
          rdfs:subClassOf bio:IndividualEvent.
bio:Event a owl:Class;
          rdfs:comment "Suceso importante en la vida de una persona, grupo u organización"@es,
                       "An event is an occurrence that brings about a change in the state of affairs for one or more people and/or other agents. Events are assumed to occur over a period of time and may not have precise start and end points."@en;
          rdfs:isDefinedBy bio:;
          rdfs:label "Evento"@es,
                     "Event"@en;
          rdfs:subClassOf poder:SourcedEntity.
bio:IndividualEvent a owl:Class;
                    rdfs:comment "A type of event that is principally about a single person, group or organization. Other agents may be involved but the event is most significant for the principal agent."@en;
                    rdfs:isDefinedBy bio:;
                    rdfs:label "Individual Event"@en;
                    rdfs:subClassOf [owl:onProperty bio:principal ; 
                                     owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                     a owl:Restriction],
                                    bio:Event.
bio:Relationship a owl:Class;
                 rdfs:comment "A particular type of connection existing between people, groups or organizations related to or having dealings with each other."@en;
                 rdfs:isDefinedBy bio:;
                 rdfs:label "Agent Relationship"@en.
bio:birth a owl:ObjectProperty,
            rdf:Property;
          rdfs:comment "An birth event associated with a person, group or organization."@en,
                       "El evento del nacimiento de una persona, grupo u organización"@es;
          rdfs:domain foaf:Agent;
          rdfs:isDefinedBy bio:;
          rdfs:label "Birth Event"@en,
                     "Nacimiento"@es;
          rdfs:range bio:Birth;
          rdfs:subPropertyOf bio:event,
                             owl:differentFrom.
bio:concludingEvent a owl:ObjectProperty,
                      rdf:Property;
                    rdfs:comment "Un evento que marca el final de un intervalo o relación"@es,
                                 "An event that marks the end of an interval and/or relationship. The event changes of the state of affairs that held during the interval. For example a period of study may be concluded by a Graduation event."@en;
                    rdfs:isDefinedBy bio:;
                    rdfs:label "Evento final"@es,
                               "Concluding Event"@en;
                    rdfs:range bio:Event.
bio:date a rdf:Property;
         rdfs:comment "La fecha cuando un evento ocurrió"@es,
                      "The date at which an event occurred."@en;
         rdfs:domain bio:Event;
         rdfs:isDefinedBy bio:;
         rdfs:label "Fecha",
                    "Date"@en;
         rdfs:subPropertyOf dc11:date.
bio:death a owl:ObjectProperty,
            rdf:Property;
          rdfs:comment "An death event associated with a person, group or organization."@en,
                       "El evento de la muerte de una persona, grupo u organización"@es;
          rdfs:domain foaf:Agent;
          rdfs:isDefinedBy bio:;
          rdfs:label "Death Event"@en,
                     "Muerte"@es;
          rdfs:range bio:Death;
          rdfs:subPropertyOf owl:differentFrom,
                             bio:event.
bio:initiatingEvent a owl:ObjectProperty,
                      rdf:Property;
                    rdfs:comment "Un evento que indica el comienzo de un intervalo o relación"@es,
                                 "An event that marks the start of an interval and/or relationship. The event contributes to and/or causes of the state of affairs that hold during the interval. For example a period of study may be initiated by an Enrolment event."@en;
                    rdfs:isDefinedBy bio:;
                    rdfs:label "Evento inicial"@es,
                               "Initiating Event"@en;
                    rdfs:range bio:Event.
bio:participant a owl:ObjectProperty,
                  rdf:Property;
                rdfs:comment "A person, group or organization that participates in a relationship for some time."@en;
                rdfs:domain bio:Relationship;
                rdfs:isDefinedBy bio:;
                rdfs:label "Participant"@en;
                rdfs:range foaf:Agent;
                rdfs:subPropertyOf owl:differentFrom;
                owl:inverseOf bio:relationship.
bio:place a rdf:Property;
          rdfs:comment "Lugar donde ocurre un evento"@es,
                       "The place at which an event occurred."@en;
          rdfs:domain bio:Event;
          rdfs:label "Lugar",
                     "Place"@en;
          rdfs:range wgspos:SpatialThing.
bio:relationship a owl:ObjectProperty,
                   rdf:Property;
                 rdfs:comment "A relationship that a person, group or organization participates in for some time."@en;
                 rdfs:domain foaf:Agent;
                 rdfs:isDefinedBy bio:;
                 rdfs:label "Relationship"@en;
                 rdfs:range bio:Relationship;
                 owl:inverseOf bio:participant.
rdfs:comment a owl:DatatypeProperty,
               rdf:Property;
             rdfs:comment "A description of the subject resource.";
             rdfs:domain rdfs:Resource;
             rdfs:label "comment";
             rdfs:range rdfs:Literal.
foaf:Agent a owl:Class;
           rdfs:comment "An agent (human or not)"@en,
                        "Un agente (humano o no)"@es;
           rdfs:label "Agente"@es,
                      "Agent"@en.
foaf:Organization a owl:Class;
                  rdfs:label "Organización"@es,
                             "Organization"@en;
                  rdfs:subClassOf foaf:Agent;
                  owl:equivalentClass org:Organization.
foaf:Person a owl:Class;
            rdfs:comment "Una persona"@es,
                         "A person"@en;
            rdfs:label "Persona"@es,
                       "Person"@en;
            rdfs:subClassOf foaf:Agent.
foaf:based_near a owl:ObjectProperty,
                  rdf:Property;
                rdfs:comment "A location that something is based near, for some broadly human notion of near.";
                rdfs:domain wgspos:SpatialThing;
                rdfs:isDefinedBy foaf:;
                rdfs:label "based near";
                rdfs:range wgspos:SpatialThing.
foaf:firstName a owl:DatatypeProperty,
                 rdf:Property;
               rdfs:comment "El primer nombre de una persona"@es,
                            "The first name of a person."@en;
               rdfs:domain foaf:Person;
               rdfs:label "Primer nombre"@es,
                          "firstName"@en;
               rdfs:range rdfs:Literal.
foaf:givenName a owl:DatatypeProperty,
                 rdf:Property;
               rdfs:comment "El nombre dado a una persona"@es,
                            "The given name of some person."@en;
               rdfs:isDefinedBy foaf:;
               rdfs:label "Otro nombre"@es,
                          "Given name"@en.
