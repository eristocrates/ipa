rdarole:productionCompanyWork <http://metadataregistry.org/uri/profile/RegAp/name> "productionCompanyWork"@en;
                              <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                              a rdf:Property;
                              rdfs:domain rdafrbr:Work;
                              rdfs:isDefinedBy <http://rdvocab.info/roles>;
                              rdfs:label "Production company (Work)"@en,
                                         "Produktionsunternehmen (Werk)"@de;
                              rdfs:subPropertyOf rdarole:productionCompany;
                              skos:definition "Eine Körperschaft, die für das finanzielle, technische und organisatorische Management einer Produktion für Bühne, Leinwand, Tonaufnahme, Fernsehen, Internetübertragung o.ä. verantwortlich ist."@de,
                                              "A corporate body that is responsible for financial, technical, and organizational management of a production for stage, screen, audio recording, television, webcast, etc."@en.
rdarole:productionDesigner <http://metadataregistry.org/uri/profile/RegAp/name> "productionDesigner"@en;
