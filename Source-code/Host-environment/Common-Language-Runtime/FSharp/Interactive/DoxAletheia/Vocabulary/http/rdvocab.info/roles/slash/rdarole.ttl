                     rdfs:label "Film director"@en,
                                "Filmregisseur "@de;
                     rdfs:subPropertyOf rdarole:director.
rdarole:filmDirectorWork <http://metadataregistry.org/uri/profile/RegAp/name> "filmDirectorWork"@en;
                         <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                         a rdf:Property;
                         rdfs:domain rdafrbr:Work;
                         rdfs:isDefinedBy <http://rdvocab.info/roles>;
                         rdfs:label "Filmregisseur (Werk)"@de,
                                    "Film director (Work)"@en;
                         rdfs:subPropertyOf rdarole:directorWork;
                         skos:definition "A director responsible for the general management and supervision of a filmed performance."@en,
                                         "Eine Person, Familie oder Körperschaft, die für das allgemeine Management und die Leitung einer verfilmten Darbietung verantwortlich ist."@de.
rdarole:filmDistributor <http://metadataregistry.org/uri/profile/RegAp/name> "filmDistributor"@en;
