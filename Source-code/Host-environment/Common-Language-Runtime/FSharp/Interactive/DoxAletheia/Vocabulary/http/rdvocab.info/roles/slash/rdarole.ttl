                  rdfs:subPropertyOf rdarole:formerOwnerItem;
                  skos:definition "Ein ehemaliger Eigentümer eines Exemplars, der dieses Exemplar jemand anderem überlassen hat. "@de,
                                  "A former owner of an item who donated that item to the another owner."@en.
rdarole:draftsman <http://metadataregistry.org/uri/profile/RegAp/name> "draftsman"@en;
                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                  a rdf:Property;
                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                  rdfs:label "Draftsman"@en,
                             "Technischer Zeichner"@de.
rdarole:draftsmanExpression <http://metadataregistry.org/uri/profile/RegAp/name> "draftsmanExpression"@en;
                            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                            a rdf:Property;
                            rdfs:domain rdafrbr:Expression;
                            rdfs:isDefinedBy <http://rdvocab.info/roles>;
                            rdfs:label "Draftsman (Expression)"@en,
                                       "Technischer Zeichner (Expression)"@de;
                            rdfs:subPropertyOf rdarole:contributor;
                            skos:definition "Eine Person, Familie oder Körperschaft, die an einer Expression eines Werkes eines Architekten, Erfinders oder ähnlichen mitwirkt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte o.ä. erstellt."@de,
                                            "A person, family, or corporate body contributing to an expression of a work by an architect, inventor, etc., by making detailed plans or drawings for buildings, ships, aircraft, machines, objects, etc."@en.
rdarole:editor <http://metadataregistry.org/uri/profile/RegAp/name> "editor"@en;
               <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
               a rdf:Property;
               rdfs:isDefinedBy <http://rdvocab.info/roles>;
               rdfs:label "Editor"@en,
                          "Herausgeber "@de.
rdarole:editorExpression <http://metadataregistry.org/uri/profile/RegAp/name> "editorExpression"@en;
                         <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                         a rdf:Property;
                         rdfs:domain rdafrbr:Expression;
                         rdfs:isDefinedBy <http://rdvocab.info/roles>;
                         rdfs:label "Editor (Expression)"@en,
                                    "Herausgeber (Expression)"@de;
                         rdfs:subPropertyOf rdarole:contributor;
                         skos:definition "A person, family, or corporate body contributing to an expression of a work by revising or elucidating the content, e.g., adding an introduction, notes, or other critical matter. An editor may also prepare an expression of a work for production, publication, or distribution. "@en,
                                         "Eine Person, Familie oder Körperschaft, die an einer Expression eines Werkes mitwirkt, indem sie den Inhalt überarbeitet oder erläutert, beispielsweise indem sie eine Einleitung oder Anmerkungen oder anderes kritisches Material hinzufügt. Ein Herausgeber kann ebenso eine Expression eines Werkes für die Produktion, die Herausgabe oder den Vertrieb vorbereiten. "@de.
rdarole:editorOfCompilation <http://metadataregistry.org/uri/profile/RegAp/name> "editorOfCompilation"@en;
                            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                            a rdf:Property;
                            rdfs:isDefinedBy <http://rdvocab.info/roles>;
                            rdfs:label "Editor of compilation"@en,
                                       "Compilation Editor"@de.
rdarole:editorOfCompilationExpression <http://metadataregistry.org/uri/profile/RegAp/name> "editorOfCompilationExpression"@en;
                                      <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                      a rdf:Property;
                                      rdfs:domain rdafrbr:Expression;
                                      rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                      rdfs:label "Editor of compilation (Expression)"@en,
                                                 "Compilation Editor "@de;
                                      rdfs:subPropertyOf rdarole:contributor;
                                      skos:definition "A person, family, or corporate body contributing to an expression of a collective or aggregate work by selecting and putting together works, or parts of works, by one or more creators. The editor of compilation may also be involved in elucidating the content, e.g., adding an introduction, notes, or other critical matter, of the compilation.  For compilations of data, information, etc., that result in new works, see Compiler."@en,
                                                      "Eine Person, Familie oder Körperschaft, die an einem gemeinschaftlichen oder gesammelten Werk mitwirken, indem sie die Werke oder Teile von Werken von einem oder mehreren Schöpfern auswählen und zusammenstellen. "@de;
                                      skos:scopeNote "For compilations of data, information, etc., that result in new works, see Compiler."@en.
rdarole:editorOfMovingImageWork <http://metadataregistry.org/uri/profile/RegAp/name> "editorOfMovingImageWork"@en;
                                <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                a rdf:Property;
                                rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                rdfs:label "Editor of moving image work"@en,
                                           "Cutter"@de.
rdarole:editorOfMovingImageWorkExpression <http://metadataregistry.org/uri/profile/RegAp/name> "editorOfMovingImageWorkExpression"@en;
                                          <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                          a rdf:Property;
                                          rdfs:domain rdafrbr:Expression;
                                          rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                          rdfs:label "Editor of moving image work (Expression)"@en,
                                                     "Cutter (Expression)"@de;
                                          rdfs:subPropertyOf rdarole:contributor;
                                          skos:definition "A person, family, or corporate body responsible for assembling, arranging, and trimming film, video, or other moving image formats, including both visual and audio aspects."@en,
                                                          "Eine Person, Familie oder Körperschaft, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist, sowohl Video- als auch Audio-Aspekte umfassend."@de.
rdarole:enactingJurisdiction <http://metadataregistry.org/uri/profile/RegAp/name> "enactingJurisdiction"@en;
                             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                             a rdf:Property;
                             rdfs:isDefinedBy <http://rdvocab.info/roles>;
                             rdfs:label "Enacting jurisdiction"@en,
                                        "Normerlassender Rechtsträger "@de.
rdarole:enactingJurisdictionWork <http://metadataregistry.org/uri/profile/RegAp/name> "enactingJurisdictionWork"@en;
                                 <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                 a rdf:Property;
                                 rdfs:domain rdafrbr:Work;
                                 rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                 rdfs:label "Enacting jurisdiction (Work)"@en,
                                            "Normerlassender Rechtsträger (Werk)"@de;
                                 rdfs:subPropertyOf rdarole:creator;
                                 skos:definition "A jurisdiction enacting a law, regulation, constitution, court rule, etc."@en,
                                                 "Ein Rechtsträger, der Gesetze, Verordnungen, eine Satzung, gerichtliche Anordnungen usw. erlassen kann. "@de.
rdarole:engraver <http://metadataregistry.org/uri/profile/RegAp/name> "engraver"@en;
                 <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                 a rdf:Property;
                 rdfs:isDefinedBy <http://rdvocab.info/roles>;
                 rdfs:label "Engraver"@en,
                            "Graveur "@de;
                 rdfs:subPropertyOf rdarole:manufacturer.
rdarole:engraverManifestation <http://metadataregistry.org/uri/profile/RegAp/name> "engraverManifestation"@en;
                              <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                              a rdf:Property;
                              rdfs:domain rdafrbr:Manifestation;
                              rdfs:isDefinedBy <http://rdvocab.info/roles>;
                              rdfs:label "Engraver (Manifestation)"@en,
                                         "Graveur (Manifestation)"@de;
                              rdfs:subPropertyOf rdarole:manufacturerManifestation;
                              skos:definition "Eine Person, Familie oder Körperschaft, die in die Produktion einer Manifestation eingebunden ist, indem sie Buchstaben, Zahlen usw. in eine Oberfläche, wie z.B. eine Holz- oder Metallplatte, die zum Drucken benutzt wird, schneidet."@de,
                                              "A person, family, or corporate body involved in manufacturing a manifestation by cutting letters, figures, etc., on a surface such as a wooden or metal plate used for printing."@en.
rdarole:etcher <http://metadataregistry.org/uri/profile/RegAp/name> "etcher"@en;
               <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
               a rdf:Property;
               rdfs:isDefinedBy <http://rdvocab.info/roles>;
               rdfs:label "Etcher"@en,
                          "Radierer "@de;
               rdfs:subPropertyOf rdarole:manufacturer.
rdarole:etcherManifestation <http://metadataregistry.org/uri/profile/RegAp/name> "etcherManifestation"@en;
                            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                            a rdf:Property;
                            rdfs:domain rdafrbr:Manifestation;
                            rdfs:isDefinedBy <http://rdvocab.info/roles>;
                            rdfs:label "Radierer (Manifestation)"@de,
                                       "Etcher (Manifestation)"@en;
                            rdfs:subPropertyOf rdarole:manufacturerManifestation;
                            skos:definition "A person, family, or corporate body involved in manufacturing a manifestation by subjecting metal, glass, or some other surface used for printing, to acid or another corrosive substance."@en,
                                            "Eine Person, Familie oder Körperschaft, die in die Produktion einer Manifestation eingebunden ist, indem sie Metall, Glas oder eine andere Oberfläche, die zum Drucken benutzt wird, mit Säure oder einer anderen ätzenden Substanz behandelt."@de.
rdarole:filmDirector <http://metadataregistry.org/uri/profile/RegAp/name> "filmDirector"@en;
                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                     a rdf:Property;
