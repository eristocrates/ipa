                                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                  a rdf:Property;
                                  rdfs:domain rdafrbr:Expression;
                                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                  rdfs:label "Musical director (Expression)"@en,
                                             "Musikalischer Leiter (Expression)"@de;
                                  rdfs:subPropertyOf rdarole:contributor;
                                  skos:definition "Eine Person, Familie oder Körperschaft, die für die Koordinierung der Arbeit des Komponisten, des Tonbearbeiters und Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung verantwortlich ist."@de,
                                                  "A person, family, or corporate body contributing to an expression of a work by coordinating the activities of the composer, the sound editor, and sound mixers for a moving image production or for a musical or dramatic presentation or entertainment."@en.
rdarole:narrator <http://metadataregistry.org/uri/profile/RegAp/name> "narrator"@en;
