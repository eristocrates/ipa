                        rdfs:label "Film distributor"@en,
                                   "Filmverleiher "@de;
                        rdfs:subPropertyOf rdarole:distributor.
rdarole:filmDistributorManifestation <http://metadataregistry.org/uri/profile/RegAp/name> "filmDistributorManifestation"@en;
                                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                     a rdf:Property;
                                     rdfs:domain rdafrbr:Manifestation;
                                     rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                     rdfs:label "Filmverleiher (Manifestation)"@de,
                                                "Film distributor (Manifestation)"@en;
                                     rdfs:subPropertyOf rdarole:distributorManifestation;
                                     skos:definition "Eine Person, Familie oder Körperschaft, die für den Vertrieb einer verfilmten Bewegtbildmanifestation an Kinos oder andere Vertriebskanäle verantwortlich ist. "@de,
                                                     "A person, family, or corporate body responsible for distributing a moving image manifestation to theatres or other distribution channels."@en.
rdarole:filmProducer <http://metadataregistry.org/uri/profile/RegAp/name> "filmProducer"@en;
                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                     a rdf:Property;
                     rdfs:isDefinedBy <http://rdvocab.info/roles>;
                     rdfs:label "Film producer"@en,
                                "Filmproduzent "@de;
                     rdfs:subPropertyOf rdarole:producer.
rdarole:filmProducerWork <http://metadataregistry.org/uri/profile/RegAp/name> "filmProducerWork"@en;
                         <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                         a rdf:Property;
                         rdfs:domain rdafrbr:Work;
                         rdfs:isDefinedBy <http://rdvocab.info/roles>;
                         rdfs:label "Film producer (Work)"@en,
                                    "Filmproduzent (Werk)"@de;
                         rdfs:subPropertyOf rdarole:producerWork;
                         skos:definition "Eine Person, Familie oder Körperschaft, die für einen Film die Verantwortung für die meisten geschäftlichen Aspekte übernimmt. Der Produzent ist hauptsächlich verantwortlich für die Geldbeschaffung, das Produktionsmanagement, die Einstellung der Kompetenzträger, die Organisation des Vertriebs, die Absicherung des kommerziellen Erfolges usw."@de,
                                         "A producer responsible for most of the business aspects of a film."@en.
rdarole:filmmakerWork <http://metadataregistry.org/uri/profile/RegAp/name> "filmmakerWork"@en;
                      <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                      a rdf:Property;
                      rdfs:domain rdafrbr:Work;
                      rdfs:isDefinedBy <http://rdvocab.info/roles>;
                      rdfs:label "Filmmaker (Work)"@en,
                                 "Filmemacher (Werk)"@de;
                      rdfs:subPropertyOf rdarole:creator;
                      skos:definition "A person, family, or corporate body responsible for creating an independent or personal film. A filmmaker is individually responsible for the conception, and execution of all aspects of the film."@en,
                                      "Eine Person, Familie oder Körperschaft, die für die Erstellung eines unabhängigen oder privaten Films verantwortlich ist. Ein Filmemacher ist individuell verantwortlich für das Konzept und die Ausführung aller Aspekte des Films."@de.
rdarole:formerOwner <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:donor,
                                                                                   rdarole:seller;
                    <http://metadataregistry.org/uri/profile/RegAp/name> "formerOwner"@en;
                    <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                    a rdf:Property;
                    rdfs:isDefinedBy <http://rdvocab.info/roles>;
                    rdfs:label "Former owner"@en,
                               "Früherer Besitzer "@de;
                    rdfs:subPropertyOf rdarole:owner.
rdarole:formerOwnerItem <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:donorItem,
                                                                                       rdarole:sellerItem;
                        <http://metadataregistry.org/uri/profile/RegAp/name> "formerOwnerItem"@en;
                        <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                        a rdf:Property;
                        rdfs:domain rdafrbr:Item;
                        rdfs:isDefinedBy <http://rdvocab.info/roles>;
                        rdfs:label "Former owner (Item)"@en,
                                   "Früherer Besitzer (Exemplar)"@de;
                        rdfs:subPropertyOf rdarole:ownerItem;
                        skos:definition "A person, family, or corporate body formerly having legal possession of an item (i.e., a specific copy or instance of a resource)."@en,
                                        "Eine Person, Familie oder Körperschaft, die früher rechtmäßiger Besitzer eines Exemplars war (d.h. einer bestimmten Kopie oder eines Exemplars einer Ressource) "@de.
rdarole:honouree <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:honoureeWork,
                                                                                rdarole:honoureeOfItem;
                 <http://metadataregistry.org/uri/profile/RegAp/name> "honouree"@en;
