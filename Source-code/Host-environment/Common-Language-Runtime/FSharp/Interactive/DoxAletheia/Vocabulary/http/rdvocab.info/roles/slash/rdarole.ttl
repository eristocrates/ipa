                           rdfs:subPropertyOf rdarole:performerExpression;
                           skos:definition "Ein Darsteller, der eine Expression eines Werkes liest oder spricht, um einen Akt, ein Geschehnis, einen Ereignisablauf usw. darzustellen. "@de,
                                           "A performer contributing to an expression of a work by reading or speaking in order to give an account of an act, occurrence, course of events, etc."@en.
rdarole:onScreenPresenter <http://metadataregistry.org/uri/profile/RegAp/name> "onScreenPresenter"@en;
                          <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
