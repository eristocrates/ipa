<http://metadataregistry.org/uri/RegStatus/1002> a skos:Concept;
                                                 skos:prefLabel "New-Proposed"@en.
<http://rdvocab.info/roles> dc11:title "RDA Roles"@en;
                            foaf:homepage <http://dublincore.org/dcmirdataskgroup/>.
rdarole:Filmmaker <http://metadataregistry.org/uri/profile/RegAp/name> "Filmmaker"@en;
                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                  a rdf:Property;
                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                  rdfs:label "Filmmaker"@en;
                  skos:definition "A person, family, or corporate body responsible for creating an independent or personal film. A filmmaker is individually responsible for the conception, and execution of all aspects of the film."@en.
rdarole:abridger <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:abridgerExpression;
                 <http://metadataregistry.org/uri/profile/RegAp/name> "abridger"@en;
                 <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                 a rdf:Property;
                 rdfs:isDefinedBy <http://rdvocab.info/roles>;
                 rdfs:label "Abridger"@en,
                            "Abridger "@de.
rdarole:abridgerExpression <http://metadataregistry.org/uri/profile/RegAp/name> "abridgerExpression"@en;
                           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                           a rdf:Property;
                           rdfs:domain rdafrbr:Expression;
                           rdfs:isDefinedBy <http://rdvocab.info/roles>;
                           rdfs:label "Abridger (Expression)"@en,
                                      "Abridger (Expression)"@de;
                           rdfs:subPropertyOf rdarole:contributor;
                           skos:definition "Eine Person, Familie oder Körperschaft, die eine Expression eines Werkes kürzt oder zusammenfasst, dabei aber das Wesen des Originalwerkes unverändert lässt. "@de,
                                           "A person, family, or corporate body contributing to an expression of a work by shortening or condensing the original work but leaving the nature and content of the original work substantially unchanged."@en.
rdarole:actor <http://metadataregistry.org/uri/profile/RegAp/name> "actor"@en;
              <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
              a rdf:Property;
              rdfs:isDefinedBy <http://rdvocab.info/roles>;
              rdfs:label "Actor"@en,
                         "Schauspieler "@de;
              rdfs:subPropertyOf rdarole:performer.
rdarole:actorExpression <http://metadataregistry.org/uri/profile/RegAp/name> "actorExpression"@en;
                        <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                        a rdf:Property;
                        rdfs:domain rdafrbr:Expression;
                        rdfs:isDefinedBy <http://rdvocab.info/roles>;
                        rdfs:label "Actor (Expression)"@en,
                                   "Schauspieler (Expression)"@de;
                        rdfs:subPropertyOf rdarole:performerExpression;
                        skos:definition "A performer contributing to an expression of a work by acting as a cast member or player in a musical or dramatic presentation, etc."@en,
                                        "Ein Darsteller, der zu einer Expression eines Werkes als Ensemble-Mitglied oder Darsteller in einer musikalischen oder dramatischen Darbietung usw. beiträgt."@de.
rdarole:addressee <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:addresseeWork;
                  <http://metadataregistry.org/uri/profile/RegAp/name> "addressee"@en;
                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                  a rdf:Property;
                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                  rdfs:label "addressee"@en,
                             "Adressat"@de.
rdarole:addresseeWork <http://metadataregistry.org/uri/profile/RegAp/name> "addresseeWork"@en;
                      <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                      a rdf:Property;
                      rdfs:domain rdafrbr:Work;
                      rdfs:isDefinedBy <http://rdvocab.info/roles>;
                      rdfs:label "Adressat (Werk)"@de,
                                 "addressee (Work)"@en;
                      rdfs:subPropertyOf rdarole:addressee;
                      skos:definition "Eine Person, Familie oder Körperschaft, an die Korrespondenz in einem Werk adressiert ist. "@de,
                                      "A person, family, or corporate body to whom the work or part of the work is addressed."@en.
rdarole:animator <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:animatorExpression;
                 <http://metadataregistry.org/uri/profile/RegAp/name> "animator"@en;
                 <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                 a rdf:Property;
                 rdfs:isDefinedBy <http://rdvocab.info/roles>;
                 rdfs:label "Animator"@en,
                            "Animator "@de.
rdarole:animatorExpression <http://metadataregistry.org/uri/profile/RegAp/name> "animatorExpression"@en;
                           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                           a rdf:Property;
                           rdfs:domain rdafrbr:Expression;
                           rdfs:isDefinedBy <http://rdvocab.info/roles>;
                           rdfs:label "Animator (Expression)"@en,
                                      "Animator (Expression)"@de;
                           rdfs:subPropertyOf rdarole:contributor;
                           skos:definition "A person, family, or corporate body contributing to an expression of a moving image work or computer program by giving apparent movement to inanimate objects or drawings."@en,
                                           "Eine Person, Familie oder Körperschaft, an die Korrespondenz in einem Werk adressiert ist. "@de.
rdarole:annotator <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:annotatorItem;
                  <http://metadataregistry.org/uri/profile/RegAp/name> "annotator"@en;
                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                  a rdf:Property;
                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                  rdfs:label "Annotator"@en,
                             "Annotator"@de.
rdarole:annotatorItem <http://metadataregistry.org/uri/profile/RegAp/name> "annotatorItem"@en;
                      <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                      a rdf:Property;
                      rdfs:domain rdafrbr:Item;
                      rdfs:isDefinedBy <http://rdvocab.info/roles>;
                      rdfs:label "Annotator (Item)"@en,
                                 "Annotator (Exemplar)"@de;
                      rdfs:subPropertyOf rdarole:annotator;
                      skos:definition "Eine Person, die handschriftlich Anmerkungen in ein spezifisches Exemplar schreibt. "@de,
                                      "A person who makes manuscript annotations on a specific item."@en.
rdarole:appellant <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:appellantWork;
                  <http://metadataregistry.org/uri/profile/RegAp/name> "appellant"@en;
                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                  a rdf:Property;
                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                  rdfs:label "Appellant"@en,
                             "Berufungskläger / Revisionskläger  "@de;
                  skos:definition "Eine natürliche oder juristische Person, die gegen ein Gerichtsurteil einer unteren Instanz Rechtsmittel (Berufung / Revision) einlegt. "@de.
rdarole:appellantWork <http://metadataregistry.org/uri/profile/RegAp/name> "appellantWork"@en;
                      <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                      a rdf:Property;
                      rdfs:domain rdafrbr:Work;
                      rdfs:isDefinedBy <http://rdvocab.info/roles>;
                      rdfs:label "Berufungskläger / Revisionskläger (Werk)"@de,
                                 "Appellant (Work)"@en;
                      rdfs:subPropertyOf rdarole:appellant;
                      skos:definition "A person or corporate body who appeals a lower court's decision."@en,
                                      "Eine natürliche oder juristische Person, die gegen ein Gerichtsurteil einer unteren Instanz Rechtsmittel (Berufung / Revision) einlegt. "@de.
rdarole:appellee <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:appelleeWork;
                 <http://metadataregistry.org/uri/profile/RegAp/name> "appellee"@en;
                 <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                 a rdf:Property;
                 rdfs:isDefinedBy <http://rdvocab.info/roles>;
                 rdfs:label "Appellee"@en,
                            "Berufungsbeklagter / Revisionsbeklagter "@de;
                 skos:definition "Eine natürliche oder juristische Person, gegen die Rechtsmittel (Berufung / Revision) eingelegt wurde. "@de.
rdarole:appelleeWork <http://metadataregistry.org/uri/profile/RegAp/name> "appelleeWork"@en;
                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                     a rdf:Property;
                     rdfs:domain rdafrbr:Work;
                     rdfs:isDefinedBy <http://rdvocab.info/roles>;
                     rdfs:label "Berufungsbeklagter / Revisionsbeklagter (Werk)"@de,
                                "Appellee (Work)"@en;
                     rdfs:subPropertyOf rdarole:appellee;
                     skos:definition "A person or corporate body against whom an appeal is taken."@en,
                                     "Eine natürliche oder juristische Person, gegen die Rechtsmittel (Berufung / Revision) eingelegt wurde. "@de.
rdarole:architect <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:landscapeArchitect;
                  <http://metadataregistry.org/uri/profile/RegAp/name> "architect"@en;
                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                  a rdf:Property;
                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                  rdfs:label "Architect"@en,
                             "Architekt"@de.
rdarole:architectWork <http://metadataregistry.org/uri/profile/RegAp/name> "architectWork"@en;
                      <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                      a rdf:Property;
                      rdfs:domain rdafrbr:Work;
                      rdfs:isDefinedBy <http://rdvocab.info/roles>;
                      rdfs:label "Architekt (Werk)"@de,
                                 "Architect (Work)"@en;
                      rdfs:subPropertyOf rdarole:creator;
                      skos:definition "Eine Person, Familie oder Körperschaft, die für eine architektonische Gestaltung verantwortlich ist, einschließlich einer bildlichen Darstellung, die zeigt, wie ein Gebäude o. ä. aussieht, wenn es fertig gebaut sein wird."@de,
                                      "A person, family, or corporate body responsible for creating an architectural design, including a pictorial representation intended to show how a building, etc., will look when completed."@en.
rdarole:arrangerOfMusic <http://metadataregistry.org/uri/profile/RegAp/name> "arrangerOfMusic"@en;
                        <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                        a rdf:Property;
                        rdfs:isDefinedBy <http://rdvocab.info/roles>;
                        rdfs:label "Arranger of music"@en,
                                   "Arrangeur"@de.
rdarole:arrangerOfMusicExpression <http://metadataregistry.org/uri/profile/RegAp/name> "arrangerOfMusicExpression"@en;
                                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                  a rdf:Property;
                                  rdfs:domain rdafrbr:Expression;
                                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                  rdfs:label "Arrangeur (Expression)"@de,
                                             "Arranger of music (Expression)"@en;
                                  rdfs:subPropertyOf rdarole:contributor;
                                  skos:definition "Eine Person, Familie oder Körperschaft, die zu einer Expression eines Musikwerkes beiträgt, indem sie eine Komposition mit einer bestimmen Originalbesetzung für eine andere Besetzung umschreibt oder das Werk für die Originalbesetzung modifiziert. Das Wesen des originären Musikstückes bleibt dabei unverändert. "@de,
                                                  "A person, family, or corporate body contributing to an expression of a musical work by rewriting the composition for a medium of performance different from that for which the work was originally intended, modifying the work for the same medium of performance, etc., such that the musical substance of the original composition remains essentially unchanged."@en.
rdarole:artDirector <http://metadataregistry.org/uri/profile/RegAp/name> "artDirector"@en;
                    <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                    a rdf:Property;
                    rdfs:isDefinedBy <http://rdvocab.info/roles>;
                    rdfs:label "Art director"@en,
                               "Art Director"@de.
rdarole:artDirectorExpression <http://metadataregistry.org/uri/profile/RegAp/name> "artDirectorExpression"@en;
                              <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                              a rdf:Property;
                              rdfs:domain rdafrbr:Expression;
                              rdfs:isDefinedBy <http://rdvocab.info/roles>;
                              rdfs:label "Art director (Expression)"@en,
                                         "Art Director (Expression)"@de;
                              rdfs:subPropertyOf rdarole:contributor;
                              skos:definition "A person, family or corporate body responsible for overseeing the artists and craftspeople who build the sets for moving image productions."@en,
                                              "Eine Person, Familie oder Körperschaft, die für die Künstler und Kunsthandwerker, die ein Set für eine Bewegtbildproduktion aufbauen, verantwortlich ist. "@de.
rdarole:artist <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:sculptor;
               <http://metadataregistry.org/uri/profile/RegAp/name> "artist"@en;
               <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
               a rdf:Property;
               rdfs:isDefinedBy <http://rdvocab.info/roles>;
               rdfs:label "Artist"@en,
                          "Künstler"@de.
rdarole:artistWork <http://metadataregistry.org/uri/profile/RegAp/name> "artistWork"@en;
                   <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                   a rdf:Property;
                   rdfs:domain rdafrbr:Work;
                   rdfs:isDefinedBy <http://rdvocab.info/roles>;
                   rdfs:label "Künstler (Werk)"@de,
                              "Artist (Work)"@en;
                   rdfs:subPropertyOf rdarole:creator;
                   skos:definition "Eine Person, Familie oder Körperschaft, die für die Idee und meist auch Umsetzung eines Werkes in Form einer Grafik, einer Zeichnung oder eines Gemäldes verantwortlich ist."@de,
                                   "A person, family, or corporate body responsible for creating a work by conceiving, and often implementing, an original graphic design, drawing, painting, etc."@en.
rdarole:author <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:screenwriter,
                                                                              rdarole:lyricist,
                                                                              rdarole:librettist;
               <http://metadataregistry.org/uri/profile/RegAp/name> "author"@en;
               <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
               a rdf:Property;
               rdfs:isDefinedBy <http://rdvocab.info/roles>;
               rdfs:label "Verfasser"@de,
                          "Author"@en;
               skos:definition "Eine Person, Familie oder Körperschaft, die verantwortlich für die Erstellung eines Werkes ist, das im Wesentlichen aus Text besteht, unabhängig vom Medientyp (gedruckter Text, gesprochenes Wort, elektronischer Text, taktiler Text usw.) oder von der Gattung (Gedichte, Romane, Drehbücher, Blogs usw.). Die Rolle wird auch für Personen verwendet, die den Charakter und den Inhalt eines Originalwerkes wesentlich durch Paraphrasieren, Umschreiben oder Adaption verändern und so ein neues Werk erschaffen, oder den Medientyp einer Expression ändern. "@de.
rdarole:authorWork <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:librettistWork,
                                                                                  rdarole:screenwriterWork,
                                                                                  rdarole:lyricistWork;
                   <http://metadataregistry.org/uri/profile/RegAp/name> "authorWork"@en;
                   <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                   a rdf:Property;
                   rdfs:domain rdafrbr:Work;
                   rdfs:isDefinedBy <http://rdvocab.info/roles>;
                   rdfs:label "Author (Work)"@en,
                              "Verfasser (Werk)"@de;
                   rdfs:subPropertyOf rdarole:creator;
                   skos:definition "Eine Person, Familie oder Körperschaft, die verantwortlich für die Erstellung eines Werkes ist, das im Wesentlichen aus Text besteht, unabhängig vom Medientyp (gedruckter Text, gesprochenes Wort, elektronischer Text, taktiler Text usw.) oder von der Gattung (Gedichte, Romane, Drehbücher, Blogs usw.). Die Rolle wird auch für Personen verwendet, die den Charakter und den Inhalt eines Originalwerkes wesentlich durch Paraphrasieren, Umschreiben oder Adaption verändern und so ein neues Werk erschaffen, oder den Medientyp einer Expression ändern."@de,
                                   "A person, family, or corporate body responsible for creating a work that is primarily textual in content, regardless of media type (e.g., printed text, spoken word, electronic text, tactile text) or genre (e.g., poems, novels, screenplays, blogs). Use also for persons, etc., creating a new work by paraphrasing, rewriting, or adapting works by another creator such that the modification has substantially changed the nature and content of the original or changed the medium of expression."@en.
rdarole:autographer <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:autographerItem;
                    <http://metadataregistry.org/uri/profile/RegAp/name> "autographer"@en;
                    <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                    a rdf:Property;
                    rdfs:isDefinedBy <http://rdvocab.info/roles>;
                    rdfs:label "Autographer"@en,
                               "Unterzeichner"@de.
rdarole:autographerItem <http://metadataregistry.org/uri/profile/RegAp/name> "autographerItem"@en;
                        <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                        a rdf:Property;
                        rdfs:domain rdafrbr:Item;
                        rdfs:isDefinedBy <http://rdvocab.info/roles>;
                        rdfs:label "Unterzeichner (Exemplar)"@de,
                                   "Autographer (item)"@en;
                        rdfs:subPropertyOf rdarole:autographer;
                        skos:definition "Eine Person, deren handschriftliche Unterschrift auf einem Exemplar steht."@de,
                                        "A person whose manuscript signature appears on an item."@en.
rdarole:binder <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:binderItem;
               <http://metadataregistry.org/uri/profile/RegAp/name> "binder"@en;
               <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
               a rdf:Property;
               rdfs:isDefinedBy <http://rdvocab.info/roles>;
               rdfs:label "Binder"@en,
                          "Buchbinder "@de;
               skos:definition "Eine Person, die ein Exemplar bindet. "@de.
rdarole:binderItem <http://metadataregistry.org/uri/profile/RegAp/name> "binderItem"@en;
                   <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                   a rdf:Property;
                   rdfs:domain rdafrbr:Item;
                   rdfs:isDefinedBy <http://rdvocab.info/roles>;
                   rdfs:label "Eine Person, die ein Exemplar bindet. "@de,
                              "Buchbinder (Exemplar)"@de,
                              "Binder (Item)"@en;
                   rdfs:subPropertyOf rdarole:binder;
                   skos:definition "A person who binds a specific item."@en.
rdarole:bookDesigner <http://metadataregistry.org/uri/profile/RegAp/name> "bookDesigner"@en;
                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                     a rdf:Property;
                     rdfs:isDefinedBy <http://rdvocab.info/roles>;
                     rdfs:label "Book designer"@en,
                                "Buchgestalter"@de;
                     rdfs:subPropertyOf rdarole:manufacturer.
rdarole:bookDesignerManifestation <http://metadataregistry.org/uri/profile/RegAp/name> "bookDesignerManifestation"@en;
                                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                  a rdf:Property;
                                  rdfs:domain rdafrbr:Manifestation;
                                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                  rdfs:label "Buchgestalter (Manifestation)"@de,
                                             "Book designer (Manifestation)"@en;
                                  rdfs:subPropertyOf rdarole:manufacturerManifestation;
                                  skos:definition "Eine Person, Familie oder Körperschaft, die für das gesamte grafische Design eines Buches verantwortlich ist, einschließlich Schriftbild, Bildgestaltung, Materialwahl und der angewandten Verfahren."@de,
                                                  "A person, family, or corporate body involved in manufacturing a manifestation by being responsible for the entire graphic design of a book, including arrangement of type and illustration, choice of materials, and process used."@en.
rdarole:brailleEmbosser <http://metadataregistry.org/uri/profile/RegAp/name> "brailleEmbosser"@en;
                        <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                        a rdf:Property;
                        rdfs:isDefinedBy <http://rdvocab.info/roles>;
                        rdfs:label "Braille embosser"@en,
                                   "Brailleschriftpräger "@de;
                        rdfs:subPropertyOf rdarole:manufacturer.
rdarole:brailleEmbosserManifestation <http://metadataregistry.org/uri/profile/RegAp/name> "brailleEmbosserManifestation"@en;
                                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                     a rdf:Property;
                                     rdfs:domain rdafrbr:Manifestation;
                                     rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                     rdfs:label "Brailleschriftpräger (Manifestation)"@de,
                                                "Braille embosser (Manifestation)"@en;
                                     rdfs:subPropertyOf rdarole:manufacturerManifestation;
                                     skos:definition "Eine Person, Familie oder Körperschaft, die im Herstellungsprozess einer Manifestation in Form von Braillezeichen involviert ist. Für das Prägen wird ein Griffel, ein spezieller Brailledrucker oder ein anderes Gerät verwendet."@de,
                                                     "A person, family, or corporate body involved in producing a manifestation by embossing Braille cells using a stylus, special embossing printer, or other device."@en.
rdarole:broadcaster <http://metadataregistry.org/uri/profile/RegAp/name> "broadcaster"@en;
                    <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                    a rdf:Property;
                    rdfs:isDefinedBy <http://rdvocab.info/roles>;
                    rdfs:label "Broadcaster"@en,
                               "Broadcaster"@de;
                    rdfs:subPropertyOf rdarole:publisher;
                    skos:definition "Eine Person, eine Familie oder eine Körperschaft, die für Ausstrahlung einer Manifestation über Hörfunk, Fernsehen oder Webcast usw. verantwortlich ist."@de.
rdarole:broadcasterManifestation <http://metadataregistry.org/uri/profile/RegAp/name> "broadcasterManifestation"@en;
                                 <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                 a rdf:Property;
                                 rdfs:domain rdafrbr:Manifestation;
                                 rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                 rdfs:label "Broadcaster (Manifestation)"@en,
                                            "Broadcaster (Manifestation)"@de;
                                 rdfs:subPropertyOf rdarole:publisherManifestation;
                                 skos:definition "A person, family, or corporate body responsible for broadcasting a manifestation to an audience via radio, television, webcast, etc."@en,
                                                 "Eine Person, eine Familie oder eine Körperschaft, die für Ausstrahlung einer Manifestation über Hörfunk, Fernsehen oder Webcast usw. verantwortlich ist."@de.
rdarole:cartographer <http://metadataregistry.org/uri/profile/RegAp/name> "cartographer"@en;
                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                     a rdf:Property;
                     rdfs:isDefinedBy <http://rdvocab.info/roles>;
                     rdfs:label "Cartographer"@en,
                                "Kartograf "@de.
rdarole:cartographerWork <http://metadataregistry.org/uri/profile/RegAp/name> "cartographerWork"@en;
                         <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                         a rdf:Property;
                         rdfs:domain rdafrbr:Work;
                         rdfs:isDefinedBy <http://rdvocab.info/roles>;
                         rdfs:label "Kartograf (Werk)"@de,
                                    "Cartographer (Work)"@en;
                         rdfs:subPropertyOf rdarole:creator;
                         skos:definition "A person, family, or corporate body responsible for creating a map, atlase, globe, or other cartographic work."@en,
                                         "Eine Person, Familie oder Körperschaft, die für das Erstellen einer Karte, eines Atlasses, eines Globusses oder eines anderen kartografischen Werkes verantwortlich ist."@de.
rdarole:caster <http://metadataregistry.org/uri/profile/RegAp/name> "caster"@en;
               <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
               a rdf:Property;
               rdfs:isDefinedBy <http://rdvocab.info/roles>;
               rdfs:label "Caster"@en,
                          "Formgießer "@de;
               rdfs:subPropertyOf rdarole:manufacturer.
rdarole:casterManifestation <http://metadataregistry.org/uri/profile/RegAp/name> "casterManifestation"@en;
                            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                            a rdf:Property;
                            rdfs:domain rdafrbr:Manifestation;
                            rdfs:isDefinedBy <http://rdvocab.info/roles>;
                            rdfs:label "Formgießer (Manifestation)"@de,
                                       "Caster (Manifestation)"@en;
                            rdfs:subPropertyOf rdarole:manufacturerManifestation;
                            skos:definition """Eine Person, Familie oder Körperschaft, die in den Herstellungsprozess einer Manifestation durch das Gießen einer Flüssigkeit oder einer geschmolzenen Substanz in eine Form involviert ist.
Die Substanz verbleibt in der Gießform, bis sie ausgehärtet ist. """@de,
                                            "A person, family, or corporate body involved in producing a manifestation by pouring a liquid or molten substance into a mold and leaving it to solidify to take the shape of the mold."@en.
rdarole:choreographer <http://metadataregistry.org/uri/profile/RegAp/name> "choreographer"@en;
                      <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                      a rdf:Property;
                      rdfs:isDefinedBy <http://rdvocab.info/roles>;
                      rdfs:label "Choreographer "@en,
                                 "Choreograf "@de.
rdarole:choreographerExpression <http://metadataregistry.org/uri/profile/RegAp/name> "choreographerExpression"@en;
                                <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                a rdf:Property;
                                rdfs:domain rdafrbr:Expression;
                                rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                rdfs:label "Choreographer (Expression)"@en,
                                           "Choreograph (Expression)"@de;
                                rdfs:subPropertyOf rdarole:contributor;
                                skos:definition "Eine Person, Familie oder Körperschaft, die für ein aus Bewegung bestehendes Werk verantwortlich ist. "@de,
                                                "A person, family, or corporate body contributing to an expression of a work by providing additional choreography, or by modifying the previous choreography."@en.
rdarole:choreographerWork <http://metadataregistry.org/uri/profile/RegAp/name> "choreographerWork"@en;
                          <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                          a rdf:Property;
                          rdfs:domain rdafrbr:Work;
                          rdfs:isDefinedBy <http://rdvocab.info/roles>;
                          rdfs:label "Choreograf (Werk)"@de,
                                     "Choreographer (Work)"@en;
                          rdfs:subPropertyOf rdarole:creator;
                          skos:definition "A person, family, or corporate body responsible for creating a work of movement."@en,
                                          "Eine Person, Familie oder Körperschaft, die für ein aus Bewegung bestehendes Werk verantwortlich ist. "@de.
rdarole:cinematographer <http://metadataregistry.org/uri/profile/RegAp/name> "cinematographer"@en;
                        <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                        a rdf:Property;
                        rdfs:isDefinedBy <http://rdvocab.info/roles>;
                        rdfs:label "Cinematographer"@en,
                                   "Kameramann"@de;
                        skos:definition "A person, family, or corporate body contributing to an expression of a moving image work by capturing images either electronically or on film or video stock using a visual recording device, and often the selection and arrangement of lighting. The chief cinematographer for a movie is also called the director of photography. Use this designation also for videographers."@en,
                                        """Eine Person, eine Familie oder eine Körperschaft, die zu einer Expression eines Bewegtbildwerkes  beiträgt, indem sie die Bilder mit einem Aufzeichnungsgerät aufnimmt, entweder in elektronischer Form oder auf Film oder Video. Häufig gehört auch die Auswahl der Bilder und die Beleuchtung dazu. Der leitende Kameramann wird auch verantwortlicher Kameramann genannt. Die Bezeichnung „Kameramann\" wird auch für einen Videografen verwendet."""@de.
rdarole:collectionRegistrar <http://metadataregistry.org/uri/profile/RegAp/name> "collectionRegistrar"@en;
                            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                            a rdf:Property;
                            rdfs:isDefinedBy <http://rdvocab.info/roles>;
                            rdfs:label "Collection registrar"@en,
                                       "Registrar "@de;
                            rdfs:subPropertyOf rdarole:curator.
rdarole:collectionRegistrarItem <http://metadataregistry.org/uri/profile/RegAp/name> "collectionRegistrarItem"@en;
                                <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                a rdf:Property;
                                rdfs:domain rdafrbr:Item;
                                rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                rdfs:label "Collection registrar (Item)"@en,
                                           "Registrar (Exemplar)"@de;
                                skos:definition "A type of curator who lists or inventories the items in an aggregate work such as a collection of items or works."@en,
                                                "Jemand, der die Exemplare eines zusammengestellten Werkes, wie beispielsweise eine Sammlung von Exemplaren oder Werken, verzeichnet und inventarisiert."@de.
rdarole:collector <http://metadataregistry.org/uri/profile/RegAp/name> "collector"@en;
                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                  a rdf:Property;
                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                  rdfs:label "Collector"@en,
                             "Sammler"@de;
                  rdfs:subPropertyOf rdarole:curator.
rdarole:collectorItem <http://metadataregistry.org/uri/profile/RegAp/name> "collectorItem"@en;
                      <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                      a rdf:Property;
                      rdfs:domain rdafrbr:Item;
                      rdfs:isDefinedBy <http://rdvocab.info/roles>;
                      rdfs:label "Collector (Item)"@en,
                                 "Sammler (Exemplar)"@de;
                      skos:definition "A curator who brings together material from various sources that are then arranged, described, and cataloged as a collection."@en,
                                      "Jemand, der Materialien aus unterschiedlichen Quellen zusammenträgt, die zu einer Sammlung zusammengestellt, beschrieben und katalogisiert werden."@de.
rdarole:collotyper <http://metadataregistry.org/uri/profile/RegAp/name> "collotyper"@en;
                   <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                   a rdf:Property;
                   rdfs:isDefinedBy <http://rdvocab.info/roles>;
                   rdfs:label "Collotyper"@en,
                              "Drucker (im Lichtdruckverfahren) "@de;
                   rdfs:subPropertyOf rdarole:manufacturer.
rdarole:collotyperManifestation <http://metadataregistry.org/uri/profile/RegAp/name> "collotyperManifestation"@en;
                                <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                a rdf:Property;
                                rdfs:domain rdafrbr:Manifestation;
                                rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                rdfs:label "Drucker (im Lichtdruckverfahren) (Manifestation)"@de,
                                           "Collotyper (Manifestation)"@en;
                                rdfs:subPropertyOf rdarole:manufacturerManifestation;
                                skos:definition "Eine Person, Familie oder Körperschaft, die an der Produktion einer Manifestation aus Fotodrucken von Film oder einem anderem Kolloiden, der Druckerfarbe anziehende und abstoßende Flächen aufweist, beteiligt ist."@de,
                                                "A person, family, or corporate body involved in producing a manifestation of photographic prints from film or other colloid that has ink-receptive and ink-repellent surfaces."@en.
rdarole:commentator <http://metadataregistry.org/uri/profile/RegAp/name> "commentator"@en;
                    <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                    a rdf:Property;
                    rdfs:isDefinedBy <http://rdvocab.info/roles>;
                    rdfs:label "Commentator"@en,
                               "Kommentator (mündlich) "@de;
                    rdfs:subPropertyOf rdarole:performer.
rdarole:commentatorExpression <http://metadataregistry.org/uri/profile/RegAp/name> "commentatorExpression"@en;
                              <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                              a rdf:Property;
                              rdfs:domain rdafrbr:Expression;
                              rdfs:isDefinedBy <http://rdvocab.info/roles>;
                              rdfs:label "Commentator (Expression)"@en,
                                         "Kommentator (mündlich) (Expression)"@de;
                              skos:definition "A performer contributing to an expression of a work by providing interpretation, analysis, or a discussion of the subject matter on a recording, film, or other audiovisual medium."@en,
                                              "Jemand, der zu einer Expression eines Werkes in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium in Form einer Interpretation, einer Analyse oder einer Diskussion des Themas beiträgt."@de.
rdarole:compiler <http://metadataregistry.org/uri/profile/RegAp/name> "compiler"@en;
                 <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                 a rdf:Property;
                 rdfs:isDefinedBy <http://rdvocab.info/roles>;
                 rdfs:label "Compiler"@en,
                            "Compiler "@de.
rdarole:compilerWork <http://metadataregistry.org/uri/profile/RegAp/name> "compilerWork"@en;
                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                     a rdf:Property;
                     rdfs:domain rdafrbr:Work;
                     rdfs:isDefinedBy <http://rdvocab.info/roles>;
                     rdfs:label "Compiler (Werk)"@de,
                                "Compiler (Work)"@en;
                     rdfs:subPropertyOf rdarole:creator;
                     skos:definition "Eine Person, Familie oder Körperschaft, die für das Erstellen eines Werkes durch eine Zusammenstellung verantwortlich ist, beispielsweise durch Selektieren, Gliedern, Zusammenstellen und Editieren von Daten, Information, usw. "@de,
                                     "A person, family, or corporate body responsible for creating a new work (e.g., a bibliography, a directory) through the act of compilation, e.g., selecting, arranging, aggregating, and editing data, information, etc."@en.
rdarole:composer <http://metadataregistry.org/uri/profile/RegAp/name> "composer"@en;
                 <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                 a rdf:Property;
                 rdfs:isDefinedBy <http://rdvocab.info/roles>;
                 rdfs:label "Composer"@en,
                            "Komponist "@de.
rdarole:composerExpression <http://metadataregistry.org/uri/profile/RegAp/name> "composerExpression"@en;
                           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                           a rdf:Property;
                           rdfs:domain rdafrbr:Expression;
                           rdfs:isDefinedBy <http://rdvocab.info/roles>;
                           rdfs:label "Composer (Expression)"@en,
                                      "Komponist (Expression)"@de;
                           rdfs:subPropertyOf rdarole:contributor;
                           skos:definition "Eine Person, Familie oder Körperschaft, die zu einer Expression eines Werkes beiträgt, indem sie als Ersatz für die Originalmusik neue Musik komponiert oder neue Musik komponiert, die die existierende Musik ergänzt."@de,
                                           "A person, family, or corporate body contributing to an expression by composing new music to substitute for the original music, or by composing new music to supplement the existing music."@en.
rdarole:composerOfAdditionalMusic <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:composerOfAdditionalMusicExpression;
                                  <http://metadataregistry.org/uri/profile/RegAp/name> "composerOfAdditionalMusic"@en;
                                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                  a rdf:Property;
                                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                  rdfs:label "Composer of Additional Music"@en,
                                             "Komponist eines zusätzlichen Musikstückes "@de;
                                  skos:definition "A person, family, or corporate body contributing to an expression of a musical work by composing accompaniments or additional parts (e.g., vocal/instrumental parts, musical numbers) that supplement the music written by the original composer."@en,
                                                  "Eine Person, Familie oder Körperschaft, die zu einer Expression eines Musikwerkes durch Begleitkompositionen oder Zusätze (wie zusätzliche Parts für Stimmen/Instrumente oder weitere Musikstücke) beiträgt, welche die Musik des ursprünglichen Komponisten ergänzen."@de.
rdarole:composerOfAdditionalMusicExpression <http://metadataregistry.org/uri/profile/RegAp/name> "composerOfAdditionalMusicExpression"@en;
                                            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                            a rdf:Property;
                                            rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                            rdfs:label "Composer of Additional Music (Expression)"@en;
                                            rdfs:subPropertyOf rdarole:composerOfAdditionalMusic;
                                            skos:definition "A person, family, or corporate body contributing to an expression of a musical work by composing accompaniments or additional parts (e.g., vocal/instrumental parts, musical numbers) that supplement the music written by the original composer. "@en.
rdarole:composerOfIncidentalMusic <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:composerOfIncidentalMusicExpression;
                                  <http://metadataregistry.org/uri/profile/RegAp/name> "composerOfIncidentalMusic"@en;
                                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                  a rdf:Property;
                                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                  rdfs:label "Composer of Incidental Music"@en,
                                             "Komponist von Begleitmusik "@de;
                                  skos:definition "A person, family, or corporate body contributing to an expression of a work by composing music for a pre-existing, usually textual, work."@en,
                                                  "Eine Person, Familie oder Körperschaft, die zu einer Expression eines Werkes durch die Komposition von Musik für ein bereits bestehendes, meist textliches, Werk beiträgt."@de.
rdarole:composerOfIncidentalMusicExpression <http://metadataregistry.org/uri/profile/RegAp/name> "composerOfIncidentalMusicExpression"@en;
                                            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                            a rdf:Property;
                                            rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                            rdfs:label "Composer of Incidental Music (Expression)"@en;
                                            rdfs:subPropertyOf rdarole:composerOfIncidentalMusic;
                                            skos:definition "A person, family, or corporate body contributing to an expression of a work by composing music for a pre-existing, usually textual, work. "@en.
rdarole:composerOfMusicForSilentFilm <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:composerOfMusicForSilentFilmExpression;
                                     <http://metadataregistry.org/uri/profile/RegAp/name> "composerOfMusicForSilentFilm"@en;
                                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                     a rdf:Property;
                                     rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                     rdfs:label "Composer of Music for Silent Film"@en,
                                                "Komponist von Stummfilm-Musik "@de;
                                     skos:definition "A person, family, or corporate body responsible for contributing compositions to accompany the presentation of a moving image work produced in the silent film era and recorded without a synchronized, integrated soundtrack. These musical works may be originally written for the moving image or may consist of or incorporate pre-existing works in a manner that is intended to complement the moving image."@en,
                                                     "Eine Person, Familie oder Körperschaft, die für Kompositionen zur Begleitung von Bewegtbildwerken aus der Stummfilmzeit, die ohne synchronisierten und integrierten Ton aufgenommen wurden, verantwortlich ist. Diese Musikwerke können entweder eigens für das bewegte Bild geschrieben sein oder aber aus bereits existierenden Werken bestehen bzw. sich zusammensetzen, die vorgesehen sind, das bewegte Bild zu ergänzen."@de.
rdarole:composerOfMusicForSilentFilmExpression <http://metadataregistry.org/uri/profile/RegAp/name> "composerOfMusicForSilentFilmExpression"@en;
                                               <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                               a rdf:Property;
                                               rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                               rdfs:label "Composer of Music for Silent Film (Expression)"@en;
                                               rdfs:subPropertyOf rdarole:composerOfMusicForSilentFilm;
                                               skos:definition "A person, family, or corporate body responsible for contributing compositions to accompany the presentation of a moving image work produced in the silent film era and recorded without a synchronized, integrated soundtrack. These musical works may be originally written for the moving image or may consist of or incorporate pre-existing works in a manner that is intended to complement the moving image. "@en.
rdarole:composerOfMusicForSoundFilm <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:composerOfMusicForSoundFilmExpression;
                                    <http://metadataregistry.org/uri/profile/RegAp/name> "composerOfMusicForSoundFilm"@en;
                                    <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                    a rdf:Property;
                                    rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                    rdfs:label "Composer of Music for Sound Film"@en,
                                               "Filmkomponist "@de;
                                    skos:definition "A person, family, or corporate body responsible for contributing compositions that form part of the presentation of a moving image work recorded with a synchronized, integrated soundtrack. These musical works may be originally written for the moving image or be pre-existing works that are incorporated into the moving image soundtrack."@en,
                                                    "Eine Person, Familie oder Körperschaft, die für Kompositionen verantwortlich ist, die einen Teil eines Bewegtbildwerkes  bilden, das mit synchronisiertem und integriertem Ton aufgenommen wurde. Diese Musikwerke können entweder eigens für das bewegte Bild geschriebene oder bereits bestehende Werke sein, die in den Bewegtbildsoundtrack eingebunden wurden."@de.
rdarole:composerOfMusicForSoundFilmExpression <http://metadataregistry.org/uri/profile/RegAp/name> "composerOfMusicForSoundFilmExpression"@en;
                                              <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                              a rdf:Property;
                                              rdfs:isDefinedBy <http://rdvocab.info/roles>;
                                              rdfs:label "Composer of Music for Sound Film (Expression)"@en,
                                                         "Filmkomponist (Expression)"@de;
                                              rdfs:subPropertyOf rdarole:composerOfMusicForSoundFilm;
                                              skos:definition "A person, family, or corporate body responsible for contributing compositions that form part of the presentation of a moving image work recorded with a synchronized, integrated soundtrack. These musical works may be originally written for the moving image or be pre-existing works that are incorporated into the moving image soundtrack."@en,
                                                              "Eine Person, Familie oder Körperschaft, die für Kompositionen verantwortlich ist, die einen Teil eines Bewegtbildwerkes  bilden, das mit synchronisiertem und integriertem Ton aufgenommen wurde. Diese Musikwerke können entweder eigens für das bewegte Bild geschriebene oder bereits bestehende Werke sein, die in den Bewegtbildsoundtrack eingebunden wurden."@de.
rdarole:composerWork <http://metadataregistry.org/uri/profile/RegAp/name> "composerWork"@en;
                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                     a rdf:Property;
                     rdfs:domain rdafrbr:Work;
                     rdfs:isDefinedBy <http://rdvocab.info/roles>;
                     rdfs:label "Composer (Work)"@en,
                                "Komponist (Werk)"@de;
                     rdfs:subPropertyOf rdarole:creator;
                     skos:definition "A person, family, or corporate body responsible for creating a musical work. Use also for persons, etc., adapting another musical work to form a distinct alteration (e.g., free transcription), paraphrasing a work or creating a work in the general style of another composer, or creating a work that is based on the music of another composer (e.g., variations on a theme)."@en,
                                     """
	Eine Person, Familie oder Körperschaft, die für ein Musikwerk verantwortlich ist. Die Bezeichnung wird auch für Personen usw. verwendet, die ein anderes Musikwerk adaptiert haben, das sich deutlich vom Original unterscheidet, beispielsweise eine freie Bearbeitung. Oder die ein Werk im Stil eines anderen Komponisten umgeschrieben oder erschaffen hat oder ein Werk, das auf der Musik eines anderen Komponisten basiert, wie beispielsweise Variationen eines Themas. """@de.
rdarole:conductor <http://metadataregistry.org/uri/profile/RegAp/name> "conductor"@en;
                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                  a rdf:Property;
                  rdfs:isDefinedBy <http://rdvocab.info/roles>;
                  rdfs:label "Conductor"@en,
                             "Dirigent "@de;
                  rdfs:subPropertyOf rdarole:performer.
rdarole:conductorExpression <http://metadataregistry.org/uri/profile/RegAp/name> "conductorExpression"@en;
                            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                            a rdf:Property;
                            rdfs:domain rdafrbr:Expression;
