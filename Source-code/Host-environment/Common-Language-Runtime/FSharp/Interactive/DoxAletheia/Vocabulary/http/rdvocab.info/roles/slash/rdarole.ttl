                 a rdf:Property;
                 rdfs:isDefinedBy <http://rdvocab.info/roles>;
                 rdfs:label "Honouree"@en,
                            "Gefeierte Person"@de.
rdarole:honoureeOfItem <http://metadataregistry.org/uri/profile/RegAp/name> "honoureeOfItem"@en;
                       <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                       a rdf:Property;
                       rdfs:domain rdafrbr:Item;
                       rdfs:isDefinedBy <http://rdvocab.info/roles>;
                       rdfs:label "Honouree of item"@en,
                                  "Mit einem Exemplar geehrte Person."@de;
                       rdfs:subPropertyOf rdarole:honouree;
                       skos:definition "A person, family, or corporate body honoured by an item, e.g., a person to whom a copy is presented."@en,
                                       "Eine Person, Familie oder Körperschaft, die durch ein Exemplar geehrt wird, z.B. die Person, der ein Exemplar gewidmet wird. "@de.
rdarole:honoureeWork <http://metadataregistry.org/uri/profile/RegAp/name> "honoureeWork"@en;
                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                     a rdf:Property;
                     rdfs:domain rdafrbr:Work;
                     rdfs:isDefinedBy <http://rdvocab.info/roles>;
                     rdfs:label "Honouree (Work)"@en,
                                "Gefeierte Person (Werk)"@de;
                     rdfs:subPropertyOf rdarole:honouree;
                     skos:definition "Eine Person, Familie oder Körperschaft, die durch ein Werk geehrt wird, z.B. die mit einer Festschrift gefeierte Person. "@de,
                                     "A person, family, or corporate body honoured by a work, e.g., the honouree of a festschrift."@en.
rdarole:host <http://metadataregistry.org/uri/profile/RegAp/name> "host"@en;
             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
             a rdf:Property;
             rdfs:isDefinedBy <http://rdvocab.info/roles>;
             rdfs:label "Host"@en,
                        "Gastgeber "@de;
             rdfs:subPropertyOf rdarole:performer.
rdarole:hostExpression <http://metadataregistry.org/uri/profile/RegAp/name> "hostExpression"@en;
                       <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                       a rdf:Property;
                       rdfs:domain rdafrbr:Expression;
                       rdfs:isDefinedBy <http://rdvocab.info/roles>;
                       rdfs:label "Host (Expression)"@en,
                                  "Gastgeber (Expression)"@de;
                       skos:definition "A performer contributing to an expression of a work by leading a program (often broadcast) that includes other guests, performers, etc. (e.g., talk show host)."@en,
                                       "Ein Darsteller, der an einer Expression eines Werkes mitwirkt, indem er ein Programm leitet, häufig im Rundfunk, an dem auch andere Gäste, Darsteller usw. teilnehmen (z.B. der Gastgeber einer Talkshow)."@de.
rdarole:hostInstitution <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:hostInstitutionWork;
                        <http://metadataregistry.org/uri/profile/RegAp/name> "hostInstitution"@en;
                        <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                        a rdf:Property;
                        rdfs:isDefinedBy <http://rdvocab.info/roles>;
                        rdfs:label "Host institution"@en,
                                   "Veranstalter "@de.
rdarole:hostInstitutionWork <http://metadataregistry.org/uri/profile/RegAp/name> "hostInstitutionWork"@en;
                            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                            a rdf:Property;
                            rdfs:domain rdafrbr:Work;
                            rdfs:isDefinedBy <http://rdvocab.info/roles>;
                            rdfs:label "Veranstalter (Werk)"@de,
                                       "Host institution (Work)"@en;
                            rdfs:subPropertyOf rdarole:hostInstitution;
                            skos:definition "A corporate body hosting an event, exhibit, conference, etc., which gave rise to the work, but having little or no responsibility for the content of the work."@en,
                                            "Eine Körperschaft, die eine Veranstaltung, eine Ausstellung, einen Kongress usw. ausrichtet, die/der ein Werk zur Folge hat, die aber für den Inhalt des Werkes wenig oder gar keine Verantwortung für trägt."@de.
rdarole:illuminator <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:illuminatorItem;
                    <http://metadataregistry.org/uri/profile/RegAp/name> "illuminator"@en;
