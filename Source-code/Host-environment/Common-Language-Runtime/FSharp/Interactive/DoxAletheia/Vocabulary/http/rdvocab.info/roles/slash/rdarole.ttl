                               rdfs:subPropertyOf rdarole:directorWork;
                               skos:definition "A director responsible for the general management and supervision of a television program."@en,
                                               "Eine Person, Familie oder Körperschaft, die für das allgemeine Management und die Leitung eines Fernsehprogramms verantwortlich ist."@de.
rdarole:televisionProducer <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarole:televisionProducerWork;
