<http://taxref.mnhn.fr/lod/property/habitat> <http://purl.org/dc/terms/description> "Relates a taxon to an habitat in which it lives"@en;
                                             a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                             rdfs:isDefinedBy taxref-ld:taxref-ld;
                                             rdfs:label "has habitat"@en;
                                             rdfs:seeAlso <http://lod.taxonconcept.org/ontology/txn.owl#habitat>,
                                                          <http://rs.tdwg.org/dwc/iri/habitat>,
                                                          <http://purl.obolibrary.org/obo/RO_0002303>;
                                             <http://www.w3.org/2002/07/owl#equivalentProperty> <http://www.wikidata.org/prop/direct/P2974>.
<http://taxref.mnhn.fr/lod/property/hasAuthority> <http://purl.org/dc/terms/description> "Provides the authorship information of a scientific name"@en;
                                                  a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                                  rdfs:comment "TDWG ontology's property http://rs.tdwg.org/ontology/voc/TaxonName#authorship is preferably associated with a scientific name (http://rs.tdwg.org/ontology/voc/TaxonName#TaxonName), which is in line with TAXREF-LD's modelling. By contrast, DwC's scientificNameAuthorship property is associated with a taxon (dwc:Taxon), and its object shoud be a literal (DwC does not have a class for taxon names). Therefore, TAXREF-LD's hasAuthority property is not equivalent to the latter."@en;
                                                  rdfs:isDefinedBy taxref-ld:taxref-ld;
                                                  rdfs:label "has scientific name authority"@en;
                                                  rdfs:seeAlso <http://rs.tdwg.org/dwc/terms/scientificNameAuthorship>;
                                                  <http://www.w3.org/2002/07/owl#equivalentProperty> <http://rs.tdwg.org/ontology/voc/TaxonName#authorship>,
                                                                                                     <http://lod.taxonconcept.org/ontology/txn.owl#authority>.
<http://taxref.mnhn.fr/lod/property/hasBiologicalStage> <http://purl.org/dc/terms/description> "Gives the biological stage of a biologic individual (member of a taxon class)"@en;
                                                        a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                        rdfs:isDefinedBy taxref-ld:taxref-ld;
                                                        rdfs:label "has biological stage"@en;
                                                        <http://www.w3.org/2002/07/owl#equivalentProperty> <http://www.wikidata.org/prop/direct/P4774>.
<http://taxref.mnhn.fr/lod/property/hasRank> <http://purl.org/dc/terms/description> "Relates a scientific name or a taxon to a taxonimical rank"@en;
                                             a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                             rdfs:comment "This property is not equivalent to http://rs.tdwg.org/ontology/voc/TaxonConcept#rank nor http://rs.tdwg.org/ontology/voc/TaxonName#rank whose domains are http://rs.tdwg.org/ontology/voc/TaxonConcept#TaxonConcept and http://rs.tdwg.org/ontology/voc/TaxonName#TaxonName respectively, whereas we want to use taxrefprop:hasRank with taxa implemented as owl:Class's as well as scientific names implemented as instances of skos:Concept. "@en,
                                                          "This property is not equivalent to dwc:taxonRank which is expected to be used only with literal values (see http://rs.tdwg.org/dwc/terms/guides/rdf/index.htm, section 3.5)"@en;
                                             rdfs:isDefinedBy taxref-ld:taxref-ld;
                                             rdfs:label "has taxonomic rank"@en;
                                             rdfs:seeAlso <http://rs.tdwg.org/ontology/voc/TaxonName#rank>,
                                                          <http://rs.tdwg.org/ontology/voc/TaxonConcept#rank>,
                                                          <http://rs.tdwg.org/dwc/terms/taxonRank>;
                                             <http://www.w3.org/2002/07/owl#equivalentProperty> <http://www.wikidata.org/prop/direct/P105>,
                                                                                                <http://purl.obolibrary.org/obo/ncbitaxon#has_rank>.
<http://taxref.mnhn.fr/lod/property/hasReferenceName> <http://purl.org/dc/terms/description> "Relates a taxon to its reference (valid) scientific name"@en;
                                                      a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                                      rdfs:comment "DwC's scientificName property is recommended to be used with a literal object, and does not distinguish between reference vs. synonym names. Hence, TAXREF-LD extends it (rdfs:subPropertyOf) instead of asserting an equivalence."@en;
                                                      rdfs:isDefinedBy taxref-ld:taxref-ld;
                                                      rdfs:label "has reference name"@en;
                                                      rdfs:seeAlso <http://rs.tdwg.org/dwc/terms/scientificName>.
<http://taxref.mnhn.fr/lod/property/hasSex> <http://purl.org/dc/terms/description> "Gives the sex of a biologic individual (member of a taxon class)"@en;
                                            a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                            rdfs:isDefinedBy taxref-ld:taxref-ld;
                                            rdfs:label "has sex"@en;
                                            <http://www.w3.org/2002/07/owl#equivalentProperty> <http://www.wikidata.org/prop/direct/P21>.
<http://taxref.mnhn.fr/lod/property/hasSpecificity> <http://purl.org/dc/terms/description> "Specificity of the interaction"@en;
                                                    a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                    rdfs:isDefinedBy taxref-ld:taxref-ld;
                                                    rdfs:label "has a specificity"@en.
<http://taxref.mnhn.fr/lod/property/hasStatus> <http://purl.org/dc/terms/description> "Relates a taxon to one of its biogeographical, red list or legal statuses."@en;
                                               a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                               rdfs:isDefinedBy taxref-ld:taxref-ld;
                                               rdfs:label "has status"@en.
<http://taxref.mnhn.fr/lod/property/hasSynonym> <http://purl.org/dc/terms/description> "Relates a taxon to one of its synonyms"@en;
                                                a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                                rdfs:comment "DwC's scientificName property is recommended to be used with a literal object, and does not distinguish between reference vs. synonym names. Hence, in TAXREF-LD, we extend it with rdfs:subPropertyOf instead of asserting an equivalence."@en;
                                                rdfs:isDefinedBy taxref-ld:taxref-ld;
                                                rdfs:label "has synonym"@en;
                                                rdfs:seeAlso <http://rs.tdwg.org/dwc/terms/scientificName>.
<http://taxref.mnhn.fr/lod/property/hasTrophicLevel> <http://purl.org/dc/terms/description> "Relates a taxon to its tophic level"@en;
                                                     a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                                     rdfs:isDefinedBy taxref-ld:taxref-ld;
                                                     rdfs:label "has trophic level"@en.
<http://taxref.mnhn.fr/lod/property/isReferenceNameOf> <http://purl.org/dc/terms/description> "Relates a scientific name to the taxon for which it is the reference (valid) name"@en;
                                                       a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                                       rdfs:isDefinedBy taxref-ld:taxref-ld;
