taxrefprop:bioGeoStatusIn dcterms:description "(deprecated). Relates a taxon to a biogeograpical status within a certain region. As of TAXREF v12, this property should no longer be used. Instead use class taxrefstatus:BioGeographicalStatus"@en;
                          a owl:ObjectProperty;
                          rdfs:isDefinedBy taxref-ld:taxref-ld;
                          rdfs:label "has biogeograpical status"@en;
                          rdfs:range <http://taxref.mnhn.fr/lod/bioGeoStatus/BioGeographicalStatus>;
                          owl:deprecated true.
taxrefprop:habitat dcterms:description "Relates a taxon to an habitat in which it lives"@en;
                   a owl:AnnotationProperty;
                   rdfs:isDefinedBy taxref-ld:taxref-ld;
                   rdfs:label "has habitat"@en;
                   rdfs:seeAlso txn:habitat,
                                dwciri:habitat,
                                pobo:RO_0002303;
                   owl:equivalentProperty wdt:P2974.
taxrefprop:hasAuthority dcterms:description "Provides the authorship information of a scientific name"@en;
                        a owl:AnnotationProperty;
                        rdfs:comment "TDWG ontology's property http://rs.tdwg.org/ontology/voc/TaxonName#authorship is preferably associated with a scientific name (http://rs.tdwg.org/ontology/voc/TaxonName#TaxonName), which is in line with TAXREF-LD's modelling. By contrast, DwC's scientificNameAuthorship property is associated with a taxon (dwc:Taxon), and its object shoud be a literal (DwC does not have a class for taxon names). Therefore, TAXREF-LD's hasAuthority property is not equivalent to the latter."@en;
                        rdfs:isDefinedBy taxref-ld:taxref-ld;
                        rdfs:label "has scientific name authority"@en;
                        rdfs:seeAlso dwc:scientificNameAuthorship;
                        owl:equivalentProperty <http://rs.tdwg.org/ontology/voc/TaxonName#authorship>,
                                               txn:authority.
taxrefprop:hasBiologicalStage dcterms:description "Gives the biological stage of a biologic individual (member of a taxon class)"@en;
                              a owl:ObjectProperty;
                              rdfs:isDefinedBy taxref-ld:taxref-ld;
                              rdfs:label "has biological stage"@en;
                              owl:equivalentProperty wdt:P4774.
taxrefprop:hasRank dcterms:description "Relates a scientific name or a taxon to a taxonimical rank"@en;
                   a owl:AnnotationProperty;
                   rdfs:comment "This property is not equivalent to http://rs.tdwg.org/ontology/voc/TaxonConcept#rank nor http://rs.tdwg.org/ontology/voc/TaxonName#rank whose domains are http://rs.tdwg.org/ontology/voc/TaxonConcept#TaxonConcept and http://rs.tdwg.org/ontology/voc/TaxonName#TaxonName respectively, whereas we want to use taxrefprop:hasRank with taxa implemented as owl:Class's as well as scientific names implemented as instances of skos:Concept. "@en,
                                "This property is not equivalent to dwc:taxonRank which is expected to be used only with literal values (see http://rs.tdwg.org/dwc/terms/guides/rdf/index.htm, section 3.5)"@en;
                   rdfs:isDefinedBy taxref-ld:taxref-ld;
                   rdfs:label "has taxonomic rank"@en;
                   rdfs:seeAlso <http://rs.tdwg.org/ontology/voc/TaxonName#rank>,
                                <http://rs.tdwg.org/ontology/voc/TaxonConcept#rank>,
                                dwc:taxonRank;
                   owl:equivalentProperty wdt:P105,
                                          <http://purl.obolibrary.org/obo/ncbitaxon#has_rank>.
taxrefprop:hasReferenceName dcterms:description "Relates a taxon to its reference (valid) scientific name"@en;
                            a owl:AnnotationProperty;
                            rdfs:comment "DwC's scientificName property is recommended to be used with a literal object, and does not distinguish between reference vs. synonym names. Hence, TAXREF-LD extends it (rdfs:subPropertyOf) instead of asserting an equivalence."@en;
                            rdfs:isDefinedBy taxref-ld:taxref-ld;
                            rdfs:label "has reference name"@en;
                            rdfs:seeAlso dwc:scientificName.
taxrefprop:hasSex dcterms:description "Gives the sex of a biologic individual (member of a taxon class)"@en;
                  a owl:ObjectProperty;
                  rdfs:isDefinedBy taxref-ld:taxref-ld;
                  rdfs:label "has sex"@en;
                  owl:equivalentProperty wdt:P21.
taxrefprop:hasSpecificity dcterms:description "Specificity of the interaction"@en;
                          a owl:ObjectProperty;
                          rdfs:isDefinedBy taxref-ld:taxref-ld;
                          rdfs:label "has a specificity"@en.
taxrefprop:hasStatus dcterms:description "Relates a taxon to one of its biogeographical, red list or legal statuses."@en;
                     a owl:AnnotationProperty;
                     rdfs:isDefinedBy taxref-ld:taxref-ld;
                     rdfs:label "has status"@en.
taxrefprop:hasSynonym dcterms:description "Relates a taxon to one of its synonyms"@en;
                      a owl:AnnotationProperty;
                      rdfs:comment "DwC's scientificName property is recommended to be used with a literal object, and does not distinguish between reference vs. synonym names. Hence, in TAXREF-LD, we extend it with rdfs:subPropertyOf instead of asserting an equivalence."@en;
                      rdfs:isDefinedBy taxref-ld:taxref-ld;
                      rdfs:label "has synonym"@en;
                      rdfs:seeAlso dwc:scientificName.
taxrefprop:hasTrophicLevel dcterms:description "Relates a taxon to its tophic level"@en;
                           a owl:AnnotationProperty;
                           rdfs:isDefinedBy taxref-ld:taxref-ld;
                           rdfs:label "has trophic level"@en.
taxrefprop:isReferenceNameOf dcterms:description "Relates a scientific name to the taxon for which it is the reference (valid) name"@en;
                             a owl:AnnotationProperty;
                             rdfs:isDefinedBy taxref-ld:taxref-ld;
                             rdfs:label "is the reference name of"@en;
                             owl:inverse taxrefprop:hasReferenceName.
taxrefprop:isSynonymOf dcterms:description "Relates a scientific name to a taxon for which it is a synonym"@en;
                       a owl:AnnotationProperty;
                       rdfs:isDefinedBy taxref-ld:taxref-ld;
                       rdfs:label "is a synonym of"@en;
                       owl:inverse taxrefprop:hasSynonym.
taxrefprop:statusType dcterms:description "Relates a taxon status with the type of status which is a narrower concept of taxrefstatus:TaxonStatusType"@en;
                      a owl:ObjectProperty;
                      rdfs:domain <http://taxref.mnhn.fr/lod/status/TaxonStatus>;
                      rdfs:isDefinedBy taxref-ld:taxref-ld;
                      rdfs:label "status type"@en.
taxrefprop:statusValue dcterms:description "Relates a taxon status with the actual status value"@en;
                       a owl:ObjectProperty;
                       rdfs:domain <http://taxref.mnhn.fr/lod/status/TaxonStatus>;
                       rdfs:isDefinedBy taxref-ld:taxref-ld;
                       rdfs:label "status value"@en.
taxrefprop:vernacularName dcterms:description "Relates a taxon to one of its vernacular (common) names"@en;
                          a owl:AnnotationProperty;
                          rdfs:isDefinedBy taxref-ld:taxref-ld;
                          rdfs:label "has vernacular name"@en;
                          rdfs:seeAlso dwc:vernacularName,
                                       geospecies:hasVernacularName;
                          owl:equivalentProperty wdt:P1843.
taxrefprop:vernacularNameXL dcterms:description "Relates a taxon to one of its vernacular (common) names in the form of a SKOS extended label"@en;
                            a owl:AnnotationProperty;
                            rdfs:comment "This property was initially defined as a subPropertyOf skosxl:altLabel. However skosxl:altLabel is an owl:ObjectProperty and thus cannot apply to a class. Therefore, we instead define it a an owl:AnnotationProperty whose range is a skosxl:Label";
                            rdfs:isDefinedBy taxref-ld:taxref-ld;
                            rdfs:label "has extended vernacular name"@en;
                            rdfs:range skosxl:Label.
