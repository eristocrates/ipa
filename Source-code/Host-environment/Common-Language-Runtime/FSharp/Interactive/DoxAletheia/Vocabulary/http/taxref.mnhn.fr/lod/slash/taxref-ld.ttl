<http://taxref.mnhn.fr/lod/trophicLevel/Algivore> a skos:Concept;
                                                  rdfs:label "Algivore"@en;
                                                  skos:definition "Un herbivore qui consomme principalement des algues"@fr,
                                                                  "An herbivore that primarily consumes algae"@en;
                                                  skos:exactMatch ecocore:00000086;
                                                  skos:inScheme taxref-ld:taxref-ld;
                                                  skos:prefLabel "Algivore"@fr,
                                                                 "Algivore"@en.
<http://taxref.mnhn.fr/lod/trophicLevel/Autotroph> a skos:Concept;
                                                   rdfs:label "Autotroph"@en;
                                                   skos:definition "Organisme capable d'incorporer du carbone abiogène (inorganique) dans sa biomasse"@fr,
                                                                   "An organism which is capable of incorporating abiogenic (inorganic) carbon into its biomass"@en;
                                                   skos:exactMatch ecocore:00000023;
                                                   skos:inScheme taxref-ld:taxref-ld;
                                                   skos:prefLabel "Producteur primaire"@fr,
                                                                  "Autotroph"@en;
                                                   skos:relatedMatch wikidata:Q131427.
<http://taxref.mnhn.fr/lod/trophicLevel/Carnivore> a skos:Concept;
                                                   rdfs:label "Carnivore"@en;
                                                   skos:definition "Un hétérotrophe qui consomme des animaux en tout ou en partie par ingestion par une sorte de 'bouche'. La matière animale est décomposée par un processus de digestion interne."@fr,
                                                                   "A heterotroph that consumes animals in whole or in part via ingestion through a type of 'mouth'. Animal matter is broken down through an internal digestion process."@en;
                                                   skos:exactMatch ecocore:00000088;
                                                   skos:inScheme taxref-ld:taxref-ld;
                                                   skos:prefLabel "Consommateur d’hétérotrophes"@fr,
                                                                  "Carnivore"@en;
                                                   skos:relatedMatch wikidata:Q220314.
<http://taxref.mnhn.fr/lod/trophicLevel/Chemoautotroph> a skos:Concept;
                                                        rdfs:label "Chemoautotroph"@en;
                                                        skos:definition "Autotrophe capable d'obtenir de l'énergie à partir des liaisons d'un composé chimique"@fr,
                                                                        "An autotroph which is capable of obtaining energy from the bonds in a chemical compound"@en;
                                                        skos:exactMatch ecocore:00000129;
                                                        skos:inScheme taxref-ld:taxref-ld;
                                                        skos:prefLabel "Chemoautotrophe"@fr,
                                                                       "Chemoautotroph"@en;
                                                        skos:relatedMatch wikidata:Q747472.
<http://taxref.mnhn.fr/lod/trophicLevel/Coprophage> a skos:Concept;
                                                    rdfs:label "Coprophage"@en;
                                                    skos:definition "Un décomposeur qui se nourrit en consommant des matières fécales"@fr,
                                                                    "A decomposer which obtains nutrition by consuming feces"@en;
                                                    skos:exactMatch wikidata:Q45845947,
