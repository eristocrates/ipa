<http://taxref.mnhn.fr/lod/specificity/Mandatory> a skos:Concept;
                                                  rdfs:label "Mandatory"@en;
                                                  skos:definition "L'interaction est obligatoire à la survie de l'individu"@fr,
                                                                  "The interaction is mandatory for the survival of the individual"@en;
                                                  skos:inScheme taxref-ld:taxref-ld;
                                                  skos:prefLabel "Obligatoire"@fr,
                                                                 "Mandatory"@en;
                                                  skos:relatedMatch ncit:C25652.
<http://taxref.mnhn.fr/lod/specificity/Optional> a skos:Concept;
                                                 rdfs:label "Optional"@en;
                                                 skos:definition "Une interaction facultative n'est pas obligatoire à la survie de l'individu"@fr,
                                                                 "An optional interaction is not mandatory for the survival of the individual"@en;
                                                 skos:inScheme taxref-ld:taxref-ld;
                                                 skos:prefLabel "Facultative"@fr,
                                                                "Optional"@en;
                                                 skos:relatedMatch <https://www.wikidata.org/wiki/Q59864995>,
                                                                   ncit:C25603.
<http://taxref.mnhn.fr/lod/specificity/Principal> a skos:Concept;
                                                  rdfs:label "Principal"@en;
                                                  skos:definition "Une interaction principale n'est pas obligatoire, elle peut être remplacée par une autre interaction occasionelle avec une autre espèce"@fr,
                                                                  "A principal interaction is not mandatory, it can be remplaced by an optional interaction with another species";
                                                  skos:inScheme taxref-ld:taxref-ld;
                                                  skos:prefLabel "Principale"@fr,
                                                                 "Principal"@en;
                                                  skos:relatedMatch ncit:C25628.
<http://taxref.mnhn.fr/lod/specificity/Regular> a skos:Concept;
                                                rdfs:label "Regular"@en;
                                                skos:definition "L'interaction est régulièrement observée"@fr,
                                                                "The interaction is regularly observed"@en;
                                                skos:inScheme taxref-ld:taxref-ld;
                                                skos:prefLabel "Régulière"@fr,
                                                               "Regular"@en;
                                                skos:relatedMatch ncit:C102843.
<http://taxref.mnhn.fr/lod/specificity/SpecificityCollection> a skos:Collection;
                                                              rdfs:isDefinedBy taxref-ld:taxref-ld;
                                                              rdfs:label "Collection of interaction specificities"@en;
                                                              skos:member <http://taxref.mnhn.fr/lod/specificity/Sporadic>,
                                                                          <http://taxref.mnhn.fr/lod/specificity/Optional>,
                                                                          <http://taxref.mnhn.fr/lod/specificity/Regular>,
                                                                          <http://taxref.mnhn.fr/lod/specificity/Principal>,
                                                                          <http://taxref.mnhn.fr/lod/specificity/Mandatory>.
<http://taxref.mnhn.fr/lod/specificity/Sporadic> a skos:Concept;
                                                 rdfs:label "Sporadic"@en;
                                                 skos:definition "L'interaction est observée de manière occasionnelle/exceptionnelle"@fr,
                                                                 "The interaction is observed sporadically"@en;
                                                 skos:inScheme taxref-ld:taxref-ld;
                                                 skos:prefLabel "occasionnelle / exceptionnelle"@fr,
                                                                "Sporadic"@en;
                                                 skos:relatedMatch ncit:C64954.
<http://taxref.mnhn.fr/lod/status/BioGeographicalStatus> rdfs:comment "The biogeographical status of a taxon with the geographical area where this status applies and the bibliographic source that assigned this status to that taxon"@en;
