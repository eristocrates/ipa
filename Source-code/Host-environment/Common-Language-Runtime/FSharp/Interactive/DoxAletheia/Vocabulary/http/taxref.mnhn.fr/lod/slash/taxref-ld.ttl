taxref-ld:taxref <http://purl.org/dc/terms/accrualPeriodicity> <http://purl.org/linked-data/sdmx/2009/code#freq-A>;
                 <http://purl.org/dc/terms/creator> "C. Régnier",
                                                    "O. Gargominy",
                                                    "E. Vandel",
