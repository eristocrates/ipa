@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix munc: <http://ns.inria.fr/munc/>.

<http://ns.inria.fr/munc#> <http://purl.org/dc/terms/contributor> "Ahmed El Amine DJEBRI",
                                                                  "Fabien Gandon",
                                                                  "Andrea G.B. Tettamanzi";
                           <http://purl.org/dc/terms/created> "2018-12-23"^^xsd:date;
                           <http://purl.org/dc/terms/creator> <http://i3s.unice.fr/~djebri/foaf.html#me>,
                                                              "Ahmed El Amine DJEBRI";
                           <http://purl.org/dc/terms/description> "An OWL vocabulary for describing uncertainty metadata."@en;
                           <http://purl.org/dc/terms/hasVersion> <http://ns.inria.fr/munc/v1#>;
                           <http://purl.org/dc/terms/modified> "2019-02-01"^^xsd:date;
                           <http://purl.org/dc/terms/publisher> "Inria";
                           <http://purl.org/dc/terms/status> <http://purl.org/adms/status/UnderDevelopment>;
                           <http://purl.org/dc/terms/title> "Meta-Uncertainty"@en;
                           <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "munc";
                           <http://purl.org/vocab/vann/preferredNamespaceUri> "http://ns.inria.fr/munc/v1#";
                           a <http://purl.org/vocommons/voaf#Vocabulary>,
                             <http://www.w3.org/2002/07/owl#Ontology>;
                           rdfs:comment "This file specifies the set of OWL classes and properties to represent multi-level uncertainty metadata."@en;
                           rdfs:isDefinedby <http://ns.inria.fr/munc>;
                           rdfs:seeAlso munc:;
                           <http://xmlns.com/foaf/0.1/homepage> <http://ns.inria.fr/munc>.
<http://ns.inria.fr/munc#Meta> a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "The metadata associated to a Sentence in a certain World (Context)."@en;
                               rdfs:label "Meta"@en.
<http://ns.inria.fr/munc#Sentence> a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "The Sentence (Triple, Graph, Graph Pattern) to which Meta is associated in a specific World."@en;
                                   rdfs:label "Sentence"@en.
<http://ns.inria.fr/munc#TranslationFunction> a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:comment "Individuals of this class are LDScript functions enabling translating uncertainty information from one approach to another."@en;
                                              rdfs:label "Translation Function"@en.
<http://ns.inria.fr/munc#Uncertainty> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "A subclass of Meta, it enables annotating the Sentence associated to the metadata with uncertainty information."@en;
                                      rdfs:label "Uncertainty"@en;
                                      rdfs:subClassOf <http://ns.inria.fr/munc#Meta>.
<http://ns.inria.fr/munc#UncertaintyApproach> a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:comment "Individuals of this class represent uncertainty approaches, which are detailed in the appendix A."@en;
                                              rdfs:label "Uncertainty Approach"@en.
<http://ns.inria.fr/munc#UncertaintyOperation> a <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:comment "The Calculus to apply on the Values of a defined Uncertainty Feature."@en;
                                               rdfs:label "Uncertainty Operation"@en.
<http://ns.inria.fr/munc#UncertaintyValue> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "For each Uncertainty Feature, exists (when declared) a corresponding value."@en;
                                           rdfs:label "Uncertainty Value"@en.
<http://ns.inria.fr/munc#World> a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "The context (Graph, Default Graph, etc.) in which the Sentence is associated to Meta. This is used generally by datastores which are unable to represent named graphs."@en;
                                rdfs:label "World"@en.
<http://ns.inria.fr/munc#hasFullTranslation> a <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                                               <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                                               <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                                             rdfs:domain <http://ns.inria.fr/munc#UncertaintyApproach>;
                                             rdfs:label "hasFullTranslation"@en;
                                             rdfs:range <http://ns.inria.fr/munc#UncertaintyApproach>;
                                             rdfs:subPropertyOf <http://ns.inria.fr/munc#hasIdealTranslation>.
<http://ns.inria.fr/munc#hasIdealTranslation> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                              rdfs:domain <http://ns.inria.fr/munc#UncertaintyApproach>;
                                              rdfs:label "hasIdealTranslation"@en;
                                              rdfs:range <http://ns.inria.fr/munc#UncertaintyApproach>;
                                              rdfs:subPropertyOf <http://ns.inria.fr/munc#hasTranslation>.
<http://ns.inria.fr/munc#hasMeta> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:domain <http://ns.inria.fr/munc#World>,
                                              <http://ns.inria.fr/munc#Sentence>;
                                  rdfs:label "hasMeta"@en;
                                  rdfs:range <http://ns.inria.fr/munc#Meta>.
<http://ns.inria.fr/munc#hasTranslation> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                         rdfs:domain <http://ns.inria.fr/munc#UncertaintyApproach>;
                                         rdfs:label "hasTranslation"@en;
                                         rdfs:range <http://ns.inria.fr/munc#UncertaintyApproach>.
<http://ns.inria.fr/munc#hasUncertaintyApproach> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                 rdfs:domain <http://ns.inria.fr/munc#Uncertainty>;
                                                 rdfs:label "hasUncertaintyApproach"@en;
                                                 rdfs:range <http://ns.inria.fr/munc#UncertaintyApproach>.
<http://ns.inria.fr/munc#hasUncertaintyFeature> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                rdfs:domain <http://ns.inria.fr/munc#UncertaintyApproach>;
                                                rdfs:label "hasUncertaintyFeature"@en;
                                                rdfs:range <http://ns.inria.fr/munc#uncertaintyFeature>.
<http://ns.inria.fr/munc#hasUncertaintyOperator> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                 rdfs:domain <http://ns.inria.fr/munc#UncertaintyApproach>;
                                                 rdfs:label "hasUncertaintyOperator"@en;
                                                 rdfs:range <http://ns.inria.fr/munc#uncertaintyOperator>.
<http://ns.inria.fr/munc#statedIn> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:domain <http://ns.inria.fr/munc#Sentence>;
                                   rdfs:label "statedIn"@en;
                                   rdfs:range <http://ns.inria.fr/munc#World>.
<http://ns.inria.fr/munc#translateFrom> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:domain <http://ns.inria.fr/munc#TranslationFunction>;
                                        rdfs:label "translateFrom"@en;
                                        rdfs:range <http://ns.inria.fr/munc#UncertaintyApproach>.
<http://ns.inria.fr/munc#translateTo> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                      rdfs:domain <http://ns.inria.fr/munc#TranslationFunction>;
                                      rdfs:label "translateFrom"@en;
                                      rdfs:range <http://ns.inria.fr/munc#UncertaintyApproach>.
<http://ns.inria.fr/munc#uncertaintyFeature> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                             rdfs:comment "Each Uncertainty approach has some features, which can be metrics or measures to compare, infer or reason over to have a decision about knowledge."@en;
                                             rdfs:domain <http://ns.inria.fr/munc#Uncertainty>;
                                             rdfs:label "uncertaintyFeature"@en;
                                             rdfs:range <http://ns.inria.fr/munc#UncertaintyValue>.
<http://ns.inria.fr/munc#uncertaintyOperator> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                              rdfs:comment "Each Uncertainty approach has its own logic to reason over metadata, This class defines the methods that can be applied over Uncertainty Values. Such logic is the same used in reasoners and inference engines."@en;
                                              rdfs:domain <http://ns.inria.fr/munc#uncertaintyFeature>;
                                              rdfs:label "uncertaintyOperator"@en;
                                              rdfs:range <http://ns.inria.fr/munc#UncertaintyOperation>.
