          a owl:Class;
          rdfs:label "Actor"@en.
ekc:Architecture dc11:description "Historic Buildings in a certain area and historically related structures"@en,
                                  "특정 권역의 역사적인 건조물 및 주변의 유관한 건축/조형물"@ko;
                 a owl:Class;
                 rdfs:label "Architecture"@en.
