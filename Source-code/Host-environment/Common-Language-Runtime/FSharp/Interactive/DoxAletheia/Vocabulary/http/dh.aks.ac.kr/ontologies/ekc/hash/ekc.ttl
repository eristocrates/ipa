          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "Index"@en.
ekc:Multimedia <http://purl.org/dc/elements/1.1/description> "3D model of a building; 3D map indicating the location of a specific place; visual materials"@en,
