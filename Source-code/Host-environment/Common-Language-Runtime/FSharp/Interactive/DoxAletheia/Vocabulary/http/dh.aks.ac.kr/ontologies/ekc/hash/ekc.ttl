       skos:definition "장소가 목적어인 관계"@ko.
ekc:Place dc11:description "Places related to historical events or characters; Places where historical relics or artifacts are located"@en,
                           "역사적 배경(사건, 인물)과 관련이 있는 장소. 유물의 소장처"@ko;
          a owl:Class;
          rdfs:label "Place"@en.
ekc:RE a owl:ObjectProperty;
       rdfs:label "RE"@en;
       skos:definition "기록물/유물 관련 관계"@ko.
ekc:Record dc11:description "Records that serve as the source of knowledge such as books, photographs, drawings, and inscriptions"@en,
                            "문헌, 사진, 도면, 금석문 등 지식 데이터의 원천 자료가 되는 기록물"@ko;
           a owl:Class;
           rdfs:label "Record"@en.
ekc:ST a owl:ObjectProperty;
       rdfs:label "ST"@en;
       skos:definition "스토리텔링 구성을 지시하는 관계"@ko.
ekc:Story dc11:description "Description of historical knowledge that explains the background of discovering data nodes"@en,
                           "데이터 노드 발굴의 배경이 된 역사적 지식에 대한 서술"@ko;
          a owl:Class;
          rdfs:label "Story"@en.
ekc:TM a owl:ObjectProperty;
       rdfs:label "TM"@en;
       skos:definition "연표의 구성을 지시하는 관계"@ko.
ekc:Text dc11:description "Text in the literature that functions as evidence of explanation"@en,
                          "설명의 증거 기능을 하는 문헌상의 텍스트"@ko;
         a owl:Class;
         rdfs:label "Text"@en.
ekc:WebResource dc11:description "Reference materials that can be accessed on the World Wide Web"@en,
                                 "월드 와이드 웹에서 접근할 수 있는 참고 자료"@ko;
                a owl:Class;
                rdfs:label "WebResource"@en.
ekc:Work dc11:description "Works of art such as literature, fine arts, music, dance, performance, etc."@en,
                          "문학, 미술, 음악, 연희, 무용 등의 문예 작품"@ko;
         a owl:Class;
         rdfs:label "Work"@en.
ekc:XR a owl:ObjectProperty;
       rdfs:label "XR"@en;
       skos:definition "참고자료를 지시하는 관계"@ko.
ekc:administrates dc11:description "~를 주관하다"@ko;
