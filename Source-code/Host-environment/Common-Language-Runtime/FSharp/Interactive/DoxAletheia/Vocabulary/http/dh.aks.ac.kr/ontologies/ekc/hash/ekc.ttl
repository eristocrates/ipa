       rdfs:label "HR"@en;
       skos:definition "문화재 관련 관계"@ko.
ekc:Heritage dc11:description "Registration information of designated and registered cultural properties"@en,
                              "지정문화유산 및 등록문화유산 등록 정보"@ko;
             a owl:Class;
             rdfs:label "Heritage"@en.
ekc:Index dc11:description "A list of nodes of similar character. Timeline, collection list, reference list, web resource list, etc."@en,
                           "유사한 성격의 노드들을 모아서 묶은 목록. 연표, 소장도서목록, 참고문헌목록, 웹자원목록 등"@ko;
          a owl:Class;
          rdfs:label "Index"@en.
ekc:Multimedia dc11:description "3D model of a building; 3D map indicating the location of a specific place; visual materials"@en,
                                "3D 모델, 특정 공간의 위치를 알리는 3차원 지도, 시각자료"@ko;
               a owl:Class;
               rdfs:label "Multimedia"@en.
ekc:NM a owl:ObjectProperty;
