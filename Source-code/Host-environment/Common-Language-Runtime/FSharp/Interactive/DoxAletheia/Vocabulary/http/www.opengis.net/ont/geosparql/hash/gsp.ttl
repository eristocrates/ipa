                    skos:prefLabel "has length"@en.
geosparql:hasMetricArea a rdf:Property,
                          owl:DatatypeProperty;
                        rdfs:domain geosparql:SpatialObject;
                        rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/spatial-object-properties>,
