                 skos:prefLabel "disconnected"@en.
geosparql:rcc8ec a owl:ObjectProperty,
                   rdf:Property;
                 rdfs:domain geosparql:SpatialObject;
                 rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/rcc8-spatial-relations>,
                                  geosparql:,
                                  <http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/rcc8-spatial-relations>;
                 rdfs:range geosparql:SpatialObject;
                 rdfs:seeAlso resource:DE-9IM;
                 skos:definition "States that the subject SpatialObject spatially meets the object SpatialObject. DE-9IM: FFTFTTTTT"@en;
                 skos:prefLabel "externally connected"@en.
geosparql:rcc8eq a rdf:Property,
                   owl:ObjectProperty;
                 rdfs:domain geosparql:SpatialObject;
                 rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/rcc8-spatial-relations>,
