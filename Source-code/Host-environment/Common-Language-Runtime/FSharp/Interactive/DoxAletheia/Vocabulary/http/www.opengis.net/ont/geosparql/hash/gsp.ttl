                                      geosparql:;
                     rdfs:seeAlso <https://portal.ogc.org/files/?artifact_id=20509>;
                     skos:definition "A GML serialization of a Geometry object."@en;
                     skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.4>;
                     skos:prefLabel "GML Literal"@en.
geosparql:hasArea a rdf:Property,
                    owl:ObjectProperty;
                  rdfs:domain geosparql:SpatialObject;
                  rdfs:isDefinedBy geosparql:,
                                   <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/spatial-object-properties>;
                  rdfs:subPropertyOf geosparql:hasSize;
                  skos:definition "The area of a Spatial Object."@en;
                  skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.4>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.2>;
                  skos:prefLabel "has area"@en.
geosparql:hasBoundingBox a rdf:Property,
                           owl:ObjectProperty;
                         rdfs:domain geosparql:Feature;
                         rdfs:isDefinedBy geosparql:,
                                          <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/feature-properties>;
                         rdfs:range geosparql:Geometry;
                         rdfs:subPropertyOf geosparql:hasGeometry;
                         skos:definition "The minimum or smallest bounding or enclosing box of a given Feature."@en;
                         skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.2>;
                         skos:prefLabel "has bounding box"@en;
                         skos:scopeNote "The target is a Geometry that defines a rectilinear region whose edges are aligned with the axes of the coordinate reference system, which exactly contains the Feature, for example an instance of http://www.opengis.net/ont/sf#envelope."@en.
geosparql:hasCentroid a rdf:Property,
                        owl:ObjectProperty;
                      rdfs:domain geosparql:Feature;
                      rdfs:isDefinedBy geosparql:,
                                       <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/feature-properties>;
                      rdfs:range geosparql:Geometry;
                      rdfs:subPropertyOf geosparql:hasGeometry;
                      skos:definition "The arithmetic mean position of all the Geometry points of a given Feature."@en;
                      skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.2>;
                      skos:prefLabel "has centroid"@en;
                      skos:scopeNote "The target Geometry shall describe a point, for example an instance of http://www.opengis.net/ont/sf#Point."@en.
geosparql:hasDefaultGeometry a owl:ObjectProperty,
                               rdf:Property;
                             rdfs:domain geosparql:Feature;
                             rdfs:isDefinedBy geosparql:,
                                              <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/feature-properties>,
                                              <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/feature-properties>;
                             rdfs:range geosparql:Geometry;
                             rdfs:subPropertyOf geosparql:hasGeometry;
                             owl:equivalentProperty geosparql:defaultGeometry;
                             skos:definition "The default Geometry to be used in spatial calculations. It is usually the most detailed Geometry."@en;
                             skos:note "Duplicate properties defaultGeometry and hasDefaultGeometry exist because of an inconsistency between ontology and documentation in GeoSPARQL 1.0. Only hasDefaultGeometry is described in the documention."@en;
                             skos:prefLabel "has default geometry"@en.
geosparql:hasGeometry a owl:ObjectProperty,
                        rdf:Property;
                      rdfs:domain geosparql:Feature;
                      rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/feature-properties>,
                                       geosparql:,
                                       <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/feature-properties>;
                      rdfs:range geosparql:Geometry;
                      skos:definition "A spatial representation for a given Feature."@en;
                      skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.3>,
                                   <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.4>,
                                   <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.2>,
                                   <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.8>,
                                   <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.2>,
                                   <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.4>,
                                   <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.3>,
                                   <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.3>,
                                   <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.2>,
                                   <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.5>,
                                   <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.6>,
                                   <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.2>;
                      skos:prefLabel "has geometry"@en.
geosparql:hasLength a owl:ObjectProperty,
                      rdf:Property;
                    rdfs:domain geosparql:SpatialObject;
                    rdfs:isDefinedBy geosparql:,
                                     <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/spatial-object-properties>;
                    rdfs:subPropertyOf geosparql:hasSize;
                    skos:definition "The length of a Spatial Object."@en;
                    skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.2>,
