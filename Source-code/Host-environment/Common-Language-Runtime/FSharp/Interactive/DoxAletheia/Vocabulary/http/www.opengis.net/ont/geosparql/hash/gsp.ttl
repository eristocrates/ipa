@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix planet: <http://dbpedia.org/>.
@prefix resource: <http://dbpedia.org/resource/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix geosparql: <http://www.opengis.net/ont/geosparql#>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix schemas: <https://schema.org/>.

<http://www.opengis.net/ont/geosparql> dcterms:contributor [schemas:url "https://orcid.org/0000-0002-3884-3420"^^xsd:anyURI ; 
                                                            schemas:email "simon.cox@csiro.au" ; 
                                                            schemas:affiliation "CSIRO Australia" ; 
                                                            schemas:name "Simon J D Cox" ; 
                                                            a schemas:Person],
                                                           [schemas:url "https://orcid.org/0000-0001-5075-6234"^^xsd:anyURI ; 
                                                            schemas:email "joseph.abhayaratna@geoscape.com.au" ; 
                                                            schemas:affiliation "Geoscape Australia" ; 
                                                            schemas:name "Joseph Abhayaratna" ; 
                                                            a schemas:Person],
                                                           [schemas:url "https://orcid.org/0000-0002-3313-924X"^^xsd:anyURI ; 
                                                            schemas:email "mathias.bonduel@neanex.com" ; 
                                                            schemas:affiliation "Neanex Technologies" ; 
                                                            schemas:affiliation "KU Leuven" ; 
                                                            schemas:name "Mathias Bonduel" ; 
                                                            a schemas:Person],
                                                           [schemas:url "https://orcid.org/0000-0002-9499-5840"^^xsd:anyURI ; 
                                                            schemas:email "timo.homburg@hs-mainz.de" ; 
                                                            schemas:affiliation "Mainz University Of Applied Sciences" ; 
                                                            schemas:name "Timo Homburg" ; 
                                                            a schemas:Person],
                                                           [schemas:url "https://orcid.org/0000-0002-8742-7730"^^xsd:anyURI ; 
                                                            schemas:email "nick@kurrawong.ai" ; 
                                                            schemas:affiliation "KurrawongAI" ; 
                                                            schemas:affiliation "Australian National University" ; 
                                                            schemas:affiliation "SURROUND Australia Pty Ltd" ; 
                                                            schemas:name "Nicholas J. Car" ; 
                                                            a schemas:Person],
                                                           [schemas:email "john.herring@oracle.com" ; 
                                                            schemas:affiliation "Oracle Corporation" ; 
                                                            schemas:name "John Herring" ; 
                                                            a schemas:Person],
                                                           [schemas:url "https://orcid.org/0000-0003-1988-462X"^^xsd:anyURI ; 
                                                            schemas:email "matthew.perry@oracle.com" ; 
                                                            schemas:affiliation "Oracle Corporation" ; 
                                                            schemas:name "Matthew Perry" ; 
                                                            a schemas:Person],
                                                           [schemas:url "https://orcid.org/0000-0003-3789-2260"^^xsd:anyURI ; 
                                                            schemas:email "fjknibbe@gmail.com" ; 
                                                            schemas:name "Frans Knibbe" ; 
                                                            a schemas:Person];
                                       dcterms:created "2020-09-09"^^xsd:date;
                                       dcterms:creator "OGC GeoSPARQL Standards Working Group";
                                       dcterms:description "An RDF/OWL vocabulary for representing spatial information"@en;
                                       dcterms:issued "2023-11-16"^^xsd:date;
                                       dcterms:license "https://www.ogc.org/license"^^xsd:anyURI;
                                       dcterms:modified "2024-01-12"^^xsd:date;
                                       dcterms:publisher [schemas:url "https://www.ogc.org"^^xsd:anyURI ; 
                                                          schemas:name "Open Geospatial Consortium" ; 
                                                          a schemas:Organization];
                                       dcterms:replaces <http://www.opengis.net/ont/geosparql/1.0>;
                                       dcterms:rights "(c) 2023 Open Geospatial Consortium";
                                       dcterms:source <http://www.opengis.net/doc/IS/geosparql/1.1>;
                                       dcterms:title "GeoSPARQL Ontology";
                                       a owl:Ontology;
                                       rdfs:seeAlso <http://www.opengis.net/doc/IS/geosparql/1.1>;
                                       owl:versionIRI <http://www.opengis.net/ont/geosparql/1.1>;
                                       owl:versionInfo "1.1".
geosparql:Feature a owl:Class,
                    rdfs:Class;
                  rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0/req/core/feature-class>,
                                   geosparql:,
                                   <http://www.opengis.net/spec/geosparql/1.1/req/core/feature-class>;
                  rdfs:subClassOf geosparql:SpatialObject;
                  owl:disjointWith geosparql:Geometry;
                  skos:definition "A discrete spatial phenomenon in a universe of discourse."@en;
                  skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.7>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.6>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.3>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.2>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.2>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.4>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.5>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.3>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.9>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.1>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.8>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.2>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.4>,
                               <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.3>;
                  skos:note "A Feature represents a uniquely identifiable phenomenon, for example a river or an apple. While such phenomena (and therefore the Features used to represent them) are bounded, their boundaries may be crisp (e.g., the declared boundaries of a state), vague (e.g., the delineation of a valley versus its neighboring mountains), and change with time (e.g., a storm front). While discrete in nature, Features may be created from continuous observations, such as an isochrone that determines the region that can be reached by ambulance within 5 minutes."@en;
                  skos:prefLabel "Feature"@en.
geosparql:FeatureCollection a owl:Class,
                              rdfs:Class;
                            rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/core/feature-collection-class>,
                                             geosparql:;
                            rdfs:subClassOf [owl:onProperty rdfs:member ; 
                                             owl:allValuesFrom geosparql:Feature ; 
                                             a owl:Restriction],
                                            geosparql:SpatialObjectCollection;
                            skos:definition "A collection of individual Features."@en;
                            skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.6>;
                            skos:prefLabel "Feature Collection"@en.
geosparql:Geometry a owl:Class,
                     rdfs:Class;
                   rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-class>,
                                    <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-class>,
                                    geosparql:;
                   rdfs:subClassOf geosparql:SpatialObject;
                   skos:definition "A coherent set of direct positions in space. The positions are held within a Spatial Reference System (SRS)."@en;
                   skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.4>,
                                <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.5>,
                                <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.2>,
                                <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.6>,
                                <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.3>,
                                <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.4>,
                                <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.2>,
                                <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.1>,
                                <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.8>,
                                <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.3>,
                                <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.2>,
                                <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.3>;
                   skos:note "Geometry can be used as a representation of the shape, extent or location of a Feature and may exist as a self-contained entity."@en;
                   skos:prefLabel "Geometry"@en.
geosparql:GeometryCollection a owl:Class,
                               rdfs:Class;
                             rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/core/geometry-collection-class>,
                                              geosparql:;
                             rdfs:subClassOf [owl:onProperty rdfs:member ; 
                                              owl:allValuesFrom geosparql:Geometry ; 
                                              a owl:Restriction],
                                             geosparql:SpatialObjectCollection;
                             skos:definition "A collection of individual Geometries."@en;
                             skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.7>;
                             skos:prefLabel "Geometry Collection"@en.
geosparql:SpatialObject a owl:Class,
                          rdfs:Class;
                        rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/core/spatial-object-class>,
                                         <http://www.opengis.net/spec/geosparql/1.0/req/core/spatial-object-class>,
                                         geosparql:;
                        skos:definition "Anything spatial (being or having a shape, position or an extent)."@en;
                        skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.1.1>,
                                     <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.1.2>;
                        skos:note "Subclasses of this class are expected to be used for instance data."@en;
                        skos:prefLabel "Spatial Object"@en.
geosparql:SpatialObjectCollection a owl:Class,
                                    rdfs:Class;
                                  rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/core/spatial-object-collection-class>,
                                                   geosparql:;
                                  rdfs:subClassOf [owl:onProperty rdfs:member ; 
                                                   owl:allValuesFrom geosparql:SpatialObject ; 
                                                   a owl:Restriction],
                                                  rdfs:Container;
                                  skos:definition "A collection of individual Spatial Objects."@en;
                                  skos:note "This is the superclass of Feature Collection and Geometry Collection."@en;
                                  skos:prefLabel "Spatial Object Collection"@en.
geosparql:asDGGS a rdf:Property,
                   owl:DatatypeProperty;
                 rdfs:domain geosparql:Geometry;
                 rdfs:isDefinedBy geosparql:,
                                  <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-as-dggs-literal>;
                 rdfs:range geosparql:dggsLiteral;
                 rdfs:subPropertyOf geosparql:hasSerialization;
                 skos:definition "The Discrete Global Grid System (DGGS) serialization of a Geometry"@en;
                 skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.4>;
                 skos:prefLabel "as DGGS"@en.
geosparql:asGML a owl:DatatypeProperty,
                  rdf:Property;
                rdfs:domain geosparql:Geometry;
                rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-as-gml-literal>,
                                 <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-as-gml-literal>,
                                 geosparql:;
                rdfs:range geosparql:gmlLiteral;
                rdfs:subPropertyOf geosparql:hasSerialization;
                skos:definition "The GML serialization of a Geometry"@en;
                skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.4>;
                skos:prefLabel "as GML"@en.
geosparql:asGeoJSON a owl:DatatypeProperty,
                      rdf:Property;
                    rdfs:domain geosparql:Geometry;
                    rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-as-geojson-literal>,
                                     geosparql:;
                    rdfs:range geosparql:geoJSONLiteral;
                    rdfs:seeAlso <https://tools.ietf.org/html/rfc7946>;
                    rdfs:subPropertyOf geosparql:hasSerialization;
                    skos:definition "The GeoJSON serialization of a Geometry"@en;
                    skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.4>;
                    skos:prefLabel "as GeoJSON"@en.
geosparql:asKML a rdf:Property,
                  owl:DatatypeProperty;
                rdfs:domain geosparql:Geometry;
                rdfs:isDefinedBy geosparql:,
                                 <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-as-kml-literal>;
                rdfs:range geosparql:kmlLiteral;
                rdfs:seeAlso <https://www.ogc.org/standards/kml>;
                rdfs:subPropertyOf geosparql:hasSerialization;
                skos:definition "The KML serialization of a Geometry"@en;
                skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.4>;
                skos:prefLabel "as KML"@en.
geosparql:asWKT a rdf:Property,
                  owl:DatatypeProperty;
                rdfs:domain geosparql:Geometry;
                rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-as-wkt-literal>,
                                 geosparql:,
                                 <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-as-wkt-literal>;
                rdfs:range geosparql:wktLiteral;
                rdfs:subPropertyOf geosparql:hasSerialization;
                skos:definition "The WKT serialization of a Geometry"@en;
                skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.3>,
                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.4>,
                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.2>,
                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.3>,
                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.2.1>,
                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.2.2.4>,
                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.2>,
                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.6>,
                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.5>,
                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.1>,
                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.2>,
                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.8>;
                skos:prefLabel "as WKT"@en.
geosparql:coordinateDimension a owl:DatatypeProperty,
                                rdf:Property;
                              rdfs:domain geosparql:Geometry;
                              rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-properties>,
                                               geosparql:;
                              rdfs:range xsd:integer;
                              skos:definition "The number of measurements or axes needed to describe the position of this Geometry in a coordinate system."@en;
                              skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.3>;
                              skos:prefLabel "coordinate dimension"@en.
geosparql:defaultGeometry a owl:ObjectProperty,
                            rdf:Property;
                          rdfs:domain geosparql:Feature;
                          rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/feature-properties>,
                                           geosparql:;
                          rdfs:range geosparql:Geometry;
                          rdfs:subPropertyOf geosparql:hasGeometry;
                          owl:equivalentProperty geosparql:hasDefaultGeometry;
                          skos:definition "The default Geometry to be used in spatial calculations. It is usually the most detailed Geometry."@en;
                          skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.2>,
                                       <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.2.1>;
                          skos:note "Duplicate properties defaultGeometry and hasDefaultGeometry exist because of an inconsistency between ontology and documentation in GeoSPARQL 1.0. Only hasDefaultGeometry is described in the documention."@en;
                          skos:prefLabel "default geometry"@en.
geosparql:dggsLiteral a rdfs:Datatype;
                      rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/dggs-literal>,
                                       geosparql:;
                      rdfs:seeAlso <http://www.opengis.net/doc/AS/dggs/2.0>;
                      skos:definition "A textual serialization of a Discrete Global Grid (DGGS) Geometry object."@en;
                      skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.4>,
                                   """ \"<https://w3id.org/dggs/auspix> OrdinateList (R3234)\"^^<http://www.opengis.net/ont/geosparql#dggsLiteral>""";
                      skos:prefLabel "DGGS Literal"@en;
                      skos:scopeNote "This datatype is not expected to be used directly but to serve as an abstract datatype for a series of specific DGGS literal types, for specific DGGS implementations"@en.
geosparql:dimension a owl:DatatypeProperty,
                      rdf:Property;
                    rdfs:domain geosparql:Geometry;
                    rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-properties>,
                                     geosparql:;
                    rdfs:range xsd:integer;
                    skos:definition "The topological dimension of this geometric object, which must be less than or equal to the coordinate dimension. In non-homogeneous collections, this will return the largest topological dimension of the contained objects."@en;
                    skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.3>;
                    skos:prefLabel "dimension"@en.
geosparql:ehContains a rdf:Property,
                       owl:ObjectProperty;
                     rdfs:domain geosparql:SpatialObject;
                     rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations>,
                                      <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations>,
                                      geosparql:;
                     rdfs:range geosparql:SpatialObject;
                     rdfs:seeAlso resource:DE-9IM;
                     skos:definition "States that the subject SpatialObject spatially contains the object SpatialObject. DE-9IM: T*TFF*FF*"@en;
                     skos:prefLabel "contains"@en.
geosparql:ehCoveredBy a rdf:Property,
                        owl:ObjectProperty;
                      rdfs:domain geosparql:SpatialObject;
                      rdfs:isDefinedBy geosparql:,
                                       <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations>,
                                       <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations>;
                      rdfs:range geosparql:SpatialObject;
                      rdfs:seeAlso resource:DE-9IM;
                      skos:definition "States that the subject SpatialObject is spatially covered by the object SpatialObject. DE-9IM: TFF*TFT**"@en;
                      skos:prefLabel "covered by"@en.
geosparql:ehCovers a owl:ObjectProperty,
                     rdf:Property;
                   rdfs:domain geosparql:SpatialObject;
                   rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations>,
                                    <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations>,
                                    geosparql:;
                   rdfs:range geosparql:SpatialObject;
                   rdfs:seeAlso resource:DE-9IM;
                   skos:definition "States that the subject SpatialObject spatially covers the object SpatialObject. DE-9IM: T*TFT*FF*"@en;
                   skos:prefLabel "covers"@en.
geosparql:ehDisjoint a owl:ObjectProperty,
                       rdf:Property;
                     rdfs:domain geosparql:SpatialObject;
                     rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations>,
                                      geosparql:,
                                      <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations>;
                     rdfs:range geosparql:SpatialObject;
                     rdfs:seeAlso resource:DE-9IM;
                     owl:equivalentProperty geosparql:sfDisjoint;
                     skos:definition "States that the subject SpatialObject is spatially disjoint from the object SpatialObject. DE-9IM: FF*FF****"@en;
                     skos:prefLabel "disjoint"@en.
geosparql:ehEquals a rdf:Property,
                     owl:ObjectProperty;
                   rdfs:domain geosparql:SpatialObject;
                   rdfs:isDefinedBy geosparql:,
                                    <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations>,
                                    <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations>;
                   rdfs:range geosparql:SpatialObject;
                   rdfs:seeAlso resource:DE-9IM;
                   owl:equivalentProperty geosparql:sfEquals;
                   skos:definition "States that the subject SpatialObject spatially equals the object SpatialObject. DE-9IM: TFFFTFFFT"@en;
                   skos:prefLabel "equals"@en.
geosparql:ehInside a owl:ObjectProperty,
                     rdf:Property;
                   rdfs:domain geosparql:SpatialObject;
                   rdfs:isDefinedBy geosparql:,
                                    <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations>,
                                    <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations>;
                   rdfs:range geosparql:SpatialObject;
                   rdfs:seeAlso resource:DE-9IM;
                   skos:definition "States that the subject SpatialObject is spatially inside the object SpatialObject. DE-9IM: TFF*FFT**"@en;
                   skos:prefLabel "inside"@en.
geosparql:ehMeet a rdf:Property,
                   owl:ObjectProperty;
                 rdfs:domain geosparql:SpatialObject;
                 rdfs:isDefinedBy geosparql:,
                                  <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations>,
                                  <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations>;
                 rdfs:range geosparql:SpatialObject;
                 rdfs:seeAlso resource:DE-9IM;
                 owl:equivalentProperty geosparql:sfTouches;
                 skos:definition "States that the subject SpatialObject spatially meets the object SpatialObject. DE-9IM: FT******* ^ F**T***** ^ F***T****"@en;
                 skos:prefLabel "meet"@en.
geosparql:ehOverlap a owl:ObjectProperty,
                      rdf:Property;
                    rdfs:domain geosparql:SpatialObject;
                    rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations>,
                                     <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations>,
                                     geosparql:;
                    rdfs:range geosparql:SpatialObject;
                    rdfs:seeAlso resource:DE-9IM;
                    skos:definition "States that the subject SpatialObject spatially overlaps the object SpatialObject. DE-9IM: T*T***T**"@en;
                    skos:prefLabel "overlap"@en.
geosparql:geoJSONLiteral a rdfs:Datatype;
                         rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geojson-literal>,
                                          geosparql:;
                         rdfs:seeAlso <https://tools.ietf.org/html/rfc7946>;
                         skos:definition "A GeoJSON serialization of a Geometry object."@en;
                         skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.4>;
                         skos:prefLabel "GeoJSON Literal"@en.
geosparql:gmlLiteral a rdfs:Datatype;
                     rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/gml-literal>,
