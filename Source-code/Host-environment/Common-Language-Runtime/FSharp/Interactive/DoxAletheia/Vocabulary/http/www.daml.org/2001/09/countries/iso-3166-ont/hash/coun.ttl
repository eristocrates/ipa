@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix daml: <http://www.daml.org/2001/03/daml+oil#>.
@prefix coun: <http://www.daml.org/2001/09/countries/iso-3166-ont#>.
@prefix w3: <http://www.w3.org/>.

<http://www.daml.org/2001/09/countries/iso-3166-ont> daml:versionInfo "$Id: iso-3166-ont.daml,v 1.3 2003/08/11 23:26:13 mdean Exp $";
                                                     a daml:Ontology;
                                                     rdfs:comment "ISO 3166 Country Codes".
coun:Country a rdfs:Class;
             rdfs:subClassOf [daml:toClass <http://www.w3.org/2000/10/XMLSchema#string> ; 
                              daml:onProperty coun:code ; 
                              daml:cardinality "1" ; 
                              a daml:Restriction],
                             [daml:toClass <http://www.w3.org/2000/10/XMLSchema#string> ; 
                              daml:onProperty coun:name ; 
                              daml:cardinality "1" ; 
                              a daml:Restriction],
                             <http://www.daml.org/2001/09/countries/country-ont#Country>.
coun:code a daml:DatatypeProperty.
coun:name a daml:DatatypeProperty.
