                                                                       [owl:onProperty datex:millimetresPerHourIntensity ; 
                                                                       owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                       a owl:Restriction]
                                                                       [owl:onProperty datex:millimetresPerHourIntensity ; 
