datex:OpenlrLastLocationReferencePoint a owl:Class;
                                       rdfs:comment "The sequence of location reference points is terminated by a last location reference point."@en;
                                       rdfs:subClassOf [owl:intersectionOf ([owl:onProperty datex:openlrLastLocationReferencePointExtension ; 
                                                                            owl:allValuesFrom datex:_ExtensionType ; 
                                                                            a owl:Restriction]
