                                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class],
                                                datex:Fault.
datex:MeasurementSiteRecord a owl:Class;
                            rdfs:comment "An identifiable single measurement site entry/record in the Measurement Site table."@en;
