                                                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                         a owl:Restriction]) ; 
                                     a owl:Class].
datex:MeasurementEquipmentFault a owl:Class;
                                rdfs:comment "Details of a fault which is being reported for the related measurement equipment."@en;
                                rdfs:subClassOf [owl:intersectionOf ([owl:onProperty datex:measurementEquipmentFault ; 
                                                                     owl:allValuesFrom xsd:string ; 
                                                                     a owl:Restriction]
