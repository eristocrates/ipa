                                                                     a owl:Restriction]
                                                                     [owl:onProperty datex:precipitationDetail ; 
                                                                     owl:allValuesFrom datex:PrecipitationDetail ; 
                                                                     a owl:Restriction]
                                                                     [owl:onProperty datex:temperature ; 
