                                          [owl:onProperty datex:version ; 
                                           owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                           a owl:Restriction],
                                          datex:ParkingRoute.
datex:ParkingRouteStatus a owl:Class;
                         rdfs:comment "The status of a parking route (active/inactive) defined in the static part of the model."@en;
                         rdfs:subClassOf [owl:intersectionOf ([owl:onProperty datex:parkingRouteActive ; 
                                                              owl:allValuesFrom xsd:string ; 
                                                              a owl:Restriction]
