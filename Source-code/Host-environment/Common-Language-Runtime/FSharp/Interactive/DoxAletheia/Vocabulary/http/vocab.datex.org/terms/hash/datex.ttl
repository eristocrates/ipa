datex:PrecipitationIntensityValue a owl:Class;
                                  rdfs:comment "A measured or calculated value of the accumulation rate of precipitation."@en;
                                  rdfs:subClassOf [owl:intersectionOf ([owl:onProperty datex:millimetresPerHourIntensity ; 
                                                                       owl:allValuesFrom xsd:string ; 
