                                                                   a owl:Restriction]
                                                                   [owl:onProperty datex:siteMeasurements ; 
                                                                   owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                   a owl:Restriction]
                                                                   [owl:onProperty datex:headerInformation ; 
