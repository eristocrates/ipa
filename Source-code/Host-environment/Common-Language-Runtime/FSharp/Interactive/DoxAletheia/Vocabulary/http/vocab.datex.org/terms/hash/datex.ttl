datex:PredefinedItinerary a owl:Class;
                          rdfs:comment "An identifiable versioned instance of a predefined itinerary."@en;
                          rdfs:subClassOf [owl:onProperty datex:id ; 
                                           owl:allValuesFrom xsd:string ; 
