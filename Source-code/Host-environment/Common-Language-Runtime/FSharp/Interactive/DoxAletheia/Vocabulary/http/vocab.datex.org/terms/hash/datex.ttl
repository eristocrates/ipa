datex:ParkingVehicle a owl:Class;
                     rdfs:comment "Information about one individual parking vehicle."@en;
                     rdfs:subClassOf [owl:onProperty datex:id ; 
                                      owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
