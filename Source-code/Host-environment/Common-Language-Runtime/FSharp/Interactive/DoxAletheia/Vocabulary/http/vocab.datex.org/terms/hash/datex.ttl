                                                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                         a owl:Restriction]) ; 
                                     a owl:Class].
datex:PoliceCheckPoint a owl:NamedIndividual.
datex:PoliceInvestigation a owl:NamedIndividual.
datex:PoliceSpeedChecksInOperation a owl:NamedIndividual.
datex:Pollution a owl:Class,
                  owl:NamedIndividual;
                rdfs:comment "Details of atmospheric pollution."@en;
                rdfs:subClassOf [owl:intersectionOf ([owl:onProperty datex:pollutantConcentration ; 
                                                     owl:allValuesFrom datex:MicrogramsConcentrationValue ; 
                                                     a owl:Restriction]
