                                                                             a owl:Restriction]
                                                                             [owl:onProperty datex:distanceFromLinearElementReferentExtension ; 
                                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                             a owl:Restriction]
                                                                             [owl:onProperty datex:fromReferent ; 
                                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
