                                                                   owl:allValuesFrom datex:OpenlrLastLocationReferencePoint ; 
                                                                   a owl:Restriction]
                                                                   [owl:onProperty datex:openlrLocationReferencePoint ; 
                                                                   owl:allValuesFrom datex:OpenlrLocationReferencePoint ; 
                                                                   a owl:Restriction]
                                                                   [owl:onProperty datex:openlrOrientation ; 
