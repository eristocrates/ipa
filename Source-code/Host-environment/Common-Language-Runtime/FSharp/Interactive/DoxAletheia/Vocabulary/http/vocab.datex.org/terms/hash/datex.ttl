                                                          owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                          a owl:Restriction]
                                                          [owl:onProperty datex:d2LogicalModelExtension ; 
                                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                          a owl:Restriction]
                                                          [owl:onProperty datex:exchange ; 
                                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                          a owl:Restriction]
                                                          [owl:onProperty datex:payloadPublication ; 
                                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                          a owl:Restriction]) ; 
                                      a owl:Class].
