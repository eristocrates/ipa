                                                              a owl:Restriction]) ; 
                                          a owl:Class].
datex:OpenlrExtendedLinear a owl:Class;
                           rdfs:comment "Extension class for OpenLR Line location reference"@en;
                           rdfs:subClassOf [owl:intersectionOf ([owl:onProperty datex:firstDirection ; 
