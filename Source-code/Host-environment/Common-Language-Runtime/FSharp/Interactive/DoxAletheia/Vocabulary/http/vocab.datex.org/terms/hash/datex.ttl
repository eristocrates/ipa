datex:PcuFlowValue a owl:Class;
                   rdfs:comment "A measured or calculated value of the flow rate of passenger car units."@en;
                   rdfs:subClassOf [owl:intersectionOf ([owl:onProperty datex:pcuFlowRate ; 
