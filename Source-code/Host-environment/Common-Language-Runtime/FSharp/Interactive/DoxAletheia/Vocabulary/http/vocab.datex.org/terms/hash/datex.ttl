datex:AbandonedVehicle a owl:NamedIndividual.
datex:AbnormalLoad a owl:NamedIndividual.
datex:AbnormalTraffic a owl:Class,
                        owl:NamedIndividual;
                      rdfs:comment "A traffic condition which is not normal."@en;
                      rdfs:subClassOf [owl:intersectionOf ([owl:onProperty datex:abnormalTrafficExtension ; 
                                                           owl:allValuesFrom datex:_ExtensionType ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:abnormalTrafficType ; 
                                                           owl:allValuesFrom xsd:string ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:numberOfVehiclesWaiting ; 
                                                           owl:allValuesFrom xsd:string ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:queueLength ; 
                                                           owl:allValuesFrom xsd:string ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:relativeTrafficFlow ; 
                                                           owl:allValuesFrom xsd:string ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:trafficFlowCharacteristics ; 
                                                           owl:allValuesFrom xsd:string ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:trafficTrendType ; 
                                                           owl:allValuesFrom xsd:string ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:abnormalTrafficExtension ; 
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:abnormalTrafficType ; 
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:numberOfVehiclesWaiting ; 
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:queueLength ; 
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:relativeTrafficFlow ; 
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:trafficFlowCharacteristics ; 
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           a owl:Restriction]
                                                           [owl:onProperty datex:trafficTrendType ; 
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           a owl:Restriction]) ; 
                                       a owl:Class],
                                      datex:TrafficElement.
datex:AcceptedPaymentCards a owl:Class;
                           rdfs:comment "Use this class to describe details in case acceptedMeansOfPayment is set to 'paymentCard'."@en;
                           rdfs:subClassOf [owl:intersectionOf ([owl:onProperty datex:acceptedPaymentCardsExtension ; 
                                                                owl:allValuesFrom datex:_ExtensionType ; 
                                                                a owl:Restriction]
                                                                [owl:onProperty datex:otherPaymentCardBrands ; 
