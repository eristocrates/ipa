                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                               a owl:Restriction]
                                                               [owl:onProperty datex:openlrGeoCoordinateExtension ; 
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                               a owl:Restriction]) ; 
                                           a owl:Class].
datex:OpenlrGridAttributes a owl:Class;
                           rdfs:comment "attributes required for the grid method"@en;
