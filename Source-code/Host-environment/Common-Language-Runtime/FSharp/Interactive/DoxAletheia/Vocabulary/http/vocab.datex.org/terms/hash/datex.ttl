                                                    [owl:onProperty datex:mobilityOfActivity ; 
                                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    a owl:Restriction]) ; 
                                a owl:Class],
                               datex:TrafficElement.
