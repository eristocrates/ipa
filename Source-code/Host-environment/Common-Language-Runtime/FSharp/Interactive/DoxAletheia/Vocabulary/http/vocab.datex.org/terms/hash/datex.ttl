                                                               a owl:Restriction]
                                                               [owl:onProperty datex:parkingRouteName ; 
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                               a owl:Restriction]
                                                               [owl:onProperty datex:dynamicRouteManagement ; 
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
