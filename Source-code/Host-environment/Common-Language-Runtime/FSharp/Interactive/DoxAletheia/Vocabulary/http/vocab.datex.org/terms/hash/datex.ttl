                                                                             a owl:Restriction]
                                                                             [owl:onProperty datex:openlrLastLine ; 
                                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                             a owl:Restriction]) ; 
                                                         a owl:Class],
