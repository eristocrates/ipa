                       rdfs:label "Related object, resource"@en;
                       rdfs:range [owl:unionOf (ebucore:Asset
                                                ebucore:BusinessObject
                                                ebucore:Resource) ; 
                                   a owl:Class];
                       rdfs:subPropertyOf dc11:relation.
ebucore:isRelatedTo a rdf:Property;
                    rdfs:comment """To establish relationships between Assets,
            BusinessObjects, PublicationEvents, Ratings and Resources."""@en;
                    rdfs:domain [owl:unionOf (ebucore:Asset
                                              ebucore:BusinessObject
                                              ebucore:PublicationEvent
                                              ebucore:Resource
                                              ebucore:Rating) ; 
