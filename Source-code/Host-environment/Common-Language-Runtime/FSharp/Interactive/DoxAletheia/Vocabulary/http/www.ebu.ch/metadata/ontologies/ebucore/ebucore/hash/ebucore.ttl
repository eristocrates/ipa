                    rdfs:range [owl:unionOf (ebucore:Asset
                                             ebucore:BusinessObject
                                             ebucore:PublicationEvent
                                             ebucore:Resource
                                             ebucore:Rating) ; 
                                a owl:Class];
                    rdfs:subPropertyOf dc11:relation;
                    owl:equivalentProperty ma-ont:isRelatedTo.
ebucore:isReplacedBy a rdf:Property;
                     rdfs:comment "To identify substitutions."@en;
                     rdfs:domain [owl:unionOf (ebucore:Asset
                                               ebucore:BusinessObject
                                               ebucore:Resource) ; 
                                  a owl:Class];
                     rdfs:label "Replacement"@en;
                     rdfs:range [owl:unionOf (ebucore:Asset
                                              ebucore:BusinessObject
                                              ebucore:Resource) ; 
                                 a owl:Class];
                     rdfs:subPropertyOf dc11:relation.
ebucore:isRequiredBy a rdf:Property;
                     rdfs:comment "To express strong relations between Assets, BusinessObjects or Resources."@en;
                     rdfs:domain [owl:unionOf (ebucore:Asset
                                               ebucore:BusinessObject
                                               ebucore:Resource) ; 
                                  a owl:Class];
                     rdfs:label "Required"@en;
                     rdfs:range [owl:unionOf (ebucore:Asset
                                              ebucore:BusinessObject
                                              ebucore:Resource) ; 
                                 a owl:Class];
                     rdfs:subPropertyOf dc11:relation.
ebucore:isSeasonOf a rdf:Property;
                   rdfs:comment "The Season of a Series."@en;
