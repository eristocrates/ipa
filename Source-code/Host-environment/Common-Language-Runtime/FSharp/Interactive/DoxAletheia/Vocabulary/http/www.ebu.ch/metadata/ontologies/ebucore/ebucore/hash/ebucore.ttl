                     rdfs:domain ebucore:PublicationChannel;
                     rdfs:label "Operator, owner"@en;
                     rdfs:range ebucore:Service;
                     rdfs:subPropertyOf dc11:relation.
ebucore:isOwnedBy a rdf:Property;
                  rdfs:comment """To identify the Agent (Contact/person or
            Organisation) who owns a Service operating a PublicationChannel."""@en;
                  rdfs:domain ebucore:Service;
                  rdfs:label "Owner"@en;
                  rdfs:range ebucore:Agent;
                  rdfs:subPropertyOf dc11:relation.
ebucore:isReferencedBy a rdf:Property;
                       rdfs:comment "To express references across Assets, BusinessObjects or Resources."@en;
                       rdfs:domain [owl:unionOf (ebucore:Asset
                                                 ebucore:BusinessObject
                                                 ebucore:Resource) ; 
