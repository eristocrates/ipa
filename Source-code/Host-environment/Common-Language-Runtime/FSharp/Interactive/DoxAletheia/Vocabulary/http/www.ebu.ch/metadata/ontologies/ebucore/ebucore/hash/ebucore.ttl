@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix bbccore: <http://www.bbc.co.uk/ontologies/coreconcepts/>.
@prefix ebucore: <http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.
@prefix ma-ont: <http://www.w3.org/ns/ma-ont#>.

dc11:Agent a rdfs:Class;
           rdfs:comment "A resource that acts or has the power to act."@en;
           rdfs:label "Agent"@en;
           rdfs:subClassOf owl:Thing.
dc11:contributor a rdf:Property;
                 rdfs:comment "An Agent who has participated in any phase of management of a BusinessObject or Resource."@en;
                 rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                           ebucore:Resource) ; 
                              a owl:Class];
                 rdfs:label "Contributor"@en.
dc11:coverage a rdf:Property;
              rdfs:comment """A property to identify the Events and or
            Locations, all real or fictional, covered by the 
            BusinessObject."""@en;
              rdfs:domain ebucore:BusinessObject;
              rdfs:label "Coverage"@en.
dc11:creator a rdf:Property;
             rdfs:comment "A creator of content such as a director or a producer."@en;
             rdfs:label "Creator"@en;
             rdfs:subPropertyOf dc11:contributor.
dc11:date a rdf:Property;
          rdfs:comment "A date associated with the BusinessObject, Resource or Contact/Person."@en;
          rdfs:label "date"@en;
          rdfs:range xsd:date.
dc11:description a rdf:Property;
                 rdfs:comment "A description of the BusinessObject or Resource."@en;
                 rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                           ebucore:Resource) ; 
                              a owl:Class];
                 rdfs:label "Description".
dc11:format a rdf:Property;
            rdfs:comment "Information about the Format of a Resource."@en;
            rdfs:domain ebucore:Resource;
            rdfs:label "Format"@en.
dc11:identifier a rdf:Property;
                rdfs:comment "An identifier associated with a BusinessObject or a resource."@en;
                rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                          ebucore:Resource) ; 
                             a owl:Class];
                rdfs:label "identifier"@en;
                rdfs:range xsd:anyURI.
dc11:language a rdf:Property;
              rdfs:comment "A Languages used in the BusinessObject or Resource."@en;
              rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                        ebucore:Resource) ; 
                           a owl:Class];
              rdfs:label "Language"@en.
dc11:publisher a rdf:Property;
               rdfs:comment "An Agent involved in the distribution of content."@en;
               rdfs:label "Publisher"@en;
               rdfs:subPropertyOf dc11:contributor.
dc11:relation a rdf:Property;
              rdfs:comment "A relation between BusinessObjects and resources."@en;
              rdfs:label "Relation"@en.
dc11:rights a rdf:Property;
            rdfs:comment "Rights information related to an Asset, aPublicationEvent, a BusinessObject or a resource."@en;
            rdfs:domain [owl:unionOf (ebucore:Asset
                                      ebucore:PublicationEvent) ; 
                         a owl:Class];
            rdfs:label "Rights"@en.
dc11:source a rdf:Property;
            rdfs:comment "To identify a Resource as the source of another Resource."@en;
            rdfs:domain ebucore:Resource;
            rdfs:label "Source"@en.
dc11:subject a rdf:Property;
             rdfs:comment """To associate a Subject or topic addressed by a
            BusinessObject / Resource."""@en;
             rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                       ebucore:Resource) ; 
                          a owl:Class];
             rdfs:label "Subject"@en.
dc11:title a rdf:Property;
           rdfs:comment "The title by which a BusinessObject is known."@en;
           rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                     ebucore:Resource) ; 
                        a owl:Class];
           rdfs:label "Title";
           rdfs:range xsd:string.
dc11:type a rdf:Property;
          rdfs:comment "A concept associated with a BusinessObject or Resource."@en;
          rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                    ebucore:Resource) ; 
                       a owl:Class];
          rdfs:label "type"@en.
dcterms:alternative a rdf:Property;
                    rdfs:comment "An alternative to the title."@en;
                    rdfs:domain ebucore:BusinessObject;
                    rdfs:label "Alternative title"@en;
                    rdfs:range xsd:string.
dcterms:contributor a rdf:Property;
                    rdfs:label "contributor"@en.
dcterms:coverage a rdf:Property;
                 rdfs:label "coverage"@en.
dcterms:creator a rdf:Property;
                rdfs:label "Creator"@en.
dcterms:description a rdf:Property;
                    rdfs:label "Description"@en;
                    rdfs:range xsd:string.
dcterms:format a rdf:Property;
               rdfs:label "format"@en.
dcterms:issued a rdf:Property;
               rdfs:label "Issued"@en;
               rdfs:subPropertyOf dc11:date.
dcterms:language a rdf:Property;
                 rdfs:label "language"@en.
dcterms:modified a rdf:Property;
                 rdfs:label "Modified"@en;
                 rdfs:subPropertyOf dc11:date.
dcterms:publisher a rdf:Property;
                  rdfs:label "Publisher"@en.
dcterms:relation a rdf:Property;
                 rdfs:label "Relation"@en.
dcterms:rights a rdf:Property;
               rdfs:label "Rights"@en.
dcterms:source a rdf:Property;
               rdfs:label "Source"@en.
dcterms:subject a rdf:Property;
                rdfs:label "Subject"@en.
dcterms:title a rdf:Property;
              rdfs:label "Title"@en;
              rdfs:range xsd:string.
dcterms:type a rdf:Property;
             rdfs:label "type"@en.
bbccore:Event a rdfs:Class;
              rdfs:comment "Music events, historic events, sports events, politics events, e.t.c."@en;
              rdfs:label "Event"@en;
              rdfs:subClassOf ebucore:Event.
bbccore:Organisation a rdfs:Class;
                     rdfs:comment "E.g., Businesses."@en;
                     rdfs:label "Organisation"@en;
                     rdfs:subClassOf ebucore:Organisation.
bbccore:Person a rdfs:Class;
               rdfs:comment "all types of people such as politicians, athletes, historic figures, contributors in programmes e.t.c."@en;
               rdfs:label "Person"@en;
               rdfs:subClassOf ebucore:Contact.
bbccore:Place a rdfs:Class;
              rdfs:comment "Another type of location."@en;
              rdfs:label "Place"@en;
              rdfs:subClassOf ebucore:Location.
bbccore:Theme a rdfs:Class;
              rdfs:comment "This concept is used to represent intangible things or abstract concepts. For example, Financial Crisis, Midwifery, Happiness."@en;
              rdfs:label "Theme"@en;
              rdfs:subClassOf ebucore:Keyword.
bbccore:dateOfBirth a rdf:Property;
                    rdfs:comment "The date when a Contact/Person is born."@en;
                    rdfs:domain ebucore:Contact;
                    rdfs:label "Date of birth"@en;
                    rdfs:subPropertyOf dc11:date.
bbccore:dateOfDeath a rdf:Property;
                    rdfs:comment "The date when a Contact/Person has passed away."@en;
                    rdfs:domain ebucore:Contact;
                    rdfs:label "Date of death"@en;
                    rdfs:subPropertyOf dc11:date.
bbccore:gender a rdf:Property;
               rdfs:comment "The gender of a person e.g. male or female."@en;
               rdfs:domain ebucore:Contact;
               rdfs:label "Gender"@en;
               rdfs:range xsd:string.
bbccore:placeOfBirth a rdf:Property;
                     rdfs:comment "The place where a person is born."@en;
                     rdfs:domain ebucore:Contact;
                     rdfs:label "Place of birth"@en.
bbccore:placeOfDeath a rdf:Property;
                     rdfs:comment "The place where a person has passed away."@en;
                     rdfs:domain ebucore:Contact;
                     rdfs:label "Place of death"@en.
bbccore:primaryTopic a rdf:Property;
                     rdfs:comment "The main subject of interest."@en;
                     rdfs:label "Primary topic"@en;
                     rdfs:subPropertyOf dc11:description.
bbccore:slug a rdf:Property;
             rdfs:comment "One or more keywords."@en;
             rdfs:label "Slug"@en;
             rdfs:subPropertyOf dc11:description.
<http://www.ebu.ch/metadata/ontologies/ebucore/ebucore> ccrel:licence "http://creativecommons.org/licenses/by-sa/3.0/";
                                                        dc11:contributor "Glenn Clatworthy, PBS"@en-us,
                                                                         "Michael J. Giarlo, Penn State University"@en-us,
                                                                         "Drew Myers, WGBH"@en-us,
                                                                         "Casey Davis, WGBH"@en-us,
                                                                         "Christophe Debruyne, RIA"@ie,
                                                                         "Jack Brighton, WILL Public Media"@en-us,
                                                                         "Cliff Ingham, City of Bloomington"@en-us,
                                                                         "Hugo Manguinhas, Europeana"@nl,
                                                                         "Valentine Charles, Europeana"@nl,
                                                                         "Julie Hardesty, Indian University Library"@en-us,
                                                                         "Rebecca Fraimow, WGBH"@en-us,
                                                                         "Valerie J. Miller, PBS"@en-us,
                                                                         "Kara vam Malssen, AV Preserve"@en-us,
                                                                         "Rebecca Guenther, Rebecca Guenther Consulting"@en-us,
                                                                         "Peggy Griesinger, George Mason University Libraries"@en-us,
                                                                         "Karen Cariani, WGBH"@en-us,
                                                                         "Chuck McCallum, WGBH"@en-us,
                                                                         "Knut-Olav Hoven, NRK"@no,
                                                                         "Robert Engels, NRK"@no,
                                                                         "Laurence Cook, metaCirque"@en-us,
                                                                         "Tormod Vaervagen, NRK"@no,
                                                                         "Adam Wead, Penn State University"@en-us,
                                                                         "Sadie Roosa, WGBH"@en-us;
                                                        dc11:creator "Jean Pierre Evain, EBU"@ch;
                                                        dc11:description "Guidelines: for the purpose of flexibility and interoperability with a wider range of implementations, some properties purposefully do not have a range and accept either a resource or a literal.  When a resource is used, it is recommended to reuse objects defined in the model (e.g. pair hasEvent/Event or hasRole/Role). Example 1: x hasRole 'actor'. Example 2: x hasRole _:Role_1 (a reference to the Concept Id from a SKOS Role vocabulary defined in the ontology)."@en,
                                                                         "Note to implementers: The EBUCore ontology is used by a variety of users with different needs. Several EBUCore properties have no range to allow different implementations using entities or literals. As an implementer, it is your choice to go for one or the other for each property to have consistent expectations when parsing individuals. EBUCore also provides different classes defined as subclasses of skos:Concept. You can use these classes as entities in range of several properties currently left without range. EBUCore is expressed in RDF in order to facilitate such modelling and flexibility. As a consequence, propoerties appear in the documentation as annotation properties."@en,
                                                                         "The EBUCore has been designed to make users benefit from the flexibility of RDF to adapt the names of Classes and properties to their respective needs. This means users are welcome to add their own subclasses (e.g. to define the most appropriate BusinessObjects or Resources or Agents) and subproperties."@en,
                                                                         "The development of the EBUCore ontology is now a joint effort of the EBUCore and PBCore communities.";
                                                        dc11:publisher "European Broadcasting Union (EBU)"@ch;
                                                        dc11:rights "Copyright 2015 EBU"@en;
                                                        dc11:title "EBUCore - the Dublin Core for media"@en;
                                                        dcterms:issued "2013-01-01"^^xsd:date;
                                                        dcterms:modified "2015-08-04"^^xsd:date;
                                                        vann:preferredNamespaceUri "http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#";
                                                        a owl:Ontology;
                                                        owl:backwardCompatibleWith <http://www.ebu.ch/metadata/ontologies/ebucore/20150122/ebucore_2015_05_20.rdf>;
                                                        owl:imports <http://www.w3.org/2004/02/skos/core>;
                                                        owl:priorVersion <http://www.ebu.ch/metadata/ontologies/ebucore/20150122/ebucore_2015_05_20.rdf>;
                                                        owl:versionInfo """Improve the relations around the notions of \"hasContributor\", \"Character\", \"Cast\"."""@en,
                                                                        "EBUCore based on Dublin Core + SKOS + some BBC Core Concepts + basic FOAF properties  + equivalences to W3C MA-ONT"@en,
                                                                        "Version 1.6"@en,
                                                                        "PBCore updates:  dateBroadcast, dateLicenced, endLicencedate, dateDistributed, dateDeleted, dateIngested, dateMigrated, dateNormalized, dateTransferred, dateValidated, shotlog, folksonomy, clonedTo/isClonedFrom, dubbedTo/isDubbedfrom, derivedTo/isDerivedFrom, playbackSpeed, framesPerSecond, inchesPerSecond, hasGeneration, hasStandard, dimensions."@en,
                                                                        "hasCaptioning, hasSigning, hasSubtitling: the range is either a resource or a literal/boolean indicating the presence/absence thereof"@en,
                                                                        "Added eventPeriod property."@en,
                                                                        "New hasAudioDescription property pointing to a resource (new AudioDescription as subclass of audioTrack) or a presence flag"@en,
                                                                        "Leftovers from object audio components removed."@en,
                                                                        """Add \"Feature\" as sub-class of EditorialObject"""@en,
                                                                        "More consistency on opening property ranges to allow resources or literals."@en;
                                                        status:term_status "stable"@en.
ebucore:AccessConditions a rdfs:Class;
                         rdfs:comment "The conditions under which content can be accessed."@en;
                         rdfs:label "Access conditions"@en;
                         rdfs:subClassOf ebucore:Rights.
ebucore:Affiliation a rdfs:Class;
                    rdfs:comment "An Organisation to which a Contact is affiliated (with period of validity)."@en;
                    rdfs:label "Affiliation"@en;
                    rdfs:subClassOf ebucore:Organisation.
ebucore:Agent a rdfs:Class;
              rdfs:comment "A person / contact or organisation."@en;
              rdfs:label "Agent"@en;
              rdfs:subClassOf foaf:Agent.
ebucore:AncillaryData a rdfs:Class;
                      rdfs:comment """Any ancillary data provided with the content
            other than captioning and subtitling."""@en;
                      rdfs:label "Ancillary data"@en;
                      rdfs:subClassOf ebucore:DataTrack.
ebucore:AncillaryDataFormat a rdfs:Class;
                            rdfs:comment """To define the format of AncillaryData such as
            legacy data used to be carried in vertical blanking intervals. This is provided as free
            text in an annotation label or as an identifier pointing to a term in a classification
            scheme."""@en;
                            rdfs:label "Ancillary data format"@en;
                            rdfs:subClassOf ebucore:DataFormat.
ebucore:Annotation a rdfs:Class;
                   rdfs:comment """A set of descriptive or technical metadata.
            Annotation can also be made in the form of a document or media resource such as an or
            video audio file . An annotation can exist on its own and be related / associated to
            other editorial objects or resources."""@en;
                   rdfs:label "Annotation"@en;
                   rdfs:subClassOf owl:Thing.
ebucore:Asset a rdfs:Class;
              rdfs:comment """The Class \"Asset\" is an
            object to which an identifier will be associated at commissioning. It will serve as a
            central reference point to manage rights associated to EditorialObjects, Resources,
            MediaResources or Essences, and PublicationEvents (distribution and exploitation
            conditions)."""@en;
              rdfs:label "Asset"@en;
              rdfs:subClassOf owl:Thing.
ebucore:AudienceRating a rdfs:Class;
                       rdfs:comment """The audience by which the Resource can be
            seen according to ratings like MPAA  (http://en.wikipedia.org/wiki/Motion_picture_rating_system) or other organisational / national / local standards."""@en;
                       rdfs:label "Audience rating"@en;
                       rdfs:subClassOf ebucore:Rating.
ebucore:AudioChannel a rdfs:Class;
                     rdfs:comment """An audioChannel represents a single sequence of audio samples. It
				is sub-divided in the time domain into audioBlocks, which is must contain at
				least one of. The typeDefintion of the audioChannel format specifies the type of
				audio it is describing, and also determines which parameters are used within its
				audioBlock children.""";
                     rdfs:label "Audio channel";
                     rdfs:subClassOf ebucore:Essence.
ebucore:AudioContent a rdfs:Class;
                     rdfs:comment """An audioContent defines one component of a programme (e.g. background
				music), its association with an audioGroup (e.g. a 2.0 audioPackFormat of
				audioChannelFormats for stereo reproduction), its association with an
				audioStreamFormat, and its set of loudness parameters."""@en;
                     rdfs:label "Audio content"@en;
                     rdfs:subClassOf ebucore:AudioProgramme.
ebucore:AudioDescription a rdfs:Class;
                         rdfs:label "Audio description";
                         rdfs:subClassOf ebucore:AudioTrack;
                         skos:prefLabel "Audio description".
ebucore:AudioEncodingFormat a rdfs:Class;
                            rdfs:comment "The encoding format for the audio."@en;
                            rdfs:label "Audio encoding format"@en;
                            rdfs:subClassOf ebucore:EncodingFormat.
ebucore:AudioFormat a rdfs:Class;
                    rdfs:comment """The technical characteristics of an
            AudioResource such as the sampleRate. This is provided as free text in an annotation
            label or as an identifier pointing to a term in a classification scheme e.g.
            http://www.ebu.ch/metadata/ontologies/skos/ebu_AudioFormatCodeCS.rdf."""@en;
                    rdfs:label "Audio Format"@en;
                    rdfs:subClassOf ebucore:Format.
ebucore:AudioPackFormat a rdfs:Class;
                        rdfs:comment "The format of an AudioPack. Examples of audioPackFormats are 'stereo' and '5.1' for channel-based formats."@en;
                        rdfs:label "Audio pack format"@en;
                        rdfs:subClassOf ebucore:AudioFormat.
ebucore:AudioProgramme a rdfs:Class;
                       rdfs:comment """A set of one or more audioContent that derive from the same material,
				i.e. an audioMultiplex, and the definition of its multiplexed audioContents (e.g.
				foreground and commentary, background music)."""@en;
                       rdfs:label "Audio programme"@en;
                       rdfs:subClassOf ebucore:Programme.
ebucore:AudioStream a rdfs:Class;
                    rdfs:comment "An audioStreamFormat describes a decodable signal - PCM signal or a Dolby E stream for example. It is composed of one or more AudioTracks."@en;
                    rdfs:label "Audio stream"@en;
                    rdfs:subClassOf ebucore:Stream.
ebucore:AudioStreamFormat a rdfs:Class;
                          rdfs:comment "The format of an AudioStream, e.g. PCM_FrontLeft or Dolby E."@en;
                          rdfs:label "Audio stream format"@en;
                          rdfs:subClassOf ebucore:AudioFormat.
ebucore:AudioTrack a rdfs:Class;
                   rdfs:comment """An audioTrack object defines a component of an audioStream.
				A single set of samples or data in the storage medium."""@en,
                                """Represents a physical container or carrier to hold an audio stream. This
				should be usually defined by many attributes such as ID, format (e.g. 48 kHz/24
				bits), linkage information (e.g. odd/even)…"""@en,
                                """An audioTrack is the basic audio data container of a medium. Attribute is
				an unambiguous reference to this container in a given medium."""@en;
                   rdfs:label "Audio track"@en;
                   rdfs:subClassOf ebucore:Track.
ebucore:AudioTrackFormat a rdfs:Class;
                         rdfs:comment "The format of an AudioTrack e.g. PCM_FrontLeft."@en;
                         rdfs:label "Audio track format"@en;
                         rdfs:subClassOf ebucore:AudioFormat.
ebucore:BibliographicalObject a rdfs:Class;
                              rdfs:label "Bibliographical object";
                              rdfs:subClassOf ebucore:BusinessObject;
                              skos:prefLabel "Bibliographical object".
ebucore:Brand a rdfs:Class;
              rdfs:comment """A group of EditorialObjects having a Brand as a
            common denominator""";
              rdfs:label "Brand";
              rdfs:subClassOf ebucore:Group.
ebucore:BusinessObject a rdfs:Class;
                       rdfs:comment """An image, a document, an annotation
            (descriptive textual metadata or audio/video tag), a tag (time related in audiovisual
            media resources), or an audiovisual media resource (optionally composed of one or more
            fragment / part and / or audio, video data tracks). Other types of BusinessObjects may
            be defined as subclasses."""@en;
                       rdfs:label "Business Object"@en;
                       rdfs:subClassOf owl:Thing.
ebucore:Captioning a rdfs:Class;
                   rdfs:comment """To signal the presence of hard of hearing
            captioning."""@en;
                   rdfs:label "Captioning"@en;
                   rdfs:subClassOf ebucore:DataTrack.
ebucore:CaptioningFormat a rdfs:Class;
                         rdfs:comment """To define the format of captioning.
            Captioning's main use isfor hard of hearing transcription. This is provided as
            free text in an annotation label or as an identifier pointing to a term in a
            classification scheme."""@en;
                         rdfs:label "Captioning format"@en;
                         rdfs:subClassOf ebucore:DataFormat.
ebucore:Cast a rdfs:Class;
             rdfs:comment """A member of the cast list (a list of performers/actors and associated fictitious
            characters)."""@en;
             rdfs:label "Cast member"@en;
             rdfs:subClassOf ebucore:Agent.
ebucore:Character a rdfs:Class;
                  rdfs:comment "E.g. a fictitious contact / person."@en;
                  rdfs:label "Character"@en;
                  rdfs:subClassOf ebucore:Agent.
ebucore:ClosedCaptions a rdfs:Class;
                       rdfs:comment """Closed captioning is provided as separate
            content."""@en;
                       rdfs:label "Closed caption"@en;
                       rdfs:subClassOf ebucore:Captioning.
ebucore:ClosedSubtitling a rdfs:Class;
                         rdfs:comment """Closed subtitles are provided as separate
            content."""@en;
                         rdfs:label "Closed subtitling"@en;
                         rdfs:subClassOf ebucore:Subtitling.
ebucore:Codec a rdfs:Class;
              rdfs:comment "To provide information on a codec."@en;
              rdfs:label "Codec"@en;
              rdfs:subClassOf skos:Concept.
ebucore:Collection a rdfs:Class;
                   rdfs:comment """A group of EditorialObjects. There can be many
            types of collections for which specific sub-classes should be defined. In the worl of
            archives, A collection corresponds to all items belonging to an individual /
            collector.""";
                   rdfs:label "Collection";
                   rdfs:subClassOf ebucore:Group.
ebucore:ColourSpace a rdfs:Class;
                    rdfs:comment """The CoulourSpace of a VideoResource. A
            ColourSpace is defined as free text in an annotation label or as an identifier pointing
            to a term in a classification scheme such as
            http://www.ebu.ch/metadata/ontologies/skos/ebu_ColourCodeCS.rdf."""@en;
                    rdfs:label "Colour space"@en;
                    rdfs:subClassOf ebucore:Format.
ebucore:Component a rdfs:Class;
                  rdfs:comment "A component e.g. audio, video, data or else or a MediaResource or Essence."@en;
                  rdfs:label "Component"@en;
                  rdfs:subClassOf ebucore:Essence.
ebucore:Contact a rdfs:Class;
                rdfs:comment "A physical person."@en;
                rdfs:label "Contact"@en;
                rdfs:subClassOf ebucore:Agent.
ebucore:ContainerFormat a rdfs:Class;
                        rdfs:comment """The container or wrapper format used to package
            audio, video and data components of a Mediaresource. The format is defined as free text
            or pointing at a term in a classification scheme e.g.
            http://www.ebu.ch/metadata/ontologies/skos/ebu_ContainerFormatCS.rdf."""@en;
                        rdfs:label "Container format"@en;
                        rdfs:subClassOf ebucore:Format.
ebucore:ContainerMimeType a rdfs:Class;
                          rdfs:comment """The definition of the container if available as
            a MIME type. This is provided as free text in an annotation label or as an identifier
            pointing to a term in a classification scheme. For more information:
            http://www.iana.org/assignments/media-types/application/index.html."""@en;
                          rdfs:label "Container Mime type"@en;
                          rdfs:subClassOf ebucore:Format.
ebucore:Copyright a rdfs:Class;
                  rdfs:comment """To provide a copyright
            statement."""@en;
                  rdfs:label "Copyright"@en;
                  rdfs:subClassOf ebucore:Rights.
ebucore:CoverageRestrictions a rdfs:Class;
                             rdfs:comment """To provide information on possible restrictions
            regarding the temporal and spatial coverage for publication."""@en;
                             rdfs:label "Coverage restrictions"@en;
                             rdfs:subClassOf ebucore:Rights.
ebucore:Crew a rdfs:Class;
             rdfs:comment "Crew member."@en;
             rdfs:label "Crew member"@en;
             rdfs:subClassOf ebucore:Agent.
ebucore:DID a rdf:Property;
            rdfs:comment """The Data Identifier word (along with the SDID,
            if used), indicates the type of ancillary data that the packet corresponds
            to."""@en;
            rdfs:domain ebucore:AncillaryData;
            rdfs:label "DID"@en;
            rdfs:range xsd:integer.
ebucore:DataFormat a rdfs:Class;
                   rdfs:comment """To provide addtional technical information on
            the characteristics of data streams in a MediaResource including but not limited to
            AncillaryData, Subtilting and Captioning. Additional specific data format may be defined
            as subclasses of DataFormat."""@en;
                   rdfs:label "Data format"@en;
                   rdfs:subClassOf ebucore:Format.
ebucore:DataTrack a rdfs:Class;
                  rdfs:comment """Ancillary data track e.g. ¨captioning\"
            or \"subtitling\" in addition to video and audio tracks."""@en;
                  rdfs:label "Data track"@en;
                  rdfs:subClassOf ebucore:Track.
ebucore:Department a rdfs:Class;
                   rdfs:comment """A department within and
            organisation."""@en;
                   rdfs:label "Department"@en;
                   rdfs:subClassOf ebucore:Organisation.
ebucore:DepictedEvent a rdfs:Class;
                      rdfs:comment """A DepictedEVent is fictitious or historical or
            other sort of Event that the content of the BusinessObject or resource relates
            to."""@en;
                      rdfs:label "Depicted Event"@en;
                      rdfs:subClassOf bbccore:Event.
ebucore:Disclaimer a rdfs:Class;
                   rdfs:comment """To provide a disclaimer of any
            form."""@en;
                   rdfs:label "Disclaimer"@en;
                   rdfs:subClassOf ebucore:Rights.
ebucore:Document a rdfs:Class;
                 rdfs:comment """To describe a publication in the form of a
            document e.g. a html webpage (news item) or a pdf document e.g. a script."""@en;
                 rdfs:label "Document"@en;
                 rdfs:subClassOf ebucore:Resource.
ebucore:DocumentFormat a rdfs:Class;
                       rdfs:comment """To provide technical information about the
            format of a document such as the orientation. This is provided as free text in an
            annotation label or as an identifier pointing to a term in a classification
            scheme."""@en;
                       rdfs:label "Document format"@en;
                       rdfs:subClassOf ebucore:Format.
ebucore:Dopesheet a rdfs:Class;
                  rdfs:comment "Provides additional information about a NewsItem, e.g. date and place, subject."@en;
                  rdfs:label "Dopesheet"@en;
                  rdfs:subClassOf ebucore:Document.
ebucore:EditorialObject a rdfs:Class;
                        rdfs:comment """In the audiovisual domain, the Class
            EditorialObject transforms a commissioned concept into an editorial definition of a
            MediaResource before fabrication (in the Production Domain) and Distribution (in the
            Distribution Domain). An EditorialObject is a set of descriptive metadata summarising
            e.g. editing decisions. An EditorialObject can also be a part of an EditorialObject,
            which is defined by its start time and duration. An EditorialObject can also be a group
            of EditorialObjects. For example a series composed of episodes is defined as an
            EditorialObject."""@en;
                        rdfs:label "Editorial Object"@en;
                        rdfs:subClassOf ebucore:BusinessObject.
ebucore:EncodingFormat a rdfs:Class;
                       rdfs:comment """To provide a definition of the encoding format
            for audio and video. This is provided as free text in an annotation label or as an
            identifier pointing to a term in a classification scheme e.g.
            http://www.ebu.ch/metadata/ontologies/skos/ebu_AudioCompressionCodeCS.rdf or
            http://www.ebu.ch/metadata/ontologies/skos/ebu_VideoCompressionCodeCS.rdf."""@en;
                       rdfs:label "Encoding"@en;
                       rdfs:subClassOf ebucore:Format.
ebucore:Essence a rdfs:Class;
                rdfs:comment """In some audiovisual standardisation groups,
            Essence is preferred to MediaResource. In also has subclasses well known as MediaObject
            clustered in AudioObjects and VideoObjects."""@en;
                rdfs:label "Essence"@en;
                rdfs:subClassOf ebucore:MediaResource.
ebucore:Event a rdfs:Class;
              rdfs:comment """Additional types of event shall be defined as
            new sub-classes of event."""@en,
                           """An event related to the media resource, e.g.
            depicted in the resource (possibly fictional), etc."""@en;
              rdfs:label "Event"@en;
              rdfs:subClassOf owl:Thing.
ebucore:ExploitationIssues a rdfs:Class;
                           rdfs:comment """To highlight potential exploitation
            issues."""@en;
                           rdfs:label "Exploitation issues"@en;
                           rdfs:subClassOf ebucore:Rights.
ebucore:Feature a rdfs:Class;
                rdfs:label "Feature";
                rdfs:subClassOf ebucore:EditorialObject;
                skos:prefLabel "Feature".
ebucore:FileFormat a rdfs:Class;
                   rdfs:comment """A file format for Resources other than
            audiovisual resources. The format is defined as free text or pointing at a term in a
            classification scheme e.g.
            http://www.ebu.ch/metadata/ontologies/skos/ebu_FileFormatCS.rdf."""@en;
                   rdfs:label "File format"@en;
                   rdfs:subClassOf ebucore:Format.
ebucore:Format a rdfs:Class;
               rdfs:comment """The format provides technical information on
            the format of a Resource. A BusinessObject can be instantiated in a variety of Resources
            each in a particular Format. Other specific data formats may be defined as subclasses of
            format."""@en;
               rdfs:label "Format"@en;
               rdfs:subClassOf skos:Concept.
ebucore:Generation a rdfs:Class;
                   rdfs:comment "Identifies the generation of a version of a resource, i.e. master, edit master, distribution copy, etc."@en;
                   rdfs:label "Generation";
                   rdfs:subClassOf ebucore:Format;
                   skos:prefLabel "Generation".
ebucore:Genre a rdfs:Class;
              rdfs:comment """This class shall be used to provide information
            on the genre of the BusinessObject or Resource. This is provided as free text in an
            annotation label or as an identifier pointing to a term in a classification scheme e.g.
            http://www.ebu.ch/metadata/ontologies/skos/ebu_ContentGenreCS.rdf or
            http://www.ebu.ch/metadata/ontologies/skos/ebu_EditorialFormatCodeCS.rdf."""@en;
              rdfs:label "Genre"@en;
              rdfs:subClassOf ebucore:Type.
ebucore:Group a rdfs:Class;
              rdfs:comment """To define a collection / group of media
            resources, for example a series made of episodes."""@en;
              rdfs:label "Group"@en;
              rdfs:subClassOf ebucore:EditorialObject.
ebucore:IPRRestrictions a rdfs:Class;
                        rdfs:comment """To provide information on intellectual
            property."""@en;
                        rdfs:label "IPR restrictions"@en;
                        rdfs:subClassOf ebucore:Rights.
ebucore:Image a rdfs:Class;
              rdfs:comment """A still image / thumbnail / key frame / logo
            related to the media resource or being the media resource itself""";
              rdfs:label "Image";
              rdfs:subClassOf ebucore:BusinessObject.
ebucore:ImageFormat a rdfs:Class;
                    rdfs:comment """To provide technical information about the
            format of an image such as the orientation. This is provided as free text in an
            annotation label or as an identifier pointing to a term in a classification
            scheme."""@en;
                    rdfs:label "Image format"@en;
                    rdfs:subClassOf ebucore:Format.
ebucore:Item a rdfs:Class;
             rdfs:comment "An item e.g. newsItem or sportItem"@en;
             rdfs:label "Item"@en;
             rdfs:subClassOf ebucore:EditorialObject.
ebucore:KeyCareerEvent a rdfs:Class;
                       rdfs:label "Key career event";
                       rdfs:subClassOf ebucore:KeyEvent.
ebucore:KeyEvent a rdfs:Class;
                 rdfs:label "Key event";
                 rdfs:subClassOf bbccore:Event.
ebucore:KeyPersonalEvent a rdfs:Class;
                         rdfs:label "Key personal event";
                         rdfs:subClassOf ebucore:KeyEvent.
ebucore:Keyframe a rdfs:Class;
                 rdfs:comment """A key frame is a frame extarcted from video,
            e.g. representative of a part of a MediaResource."""@en;
                 rdfs:label "key frame"@en;
                 rdfs:subClassOf ebucore:Picture.
ebucore:Keyword a rdfs:Class;
                rdfs:comment """To proivde keywords and define key concepts
            illustrating the content of the Resource or EditorialObject. This is provided as free
            text in an annotation label or as an identifier pointing to a term in a classification
            scheme."""@en;
                rdfs:label "Keyword"@en;
                rdfs:subClassOf skos:Concept.
ebucore:Language a rdfs:Class;
                 rdfs:comment """To provide information on languages present in
            the BusinessObject and its purpose. This is provided as free text in an annotation label
            or as an identifier pointing to a term in a classification scheme.Other language
            specific types may be added as subclasses of language."""@en;
                 rdfs:label "Language"@en;
                 rdfs:subClassOf skos:Concept.
ebucore:Location a rdfs:Class;
                 rdfs:comment """A type of location is defined as a sub-class of 
            location."""@en,
                              """A location related to the media resource, e.g.
            depicted in the resource (possibly fictional) or where the resource was created
            (shooting location), etc."""@en,
                              """This is provided as free text in an annotation
            label or as an identifier pointing to a term in a classification scheme."""@en;
                 rdfs:label "Location";
                 rdfs:subClassOf owl:Thing.
ebucore:Logo a rdfs:Class;
             rdfs:comment """A Logo allows to visually identify an
            organisation, publicationService, publicationChannel, or ratings /
            parentalGuidance"""@en;
             rdfs:label "Logo"@en;
             rdfs:subClassOf ebucore:Picture.
ebucore:MediaFragment a rdfs:Class;
                      rdfs:comment "A MediaFragment is a temporal or spatial segment of a resource identified by a MediaGragment URI (http://www.w3.org/2008/WebVideo/Fragments/WD-media-fragments-spec/)."@en;
                      rdfs:label "Media Fragment"@en;
                      rdfs:subClassOf ebucore:MediaResource.
ebucore:MediaResource a rdfs:Class;
                      rdfs:comment """The use of MediaResource is reserved to
            audiovisual content."""@en;
                      rdfs:label "Media Resource"@en;
                      rdfs:subClassOf ebucore:Resource.
ebucore:Medium a rdfs:Class;
               rdfs:comment """To provide information on the medium formats in
            which the resource is available. This is provided as free text in an annotation label or
            as an identifier pointing to a term in a classification scheme."""@en;
               rdfs:label "Medium"@en;
               rdfs:subClassOf ebucore:Format.
ebucore:MetadataTrack a rdfs:Class;
                      rdfs:label "Metadata track";
                      rdfs:subClassOf ebucore:Track;
                      skos:prefLabel "Metadata track".
ebucore:MimeType a rdfs:Class;
                 rdfs:comment """The definition of the container if available as
            a MIME type. This is provided as free text in an annotation label or as an identifier
            pointing to a term in a classification scheme. For more information:
            http://www.iana.org/assignments/media-types/index.html."""@en;
                 rdfs:label "Mime type"@en;
                 rdfs:subClassOf ebucore:Format.
ebucore:NewsItem a rdfs:Class;
                 rdfs:comment "A NewsItem aggregates all information about a particular news event."@en;
                 rdfs:label "News Item"@en;
                 rdfs:subClassOf ebucore:Item.
ebucore:ObjectType a rdfs:Class;
                   rdfs:comment """To specify the type of BusinessObject e.g. and
            EditorialObject of type \"programme\" or clip\". This is
            provided as free text in an annotation label or as an identifier pointing to a term in a
            classification scheme e.g.
            http://www.ebu.ch/metadata/ontologies/skos/ebu_ObjectTypeCodeCS.rdf."""@en;
                   rdfs:label "Object type"@en;
                   rdfs:subClassOf ebucore:Type.
ebucore:OpenCaptions a rdfs:Class;
                     rdfs:comment """Open Captions are burned in the
            image."""@en;
                     rdfs:label "Open captions"@en;
                     rdfs:subClassOf ebucore:Captioning.
ebucore:OpenSubtitling a rdfs:Class;
                       rdfs:comment """Open subtitles are burned in the
            image."""@en;
                       rdfs:label "Open subtitling"@en;
                       rdfs:subClassOf ebucore:Subtitling.
ebucore:Organisation a rdfs:Class;
                     rdfs:comment "An organisation (business, corporation, federation, etc.) or moral agent (gvernment body)."@en;
                     rdfs:label "Organisation"@en;
                     rdfs:subClassOf ebucore:Agent.
ebucore:OriginalLanguage a rdfs:Class;
                         rdfs:comment """The original language in which the
            BusinessObject or Resource has been created and released. This is provided as free text
            in an annotation label or as an identifier pointing to a term in a classification
            scheme.""";
                         rdfs:subClassOf ebucore:Language.
ebucore:Part a rdfs:Class;
             rdfs:comment """One of more media fragment (audio, video, data)
            composing an audiovisual media resource. In other ontolgies fragment is often referred
            to e.g. as a 'part' or 'segment' or
            'fragment'."""@en,
                          """A Fragment is a particular section of a
            MediaResource identified by a start and end time or duration. Fragment can also be
            called segment or part."""@en;
             rdfs:label "Part, Fragment, Segment"@en;
             rdfs:subClassOf ebucore:EditorialObject.
ebucore:Pictogram a rdfs:Class;
                  rdfs:comment "A visual / graphical representation of a concept."@en;
                  rdfs:label "Pictogram"@en;
                  rdfs:subClassOf ebucore:Picture.
ebucore:Picture a rdfs:Class;
                rdfs:comment "A photography, a logo, a pictogram, etc."@en;
                rdfs:label "Picture"@en;
                rdfs:subClassOf ebucore:Resource.
ebucore:Programme a rdfs:Class;
                  rdfs:comment """An EditorialObject corresponding to a
            MediaResource ready for publication."""@en;
                  rdfs:label "Programme"@en;
                  rdfs:subClassOf ebucore:EditorialObject.
ebucore:PublicationChannel a rdfs:Class;
                           rdfs:comment """The name of the channel through which a
            Resource has been published as a PublicationEvent. A PublicationChannel can use a
            variety of medias e.g. broadcast or online."""@en;
                           rdfs:label "Publication Channel"@en;
                           rdfs:subClassOf owl:Thing.
ebucore:PublicationEvent a rdfs:Class;
                         rdfs:comment """To describe any manifestation of a media
            resource on any media (live, on demand, catch-up TV, etc.) and the appropriate
            PublciationChannel."""@en;
                         rdfs:label "Publication Event"@en;
                         rdfs:subClassOf owl:Thing.
ebucore:PublicationHistory a rdfs:Class;
                           rdfs:comment """A collection of PublicationEvents through which
            a resource has been published."""@en;
                           rdfs:label "Publication History"@en;
                           rdfs:subClassOf owl:Thing.
ebucore:PublicationPlanning a rdfs:Class;
                            rdfs:comment "A collection of PublicationEvents organised as a PublicationPlanning."@en;
                            rdfs:label "Publication History"@en;
                            rdfs:subClassOf owl:Thing.
ebucore:RadioProgramme a rdfs:Class;
                       rdfs:comment """A programme for distribution on radio
            channels."""@en;
                       rdfs:label "Radio Programme"@en;
                       rdfs:subClassOf ebucore:Programme.
ebucore:Rating a rdfs:Class;
               rdfs:comment """All the information about the rating/evaluation
            given to a media resource by an Agent i.e. a person/Contact or
            Organisation."""@en,
                            """This is provided as free text in an annotation
            label or as an identifier pointing to a term in a classification scheme."""@en;
               rdfs:label "Rating"@en;
               rdfs:subClassOf owl:Thing.
ebucore:Resource a rdfs:Class;
                 rdfs:comment """A manifestation of a
            BusinessObject."""@en;
                 rdfs:label "Resource"@en;
                 rdfs:subClassOf owl:Thing.
ebucore:Rights a rdfs:Class;
               rdfs:comment """To provide information on the rights, including
            intellectual property, related to a BusinessObject or Resource."""@en;
               rdfs:label "Rights"@en;
               rdfs:subClassOf owl:Thing.
ebucore:RightsClearance a rdfs:Class;
                        rdfs:comment """To signal that rights have been cleared (or
            not)"""@en;
                        rdfs:subClassOf ebucore:Rights.
ebucore:Role a rdfs:Class;
             rdfs:comment """To define the role / action of an agent. This
            is provided as free text in an annotation label or as an identifier pointing to a term
            in a classification scheme."""@en;
             rdfs:label "Role"@en;
             rdfs:subClassOf skos:Concept.
ebucore:SDID a rdf:Property;
             rdfs:comment """Secondary data identification word for
            ancillary data. Send mode identifier. An identifier which indicates the transmission
            timing for closed caption data."""@en;
             rdfs:domain ebucore:AncillaryData;
             rdfs:label "SDID"@en;
             rdfs:range xsd:integer.
ebucore:Season a rdfs:Class;
               rdfs:comment """A series can be composed of one or more seasons
            clustering a certain number of episodes. Fro this reason, seasons are related to series
            using the isRelatedTo property.""";
               rdfs:label "Season";
               rdfs:subClassOf ebucore:Group.
ebucore:Series a rdfs:Class;
               rdfs:comment """Series is a particular type of collection. TV
            or Radio Series are composed of Episodes.""";
               rdfs:label "Series";
               rdfs:subClassOf ebucore:Group.
ebucore:Service a rdfs:Class;
                rdfs:comment """A service is the umbrella under which one or
            more PublicationChannel is operated."""@en;
                rdfs:label "Service"@en;
                rdfs:subClassOf owl:Thing.
ebucore:Signing a rdfs:Class;
                rdfs:comment """To signal the presence of Signing for hard of
            hearing users. The type of Signing (e.g. incursted in or else) or language of Signing
            can be specified using the appropriate properties."""@en;
                rdfs:label "Signing"@en;
                rdfs:subClassOf ebucore:VideoTrack.
ebucore:SigningFormat a rdfs:Class;
                      rdfs:comment """To provide additional information on the
            signing format. This is provided as free text in an annotation label or as an identifier
            pointing to a term in a classification scheme."""@en;
                      rdfs:label "Signing format"@en;
                      rdfs:subClassOf ebucore:VideoFormat.
ebucore:SportItem a rdfs:Class;
                  rdfs:comment "A SportItem aggregates all information about a sport event."@en;
                  rdfs:label "Sport item"@en;
                  rdfs:subClassOf ebucore:Item.
ebucore:Staff a rdfs:Class;
              rdfs:comment "Staff member."@en;
              rdfs:label "Staff member."@en;
              rdfs:subClassOf ebucore:Agent.
ebucore:Standard a rdfs:Class;
                 rdfs:comment "identifies the technical video standard of a resource, i.e. NTSC or PAL."@en;
                 rdfs:label "Standard";
                 rdfs:subClassOf ebucore:Format;
                 skos:prefLabel "Standard".
ebucore:StorageType a rdfs:Class;
                    rdfs:comment """The type of storage used for the repository.
            This is provided as free text in an annotation label or as an identifier pointing to a
            term in a classification scheme."""@en;
                    rdfs:label "Storage type"@en;
                    rdfs:subClassOf skos:Concept.
ebucore:Stream a rdfs:Class;
               rdfs:comment "A continuous stream of bits."@en;
               rdfs:label "Stream"@en;
               rdfs:subClassOf ebucore:Component.
ebucore:Subject a rdfs:Class;
                rdfs:comment """A term describing the topic covered by the
            BusinessObject or resource. This is provided as free text in an annotation label or as
            an identifier pointing to a term in a classification scheme."""@en;
                rdfs:label "Subject"@en;
                rdfs:subClassOf skos:Concept.
ebucore:Subtitling a rdfs:Class;
                   rdfs:comment """To signal the presence of subtitles for
            translation in alternative languages."""@en;
                   rdfs:label "Subtitling"@en;
                   rdfs:subClassOf ebucore:DataTrack.
ebucore:SubtitlingFormat a rdfs:Class;
                         rdfs:comment """To define the format of subtitling.
            subtitling's main use isfor translation. This is provided as free text in an
            annotation label  or as an identifier pointing to a term in a classification
            scheme."""@en;
                         rdfs:label "Subtitling format"@en;
                         rdfs:subClassOf ebucore:DataFormat.
ebucore:TVProgramme a rdfs:Class;
                    rdfs:comment """A programme for distribution on television
            channels."""@en;
                    rdfs:label "TV Programme"@en;
                    rdfs:subClassOf ebucore:Programme.
ebucore:Tag a rdfs:Class;
            rdfs:comment """An annotation specific to a particular
            timestamp in audiovisual MediaResources.""";
            rdfs:label "Tag";
            rdfs:subClassOf ebucore:Annotation.
ebucore:Thumbnail a rdfs:Class;
                  rdfs:comment """A thumbnail is a low resolution picture that
            can be associated with EditorialObjects or e.g. MediaResources or
            Contacts."""@en;
                  rdfs:label "Thumbnail"@en;
                  rdfs:subClassOf ebucore:Picture.
ebucore:TimecodeTrack a rdfs:Class;
                      rdfs:comment "A track with timecode information.";
                      rdfs:label "Timecode track";
                      rdfs:subClassOf ebucore:Track.
ebucore:Topic a rdfs:Class;
              rdfs:comment """A type subject for use in some contexts. This
            is provided as free text in an annotation label or as an identifier pointing to a term
            in a classification scheme."""@en;
              rdfs:label "Topic"@en;
              rdfs:subClassOf ebucore:Subject.
ebucore:Track a rdfs:Class;
              rdfs:comment """Audiovisual content can be composed of audio,
            video and data Tracks (including captioning and subtitling)."""@en;
              rdfs:label "Track"@en;
              rdfs:subClassOf ebucore:Essence.
ebucore:Type a rdfs:Class;
             rdfs:comment "An expression of type in textual form or as a term from a classification scheme."@en;
             rdfs:label "Type"@en;
             rdfs:subClassOf skos:Concept.
ebucore:UsageRights a rdfs:Class;
                    rdfs:comment "Usage rights associated with content."@en;
                    rdfs:label "Usage rights"@en;
                    rdfs:subClassOf ebucore:Rights.
ebucore:VideoEncodingFormat a rdfs:Class;
                            rdfs:comment "The encoding format of the video."@en;
                            rdfs:label "Video encoding format"@en;
                            rdfs:subClassOf ebucore:EncodingFormat.
ebucore:VideoFormat a rdfs:Class;
                    rdfs:comment """To provide additional technical information
            about a video resource such as the frame rate. This is provided as free text in an
            annotation label or as an identifier pointing to a term in a classification
            scheme."""@en;
                    rdfs:label "Video format"@en;
                    rdfs:subClassOf ebucore:Format.
ebucore:VideoStream a rdfs:Class;
                    rdfs:comment "A decodable video stream of bits."@en;
                    rdfs:label "Video stream"@en;
                    rdfs:subClassOf ebucore:Stream.
ebucore:VideoTrack a rdfs:Class;
                   rdfs:comment """A specialisation of Track for Video to provide
            a link to specific data properties such as frameRate, etc. Signing is another possible
            example of video track. Specific VideoTracks such as Signing can be defined as sub
            VideoTracks.. In advanced systems, different VideoTracks can be used to provide e.g.
            different viewing angles."""@en;
                   rdfs:label "Video track"@en;
                   rdfs:subClassOf ebucore:Track.
ebucore:YouTubeVideo a rdfs:Class;
                     rdfs:label "You tube video";
                     rdfs:subClassOf ebucore:MediaResource.
ebucore:abridgedTitle a rdf:Property;
                      rdfs:comment "A shorter version of the title."@en;
                      rdfs:label "Abridged title"@en;
                      rdfs:subPropertyOf ebucore:alternativeTitle.
ebucore:abstract a rdf:Property;
                 rdfs:comment "To provide a brief summary."@en;
                 rdfs:label "Abstract"@en;
                 rdfs:subPropertyOf ebucore:description.
ebucore:adultContent a rdf:Property;
                     rdfs:domain [owl:unionOf (ebucore:EditorialObject
                                               ebucore:Resource) ; 
                                  a owl:Class];
                     rdfs:label "adult content";
                     rdfs:range xsd:boolean.
ebucore:affiliationEndDate a rdf:Property;
                           rdfs:comment "The date when a Contact left an Organisation"@en;
                           rdfs:domain ebucore:Affiliation;
                           rdfs:label "Affiliation start date"@en;
                           rdfs:range xsd:date.
ebucore:affiliationStartDate a rdf:Property;
                             rdfs:domain ebucore:Affiliation;
                             rdfs:label "Affiliation start date";
                             rdfs:range xsd:date.
ebucore:agentAddress a rdf:Property;
                     rdfs:comment """To provide the address of an Agent
            (Contact/person or organisation)."""@en;
                     rdfs:domain ebucore:Agent;
                     rdfs:label "Address"@en;
                     rdfs:range xsd:string.
ebucore:agentAge a rdf:Property;
                 rdfs:comment "The age of a Contact/Person";
                 rdfs:domain ebucore:Contact;
                 rdfs:label "Age"@en;
                 rdfs:range xsd:integer.
ebucore:agentCountryOfResidence a rdf:Property;
                                rdfs:domain ebucore:Agent;
                                rdfs:label "agent country of residence".
ebucore:agentEmailAddress a rdf:Property;
                          rdfs:comment """To provide the email address of an agent
            (Contact/person or organisation)."""@en;
                          rdfs:domain ebucore:Agent;
                          rdfs:label "Email"@en;
                          rdfs:range xsd:string;
                          owl:equivalentProperty foaf:mbox.
ebucore:agentMobileTelephoneNumber a rdf:Property;
                                   rdfs:comment """To provide the mobile telephone number of an
            Agent (Contact/person or organisation)"""@en;
                                   rdfs:domain ebucore:Agent;
                                   rdfs:label "Mobile"@en;
                                   rdfs:range xsd:string.
ebucore:agentName a rdf:Property;
                  rdfs:comment "To provide the full name of Contact/person - family and given name."@en;
                  rdfs:domain ebucore:Agent;
                  rdfs:label "Name"@en;
                  rdfs:range xsd:string.
ebucore:agentNationality a rdf:Property;
                         rdfs:domain ebucore:Agent;
                         rdfs:label "agent nationality".
ebucore:agentNickname a rdf:Property;
                      rdfs:comment "To provide a nickname of a Contact/person."@en;
                      rdfs:domain ebucore:Agent;
                      rdfs:label "Nickname"@en;
                      rdfs:range xsd:string.
ebucore:agentPictureIdLocator a rdf:Property;
                              rdfs:label "agent picture id locator";
                              rdfs:subPropertyOf ebucore:locator.
ebucore:agentTelephoneNumber a rdf:Property;
                             rdfs:comment """To provide the telephone number of an Agent
            (Contact/person or Organisation)."""@en;
                             rdfs:domain ebucore:Agent;
                             rdfs:label "Telephone"@en;
                             rdfs:range xsd:string.
ebucore:agentWebHomepage a rdf:Property;
                         rdfs:comment """To provide the address of the webpage of an
            Agent (Contact/person or Organisation)."""@en;
                         rdfs:domain ebucore:Agent;
                         rdfs:label "Homepage"@en;
                         rdfs:range xsd:anyURI;
                         owl:equivalentProperty foaf:homepage.
ebucore:alternativeTitle a rdf:Property;
                         rdfs:comment "To provide an alternative title."@en;
                         rdfs:label "Alternative title"@en;
                         rdfs:subPropertyOf dcterms:alternative;
                         owl:equivalentProperty ma-ont:alternativeTitle.
ebucore:appliesOutOf a rdf:Property;
                     rdfs:comment "To define the Location (e.g. country, region) to which Rating and TargetAudience do NOT apply."@en;
                     rdfs:domain [owl:unionOf (ebucore:Rating
                                               ebucore:audienceLevel) ; 
                                  a owl:Class];
                     rdfs:label "Exclusion area"@en.
ebucore:appliesTo a rdf:Property;
                  rdfs:comment "To define the location/region to which Rating and TargetAudience apply."@en;
                  rdfs:domain [owl:unionOf (ebucore:Rating
                                            ebucore:audienceLevel) ; 
                               a owl:Class];
                  rdfs:label "Coverage"@en.
ebucore:aspectRatio a rdf:Property;
                    rdfs:comment """To provide the aspect ratio of a video frame or
            image. Several types of different aspect ration can apply to the same video image. If
            necessary, specialised aspect ratios can be defined as subproperties."""@en;
                    rdfs:domain [owl:unionOf (ebucore:MediaResource
                                              ebucore:Picture
                                              ebucore:VideoTrack) ; 
                                 a owl:Class];
                    rdfs:label "Aspect ratio"@en;
                    rdfs:range xsd:string.
ebucore:audienceLevel a rdfs:Class;
                      rdfs:comment """This is provided as free text in an annotation
            label or as an identifier pointing to a term in a classification scheme."""@en,
                                   """The target audience (target region, target
            audience category but also parental guidance recommendation) for which the media
            resource is intended."""@en;
                      rdfs:label "Target audience"@en;
                      rdfs:subClassOf ebucore:Type.
ebucore:audioChannelNumber a rdf:Property;
                           rdfs:comment """The total number of audio channels contained in
            the MediaResource."""@en;
                           rdfs:domain ebucore:MediaResource;
                           rdfs:label "Audio channel number"@en;
                           rdfs:range xsd:nonNegativeInteger.
ebucore:audioTrackConfiguration a rdf:Property;
                                rdfs:comment """To provide the configuration of an audio track
            (e.g. stereo pair) in a MediaResource."""@en;
                                rdfs:domain ebucore:MediaResource;
                                rdfs:label "Audio track configuration";
                                rdfs:range xsd:string.
ebucore:bitDepth a rdf:Property;
                 rdfs:comment "To provide the audio encoding bit depth. Also called sample size."@en;
                 rdfs:domain ebucore:MediaResource;
                 rdfs:label "Bit depth"@en;
                 rdfs:range xsd:integer.
ebucore:bitRate a rdf:Property;
                rdfs:comment """To provide the bitrate at which the
            MediaResource can be played in bits/second. Current bitrate if constant, and average bitrate if variable."""@en;
                rdfs:domain ebucore:MediaResource;
                rdfs:label "Bitrate";
                rdfs:range xsd:nonNegativeInteger;
                owl:equivalentProperty ma-ont:averageBitRate.
ebucore:bitRateMax a rdf:Property;
                   rdfs:comment "The maximum bitrate when variable, in bits per second."@en;
                   rdfs:domain ebucore:MediaResource;
                   rdfs:label "Maximum bitrate"@en;
                   rdfs:range xsd:integer.
ebucore:bitRateMode a rdf:Property;
                    rdfs:comment """A flag to indicate if the bit rate is fixed or
            variable."""@en;
                    rdfs:domain ebucore:MediaResource;
                    rdfs:label "Bitrate mode"@en;
                    rdfs:range xsd:string.
ebucore:bookmark a rdf:Property;
                 rdfs:comment "To provide a bookmark."@en;
                 rdfs:label "Bookmark"@en;
                 rdfs:subPropertyOf ebucore:description.
ebucore:businessObjectName a rdf:Property;
                           rdfs:comment """A name attributed to a
            BusinessObject."""@en;
                           rdfs:domain ebucore:BusinessObject;
                           rdfs:label "Name"@en;
                           rdfs:range xsd:string.
ebucore:captioningSource a rdf:Property;
                         rdfs:comment """To provide information on the source of a
            captioning file."""@en;
                         rdfs:domain ebucore:MediaResource;
                         rdfs:label "Captioning source"@en;
                         rdfs:range xsd:string.
ebucore:clonedTo a rdf:Property;
                 rdfs:comment "Identifies relationship between a digital instantiation of a resource and its direct copy, with no generational loss."@en;
                 rdfs:domain [owl:unionOf (ebucore:Asset
                                           ebucore:BusinessObject
                                           ebucore:Resource) ; 
                              a owl:Class];
                 rdfs:label "Cloned to"@en;
                 rdfs:range [owl:unionOf (ebucore:Asset
                                          ebucore:BusinessObject
                                          ebucore:Resource) ; 
                             a owl:Class];
                 rdfs:subPropertyOf dc11:relation;
                 owl:inverseOf ebucore:isClonedFrom.
ebucore:codecFamily a rdf:Property;
                    rdfs:comment "To provide information on the product family of the Codec."@en;
                    rdfs:domain ebucore:Codec;
                    rdfs:label "Codec family"@en;
                    rdfs:range xsd:string.
ebucore:codecName a rdf:Property;
                  rdfs:comment "To provide a name for the Codec, e.g. a product name."@en;
                  rdfs:domain ebucore:Codec;
                  rdfs:label "Codec name"@en;
                  rdfs:range xsd:string.
ebucore:codecVendor a rdf:Property;
                    rdfs:comment "To provide a name for the vendor of the Codec."@en;
                    rdfs:domain ebucore:Codec;
                    rdfs:label "Codec vendor"@en;
                    rdfs:range xsd:string.
ebucore:codecVersion a rdf:Property;
                     rdfs:comment "To provide information on the version of the Codec."@en;
                     rdfs:domain ebucore:Codec;
                     rdfs:label "Codec version"@en;
                     rdfs:range xsd:string.
ebucore:comments a rdf:Property;
                 rdfs:comment "To provide a comment."@en;
                 rdfs:label "Comments"@en;
                 rdfs:subPropertyOf ebucore:description.
ebucore:contactEducation a rdf:Property;
                         rdfs:comment """The education details of a Contact /
            person."""@en;
                         rdfs:domain ebucore:Contact;
                         rdfs:label "Education"@en;
                         rdfs:range xsd:string.
ebucore:contactFamilyInformation a rdf:Property;
                                 rdfs:comment """Information on the family of a Contact /
            person."""@en;
                                 rdfs:domain ebucore:Contact;
                                 rdfs:label "Family information"@en;
                                 rdfs:range xsd:string.
ebucore:contactHobbies a rdf:Property;
                       rdfs:comment """The hobbies of a Contact /
            person."""@en;
                       rdfs:domain ebucore:Contact;
                       rdfs:label "Hobbies"@en;
                       rdfs:range xsd:string.
ebucore:contactMaritalStatus a rdf:Property;
                             rdfs:comment """The marital status of a Contact /
            person."""@en;
                             rdfs:domain ebucore:Contact;
                             rdfs:label "Marital status"@en;
                             rdfs:range xsd:string.
ebucore:contactOccupation a rdf:Property;
                          rdfs:comment """The job / occupation name of a Contact /
            person."""@en;
                          rdfs:domain ebucore:Contact;
                          rdfs:label "Occupation"@en;
                          rdfs:range xsd:string.
ebucore:contactUsername a rdf:Property;
                        rdfs:comment """The username by which a Contact / person is
            known e.g. when attributing a rating value."""@en;
                        rdfs:domain ebucore:Contact;
                        rdfs:label "Username"@en;
                        rdfs:range xsd:string;
                        owl:equivalentProperty foaf:nick.
ebucore:dateBroadcast a rdf:Property;
                      rdfs:comment "The date when the resource was first broadcast publicly on television or radio."@en;
                      rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                ebucore:Resource) ; 
                                   a owl:Class];
                      rdfs:label "Broadcast date";
                      rdfs:subPropertyOf dc11:date;
                      owl:equivalentProperty ma-ont:creationDate.
ebucore:dateCreated a rdf:Property;
                    rdfs:comment "The date of creation of the Resource."@en;
                    rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                              ebucore:Resource) ; 
                                 a owl:Class];
                    rdfs:label "Creation date/time";
                    rdfs:subPropertyOf dc11:date;
                    owl:equivalentProperty ma-ont:creationDate.
ebucore:dateDeleted a rdf:Property;
                    rdfs:comment "The date when the resource was removed from institutional holdings."@en;
                    rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                              ebucore:Resource) ; 
                                 a owl:Class];
                    rdfs:label "Deletion date";
                    rdfs:subPropertyOf dc11:date;
                    owl:equivalentProperty ma-ont:creationDate.
ebucore:dateDigitised a rdf:Property;
                      rdfs:comment "To provide the date of digitisation of the Resource."@en;
                      rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                ebucore:Resource) ; 
                                   a owl:Class];
                      rdfs:label "Digitisation date/time";
                      rdfs:subPropertyOf dc11:date.
ebucore:dateDistributed a rdf:Property;
                        rdfs:comment "The date when the resource was first made available to the public for purchase, download, or online access."@en;
                        rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                  ebucore:Resource) ; 
                                     a owl:Class];
                        rdfs:label "Distribution date";
                        rdfs:subPropertyOf dc11:date;
                        owl:equivalentProperty ma-ont:creationDate.
ebucore:dateIngested a rdf:Property;
                     rdfs:comment "The date when the resource was removed from institutional holdings."@en;
                     rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                               ebucore:Resource) ; 
                                  a owl:Class];
                     rdfs:label "Ingest date";
                     rdfs:subPropertyOf dc11:date;
                     owl:equivalentProperty ma-ont:creationDate.
ebucore:dateIssued a rdf:Property;
                   rdfs:comment "To provide the date of release of the Resource."@en;
                   rdfs:label "Publication date/time";
                   rdfs:subPropertyOf dcterms:issued;
                   owl:equivalentProperty ma-ont:releaseDate.
ebucore:dateLicenced a rdf:Property;
                     rdfs:comment "The date when the license for the resource begins."@en;
                     rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                               ebucore:Resource) ; 
                                  a owl:Class];
                     rdfs:label "License start date";
                     rdfs:subPropertyOf dc11:date;
                     owl:equivalentProperty ma-ont:creationDate.
ebucore:dateMigrated a rdf:Property;
                     rdfs:comment "The date when the resource was copied or converted from an obsolete or endangered original format to a more updated format for preservation."@en;
                     rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                               ebucore:Resource) ; 
                                  a owl:Class];
                     rdfs:label "Migration date";
                     rdfs:subPropertyOf dc11:date;
                     owl:equivalentProperty ma-ont:creationDate.
ebucore:dateModified a rdf:Property;
                     rdfs:comment "To indicate the date at which the Resource has been modified."@en;
                     rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                               ebucore:Resource) ; 
                                  a owl:Class];
                     rdfs:label "Modification date/time";
                     rdfs:subPropertyOf dcterms:modified.
ebucore:dateNormalized a rdf:Property;
                       rdfs:comment "The date when the resource was converted from its original format into a format pre-selected by the institution for preservation."@en;
                       rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                 ebucore:Resource) ; 
                                    a owl:Class];
                       rdfs:label "Normalization date";
                       rdfs:subPropertyOf dc11:date;
                       owl:equivalentProperty ma-ont:creationDate.
ebucore:dateTransferred a rdf:Property;
                        rdfs:comment "The date when the resource was moved from one digital or physical location to another."@en;
                        rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                  ebucore:Resource) ; 
                                     a owl:Class];
                        rdfs:label "Transfer date";
                        rdfs:subPropertyOf dc11:date;
                        owl:equivalentProperty ma-ont:creationDate.
ebucore:dateValidated a rdf:Property;
                      rdfs:comment "The most recent date when the resource was confirmed to be valid through manual or digital QC."@en;
                      rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                ebucore:Resource) ; 
                                   a owl:Class];
                      rdfs:label "Validation date";
                      rdfs:subPropertyOf dc11:date;
                      owl:equivalentProperty ma-ont:creationDate.
ebucore:derivedTo a rdf:Property;
                  rdfs:comment "Identifies a content-based relationship between two resources."@en;
                  rdfs:domain [owl:unionOf (ebucore:Asset
                                            ebucore:BusinessObject
                                            ebucore:Resource) ; 
                               a owl:Class];
                  rdfs:label "Derived to"@en;
                  rdfs:range [owl:unionOf (ebucore:Asset
                                           ebucore:BusinessObject
                                           ebucore:Resource) ; 
                              a owl:Class];
                  rdfs:subPropertyOf dc11:relation;
                  owl:inverseOf ebucore:isDerivedFrom.
ebucore:description a rdf:Property;
                    rdfs:comment """This can be specialised by using sub-properties
            like defined in http://www.ebu.ch/metadata/cs/web/ebu_DescriptionTypeCodeCS_p.xml.htm
            implemented as examples as e.g. 'summary' or
            'script'.""";
                    rdfs:domain ebucore:BusinessObject;
                    rdfs:label "Description";
                    rdfs:range xsd:string;
                    rdfs:subPropertyOf dc11:description;
                    owl:equivalentProperty ma-ont:description.
ebucore:dimensions a rdf:Property;
                   rdfs:comment "Describes the physical dimensions of a media resource, with units of measure concatenated to become part of the value."@en;
                   rdfs:domain ebucore:Resource;
                   rdfs:label "Dimensions"@en;
                   rdfs:range xsd:double.
ebucore:dopesheet a rdf:Property;
                  rdfs:comment "To provide a dopesheet with a title and brief description for news."@en;
                  rdfs:label "Dopesheet"@en;
                  rdfs:subPropertyOf ebucore:description.
ebucore:dubbedTo a rdf:Property;
                 rdfs:comment "Identifies relationship between a physical instantiation of a resource and a duplicate physical copy that may involve generational loss."@en;
                 rdfs:domain [owl:unionOf (ebucore:Asset
                                           ebucore:BusinessObject
                                           ebucore:Resource) ; 
                              a owl:Class];
                 rdfs:label "Dubbed to"@en;
                 rdfs:range [owl:unionOf (ebucore:Asset
                                          ebucore:BusinessObject
                                          ebucore:Resource) ; 
                             a owl:Class];
                 rdfs:subPropertyOf dc11:relation;
                 owl:inverseOf ebucore:isDubbedFrom.
ebucore:duration a rdf:Property;
                 rdfs:comment """To provide information on the duration of a MediaResource. It corresponds to 'duration' in the
            Ontology for Media Resources."""@en;
                 rdfs:domain [owl:unionOf (ebucore:MediaResource
                                           ebucore:EditorialObject) ; 
                              a owl:Class];
                 rdfs:label "Duration"@en;
                 rdfs:range rdfs:Literal;
                 owl:equivalentProperty ma-ont:duration.
ebucore:durationNormalPlayTime a rdf:Property;
                               rdfs:comment """To provide a duration as normal
            time."""@en;
                               rdfs:label "Duration (time)";
                               rdfs:range xsd:time;
                               rdfs:subPropertyOf ebucore:duration.
ebucore:durationNumberEditUnit a rdf:Property;
                               rdfs:comment """To provide a duration as a number of EditUnits
            which value is for instance the inverse of the audio sample rate or video frame
            rate."""@en;
                               rdfs:label "Duration (edit units)";
                               rdfs:range xsd:double;
                               rdfs:subPropertyOf ebucore:duration.
ebucore:durationPublished a rdf:Property;
                          rdfs:comment "To provide information on the published / announced duration of an EditorialObject."@en;
                          rdfs:domain ebucore:EditorialObject;
                          rdfs:label "Published Duration"@en;
                          rdfs:range rdfs:Literal.
ebucore:durationPublishedNormalPlayTime a rdf:Property;
                                        rdfs:comment """To provide a published duration as normal
            time."""@en;
                                        rdfs:label "Published duration (time)"@en;
                                        rdfs:range xsd:dateTime;
                                        rdfs:subPropertyOf ebucore:durationPublished.
ebucore:durationPublishedNumberEditUnit a rdf:Property;
                                        rdfs:comment """To provide a published duration as a number of EditUnits
            which value is for instance the inverse of the audio sample rate or video frame
            rate."""@en;
                                        rdfs:label "Published duration (edit units)"@en;
                                        rdfs:range xsd:double;
                                        rdfs:subPropertyOf ebucore:durationPublished.
ebucore:durationPublishedTimecode a rdf:Property;
                                  rdfs:comment """The published duration expressed as a
            timecode."""@en;
                                  rdfs:label "Published duration (timecode)"@en;
                                  rdfs:range xsd:string;
                                  rdfs:subPropertyOf ebucore:durationPublished.
ebucore:durationTimecode a rdf:Property;
                         rdfs:comment """The duration expressed as a
            timecode."""@en;
                         rdfs:label "Duration (timecode)";
                         rdfs:range xsd:string;
                         rdfs:subPropertyOf ebucore:duration.
ebucore:editUnit a rdf:Property;
                 rdfs:comment """The edit unit is e.g. the inverse of the audio
            sample rate or video frame rate."""@en;
                 rdfs:domain ebucore:MediaResource;
                 rdfs:label "Edit unit"@en;
                 rdfs:range xsd:float.
ebucore:encodingLevel a rdf:Property;
                      rdfs:comment "The encoding level."@en;
                      rdfs:domain ebucore:Resource;
                      rdfs:label "Encoding level"@en.
ebucore:encodingProfile a rdf:Property;
                        rdfs:comment "The encoding profile"@en;
                        rdfs:domain ebucore:Resource;
                        rdfs:label "Encoding profile"@en.
ebucore:end a rdf:Property;
            rdfs:comment """The start point of the media
            resource."""@en;
            rdfs:domain ebucore:MediaResource;
            rdfs:label "End time"@en;
            rdfs:range rdfs:Literal.
ebucore:endLicenceDate a rdf:Property;
                       rdfs:comment "The date on which the license for the resource expires."@en;
                       rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                 ebucore:Resource) ; 
                                    a owl:Class];
                       rdfs:label "License expiration date";
                       rdfs:subPropertyOf dc11:date;
                       owl:equivalentProperty ma-ont:creationDate.
ebucore:endNormalPlayTime a rdf:Property;
                          rdfs:comment """The start time expressed using a time
            expression."""@en;
                          rdfs:label "End time (time)"@en;
                          rdfs:range xsd:time;
                          rdfs:subPropertyOf ebucore:end.
ebucore:endNumberEditUnits a rdf:Property;
                           rdfs:comment """A start time expressed as a number of edit
            units."""@en;
                           rdfs:label "End time (edit units)"@en;
                           rdfs:range xsd:double;
                           rdfs:subPropertyOf ebucore:end.
ebucore:endTimecode a rdf:Property;
                    rdfs:comment """A start time expressed as
            timecode."""@en;
                    rdfs:label "End time (timecode)"@en;
                    rdfs:range xsd:string;
                    rdfs:subPropertyOf ebucore:end.
ebucore:eventDescription a rdf:Property;
                         rdfs:comment """To provide a deescription for an
            Event."""@en;
                         rdfs:domain ebucore:Event;
                         rdfs:label "Description"@en;
                         rdfs:range xsd:string.
ebucore:eventDuration a rdf:Property;
                      rdfs:comment "The duration of an event.";
                      rdfs:domain ebucore:Event;
                      rdfs:label "Duration";
                      rdfs:range xsd:duration.
ebucore:eventEndDate a rdf:Property;
                     rdfs:comment "The end date of an Event."@en;
                     rdfs:domain ebucore:Event;
                     rdfs:label "Event end date"@en;
                     rdfs:range xsd:string.
ebucore:eventName a rdf:Property;
                  rdfs:comment "To provide a name for an Event."@en;
                  rdfs:domain ebucore:Event;
                  rdfs:label "Event name"@en;
                  rdfs:range xsd:string.
ebucore:eventPeriod a rdf:Property;
                    rdfs:comment "The period of time during which an Event has occured."@en;
                    rdfs:domain ebucore:Event;
                    rdfs:label "Event period"@en;
                    rdfs:range xsd:string.
ebucore:eventStartDate a rdf:Property;
                       rdfs:comment "The start date of an Event."@en;
                       rdfs:domain ebucore:Event;
                       rdfs:label "Event start date"@en;
                       rdfs:range xsd:string.
ebucore:familyName a rdf:Property;
                   rdfs:comment "To provide a family name / last name."@en;
                   rdfs:label "Family name"@en;
                   rdfs:subPropertyOf ebucore:agentName;
                   owl:equivalentProperty foaf:familyName.
ebucore:fictitious a rdf:Property;
                   rdfs:comment """A flag to indicate if an agent of fictitious
            (set to true)."""@en;
                   rdfs:domain ebucore:Agent;
                   rdfs:label "Fictitious agent indicator"@en;
                   rdfs:range xsd:boolean.
ebucore:fileSize a rdf:Property;
                 rdfs:comment "Provides the size of a MediaResource in bytes."@en;
                 rdfs:domain ebucore:Resource;
                 rdfs:label "File size"@en;
                 rdfs:range xsd:double.
ebucore:filename a rdf:Property;
                 rdfs:comment """The name of the file containing the
            Resource."""@en;
                 rdfs:domain ebucore:Resource;
                 rdfs:label "File name"@en;
                 rdfs:range xsd:string.
ebucore:folksonomy a rdf:Property;
                   rdfs:comment "Provides a user/audience-generated description, tag, or label for resource content."@en;
                   rdfs:label "Folksonomy"@en.
ebucore:followsInSequence a rdf:Property;
                          rdfs:comment "A link to a an BusinessObject or a Resource preceding the current BusinessObject or Resource in an ordered sequence";
                          rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                    ebucore:Resource) ; 
                                       a owl:Class];
                          rdfs:label "Previous";
                          rdfs:range [owl:unionOf (ebucore:BusinessObject
                                                   ebucore:Resource) ; 
                                      a owl:Class];
                          rdfs:subPropertyOf dc11:relation.
ebucore:frameRate a rdf:Property;
                  rdfs:comment "The frame rate of the video signal in frame per second."@en;
                  rdfs:domain ebucore:VideoTrack;
                  rdfs:label "Frame rate"@en;
                  rdfs:range xsd:double;
                  owl:equivalentProperty ma-ont:frameRate.
ebucore:frameSizeUnit a rdf:Property;
                      rdfs:comment """The unit used to express the frame width or
            height. The unit by default is 'pixel'."""@en;
                      rdfs:domain ebucore:VideoTrack;
                      rdfs:label "Frame size unit"@en;
                      rdfs:range xsd:string;
                      owl:equivalentProperty ma-ont:frameSizeUnit.
ebucore:framesPerSecond a rdf:Property;
                        rdfs:comment "Identifies the frames per second at which a visual resource should be played back for human consumption."@en;
                        rdfs:domain ebucore:Resource;
                        rdfs:label "Frames per second"@en;
                        rdfs:range xsd:double;
                        rdfs:subPropertyOf ebucore:playbackSpeed;
                        owl:equivalentProperty ma-ont:frameRate.
ebucore:frequency a rdf:Property;
                  rdfs:comment "To provide the frequency of an AudioChannel filter"@en;
                  rdfs:domain ebucore:AudioChannel;
                  rdfs:label "Frequency"@en;
                  rdfs:range xsd:integer.
ebucore:givenName a rdf:Property;
                  rdfs:comment "To provide one or more given names."@en;
                  rdfs:label "Given name"@en;
                  rdfs:subPropertyOf ebucore:agentName;
                  owl:equivalentProperty foaf:givenName.
ebucore:groupDescription a rdf:Property;
                         rdfs:comment """A textual description of a
            Group."""@en;
                         rdfs:domain ebucore:Group;
                         rdfs:label "Group description"@en;
                         rdfs:range xsd:string.
ebucore:groupName a rdf:Property;
                  rdfs:comment "The name attributed to a Group."@en;
                  rdfs:domain ebucore:Group;
                  rdfs:label "Group name"@en;
                  rdfs:range xsd:string.
ebucore:hasAffiliation a rdf:Property;
                       rdfs:comment """A property to establish the relation between a
            Contact/person and an Organisation."""@en;
                       rdfs:domain ebucore:Contact;
                       rdfs:label "Affiliation"@en;
                       rdfs:range ebucore:Organisation.
ebucore:hasAncillaryData a rdf:Property;
                         rdfs:comment """A property to signal the presence of
            AncillaryData associated with the EditorialObject and / or MediaResource."""@en;
                         rdfs:domain [owl:unionOf (ebucore:EditorialObject
                                                   ebucore:MediaResource) ; 
                                      a owl:Class];
                         rdfs:label "Ancillary data"@en;
                         rdfs:range ebucore:AncillaryData.
ebucore:hasAncillaryDataFormat a rdf:Property;
                               rdfs:label "Ancillary data format";
                               rdfs:subPropertyOf ebucore:hasDataFormat.
ebucore:hasAnnotation a rdf:Property;
                      rdfs:comment """A property to signal the presence of Annotation
            information associated with an EditorialObject and / or a MediaResource."""@en;
                      rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                ebucore:Resource) ; 
                                   a owl:Class];
                      rdfs:label "Annotation"@en.
ebucore:hasAnnotationSource a rdf:Property;
                            rdfs:comment """To identify the Agent, Contact/person or
            Organisation who has provided the Annotation."""@en;
                            rdfs:domain ebucore:Annotation;
                            rdfs:label "Annotation Source"@en.
ebucore:hasAudioDescription a rdf:Property;
                            rdfs:comment """To signal the presence of
            AudioDescription."""@en;
                            rdfs:domain [owl:unionOf (ebucore:EditorialObject
                                                      ebucore:MediaResource) ; 
                                         a owl:Class];
                            rdfs:label "Audio description"@en.
ebucore:hasAudioEncodingFormat a rdf:Property;
                               rdfs:label "Audio encoding format";
                               rdfs:subPropertyOf ebucore:hasEncodingFormat.
ebucore:hasAudioFormat a rdf:Property;
                       rdfs:label "Audio format";
                       rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasCaptioning a rdf:Property;
                      rdfs:comment """To signal the presence of
            Captioning."""@en;
                      rdfs:domain [owl:unionOf (ebucore:EditorialObject
                                                ebucore:MediaResource) ; 
                                   a owl:Class];
                      rdfs:label "Captioning"@en.
ebucore:hasCaptioningFormat a rdf:Property;
                            rdfs:label "Captioning format";
                            rdfs:subPropertyOf ebucore:hasDataFormat.
ebucore:hasCastMember a rdf:Property;
                      rdfs:domain ebucore:BusinessObject;
                      rdfs:label "Cast member";
                      skos:prefLabel "Cast member".
ebucore:hasCharacter a rdf:Property;
                     rdfs:domain ebucore:BusinessObject;
                     rdfs:label "Character";
                     skos:prefLabel "Character".
ebucore:hasCodec a rdf:Property;
                 rdfs:comment "To identify the Codec with which the Resource has been encoded."@en;
                 rdfs:domain ebucore:Resource;
                 rdfs:label "Encoder";
                 owl:equivalentProperty ma-ont:hasCompression.
ebucore:hasColourSpace a rdf:Property;
                       rdfs:label "Colour space";
                       rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasContact a rdf:Property;
                   rdfs:comment """To provide information on a Contact for an
            Organisation or a physical person (e.g. the agent of an actor)."""@en;
                   rdfs:domain ebucore:Agent;
                   rdfs:label "Contact"@en.
ebucore:hasContainerFormat a rdf:Property;
                           rdfs:label "Container format";
                           rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasContainerMimeType a rdf:Property;
                             rdfs:label "Mime type";
                             rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasContributor a rdf:Property;
                       rdfs:comment """To provide information on Contacts/persons or
            Organisations who have contributed to the BusinessObject or Resource."""@en;
                       rdfs:label "Contributor"@en;
                       rdfs:subPropertyOf dc11:contributor;
                       owl:equivalentProperty ma-ont:hasContributor.
ebucore:hasCoverage a rdf:Property;
                    rdfs:comment """A property to identify the Events and or
            Locations, all real or fictional, covered by the 
            BusinessObject."""@en;
                    rdfs:label "Coverage"@en;
                    rdfs:subPropertyOf dc11:coverage;
                    owl:equivalentProperty ma-ont:hasRelatedLocation.
ebucore:hasCreationLocation a rdf:Property;
                            rdfs:comment "The Location where content has been created."@en;
                            rdfs:label "Creation location"@en;
                            rdfs:subPropertyOf dc11:coverage.
ebucore:hasCreator a rdf:Property;
                   rdfs:comment "To identify an Agent involved in the creation of the Resource or BusinessObject."@en;
                   rdfs:label "Creator"@en;
                   rdfs:subPropertyOf dc11:creator;
                   owl:equivalentProperty ma-ont:hasCreator.
ebucore:hasCrewMember a rdf:Property;
                      rdfs:domain ebucore:BusinessObject;
                      rdfs:label "Crew member";
                      skos:prefLabel "Crew member".
ebucore:hasDataFormat a rdf:Property;
                      rdfs:label "Data format";
                      rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasDepartment a rdf:Property;
                      rdfs:comment """To identify Departments within an
            Organisation."""@en;
                      rdfs:domain ebucore:Organisation;
                      rdfs:label "Department"@en.
ebucore:hasDocumentFormat a rdf:Property;
                          rdfs:label "has document format";
                          rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasDopesheet a rdf:Property;
                     rdfs:comment "To associate a Dopesheet with a NewsItem."@en;
                     rdfs:domain ebucore:NewsItem;
                     rdfs:label "Dopesheet"@en.
ebucore:hasEncodingFormat a rdf:Property;
                          rdfs:label "Encoding format";
                          rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasEpisode a rdf:Property;
                   rdfs:comment """To identify an episode of a
            Series or a Season."""@en;
                   rdfs:domain [owl:unionOf (ebucore:Season
                                             ebucore:Series) ; 
                                a owl:Class];
                   rdfs:label "Episode"@en;
                   rdfs:range ebucore:Programme;
                   rdfs:subPropertyOf ebucore:hasRelatedBusinessObject;
                   owl:inverseOf ebucore:isEpisodeOf.
ebucore:hasEvent a rdf:Property;
                 rdfs:comment """To associate an Event with a
            Location."""@en;
                 rdfs:domain ebucore:Location;
                 rdfs:label "Event"@en;
                 rdfs:subPropertyOf dc11:coverage.
ebucore:hasFileFormat a rdf:Property;
                      rdfs:label "File format";
                      rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasFormat a rdf:Property;
                  rdfs:comment "A property to define the Format of a Resource."@en;
                  rdfs:label "Format"@en;
                  rdfs:subPropertyOf dc11:format;
                  owl:equivalentProperty ma-ont:hasFormat.
ebucore:hasGeneration a rdf:Property;
                      rdfs:comment "Identifies the generation of a version of a resource, i.e. master, edit master, distribution copy, etc."@en;
                      rdfs:label "Generation"@en;
                      rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasGenre a rdf:Property;
                 rdfs:comment """To define a Genre/category associated to the
            BusinesssObject."""@en;
                 rdfs:domain ebucore:BusinessObject;
                 rdfs:label "Genre"@en;
                 rdfs:subPropertyOf ebucore:hasType;
                 owl:equivalentProperty ma-ont:hasGenre.
ebucore:hasHomepage a rdf:Property;
                    rdfs:label "Homepage";
                    rdfs:subPropertyOf ebucore:hasRelatedResource;
                    skos:prefLabel "Homepage".
ebucore:hasIdPicture a rdf:Property;
                     rdfs:domain ebucore:Contact;
                     rdfs:label "Id picture";
                     skos:prefLabel "Id picture".
ebucore:hasImageFormat a rdf:Property;
                       rdfs:label "Image format";
                       rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasKeyCareerEvent a rdf:Property;
                          rdfs:domain ebucore:Agent;
                          rdfs:label "Career event";
                          rdfs:range ebucore:KeyCareerEvent;
                          rdfs:subPropertyOf ebucore:hasRelatedEvent.
ebucore:hasKeyPersonalEvent a rdf:Property;
                            rdfs:domain ebucore:Agent;
                            rdfs:label "Personal event";
                            rdfs:range ebucore:KeyPersonalEvent;
                            rdfs:subPropertyOf ebucore:hasRelatedEvent.
ebucore:hasKeyword a rdf:Property;
                   rdfs:comment """To associate a concept, descriptive phrase or
            Keyword that specifies the topic of the BusinessObject or Annotation."""@en;
                   rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                             ebucore:Annotation) ; 
                                a owl:Class];
                   rdfs:label "Keyword"@en;
                   owl:equivalentProperty ma-ont:hasKeyword.
ebucore:hasLanguage a rdf:Property;
                    rdfs:comment """To associate a Language to a Resource or
            BusinessObject. A controlled vocabulary based on BCP 47 is recommended. This
            property can also be used to identify the presence of sign language (RFC 5646). By
            inheritance, the hasLanguage property applies indifferently at the MediaResource /
            Fragment / Track levels at which the usage is being defined. Best practice recommends to
            use to best possible level of granularity fo describe the usage of language within a
            MediaResource including at Fragment and Track levels."""@en;
                    rdfs:label "Language"@en;
                    rdfs:subPropertyOf dc11:language;
                    owl:equivalentProperty ma-ont:hasLanguage.
ebucore:hasLocation a rdf:Property;
                    rdfs:comment "To associate a Location with a BusinessObject."@en;
                    rdfs:domain ebucore:Event;
                    rdfs:label "Location"@en;
                    rdfs:subPropertyOf dc11:coverage.
ebucore:hasLogo a rdf:Property;
                rdfs:comment """Logos can be used in a variety of contexts.
            Logo can be associated with an Organisation or a Service or a PublicationChannel."""@en;
                rdfs:domain [owl:unionOf (ebucore:PublicationChannel
                                          ebucore:Service
                                          ebucore:Organisation) ; 
                             a owl:Class];
                rdfs:label "Logo"@en.
ebucore:hasMediaFragment a rdf:Property;
                         rdfs:comment """To define Parts (segments, fragments, etc.)
            withiin a MediaResource."""@en;
                         rdfs:domain [owl:unionOf (ebucore:MediaResource
                                                   ebucore:EditorialObject) ; 
                                      a owl:Class];
                         rdfs:label "Part"@en;
                         rdfs:range ebucore:MediaFragment;
                         rdfs:subPropertyOf ebucore:hasRelatedResource;
                         owl:equivalentProperty ma-ont:hasFragment;
                         owl:inverseOf ebucore:isMediaFragmentOf.
ebucore:hasMedium a rdf:Property;
                  rdfs:label "Medium";
                  rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasMember a rdf:Property;
                  rdfs:comment "To establish group/collection relationship between EditorialObjects."@en;
                  rdfs:domain ebucore:Group;
                  rdfs:label "Member."@en;
                  rdfs:range ebucore:EditorialObject.
ebucore:hasMetadataAttributor a rdf:Property;
                              rdfs:comment """To identify the Agent (Contact/person or
            Organisation) who has created the metadata."""@en;
                              rdfs:domain ebucore:Subject;
                              rdfs:label "Metadata attributor"@en.
ebucore:hasMimeType a rdf:Property;
                    rdfs:label "Mime type";
                    rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasObjectType a rdf:Property;
                      rdfs:comment """To define an ObjectType for the BusinessObject
             (e.g. book, report, programme, clip) if not defined as a subClass of BusinessObject."""@en;
                      rdfs:domain ebucore:BusinessObject;
                      rdfs:label "Object/asset type";
                      rdfs:subPropertyOf ebucore:hasType.
ebucore:hasOriginalLanguage a rdf:Property;
                            rdfs:label "Original language";
                            rdfs:subPropertyOf ebucore:hasLanguage.
ebucore:hasPart a rdf:Property;
                rdfs:comment """To define Parts (segments, fragments, etc.)
            within a BusinessObject."""@en;
                rdfs:domain ebucore:EditorialObject;
                rdfs:label "Part"@en;
                rdfs:range ebucore:EditorialObject;
                rdfs:subPropertyOf ebucore:hasRelatedBusinessObject.
ebucore:hasPictogram a rdf:Property;
                     rdfs:comment "To provide a visual representation of  TargetAudience or Rating."@en;
                     rdfs:domain [owl:unionOf (ebucore:Rating
                                               ebucore:audienceLevel) ; 
                                  a owl:Class];
                     rdfs:label "Pictogram"@en.
ebucore:hasPublicationChannel a rdf:Property;
                              rdfs:comment """To associate a PublicationEvent with a
            PublicationChannel."""@en;
                              rdfs:domain ebucore:PublicationEvent;
                              rdfs:label "Publication channel"@en;
                              rdfs:range ebucore:PublicationChannel.
ebucore:hasPublicationEvent a rdf:Property;
                            rdfs:comment """To associate PublicationEvents with
            PublicationChannels or as elements of a PublicationHistory or PublicationPlanning."""@en;
                            rdfs:domain [owl:unionOf (ebucore:PublicationChannel
                                                      ebucore:PublicationHistory
                                                      ebucore:PublicationPlanning) ; 
                                         a owl:Class];
                            rdfs:label "Publication event"@en;
                            rdfs:range ebucore:PublicationEvent.
ebucore:hasPublicationHistory a rdf:Property;
                              rdfs:domain [owl:unionOf (ebucore:EditorialObject
                                                        ebucore:MediaResource) ; 
                                           a owl:Class];
                              rdfs:label "has publication history";
                              rdfs:range ebucore:PublicationHistory.
ebucore:hasPublisher a rdf:Property;
                     rdfs:comment "To identify an Agent involved in the publication of the Resource or BusinessObject."@en;
                     rdfs:label "Publisher"@en;
                     rdfs:subPropertyOf dc11:publisher;
                     owl:equivalentProperty ma-ont:hasPublisher.
ebucore:hasRating a rdf:Property;
                  rdfs:comment """To identify the presence of Rating attributed
            to a Resource or BusinessObject."""@en;
                  rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                            ebucore:Resource) ; 
                               a owl:Class];
                  rdfs:label "Rating"@en;
                  owl:equivalentProperty ma-ont:hasRating.
ebucore:hasRatingSource a rdf:Property;
                        rdfs:comment """To identify an Agent (Contact/person or
            Organisation) who has proposed a Rating."""@en;
                        rdfs:domain ebucore:Rating;
                        rdfs:label "Rating provider"@en.
ebucore:hasRelatedAudioChannel a rdf:Property;
                               rdfs:comment "To associate an AudioChannel with an AudioPack or an AudioStream."@en;
                               rdfs:label "Audio channel"@en;
                               rdfs:range ebucore:AudioChannel;
                               rdfs:subPropertyOf ebucore:hasRelatedResource.
ebucore:hasRelatedAudioContent a rdf:Property;
                               rdfs:comment "To identify the AudioContent associated with an AudioProgramme."@en;
                               rdfs:domain ebucore:AudioProgramme;
                               rdfs:label "Audio content"@en;
                               rdfs:range ebucore:AudioContent;
                               rdfs:subPropertyOf ebucore:hasRelatedBusinessObject.
ebucore:hasRelatedAudioObject a rdf:Property;
                              rdfs:comment "To identify AudioObjects associated with AudioContent or other AudioObjects."@en;
                              rdfs:label "Audio object"@en;
                              rdfs:subPropertyOf ebucore:hasRelatedBusinessObject.
ebucore:hasRelatedAudioStream a rdf:Property;
                              rdfs:comment "To associate an AudioStream with an AudioTrack."@en;
                              rdfs:domain ebucore:AudioTrack;
                              rdfs:label "Audio stream"@en;
                              rdfs:range ebucore:AudioStream;
                              rdfs:subPropertyOf ebucore:hasRelatedResource.
ebucore:hasRelatedAudioTrack a rdf:Property;
                             rdfs:comment "To associate an AudioTrack with an AudioStream or an AudioTrackUID."@en;
                             rdfs:label "Audio track"@en;
                             rdfs:range ebucore:AudioTrack;
                             rdfs:subPropertyOf ebucore:hasRelatedResource.
ebucore:hasRelatedBusinessObject a rdf:Property;
                                 rdfs:comment "EditorialObjects can be related to other BusinessOjects, Assets (and associated rights), PublicationEvents(defined when commissioning the EditorialObject before it is instantiated as a Resource (manifestation), or Resources, or Ratings."@en;
                                 rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                           ebucore:Resource
                                                           ebucore:Asset
                                                           ebucore:PublicationEvent
                                                           ebucore:Rating) ; 
                                              a owl:Class];
                                 rdfs:label "Editorial object"@en;
                                 rdfs:range ebucore:BusinessObject;
                                 rdfs:subPropertyOf dc11:relation.
ebucore:hasRelatedEvent a rdf:Property;
                        rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                  ebucore:Resource) ; 
                                     a owl:Class];
                        rdfs:label "has related event";
                        rdfs:range ebucore:Event;
                        rdfs:subPropertyOf dc11:relation.
ebucore:hasRelatedImage a rdf:Property;
                        rdfs:comment "To associate an Image with a BusinessObject."@en;
                        rdfs:domain ebucore:BusinessObject;
                        rdfs:label "Image"@en;
                        rdfs:range ebucore:Image;
                        rdfs:subPropertyOf ebucore:hasRelatedBusinessObject.
ebucore:hasRelatedLocation a rdf:Property;
                           rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                     ebucore:Resource) ; 
                                        a owl:Class];
                           rdfs:label "has related event";
                           rdfs:range ebucore:Location;
                           rdfs:subPropertyOf dc11:relation.
ebucore:hasRelatedMediaFragment a rdf:Property;
                                rdfs:comment "To associate a Part of an EditorialObject with a MediaFragment within the association MediaResource instantiating the EditorialObject."@en;
                                rdfs:domain ebucore:Part;
                                rdfs:label "Media fragment"@en;
                                rdfs:range ebucore:MediaFragment;
                                rdfs:subPropertyOf ebucore:hasMediaFragment.
ebucore:hasRelatedPicture a rdf:Property;
                          rdfs:comment "To associate a Picture with a BusinessObject or a Resource."@en;
                          rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                    ebucore:Resource) ; 
                                       a owl:Class];
                          rdfs:label "Picture"@en;
                          rdfs:range ebucore:Picture;
                          rdfs:subPropertyOf ebucore:hasRelatedResource;
                          owl:equivalentProperty ma-ont:hasRelatedImage.
ebucore:hasRelatedPublicationEvent a rdf:Property;
                                   rdfs:comment "To identify the PublicationEvent associated with a MediaResource (manifestation of an EditorialObject)."@en;
                                   rdfs:domain ebucore:MediaResource;
                                   rdfs:label "Publication event"@en;
                                   rdfs:range ebucore:PublicationEvent;
                                   rdfs:subPropertyOf dc11:relation.
ebucore:hasRelatedResource a rdf:Property;
                           rdfs:comment "To identify a Resource associated with an Asset or a BusinessObject or a PublicationEvent or another Resource."@en;
                           rdfs:domain [owl:unionOf (ebucore:Asset
                                                     ebucore:BusinessObject
                                                     ebucore:PublicationEvent
                                                     ebucore:Resource
                                                     ebucore:Rating) ; 
                                        a owl:Class];
                           rdfs:label "Related resource";
                           rdfs:range ebucore:Resource;
                           rdfs:subPropertyOf dc11:relation;
                           owl:equivalentProperty ma-ont:hasRelatedResource.
ebucore:hasRights a rdf:Property;
                  rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                            ebucore:Resource) ; 
                               a owl:Class];
                  rdfs:label "Rights";
                  skos:prefLabel "Rights".
ebucore:hasRightsContact a rdf:Property;
                         rdfs:comment """To identify a Contact/person who can provide
            assistance / guidance regarding the associated Rights."""@en;
                         rdfs:domain ebucore:Rights;
                         rdfs:label "Contact"@en.
ebucore:hasRightsHolder a rdf:Property;
                        rdfs:comment """To identify an Agent (Contact/person or
            Organisation) having/managing Rights."""@en;
                        rdfs:domain ebucore:Rights;
                        rdfs:label "Rights holder"@en.
ebucore:hasRole a rdf:Property;
                rdfs:comment """To define the role of an Agent (Contact/person
            or Organisation). The association in a particular context is made by declaring the hasCastRole  associated with the BusinessObject."""@en;
                rdfs:domain ebucore:Agent;
                rdfs:label "Role"@en.
ebucore:hasSeason a rdf:Property;
                  rdfs:comment "The Season of a Series."@en;
                  rdfs:domain ebucore:Series;
                  rdfs:label "Season"@en;
                  rdfs:range ebucore:Season;
                  rdfs:subPropertyOf ebucore:hasRelatedBusinessObject;
                  owl:inverseOf ebucore:isSeasonOf.
ebucore:hasSigning a rdf:Property;
                   rdfs:comment """To identify the presence of Signing associated
            to the BusinessObject/Resource."""@en;
                   rdfs:domain [owl:unionOf (ebucore:EditorialObject
                                             ebucore:MediaResource) ; 
                                a owl:Class];
                   rdfs:label "Accessibility - signing"@en;
                   owl:equivalentProperty ma-ont:hasSigning.
ebucore:hasSigningFormat a rdf:Property;
                         rdfs:label "Signing format";
                         rdfs:subPropertyOf ebucore:hasVideoFormat.
ebucore:hasSource a rdf:Property;
                  rdfs:comment "To identify a Resource as the source of another Resource."@en;
                  rdfs:label "Source"@en;
                  rdfs:range ebucore:Resource;
                  rdfs:subPropertyOf dc11:source;
                  owl:equivalentProperty ma-ont:hasSource.
ebucore:hasStaff a rdf:Property;
                 rdfs:comment "To identify staff working within an Organisation."@en;
                 rdfs:domain ebucore:Organisation;
                 rdfs:label "Staff"@en.
ebucore:hasStandard a rdf:Property;
                    rdfs:comment "Identifies the technical video standard of a resource, i.e. NTSC or PAL."@en;
                    rdfs:label "Standard"@en;
                    rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hasStorageType a rdf:Property;
                       rdfs:comment """To define a particular type of storage /
            repository associated with the Locator from where a Resource can be
            accessed."""@en;
                       rdfs:domain ebucore:Resource;
                       rdfs:label "Storage type".
ebucore:hasSubject a rdf:Property;
                   rdfs:comment """To associate a Subject addressed with a
            BusinessObject / Resource."""@en;
                   rdfs:label "Subject"@en;
                   rdfs:subPropertyOf dc11:subject.
ebucore:hasSubtitling a rdf:Property;
                      rdfs:comment """To signal the presence of Subtitling associated
            with the EditorialObject or MediaResource."""@en;
                      rdfs:domain [owl:unionOf (ebucore:EditorialObject
                                                ebucore:MediaResource) ; 
                                   a owl:Class];
                      rdfs:label "Subtitling"@en;
                      owl:equivalentProperty ma-ont:hasSubtitling.
ebucore:hasSubtitlingFormat a rdf:Property;
                            rdfs:label "Subtitling format";
                            rdfs:subPropertyOf ebucore:hasDataFormat.
ebucore:hasTargetAudience a rdf:Property;
                          rdfs:comment """To associate a TargetAudience (e.g. for
            parental guiddance or targeting a particular social group) with a
            BusinessObject/Resource."""@en;
                          rdfs:domain ebucore:BusinessObject;
                          rdfs:label "Target audience";
                          rdfs:subPropertyOf ebucore:hasType;
                          owl:equivalentProperty ma-ont:hasTargetAudience.
ebucore:hasTheme a rdf:Property;
                 rdfs:label "Theme";
                 rdfs:subPropertyOf ebucore:hasKeyword.
ebucore:hasTopic a rdf:Property;
                 rdfs:label "Topic";
                 rdfs:subPropertyOf ebucore:hasSubject.
ebucore:hasTrack a rdf:Property;
                 rdfs:comment "To associate audio/data/video tracks with a MediaResource."@en;
                 rdfs:domain ebucore:MediaResource;
                 rdfs:label "Track"@en;
                 rdfs:range ebucore:Track;
                 rdfs:subPropertyOf ebucore:hasRelatedResource;
                 owl:equivalentProperty ma-ont:hasTrack.
ebucore:hasType a rdf:Property;
                rdfs:comment "To define a type of BusinessObject is not declared as a subClass of BusinessObject."@en;
                rdfs:domain ebucore:BusinessObject;
                rdfs:label "Type"@en;
                rdfs:subPropertyOf dc11:type.
ebucore:hasVersion a rdf:Property;
                   rdfs:comment "To identify another version of an Asset, BusinessObject or Resource."@en;
                   rdfs:domain [owl:unionOf (ebucore:Asset
                                             ebucore:BusinessObject
                                             ebucore:Resource) ; 
                                a owl:Class];
                   rdfs:label "Version"@en;
                   rdfs:range [owl:unionOf (ebucore:Asset
                                            ebucore:BusinessObject
                                            ebucore:Resource) ; 
                               a owl:Class];
                   rdfs:subPropertyOf dc11:relation;
                   owl:inverseOf ebucore:isVersionOf.
ebucore:hasVideoEncodingFormat a rdf:Property;
                               rdfs:label "Video encoding format";
                               rdfs:subPropertyOf ebucore:hasEncodingFormat.
ebucore:hasVideoFormat a rdf:Property;
                       rdfs:label "Video format";
                       rdfs:subPropertyOf ebucore:hasFormat.
ebucore:hashValue a rdf:Property;
                  rdfs:comment """The hash value associated to a Resource. There
            are different methods / algorithms to calculate hash values, which can be defined as
            subproperties."""@en;
                  rdfs:domain ebucore:Resource;
                  rdfs:label "Hash code"@en;
                  rdfs:range xsd:string.
ebucore:height a rdf:Property;
               rdfs:comment """The height of e.g. a video frame typically
            expressed as a number of lines or the height of a picture/image expressed in millimeters
            or else."""@en;
               rdfs:domain ebucore:Resource;
               rdfs:label "Height"@en;
               rdfs:range xsd:integer;
               owl:equivalentProperty ma-ont:frameHeight.
ebucore:heightUnit a rdf:Property;
                   rdfs:comment """The unit used to measure a Height e.g. in
            pixels or number of lines or millimeters or else."""@en;
                   rdfs:domain ebucore:Resource;
                   rdfs:label "Height unit"@en;
                   rdfs:range xsd:string.
ebucore:highPass a rdf:Property;
                 rdfs:comment "The high pass frequency of the AudioChannel filter."@en;
                 rdfs:label "High pass frequency"@en;
                 rdfs:subPropertyOf ebucore:frequency.
ebucore:highlights a rdf:Property;
                   rdfs:comment "To provide highlights."@en;
                   rdfs:label "Highlights"@en;
                   rdfs:subPropertyOf ebucore:description.
ebucore:holdsRightsOver a rdf:Property;
                        rdfs:comment """To identify a BusinessObject or Resource on
            which an Agent (Contact/person or Organisation) holds Rights."""@en;
                        rdfs:domain ebucore:Agent;
                        rdfs:label "Asset, resource, object"@en;
                        rdfs:range [owl:unionOf (ebucore:Asset
                                                 ebucore:BusinessObject
                                                 ebucore:Resource) ; 
                                    a owl:Class].
ebucore:identifier a rdf:Property;
                   rdfs:comment """Corresponds to 'identifier'
            in the W3C Ontology for Media Annotation. The URI may be used to express an alternative
            identifier of the resource, or to share an identifier used by other instances of the
            same resource (equivalent to the fucntionality owl:sameAs)."""@en,
                                """This property is intended to provide an
            alternative identifier for the resource, which has no URI counterpart. In the case where
            the alternative identifier can be expressed as a URI, it is recommended to use
            owl:sameAs instead."""@en;
                   rdfs:label "Identifier"@en;
                   rdfs:subPropertyOf dc11:identifier.
ebucore:inchesPerSecond a rdf:Property;
                        rdfs:comment "Identifies the inches per second at which an analog audio tape should be played back for human consumption."@en;
                        rdfs:domain ebucore:Resource;
                        rdfs:label "Inches per second"@en;
                        rdfs:range xsd:double;
                        rdfs:subPropertyOf ebucore:playbackSpeed;
                        owl:equivalentProperty ma-ont:frameRate.
ebucore:instantiates a rdf:Property;
                     rdfs:comment """To link a particular manifestation of a
            BusinessObject to the corresponding Resource."""@en;
                     rdfs:domain ebucore:Resource;
                     rdfs:label "Business object"@en;
                     rdfs:range ebucore:BusinessObject;
                     rdfs:subPropertyOf ebucore:hasRelatedBusinessObject.
ebucore:isAgent a rdf:Property;
                rdfs:comment "To identify a Contact/person or Organisation as part of a cast list."@en;
                rdfs:domain ebucore:Cast;
                rdfs:label "Agent"@en.
ebucore:isCharacter a rdf:Property;
                    rdfs:comment "To identify the character personified by a Cast individual."@en;
                    rdfs:domain ebucore:Cast;
                    rdfs:label "Character"@en.
ebucore:isClonedFrom a rdf:Property;
                     rdfs:comment "Identifies relationship between a digital instantiation of a resource and its direct copy, with no generational loss."@en;
                     rdfs:domain [owl:unionOf (ebucore:Asset
                                               ebucore:BusinessObject
                                               ebucore:Resource) ; 
                                  a owl:Class];
                     rdfs:label "Cloned from"@en;
                     rdfs:range [owl:unionOf (ebucore:Asset
                                              ebucore:BusinessObject
                                              ebucore:Resource) ; 
                                 a owl:Class];
                     rdfs:subPropertyOf dc11:relation;
                     owl:inverseOf ebucore:clonedTo.
ebucore:isCopyrightedBy a rdf:Property;
                        rdfs:comment "Copyright statement."@en;
                        rdfs:label "Copyright"@en;
                        rdfs:subPropertyOf ebucore:hasRights;
                        owl:equivalentProperty ma-ont:isCopyrightedBy.
ebucore:isCoveredBy a rdf:Property;
                    rdfs:comment """The Rights or policy applicable to the
            BusinessObject, Asset, Resource or PublicationEvent."""@en;
                    rdfs:label "Rights"@en;
                    rdfs:subPropertyOf ebucore:hasRights;
                    owl:equivalentProperty ma-ont:hasPermissions,
                                           ma-ont:hasPolicy.
ebucore:isDerivedFrom a rdf:Property;
                      rdfs:comment "Identifies a content-based relationship between two resources."@en;
                      rdfs:domain [owl:unionOf (ebucore:Asset
                                                ebucore:BusinessObject
                                                ebucore:Resource) ; 
                                   a owl:Class];
                      rdfs:label "Derived from"@en;
                      rdfs:range [owl:unionOf (ebucore:Asset
                                               ebucore:BusinessObject
                                               ebucore:Resource) ; 
                                  a owl:Class];
                      rdfs:subPropertyOf dc11:relation;
                      owl:inverseOf ebucore:derivedTo.
ebucore:isDubbedFrom a rdf:Property;
                     rdfs:comment "Identifies relationship between a physical instantiation of a resource and a duplicate physical copy that may involve generational loss."@en;
                     rdfs:domain [owl:unionOf (ebucore:Asset
                                               ebucore:BusinessObject
                                               ebucore:Resource) ; 
                                  a owl:Class];
                     rdfs:label "Dubbed from"@en;
                     rdfs:range [owl:unionOf (ebucore:Asset
                                              ebucore:BusinessObject
                                              ebucore:Resource) ; 
                                 a owl:Class];
                     rdfs:subPropertyOf dc11:relation;
                     owl:inverseOf ebucore:dubbedTo.
ebucore:isEpisodeOf a rdf:Property;
                    rdfs:comment "The Episode of a Series or a Season."@en;
                    rdfs:domain ebucore:Programme;
                    rdfs:label "Parent season"@en;
                    rdfs:range [owl:unionOf (ebucore:Season
                                             ebucore:Series) ; 
                                a owl:Class];
                    rdfs:subPropertyOf ebucore:hasRelatedBusinessObject;
                    owl:inverseOf ebucore:hasEpisode.
ebucore:isFictitiousContact a rdf:Property;
                            rdfs:comment "To identify Contact/persons being fictitious."@en;
                            rdfs:domain ebucore:Character;
                            rdfs:label "Fictitious contact"@en.
ebucore:isMediaFragmentOf a rdf:Property;
                          rdfs:comment "To identify the MediaResource to which the MediaFragment belongs to."@en;
                          rdfs:domain ebucore:MediaFragment;
                          rdfs:label "Source"@en;
                          rdfs:range ebucore:MediaResource;
                          rdfs:subPropertyOf ebucore:hasRelatedResource;
                          owl:equivalentProperty ma-ont:isFragmentOf;
                          owl:inverseOf ebucore:hasMediaFragment.
ebucore:isMemberOf a rdf:Property;
                   rdfs:comment "To identify a Group to which an EidtorialObject is a member of."@en;
                   rdfs:domain ebucore:EditorialObject;
                   rdfs:label "Member of"@en;
                   rdfs:range ebucore:Group;
                   rdfs:subPropertyOf dc11:relation;
                   owl:inverseOf ebucore:hasMember.
ebucore:isNextInSequence a rdf:Property;
                         rdfs:comment "A link to a an BusinessObject or a Resource following the current BusinessObject or Resource in an ordered sequence";
                         rdfs:domain [owl:unionOf (ebucore:BusinessObject
                                                   ebucore:Resource) ; 
                                      a owl:Class];
                         rdfs:label "Next";
                         rdfs:range [owl:unionOf (ebucore:BusinessObject
                                                  ebucore:Resource) ; 
                                     a owl:Class];
                         rdfs:subPropertyOf dc11:relation.
ebucore:isOperatedBy a rdf:Property;
                     rdfs:comment """To identify the Service that operates the
