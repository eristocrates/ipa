                               sio:SIO_000512.
sio:SIO_000502 <http://purl.org/dc/elements/1.1/identifier> "SIO_000502";
               <http://purl.org/dc/terms/description> "A polyhedral skeleton is a collection of polygon edges."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
