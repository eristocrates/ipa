sio:SIO_000259 dc11:identifier "SIO_000259";
               dcterms:description "An argument is a set of one or more declarative sentences (or propositions) known as the premises along with another declarative sentence (or proposition) known as the conclusion."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "argument"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb113" ; 
                                owl:intersectionOf ([dc11:identifier ":arc758fb114" ; 
                                                    owl:someValuesFrom sio:SIO_000261 ; 
                                                    owl:onProperty sio:SIO_000053 ; 
                                                    a owl:Restriction]
                                                    [dc11:identifier ":arc758fb116" ; 
                                                    owl:someValuesFrom sio:SIO_000262 ; 
                                                    owl:onProperty sio:SIO_000053 ; 
                                                    a owl:Restriction]) ; 
                                a owl:Class],
                               sio:SIO_000256.
sio:SIO_000261 dc11:identifier "SIO_000261";
               dcterms:description "A premise is a proposition of an argument from which the conclusion is drawn."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "premise"@en;
               rdfs:subClassOf sio:SIO_000256.
sio:SIO_000262 dc11:identifier "SIO_000262";
               dcterms:description "A conclusion is a proposition which is reached after considering the evidence, arguments or premises."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "conclusion"@en;
               rdfs:subClassOf sio:SIO_000256.
sio:SIO_000263 dc11:identifier "SIO_000263";
               dcterms:description "A deductive argument is an argument that asserts that the truth of the conclusion is a logical consequence of the premises."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "deductive argument"@en;
               rdfs:subClassOf sio:SIO_000259.
sio:SIO_000264 dc11:identifier "SIO_000264";
               dcterms:description "An inductive argument is an argument that asserts that the truth of the conclusion is supported by the premises."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "inductive argument"@en;
               rdfs:subClassOf sio:SIO_000259.
sio:SIO_000265 dc11:identifier "SIO_000265";
               dcterms:description "A sound argument is a valid argument with true premises."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "sound argument"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb118" ; 
                                owl:someValuesFrom [dc11:identifier ":arc758fb119" ; 
                                                    owl:intersectionOf (sio:SIO_000261
                                                                        [dc11:identifier ":arc758fb121" ; 
                                                                        owl:someValuesFrom sio:SIO_000269 ; 
                                                                        owl:onProperty sio:SIO_000217 ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class] ; 
                                owl:onProperty sio:SIO_000053 ; 
                                a owl:Restriction],
                               sio:SIO_000266.
sio:SIO_000266 dc11:identifier "SIO_000266";
               dcterms:description "A valid argument is an argument where the truth of the conclusion is a logical consequence of the premises and (consequently) its corresponding conditional is a necessary truth."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "valid argument"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb123" ; 
                                owl:someValuesFrom [dc11:identifier ":arc758fb124" ; 
                                                    owl:intersectionOf (sio:SIO_000262
                                                                        [dc11:identifier ":arc758fb126" ; 
                                                                        owl:someValuesFrom sio:SIO_000270 ; 
                                                                        owl:onProperty sio:SIO_000217 ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class] ; 
                                owl:onProperty sio:SIO_000053 ; 
                                a owl:Restriction],
                               sio:SIO_000259.
sio:SIO_000267 dc11:identifier "SIO_000267";
               dcterms:description "An invalid argument is an argument where the truth of the conclusion is false because it is not a logical consequence of the premises."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "invalid argument"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb128" ; 
                                owl:someValuesFrom [dc11:identifier ":arc758fb129" ; 
