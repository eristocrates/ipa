                                                                                                         sio:SIO_010783) ; 
                                                                a <http://www.w3.org/2002/07/owl#Class>].
sio:SIO_010781 <http://purl.org/dc/elements/1.1/identifier> "SIO_010781";
               <http://purl.org/dc/terms/description> "An aromatic ring is a ring in which the electrons are delocalized across all atoms in the ring."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "aromatic ring"@en;
               rdfs:subClassOf sio:SIO_010780.
sio:SIO_010782 <http://purl.org/dc/elements/1.1/identifier> "SIO_010782";
               <http://purl.org/dc/terms/description> "A heterocyclic ring is a ring containing a hetero atom."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "heterocyclic ring"@en;
               rdfs:subClassOf sio:SIO_010780;
               <http://www.w3.org/2002/07/owl#disjointWith> sio:SIO_010783.
sio:SIO_010783 <http://purl.org/dc/elements/1.1/identifier> "SIO_010783";
               <http://purl.org/dc/terms/description> "A homocyclic ring is a ring where the atoms are of a single type."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "homocyclic ring"@en;
               rdfs:subClassOf sio:SIO_010780.
sio:SIO_010784 <http://purl.org/dc/elements/1.1/identifier> "SIO_010784";
               <http://purl.org/dc/terms/description> "An ionic compound is a mereological maximal sum of weakly connected paired positive and negative ions."@en;
