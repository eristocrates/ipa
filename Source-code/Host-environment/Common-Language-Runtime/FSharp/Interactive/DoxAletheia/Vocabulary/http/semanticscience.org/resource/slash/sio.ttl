sio:SIO_000428 <http://purl.org/dc/elements/1.1/identifier> "SIO_000428";
               <http://purl.org/dc/terms/description> "A year is a period of time taken by a planet to make one revolution around the sun."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "year"@en;
