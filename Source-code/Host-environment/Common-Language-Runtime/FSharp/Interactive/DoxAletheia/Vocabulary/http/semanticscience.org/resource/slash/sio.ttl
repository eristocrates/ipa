                                                                 owl:onProperty sio:SIO_000068 ; 
                                                                 a owl:Restriction]) ; 
                                                    a owl:Class] ; 
                                owl:onProperty sio:SIO_010081 ; 
                                a owl:Restriction],
                               sio:SIO_010009.
sio:SIO_010451 dc11:identifier "SIO_010451";
               dcterms:description "A splice site is a region required for the excision of an intron and connection to another exon."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "splice site"@en;
               rdfs:subClassOf sio:SIO_010095.
sio:SIO_010452 dc11:identifier "SIO_010452";
               dcterms:description "A molecular pocket is a site on a molecule that appears as a depression into the structure."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "molecular pocket"@en;
               rdfs:subClassOf sio:SIO_010049.
sio:SIO_010453 dc11:identifier "SIO_010453";
               dcterms:description "An acid is a molecular entity in solution capable of donating a hydron (Bronsted acid) or capable of forming a covalent bond with an electron pair (Lewis acid)."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "acid"@en;
               rdfs:subClassOf sio:SIO_010427.
sio:SIO_010454 dc11:identifier "SIO_010454";
               dcterms:description "A base is a molecular entity dissolved in a solvent that is capable of accepting a proton (Bronsted base) or forming a covalent bond with a hydron (Lewis base) ."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "base"@en;
               rdfs:subClassOf sio:SIO_010427.
sio:SIO_010455 dc11:identifier "SIO_010455";
               dcterms:description "An isomer is a molecule that is compositionally identical to another molecule as a result of a different atomic connectivity."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "isomer"@en;
               owl:equivalentClass [dc11:identifier ":arc758fb838" ; 
                                    owl:intersectionOf (sio:SIO_011125
                                                        [dc11:identifier ":arc758fb840" ; 
                                                        owl:someValuesFrom sio:SIO_011125 ; 
                                                        owl:onProperty sio:SIO_000272 ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class].
sio:SIO_010456 dc11:identifier "SIO_010456";
               dcterms:description "An ion is an atom or molecule in which the total number of electrons is not equal to the total number of protons, giving it a net positive or negative electrical charge."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ion"@en;
               rdfs:subClassOf sio:SIO_010004;
               owl:equivalentClass [dc11:identifier ":arc758fb842" ; 
                                    owl:intersectionOf ([dc11:identifier ":arc758fb843" ; 
