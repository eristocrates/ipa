               <http://purl.org/dc/terms/description> "A small nuclear RNA (snRNA) gene is a gene that encodes a small niuclear RNA molecule."@en;
               sio:equivalentTo "http://purl.obolibrary.org/obo/SO_0001268"^^xsd:anyURI;
