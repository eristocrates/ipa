                                              <http://purl.org/dc/terms/description> """The semanticscience integrated ontology (SIO) provides a simple, integrated ontology (types, relations) for objects, processes and their attributes.

This project provides foundational support for the Bio2RDF (http://bio2rdf.org) and SADI (http://sadiframework.org) projects. 

website: http://semanticscience.org
email: sio-ontology@googlegroups.com
mailing list: http://groups.google.com/group/sio-ontology
"""@en;
                                              <http://purl.org/dc/terms/issued> "2010-03-29"^^xsd:date;
                                              <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/4.0/>;
                                              <http://purl.org/dc/terms/modified> "2016-09-27"^^xsd:date;
                                              <http://purl.org/dc/terms/rights> "free to use,share,modify. modify with attribution [http://creativecommons.org/licenses/by/4.0/].";
                                              <http://purl.org/dc/terms/title> "Semanticscience Integrated Ontology (SIO)"@en;
                                              <http://purl.org/spar/cito/citesAsAuthority> "http://www.jbiomedsem.com/content/5/1/14"^^xsd:anyURI;
                                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "sio"@en;
                                              <http://purl.org/vocab/vann/preferredNamespaceUri> "http://semanticscience.org/resource/";
                                              <http://schema.org/comment> """general class inclusion axioms:
'is part of' some 'physical entity' subClassOf 'is located in' some 'physical entity'

role chains:
'has capability' o 'is realized in' -> 'is participant in'""";
                                              a <http://www.w3.org/2002/07/owl#Ontology>;
                                              rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
                                              rdfs:seeAlso "http://sio.semanticscience.org"^^xsd:anyURI;
                                              <http://www.w3.org/2002/07/owl#versionIRI> <http://semanticscience.org/ontology/sio/v1.34.0/sio-release.owl>;
                                              <http://www.w3.org/2002/07/owl#versionInfo> "1.34.0".
sio:SIO_000000 <http://purl.org/dc/elements/1.1/identifier> "SIO_000000";
               <http://purl.org/dc/terms/description> "Every thing is an entity."@en;
               sio:subset "core";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "entity"@en.
sio:SIO_000001 <http://purl.org/dc/elements/1.1/identifier> "SIO_000001";
               <http://purl.org/dc/terms/description> "A is related to B iff there is some relation between A and B."@en;
               <http://schema.org/comment> "'is related to' is the top level relation in SIO";
               sio:subset "relations+",
                          "core";
               a <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                 <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is related to"@en.
sio:SIO_000004 <http://purl.org/dc/elements/1.1/identifier> "SIO_000004";
               <http://purl.org/dc/terms/description> "A material entity is a physical entity that is spatially extended, exists as a whole at any point in time and has mass."@en;
               sio:subset "core";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "material entity"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb12" ; 
                                <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb13" ; 
                                                                               <http://www.w3.org/2002/07/owl#unionOf> (sio:SIO_000004
                                                                                                                        sio:SIO_000370) ; 
                                                                               a <http://www.w3.org/2002/07/owl#Class>] ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000053 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb11" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_000279 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000008 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000776.
sio:SIO_000005 <http://purl.org/dc/elements/1.1/identifier> "SIO_000005";
               <http://purl.org/dc/terms/description> "A quality is an attribute that is intrinsically associated with its bearer (or its parts), but whose presence/absence and observed/measured value may vary."@en;
               sio:subset "core";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "quality"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb16" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_000000 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000218 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000614;
               <http://www.w3.org/2002/07/owl#disjointWith> sio:SIO_000340.
sio:SIO_000006 <http://purl.org/dc/elements/1.1/identifier> "SIO_000006";
               <http://purl.org/dc/terms/description> "A process is an entity that is identifiable only through the unfolding of time, has temporal parts, and unless otherwise specified/predicted, cannot be identified from any instant of time in which it exists."@en;
               sio:subset "core",
                          "process+";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "process"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb17" ; 
                                <http://www.w3.org/2002/07/owl#allValuesFrom> sio:SIO_000006 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000053 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000000,
                               [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb18" ; 
                                <http://www.w3.org/2002/07/owl#allValuesFrom> sio:SIO_000417 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000687 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>].
sio:SIO_000008 <http://purl.org/dc/elements/1.1/identifier> "SIO_000008";
               <http://purl.org/dc/terms/description> "has attribute is a relation that associates a entity with an attribute where an attribute is an intrinsic characteristic such as a quality, capability, disposition, function, or is an externally derived attribute determined from some descriptor (e.g. a quantity, position, label/identifier) either directly or indirectly through generalization of entities of the same type."@en;
               sio:subset "core";
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has attribute"@en;
               rdfs:subPropertyOf sio:SIO_000001;
               <http://www.w3.org/2002/07/owl#inverseOf> sio:SIO_000011.
sio:SIO_000009 <http://purl.org/dc/elements/1.1/identifier> "SIO_000009";
               <http://purl.org/dc/terms/description> "A social entity pertains to the interaction among individuals and groups."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "social entity"@en;
               rdfs:subClassOf sio:SIO_000015.
sio:SIO_000010 <http://purl.org/dc/elements/1.1/identifier> "SIO_000010";
               <http://purl.org/dc/terms/description> "A social structure is a social entity which consists of relationships between two or more entities."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "social structure"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb19" ; 
                                <http://www.w3.org/2002/07/owl#allValuesFrom> sio:SIO_000776 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000059 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000009.
sio:SIO_000011 <http://purl.org/dc/elements/1.1/identifier> "SIO_000011";
               <http://purl.org/dc/terms/description> "is attribute of is a relation that associates an attribute with an entity where an attribute is an intrinsic characteristic such as a quality, capability, disposition, function, or is an externally derived attribute determined from some descriptor (e.g. a quantity, position, label/identifier) either directly or indirectly through generalization of entities of the same type."@en;
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is attribute of"@en;
               rdfs:subPropertyOf sio:SIO_000001.
sio:SIO_000012 <http://purl.org/dc/elements/1.1/identifier> "SIO_000012";
               <http://purl.org/dc/terms/description> "An organization is a collective with a complex articulation of tasks, roles and responsibilities."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "organization"@en;
               rdfs:subClassOf sio:SIO_000620.
sio:SIO_000013 <http://purl.org/dc/elements/1.1/identifier> "SIO_000013";
               <http://purl.org/dc/terms/description> "A geographic position is the coordinate of an entity against some geographic coordinate system."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "geographic position"@en;
               rdfs:subClassOf sio:SIO_000056.
sio:SIO_000014 <http://purl.org/dc/elements/1.1/identifier> "SIO_000014";
               <http://purl.org/dc/terms/description> "A disposition is the tendency of a capability to be exhibited under certain conditions or in response to a certain stimulus (trigger)."@en;
               sio:example "solubility (to dissolve when put in fluid); fragility (disposition to break when dropped)"@en;
               sio:subset "core";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "disposition"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb20" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_000638 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000008 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000112.
sio:SIO_000015 <http://purl.org/dc/elements/1.1/identifier> "SIO_000015";
               <http://purl.org/dc/terms/description> "information content entity is an object that requires some background knowledge or procedure to correctly interpret."@en;
               sio:subset "ice+",
                          "core";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
