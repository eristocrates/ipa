               <http://purl.org/dc/terms/description> "to identify is the capability to determine the identity of something."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "to identify"@en;
               rdfs:subClassOf sio:SIO_000408.
sio:SIO_001240 <http://purl.org/dc/elements/1.1/identifier> "SIO_001240";
               <http://purl.org/dc/terms/description> "A nuclear magnetic resonance (NMR) device is a device that applies a magnetic field to perturb nuclei with an odd number of protons and/or of neutrons in order to hav them absort and re-emit electromagnetic radiation. "@en;
               sio:equivalentTo "http://purl.obolibrary.org/obo/OBI_0000566"^^xsd:anyURI;
               sio:hasSynonym "nuclear magnetic resonance device"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "nmr device"@en;
               rdfs:subClassOf sio:SIO_001236.
sio:SIO_001241 <http://purl.org/dc/elements/1.1/identifier> "SIO_001241";
               <http://purl.org/dc/terms/description> "A catalog is a systemic collection of items of the same type."@en;
               sio:hasSynonym "registry"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "catalog"@en;
               rdfs:subClassOf sio:SIO_000616.
sio:SIO_001242 <http://purl.org/dc/elements/1.1/identifier> "SIO_001242";
               <http://purl.org/dc/terms/description> "is identical to is a relation between two objects that are conceptually the same notwithstanding provenance or other non-intrinsic attributes."@en;
               a <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                 <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is identical to"@en;
               rdfs:subPropertyOf sio:SIO_000736.
sio:SIO_001243 <http://purl.org/dc/elements/1.1/identifier> "SIO_001243";
               <http://purl.org/dc/terms/description> "Likelihood is the hypothetical probability that an event that has already occurred would yield a specific outcome."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "likelihood"@en;
               rdfs:subClassOf sio:SIO_000052.
sio:SIO_001244 <http://purl.org/dc/elements/1.1/identifier> "SIO_001244";
               <http://purl.org/dc/terms/description> "Log likelihood is the natural logarithm of the likelihood function"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "log likelihood"@en;
               rdfs:subClassOf sio:SIO_001243.
sio:SIO_001245 <http://purl.org/dc/elements/1.1/identifier> "SIO_001245";
               <http://purl.org/dc/terms/description> "A standard score is the (signed) number of standard deviations an observation or datum is above the mean. "@en;
               sio:hasSynonym "z-value, z-score, normal score, standardadized variable."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "standard score"@en;
               rdfs:subClassOf sio:SIO_000638.
sio:SIO_001246 <http://purl.org/dc/elements/1.1/identifier> "SIO_001246";
               <http://purl.org/dc/terms/description> "an interval is a set of real numbers with the property that any number that lies between thwo numbers in the set is also included in the set. "@en;
               sio:example "The set of all numbers x satisfying 0<=x<=1 is an interval which contains 0 and 1, as well as numbers between them."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "interval"@en;
               rdfs:subClassOf sio:SIO_000289.
sio:SIO_001247 <http://purl.org/dc/elements/1.1/identifier> "SIO_001247";
               <http://schema.org/comment> "not implemented in standard distribution";
               sio:subset "ovopub";
               a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                 <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                 <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is transitively related to"@en.
sio:SIO_001248 <http://purl.org/dc/elements/1.1/identifier> "SIO_001248";
               <http://purl.org/dc/terms/description> "an open interval is an interval that does not include its endpoints."@en;
               sio:example "(0,1) is an open interval that is greater than 0 and less than 1."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "open interval"@en;
               rdfs:subClassOf sio:SIO_001252,
                               sio:SIO_001251.
sio:SIO_001249 <http://purl.org/dc/elements/1.1/identifier> "SIO_001249";
               <http://purl.org/dc/terms/description> "A closed interval is an interval that includes its endpoints, and is denoted with square brackets."@en;
               sio:example "[0,1] is a closed interval that is greater than or equal to 0 and less than or equal to 1."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "closed interval"@en;
               rdfs:subClassOf sio:SIO_001254,
                               sio:SIO_001253.
