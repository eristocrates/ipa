                               [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb602" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_001107 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000628 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000897.
sio:SIO_001251 <http://purl.org/dc/elements/1.1/identifier> "SIO_001251";
               <http://purl.org/dc/terms/description> "a left open interval is an interval in which there is no element that is smaller than all other elements."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "left open interval"@en;
               rdfs:subClassOf sio:SIO_001246.
sio:SIO_001252 <http://purl.org/dc/elements/1.1/identifier> "SIO_001252";
               <http://purl.org/dc/terms/description> "a right open interval is an interval in which there is no element that is greater than all other elements."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "right open interval"@en;
               rdfs:subClassOf sio:SIO_001246.
