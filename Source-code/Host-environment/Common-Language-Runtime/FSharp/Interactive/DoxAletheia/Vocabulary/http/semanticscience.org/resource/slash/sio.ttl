               sio:seeAlso "CHEBI:27560";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "boron atom"@en;
               rdfs:subClassOf sio:SIO_010044.
