               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "to describe"@en;
               rdfs:subClassOf sio:SIO_000639.
sio:SIO_001222 <http://purl.org/dc/elements/1.1/identifier> "SIO_001222";
               <http://purl.org/dc/terms/description> "The 5' splice site is the terminal region of an exon that is 5' to the intron that is to be excised."@en;
