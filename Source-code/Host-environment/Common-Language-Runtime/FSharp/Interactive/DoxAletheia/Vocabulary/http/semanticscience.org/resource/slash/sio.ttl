               rdfs:label "annoyance"@en;
               rdfs:subClassOf sio:SIO_000832.
sio:SIO_000815 <http://purl.org/dc/elements/1.1/identifier> "SIO_000815";
               <http://purl.org/dc/terms/description> "anxiety is an emotion charactersized by intense feeling of fear and concern coupled with a physical response."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "anxiety"@en;
               rdfs:subClassOf sio:SIO_000949.
sio:SIO_000816 <http://purl.org/dc/elements/1.1/identifier> "SIO_000816";
               <http://purl.org/dc/terms/description> "apathy is an emotion characterized by lack of interest, enthusiasm, or concern."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "apathy"@en;
               rdfs:subClassOf sio:SIO_000847.
sio:SIO_000817 <http://purl.org/dc/elements/1.1/identifier> "SIO_000817";
               <http://purl.org/dc/terms/description> "arousal is an emotion characterized by state of reactive to stimuli. It involves the activation of the reticular activating system in the brain stem, the autonomic nervous system and the endocrine system, leading to increased heart rate and blood pressure and a condition of sensory alertness, mobility and readiness to respond."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "arousal"@en;
               rdfs:subClassOf sio:SIO_000831.
sio:SIO_000818 <http://purl.org/dc/elements/1.1/identifier> "SIO_000818";
               <http://purl.org/dc/terms/description> "awe is an emotion produced by that which is grand, sublime or powerful and is characterized by a combination of joy, fear and admiration/reverence/respect. "@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "awe"@en;
               rdfs:subClassOf sio:SIO_000831.
sio:SIO_000819 <http://purl.org/dc/elements/1.1/identifier> "SIO_000819";
               <http://purl.org/dc/terms/description> "boldness is the trait of being willing to undertake things that involve risk or danger."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "boldness"@en;
               rdfs:subClassOf sio:SIO_000831.
sio:SIO_000820 <http://purl.org/dc/elements/1.1/identifier> "SIO_000820";
               <http://purl.org/dc/terms/description> "boredom is the emotion experience by those not interested in their surroundings or available activities."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "boredom"@en;
               rdfs:subClassOf sio:SIO_000832.
sio:SIO_000821 <http://purl.org/dc/elements/1.1/identifier> "SIO_000821";
               <http://purl.org/dc/terms/description> "contempt is disgust towards a lower status individual."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "contempt"@en;
               rdfs:subClassOf sio:SIO_000828.
sio:SIO_000822 <http://purl.org/dc/elements/1.1/identifier> "SIO_000822";
               <http://purl.org/dc/terms/description> "contentment is an emotion characterized by acknowledgement and satisfaction of the current state of affairs."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "contentment"@en;
               rdfs:subClassOf sio:SIO_000840.
sio:SIO_000823 <http://purl.org/dc/elements/1.1/identifier> "SIO_000823";
               <http://purl.org/dc/terms/description> "curiosity is the strong desire to know or learn something."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "curiosity"@en;
               rdfs:subClassOf sio:SIO_000825.
sio:SIO_000824 <http://purl.org/dc/elements/1.1/identifier> "SIO_000824";
               <http://purl.org/dc/terms/description> "depression is an unpleasant emotion linked to aversion to activity that can affect a person's thoughts, behavior, feelings and physical well-being. Depressed individuals may feel sad, anxious, empty, hopeless, worried, helpless, worthless, guilty, irritable, or restless."@en;
               sio:hasSynonym "depressed";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "depression"@en;
               rdfs:subClassOf sio:SIO_000863.
sio:SIO_000825 <http://purl.org/dc/elements/1.1/identifier> "SIO_000825";
               <http://purl.org/dc/terms/description> "desire is a strong emotion of wanting to have something or wishing for something to happen."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "desire"@en;
               rdfs:subClassOf sio:SIO_000848.
sio:SIO_000826 <http://purl.org/dc/elements/1.1/identifier> "SIO_000826";
               <http://purl.org/dc/terms/description> "despair is depression, hopelessness or lack of hope."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "despair"@en;
               rdfs:subClassOf sio:SIO_000863.
sio:SIO_000827 <http://purl.org/dc/elements/1.1/identifier> "SIO_000827";
               <http://purl.org/dc/terms/description> "disappointment is the feeling of dissatisfaction that follows the failure of expectations or hopes to manifest."@en;
               sio:hasSynonym "disappointing",
                              "disappointed";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "disappointment"@en;
               rdfs:subClassOf sio:SIO_000832.
sio:SIO_000828 <http://purl.org/dc/elements/1.1/identifier> "SIO_000828";
               <http://purl.org/dc/terms/description> "Disgust is a feeling of revulsion or profound disapproval aroused by something unpleasant or offensive."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "disgust"@en;
               rdfs:subClassOf sio:SIO_000844.
sio:SIO_000829 <http://purl.org/dc/elements/1.1/identifier> "SIO_000829";
               <http://purl.org/dc/terms/description> "dread is the instense negative emotion that induces fear and apprehension."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "dread"@en;
               rdfs:subClassOf sio:SIO_000837.
sio:SIO_000830 <http://purl.org/dc/elements/1.1/identifier> "SIO_000830";
               <http://purl.org/dc/terms/description> "ecstacy is an emotion characterized by a heightened state of consciousness with total involvement of a subject."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ecstasy"@en;
               rdfs:subClassOf sio:SIO_000831.
sio:SIO_000831 <http://purl.org/dc/elements/1.1/identifier> "SIO_000831";
               <http://purl.org/dc/terms/description> "A positive emotion is an emotion that feels good."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "positive emotion"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb391" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_001210 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000217 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000276.
sio:SIO_000832 <http://purl.org/dc/elements/1.1/identifier> "SIO_000832";
               <http://purl.org/dc/terms/description> "negative emotion is an emotion that does not feel good."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "negative emotion"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb392" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_001211 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000217 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000276.
sio:SIO_000833 <http://purl.org/dc/elements/1.1/identifier> "SIO_000833";
               <http://purl.org/dc/terms/description> "Embarrassment is the emotion of intense discomfort with oneself, experienced upon having a socially unacceptable act or condition witnessed by or revealed to other."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "embarassment"@en;
               rdfs:subClassOf sio:SIO_000832.
sio:SIO_000834 <http://purl.org/dc/elements/1.1/identifier> "SIO_000834";
               <http://purl.org/dc/terms/description> "envy is an emotion that occurs when a person lacks another's (perceived) superior quality, achievement or possession and wishes that the other lacked it."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "envy"@en;
               rdfs:subClassOf sio:SIO_000832.
sio:SIO_000835 <http://purl.org/dc/elements/1.1/identifier> "SIO_000835";
               <http://purl.org/dc/terms/description> "euphoria is an emotion characterized by intense feelings of well-being, elation, happiness, ecstasy, excitement, and joy."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "euphoria"@en;
               rdfs:subClassOf sio:SIO_000840.
sio:SIO_000836 <http://purl.org/dc/elements/1.1/identifier> "SIO_000836";
               <http://purl.org/dc/terms/description> "excitement is a positive emotion of feeling great enthusiasm and eagerness."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "excitement"@en;
               rdfs:subClassOf sio:SIO_000831.
sio:SIO_000837 <http://purl.org/dc/elements/1.1/identifier> "SIO_000837";
               <http://purl.org/dc/terms/description> "Fear is a negative emotion induced by a perceived threat that induces one to hide or move quickly away from the location of the perceived threat."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "fear"@en;
               rdfs:subClassOf sio:SIO_000949.
sio:SIO_000838 <http://purl.org/dc/elements/1.1/identifier> "SIO_000838";
               <http://purl.org/dc/terms/description> "Frustration is an emotion that arises from the perceived resistance to the fulfillment of individual will. "@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "frustration"@en;
               rdfs:subClassOf sio:SIO_000814.
sio:SIO_000839 <http://purl.org/dc/elements/1.1/identifier> "SIO_000839";
               <http://purl.org/dc/terms/description> "Gratitude, thankfulness, gratefulness, or appreciation is a feeling, emotion or attitude in acknowledgment of a benefit that one has received or will receive."@en;
               sio:hasSynonym "thankfullness",
                              "gratification",
                              "gratefulness",
                              "appreciation";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "gratitude"@en;
               rdfs:subClassOf sio:SIO_000831.
sio:SIO_000840 <http://purl.org/dc/elements/1.1/identifier> "SIO_000840";
               <http://purl.org/dc/terms/description> "happiness is an emotion characterized by positive or pleasant emotions ranging from contentment to intense joy."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "happiness"@en;
               rdfs:subClassOf sio:SIO_000831.
sio:SIO_000841 <http://purl.org/dc/elements/1.1/identifier> "SIO_000841";
               <http://purl.org/dc/terms/description> "Guilt is the emotion borne from feeling responsible for the commission of an offense and arises out of public humiliation."@en;
               sio:hasSynonym "guilty";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "guilt"@en;
               rdfs:subClassOf sio:SIO_000832.
sio:SIO_000842 <http://purl.org/dc/elements/1.1/identifier> "SIO_000842";
               <http://purl.org/dc/terms/description> "grief is an emotion in response to loss, whether physical or abstract including death, unemployment, ill health or the end of a relationship."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "grief"@en;
               rdfs:subClassOf sio:SIO_000863.
sio:SIO_000843 <http://purl.org/dc/elements/1.1/identifier> "SIO_000843";
               <http://purl.org/dc/terms/description> "hope is an emotion of belief in a positive outcome related to events and circumstances in one's life."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "hope"@en;
               rdfs:subClassOf sio:SIO_000831.
sio:SIO_000844 <http://purl.org/dc/elements/1.1/identifier> "SIO_000844";
               <http://purl.org/dc/terms/description> "Hostility is the intense negative emotion of being in conflict or opposition to someone or something."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "hostility"@en;
               rdfs:subClassOf sio:SIO_000832.
sio:SIO_000845 <http://purl.org/dc/elements/1.1/identifier> "SIO_000845";
               <http://purl.org/dc/terms/description> "hurt is an unpleasant feeling, emotion or sensation."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "hurt"@en;
               rdfs:subClassOf sio:SIO_000832.
sio:SIO_000846 <http://purl.org/dc/elements/1.1/identifier> "SIO_000846";
               <http://purl.org/dc/terms/description> "Hysteria is an unmanageable emotion."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "hysteria"@en;
               rdfs:subClassOf sio:SIO_000832.
sio:SIO_000847 <http://purl.org/dc/elements/1.1/identifier> "SIO_000847";
               <http://purl.org/dc/terms/description> "indifference is an emotion characterized by lack of interest, concern, or sympathy."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "indifference"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb393" ; 
                                <http://www.w3.org/2002/07/owl#intersectionOf> ([<http://purl.org/dc/elements/1.1/identifier> ":arc758fb394" ; 
                                                                                <http://www.w3.org/2002/07/owl#complementOf> [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb396" ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_001210 ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000217 ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                                                                a <http://www.w3.org/2002/07/owl#Class>]
                                                                                [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb397" ; 
                                                                                <http://www.w3.org/2002/07/owl#complementOf> [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb399" ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_001211 ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000217 ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                                                                a <http://www.w3.org/2002/07/owl#Class>]) ; 
                                a <http://www.w3.org/2002/07/owl#Class>],
                               sio:SIO_000276.
sio:SIO_000848 <http://purl.org/dc/elements/1.1/identifier> "SIO_000848";
               <http://purl.org/dc/terms/description> "interest is the emotion of wanting to know or learn about something or someone."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "interest"@en;
               rdfs:subClassOf sio:SIO_000831.
sio:SIO_000849 <http://purl.org/dc/elements/1.1/identifier> "SIO_000849";
               <http://purl.org/dc/terms/description> "jealousy is an emotion and typically refers to the negative thoughts and feelings of insecurity, fear, and anxiety over an anticipated loss of something that the person values, particularly in reference to a human connection."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "jealousy"@en;
               rdfs:subClassOf sio:SIO_000834.
sio:SIO_000850 <http://purl.org/dc/elements/1.1/identifier> "SIO_000850";
               <http://purl.org/dc/terms/description> "joy is an emotion of intense happiness."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "joy"@en;
               rdfs:subClassOf sio:SIO_000840.
sio:SIO_000851 <http://purl.org/dc/elements/1.1/identifier> "SIO_000851";
               <http://purl.org/dc/terms/description> "loathing is an intense dislike or disgust."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "loathing"@en;
               rdfs:subClassOf sio:SIO_000828.
sio:SIO_000852 <http://purl.org/dc/elements/1.1/identifier> "SIO_000852";
               <http://purl.org/dc/terms/description> "Loneliness is an unpleasant emotion in which a person feels a strong sense of emptiness, yearning distress and solitude resulting from inadequate quantity or quality of social relationships."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "loneliness"@en;
               rdfs:subClassOf sio:SIO_000832.
sio:SIO_000853 <http://purl.org/dc/elements/1.1/identifier> "SIO_000853";
               <http://purl.org/dc/terms/description> "lust is the strong desire for sex."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "lust"@en;
               rdfs:subClassOf sio:SIO_000825.
sio:SIO_000854 <http://purl.org/dc/elements/1.1/identifier> "SIO_000854";
               <http://purl.org/dc/terms/description> "misery is a feeling of great unhappiness, suffering and/or pain."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "misery"@en;
               rdfs:subClassOf sio:SIO_000863.
sio:SIO_000855 <http://purl.org/dc/elements/1.1/identifier> "SIO_000855";
               <http://purl.org/dc/terms/description> "Panic is a sudden emotion of fear which is so strong as to dominate or prevent reason and logical thinking, replacing it with overwhelming feelings of anxiety and frantic agitation consistent with an animalistic fight-or-flight reaction."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "panic"@en;
               rdfs:subClassOf sio:SIO_000837.
sio:SIO_000856 <http://purl.org/dc/elements/1.1/identifier> "SIO_000856";
               <http://purl.org/dc/terms/description> "passion is the intense desire for something."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "passion"@en;
               rdfs:subClassOf sio:SIO_000825.
sio:SIO_000857 <http://purl.org/dc/elements/1.1/identifier> "SIO_000857";
               <http://purl.org/dc/terms/description> "Pity is the emotion of sadness or sorrow for another."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "pity"@en;
               rdfs:subClassOf sio:SIO_000832.
sio:SIO_000858 <http://purl.org/dc/elements/1.1/identifier> "SIO_000858";
               <http://purl.org/dc/terms/description> "pleasure is an emotion of happy satisfaction and enjoyment."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "pleasure"@en;
               rdfs:subClassOf sio:SIO_000840.
sio:SIO_000859 <http://purl.org/dc/elements/1.1/identifier> "SIO_000859";
               <http://purl.org/dc/terms/description> "pride is an emotion of satisfaction of attachment toward one's own or another's choices and actions, or toward a whole group of people, and is a product of praise, independent self-reflection, or a fulfilled feeling of belonging."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "pride"@en;
               rdfs:subClassOf sio:SIO_000864.
sio:SIO_000860 <http://purl.org/dc/elements/1.1/identifier> "SIO_000860";
               <http://purl.org/dc/terms/description> "Rage is a feeling of intense anger that is associated with the Fight-or-flight response."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
