               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "rat"@en;
               rdfs:subClassOf sio:SIO_010375.
sio:SIO_000488 <http://purl.org/dc/elements/1.1/identifier> "SIO_000488";
               <http://purl.org/dc/terms/description> "A worm is a non-arthropod invertebrate animal that typically have a long cylindrical tube-like body and no legs."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "worm"@en;
               rdfs:subClassOf sio:SIO_010375.
sio:SIO_000489 <http://purl.org/dc/elements/1.1/identifier> "SIO_000489";
               <http://purl.org/dc/terms/description> "Escherichia coli (e coli) is a Gram-negative, rod-shaped bacterium that is commonly found in the lower intestine of warm-blooded organisms."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "e.coli"@en;
