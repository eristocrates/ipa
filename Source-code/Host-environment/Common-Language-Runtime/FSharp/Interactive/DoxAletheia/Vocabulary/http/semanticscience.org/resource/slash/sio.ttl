               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "mereological chart"@en;
               rdfs:subClassOf sio:SIO_000904.
sio:SIO_000941 <http://purl.org/dc/elements/1.1/identifier> "SIO_000941";
               <http://purl.org/dc/terms/description> "conversing a form of interactive, spontaneous communication between two or more agents who are following rules of etiquette."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "conversing"@en;
               rdfs:subClassOf sio:SIO_000969.
sio:SIO_000942 <http://purl.org/dc/elements/1.1/identifier> "SIO_000942";
               <http://purl.org/dc/terms/description> "A numeric label is a number used as a label."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "numeric label"@en;
               rdfs:subClassOf sio:SIO_000179.
sio:SIO_000943 <http://purl.org/dc/elements/1.1/identifier> "SIO_000943";
               <http://purl.org/dc/terms/description> "A start position is the proximal position of an object relative to an origin in a linear system."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "start position"@en;
               rdfs:subClassOf sio:SIO_000788.
sio:SIO_000944 <http://purl.org/dc/elements/1.1/identifier> "SIO_000944";
               <http://purl.org/dc/terms/description> "An interval is a set of real numbers that includes all numbers between any two numbers in the set."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "interval"@en;
               rdfs:subClassOf sio:SIO_000075.
sio:SIO_000945 <http://purl.org/dc/elements/1.1/identifier> "SIO_000945";
               <http://purl.org/dc/terms/description> "A tree diagram is a hierarchical network diagram in which a root vertex is connected to one or more other vertices through a directed edge, which in turn may be connected to other vertices."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "tree diagram"@en;
               rdfs:subClassOf sio:SIO_001332.
