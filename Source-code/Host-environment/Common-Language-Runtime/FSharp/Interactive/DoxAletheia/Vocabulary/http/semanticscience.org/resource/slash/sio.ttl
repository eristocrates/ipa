sio:SIO_000020 <http://purl.org/dc/elements/1.1/identifier> "SIO_000020";
               <http://purl.org/dc/terms/description> "denotes is a relation between an entity and what it is a sign or indication of, or what specifically means."@en;
               sio:example "the symbol '%' denotes a proportion in relation to a whole."@en;
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "denotes"@en;
