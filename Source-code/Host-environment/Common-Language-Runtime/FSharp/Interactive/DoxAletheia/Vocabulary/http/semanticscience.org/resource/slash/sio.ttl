sio:SIO_000505 <http://purl.org/dc/elements/1.1/identifier> "SIO_000505";
               <http://purl.org/dc/terms/description> "A polygon is a planar entity that is bounded by a closed path or circuit, composed of a finite connected sequence3 of straight line segments."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "polygon"@en;
               rdfs:subClassOf sio:SIO_000506.
sio:SIO_000506 <http://purl.org/dc/elements/1.1/identifier> "SIO_000506";
               <http://purl.org/dc/terms/description> "A geometric entity is an information content entity that pertains to the structure and topology of a space.";
               sio:subset "geometry+";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "geometric entity"@en;
               rdfs:subClassOf sio:SIO_000015.
sio:SIO_000507 <http://purl.org/dc/elements/1.1/identifier> "SIO_000507";
               <http://purl.org/dc/terms/description> "A point is a geometric entity that is located in a zero-dimensional spatial region and whose position is defined by its coordinates in some coordinate system."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "point"@en;
               rdfs:subClassOf sio:SIO_000506.
sio:SIO_000508 <http://purl.org/dc/elements/1.1/identifier> "SIO_000508";
               <http://purl.org/dc/terms/description> """An endpoint is a terminal point that is the last of an ordered 
pair of points."""@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "endpoint"@en;
               rdfs:subClassOf sio:SIO_000532.
sio:SIO_000509 <http://purl.org/dc/elements/1.1/identifier> "SIO_000509";
               <http://purl.org/dc/terms/description> """A start point is a terminal point which is the first of an ordered 
pair of points."""@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "start point"@en;
               rdfs:subClassOf sio:SIO_000532.
sio:SIO_000510 <http://purl.org/dc/elements/1.1/identifier> "SIO_000510";
               <http://purl.org/dc/terms/description> "A model is a representation of some thing."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "model"@en;
