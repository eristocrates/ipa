               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "to change energetically"@en;
               rdfs:subClassOf sio:SIO_000343.
sio:SIO_000386 dc11:identifier "SIO_000386";
