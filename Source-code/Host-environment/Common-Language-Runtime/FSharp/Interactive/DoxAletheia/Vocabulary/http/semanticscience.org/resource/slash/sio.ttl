               <http://purl.org/dc/terms/description> "A small nucleolar RNA (snoRNA) gene is a gene that encodes a small RNA that are associated with the eukaryotic nucleus as components of small nucleolar ribonucleoproteins."@en;
               sio:equivalentTo "http://purl.obolibrary.org/obo/SO_0001267"^^xsd:anyURI;
