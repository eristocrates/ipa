                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000716.
sio:SIO_000395 <http://purl.org/dc/elements/1.1/identifier> "SIO_000395";
               <http://purl.org/dc/terms/description> "to regulate is to control or maintain the rate or speed of an object or process."@en;
               sio:hasSynonym "to modulate"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "to regulate"@en;
               rdfs:subClassOf sio:SIO_000343.
sio:SIO_000396 <http://purl.org/dc/elements/1.1/identifier> "SIO_000396";
               <http://purl.org/dc/terms/description> "A file is an information-bearing object that contains a physical embodiment of some information using a particular character encoding."@en;
