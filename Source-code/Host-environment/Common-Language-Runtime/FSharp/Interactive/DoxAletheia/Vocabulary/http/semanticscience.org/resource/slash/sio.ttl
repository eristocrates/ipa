sio:SIO_010785 <http://purl.org/dc/elements/1.1/identifier> "SIO_010785";
               <http://purl.org/dc/terms/description> "An allotrope is a structural variant of a chemical element."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "allotrope"@en;
               rdfs:subClassOf sio:SIO_010037.
sio:SIO_010786 <http://purl.org/dc/elements/1.1/identifier> "SIO_010786";
               <http://purl.org/dc/terms/description> "A carbon allotrope is a chemical substance composed of carbon."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "carbon allotrope"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb890" ; 
                                <http://www.w3.org/2002/07/owl#allValuesFrom> sio:SIO_011001 ; 
