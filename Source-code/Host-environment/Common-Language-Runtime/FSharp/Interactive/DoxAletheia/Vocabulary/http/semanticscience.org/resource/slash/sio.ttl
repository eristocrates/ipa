                                                        owl:onProperty sio:SIO_000217 ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class].
sio:SIO_010459 dc11:identifier "SIO_010459";
               dcterms:description "A polar solvent is a solvent that exhibits a polar quality."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "polar solvent"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb857" ; 
                                owl:someValuesFrom sio:SIO_001046 ; 
                                owl:onProperty sio:SIO_000217 ; 
