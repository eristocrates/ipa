sio:SIO_000994 <http://purl.org/dc/elements/1.1/identifier> "SIO_000994";
               <http://purl.org/dc/terms/description> "An experiment is an investigation that has the goal of verifying, falsifying, or establishing the validity of a hypothesis. "@en;
               sio:hasSynonym "study";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "experiment"@en;
               rdfs:subClassOf sio:SIO_000747.
sio:SIO_000995 <http://purl.org/dc/elements/1.1/identifier> "SIO_000995";
               <http://purl.org/dc/terms/description> "suspended is the status of a process that is no longer progressing towards completion."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "suspended"@en;
               rdfs:subClassOf sio:SIO_000033.
sio:SIO_000996 <http://purl.org/dc/elements/1.1/identifier> "SIO_000996";
               <http://purl.org/dc/terms/description> "cancelled is a process status in which the process, while planned to occur, will not occur."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "cancelled"@en;
               rdfs:subClassOf sio:SIO_000963.
sio:SIO_000997 <http://purl.org/dc/elements/1.1/identifier> "SIO_000997";
               <http://purl.org/dc/terms/description> "aborted is a process status in which a started process will not complete as intended."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "aborted"@en;
               rdfs:subClassOf sio:SIO_000033.
sio:SIO_000998 <http://purl.org/dc/elements/1.1/identifier> "SIO_000998";
               <http://purl.org/dc/terms/description> "literature curation is the process of an agent selecting and extracting terms and phrases from a document."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "literature curation"@en;
