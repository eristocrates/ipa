                                owl:onClass sio:SIO_010007 ; 
                                owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; 
                                owl:onProperty sio:SIO_000369 ; 
                                a owl:Restriction],
                               sio:SIO_010506.
sio:SIO_010498 dc11:identifier "SIO_010498";
               dcterms:description "A single bond is a covalent bond between a pair of atoms in which one pair of electrons are shared."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "single bond"@en;
               rdfs:subClassOf sio:SIO_011118.
sio:SIO_010499 dc11:identifier "SIO_010499";
               dcterms:description "A double bond is a covalent bond between a pair of atoms in which two pairs of electrons are shared."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "double bond"@en;
               rdfs:subClassOf sio:SIO_011118.
sio:SIO_010500 dc11:identifier "SIO_010500";
               dcterms:description "A triple bond is a covalent bond between a pair of atoms in which three pairs of electrons are shared."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "triple bond"@en;
               rdfs:subClassOf sio:SIO_011118.
sio:SIO_010501 dc11:identifier "SIO_010501";
               dcterms:description "An aromatic bond is an interaction between a set of atoms across which pairs of electrons are shared."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "aromatic bond"@en;
               rdfs:subClassOf sio:SIO_011118.
sio:SIO_010502 dc11:identifier "SIO_010502";
               dcterms:description "A disulfide bond is a bond between two sulfur atoms."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "disulfide bond"@en;
               rdfs:subClassOf sio:SIO_010498.
sio:SIO_010503 dc11:identifier "SIO_010503";
               dcterms:description "A dipole-dipole interaction is a weak submolecular interaction between strongly electronegative atoms."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "dipole-dipole interaction"@en;
               rdfs:subClassOf sio:SIO_010005.
sio:SIO_010504 dc11:identifier "SIO_010504";
               dcterms:description "van der Waals' interaction is an a weak submolecular interaction between an instantaneous dipole and induced dipole."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "van der Waals interaction"@en;
               rdfs:subClassOf sio:SIO_010005.
sio:SIO_010505 dc11:identifier "SIO_010505";
               dcterms:description "A base stack is a stabilizing interaction of DNA and RNA between spatially adjacent nucleotides and possibly involving London dispersion, hydrophobic and electrostatic forces."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "base stack"@en;
               rdfs:subClassOf sio:SIO_010005.
sio:SIO_010506 dc11:identifier "SIO_010506";
               dcterms:description "A molecular complex is a chemical complex composed of weakly interacting molecular entities, and excludes bulk solvent."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "molecular complex"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb860" ; 
                                owl:unionOf ([dc11:identifier ":arc758fb861" ; 
                                             owl:someValuesFrom sio:SIO_010506 ; 
                                             owl:onProperty sio:SIO_000273 ; 
                                             a owl:Restriction]
                                             [dc11:identifier ":arc758fb863" ; 
                                             owl:onClass sio:SIO_011125 ; 
                                             owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty sio:SIO_000273 ; 
                                             a owl:Restriction]) ; 
                                a owl:Class],
                               sio:SIO_010004.
sio:SIO_010507 dc11:identifier "SIO_010507";
               dcterms:description "An acid-base reaction is a chemical reaction between an acid and a base."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "acid-base reaction"@en;
               rdfs:subClassOf sio:SIO_010345.
sio:SIO_010508 dc11:identifier "SIO_010508";
               dcterms:description "A catalyzed reaction is a chemical reaction that is facilitated by a catalyst."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "catalyzed reaction"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb865" ; 
                                owl:someValuesFrom sio:SIO_010344 ; 
                                owl:onProperty sio:SIO_000139 ; 
                                a owl:Restriction],
                               sio:SIO_010345.
sio:SIO_010509 dc11:identifier "SIO_010509";
               dcterms:description "A redox reaction is a chemical reaction in which there is a net movement of electrons from one reactant to another."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "redox reaction"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb866" ; 
                                owl:intersectionOf ([dc11:identifier ":arc758fb867" ; 
                                                    owl:someValuesFrom [dc11:identifier ":arc758fb869" ; 
                                                                        owl:intersectionOf (sio:SIO_010358
                                                                                            [dc11:identifier ":arc758fb871" ; 
                                                                                            owl:someValuesFrom sio:SIO_011125 ; 
                                                                                            owl:onProperty sio:SIO_000236 ; 
                                                                                            a owl:Restriction]) ; 
                                                                        a owl:Class] ; 
                                                    owl:onProperty sio:SIO_000355 ; 
                                                    a owl:Restriction]
                                                    [dc11:identifier ":arc758fb873" ; 
                                                    owl:someValuesFrom [dc11:identifier ":arc758fb875" ; 
                                                                        owl:intersectionOf (sio:SIO_010359
                                                                                            [dc11:identifier ":arc758fb877" ; 
                                                                                            owl:someValuesFrom sio:SIO_011125 ; 
                                                                                            owl:onProperty sio:SIO_000236 ; 
                                                                                            a owl:Restriction]) ; 
