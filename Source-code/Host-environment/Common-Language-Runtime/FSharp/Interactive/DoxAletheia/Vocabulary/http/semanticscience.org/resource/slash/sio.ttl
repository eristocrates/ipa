                                a owl:Restriction],
                               sio:SIO_000716.
sio:SIO_000395 dc11:identifier "SIO_000395";
               dcterms:description "to regulate is to control or maintain the rate or speed of an object or process."@en;
               sio:hasSynonym "to modulate"@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "to regulate"@en;
               rdfs:subClassOf sio:SIO_000343.
sio:SIO_000396 dc11:identifier "SIO_000396";
