sio:SIO_000408 <http://purl.org/dc/elements/1.1/identifier> "SIO_000408";
               <http://purl.org/dc/terms/description> "to investigate is the capability to uncover facts."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "to investigate"@en;
               rdfs:subClassOf sio:SIO_000494.
sio:SIO_000409 <http://purl.org/dc/elements/1.1/identifier> "SIO_000409";
               <http://purl.org/dc/terms/description> "A mutual disposition is a disposition that simulataneously invokes another disposition when realized."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "mutual disposition"@en;
