sio:SIO_000442 <http://purl.org/dc/elements/1.1/identifier> "SIO_000442";
               <http://purl.org/dc/terms/description> "A line graph is a statistical graph in which lines contains the evaluation of functions or individual points connected by line segments."@en;
               sio:example "Graph 1 in http://tinyurl.com/opwnvm"@en;
               sio:hasSynonym "line chart"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "line graph"@en;
               rdfs:subClassOf sio:SIO_000083.
sio:SIO_000443 <http://purl.org/dc/elements/1.1/identifier> "SIO_000443";
               <http://purl.org/dc/terms/description> "A bar graph is a statistical graph with rectangular bars of lengths proportional to that value that they represent."@en;
               sio:example "Graphs 3,4,5 in http://tinyurl.com/opwnvm"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "bar graph"@en;
               rdfs:subClassOf sio:SIO_000083.
sio:SIO_000444 <http://purl.org/dc/elements/1.1/identifier> "SIO_000444";
               <http://purl.org/dc/terms/description> "A horizontal bar graph is a bar graph in which the rectangular bars are horizontally oriented in space."@en;
               sio:example "Graph 3 in http://tinyurl.com/opwnvm"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "horizontal bar graph"@en;
               rdfs:subClassOf sio:SIO_000443.
sio:SIO_000445 <http://purl.org/dc/elements/1.1/identifier> "SIO_000445";
               <http://purl.org/dc/terms/description> "A vertical bar graph is a bar graph in which the rectangular bars are vertically oriented in space."@en;
               sio:example "Graph 4,5 in http://tinyurl.com/opwnvm"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "vertical bar graph"@en;
               rdfs:subClassOf sio:SIO_000443.
sio:SIO_000446 <http://purl.org/dc/elements/1.1/identifier> "SIO_000446";
               <http://purl.org/dc/terms/description> "A stacked bar graph is a bar graph in which each rectangular bar is partioned by the categorical value of each series of data."@en;
               sio:example "Graphs 6,7 in http://tinyurl.com/opwnvm"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "stacked bar graph"@en;
               rdfs:subClassOf sio:SIO_000443.
sio:SIO_000447 <http://purl.org/dc/elements/1.1/identifier> "SIO_000447";
               <http://purl.org/dc/terms/description> "A line-bar graph statistical graph that contains both lines and bars."@en;
               sio:example "Graph 8 in http://tinyurl.com/opwnvm"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "line-bar graph"@en;
               rdfs:subClassOf sio:SIO_000083.
sio:SIO_000448 <http://purl.org/dc/elements/1.1/identifier> "SIO_000448";
               <http://purl.org/dc/terms/description> "A figure part is a part of a figure."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "figure part"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb206" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_000080 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000093 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_001194.
sio:SIO_000449 <http://purl.org/dc/elements/1.1/identifier> "SIO_000449";
               <http://purl.org/dc/terms/description> "A plot is a part of a figure that corresponds to the spatial region between the set of axes."@en;
               sio:example """The square portion of the chart bounded by lines that overlap with 
the two axes in Graph 1 of http://tinyurl.com/opwnvm"""@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "plot"@en;
               rdfs:subClassOf sio:SIO_000448;
               <http://www.w3.org/2002/07/owl#disjointWith> sio:SIO_000468.
sio:SIO_000450 <http://purl.org/dc/elements/1.1/identifier> "SIO_000450";
               <http://purl.org/dc/terms/description> """An axis is a line segment that is part of a statistical graph in which the 
position along the line corresponds to a numeric or categorical value."""@en;
               <http://schema.org/comment> "The value of a plotted geometric objects (e.g. point) can be obtained from the perpendicular projection of the position of the object onto the axis. Axis may also be associated with a textual description of what the values on the axis represents.";
               sio:example """The left vertical and bottom horizontal lines with tickmarks in 
Graph 1 http://tinyurl.com/opwnvm"""@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "axis"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb207" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_000083 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000313 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000521.
sio:SIO_000451 <http://purl.org/dc/elements/1.1/identifier> "SIO_000451";
               <http://purl.org/dc/terms/description> "A Cartesian coordinate axis is an axis whose behavior follows that of a Cartesian coordinate system."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "Cartesian coordinate axis"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb208" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_000321 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000362 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000458.
sio:SIO_000452 <http://purl.org/dc/elements/1.1/identifier> "SIO_000452";
               <http://purl.org/dc/terms/description> "An x-axis is a Cartesian coordinate axis that is aligned with the horizon."@en;
               <http://schema.org/comment> "In most figures, this axis represents categories, such as months, market segments, or other non-numeric data."@en;
               sio:example "The horizontal axis in http://tinyurl.com/opwnvm"@en;
               sio:hasSynonym "horizontal axis";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "x-axis"@en;
               rdfs:subClassOf sio:SIO_000451;
               <http://www.w3.org/2002/07/owl#disjointWith> sio:SIO_000453,
                                                            sio:SIO_000454.
sio:SIO_000453 <http://purl.org/dc/elements/1.1/identifier> "SIO_000453";
               <http://purl.org/dc/terms/description> "A y-axis is a Cartesian coordinate axis that is spatially oriented perpendicular to the x-axis."@en;
               sio:hasSynonym "vertical axis";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "y-axis"@en;
               rdfs:subClassOf sio:SIO_000451.
sio:SIO_000454 <http://purl.org/dc/elements/1.1/identifier> "SIO_000454";
               <http://purl.org/dc/terms/description> "A z-axis is a Cartesian coordinate axis that is spatially oriented normal to the plane formed by the x- and y-axes."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "z-axis"@en;
               rdfs:subClassOf sio:SIO_000451.
sio:SIO_000455 <http://purl.org/dc/elements/1.1/identifier> "SIO_000455";
               <http://purl.org/dc/terms/description> "A category axis is an axis in which the position along the line is partioned into categories."@en;
               sio:example """The horizontal axis corresponding to months of the year in graph 4 
of http://tinyurl.com/opwnvm"""@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "category axis"@en;
               rdfs:subClassOf sio:SIO_000450;
               <http://www.w3.org/2002/07/owl#disjointWith> sio:SIO_000458;
               <http://www.w3.org/2002/07/owl#equivalentClass> [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb209" ; 
                                                                <http://www.w3.org/2002/07/owl#unionOf> (sio:SIO_000456
                                                                                                         sio:SIO_000457) ; 
                                                                a <http://www.w3.org/2002/07/owl#Class>].
sio:SIO_000456 <http://purl.org/dc/elements/1.1/identifier> "SIO_000456";
               <http://purl.org/dc/terms/description> "A primary category axis is a category axis that either defines the sole value range or holds the larger set of categorical values specified by the secondary category axis."@en;
               sio:example """The category axis that corresponds to years in Graph 1 of 
http://tinyurl.com/opwnvm"""@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "primary category axis"@en;
               rdfs:subClassOf sio:SIO_000455;
               <http://www.w3.org/2002/07/owl#disjointWith> sio:SIO_000457.
sio:SIO_000457 <http://purl.org/dc/elements/1.1/identifier> "SIO_000457";
               <http://purl.org/dc/terms/description> "A secondary category axis is a category axis that defines a finer granular part (or subset) of the value range of the primary category axis."@en;
               sio:example """The category axis that corresponds to months in Graph 1 of 
http://tinyurl.com/opwnvm"""@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "secondary category axis"@en;
               rdfs:subClassOf sio:SIO_000455.
sio:SIO_000458 <http://purl.org/dc/elements/1.1/identifier> "SIO_000458";
               <http://purl.org/dc/terms/description> "A value axis is an axis in which the position along the line is partioned into numeric values."@en;
               <http://schema.org/comment> "A value axis holds the properties of having a minimum and a maximum value, and is usually associated with tickmarks that indicate intervals along the axis."@en;
               sio:example """The value axis that ranges from 3.0 to 7.4 and corresponds to 
billions of dollars in Graph 1 of http://tinyurl.com/opwnvm"""@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "value axis"@en;
               rdfs:subClassOf sio:SIO_000450;
               <http://www.w3.org/2002/07/owl#equivalentClass> [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb212" ; 
                                                                <http://www.w3.org/2002/07/owl#unionOf> (sio:SIO_000459
                                                                                                         sio:SIO_000460
                                                                                                         sio:SIO_000902
                                                                                                         sio:SIO_000903) ; 
                                                                a <http://www.w3.org/2002/07/owl#Class>].
sio:SIO_000459 <http://purl.org/dc/elements/1.1/identifier> "SIO_000459";
               <http://purl.org/dc/terms/description> "A left value axis is a value axis that is spatially positioned to the left of the plot area."@en;
               sio:example "The value axis that ranges from 3.0 to 7.4 and corresponds to billions of dollars in Graph 1 of http://tinyurl.com/opwnvm"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "left value axis"@en;
               rdfs:subClassOf sio:SIO_000458.
sio:SIO_000460 <http://purl.org/dc/elements/1.1/identifier> "SIO_000460";
               <http://purl.org/dc/terms/description> "A right value axis is a value axis that is spatially positioned to the right of the plot area."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "right value axis"@en;
               rdfs:subClassOf sio:SIO_000458.
sio:SIO_000461 <http://purl.org/dc/elements/1.1/identifier> "SIO_000461";
               <http://purl.org/dc/terms/description> "A scaled value axis is a value axis in which the value range was subject to a mathematic transformation."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "scaled value axis"@en;
               rdfs:subClassOf sio:SIO_000458.
sio:SIO_000462 <http://purl.org/dc/elements/1.1/identifier> "SIO_000462";
               <http://purl.org/dc/terms/description> "A linear value axis is a value axis that corresponds to a scaling factor of 1 of the value range."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "linear value axis"@en;
               rdfs:subClassOf sio:SIO_000461;
               <http://www.w3.org/2002/07/owl#disjointWith> sio:SIO_000463.
sio:SIO_000463 <http://purl.org/dc/elements/1.1/identifier> "SIO_000463";
               <http://purl.org/dc/terms/description> "A logarithmic value axis is a scaled value axis that corresponds to a scaling factor of the logarithm of the value range."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "logarithmic value axis"@en;
               rdfs:subClassOf sio:SIO_000461.
sio:SIO_000464 <http://purl.org/dc/elements/1.1/identifier> "SIO_000464";
               <http://purl.org/dc/terms/description> "A data series is a data set composed of related values displayed in a statistical graph."@en;
               sio:example """Example: The two series that correspond to \"Seasonally adjusted\" and \"Trend\" are composed of the seasonally adjusted value of permits in each month and values from a trend derived from some mathematical tranformation across those values, respectively, in  Graph 1 of http://tinyurl.com/opwnvm"""@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "data series"@en;
               rdfs:subClassOf sio:SIO_000150.
sio:SIO_000465 <http://purl.org/dc/elements/1.1/identifier> "SIO_000465";
               <http://purl.org/dc/terms/description> "A data point is a point that which corresponds to the projection of the values of measurement data against the axes of a statistical graph."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "data point"@en;
