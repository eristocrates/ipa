sio:SIO_000094 <http://purl.org/dc/elements/1.1/identifier> "SIO_000094";
               <http://purl.org/dc/terms/description> "An algorithm is an effective method expressed as a finite list of well-defined instructions for calculating a function."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "algorithm"@en;
