                               sio:SIO_000072.
sio:SIO_000334 <http://purl.org/dc/elements/1.1/identifier> "SIO_000334";
               <http://purl.org/dc/terms/description> "is covalently connected to is a relation between an atom and another atom."@en;
               a <http://www.w3.org/2002/07/owl#SymmetricProperty>,
