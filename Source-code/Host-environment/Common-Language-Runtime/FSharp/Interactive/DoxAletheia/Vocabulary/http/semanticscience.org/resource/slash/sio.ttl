sio:SIO_000066 <http://purl.org/dc/elements/1.1/identifier> "SIO_000066";
               <http://purl.org/dc/terms/description> "is provided by is a relation between an entity and the entity that provides it."@en;
               sio:equivalentTo "dc:source";
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has provider"@en;
               rdfs:subPropertyOf sio:SIO_000253.
sio:SIO_000067 <http://purl.org/dc/elements/1.1/identifier> "SIO_000067";
