                               sio:SIO_000289.
sio:SIO_000617 dc11:identifier "SIO_000617";
               dcterms:description "An empty set is a set for which there are exactly 0 members."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "empty set"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb289" ; 
