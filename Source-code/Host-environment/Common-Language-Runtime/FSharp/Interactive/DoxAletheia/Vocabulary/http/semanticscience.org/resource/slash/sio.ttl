               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "website"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb144" ; 
                                owl:someValuesFrom sio:SIO_000302 ; 
                                owl:onProperty sio:SIO_000273 ; 
