sio:SIO_000920 <http://purl.org/dc/elements/1.1/identifier> "SIO_000920";
               <http://purl.org/dc/terms/description> "An independent variable is a variable that may take on different values independent of other elements in a system."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "independent variable"@en;
               rdfs:subClassOf sio:SIO_000367.
sio:SIO_000921 <http://purl.org/dc/elements/1.1/identifier> "SIO_000921";
               <http://purl.org/dc/terms/description> "A dependent variable is one whose value changes as a consequence of changes in other values in the system."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "dependent variable"@en;
               rdfs:subClassOf sio:SIO_000367.
sio:SIO_000922 <http://purl.org/dc/elements/1.1/identifier> "SIO_000922";
               <http://purl.org/dc/terms/description> "A Gantt chart is a bar chart that illustrates a project schedule."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "Gantt chart"@en;
               rdfs:subClassOf sio:SIO_000904.
sio:SIO_000923 <http://purl.org/dc/elements/1.1/identifier> "SIO_000923";
               <http://purl.org/dc/terms/description> "A correlation is a statistical relationship involving dependence between two random variables or datasets."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "correlation"@en;
               rdfs:subClassOf sio:SIO_000898.
sio:SIO_000924 <http://purl.org/dc/elements/1.1/identifier> "SIO_000924";
               <http://purl.org/dc/terms/description> "A television program is a audiovisual media that is produced and broadcast using a television."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "television program"@en;
               rdfs:subClassOf sio:SIO_001194.
sio:SIO_000926 <http://purl.org/dc/elements/1.1/identifier> "SIO_000926";
               <http://purl.org/dc/terms/description> "A radio receiver is a communication device that receives its input from an antenna, uses electronic filters to separate a wanted radio signal from all other signals picked up by this antenna, amplifies it to a level suitable for further processing, and finally converts through demodulation and decoding the signal into a form usable for the consumer, such as sound, pictures, digital data, measurement values, navigational positions."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "radio receiver"@en;
               rdfs:subClassOf sio:SIO_000957.
sio:SIO_000927 <http://purl.org/dc/elements/1.1/identifier> "SIO_000927";
               <http://purl.org/dc/terms/description> "The telephone is a communications device that transmits and receives sounds, and are minimally composed of a microphone to speak into, a speaker'which reproduces the voice of the other person and a ringer which makes a sound to alert the owner when a call is coming in."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "telephone"@en;
               rdfs:subClassOf sio:SIO_000957.
sio:SIO_000928 <http://purl.org/dc/elements/1.1/identifier> "SIO_000928";
               <http://purl.org/dc/terms/description> "A radar is an object-detection system which uses radio waves to determine the range, altitude, direction, or speed of objects."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "radar"@en;
               rdfs:subClassOf sio:SIO_000956.
sio:SIO_000929 <http://purl.org/dc/elements/1.1/identifier> "SIO_000929";
               <http://purl.org/dc/terms/description> "A pie chart is a circular chart divided into sectors each of whose length  is proportional to the quantity it represents."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "pie chart"@en;
               rdfs:subClassOf sio:SIO_000940.
sio:SIO_000930 <http://purl.org/dc/elements/1.1/identifier> "SIO_000930";
               <http://purl.org/dc/terms/description> "A matrix chart summarizes a multidimensional data set in a grid."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "matrix chart"@en;
               rdfs:subClassOf sio:SIO_000904.
sio:SIO_000931 <http://purl.org/dc/elements/1.1/identifier> "SIO_000931";
               <http://purl.org/dc/terms/description> "A network diagram consists of a set of vertices connected by edges."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "network diagram"@en;
               rdfs:subClassOf sio:SIO_000904.
sio:SIO_000932 <http://purl.org/dc/elements/1.1/identifier> "SIO_000932";
               <http://purl.org/dc/terms/description> "A block histogram contains an x-axis that is divided into bins which correspond to value ranges. Each item in the data set is drawn as a rectangular block, and the blocks are piled into the bins to show how many values in each range."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "block histogram"@en;
               rdfs:subClassOf sio:SIO_000911.
sio:SIO_000933 <http://purl.org/dc/elements/1.1/identifier> "SIO_000933";
               <http://purl.org/dc/terms/description> "A bubble chart contains circles whose area corresponds to a value. "@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "bubble chart"@en;
               rdfs:subClassOf sio:SIO_000904.
sio:SIO_000934 <http://purl.org/dc/elements/1.1/identifier> "SIO_000934";
               <http://purl.org/dc/terms/description> "A stack graph is a statistical graph which presents multiple series in which the distance between one series and another indicates the relative contribution to the total for any x-value."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "stack graph"@en;
               rdfs:subClassOf sio:SIO_000083.
sio:SIO_000935 <http://purl.org/dc/elements/1.1/identifier> "SIO_000935";
               <http://purl.org/dc/terms/description> "A treemap is a chart that fully partitions the area into a set of rectangles whose area represents its relative value."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "treemap"@en;
               rdfs:subClassOf sio:SIO_000940.
sio:SIO_000936 <http://purl.org/dc/elements/1.1/identifier> "SIO_000936";
               <http://purl.org/dc/terms/description> "A word tree is a chart that links phrases with contexts through a tree-like branching structure."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "word tree"@en;
               rdfs:subClassOf sio:SIO_000937.
sio:SIO_000937 <http://purl.org/dc/elements/1.1/identifier> "SIO_000937";
               <http://purl.org/dc/terms/description> "A textual chart is a chart containing text."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "textual chart"@en;
