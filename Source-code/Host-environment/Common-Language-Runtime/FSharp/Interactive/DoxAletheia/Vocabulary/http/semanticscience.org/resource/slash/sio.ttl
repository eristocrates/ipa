sio:SIO_000578 <http://purl.org/dc/elements/1.1/identifier> "SIO_000578";
               <http://purl.org/dc/terms/description> "secondary active transport or co-transport uses electrochemical potential difference created by pumping ions out of the cell to transport molecules across a membrane."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "secondary active transport"@en;
               rdfs:subClassOf sio:SIO_010284.
sio:SIO_000579 <http://purl.org/dc/elements/1.1/identifier> "SIO_000579";
               <http://purl.org/dc/terms/description> "symport enabled secondary active transport is a secondary active transfort in which both ion and molecule are transported in the same direction simultaneously."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "symport enabled secondary active transport"@en;
               rdfs:subClassOf sio:SIO_000578;
               <http://www.w3.org/2002/07/owl#disjointWith> sio:SIO_000580.
