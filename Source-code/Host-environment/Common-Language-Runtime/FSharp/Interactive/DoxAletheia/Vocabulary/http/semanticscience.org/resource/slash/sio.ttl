               rdfs:subClassOf sio:SIO_000810.
sio:SIO_010465 <http://purl.org/dc/elements/1.1/identifier> "SIO_010465";
               <http://purl.org/dc/terms/description> "An antibody (also known as immunoglobulins, abbreviated Ig) are gamma globulin proteins that are used by the immune system to identify and neutralize foreign objects. They are typically made of two large heavy chains and two small light chains."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "antibody"@en;
               rdfs:subClassOf sio:SIO_010497.
sio:SIO_010468 <http://purl.org/dc/elements/1.1/identifier> "SIO_010468";
               <http://purl.org/dc/terms/description> "An alpha helix is structural region of a protein that is characterized by 3.6 residues per turn,  a translation of 1.5 angstroms along the helical axis in which backbone N-H groups form a hydrogen bond to the backbone carboxyl group of the amino acid four residues prior."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "alpha helix"@en;
               rdfs:subClassOf sio:SIO_010471.
sio:SIO_010469 <http://purl.org/dc/elements/1.1/identifier> "SIO_010469";
               <http://purl.org/dc/terms/description> """A beta strand is structural region of a protein that is characterized by a roughly planar sequence of amino acid residues forming hydrogen bonds between the N-O and the C=O  of another part of the peptide
and having their side chains perpendicular to the planar axis."""@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "beta strand"@en;
               rdfs:subClassOf sio:SIO_010471.
sio:SIO_010471 <http://purl.org/dc/elements/1.1/identifier> "SIO_010471";
               <http://purl.org/dc/terms/description> "A protein part is any submolecule of a protein."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "protein part"@en;
               rdfs:subClassOf sio:SIO_010071.
sio:SIO_010496 <http://purl.org/dc/elements/1.1/identifier> "SIO_010496";
               <http://purl.org/dc/terms/description> "An ionic interaction is a weak submolecular interaction between a charged submolecules."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ionic interaction"@en;
               rdfs:subClassOf sio:SIO_010005.
sio:SIO_010497 <http://purl.org/dc/elements/1.1/identifier> "SIO_010497";
               <http://purl.org/dc/terms/description> "A protein complex is a molecular complex composed of at least two polypeptide chains."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "protein complex"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb859" ; 
                                <http://www.w3.org/2002/07/owl#onClass> sio:SIO_010007 ; 
                                <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "2"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000369 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_010506.
sio:SIO_010498 <http://purl.org/dc/elements/1.1/identifier> "SIO_010498";
               <http://purl.org/dc/terms/description> "A single bond is a covalent bond between a pair of atoms in which one pair of electrons are shared."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "single bond"@en;
               rdfs:subClassOf sio:SIO_011118.
sio:SIO_010499 <http://purl.org/dc/elements/1.1/identifier> "SIO_010499";
               <http://purl.org/dc/terms/description> "A double bond is a covalent bond between a pair of atoms in which two pairs of electrons are shared."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "double bond"@en;
               rdfs:subClassOf sio:SIO_011118.
sio:SIO_010500 <http://purl.org/dc/elements/1.1/identifier> "SIO_010500";
               <http://purl.org/dc/terms/description> "A triple bond is a covalent bond between a pair of atoms in which three pairs of electrons are shared."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "triple bond"@en;
               rdfs:subClassOf sio:SIO_011118.
sio:SIO_010501 <http://purl.org/dc/elements/1.1/identifier> "SIO_010501";
               <http://purl.org/dc/terms/description> "An aromatic bond is an interaction between a set of atoms across which pairs of electrons are shared."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "aromatic bond"@en;
               rdfs:subClassOf sio:SIO_011118.
sio:SIO_010502 <http://purl.org/dc/elements/1.1/identifier> "SIO_010502";
               <http://purl.org/dc/terms/description> "A disulfide bond is a bond between two sulfur atoms."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "disulfide bond"@en;
               rdfs:subClassOf sio:SIO_010498.
sio:SIO_010503 <http://purl.org/dc/elements/1.1/identifier> "SIO_010503";
               <http://purl.org/dc/terms/description> "A dipole-dipole interaction is a weak submolecular interaction between strongly electronegative atoms."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "dipole-dipole interaction"@en;
               rdfs:subClassOf sio:SIO_010005.
sio:SIO_010504 <http://purl.org/dc/elements/1.1/identifier> "SIO_010504";
               <http://purl.org/dc/terms/description> "van der Waals' interaction is an a weak submolecular interaction between an instantaneous dipole and induced dipole."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "van der Waals interaction"@en;
               rdfs:subClassOf sio:SIO_010005.
sio:SIO_010505 <http://purl.org/dc/elements/1.1/identifier> "SIO_010505";
               <http://purl.org/dc/terms/description> "A base stack is a stabilizing interaction of DNA and RNA between spatially adjacent nucleotides and possibly involving London dispersion, hydrophobic and electrostatic forces."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "base stack"@en;
               rdfs:subClassOf sio:SIO_010005.
sio:SIO_010506 <http://purl.org/dc/elements/1.1/identifier> "SIO_010506";
               <http://purl.org/dc/terms/description> "A molecular complex is a chemical complex composed of weakly interacting molecular entities, and excludes bulk solvent."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "molecular complex"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb860" ; 
                                <http://www.w3.org/2002/07/owl#unionOf> ([<http://purl.org/dc/elements/1.1/identifier> ":arc758fb861" ; 
                                                                         <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_010506 ; 
                                                                         <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000273 ; 
                                                                         a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                         [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb863" ; 
                                                                         <http://www.w3.org/2002/07/owl#onClass> sio:SIO_011125 ; 
                                                                         <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "2"^^xsd:nonNegativeInteger ; 
                                                                         <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000273 ; 
                                                                         a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                a <http://www.w3.org/2002/07/owl#Class>],
                               sio:SIO_010004.
sio:SIO_010507 <http://purl.org/dc/elements/1.1/identifier> "SIO_010507";
               <http://purl.org/dc/terms/description> "An acid-base reaction is a chemical reaction between an acid and a base."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "acid-base reaction"@en;
               rdfs:subClassOf sio:SIO_010345.
sio:SIO_010508 <http://purl.org/dc/elements/1.1/identifier> "SIO_010508";
               <http://purl.org/dc/terms/description> "A catalyzed reaction is a chemical reaction that is facilitated by a catalyst."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "catalyzed reaction"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb865" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_010344 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000139 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_010345.
sio:SIO_010509 <http://purl.org/dc/elements/1.1/identifier> "SIO_010509";
               <http://purl.org/dc/terms/description> "A redox reaction is a chemical reaction in which there is a net movement of electrons from one reactant to another."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "redox reaction"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb866" ; 
                                <http://www.w3.org/2002/07/owl#intersectionOf> ([<http://purl.org/dc/elements/1.1/identifier> ":arc758fb867" ; 
                                                                                <http://www.w3.org/2002/07/owl#someValuesFrom> [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb869" ; 
                                                                                                                                <http://www.w3.org/2002/07/owl#intersectionOf> (sio:SIO_010358
                                                                                                                                                                                [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb871" ; 
                                                                                                                                                                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_011125 ; 
