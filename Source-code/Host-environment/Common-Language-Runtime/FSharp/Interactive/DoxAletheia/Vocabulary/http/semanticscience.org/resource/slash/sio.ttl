               <http://purl.org/dc/terms/description> "unsupported is an existence quality in which there is no evidence to support the existence of the entity in any world (real or hypothetical)"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "unsupported"@en;
               rdfs:subClassOf sio:SIO_000959.
sio:SIO_000993 <http://purl.org/dc/elements/1.1/identifier> "SIO_000993";
               <http://purl.org/dc/terms/description> "A chemical-disease association is an association between a chemical and a disease."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "chemical-disease association"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb442" ; 
