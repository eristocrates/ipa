               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "speculation"@en;
               rdfs:subClassOf sio:SIO_001004.
sio:SIO_001066 <http://purl.org/dc/elements/1.1/identifier> "SIO_001066";
               <http://purl.org/dc/terms/description> "A study is a process that realizes the steps of a study design."@en;
