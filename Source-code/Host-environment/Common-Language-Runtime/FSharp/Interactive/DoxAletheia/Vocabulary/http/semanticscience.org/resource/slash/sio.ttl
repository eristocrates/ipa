               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "measurement scale"@en;
               rdfs:subClassOf sio:SIO_000315.
sio:SIO_000913 <http://purl.org/dc/elements/1.1/identifier> "SIO_000913";
               <http://purl.org/dc/terms/description> "A nominal scale of measurement only specifies a limited set of categories."@en;
