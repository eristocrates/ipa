                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_001003 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000229 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_001024.
sio:SIO_001002 <http://purl.org/dc/elements/1.1/identifier> "SIO_001002";
               <http://purl.org/dc/terms/description> "A differential diagnosis (sometimes abbreviated DDx, ddx, DD, D/Dx, or ΔΔ) is a systematic diagnostic method used to identify the presence of an entity where multiple alternatives are possible (and the process may be termed differential diagnostic procedure), and may also refer to any of the included candidate alternatives (which may also be termed candidate condition)."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "differential diagnosis"@en;
               rdfs:subClassOf sio:SIO_001024.
sio:SIO_001003 <http://purl.org/dc/elements/1.1/identifier> "SIO_001003";
               <http://purl.org/dc/terms/description> "A diagnostic opinion is an opinion resulting from a medical diagnostic procedure."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "diagnostic opinion"@en;
               rdfs:subClassOf sio:SIO_001004.
sio:SIO_001004 <http://purl.org/dc/elements/1.1/identifier> "SIO_001004";
               <http://purl.org/dc/terms/description> "An opinion is a belief that is the result of emotion or interpretation of facts. "@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "opinion"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb461" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_001001 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000311 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000360.
sio:SIO_001005 <http://purl.org/dc/elements/1.1/identifier> "SIO_001005";
               <http://purl.org/dc/terms/description> "A drug effect is a chemical interaction in which a chemical elicits a marked characteristic of a biological system."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "drug effect"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb462" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_010038 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000139 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_010013.
sio:SIO_001006 <http://purl.org/dc/elements/1.1/identifier> "SIO_001006";
               <http://purl.org/dc/terms/description> "A drug-drug interaction is an interaction in which two drugs interact in such a way to produce a non-additive biological response."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "drug drug interaction"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb463" ; 
                                <http://www.w3.org/2002/07/owl#onClass> sio:SIO_010038 ; 
                                <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "2"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000132 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_001005.
sio:SIO_001007 <http://purl.org/dc/elements/1.1/identifier> "SIO_001007";
               <http://purl.org/dc/terms/description> "An assay is an investigative (analytic) procedure in laboratory medicine, pharmacology, environmental biology, and molecular biology for qualitatively assessing or quantitatively measuring the presence or amount or the functional activity of a target entity (the analyte) which can be a drug or biochemical substance or a cell in an organism or organic sample."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "assay"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb472" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_000776 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000230 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb464" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb465" ; 
                                                                                <http://www.w3.org/2002/07/owl#intersectionOf> ([<http://purl.org/dc/elements/1.1/identifier> ":arc758fb466" ; 
                                                                                                                                <http://www.w3.org/2002/07/owl#unionOf> (sio:SIO_000070
                                                                                                                                                                         sio:SIO_000959) ; 
                                                                                                                                a <http://www.w3.org/2002/07/owl#Class>]
                                                                                                                                [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb470" ; 
                                                                                                                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_000000 ; 
                                                                                                                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000011 ; 
                                                                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                a <http://www.w3.org/2002/07/owl#Class>] ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000229 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000999.
sio:SIO_001008 <http://purl.org/dc/elements/1.1/identifier> "SIO_001008";
               <http://purl.org/dc/terms/description> "toxicity is the quality of a chemical substance to cause injury to an organism in a dose dependent manner."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "toxicity"@en;
               rdfs:subClassOf sio:SIO_001011;
               <http://www.w3.org/2002/07/owl#equivalentClass> [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb473" ; 
                                                                <http://www.w3.org/2002/07/owl#unionOf> (sio:SIO_001009
                                                                                                         sio:SIO_001010) ; 
                                                                a <http://www.w3.org/2002/07/owl#Class>].
sio:SIO_001009 <http://purl.org/dc/elements/1.1/identifier> "SIO_001009";
               <http://purl.org/dc/terms/description> "toxic is the quality of a substance imparing the normal functioning of a  system."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "toxic"@en;
               rdfs:subClassOf sio:SIO_001008;
               <http://www.w3.org/2002/07/owl#disjointWith> sio:SIO_001010.
sio:SIO_001010 <http://purl.org/dc/elements/1.1/identifier> "SIO_001010";
               <http://purl.org/dc/terms/description> "non toxic is the quality of a substance having no damaging effect to a system."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "non toxic"@en;
               rdfs:subClassOf sio:SIO_001008.
sio:SIO_001011 <http://purl.org/dc/elements/1.1/identifier> "SIO_001011";
               <http://purl.org/dc/terms/description> "chemical quality is the quality of a chemical entity."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "chemical quality"@en;
               rdfs:subClassOf sio:SIO_000026.
sio:SIO_001012 <http://purl.org/dc/elements/1.1/identifier> "SIO_001012";
               <http://purl.org/dc/terms/description> "healthy is an organismal state of complete physical, mental and social well-being."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "healthy"@en;
               rdfs:subClassOf sio:SIO_010058.
sio:SIO_001013 <http://purl.org/dc/elements/1.1/identifier> "SIO_001013";
               <http://purl.org/dc/terms/description> "age is the length of time that a person has lived or a thing has existed."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "age"@en;
               rdfs:subClassOf sio:SIO_000258.
sio:SIO_001014 <http://purl.org/dc/elements/1.1/identifier> "SIO_001014";
               <http://purl.org/dc/terms/description> "ethnicity is the biological quality of membership in a social group based on a common heritage."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ethnicity"@en;
               rdfs:subClassOf sio:SIO_000475.
sio:SIO_001015 <http://purl.org/dc/elements/1.1/identifier> "SIO_001015";
               <http://purl.org/dc/terms/description> "race is a characteristic of an individual by heritable phenotypic characteristics, geographic ancestry, physical appearance, ethnicity, and social status."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "race"@en;
               rdfs:subClassOf sio:SIO_000475.
sio:SIO_001016 <http://purl.org/dc/elements/1.1/identifier> "SIO_001016";
               <http://purl.org/dc/terms/description> "An ethnic group is a group of people whose members identify with each other through a common heritage, consisting of a common culture, including a shared language or dialect. "@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ethnic group"@en;
               rdfs:subClassOf sio:SIO_001062.
sio:SIO_001017 <http://purl.org/dc/elements/1.1/identifier> "SIO_001017";
               <http://purl.org/dc/terms/description> "A syndrome is composed of a set of several clinically recognizable features, signs (observed by someone other than the patient), symptoms (reported by the patient), phenomena or characteristics that often occur together."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "syndrome"@en;
               rdfs:subClassOf sio:SIO_000136.
sio:SIO_001018 <http://purl.org/dc/elements/1.1/identifier> "SIO_001018";
               <http://purl.org/dc/terms/description> "A ratio is a relationship between two numbers of the same kind expressed arithmetically as a dimensionless quotient of the two which explicitly indicates how many times the first number contains the second."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ratio"@en;
               rdfs:subClassOf sio:SIO_000257.
sio:SIO_001019 <http://purl.org/dc/elements/1.1/identifier> "SIO_001019";
               <http://purl.org/dc/terms/description> "A dose is the quantity of a chemical substance administered to a biological system."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "dose"@en;
               rdfs:subClassOf sio:SIO_000258.
sio:SIO_001020 <http://purl.org/dc/elements/1.1/identifier> "SIO_001020";
               <http://purl.org/dc/terms/description> "effective dose is the amount of a substance required to produce an effect on a predefined percentage of a population."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "effective dose"@en;
               rdfs:subClassOf sio:SIO_001019.
sio:SIO_001021 <http://purl.org/dc/elements/1.1/identifier> "SIO_001021";
               <http://purl.org/dc/terms/description> "An expected value (or e-value) is the weighted average of all possible values that a random variable can take on."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "expected value"@en;
               rdfs:subClassOf sio:SIO_000638.
sio:SIO_001022 <http://purl.org/dc/elements/1.1/identifier> "SIO_001022";
               <http://purl.org/dc/terms/description> "A diagnostic test is a procedure performed to confirm, or determine the presence of disease in an individual suspected of having the disease, usually following the report of symptoms, or based on the results of other medical tests."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "diagnostic test"@en;
               rdfs:subClassOf sio:SIO_001024.
sio:SIO_001023 <http://purl.org/dc/elements/1.1/identifier> "SIO_001023";
               <http://purl.org/dc/terms/description> "A medical screening is a medical test or series used to detect or predict the presence of disease in individuals at risk for disease within a defined group, such as a population, family, or workforce"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "medical screening"@en;
               rdfs:subClassOf sio:SIO_001024.
sio:SIO_001024 <http://purl.org/dc/elements/1.1/identifier> "SIO_001024";
               <http://purl.org/dc/terms/description> "A medical procedure is a procedure to identify, examine, alleviate or eliminate an undesirable biological disease or disorder."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "medical procedure"@en;
               rdfs:subClassOf sio:SIO_000999.
sio:SIO_001025 <http://purl.org/dc/elements/1.1/identifier> "SIO_001025";
               <http://purl.org/dc/terms/description> "A prognosis is a proposition about the likely course of a disease, the chance of recovery or recurrence."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "prognosis"@en;
