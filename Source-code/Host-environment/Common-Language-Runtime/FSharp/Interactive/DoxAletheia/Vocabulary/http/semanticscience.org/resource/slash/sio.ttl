               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "length of perimeter"@en;
               rdfs:subClassOf sio:SIO_000044.
sio:SIO_000047 <http://purl.org/dc/elements/1.1/identifier> "SIO_000047";
               <http://purl.org/dc/terms/description> "circumference is the length of the outline of a circle or ellipse. it is defined as c = 2*pi*r, where r is the radius."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "circumference"@en;
