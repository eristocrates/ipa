               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "orientation"@en;
               rdfs:subClassOf sio:SIO_000056.
sio:SIO_000059 <http://purl.org/dc/elements/1.1/identifier> "SIO_000059";
               <http://purl.org/dc/terms/description> "has member is a mereological relation between a collection and an item."@en;
               sio:example "a collection of cars has as a car as a member"@en;
               sio:subset "core";
               a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has member"@en;
