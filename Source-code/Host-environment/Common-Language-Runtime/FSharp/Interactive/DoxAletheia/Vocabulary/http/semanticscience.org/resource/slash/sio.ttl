               rdfs:label "non-protein coding RNA (ncRNA)"@en;
               rdfs:subClassOf sio:SIO_010450.
sio:SIO_001236 <http://purl.org/dc/elements/1.1/identifier> "SIO_001236";
               <http://purl.org/dc/terms/description> "A data collection device is a device that collects information about one or more objects."@en;
