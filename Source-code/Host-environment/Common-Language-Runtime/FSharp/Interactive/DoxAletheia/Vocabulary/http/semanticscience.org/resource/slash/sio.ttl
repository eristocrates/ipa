sio:SIO_000387 <http://purl.org/dc/elements/1.1/identifier> "SIO_000387";
               <http://purl.org/dc/terms/description> "to negatively charge is the capability to add an electron or negatively charged ion to a chemical entity."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "to negatively charge"@en;
