               <http://purl.org/dc/terms/description> "A small cytoplasmic RNA (scRNA) gene is a gene that encodes a small (7S; 129 nucleotides) RNA molecule found in the cytosol and rough endoplasmic reticulum that are normally associated with proteins that are involved in specific selection and transport of other proteins."@en;
               sio:equivalentTo "http://purl.obolibrary.org/obo/SO_0001266"^^xsd:anyURI;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "small cytoplasmic RNA (scRNA) gene"@en;
