               <http://purl.org/dc/terms/description> "A measurement of a spatial location relative to a frame of reference or other objects."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
