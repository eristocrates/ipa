sio:SIO_000308 <http://purl.org/dc/elements/1.1/identifier> "SIO_000308";
               <http://purl.org/dc/terms/description> "An edition number is count of a literary work edited and published, as by a certain editor or in a certain manner including being printed during some interval of time."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "edition number"@en;
