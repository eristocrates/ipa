               rdfs:subClassOf sio:SIO_000005.
sio:SIO_001213 <http://purl.org/dc/elements/1.1/identifier> "SIO_001213";
               <http://purl.org/dc/terms/description> "mild is a qualitative intensity value that is more intense than weak, but less intense than moderate."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "mild"@en;
               rdfs:subClassOf sio:SIO_001212.
sio:SIO_001214 <http://purl.org/dc/elements/1.1/identifier> "SIO_001214";
               <http://purl.org/dc/terms/description> "moderate is a qualitative intensity value that is more intense than mild, but less intense than strong."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "moderate"@en;
               rdfs:subClassOf sio:SIO_001212.
sio:SIO_001215 <http://purl.org/dc/elements/1.1/identifier> "SIO_001215";
               <http://purl.org/dc/terms/description> "severe is a qualitative intensity value that is more intense than strong, but less intense than fatal."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "severe"@en;
               rdfs:subClassOf sio:SIO_001212.
sio:SIO_001216 <http://purl.org/dc/elements/1.1/identifier> "SIO_001216";
               <http://purl.org/dc/terms/description> "fatal is a qualitative intensity value that is more intense than severe, leading to the death/non-functioning of a system."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "fatal"@en;
               rdfs:subClassOf sio:SIO_001212.
sio:SIO_001217 <http://purl.org/dc/elements/1.1/identifier> "SIO_001217";
               <http://purl.org/dc/terms/description> "strong is a qualitative intensity value that is more intense than moderate, but less intense than severe."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "strong"@en;
               rdfs:subClassOf sio:SIO_001212.
sio:SIO_001218 <http://purl.org/dc/elements/1.1/identifier> "SIO_001218";
               <http://purl.org/dc/terms/description> "weak is a qualitative intensity value that is more intense than none, but less intense than mild."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "weak"@en;
               rdfs:subClassOf sio:SIO_001212.
sio:SIO_001219 <http://purl.org/dc/elements/1.1/identifier> "SIO_001219";
               <http://purl.org/dc/terms/description> "to test a hypothesis is the capability to evaluate the truth value of a proposition based on gathered evidence."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "to test a hypothesis"@en;
               rdfs:subClassOf sio:SIO_000724.
sio:SIO_001220 <http://purl.org/dc/elements/1.1/identifier> "SIO_001220";
               <http://purl.org/dc/terms/description> "to characterize is the capability to classify the attributes or features of an entity against a reference classification."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "to characterize"@en;
               rdfs:subClassOf sio:SIO_001221.
sio:SIO_001221 <http://purl.org/dc/elements/1.1/identifier> "SIO_001221";
               <http://purl.org/dc/terms/description> "to describe is the capabilty to communicate facts about an entity."@en;
