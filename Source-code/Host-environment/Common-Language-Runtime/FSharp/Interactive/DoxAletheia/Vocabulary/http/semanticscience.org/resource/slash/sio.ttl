                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000506.
sio:SIO_000503 <http://purl.org/dc/elements/1.1/identifier> "SIO_000503";
               <http://purl.org/dc/terms/description> "A polygonal face is a polygon bounded by a circuit of polygon edges, and includes the flat (plane) region inside the boundary."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "polygonal face"@en;
