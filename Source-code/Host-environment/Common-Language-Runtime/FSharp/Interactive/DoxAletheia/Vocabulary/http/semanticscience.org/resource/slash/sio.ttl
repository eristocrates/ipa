sio:SIO_000097 <http://purl.org/dc/elements/1.1/identifier> "SIO_000097";
               <http://purl.org/dc/terms/description> "A software entity is a computational entity that can be interpreted by or directly executed by a processing unit."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software entity"@en;
               rdfs:subClassOf sio:SIO_000602.
sio:SIO_000098 <http://purl.org/dc/elements/1.1/identifier> "SIO_000098";
               <http://purl.org/dc/terms/description> "A software method (also called subroutine, subprogram, procedure, method, function, or routine) is software designed to execute a specific task."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software method"@en;
               rdfs:subClassOf sio:SIO_000097.
sio:SIO_000099 <http://purl.org/dc/elements/1.1/identifier> "SIO_000099";
               <http://purl.org/dc/terms/description> "A software module is software composed of a collection of software methods."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software module"@en;
               rdfs:subClassOf sio:SIO_000097.
sio:SIO_000100 <http://purl.org/dc/elements/1.1/identifier> "SIO_000100";
               <http://purl.org/dc/terms/description> "A software library is software composed of a collection of software modules and/or software methods in a form that can be statically or dynamically linked to some software application."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software library"@en;
