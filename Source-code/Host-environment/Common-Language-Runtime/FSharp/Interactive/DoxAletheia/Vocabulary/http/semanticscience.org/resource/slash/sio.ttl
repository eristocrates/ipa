                                                                     sio:SIO_011125) ; 
                                                        a owl:Class]
                                                        [dc11:identifier ":arc758fb847" ; 
                                                        owl:someValuesFrom sio:SIO_010442 ; 
                                                        owl:onProperty sio:SIO_000217 ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class].
sio:SIO_010457 dc11:identifier "SIO_010457";
               dcterms:description "An anion is an atom or molecule with a net positive electrical charge."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "cation"@en;
               owl:equivalentClass [dc11:identifier ":arc758fb849" ; 
                                    owl:intersectionOf (sio:SIO_010456
                                                        [dc11:identifier ":arc758fb851" ; 
