                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000904.
sio:SIO_000938 <http://purl.org/dc/elements/1.1/identifier> "SIO_000938";
               <http://purl.org/dc/terms/description> "A tag cloud is a visualization of word frequencies."@en;
               sio:hasSynonym "word cloud"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "tag cloud"@en;
               rdfs:subClassOf sio:SIO_000937.
sio:SIO_000939 <http://purl.org/dc/elements/1.1/identifier> "SIO_000939";
               <http://purl.org/dc/terms/description> "A phrase net diagram illustrates the relationship between different words used in a text."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "phrase net diagram"@en;
               rdfs:subClassOf sio:SIO_000937.
sio:SIO_000940 <http://purl.org/dc/elements/1.1/identifier> "SIO_000940";
               <http://purl.org/dc/terms/description> "A mereological chart is a chart that illustrates the parts in the context of the whole."@en;
