sio:SIO_010510 <http://purl.org/dc/elements/1.1/identifier> "SIO_010510";
               <http://purl.org/dc/terms/description> "An inorganic reaction is a chemical reaction that involves the transformation of inorganic molecules."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "inorganic reaction"@en;
               rdfs:subClassOf sio:SIO_010345.
sio:SIO_010511 <http://purl.org/dc/elements/1.1/identifier> "SIO_010511";
               <http://purl.org/dc/terms/description> "A decomposition reaction is an inorganic reaction in which molecule is fragmented into submolecules or atoms."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "decomposition reaction"@en;
               rdfs:subClassOf sio:SIO_010510.
sio:SIO_010512 <http://purl.org/dc/elements/1.1/identifier> "SIO_010512";
               <http://purl.org/dc/terms/description> "A displacement reaction is an inorganic reaction in which a elementary substance displaces and sets free a constituent atom from a molecule."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "displacement reaction"@en;
               rdfs:subClassOf sio:SIO_010510.
sio:SIO_010513 <http://purl.org/dc/elements/1.1/identifier> "SIO_010513";
               <http://purl.org/dc/terms/description> "A double displacement reaction is a displacement reaction in which two molecules swap ions, effectively displacing each other to form two new molecules."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "double displacement reaction"@en;
               rdfs:subClassOf sio:SIO_010512.
sio:SIO_010514 <http://purl.org/dc/elements/1.1/identifier> "SIO_010514";
               <http://purl.org/dc/terms/description> "A single displacement reaction where one atom is transferred out of one molecule and into another."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "single displacement reaction"@en;
               rdfs:subClassOf sio:SIO_010512.
sio:SIO_010515 <http://purl.org/dc/elements/1.1/identifier> "SIO_010515";
               <http://purl.org/dc/terms/description> "A synthesis reaction is an inorganic reaction in which two or more molecules are chemically bonded together to produce a single product."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "synthesis reaction"@en;
               rdfs:subClassOf sio:SIO_010510.
sio:SIO_010516 <http://purl.org/dc/elements/1.1/identifier> "SIO_010516";
               <http://purl.org/dc/terms/description> "An organic reaction is a chemical reaction involving at least one organic molecule."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "organic reaction"@en;
               rdfs:subClassOf sio:SIO_010345.
sio:SIO_010517 <http://purl.org/dc/elements/1.1/identifier> "SIO_010517";
               <http://purl.org/dc/terms/description> "An isomerization reaction is a chemical reaction in which a molecule is converted into its isomer."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "isomerization reaction"@en;
               rdfs:subClassOf sio:SIO_010345.
sio:SIO_010518 <http://purl.org/dc/elements/1.1/identifier> "SIO_010518";
               <http://purl.org/dc/terms/description> """An addition reaction is an organic reaction where two or more molecules combine to form a larger one. Addition reactions are limited to chemical compounds that have multiply-bonded atoms:
    * Molecules with carbon-carbon double bonds or triple bonds
    * Molecules with carbon - hetero double bonds like C=O or C=N"""@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "addition reaction"@en;
               rdfs:subClassOf sio:SIO_010516.
sio:SIO_010519 <http://purl.org/dc/elements/1.1/identifier> "SIO_010519";
               <http://purl.org/dc/terms/description> "A polar addition reaction is an addition reaction involving polar residues."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "polar addition reaction"@en;
               rdfs:subClassOf sio:SIO_010518.
sio:SIO_010520 <http://purl.org/dc/elements/1.1/identifier> "SIO_010520";
               <http://purl.org/dc/terms/description> "A non-polar addition reaction is an addition reaction involving non-polar residues."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "non-polar addition reaction"@en;
               rdfs:subClassOf sio:SIO_010518.
sio:SIO_010521 <http://purl.org/dc/elements/1.1/identifier> "SIO_010521";
               <http://purl.org/dc/terms/description> "A free radical addition is a non-polar addition reaction involving free radicals."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "free radical addition"@en;
               rdfs:subClassOf sio:SIO_010520.
sio:SIO_010522 <http://purl.org/dc/elements/1.1/identifier> "SIO_010522";
               <http://purl.org/dc/terms/description> "A nucleophilic addition reaction is an addition reaction where a pi bond is removed by the creation of two new covalent bonds by the addition from a nucleophile."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "nucleophilic addition reaction"@en;
               rdfs:subClassOf sio:SIO_010519.
sio:SIO_010523 <http://purl.org/dc/elements/1.1/identifier> "SIO_010523";
               <http://purl.org/dc/terms/description> "An electrophilic addition reaction is a polar addition reaction where a pi bond is removed by the creation of two new covalent bonds."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "electrophilic addition reaction"@en;
               rdfs:subClassOf sio:SIO_010519.
sio:SIO_010525 <http://purl.org/dc/elements/1.1/identifier> "SIO_010525";
               <http://purl.org/dc/terms/description> "A biochemical pathway specifies a series of biochemical modifications and transformations towards achieving some biological outcome."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "biochemical pathway"@en;
               rdfs:subClassOf sio:SIO_010526.
sio:SIO_010526 <http://purl.org/dc/elements/1.1/identifier> "SIO_010526";
               <http://purl.org/dc/terms/description> "A chemical reaction pathway specifies a series of chemical reactions towards producing some chemical product."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "chemical reaction pathway"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb882" ; 
                                <http://www.w3.org/2002/07/owl#allValuesFrom> sio:SIO_010345 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000059 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb881" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_000006 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000632 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb879" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb880" ; 
                                                                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_010345 ; 
                                                                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000053 ; 
                                                                                a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000338 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_001107.
sio:SIO_010527 <http://purl.org/dc/elements/1.1/identifier> "SIO_010527";
               <http://purl.org/dc/terms/description> "A chemical synthesis pathway is a pathway involved in the assembly of a chemical."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "chemical synthesis pathway"@en;
               rdfs:subClassOf sio:SIO_010526.
sio:SIO_010528 <http://purl.org/dc/elements/1.1/identifier> "SIO_010528";
               <http://purl.org/dc/terms/description> "A chemical degradation pathway is a pathway involved in the disassembly of a chemical."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "chemical degradation pathway"@en;
               rdfs:subClassOf sio:SIO_010526.
sio:SIO_010530 <http://purl.org/dc/elements/1.1/identifier> "SIO_010530";
               <http://purl.org/dc/terms/description> "A 3D structure model is a representation of the spatial arrangement of one or more chemical entities."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "3d structure model"@en;
               rdfs:subClassOf sio:SIO_010023.
sio:SIO_010531 <http://purl.org/dc/elements/1.1/identifier> "SIO_010531";
               <http://purl.org/dc/terms/description> "A sequence profile is provides the preference for a character at each position of an abstracted sequence."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "sequence profile"@en;
               rdfs:subClassOf sio:SIO_010065.
sio:SIO_010532 <http://purl.org/dc/elements/1.1/identifier> "SIO_010532";
               <http://purl.org/dc/terms/description> "A metabolic pathway is a series of biochemical reactions that begins with one or more substrates and ends with one or more products."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "metabolic pathway"@en;
               rdfs:subClassOf sio:SIO_010525;
               <http://www.w3.org/2002/07/owl#disjointWith> sio:SIO_010533.
sio:SIO_010533 <http://purl.org/dc/elements/1.1/identifier> "SIO_010533";
               <http://purl.org/dc/terms/description> "A regulatory pathway is a series of biochemical reactions that lead to the increase or decrease of activity of participating molecular components."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "regulatory pathway"@en;
               rdfs:subClassOf sio:SIO_010525.
sio:SIO_010673 <http://purl.org/dc/elements/1.1/identifier> "SIO_010673";
               <http://purl.org/dc/terms/description> "A medical history is a record of the events of a recipient of medical care."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "medical history"@en;
               rdfs:subClassOf sio:SIO_001196.
sio:SIO_010674 <http://purl.org/dc/elements/1.1/identifier> "SIO_010674";
               <http://purl.org/dc/terms/description> "A binary compound is a mereological maximum sum of two kinds of weakly connected entities."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "binary compound"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb883" ; 
                                <http://www.w3.org/2002/07/owl#onClass> sio:SIO_011125 ; 
                                <http://www.w3.org/2002/07/owl#qualifiedCardinality> "2"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000273 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_011126.
sio:SIO_010775 <http://purl.org/dc/elements/1.1/identifier> "SIO_010775";
               <http://purl.org/dc/terms/description> "A stereoisomer is an isomer in which the atomic connectivity is the same, but differs in its spatial arrangement of atoms."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "stereoisomer"@en;
               rdfs:subClassOf sio:SIO_010455.
sio:SIO_010776 <http://purl.org/dc/elements/1.1/identifier> "SIO_010776";
               <http://purl.org/dc/terms/description> "A diastereomer is a stereoisomer that is not a mirror image of its isomer."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "diastereomer"@en;
               rdfs:subClassOf sio:SIO_010775.
sio:SIO_010777 <http://purl.org/dc/elements/1.1/identifier> "SIO_010777";
               <http://purl.org/dc/terms/description> "An enantiomer is a stereoisomer that is a mirror image of its isomer."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "enantiomer"@en;
               rdfs:subClassOf sio:SIO_010775.
sio:SIO_010778 <http://purl.org/dc/elements/1.1/identifier> "SIO_010778";
               <http://purl.org/dc/terms/description> "An optical isomer is a stereoisomer that rotates the plane of polarization of a beam of plane polarized light."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "optical isomer"@en;
               rdfs:subClassOf sio:SIO_010775.
sio:SIO_010779 <http://purl.org/dc/elements/1.1/identifier> "SIO_010779";
               <http://purl.org/dc/terms/description> "A structural isomer is an isomer in which the atoms are joined together in different ways."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "structural isomer"@en;
               rdfs:subClassOf sio:SIO_010455.
sio:SIO_010780 <http://purl.org/dc/elements/1.1/identifier> "SIO_010780";
               <http://purl.org/dc/terms/description> "A ring is a submolecule with a circular topology."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ring"@en;
