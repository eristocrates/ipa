sio:SIO_000407 <http://purl.org/dc/elements/1.1/identifier> "SIO_000407";
               <http://purl.org/dc/terms/description> "to increase the rate of formation is to regulate the rate of formation in a manner that increases this rate relative to a reference process."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "to increase the rate of formation"@en;
