sio:SIO_000053 <http://purl.org/dc/elements/1.1/identifier> "SIO_000053";
               <http://purl.org/dc/terms/description> "has proper part is an antisymmetric, irreflexive (normally transitive) relation between a whole and a distinct part."@en;
               sio:example "a car has an engine as a proper part; a car has a piston as a proper part;"@en;
               a <http://www.w3.org/2002/07/owl#IrreflexiveProperty>,
                 <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                 <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has proper part"@en;
               rdfs:subPropertyOf sio:SIO_000028;
               <http://www.w3.org/2002/07/owl#inverseOf> sio:SIO_000093.
sio:SIO_000054 <http://purl.org/dc/elements/1.1/identifier> "SIO_000054";
               <http://purl.org/dc/terms/description> "has boundary is a mereological relation between a whole and boundary located at its periphery."@en;
               sio:example "the surface of an apple is a 2D boundary of the apple."@en;
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has boundary"@en;
               rdfs:subPropertyOf sio:SIO_000053;
               <http://www.w3.org/2002/07/owl#inverseOf> sio:SIO_000096.
