                                                                        a owl:Restriction]) ; 
                                                    a owl:Class] ; 
                                owl:onProperty sio:SIO_000053 ; 
                                a owl:Restriction],
                               sio:SIO_000259.
sio:SIO_000268 dc11:identifier "SIO_000268";
               dcterms:description "truth value is a quality of information that is claimed/verified to be true or false."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "truth value"@en;
               rdfs:subClassOf sio:SIO_000436;
               owl:equivalentClass [dc11:identifier ":arc758fb133" ; 
                                    owl:unionOf (sio:SIO_000269
                                                 sio:SIO_000270) ; 
                                    a owl:Class].
sio:SIO_000269 dc11:identifier "SIO_000269";
               dcterms:description "true is a truth value that indicates that it holds under all possible worlds."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "true"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb136" ; 
                                owl:hasValue true ; 
                                owl:onProperty sio:SIO_000300 ; 
                                a owl:Restriction],
                               sio:SIO_000268;
               owl:disjointWith sio:SIO_000270.
sio:SIO_000270 dc11:identifier "SIO_000270";
               dcterms:description "false is a truth value in that indicates that it is not true."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "false"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb137" ; 
                                owl:hasValue false ; 
                                owl:onProperty sio:SIO_000300 ; 
                                a owl:Restriction],
                               sio:SIO_000268.
sio:SIO_000272 dc11:identifier "SIO_000272";
               dcterms:description "is variant of: a relationship indicating that two entities are different (by some measure), but either achieve the same objectives in different ways or are permutations of one another (temporal, logical or otherwise)"@en;
               sio:subset "core";
               a owl:TransitiveProperty,
                 owl:SymmetricProperty,
                 owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is variant of"@en;
               rdfs:subPropertyOf sio:SIO_000736.
sio:SIO_000273 dc11:identifier "SIO_000273";
               dcterms:description "has direct part is a relation to specify a part at a particular level of granularity"@en;
               sio:example "a car has an engine as a direct part"@en;
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has direct part"@en;
               rdfs:subPropertyOf sio:SIO_000053;
               owl:inverseOf sio:SIO_000310.
sio:SIO_000274 dc11:identifier "SIO_000274";
               dcterms:description "A is prior version of B iff A is a variant of B and B derives from A."@en;
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is prior version of"@en;
               rdfs:subPropertyOf sio:SIO_000497,
                                  sio:SIO_000244;
               owl:inverseOf sio:SIO_000286.
sio:SIO_000275 dc11:identifier "SIO_000275";
               dcterms:description "A term is a word or phrase used to denote one or more entities."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "term"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb138" ; 
                                owl:unionOf (sio:SIO_000114
                                             sio:SIO_000483) ; 
                                a owl:Class],
                               sio:SIO_000483.
sio:SIO_000276 dc11:identifier "SIO_000276";
               dcterms:description "An emotion is a process (experience) that arises internally or from an involuntary physiological response to a stimulus."@en;
               sio:subset "emotion++";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "emotion"@en;
               rdfs:subClassOf sio:SIO_001195.
sio:SIO_000277 dc11:identifier "SIO_000277";
               dcterms:description "cites is a relation to refer to by way of example, authority or proof."@en;
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "cites"@en;
               rdfs:subPropertyOf sio:SIO_000631;
               owl:inverseOf sio:SIO_000278.
sio:SIO_000278 dc11:identifier "SIO_000278";
               dcterms:description "is cited by is a relation from an object that is referred to by way of example, authority or proof."@en;
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is cited by"@en;
               rdfs:subPropertyOf sio:SIO_000252.
sio:SIO_000279 dc11:identifier "SIO_000279";
               dcterms:description "mass is the quality of the amount of substance."@en;
