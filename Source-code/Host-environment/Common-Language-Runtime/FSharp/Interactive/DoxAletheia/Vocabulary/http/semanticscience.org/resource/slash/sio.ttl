               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "population"@en;
               rdfs:subClassOf sio:SIO_000620.
sio:SIO_001062 <http://purl.org/dc/elements/1.1/identifier> "SIO_001062";
               <http://purl.org/dc/terms/description> "A human population refers to a collection of human beings."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "human population"@en;
               rdfs:subClassOf sio:SIO_001061.
sio:SIO_001063 <http://purl.org/dc/elements/1.1/identifier> "SIO_001063";
               <http://purl.org/dc/terms/description> "A group of people affiliated by consanguinity, affinity, or co-residence."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "family"@en;
               rdfs:subClassOf sio:SIO_000620.
sio:SIO_001064 <http://purl.org/dc/elements/1.1/identifier> "SIO_001064";
               <http://purl.org/dc/terms/description> "A community is a sizeable social unit that shares common values."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "community"@en;
               rdfs:subClassOf sio:SIO_000620.
sio:SIO_001065 <http://purl.org/dc/elements/1.1/identifier> "SIO_001065";
