               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "biological reproduction"@en;
               rdfs:subClassOf sio:SIO_000919.
sio:SIO_000588 dc11:identifier "SIO_000588";
               dcterms:description "creating is the process in which an entity comes into existence."@en;
