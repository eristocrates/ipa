               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "month"@en;
               rdfs:subClassOf sio:SIO_000417.
sio:SIO_000430 <http://purl.org/dc/elements/1.1/identifier> "SIO_000430";
               <http://purl.org/dc/terms/description> "A day is a period of 24 hours."@en;
