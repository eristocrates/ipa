                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000090.
sio:SIO_000316 <http://purl.org/dc/elements/1.1/identifier> "SIO_000316";
               <http://purl.org/dc/terms/description> "A design specification is a specification that provides precise and explicit information about the requirements for a product design."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "design specification"@en;
