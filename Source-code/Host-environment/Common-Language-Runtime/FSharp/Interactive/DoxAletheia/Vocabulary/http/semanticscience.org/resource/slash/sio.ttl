sio:SIO_000404 <http://purl.org/dc/elements/1.1/identifier> "SIO_000404";
               <http://purl.org/dc/terms/description> "A professor is an individual that is a scholarly teacher."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "professor"@en;
               rdfs:subClassOf sio:SIO_000406.
sio:SIO_000405 <http://purl.org/dc/elements/1.1/identifier> "SIO_000405";
               <http://purl.org/dc/terms/description> "A student is an individual who is attends an educational institution."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "student"@en;
               rdfs:subClassOf sio:SIO_000406.
sio:SIO_000406 <http://purl.org/dc/elements/1.1/identifier> "SIO_000406";
               <http://purl.org/dc/terms/description> "An academic is an individual that participates in education and scholarship."@en;
