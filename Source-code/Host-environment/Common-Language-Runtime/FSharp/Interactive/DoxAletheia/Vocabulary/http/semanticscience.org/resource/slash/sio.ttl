sio:SIO_000310 <http://purl.org/dc/elements/1.1/identifier> "SIO_000310";
               <http://purl.org/dc/terms/description> "is direct part of is a relation between a specific part (at some level of granularity) and its whole."@en;
               sio:subset "core";
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is direct part of"@en;
