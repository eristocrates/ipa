sio:SIO_000410 <http://purl.org/dc/elements/1.1/identifier> "SIO_000410";
               <http://purl.org/dc/terms/description> "anger is disgust directed toward an equal status individual."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "anger"@en;
               rdfs:subClassOf sio:SIO_000828.
sio:SIO_000411 <http://purl.org/dc/elements/1.1/identifier> "SIO_000411";
               <http://purl.org/dc/terms/description> "Hate is a deep and emotional extreme dislike, directed against a certain object or class of objects. "@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "hate"@en;
               rdfs:subClassOf sio:SIO_000828.
sio:SIO_000412 <http://purl.org/dc/elements/1.1/identifier> "SIO_000412";
               <http://purl.org/dc/terms/description> "love is an emotion of a strong affection and personal attachment."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "love"@en;
               rdfs:subClassOf sio:SIO_000831.
sio:SIO_000413 <http://purl.org/dc/elements/1.1/identifier> "SIO_000413";
               <http://purl.org/dc/terms/description> "A geolegal region is a geographic region which has causal powers confered by a legal entity."@en;
               sio:example "The 50 kph zones in Ottawa; the geographic region occupied by France."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "geolegal region"@en;
               rdfs:subClassOf sio:SIO_000414.
sio:SIO_000414 <http://purl.org/dc/elements/1.1/identifier> "SIO_000414";
               <http://purl.org/dc/terms/description> "A geographic region is a spatial region whose boundaries are typically defined against some material frame of reference (like the earth)."@en;
               sio:example "The spatial region occupied by the province of ontario; the spatial region occupied by a lake."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "geographic region"@en;
               rdfs:subClassOf sio:SIO_000370.
sio:SIO_000415 <http://purl.org/dc/elements/1.1/identifier> "SIO_000415";
               <http://purl.org/dc/terms/description> "a geopolitical region is a geographic region recognized by social or legal convention."@en;
               sio:example "The geographic region bounded by Canada; the spatial region occupied by the US embassy in Ottawa."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "geopolitical region"@en;
               rdfs:subClassOf sio:SIO_000413.
sio:SIO_000417 <http://purl.org/dc/elements/1.1/identifier> "SIO_000417";
               <http://purl.org/dc/terms/description> "A time internval is a contiguous temporal region having some duration."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "time interval"@en;
               rdfs:subClassOf sio:SIO_000391.
sio:SIO_000418 <http://purl.org/dc/elements/1.1/identifier> "SIO_000418";
               <http://purl.org/dc/terms/description> "A time instant is a temporal region which occurs instantaneously, e.g. having no duration."@en;
               sio:example "at this moment; the moment at which a finger is detached in an industrial accident; the moment at which a child is born; the moment of death"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "time instant"@en;
               rdfs:subClassOf sio:SIO_000391.
sio:SIO_000419 <http://purl.org/dc/elements/1.1/identifier> "SIO_000419";
               <http://purl.org/dc/terms/description> "A table is a figure that consists of an ordered arrangement of columns and rows."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "table"@en;
               rdfs:subClassOf sio:SIO_000080.
sio:SIO_000420 <http://purl.org/dc/elements/1.1/identifier> "SIO_000420";
               sio:example "the story 'war of worlds' is expressed as every language edition of the book 'war of the worlds'"@en;
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has expression"@en;
               rdfs:subPropertyOf sio:SIO_000425;
               <http://www.w3.org/2002/07/owl#inverseOf> sio:SIO_000421.
sio:SIO_000421 <http://purl.org/dc/elements/1.1/identifier> "SIO_000421";
               <http://purl.org/dc/terms/description> "is expression of is a relation between more concrete expression of some conceptualization."@en;
               sio:example "every language edition of 'war of the worlds' are expressions of the story of 'war of the worlds'"@en;
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is expression of"@en;
               rdfs:subPropertyOf sio:SIO_000425.
sio:SIO_000422 <http://purl.org/dc/elements/1.1/identifier> "SIO_000422";
               <http://purl.org/dc/terms/description> "A is broader than B (t) iff for A is broader than B."@en;
               sio:equivalentTo "http://www.w3.org/2004/02/skos/core#narrowerTransitive";
               a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 <http://www.w3.org/2002/07/owl#TransitiveProperty>;
               rdfs:domain sio:SIO_000275;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is broader than (t)"@en;
               rdfs:range sio:SIO_000275;
               rdfs:subPropertyOf sio:SIO_000283;
               <http://www.w3.org/2002/07/owl#inverseOf> sio:SIO_000424.
sio:SIO_000423 <http://purl.org/dc/elements/1.1/identifier> "SIO_000423";
               <http://purl.org/dc/terms/description> "A scatterplot is a statistical graph which uses Cartesian coordinates to display values for two variables for a set of data. The data is displayed as a collection of points, each having the value of one variable determining the position on the horizontal axis and the value of the other variable determining the position on the vertical axis."@en;
               sio:hasSynonym "scatter graph"@en,
                              "scatter diagram"@en,
                              "scatter chart"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "scatterplot"@en;
               rdfs:subClassOf sio:SIO_000083.
sio:SIO_000424 <http://purl.org/dc/elements/1.1/identifier> "SIO_000424";
               <http://purl.org/dc/terms/description> "A is narrower than B (t) iff for A is narrower than B."@en;
               sio:equivalentTo "http://www.w3.org/2004/02/skos/core#broaderTransitive";
               a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 <http://www.w3.org/2002/07/owl#TransitiveProperty>;
               rdfs:domain sio:SIO_000275;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is narrower than (t)"@en;
