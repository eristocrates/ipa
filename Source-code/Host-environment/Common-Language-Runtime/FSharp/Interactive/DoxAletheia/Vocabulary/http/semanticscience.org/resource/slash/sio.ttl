                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_010785.
sio:SIO_010787 <http://purl.org/dc/elements/1.1/identifier> "SIO_010787";
               <http://purl.org/dc/terms/description> "diamond is a carbon allotrope in which each carbon atom in diamond is covalently bonded to four other carbons in a tetrahedron. These tetrahedrons together form a 3-dimensional network of puckered six-membered rings of atoms."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "diamond"@en;
               rdfs:subClassOf sio:SIO_010786.
sio:SIO_010788 <http://purl.org/dc/elements/1.1/identifier> "SIO_010788";
               <http://purl.org/dc/terms/description> "graphite is an allotrope of carbon which is a conductor, and is the most stable form of solid carbon."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "graphite"@en;
               rdfs:subClassOf sio:SIO_010786.
sio:SIO_010789 <http://purl.org/dc/elements/1.1/identifier> "SIO_010789";
               <http://purl.org/dc/terms/description> "fullerene is a carbon allotrope which take the form of a hollow sphere, ellipsoid, or tube."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "fullerene"@en;
               rdfs:subClassOf sio:SIO_010786.
sio:SIO_010790 <http://purl.org/dc/elements/1.1/identifier> "SIO_010790";
               <http://purl.org/dc/terms/description> "aggregate of carbon nanorods is an allotrope of carbon considered to be the least compressible material known, as measured by its isothermal bulk modulus; aggregated diamond nanorods have a modulus of 491 gigapascals (GPa), while a conventional diamond has a modulus of 442 GPa. ADNRs are also 0.3% denser than regular diamond."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "aggregated carbon nanorods"@en;
               rdfs:subClassOf sio:SIO_010786.
sio:SIO_010791 <http://purl.org/dc/elements/1.1/identifier> "SIO_010791";
               <http://purl.org/dc/terms/description> "amorphous carbon is an allotrope of carbon that does not have any crystalline structure. As with all glassy materials, some short-range order can be observed, but there is no long-range pattern of atomic positions."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "amorphous carbon"@en;
               rdfs:subClassOf sio:SIO_010786.
sio:SIO_010792 <http://purl.org/dc/elements/1.1/identifier> "SIO_010792";
               <http://purl.org/dc/terms/description> "carbon nanofoam is an allotrope of carbon that consists of a low-density cluster-assembly of carbon atoms strung together in a loose three-dimensional web. Each cluster is about 6 nanometers wide and consists of about 4000 carbon atoms linked in graphite-like sheets that are given negative curvature by the inclusion of heptagons among the regular hexagonal pattern."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "carbon nanofoam"@en;
               rdfs:subClassOf sio:SIO_010786.
sio:SIO_010793 <http://purl.org/dc/elements/1.1/identifier> "SIO_010793";
               <http://purl.org/dc/terms/description> "chaoite is an allotrope of carbon that is slightly harder than graphite with a reflection colour of grey to white."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "chaoite"@en;
               rdfs:subClassOf sio:SIO_010786.
sio:SIO_010794 <http://purl.org/dc/elements/1.1/identifier> "SIO_010794";
               <http://purl.org/dc/terms/description> "glassy carbon is an allotrope of carbon which is widely used as an electrode material in electrochemistry, as well as for high temperature crucibles and as a component of some prosthetic devices."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "glassy carbon"@en;
               rdfs:subClassOf sio:SIO_010786.
sio:SIO_010795 <http://purl.org/dc/elements/1.1/identifier> "SIO_010795";
               <http://purl.org/dc/terms/description> "ionsdaleite is a hexagonal allotrope of the carbon allotrope diamond."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ionsdaleite"@en;
               rdfs:subClassOf sio:SIO_010786.
