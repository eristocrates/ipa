                                a owl:Restriction],
                               sio:SIO_000289.
sio:SIO_000618 dc11:identifier "SIO_000618";
               dcterms:description "A standard is a socially-agreed upon specification."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
