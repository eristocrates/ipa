sio:SIO_000044 <http://purl.org/dc/elements/1.1/identifier> "SIO_000044";
               <http://purl.org/dc/terms/description> "A quantity that extends in two dimensions."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
