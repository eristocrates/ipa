                               sio:SIO_001235.
sio:SIO_001232 <http://purl.org/dc/elements/1.1/identifier> "SIO_001232";
               <http://purl.org/dc/terms/description> "A transfer RNA (tRNA) is an RNA molecule that aids in the translation of a messenger RNA (mRNA) to produce a protein product."@en;
               sio:hasSynonym "tRNA"@en;
