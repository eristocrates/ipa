                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000506.
sio:SIO_000504 <http://purl.org/dc/elements/1.1/identifier> "SIO_000504";
               <http://purl.org/dc/terms/description> "A polyhedral surface is composed of polygonal faces."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
