               rdfs:label "gene-disease association"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb439" ; 
                                owl:someValuesFrom sio:SIO_010299 ; 
                                owl:onProperty sio:SIO_000628 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb438" ; 
                                owl:someValuesFrom sio:SIO_010035 ; 
                                owl:onProperty sio:SIO_000628 ; 
                                a owl:Restriction],
                               sio:SIO_000897.
sio:SIO_000984 dc11:identifier "SIO_000984";
               dcterms:description "A genome is a collection of nucleic acids."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "genome"@en;
               rdfs:subClassOf sio:SIO_010046.
sio:SIO_000985 dc11:identifier "SIO_000985";
               dcterms:description "A gene that contains an open reading frame which codes for a protein."@en;
               sio:equivalentTo "http://purl.obolibrary.org/obo/SO_0001217"^^xsd:anyURI;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "protein coding gene"@en;
               rdfs:subClassOf sio:SIO_010035.
sio:SIO_000986 dc11:identifier "SIO_000986";
               dcterms:description "A gene that codes for a functional RNA molecule."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "functional rna coding gene"@en;
               rdfs:subClassOf sio:SIO_010035.
sio:SIO_000987 dc11:identifier "SIO_000987";
               dcterms:description "A predicted gene is a gene that was identified through computational method but has not been experimentally validated."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "predicted gene"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb440" ; 
                                owl:someValuesFrom sio:SIO_000036 ; 
                                owl:onProperty sio:SIO_000008 ; 
                                a owl:Restriction],
                               sio:SIO_010035.
sio:SIO_000988 dc11:identifier "SIO_000988";
               dcterms:description "A pseudo gene is a region of a nucleic acid that either cannot be transcribed, or its RNA transcript cannot be translated."@en;
               sio:equivalentTo "http://purl.obolibrary.org/obo/SO_0000336"^^xsd:anyURI;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "pseudogene"@en;
               rdfs:subClassOf sio:SIO_010335.
sio:SIO_000989 dc11:identifier "SIO_000989";
               dcterms:description "A sequence assembly is a sequence that is produced as by the alignment of two or more sequences."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "sequence assembly"@en;
               rdfs:subClassOf sio:SIO_000030.
sio:SIO_000991 dc11:identifier "SIO_000991";
               dcterms:description "An experimentally validated gene is a gene whose existence has been demonstrated through experimental methods."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "validated gene"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb441" ; 
                                owl:someValuesFrom sio:SIO_000960 ; 
                                owl:onProperty sio:SIO_000008 ; 
                                a owl:Restriction],
                               sio:SIO_010035.
sio:SIO_000992 dc11:identifier "SIO_000992";
               dcterms:description "unsupported is an existence quality in which there is no evidence to support the existence of the entity in any world (real or hypothetical)"@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "unsupported"@en;
               rdfs:subClassOf sio:SIO_000959.
sio:SIO_000993 dc11:identifier "SIO_000993";
               dcterms:description "A chemical-disease association is an association between a chemical and a disease."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "chemical-disease association"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb442" ; 
                                owl:intersectionOf ([dc11:identifier ":arc758fb443" ; 
                                                    owl:someValuesFrom sio:SIO_010004 ; 
                                                    owl:onProperty sio:SIO_000628 ; 
                                                    a owl:Restriction]
                                                    [dc11:identifier ":arc758fb445" ; 
                                                    owl:someValuesFrom sio:SIO_010299 ; 
                                                    owl:onProperty sio:SIO_000628 ; 
                                                    a owl:Restriction]) ; 
                                a owl:Class],
                               sio:SIO_000897.
sio:SIO_000994 dc11:identifier "SIO_000994";
               dcterms:description "An experiment is an investigation that has the goal of verifying, falsifying, or establishing the validity of a hypothesis. "@en;
               sio:hasSynonym "study";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "experiment"@en;
               rdfs:subClassOf sio:SIO_000747.
sio:SIO_000995 dc11:identifier "SIO_000995";
               dcterms:description "suspended is the status of a process that is no longer progressing towards completion."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "suspended"@en;
               rdfs:subClassOf sio:SIO_000033.
sio:SIO_000996 dc11:identifier "SIO_000996";
               dcterms:description "cancelled is a process status in which the process, while planned to occur, will not occur."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "cancelled"@en;
               rdfs:subClassOf sio:SIO_000963.
sio:SIO_000997 dc11:identifier "SIO_000997";
               dcterms:description "aborted is a process status in which a started process will not complete as intended."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "aborted"@en;
               rdfs:subClassOf sio:SIO_000033.
sio:SIO_000998 dc11:identifier "SIO_000998";
               dcterms:description "literature curation is the process of an agent selecting and extracting terms and phrases from a document."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "literature curation"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb448" ; 
                                owl:someValuesFrom sio:SIO_000148 ; 
                                owl:onProperty sio:SIO_000230 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb447" ; 
                                owl:someValuesFrom sio:SIO_000483 ; 
                                owl:onProperty sio:SIO_000229 ; 
                                a owl:Restriction],
                               sio:SIO_000649.
sio:SIO_000999 dc11:identifier "SIO_000999";
               dcterms:description "A procedure is a process that attempts to achieve one or more objectives by following an established set of actions."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "procedure"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb450" ; 
                                owl:allValuesFrom [dc11:identifier ":arc758fb451" ; 
                                                   owl:unionOf (sio:SIO_000112
                                                                sio:SIO_000337) ; 
                                                   a owl:Class] ; 
                                owl:onProperty sio:SIO_000355 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb449" ; 
                                owl:someValuesFrom sio:SIO_000091 ; 
                                owl:onProperty sio:SIO_000426 ; 
                                a owl:Restriction],
                               sio:SIO_000006.
sio:SIO_001000 dc11:identifier "SIO_001000";
               dcterms:description "A clinical trial is an intervention trial to determine the safety and efficacy of  medical interventions (e.g., drugs, diagnostics, devices, therapy protocols). "@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "clinical trial"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb454" ; 
                                owl:someValuesFrom sio:SIO_001043 ; 
                                owl:onProperty sio:SIO_000339 ; 
                                a owl:Restriction],
                               sio:SIO_001048.
sio:SIO_001001 dc11:identifier "SIO_001001";
               dcterms:description "A medical diagnosis (often simply termed diagnosis) refers to the process of attempting to determine or identify a possible disease or disorder."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "medical diagnosis"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb456" ; 
                                owl:someValuesFrom [dc11:identifier ":arc758fb457" ; 
                                                    owl:intersectionOf (sio:SIO_010046
                                                                        [dc11:identifier ":arc758fb459" ; 
                                                                        owl:someValuesFrom sio:SIO_000758 ; 
                                                                        owl:onProperty sio:SIO_000217 ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class] ; 
                                owl:onProperty sio:SIO_000230 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb455" ; 
                                owl:someValuesFrom sio:SIO_001003 ; 
                                owl:onProperty sio:SIO_000229 ; 
                                a owl:Restriction],
                               sio:SIO_001024.
sio:SIO_001002 dc11:identifier "SIO_001002";
               dcterms:description "A differential diagnosis (sometimes abbreviated DDx, ddx, DD, D/Dx, or ΔΔ) is a systematic diagnostic method used to identify the presence of an entity where multiple alternatives are possible (and the process may be termed differential diagnostic procedure), and may also refer to any of the included candidate alternatives (which may also be termed candidate condition)."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "differential diagnosis"@en;
               rdfs:subClassOf sio:SIO_001024.
sio:SIO_001003 dc11:identifier "SIO_001003";
               dcterms:description "A diagnostic opinion is an opinion resulting from a medical diagnostic procedure."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "diagnostic opinion"@en;
               rdfs:subClassOf sio:SIO_001004.
sio:SIO_001004 dc11:identifier "SIO_001004";
               dcterms:description "An opinion is a belief that is the result of emotion or interpretation of facts. "@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "opinion"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb461" ; 
                                owl:someValuesFrom sio:SIO_001001 ; 
                                owl:onProperty sio:SIO_000311 ; 
                                a owl:Restriction],
                               sio:SIO_000360.
sio:SIO_001005 dc11:identifier "SIO_001005";
               dcterms:description "A drug effect is a chemical interaction in which a chemical elicits a marked characteristic of a biological system."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "drug effect"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb462" ; 
                                owl:someValuesFrom sio:SIO_010038 ; 
                                owl:onProperty sio:SIO_000139 ; 
                                a owl:Restriction],
                               sio:SIO_010013.
sio:SIO_001006 dc11:identifier "SIO_001006";
               dcterms:description "A drug-drug interaction is an interaction in which two drugs interact in such a way to produce a non-additive biological response."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "drug drug interaction"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb463" ; 
                                owl:onClass sio:SIO_010038 ; 
                                owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; 
                                owl:onProperty sio:SIO_000132 ; 
                                a owl:Restriction],
                               sio:SIO_001005.
sio:SIO_001007 dc11:identifier "SIO_001007";
               dcterms:description "An assay is an investigative (analytic) procedure in laboratory medicine, pharmacology, environmental biology, and molecular biology for qualitatively assessing or quantitatively measuring the presence or amount or the functional activity of a target entity (the analyte) which can be a drug or biochemical substance or a cell in an organism or organic sample."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "assay"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb472" ; 
                                owl:someValuesFrom sio:SIO_000776 ; 
                                owl:onProperty sio:SIO_000230 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb464" ; 
                                owl:someValuesFrom [dc11:identifier ":arc758fb465" ; 
                                                    owl:intersectionOf ([dc11:identifier ":arc758fb466" ; 
                                                                        owl:unionOf (sio:SIO_000070
                                                                                     sio:SIO_000959) ; 
                                                                        a owl:Class]
                                                                        [dc11:identifier ":arc758fb470" ; 
                                                                        owl:someValuesFrom sio:SIO_000000 ; 
                                                                        owl:onProperty sio:SIO_000011 ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class] ; 
                                owl:onProperty sio:SIO_000229 ; 
                                a owl:Restriction],
                               sio:SIO_000999.
sio:SIO_001008 dc11:identifier "SIO_001008";
               dcterms:description "toxicity is the quality of a chemical substance to cause injury to an organism in a dose dependent manner."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "toxicity"@en;
               rdfs:subClassOf sio:SIO_001011;
               owl:equivalentClass [dc11:identifier ":arc758fb473" ; 
                                    owl:unionOf (sio:SIO_001009
                                                 sio:SIO_001010) ; 
                                    a owl:Class].
sio:SIO_001009 dc11:identifier "SIO_001009";
               dcterms:description "toxic is the quality of a substance imparing the normal functioning of a  system."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "toxic"@en;
               rdfs:subClassOf sio:SIO_001008;
               owl:disjointWith sio:SIO_001010.
sio:SIO_001010 dc11:identifier "SIO_001010";
               dcterms:description "non toxic is the quality of a substance having no damaging effect to a system."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "non toxic"@en;
               rdfs:subClassOf sio:SIO_001008.
sio:SIO_001011 dc11:identifier "SIO_001011";
               dcterms:description "chemical quality is the quality of a chemical entity."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "chemical quality"@en;
               rdfs:subClassOf sio:SIO_000026.
sio:SIO_001012 dc11:identifier "SIO_001012";
               dcterms:description "healthy is an organismal state of complete physical, mental and social well-being."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "healthy"@en;
               rdfs:subClassOf sio:SIO_010058.
sio:SIO_001013 dc11:identifier "SIO_001013";
               dcterms:description "age is the length of time that a person has lived or a thing has existed."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "age"@en;
               rdfs:subClassOf sio:SIO_000258.
sio:SIO_001014 dc11:identifier "SIO_001014";
               dcterms:description "ethnicity is the biological quality of membership in a social group based on a common heritage."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ethnicity"@en;
               rdfs:subClassOf sio:SIO_000475.
sio:SIO_001015 dc11:identifier "SIO_001015";
               dcterms:description "race is a characteristic of an individual by heritable phenotypic characteristics, geographic ancestry, physical appearance, ethnicity, and social status."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "race"@en;
               rdfs:subClassOf sio:SIO_000475.
sio:SIO_001016 dc11:identifier "SIO_001016";
               dcterms:description "An ethnic group is a group of people whose members identify with each other through a common heritage, consisting of a common culture, including a shared language or dialect. "@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ethnic group"@en;
               rdfs:subClassOf sio:SIO_001062.
sio:SIO_001017 dc11:identifier "SIO_001017";
               dcterms:description "A syndrome is composed of a set of several clinically recognizable features, signs (observed by someone other than the patient), symptoms (reported by the patient), phenomena or characteristics that often occur together."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "syndrome"@en;
               rdfs:subClassOf sio:SIO_000136.
sio:SIO_001018 dc11:identifier "SIO_001018";
               dcterms:description "A ratio is a relationship between two numbers of the same kind expressed arithmetically as a dimensionless quotient of the two which explicitly indicates how many times the first number contains the second."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ratio"@en;
               rdfs:subClassOf sio:SIO_000257.
sio:SIO_001019 dc11:identifier "SIO_001019";
               dcterms:description "A dose is the quantity of a chemical substance administered to a biological system."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "dose"@en;
               rdfs:subClassOf sio:SIO_000258.
sio:SIO_001020 dc11:identifier "SIO_001020";
               dcterms:description "effective dose is the amount of a substance required to produce an effect on a predefined percentage of a population."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "effective dose"@en;
               rdfs:subClassOf sio:SIO_001019.
sio:SIO_001021 dc11:identifier "SIO_001021";
               dcterms:description "An expected value (or e-value) is the weighted average of all possible values that a random variable can take on."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "expected value"@en;
               rdfs:subClassOf sio:SIO_000638.
sio:SIO_001022 dc11:identifier "SIO_001022";
               dcterms:description "A diagnostic test is a procedure performed to confirm, or determine the presence of disease in an individual suspected of having the disease, usually following the report of symptoms, or based on the results of other medical tests."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "diagnostic test"@en;
               rdfs:subClassOf sio:SIO_001024.
sio:SIO_001023 dc11:identifier "SIO_001023";
               dcterms:description "A medical screening is a medical test or series used to detect or predict the presence of disease in individuals at risk for disease within a defined group, such as a population, family, or workforce"@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "medical screening"@en;
               rdfs:subClassOf sio:SIO_001024.
sio:SIO_001024 dc11:identifier "SIO_001024";
               dcterms:description "A medical procedure is a procedure to identify, examine, alleviate or eliminate an undesirable biological disease or disorder."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "medical procedure"@en;
               rdfs:subClassOf sio:SIO_000999.
sio:SIO_001025 dc11:identifier "SIO_001025";
               dcterms:description "A prognosis is a proposition about the likely course of a disease, the chance of recovery or recurrence."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "prognosis"@en;
               rdfs:subClassOf sio:SIO_000256.
sio:SIO_001026 dc11:identifier "SIO_001026";
               dcterms:description "A report is a textual document made that present focused, salient content to a specific audience."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "report"@en;
               rdfs:subClassOf sio:SIO_000148.
sio:SIO_001027 dc11:identifier "SIO_001027";
               dcterms:description "A medical health record is a record of a single patient's medical history."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "medical health record"@en;
               rdfs:subClassOf sio:SIO_000088.
sio:SIO_001028 dc11:identifier "SIO_001028";
               dcterms:description "A medical report is a report prepared by a health care practioner about test outcomes or health status of an individual."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "medical report"@en;
               rdfs:subClassOf sio:SIO_001026.
sio:SIO_001029 dc11:identifier "SIO_001029";
               dcterms:description "A peer reviewed article is an article that has undergone peer-review and deemed acceptable for publication."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "peer reviewed article"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb476" ; 
                                owl:someValuesFrom sio:SIO_001035 ; 
                                owl:onProperty sio:SIO_000217 ; 
                                a owl:Restriction],
                               sio:SIO_000154.
sio:SIO_001030 dc11:identifier "SIO_001030";
               dcterms:description "A major version number is a version of a software that exhibits a significant change in functionalilty from a prior version."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "major version number"@en;
               rdfs:subClassOf sio:SIO_000654.
sio:SIO_001031 dc11:identifier "SIO_001031";
               dcterms:description "A minor version number is a version of a software that exhibits minor features or significant fix from a prior version."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "minor version number"@en;
               rdfs:subClassOf sio:SIO_000654.
sio:SIO_001032 dc11:identifier "SIO_001032";
               dcterms:description "A revision number is a version of a software in which bugs have been fixed from a prior version."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "revision number"@en;
               rdfs:subClassOf sio:SIO_000654.
sio:SIO_001033 dc11:identifier "SIO_001033";
               dcterms:description "text quality is the quality of a textual entity."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "text quality"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb477" ; 
                                owl:someValuesFrom sio:SIO_000651 ; 
                                owl:onProperty sio:SIO_000218 ; 
                                a owl:Restriction],
                               sio:SIO_000026.
sio:SIO_001034 dc11:identifier "SIO_001034";
               dcterms:description "reviewed is the quality of a textual entity that has been examined and commented on by another party."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
