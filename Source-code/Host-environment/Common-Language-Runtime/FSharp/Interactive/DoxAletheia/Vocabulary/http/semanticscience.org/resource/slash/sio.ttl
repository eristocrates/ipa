               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "variant role"@en;
               rdfs:subClassOf sio:SIO_000721.
sio:SIO_000480 <http://purl.org/dc/elements/1.1/identifier> "SIO_000480";
               <http://purl.org/dc/terms/description> "An insertion variant role is the role of an sequence that contains a sub-sequence that is considered to be an addition relative to the frame of reference."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "insertion variant role"@en;
               rdfs:subClassOf sio:SIO_000478.
sio:SIO_000481 <http://purl.org/dc/elements/1.1/identifier> "SIO_000481";
               <http://purl.org/dc/terms/description> "A deletion variant role is the role of an sequence that lacks a sub-sequence relative to the frame of reference."@en;
