               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "small nuclear RNA (snRNA)"@en;
               rdfs:subClassOf sio:SIO_001235.
sio:SIO_001234 <http://purl.org/dc/elements/1.1/identifier> "SIO_001234";
               <http://purl.org/dc/terms/description> "A small nucleolar RNA (snoRNA) is a small RNA that are associated with the eukaryotic nucleus as components of small nucleolar ribonucleoproteins."@en;
               sio:hasSynonym "snoRNA"@en;
