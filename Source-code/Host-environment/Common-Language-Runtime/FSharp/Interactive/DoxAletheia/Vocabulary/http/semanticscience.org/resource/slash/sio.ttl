               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "to contain"@en;
               rdfs:subClassOf sio:SIO_000392.
sio:SIO_000381 dc11:identifier "SIO_000381";
