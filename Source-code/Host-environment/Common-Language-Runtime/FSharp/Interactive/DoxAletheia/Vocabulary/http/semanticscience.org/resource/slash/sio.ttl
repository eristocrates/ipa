               <http://purl.org/dc/terms/description> "has measurement value is a relation between a quality/realizable and a measurement value."@en;
               sio:subset "core";
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
