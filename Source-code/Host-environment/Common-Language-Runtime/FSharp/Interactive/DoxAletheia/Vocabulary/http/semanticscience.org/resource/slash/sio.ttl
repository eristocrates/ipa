               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "3D extent quantity"@en;
               rdfs:subClassOf sio:SIO_000037.
sio:SIO_000049 <http://purl.org/dc/elements/1.1/identifier> "SIO_000049";
               <http://purl.org/dc/terms/description> "volume is the quantity of three-dimensional space enclosed by some closed boundary."@en;
