               <http://purl.org/dc/terms/description> "gesturing is a form of non-verbal communication in which visible bodily actions communicate particular messages, either in place of speech or together and in parallel with spoken words. Gestures include movement of the hands, face, or other parts of the body."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "gesturing"@en;
               rdfs:subClassOf sio:SIO_000969.
sio:SIO_001060 <http://purl.org/dc/elements/1.1/identifier> "SIO_001060";
               <http://purl.org/dc/terms/description> "planned is a process status for a process that has not yet started, but is referred to in a plan."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "planned"@en;
               rdfs:subClassOf sio:SIO_000963.
sio:SIO_001061 <http://purl.org/dc/elements/1.1/identifier> "SIO_001061";
               <http://purl.org/dc/terms/description> "A population is all the organisms that both belong to the same group or species and live in the same geographical area."@en;
