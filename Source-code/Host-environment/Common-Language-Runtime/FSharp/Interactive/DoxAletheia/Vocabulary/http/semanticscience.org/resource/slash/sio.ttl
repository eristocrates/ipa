                                              dc11:creator "Michel Dumontier"@en;
                                              dc11:identifier "sio.owl";
                                              dcterms:creator "http://orcid.org/0000-0003-4727-9435"^^xsd:anyURI;
                                              dcterms:description """The semanticscience integrated ontology (SIO) provides a simple, integrated ontology (types, relations) for objects, processes and their attributes.

This project provides foundational support for the Bio2RDF (http://bio2rdf.org) and SADI (http://sadiframework.org) projects. 

website: http://semanticscience.org
email: sio-ontology@googlegroups.com
mailing list: http://groups.google.com/group/sio-ontology
"""@en;
                                              dcterms:issued "2010-03-29"^^xsd:date;
                                              dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
                                              dcterms:modified "2016-09-27"^^xsd:date;
                                              dcterms:rights "free to use,share,modify. modify with attribution [http://creativecommons.org/licenses/by/4.0/].";
                                              dcterms:title "Semanticscience Integrated Ontology (SIO)"@en;
                                              cito:citesAsAuthority "http://www.jbiomedsem.com/content/5/1/14"^^xsd:anyURI;
                                              vann:preferredNamespacePrefix "sio"@en;
                                              vann:preferredNamespaceUri "http://semanticscience.org/resource/";
                                              schema:comment """general class inclusion axioms:
'is part of' some 'physical entity' subClassOf 'is located in' some 'physical entity'

role chains:
'has capability' o 'is realized in' -> 'is participant in'""";
                                              a owl:Ontology;
                                              rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
                                              rdfs:seeAlso "http://sio.semanticscience.org"^^xsd:anyURI;
                                              owl:versionIRI <http://semanticscience.org/ontology/sio/v1.34.0/sio-release.owl>;
                                              owl:versionInfo "1.34.0".
sio:SIO_000000 dc11:identifier "SIO_000000";
               dcterms:description "Every thing is an entity."@en;
               sio:subset "core";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "entity"@en.
sio:SIO_000001 dc11:identifier "SIO_000001";
               dcterms:description "A is related to B iff there is some relation between A and B."@en;
               schema:comment "'is related to' is the top level relation in SIO";
               sio:subset "relations+",
                          "core";
               a owl:SymmetricProperty,
                 owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is related to"@en.
sio:SIO_000004 dc11:identifier "SIO_000004";
               dcterms:description "A material entity is a physical entity that is spatially extended, exists as a whole at any point in time and has mass."@en;
               sio:subset "core";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "material entity"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb12" ; 
                                owl:allValuesFrom [dc11:identifier ":arc758fb13" ; 
                                                   owl:unionOf (sio:SIO_000004
                                                                sio:SIO_000370) ; 
                                                   a owl:Class] ; 
                                owl:onProperty sio:SIO_000053 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb11" ; 
                                owl:someValuesFrom sio:SIO_000279 ; 
                                owl:onProperty sio:SIO_000008 ; 
                                a owl:Restriction],
                               sio:SIO_000776.
sio:SIO_000005 dc11:identifier "SIO_000005";
               dcterms:description "A quality is an attribute that is intrinsically associated with its bearer (or its parts), but whose presence/absence and observed/measured value may vary."@en;
               sio:subset "core";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "quality"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb16" ; 
                                owl:someValuesFrom sio:SIO_000000 ; 
                                owl:onProperty sio:SIO_000218 ; 
                                a owl:Restriction],
                               sio:SIO_000614;
               owl:disjointWith sio:SIO_000340.
sio:SIO_000006 dc11:identifier "SIO_000006";
               dcterms:description "A process is an entity that is identifiable only through the unfolding of time, has temporal parts, and unless otherwise specified/predicted, cannot be identified from any instant of time in which it exists."@en;
               sio:subset "core",
                          "process+";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "process"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb17" ; 
                                owl:allValuesFrom sio:SIO_000006 ; 
                                owl:onProperty sio:SIO_000053 ; 
                                a owl:Restriction],
                               sio:SIO_000000,
                               [dc11:identifier ":arc758fb18" ; 
                                owl:allValuesFrom sio:SIO_000417 ; 
                                owl:onProperty sio:SIO_000687 ; 
                                a owl:Restriction].
sio:SIO_000008 dc11:identifier "SIO_000008";
               dcterms:description "has attribute is a relation that associates a entity with an attribute where an attribute is an intrinsic characteristic such as a quality, capability, disposition, function, or is an externally derived attribute determined from some descriptor (e.g. a quantity, position, label/identifier) either directly or indirectly through generalization of entities of the same type."@en;
               sio:subset "core";
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has attribute"@en;
               rdfs:subPropertyOf sio:SIO_000001;
               owl:inverseOf sio:SIO_000011.
sio:SIO_000009 dc11:identifier "SIO_000009";
               dcterms:description "A social entity pertains to the interaction among individuals and groups."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "social entity"@en;
               rdfs:subClassOf sio:SIO_000015.
sio:SIO_000010 dc11:identifier "SIO_000010";
               dcterms:description "A social structure is a social entity which consists of relationships between two or more entities."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "social structure"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb19" ; 
                                owl:allValuesFrom sio:SIO_000776 ; 
                                owl:onProperty sio:SIO_000059 ; 
                                a owl:Restriction],
                               sio:SIO_000009.
sio:SIO_000011 dc11:identifier "SIO_000011";
               dcterms:description "is attribute of is a relation that associates an attribute with an entity where an attribute is an intrinsic characteristic such as a quality, capability, disposition, function, or is an externally derived attribute determined from some descriptor (e.g. a quantity, position, label/identifier) either directly or indirectly through generalization of entities of the same type."@en;
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is attribute of"@en;
               rdfs:subPropertyOf sio:SIO_000001.
sio:SIO_000012 dc11:identifier "SIO_000012";
               dcterms:description "An organization is a collective with a complex articulation of tasks, roles and responsibilities."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "organization"@en;
               rdfs:subClassOf sio:SIO_000620.
sio:SIO_000013 dc11:identifier "SIO_000013";
               dcterms:description "A geographic position is the coordinate of an entity against some geographic coordinate system."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "geographic position"@en;
               rdfs:subClassOf sio:SIO_000056.
sio:SIO_000014 dc11:identifier "SIO_000014";
               dcterms:description "A disposition is the tendency of a capability to be exhibited under certain conditions or in response to a certain stimulus (trigger)."@en;
               sio:example "solubility (to dissolve when put in fluid); fragility (disposition to break when dropped)"@en;
               sio:subset "core";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "disposition"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb20" ; 
                                owl:someValuesFrom sio:SIO_000638 ; 
                                owl:onProperty sio:SIO_000008 ; 
                                a owl:Restriction],
                               sio:SIO_000112.
sio:SIO_000015 dc11:identifier "SIO_000015";
               dcterms:description "information content entity is an object that requires some background knowledge or procedure to correctly interpret."@en;
               sio:subset "ice+",
                          "core";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "information content entity"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb21" ; 
                                owl:allValuesFrom sio:SIO_000015 ; 
                                owl:onProperty sio:SIO_000053 ; 
                                a owl:Restriction],
                               sio:SIO_000776.
sio:SIO_000016 dc11:identifier "SIO_000016";
               dcterms:description "A role is a realizable entity that describes behaviours, rights and obligations of an entity in some particular circumstance."@en;
               sio:subset "core";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "role"@en;
               rdfs:subClassOf sio:SIO_000340.
sio:SIO_000017 dc11:identifier "SIO_000017";
               dcterms:description "A function is a capability that satisfies some agentive objective, or (evolutionary) optimization."@en;
               sio:subset "core";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "function"@en;
               rdfs:subClassOf sio:SIO_000112;
               owl:disjointWith sio:SIO_000354.
sio:SIO_000019 dc11:identifier "SIO_000019";
               dcterms:description "A site is a spatial region bounded (in part or in whole) by material entities and may be occupied by material entities."@en;
               sio:example "A nostril; the interior of the heart valve; the interior of a bottle."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "site"@en;
               rdfs:subClassOf sio:SIO_000370.
sio:SIO_000020 dc11:identifier "SIO_000020";
               dcterms:description "denotes is a relation between an entity and what it is a sign or indication of, or what specifically means."@en;
               sio:example "the symbol '%' denotes a proportion in relation to a whole."@en;
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "denotes"@en;
               rdfs:subPropertyOf sio:SIO_000210;
               owl:inverseOf sio:SIO_000060.
sio:SIO_000022 dc11:identifier "SIO_000022";
               dcterms:description "A material boundary is the boundary of a material entity which exists as a lower dimensional entity at exactly the location where its parts no longer extend into space. Every material entity has a boundary, and a boundary is the boundary of exactly 1 material entity."@en;
               sio:example "the external surface of the window; the surface of the p52 protein"@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "material boundary"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb22" ; 
                                owl:someValuesFrom sio:SIO_000004 ; 
                                owl:onProperty sio:SIO_000096 ; 
                                a owl:Restriction],
                               sio:SIO_000783.
sio:SIO_000026 dc11:identifier "SIO_000026";
               dcterms:description "An object quality is quality of an object."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "object quality"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb23" ; 
                                owl:someValuesFrom sio:SIO_000776 ; 
                                owl:onProperty sio:SIO_000218 ; 
                                a owl:Restriction],
                               sio:SIO_000005.
sio:SIO_000027 dc11:identifier "SIO_000027";
               dcterms:description "A process quality is quality that is associated with a process."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "process quality"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb24" ; 
                                owl:someValuesFrom sio:SIO_000006 ; 
                                owl:onProperty sio:SIO_000218 ; 
                                a owl:Restriction],
                               sio:SIO_000005.
sio:SIO_000028 dc11:identifier "SIO_000028";
               dcterms:description "has part is a transitive, reflexive and antisymmetric relation between a whole and itself or a whole and its part."@en;
               sio:example "a collection of cars has as a car as a part;a car has an engine as a part; a car has a piston as a part;"@en;
               a owl:ObjectProperty,
                 owl:TransitiveProperty,
                 owl:ReflexiveProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has part"@en;
               rdfs:subPropertyOf sio:SIO_000145;
               owl:inverseOf sio:SIO_000068.
sio:SIO_000029 dc11:identifier "SIO_000029";
               a owl:ObjectProperty;
               rdfs:domain sio:SIO_000418;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is time boundary of"@en;
               rdfs:subPropertyOf sio:SIO_000096;
               owl:inverseOf sio:SIO_000679.
sio:SIO_000030 dc11:identifier "SIO_000030";
               dcterms:description "A sequence is a primary structure descriptor in which each of the letters in the string represents a monomeric unit (residue) in which adjacent letters represent the connectivity between the monomeric units."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "biopolymer sequence"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb31" ; 
                                owl:someValuesFrom xsd:string ; 
                                owl:onProperty sio:SIO_000300 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb30" ; 
                                owl:someValuesFrom sio:SIO_000092 ; 
                                owl:onProperty sio:SIO_000563 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb25" ; 
                                owl:someValuesFrom [dc11:identifier ":arc758fb26" ; 
                                                    owl:intersectionOf (sio:SIO_000626
                                                                        [dc11:identifier ":arc758fb28" ; 
                                                                        owl:someValuesFrom sio:SIO_000092 ; 
                                                                        owl:onProperty sio:SIO_000011 ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class] ; 
                                owl:onProperty sio:SIO_000210 ; 
                                a owl:Restriction],
                               sio:SIO_010014.
sio:SIO_000031 dc11:identifier "SIO_000031";
               dcterms:description "A start date is a time instant pertaining to the date of the beginning of a process."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "start date"@en;
               rdfs:subClassOf sio:SIO_000418.
sio:SIO_000032 dc11:identifier "SIO_000032";
               dcterms:description "An end date is a time instant pertaining to date of the end of a process."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "end date"@en;
               rdfs:subClassOf sio:SIO_000418.
sio:SIO_000033 dc11:identifier "SIO_000033";
               dcterms:description "process status is a process quality that describes the state of a process."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "process status"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb32" ; 
                                owl:someValuesFrom sio:SIO_000006 ; 
                                owl:onProperty sio:SIO_000011 ; 
                                a owl:Restriction],
                               sio:SIO_000027.
sio:SIO_000034 dc11:identifier "SIO_000034";
               dcterms:description "completed is that status of a process that successfully unfolds."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "completed"@en;
               rdfs:subClassOf sio:SIO_000033.
sio:SIO_000035 dc11:identifier "SIO_000035";
               dcterms:description "ongoing is the status of a process that is not yet complete."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ongoing"@en;
               rdfs:subClassOf sio:SIO_000033.
sio:SIO_000036 dc11:identifier "SIO_000036";
               dcterms:description "predicted is the quality of an entity that is thought to exist, as evidenced by some rational procedure."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "predicted"@en;
               rdfs:subClassOf sio:SIO_001186.
sio:SIO_000037 dc11:identifier "SIO_000037";
               dcterms:description "A spatial quantity is a quantity obtained from measuring the spatial extent of an entity "@en;
               sio:hasSynonym "physical dimensional quantity"@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "spatial quantity"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb34" ; 
                                owl:someValuesFrom sio:SIO_000052 ; 
                                owl:onProperty sio:SIO_000216 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb33" ; 
                                owl:someValuesFrom sio:SIO_000776 ; 
                                owl:onProperty sio:SIO_000011 ; 
                                a owl:Restriction],
                               sio:SIO_000258.
sio:SIO_000038 dc11:identifier "SIO_000038";
               dcterms:description "A quantity that extends in single dimension."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "1D extent quantity"@en;
               rdfs:subClassOf sio:SIO_000037.
sio:SIO_000039 dc11:identifier "SIO_000039";
               dcterms:description "depth is the dimensional extent into a plane of a 3D projection of the object."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "depth"@en;
               rdfs:subClassOf sio:SIO_000038.
sio:SIO_000040 dc11:identifier "SIO_000040";
               dcterms:description "height is the one dimensional extent along the vertical projection of a 3D object from a base plane of reference."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "height"@en;
               rdfs:subClassOf sio:SIO_000038.
sio:SIO_000041 dc11:identifier "SIO_000041";
               dcterms:description "length is the longer dimensional extent along a 2D projection of the object."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "length"@en;
               rdfs:subClassOf sio:SIO_000038.
sio:SIO_000042 dc11:identifier "SIO_000042";
               dcterms:description "width is the shorter dimensional extent perpendicular to a 2D projection of the object."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "width"@en;
               rdfs:subClassOf sio:SIO_000038.
sio:SIO_000043 dc11:identifier "SIO_000043";
               dcterms:description "thickness is the shortest dimensional extent of a 3D projection of an object."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "thickness"@en;
               rdfs:subClassOf sio:SIO_000039.
sio:SIO_000044 dc11:identifier "SIO_000044";
               dcterms:description "A quantity that extends in two dimensions."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "2D extent quantity"@en;
               rdfs:subClassOf sio:SIO_000037.
sio:SIO_000045 dc11:identifier "SIO_000045";
               dcterms:description "area is a quantity that pertains to the extent of a two-dimensional surface or shape, or planar lamina, in the plane."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "area"@en;
               rdfs:subClassOf sio:SIO_000044.
sio:SIO_000046 dc11:identifier "SIO_000046";
               dcterms:description "A perimeter is a length of the outline that surrounds a two-dimensional shape. "@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "length of perimeter"@en;
               rdfs:subClassOf sio:SIO_000044.
sio:SIO_000047 dc11:identifier "SIO_000047";
               dcterms:description "circumference is the length of the outline of a circle or ellipse. it is defined as c = 2*pi*r, where r is the radius."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "circumference"@en;
               rdfs:subClassOf sio:SIO_000046.
sio:SIO_000048 dc11:identifier "SIO_000048";
               dcterms:description "A quantity that extends in three dimensions."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "3D extent quantity"@en;
               rdfs:subClassOf sio:SIO_000037.
sio:SIO_000049 dc11:identifier "SIO_000049";
               dcterms:description "volume is the quantity of three-dimensional space enclosed by some closed boundary."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "volume"@en;
               rdfs:subClassOf sio:SIO_000048.
sio:SIO_000051 dc11:identifier "SIO_000051";
               dcterms:description "composition quality is a quality that describes its composition or anatomy."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "compositional quality"@en;
               rdfs:subClassOf sio:SIO_000026.
sio:SIO_000052 dc11:identifier "SIO_000052";
               dcterms:description "A quantity is an informational entity that gives the magnitude of a property."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "quantity"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb39" ; 
                                owl:someValuesFrom sio:SIO_000000 ; 
                                owl:onProperty sio:SIO_000215 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb38" ; 
                                owl:someValuesFrom sio:SIO_000000 ; 
                                owl:onProperty sio:SIO_000011 ; 
                                a owl:Restriction],
                               sio:SIO_000070;
               owl:equivalentClass [dc11:identifier ":arc758fb35" ; 
                                    owl:unionOf (sio:SIO_000257
                                                 sio:SIO_000258) ; 
                                    a owl:Class].
sio:SIO_000053 dc11:identifier "SIO_000053";
               dcterms:description "has proper part is an antisymmetric, irreflexive (normally transitive) relation between a whole and a distinct part."@en;
               sio:example "a car has an engine as a proper part; a car has a piston as a proper part;"@en;
               a owl:IrreflexiveProperty,
                 owl:AsymmetricProperty,
                 owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has proper part"@en;
               rdfs:subPropertyOf sio:SIO_000028;
               owl:inverseOf sio:SIO_000093.
sio:SIO_000054 dc11:identifier "SIO_000054";
               dcterms:description "has boundary is a mereological relation between a whole and boundary located at its periphery."@en;
               sio:example "the surface of an apple is a 2D boundary of the apple."@en;
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has boundary"@en;
               rdfs:subPropertyOf sio:SIO_000053;
               owl:inverseOf sio:SIO_000096.
sio:SIO_000055 dc11:identifier "SIO_000055";
               dcterms:description "shape is the quality of a bearer that relates to its spatial extent."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "shape"@en;
               rdfs:subClassOf sio:SIO_000026.
sio:SIO_000056 dc11:identifier "SIO_000056";
               dcterms:description "A measurement of a spatial location relative to a frame of reference or other objects."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "position"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb40" ; 
                                owl:someValuesFrom sio:SIO_000328 ; 
                                owl:onProperty sio:SIO_000008 ; 
                                a owl:Restriction],
                               sio:SIO_000070.
sio:SIO_000057 dc11:identifier "SIO_000057";
               dcterms:description "orientation is an angle between the bearer and an axis, or the angle between the bearer and another object."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "orientation"@en;
               rdfs:subClassOf sio:SIO_000056.
sio:SIO_000059 dc11:identifier "SIO_000059";
               dcterms:description "has member is a mereological relation between a collection and an item."@en;
               sio:example "a collection of cars has as a car as a member"@en;
               sio:subset "core";
               a owl:ObjectProperty,
                 owl:IrreflexiveProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has member"@en;
               rdfs:subPropertyOf sio:SIO_000008;
               owl:inverseOf sio:SIO_000095.
sio:SIO_000060 dc11:identifier "SIO_000060";
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is denoted by"@en;
               rdfs:subPropertyOf sio:SIO_000205.
sio:SIO_000061 dc11:identifier "SIO_000061";
               dcterms:description "A is located in B iff the spatial region occupied by A is part of the spatial region occupied by B. [T][R]"@en;
               sio:equivalentTo "OBO_REL:located_in";
               sio:example "A parasite in the interior of a person's intestine is located in their intestinal lumen."@en;
               sio:subset "core";
               a owl:TransitiveProperty,
                 owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is located in"@en;
               rdfs:subPropertyOf sio:SIO_000322;
               owl:inverseOf sio:SIO_000145.
sio:SIO_000062 dc11:identifier "SIO_000062";
               dcterms:description "is participant in is a relation that describes the participation of the subject in the (processual) object."@en;
               sio:example "a car is a participant in a car race; glucose is a participant in glycolysis"@en;
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is participant in"@en;
               rdfs:range sio:SIO_000006;
               rdfs:subPropertyOf sio:SIO_000322;
               owl:inverseOf sio:SIO_000132.
sio:SIO_000063 dc11:identifier "SIO_000063";
               dcterms:description "is agent in is a relation between an entity and a process, where the entity is present throughout the process, no permanent material change occurs, and is a causal participant in the process."@en;
               sio:example "hexokinase is an agent in the conversion of glucose to glucose-6-phosphate"@en;
               sio:subset "sadi"@en;
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is agent in"@en;
               rdfs:subPropertyOf sio:SIO_000062;
               owl:inverseOf sio:SIO_000139.
sio:SIO_000064 dc11:identifier "SIO_000064";
               dcterms:description "is provider of is a relation between a source and the entity it makes available."@en;
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is provider of"@en;
               rdfs:subPropertyOf sio:SIO_000219;
               owl:inverseOf sio:SIO_000066.
sio:SIO_000066 dc11:identifier "SIO_000066";
               dcterms:description "is provided by is a relation between an entity and the entity that provides it."@en;
               sio:equivalentTo "dc:source";
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has provider"@en;
               rdfs:subPropertyOf sio:SIO_000253.
sio:SIO_000067 dc11:identifier "SIO_000067";
               dcterms:description "A namespace is an informational entity that defines a logical container for a set of symbols or identifiers."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "namespace"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb41" ; 
                                owl:allValuesFrom sio:SIO_000115 ; 
                                owl:onProperty sio:SIO_000059 ; 
                                a owl:Restriction],
                               sio:SIO_000602.
sio:SIO_000068 dc11:identifier "SIO_000068";
               dcterms:description "is part of is a transitive, reflexive and anti-symmetric mereological relation between a whole and itself or a part and its whole."@en;
               sio:equivalentTo "OBO_REL:part_of";
               sio:subset "core";
               a owl:ReflexiveProperty,
                 owl:ObjectProperty,
                 owl:TransitiveProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is part of"@en;
               rdfs:subPropertyOf sio:SIO_000061.
sio:SIO_000069 dc11:identifier "SIO_000069";
               dcterms:description "A data item consists of information that has been collected/generated towards some purpose."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "data item"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb42" ; 
                                owl:someValuesFrom [dc11:identifier ":arc758fb43" ; 
                                                    owl:intersectionOf (sio:SIO_000006
                                                                        [dc11:identifier ":arc758fb45" ; 
                                                                        owl:someValuesFrom sio:SIO_000337 ; 
                                                                        owl:onProperty sio:SIO_000355 ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class] ; 
                                owl:onProperty sio:SIO_000062 ; 
                                a owl:Restriction],
                               sio:SIO_000602.
sio:SIO_000070 dc11:identifier "SIO_000070";
               dcterms:description "A measurement value is a quantitative description that reflects the magnitude of some attribute."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "measurement value"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb47" ; 
                                owl:unionOf ([dc11:identifier ":arc758fb48" ; 
                                             owl:someValuesFrom xsd:dateTime ; 
                                             owl:onProperty sio:SIO_000300 ; 
                                             a owl:Restriction]
                                             [dc11:identifier ":arc758fb50" ; 
                                             owl:someValuesFrom xsd:double ; 
                                             owl:onProperty sio:SIO_000300 ; 
                                             a owl:Restriction]
                                             [dc11:identifier ":arc758fb52" ; 
                                             owl:someValuesFrom xsd:float ; 
                                             owl:onProperty sio:SIO_000300 ; 
                                             a owl:Restriction]
                                             [dc11:identifier ":arc758fb54" ; 
                                             owl:someValuesFrom xsd:integer ; 
                                             owl:onProperty sio:SIO_000300 ; 
                                             a owl:Restriction]) ; 
                                a owl:Class],
                               sio:SIO_000366.
sio:SIO_000071 dc11:identifier "SIO_000071";
               dcterms:description "A coordinate is a measurement of position in n-dimensional space."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "coordinate"@en;
               rdfs:subClassOf sio:SIO_000056.
sio:SIO_000072 dc11:identifier "SIO_000072";
               dcterms:description "A Cartesian coordinate is the signed distance of a point to some referent line."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "cartesian coordinate"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb56" ; 
                                owl:someValuesFrom sio:SIO_000321 ; 
                                owl:onProperty sio:SIO_000093 ; 
                                a owl:Restriction],
                               sio:SIO_000071;
               owl:disjointWith sio:SIO_000073.
sio:SIO_000073 dc11:identifier "SIO_000073";
               dcterms:description "A polar coordinate is a position characterized by a distance from a fixed point and an angle from a fixed direction."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "polar coordinate"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb57" ; 
                                owl:someValuesFrom sio:SIO_000327 ; 
                                owl:onProperty sio:SIO_000093 ; 
                                a owl:Restriction],
                               sio:SIO_000071.
sio:SIO_000074 dc11:identifier "SIO_000074";
               dcterms:description "A unit of measurement is a definite magnitude of a physical quantity, defined and adopted by convention and/or by law, that is used as a standard for measurement of the same physical quantity."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "unit of measurement"@en;
               rdfs:subClassOf sio:SIO_000052.
sio:SIO_000075 dc11:identifier "SIO_000075";
               dcterms:description "A mathematical entity is an information content entity that are components of a mathematical system or can be defined in mathematical terms."@en;
               sio:subset "math+";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "mathematical entity"@en;
               rdfs:subClassOf sio:SIO_000015.
sio:SIO_000076 dc11:identifier "SIO_000076";
               dcterms:description "A plan is a set of intended actions, through which one expects to achieve a goal."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "plan"@en;
               rdfs:subClassOf sio:SIO_000091.
sio:SIO_000077 dc11:identifier "SIO_000077";
               dcterms:description "A generic name is the preferred name provided by manufacturer."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "generic name"@en;
               rdfs:subClassOf sio:SIO_000116.
sio:SIO_000078 dc11:identifier "SIO_000078";
               dcterms:description "A language entity implements some language specification for the visual interpretation and is part of some document."@en;
               sio:subset "nlp+";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "language entity"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb58" ; 
                                owl:someValuesFrom rdfs:Literal ; 
                                owl:onProperty sio:SIO_000300 ; 
                                a owl:Restriction],
                               sio:SIO_000015.
sio:SIO_000079 dc11:identifier "SIO_000079";
               dcterms:description "A visual language entity is a language entity that is manifested within the spectrum of light and can be pereceived and processed by a visual system."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "visual language entity"@en;
               rdfs:subClassOf sio:SIO_000078.
sio:SIO_000080 dc11:identifier "SIO_000080";
               dcterms:description "A figure is a graphical entity which consists of a visual (n-dimentional) arrangement of information entities."@en;
               sio:hasSynonym "diagram"@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "figure"@en;
               rdfs:subClassOf sio:SIO_001194;
               owl:disjointWith sio:SIO_000448.
sio:SIO_000081 dc11:identifier "SIO_000081";
               dcterms:description "An image is an affine projection of a visual entity to a two dimensional surface."@en;
               sio:hasSynonym "depiction"@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "image"@en;
               rdfs:subClassOf sio:SIO_000080.
sio:SIO_000082 dc11:identifier "SIO_000082";
               dcterms:description "A photograph is an image created by light falling on a light-sensitive surface."@en;
               sio:hasSynonym "photo"@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "photograph"@en;
               rdfs:subClassOf sio:SIO_000081.
sio:SIO_000083 dc11:identifier "SIO_000083";
               dcterms:description "A statistical graph is a figure that displays the relationship among numeric data and/or mathematical functions."@en;
               sio:hasSynonym "chart";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "statistical graph"@en;
               rdfs:subClassOf sio:SIO_000904.
sio:SIO_000085 dc11:identifier "SIO_000085";
               dcterms:description "A question is a linguistic expression used to make a request for information."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "question"@en;
               rdfs:subClassOf sio:SIO_000113.
sio:SIO_000087 dc11:identifier "SIO_000087";
               dcterms:description "A publication is a document that has been made available by a publisher."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "publication"@en;
               rdfs:subClassOf sio:SIO_000148.
sio:SIO_000088 dc11:identifier "SIO_000088";
               dcterms:description "A record is a document containing a collection of statements about some entity."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "record"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb59" ; 
                                owl:someValuesFrom sio:SIO_000115 ; 
                                owl:onProperty sio:SIO_000673 ; 
                                a owl:Restriction],
                               sio:SIO_000148.
sio:SIO_000089 dc11:identifier "SIO_000089";
               dcterms:description "A dataset is a data item that is a collection of data items."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "data set"@en;
               rdfs:subClassOf sio:SIO_000069;
               owl:equivalentClass [dc11:identifier ":arc758fb60" ; 
                                    owl:intersectionOf (sio:SIO_000069
                                                        [dc11:identifier ":arc758fb62" ; 
                                                        owl:allValuesFrom sio:SIO_000069 ; 
                                                        owl:onProperty sio:SIO_000059 ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class].
sio:SIO_000090 dc11:identifier "SIO_000090";
               dcterms:description "A specification is a description of the essential technical attributes/requirements for an object or procedure, and may be used to determine that the object / procedure meets its requirements/attributes."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "specification"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb66" ; 
                                owl:someValuesFrom sio:SIO_000015 ; 
                                owl:onProperty sio:SIO_000420 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb65" ; 
                                owl:someValuesFrom sio:SIO_000337 ; 
                                owl:onProperty sio:SIO_000369 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb64" ; 
                                owl:someValuesFrom sio:SIO_000000 ; 
                                owl:onProperty sio:SIO_000338 ; 
                                a owl:Restriction],
                               sio:SIO_000136.
sio:SIO_000091 dc11:identifier "SIO_000091";
               dcterms:description "An action specification is a specification composed of a sequence of instructions to achieve some objective."@en;
               sio:hasSynonym "effective specification";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "action specification"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb67" ; 
                                owl:someValuesFrom sio:SIO_000006 ; 
                                owl:onProperty sio:SIO_000338 ; 
                                a owl:Restriction],
                               sio:SIO_000090,
                               [dc11:identifier ":arc758fb69" ; 
                                owl:allValuesFrom sio:SIO_000006 ; 
                                owl:onProperty sio:SIO_000341 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb68" ; 
                                owl:someValuesFrom sio:SIO_000337 ; 
                                owl:onProperty sio:SIO_000362 ; 
                                a owl:Restriction].
sio:SIO_000092 dc11:identifier "SIO_000092";
               dcterms:description "A biopolymer is an organic polymer using biological components."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "biopolymer"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb70" ; 
                                owl:someValuesFrom [dc11:identifier ":arc758fb71" ; 
                                                    owl:unionOf (sio:SIO_000556
                                                                 sio:SIO_010074
                                                                 sio:SIO_010075
                                                                 sio:SIO_010334) ; 
                                                    a owl:Class] ; 
                                owl:onProperty sio:SIO_000273 ; 
                                a owl:Restriction],
                               sio:SIO_010346.
sio:SIO_000093 dc11:identifier "SIO_000093";
               dcterms:description "is proper part of is an asymmetric, irreflexive (normally transitive) relation between a part and its distinct whole."@en;
               sio:equivalentTo "OBO_REL:proper_part_of";
               sio:subset "core";
               a owl:AsymmetricProperty,
                 owl:IrreflexiveProperty,
                 owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is proper part of"@en;
               rdfs:subPropertyOf sio:SIO_000068.
sio:SIO_000094 dc11:identifier "SIO_000094";
               dcterms:description "An algorithm is an effective method expressed as a finite list of well-defined instructions for calculating a function."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "algorithm"@en;
               rdfs:subClassOf sio:SIO_000075.
sio:SIO_000095 dc11:identifier "SIO_000095";
               dcterms:description "is member of is a mereological relation between a item and a collection."@en;
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is member of"@en;
               rdfs:subPropertyOf sio:SIO_000011.
sio:SIO_000096 dc11:identifier "SIO_000096";
               dcterms:description "is boundary of is a mereological relation between a boundary located at the periphery of a whole."@en;
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is boundary of"@en;
               rdfs:subPropertyOf sio:SIO_000093.
sio:SIO_000097 dc11:identifier "SIO_000097";
               dcterms:description "A software entity is a computational entity that can be interpreted by or directly executed by a processing unit."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software entity"@en;
               rdfs:subClassOf sio:SIO_000602.
sio:SIO_000098 dc11:identifier "SIO_000098";
               dcterms:description "A software method (also called subroutine, subprogram, procedure, method, function, or routine) is software designed to execute a specific task."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software method"@en;
               rdfs:subClassOf sio:SIO_000097.
sio:SIO_000099 dc11:identifier "SIO_000099";
               dcterms:description "A software module is software composed of a collection of software methods."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software module"@en;
               rdfs:subClassOf sio:SIO_000097.
sio:SIO_000100 dc11:identifier "SIO_000100";
               dcterms:description "A software library is software composed of a collection of software modules and/or software methods in a form that can be statically or dynamically linked to some software application."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software library"@en;
               rdfs:subClassOf sio:SIO_000097.
sio:SIO_000101 dc11:identifier "SIO_000101";
               dcterms:description "A software application is software that can be directly executed by some processing unit."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software application"@en;
               rdfs:subClassOf sio:SIO_000097.
sio:SIO_000102 dc11:identifier "SIO_000102";
               dcterms:description "A software interpreter is a software application that executes some specified input software."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software interpreter"@en;
               rdfs:subClassOf sio:SIO_000101.
sio:SIO_000103 dc11:identifier "SIO_000103";
               dcterms:description "A software script is software whose instructions can be executed using a software interpreter."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software script"@en;
               rdfs:subClassOf sio:SIO_000097.
sio:SIO_000104 dc11:identifier "SIO_000104";
               dcterms:description "Language is a language entity which is the result of encoding and decoding information through systematic creation and usage of systems of symbols, each pairing a specific sign with an intended meaning, established through social conventions"@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "language"@en;
               rdfs:subClassOf sio:SIO_000078.
sio:SIO_000105 dc11:identifier "SIO_000105";
               dcterms:description "A symbol is a proposition about what an entity represents."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "symbol"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb77" ; 
                                owl:someValuesFrom sio:SIO_000000 ; 
                                owl:onProperty sio:SIO_000332 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb76" ; 
                                owl:someValuesFrom sio:SIO_000000 ; 
                                owl:onProperty sio:SIO_000210 ; 
                                a owl:Restriction],
                               sio:SIO_000612.
sio:SIO_000106 dc11:identifier "SIO_000106";
               dcterms:description "A book is a publication composed of a large number of entries."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "book"@en;
               rdfs:subClassOf sio:SIO_000087.
sio:SIO_000107 dc11:identifier "SIO_000107";
               dcterms:description "A chapter is a document section of a book or thesis."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "chapter"@en;
               rdfs:subClassOf sio:SIO_000111.
sio:SIO_000108 dc11:identifier "SIO_000108";
               dcterms:description "A character is a language symbol used to construct words."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "character"@en;
               rdfs:subClassOf sio:SIO_000078.
sio:SIO_000109 dc11:identifier "SIO_000109";
               dcterms:description "A novel is a fictitious prose narrative of book length, typically representing character and action with some degree of realism."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "novel"@en;
               rdfs:subClassOf sio:SIO_000087.
sio:SIO_000110 dc11:identifier "SIO_000110";
               dcterms:description "A paragraph is a self-contained unit of written discourse consisting of one or more sentences."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "paragraph"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb78" ; 
                                owl:someValuesFrom sio:SIO_000113 ; 
                                owl:onProperty sio:SIO_000273 ; 
                                a owl:Restriction],
                               sio:SIO_000651.
sio:SIO_000111 dc11:identifier "SIO_000111";
               dcterms:description "A document section is a component of a document."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "document section"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb79" ; 
                                owl:someValuesFrom sio:SIO_000148 ; 
                                owl:onProperty sio:SIO_000093 ; 
                                a owl:Restriction],
                               sio:SIO_000171.
sio:SIO_000112 dc11:identifier "SIO_000112";
               dcterms:description "A capability is a realizable entity whose basis lies in one or more parts or qualities and reflects possility of an entity to act in a specified way under certain conditions or in response to a certain stimulus (trigger)."@en;
               sio:subset "capability+",
                          "core";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "capability"@en;
               rdfs:subClassOf sio:SIO_000340,
                               [dc11:identifier ":arc758fb82" ; 
                                owl:someValuesFrom sio:SIO_000005 ; 
                                owl:onProperty sio:SIO_000641 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb83" ; 
                                owl:allValuesFrom sio:SIO_000006 ; 
                                owl:onProperty sio:SIO_000635 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb80" ; 
                                owl:someValuesFrom [dc11:identifier ":arc758fb81" ; 
                                                    owl:someValuesFrom sio:SIO_000006 ; 
                                                    owl:onProperty sio:SIO_000063 ; 
                                                    a owl:Restriction] ; 
                                owl:onProperty sio:SIO_000011 ; 
                                a owl:Restriction].
sio:SIO_000113 dc11:identifier "SIO_000113";
               dcterms:description "A sentence is a grammatical unit consisting of one or more words that bear minimal syntactic relation to the words that precede or follow it."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "sentence"@en;
               rdfs:subClassOf sio:SIO_000483.
sio:SIO_000114 dc11:identifier "SIO_000114";
               dcterms:description "A word is the smallest free form (an item that may be expressed in isolation with semantic or pragmatic content) in a language."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "word"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb85" ; 
                                owl:someValuesFrom sio:SIO_000108 ; 
                                owl:onProperty sio:SIO_000273 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb84" ; 
                                owl:someValuesFrom sio:SIO_001040 ; 
                                owl:onProperty sio:SIO_000028 ; 
                                a owl:Restriction],
                               sio:SIO_000078.
sio:SIO_000115 dc11:identifier "SIO_000115";
               dcterms:description "An identifier is a label that specifically refers to (identifies) an entity (instance/type)."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "identifier"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb86" ; 
                                owl:someValuesFrom sio:SIO_000000 ; 
                                owl:onProperty sio:SIO_000672 ; 
                                a owl:Restriction],
                               sio:SIO_000179.
sio:SIO_000116 dc11:identifier "SIO_000116";
               dcterms:description "A name is a label used to identify an entity."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "name"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb87" ; 
                                owl:someValuesFrom xsd:string ; 
                                owl:onProperty sio:SIO_000300 ; 
                                a owl:Restriction],
                               sio:SIO_000179.
sio:SIO_000117 dc11:identifier "SIO_000117";
               dcterms:description "A preferred name is the name that is generally used by some organization. "@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "preferred name"@en;
               rdfs:subClassOf sio:SIO_000116.
sio:SIO_000118 dc11:identifier "SIO_000118";
               dcterms:description "A common name is a name that is commonly used."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "common name"@en;
               rdfs:subClassOf sio:SIO_000116.
sio:SIO_000119 dc11:identifier "SIO_000119";
               dcterms:description "A brand name is a trademarked and marketed name of a product."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "brand name"@en;
               rdfs:subClassOf sio:SIO_000116.
sio:SIO_000120 dc11:identifier "SIO_000120";
               dcterms:description "A scientific name is a name given through scientific nomenclature."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "scientific name"@en;
               rdfs:subClassOf sio:SIO_000116.
sio:SIO_000121 dc11:identifier "SIO_000121";
               dcterms:description "A magazine is a periodical that typically contains essays, stories, poems, etc., by many writers, and often photographs and drawings, frequently specializing in a particular subject or area, as hobbies, news, or sports."@en;
               sio:equivalentTo "http://purl.org/ontology/bibo/Magazine";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "magazine"@en;
               rdfs:subClassOf sio:SIO_000162.
sio:SIO_000122 dc11:identifier "SIO_000122";
               dcterms:description "A synonym is a word with the same or very similar meanings."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "synonym"@en;
               rdfs:subClassOf sio:SIO_000342;
               owl:equivalentClass [dc11:identifier ":arc758fb88" ; 
                                    owl:intersectionOf (sio:SIO_000342
                                                        [dc11:identifier ":arc758fb90" ; 
                                                        owl:someValuesFrom sio:SIO_000275 ; 
                                                        owl:onProperty sio:SIO_000283 ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class].
sio:SIO_000123 dc11:identifier "SIO_000123";
               dcterms:description "An antonym is a word with opposite or nearly opposite meaning."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "antonym"@en;
               rdfs:subClassOf sio:SIO_000342;
               owl:equivalentClass [dc11:identifier ":arc758fb92" ; 
                                    owl:intersectionOf (sio:SIO_000342
                                                        [dc11:identifier ":arc758fb94" ; 
                                                        owl:someValuesFrom sio:SIO_000275 ; 
                                                        owl:onProperty sio:SIO_000496 ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class].
sio:SIO_000124 dc11:identifier "SIO_000124";
               dcterms:description "A hypernym is a term with a broader meaning."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "hypernym"@en;
               rdfs:subClassOf sio:SIO_000342;
               owl:equivalentClass [dc11:identifier ":arc758fb96" ; 
                                    owl:intersectionOf (sio:SIO_000342
                                                        [dc11:identifier ":arc758fb98" ; 
                                                        owl:someValuesFrom sio:SIO_000275 ; 
                                                        owl:onProperty sio:SIO_000477 ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class].
sio:SIO_000125 dc11:identifier "SIO_000125";
               dcterms:description "A hyponym is a term with a narrower meaning."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "hyponym"@en;
               rdfs:subClassOf sio:SIO_000342;
               owl:equivalentClass [dc11:identifier ":arc758fb100" ; 
                                    owl:intersectionOf (sio:SIO_000342
                                                        [dc11:identifier ":arc758fb102" ; 
                                                        owl:someValuesFrom sio:SIO_000275 ; 
                                                        owl:onProperty sio:SIO_000427 ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class].
sio:SIO_000126 dc11:identifier "SIO_000126";
               dcterms:description "A homonym is a word that sounds the same but has different meaning."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "homonym"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb104" ; 
                                owl:someValuesFrom sio:SIO_000275 ; 
                                owl:onProperty sio:SIO_000495 ; 
                                a owl:Restriction],
                               sio:SIO_000342.
sio:SIO_000127 dc11:identifier "SIO_000127";
               dcterms:description "A workflow is an algorithm that is is a depiction of a sequence of operations to achieve one or more objectives."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "workflow"@en;
               rdfs:subClassOf sio:SIO_000094.
sio:SIO_000128 dc11:identifier "SIO_000128";
               dcterms:description "A is contained in B iff the spatial region occupied by A is part of the spatial region occupied by B and A is not part of B. [T]"@en;
               sio:equivalentTo "OBO_REL:contained_in";
               sio:subset "core";
               a owl:ObjectProperty,
                 owl:TransitiveProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "is contained in"@en;
               rdfs:subPropertyOf sio:SIO_000061;
               owl:inverseOf sio:SIO_000202.
sio:SIO_000129 dc11:identifier "SIO_000129";
               dcterms:description "An ontology document is a document that contains an ontology."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "ontology document"@en;
               rdfs:subClassOf sio:SIO_000148.
sio:SIO_000130 dc11:identifier "SIO_000130";
               dcterms:description "A pattern is a generalized representation of some repeatable concrete or informational item."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "pattern"@en;
               rdfs:subClassOf sio:SIO_000075.
sio:SIO_000131 dc11:identifier "SIO_000131";
               dcterms:description "A sequence motif is a pattern of nucleotides in a DNA sequence or amino acids in a protein."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "sequence motif"@en;
               rdfs:subClassOf sio:SIO_000130;
               owl:disjointWith sio:SIO_001197.
sio:SIO_000132 dc11:identifier "SIO_000132";
               dcterms:description "has participant is a relation that describes the participation of the object in the (processual) subject."@en;
               sio:equivalentTo "OBO_REL:has_participant";
               sio:subset "core";
               a owl:ObjectProperty;
               rdfs:domain sio:SIO_000006;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has participant"@en;
               rdfs:subPropertyOf sio:SIO_000322.
sio:SIO_000133 dc11:identifier "SIO_000133";
               dcterms:description "A descriptor (index term, subject term, subject heading) is a term that captures the essence of the topic of a document."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "descriptor"@en;
               rdfs:subClassOf sio:SIO_000275.
sio:SIO_000135 dc11:identifier "SIO_000135";
               dcterms:description "A definition is a description that succintly characterizes an entity."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "definition"@en;
               rdfs:subClassOf sio:SIO_000136.
sio:SIO_000136 dc11:identifier "SIO_000136";
               dcterms:description "A description is language entity in which elements of a language (formal or natural) are used to characterize an entity."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "description"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb105" ; 
                                owl:allValuesFrom sio:SIO_000000 ; 
                                owl:onProperty sio:SIO_000563 ; 
                                a owl:Restriction],
                               sio:SIO_000078.
sio:SIO_000137 dc11:identifier "SIO_000137";
               dcterms:description "A category is a class of entities having particular shared characteristics."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "category"@en;
               rdfs:subClassOf sio:SIO_000326.
sio:SIO_000138 dc11:identifier "SIO_000138";
               dcterms:description "A class is a collection of sets which can be unambiguously defined by a property that all its members share."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "class"@en;
               rdfs:subClassOf sio:SIO_000289.
sio:SIO_000139 dc11:identifier "SIO_000139";
               dcterms:description "has agent is a relation between a process and an entity, where the entity is present throughout the process and is a causal participant in the process."@en;
               sio:equivalentTo "OBO_REL:has_agent";
               sio:subset "sadi"@en,
                          "core";
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "has agent"@en;
               rdfs:subPropertyOf sio:SIO_000132.
