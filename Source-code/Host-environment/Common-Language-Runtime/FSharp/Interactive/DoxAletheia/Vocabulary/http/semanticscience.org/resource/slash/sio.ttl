               <http://purl.org/dc/terms/description> "antiport enabled secondary active transport is a secondary active transfort in which both ion and molecule are transported in opposite directions simultaneously."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "antiport enabled secondary active transport"@en;
               rdfs:subClassOf sio:SIO_000578.
