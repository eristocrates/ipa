               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "transfer RNA (tRNA)"@en;
               rdfs:subClassOf sio:SIO_001235.
sio:SIO_001233 <http://purl.org/dc/elements/1.1/identifier> "SIO_001233";
               <http://purl.org/dc/terms/description> "A small nuclear RNA (snRNA) is a small RNA molecule that is located in the nucleus of a cell."@en;
               sio:hasSynonym "snRNA"@en;
