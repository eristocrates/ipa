                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_000612.
sio:SIO_000511 <http://purl.org/dc/elements/1.1/identifier> "SIO_000511";
               <http://purl.org/dc/terms/description> "A line is curve that extends in a single dimension (e.g. straight line; exhibits no curvature), and is composed of at least two fully connected points."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "line"@en;
