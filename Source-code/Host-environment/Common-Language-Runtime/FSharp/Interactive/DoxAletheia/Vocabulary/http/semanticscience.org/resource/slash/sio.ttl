               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "data collection device"@en;
               rdfs:subClassOf sio:SIO_000956.
sio:SIO_001237 <http://purl.org/dc/elements/1.1/identifier> "SIO_001237";
               <http://purl.org/dc/terms/description> "A mass spectrometer is a device that identifies ions based on their mass to charge ratio using an electromagnetic field."@en;
               sio:similarTo "http://purl.obolibrary.org/obo/OBI_0000049"^^xsd:anyURI;
