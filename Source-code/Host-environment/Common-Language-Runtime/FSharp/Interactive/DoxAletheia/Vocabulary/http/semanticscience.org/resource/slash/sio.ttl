               dcterms:description "A signal is an object that initiates a sequence of events."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "signal"@en;
               rdfs:subClassOf sio:SIO_011125.
sio:SIO_010439 dc11:identifier "SIO_010439";
               dcterms:description "A mesenger is a molecule involved in either signal detection or signal propagation from receptors on the cell surface to target molecules inside the cell, in the cytoplasm or nucleus."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "messenger"@en;
               rdfs:subClassOf sio:SIO_010437.
sio:SIO_010440 dc11:identifier "SIO_010440";
               dcterms:description "A second messenger is a molecule that relay signals from receptors on the cell surface to target molecules inside the cell, in the cytoplasm or nucleus. "@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "second messenger"@en;
               rdfs:subClassOf sio:SIO_010439.
sio:SIO_010441 dc11:identifier "SIO_010441";
               dcterms:description "A submolecule is a mereological sum of covalently bonded atoms."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "submolecule"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb826" ; 
                                owl:someValuesFrom sio:SIO_010044 ; 
                                owl:onProperty sio:SIO_000369 ; 
                                a owl:Restriction],
                               [dc11:identifier ":arc758fb825" ; 
                                owl:someValuesFrom sio:SIO_011125 ; 
                                owl:onProperty sio:SIO_000313 ; 
                                a owl:Restriction],
                               sio:SIO_010020.
sio:SIO_010442 dc11:identifier "SIO_010442";
               dcterms:description "charge quality is the quality pertaining to electric charge."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "charge quality"@en;
               rdfs:subClassOf sio:SIO_001011;
               owl:equivalentClass [dc11:identifier ":arc758fb827" ; 
                                    owl:unionOf (sio:SIO_000805
                                                 sio:SIO_000806) ; 
                                    a owl:Class].
sio:SIO_010443 dc11:identifier "SIO_010443";
               dcterms:description "An intron is a region of a gene that is removed from the final protein open reading frame."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "intron"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb830" ; 
                                owl:someValuesFrom sio:SIO_010035 ; 
                                owl:onProperty sio:SIO_000093 ; 
                                a owl:Restriction],
                               sio:SIO_010444.
sio:SIO_010444 dc11:identifier "SIO_010444";
               dcterms:description "A gene component is a component of a gene.";
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "gene component"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb831" ; 
                                owl:someValuesFrom sio:SIO_010035 ; 
                                owl:onProperty sio:SIO_000093 ; 
                                a owl:Restriction],
                               sio:SIO_010335.
sio:SIO_010445 dc11:identifier "SIO_010445";
               dcterms:description "An exon is a nucleotide sequence encoded by a gene that remains present within the final mature RNA product of that gene after introns have been removed by RNA splicing. "@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "exon"@en;
               rdfs:subClassOf sio:SIO_010444.
sio:SIO_010446 dc11:identifier "SIO_010446";
               dcterms:description "A gene promoter is a region of DNA that initiates transcription of a particular gene."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "gene promoter"@en;
               rdfs:subClassOf sio:SIO_010085.
sio:SIO_010447 dc11:identifier "SIO_010447";
               dcterms:description "A start codon is the first codon of a messenger RNA (mRNA) transcript translated by a ribosome. The start codon is almost always preceded by an untranslated region 5' UTR."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "start codon"@en;
               rdfs:subClassOf sio:SIO_010095;
               owl:disjointWith sio:SIO_010448.
sio:SIO_010448 dc11:identifier "SIO_010448";
               dcterms:description "A stop codon (or termination codon) is a nucleotide triplet within messenger RNA that signals a termination of translation."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "stop codon"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb832" ; 
                                owl:someValuesFrom sio:SIO_010099 ; 
                                owl:onProperty sio:SIO_000068 ; 
                                a owl:Restriction],
                               sio:SIO_010095.
sio:SIO_010450 dc11:identifier "SIO_010450";
               dcterms:description "An RNA transcript is an RNA molecule that is produced from transcription of a nucleic acid template."@en;
               a owl:Class;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "RNA transcript"@en;
               rdfs:subClassOf [dc11:identifier ":arc758fb833" ; 
                                owl:someValuesFrom [dc11:identifier ":arc758fb834" ; 
                                                    owl:unionOf (sio:SIO_010010
                                                                 [dc11:identifier ":arc758fb836" ; 
