                               sio:SIO_000006.
sio:SIO_001000 <http://purl.org/dc/elements/1.1/identifier> "SIO_001000";
               <http://purl.org/dc/terms/description> "A clinical trial is an intervention trial to determine the safety and efficacy of  medical interventions (e.g., drugs, diagnostics, devices, therapy protocols). "@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "clinical trial"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb454" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_001043 ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000339 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               sio:SIO_001048.
sio:SIO_001001 <http://purl.org/dc/elements/1.1/identifier> "SIO_001001";
               <http://purl.org/dc/terms/description> "A medical diagnosis (often simply termed diagnosis) refers to the process of attempting to determine or identify a possible disease or disorder."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "medical diagnosis"@en;
               rdfs:subClassOf [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb456" ; 
                                <http://www.w3.org/2002/07/owl#someValuesFrom> [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb457" ; 
                                                                                <http://www.w3.org/2002/07/owl#intersectionOf> (sio:SIO_010046
                                                                                                                                [<http://purl.org/dc/elements/1.1/identifier> ":arc758fb459" ; 
                                                                                                                                <http://www.w3.org/2002/07/owl#someValuesFrom> sio:SIO_000758 ; 
                                                                                                                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000217 ; 
                                                                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                a <http://www.w3.org/2002/07/owl#Class>] ; 
                                <http://www.w3.org/2002/07/owl#onProperty> sio:SIO_000230 ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
