                               sio:SIO_000790.
sio:SIO_001230 <http://purl.org/dc/elements/1.1/identifier> "SIO_001230";
               <http://purl.org/dc/terms/description> "A transfer RNA (tRNA) gene is a gene that codes for a tRNA used in the translation of a messenger RNA (mRNA) to produce a protein product."@en;
               sio:equivalentTo "http://purl.obolibrary.org/obo/SO_0001272"^^xsd:anyURI;
               sio:hasSynonym "tRNA gene"@en,
                              "solube RNA (sRNA) gene"@en;
