sio:SIO_000101 <http://purl.org/dc/elements/1.1/identifier> "SIO_000101";
               <http://purl.org/dc/terms/description> "A software application is software that can be directly executed by some processing unit."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software application"@en;
               rdfs:subClassOf sio:SIO_000097.
sio:SIO_000102 <http://purl.org/dc/elements/1.1/identifier> "SIO_000102";
               <http://purl.org/dc/terms/description> "A software interpreter is a software application that executes some specified input software."@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://semanticscience.org/ontology/sio.owl>;
               rdfs:label "software interpreter"@en;
               rdfs:subClassOf sio:SIO_000101.
sio:SIO_000103 <http://purl.org/dc/elements/1.1/identifier> "SIO_000103";
               <http://purl.org/dc/terms/description> "A software script is software whose instructions can be executed using a software interpreter."@en;
