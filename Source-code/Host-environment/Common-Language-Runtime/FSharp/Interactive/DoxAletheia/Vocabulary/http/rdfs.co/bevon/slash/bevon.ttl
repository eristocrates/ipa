                  rdfs:label "Whisky Terms"@en.
bevon:WhiteWine <http://purl.org/dc/terms/issued> "2014-03-07+09:00"^^xsd:date;
                <http://purl.org/dc/terms/modified> "2014-03-07+09:00"^^xsd:date;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment """
    It is produced by the alcoholic fermentation of the non-coloured pulp of
    grapes which may have a white or black skin. It is treated so as to
    maintain a yellow transparent colour in the final product.
    """@en;
                rdfs:isDefinedBy bevon:;
                rdfs:seeAlso <http://en.wikipedia.org/wiki/White_wine>;
                rdfs:subClassOf bevon:Wine,
                                <http://www.productontology.org/id/White_wine>;
                <http://www.w3.org/2002/07/owl#sameAs> <http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#WhiteWine>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
                <http://www.w3.org/2004/02/skos/core#definition> """
    White wine is a wine whose colour can be straw-yellow, yellow-green, or
    yellow-gold coloured.
    """@en;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "화이트 와인"@ko,
                                                                "White Wine"@en,
                                                                "Vin Blanc"@fr.
bevon:Wine <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
           <http://purl.org/dc/terms/modified> "2014-03-07+09:00"^^xsd:date;
           a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:isDefinedBy bevon:;
           rdfs:seeAlso <http://en.wikipedia.org/wiki/Wine>;
           rdfs:subClassOf bevon:FermentedBeverage,
                           <http://www.productontology.org/id/Wine>;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
           <http://www.w3.org/2004/02/skos/core#definition> """
    Wine is an alcoholic beverage made from fermented grapes or other fruits.
    """@en;
           <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/terms/creator> <http://jayg.me/> ; 
                                                              <http://purl.org/dc/terms/date> "2014-03-07+09:00"^^xsd:date ; 
                                                              rdf:value """
      Changed the semantics of bevon:Wine not to be the same as wine:Wine
      """@en];
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Wine"@en,
                                                           "Vin"@fr,
                                                           "와인"@ko.
