            rdfs:isDefinedBy bevon:;
            rdfs:range xsd:decimal;
            rdfs:seeAlso <http://en.wikipedia.org/wiki/Alcohol_proof>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
            <http://www.w3.org/2004/02/skos/core#altLabel> "alcohol proof"@en;
            <http://www.w3.org/2004/02/skos/core#definition> """
