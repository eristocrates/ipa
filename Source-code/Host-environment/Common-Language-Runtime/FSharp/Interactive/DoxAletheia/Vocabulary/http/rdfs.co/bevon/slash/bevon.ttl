                  rdf:_3 bevon:BourbonWhiskey;
                  rdf:_4 bevon:CanadianWhisky;
                  rdf:_5 bevon:IrishWhiskey;
                  rdf:_6 bevon:JapaneseWhisky;
                  rdf:_7 bevon:ScotchWhisky;
                  rdf:_8 bevon:MaltWhisky;
                  rdf:_9 bevon:SingleMaltWhisky;
                  a rdf:Bag;
                  rdfs:comment """
