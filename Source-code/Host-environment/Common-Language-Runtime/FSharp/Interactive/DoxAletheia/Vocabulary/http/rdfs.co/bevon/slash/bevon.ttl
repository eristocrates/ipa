@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix food: <http://data.lirmm.fr/ontologies/food#>.
@prefix wiki: <http://en.wikipedia.org/wiki/>.
@prefix dcam: <http://purl.org/dc/dcam/>.
@prefix gr: <http://purl.org/goodrelations/v1#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix bevon: <http://rdfs.co/bevon/>.
@prefix pto: <http://www.productontology.org/id/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix time: <http://www.w3.org/2006/time#>.
@prefix fowl: <http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#>.
@prefix vin: <http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#>.
@prefix adms: <http://www.w3.org/ns/adms#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix planet: <http://dbpedia.org/>.
@prefix dbyago: <http://dbpedia.org/class/yago/>.
@prefix dbpedia-owl: <http://dbpedia.org/ontology/>.
@prefix resource: <http://dbpedia.org/resource/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.
@prefix wikipedia: <https://en.wikipedia.org/wiki/>.

<http://jayg.me/> a foaf:Person;
                  foaf:homepage <http://jayg.org/>;
                  foaf:mbox_sha1sum "f03421e94730da58e8943d3a1d2c4c6b02898e14";
                  foaf:name "김보람"@ko,
                            "James G. Kim"@en.
<http://purl.org/vocab/whisky/terms/Distillery> rdfs:subClassOf bevon:Distillery.
<http://purl.org/vocab/whisky/terms/abv> rdfs:subPropertyOf bevon:abv.
<http://purl.org/vocab/whisky/terms/distillery> rdfs:subPropertyOf bevon:distillery.
bevon:0.8 ccrel:license <http://creativecommons.org/licenses/by/4.0/>;
          dcterms:creator <http://jayg.me/>;
          dcterms:description """
    Beverage Ontology is a Web vocabulary for describing beverages, mainly
    alcoholic.
    """@en;
          dcterms:hasFormat <http://rdfs.co/bevon/0.8/rdf>,
                            <http://rdfs.co/bevon/0.8/html>,
                            <http://rdfs.co/bevon/0.8/ttl>;
          dcterms:identifier "http://rdfs.co/bevon/0.8";
          dcterms:isVersionOf bevon:;
          dcterms:issued "2013-07-04+09:00"^^xsd:date;
          dcterms:modified "2015-07-23+09:00"^^xsd:date;
          dcterms:publisher <http://jayg.me/>;
          dcterms:replaces bevon:0.7;
          dcterms:rights "Copyright © 2013-2015 James G. Kim Some Rights Reserved.";
          dcterms:title "BEVON: Beverage Ontology"@en;
          dcterms:type <http://purl.org/adms/assettype/Ontology>;
          vann:example [rdfs:comment """
    <pre><code>beverage:Glenfiddich12YearOld
  a owl:NamedIndividual, bevon:SpeysideSingleMalt , gr:ProductOrServiceModel ;
  bevon:name \"Glenfiddich 12 Year Old\"@en , \"글렌피딕 12년\"@ko ;
  bevon:description \"\"\"
    Carefully matured in the finest American bourbon and Spanish sherry oak
    casks for at least 12 years. Married and mellowed in oak marrying tuns for
    complete harmony of aroma and flavor.

    A single malt Scotch whisky with distinctive fresh pear, creamy with subtle
    oak flavors and a long smooth and mellow finish.
    \"\"\"@en ;
  bevon:origin &lt;http://dbpedia.org/resource/Strathspey,_Scotland&gt; ;
  bevon:launch \"1887\"^^xsd:gYear ;
  bevon:distillery [
    a bevon:Distillery ;
    owl:sameAs &lt;http://dbpedia.org/resource/Glenfiddich_distillery&gt; ;
    whisky:region &lt;http://dbpedia.org/resource/Strathspey,_Scotland&gt; ;
    whisky:owner &lt;http://dbpedia.org/resource/William_Grant_%26_Sons&gt; ;
    whisky:waterSource [
      a whisky:WaterSource ;
      dcterms:title \"Robbie Dhu Springs\"@en , \"로비 듀 수원지\"@ko
    ]
  ] ;
  bevon:manufacturer &lt;http://dbpedia.org/resource/William_Grant_%26_Sons&gt; ;
  bevon:fermentation_base &lt;http://dbpedia.org/resource/Barley&gt; ;
  bevon:aging [
    a bevon:Aging ;
    bevon:material &lt;http://dbpedia.org/resource/Oak&gt; ;
    bevon:previous_content
      &lt;http://dbpedia.org/resource/Bourbon_whiskey&gt; ,
      &lt;http://dbpedia.org/resource/Sherry&gt; ;
    bevon:duration [
      a time:DurationDescription ;
      time:years \"12\"^^xsd:decimal
    ]
  ] ;
  bevon:color [
    a dbpedia:Colour ;
    owl:sameAs &lt;http://dbpedia.org/resource/Gold_(color)&gt; ;
    owl:sameAs &lt;http://purl.org/colors/rgb/FFD700&gt; ;
    dcterms:title \"Gold\"@en
  ] ;
  bevon:abv \"40\"^^xsd:decimal ;
  bevon:container container:700mlGlassBottle .

container:700mlGlassBottle a owl:NamedIndividual, bevon:GlassBottle ;
  skos:prefLabel \"700ml Glass Bottle\"@en , \"700ml 유리병\"@ko ;
  skos:altLabel \"70cl Glass Bottle\"@en ;
  bevon:volume [
    a gr:QuantitativeValueInteger ;
    gr:hasUnitOfMeasurement \"MLT\" ;
    gr:hasValue \"700\"^^xsd:int
  ] .</code></pre>
    """^^rdf:XMLLiteral ; 
                        rdfs:label "Glenfiddich 12 Year Old"@en],
                       [rdfs:comment """
    <pre><code>beverage:WhiskyAndSoda
  a owl:NamedIndividual, bevon:Highball , gr:ProductOrServiceModel ;
  bevon:name \"Whisky &amp; Soda\"@en , \"위스키 소다\"@ko ;
  bevon:description \"\"\"
    Whisky &amp; Soda is a kind of mixed drinks that are composed of whisky and
    carbonated water.
    \"\"\"@en ;
  bevon:ingredient [
    a food:Ingredient ;
    bevon:food [
      a bevon:Whisky ;
      owl:sameAs &lt;http://dbpedia.org/resource/Whisky&gt; ;
      dcterms:title \"Whisky\"@en
    ] ;
    bevon:quantity [
      a gr:QuantitativeValueInteger ;
      gr:hasUnitOfMeasurement \"OZA\" ;
      gr:hasValue \"2\"^^xsd:int
    ]
  ] , [
    a food:Ingredient ;
    bevon:food [
      a bevon:CarbonatedWater ;
      owl:sameAs &lt;http://dbpedia.org/resource/Carbonated_water&gt; ;
      dcterms:title \"Carbonated Water\"@en
    ]
  ] .</code></pre>
    """^^rdf:XMLLiteral ; 
                        rdfs:label "Whisky & Soda"@en];
          vann:preferredNamespacePrefix "bevon";
          vann:preferredNamespaceUri "http://rdfs.co/bevon/";
          vann:termGroup bevon:BeerGroup,
                         bevon:RelationGroup,
                         bevon:ContainerGroup,
                         bevon:CoreGroup,
                         bevon:WineGroup,
                         bevon:CocktailGroup,
                         bevon:WhiskyGroup;
          a adms:SemanticAsset,
            ccrel:Work,
            voaf:Vocabulary,
            owl:Ontology;
          rdfs:comment """
    Most of the descriptions given here are from Wikipedia or from the websites
    of the related products.
    """@en,
                       """
    <div>
      The master version of this vocabulary is maintained in <a
      href=\"https://github.com/jgkim/bevon\">the GitHub repository</a> so others
      can contribute edits and improvements.
    </div>
    """;
          rdfs:seeAlso <https://github.com/jgkim/bevon>;
          owl:versionInfo "0.8";
          skos:changeNote [dcterms:creator <http://jayg.me/> ; 
                           dcterms:date "2015-07-27+09:00"^^xsd:date ; 
                           rdf:value """
      Made the vocabulary as a type of voaf:Vocabulary
      """@en],
                          [dcterms:creator <http://jayg.me/> ; 
                           dcterms:date "2014-03-03+09:00"^^xsd:date ; 
                           rdf:value """
      Added a link to the GitHub repository
      """@en],
                          [dcterms:creator <http://jayg.me/> ; 
                           dcterms:date "2014-03-06+09:00"^^xsd:date ; 
                           rdf:value """
      Added term groups for core, relation, container, beer, whisky and
      cocktail terms
      """@en],
                          [dcterms:creator <http://jayg.me/> ; 
                           dcterms:date "2014-03-01+09:00"^^xsd:date ; 
                           rdf:value """
      Minor revisions for documentation
      """@en];
          skos:historyNote [dcterms:creator <http://jayg.me/> ; 
                            dcterms:date "2015-07-23+09:00"^^xsd:date ; 
                            rdf:value """
      Fixed the sameAs relationship of bevon:Whisky
      """@en],
                           [dcterms:creator <http://jayg.me/> ; 
                            dcterms:date "2014-03-07+09:00"^^xsd:date ; 
                            rdf:value """
      Changed the semantics of bevon:Wine to be a superclass of wine:Wine
      """@en],
                           [dcterms:creator <http://jayg.me/> ; 
                            dcterms:date "2014-03-07+09:00"^^xsd:date ; 
                            rdf:value """
      Added bevon:RedWine, bevon:WhiteWine and bevon:FruitWine
      """@en],
                           [dcterms:creator <http://jayg.me/> ; 
                            dcterms:date "2014-03-06+09:00"^^xsd:date ; 
                            rdf:value """
      Changed bevon:FermentedBeverages to bevon:FermentedBeverage for the
      consistency
      """@en];
          adms:status <http://purl.org/adms/status/UnderDevelopment>.
<http://rdfs.co/bevon/0.8/html> dcterms:format [rdfs:seeAlso <http://www.iana.org/assignments/media-types/text/html> ; 
                                                rdfs:label "HTML"@en ; 
                                                rdf:value "text/html" ; 
                                                dcam:memberOf dcterms:IMT ; 
                                                a dcterms:MediaType].
<http://rdfs.co/bevon/0.8/rdf> dcterms:format [rdfs:seeAlso <http://www.iana.org/assignments/media-types/application/rdf+xml> ; 
                                               rdfs:label "RDF/XML"@en ; 
                                               rdf:value "application/rdf+xml" ; 
                                               dcam:memberOf dcterms:IMT ; 
                                               a dcterms:MediaType].
<http://rdfs.co/bevon/0.8/ttl> dcterms:format [rdfs:seeAlso <http://www.iana.org/assignments/media-types/text/turtle> ; 
                                               rdfs:label "Turtle"@en ; 
                                               rdf:value "text/turtle" ; 
                                               dcam:memberOf dcterms:IMT ; 
                                               a dcterms:MediaType].
bevon:Aging dcterms:issued "2013-07-04+09:00"^^xsd:date;
            dcterms:modified "2014-03-01+09:00"^^xsd:date;
            a owl:Class;
            rdfs:isDefinedBy bevon:;
            status:term_status "unstable"@en;
            skos:definition """
    Aging is the process of storing beverages in casks for a specific period of
    time to remove harsh flavors and add distinct characteristics found in the
    cask's wood.
    """@en;
            skos:prefLabel "숙성"@ko,
                           "Aging"@en.
bevon:AlcoholicBeverage dcterms:issued "2013-07-04+09:00"^^xsd:date;
                        dcterms:modified "2014-03-01+09:00"^^xsd:date;
                        a owl:Class;
                        rdfs:isDefinedBy bevon:;
                        rdfs:seeAlso wiki:Alcoholic_beverage;
                        rdfs:subClassOf bevon:Beverage,
                                        pto:Alcoholic_beverage;
                        owl:disjointWith bevon:NonAlcoholicBeverage;
                        status:term_status "testing"@en;
                        skos:definition """
     An alcoholic beverage is a drink and psychoactive drug containing
     ethyl alcohol which is commonly referred to as ethanol.
     """@en;
                        skos:prefLabel "알코올 음료"@ko,
                                       "Alcoholic Beverage"@en.
bevon:Ale dcterms:issued "2013-07-04+09:00"^^xsd:date;
          dcterms:modified "2014-03-01+09:00"^^xsd:date;
          a owl:Class;
          rdfs:comment """
    The yeast will ferment the beer quickly, giving it a sweet, full bodied and
    fruity taste.
    """@en;
          rdfs:isDefinedBy bevon:;
          rdfs:seeAlso wiki:Ale;
          rdfs:subClassOf bevon:Beer,
                          pto:Ale;
          status:term_status "unstable"@en;
          skos:definition """
    Ale is a type of beer brewed from malted barley using a warm-fermentation
    with a strain of brewers' yeast.
    """@en;
          skos:prefLabel "에일"@ko,
                         "Ale"@en.
bevon:AmericanWhiskey dcterms:issued "2013-07-04+09:00"^^xsd:date;
                      dcterms:modified "2014-03-01+09:00"^^xsd:date;
                      a owl:Class;
                      rdfs:comment """
    The production and labeling of American whiskey are governed by Title 27 of
    the U.S. Code of Federal Regulations.
    """@en;
                      rdfs:isDefinedBy bevon:;
                      rdfs:seeAlso wiki:American_whiskey;
                      rdfs:subClassOf pto:American_whiskey,
                                      bevon:Whisky;
                      status:term_status "unstable"@en;
                      skos:altLabel "American Whisky"@en;
                      skos:definition """
    American whiskey is a distilled beverage produced in the United States from
    a fermented mash of cereal grain.
    """@en;
                      skos:prefLabel "American Whiskey"@en,
                                     "아메리칸 위스키"@ko.
bevon:Beer dcterms:issued "2013-07-04+09:00"^^xsd:date;
           dcterms:modified "2014-03-01+09:00"^^xsd:date;
           a owl:Class;
           rdfs:comment """
    The starch and saccharification enzymes are often derived from malted
    cereal grains, most commonly malted barley and malted wheat.
    """@en;
           rdfs:isDefinedBy bevon:;
           rdfs:seeAlso wiki:Beer;
           rdfs:subClassOf bevon:FermentedBeverage,
                           pto:Beer;
           owl:disjointWith bevon:NonAlcoholicBeer;
           status:term_status "testing"@en;
           skos:definition """
    Beer is an alcoholic beverage produced by the saccharification of starch
    and fermentation of the resulting sugar.
    """@en;
           skos:prefLabel "맥주"@ko,
                          "Beer"@en.
bevon:BeerBottle dcterms:issued "2013-07-04+09:00"^^xsd:date;
                 dcterms:modified "2014-03-01+09:00"^^xsd:date;
                 a owl:Class;
                 rdfs:comment """
    Dark amber or brown glass greatly reduces UV light from spoiling the beer.
    However, lighter colored bottles are often used for marketing reasons.
    """@en;
                 rdfs:isDefinedBy bevon:;
                 rdfs:seeAlso wiki:Beer_bottle;
                 rdfs:subClassOf bevon:GlassBottle;
                 status:term_status "unstable"@en;
                 skos:definition """
    A beer bottle is a bottle made to contain beer, usually made of glass and
    come in various sizes, shapes and colors.
    """@en;
                 skos:prefLabel "맥주병"@ko,
                                "Beer Bottle"@en.
bevon:BeerCocktail dcterms:issued "2013-07-04+09:00"^^xsd:date;
                   dcterms:modified "2014-03-01+09:00"^^xsd:date;
                   a owl:Class;
                   rdfs:isDefinedBy bevon:;
                   rdfs:seeAlso wiki:Beer_cocktail;
                   rdfs:subClassOf bevon:Cocktail,
                                   pto:Beer_cocktail;
                   status:term_status "unstable"@en;
                   skos:definition """
    A beer cocktail is a cocktail that is made by mixing beer with a distilled
    beverage. In this type of cocktail, the primary ingredient is beer.
    """@en;
                   skos:prefLabel "Beer Cocktail"@en,
                                  "맥주 칵테일"@ko.
bevon:BeerGroup rdf:_1 bevon:Beer;
                rdf:_10 bevon:PaleLager;
                rdf:_11 bevon:Pilsner;
                rdf:_12 bevon:NonAlcoholicBeer;
                rdf:_13 bevon:Brewery;
                rdf:_14 bevon:BeerBottle;
                rdf:_15 bevon:Longneck;
                rdf:_16 bevon:BeerKeg;
                rdf:_17 bevon:ibu;
                rdf:_18 bevon:srm;
                rdf:_19 bevon:brewery;
                rdf:_2 bevon:Ale;
                rdf:_3 bevon:PaleAle;
                rdf:_4 bevon:IrishRedAle;
                rdf:_5 bevon:Porter;
                rdf:_6 bevon:Stout;
                rdf:_7 bevon:DryStout;
                rdf:_8 bevon:Lager;
                rdf:_9 bevon:Dunkel;
                a rdf:Bag;
                rdfs:comment """
    In addition to the BEVON core terms, there are a number of terms for use
    when describing beverages categorized under Beer.
    """@en;
                rdfs:label "Beer Terms"@en.
bevon:BeerKeg dcterms:issued "2013-07-04+09:00"^^xsd:date;
              dcterms:modified "2014-03-01+09:00"^^xsd:date;
              a owl:Class;
              rdfs:isDefinedBy bevon:;
              rdfs:subClassOf bevon:Keg;
              status:term_status "unstable"@en;
              skos:definition """
    Beer kegs are made of stainless steel, or less commonly, of aluminium.
    """@en;
              skos:prefLabel "맥주 케그"@ko,
                             "Beer Keg"@en.
bevon:Beverage dcterms:issued "2013-07-04+09:00"^^xsd:date;
               dcterms:modified "2014-03-01+09:00"^^xsd:date;
               a owl:Class;
               rdfs:isDefinedBy bevon:;
               rdfs:seeAlso wiki:Beverage;
               rdfs:subClassOf fowl:PotableLiquid,
                               pto:Drink,
                               food:Food;
               status:term_status "testing"@en;
               skos:altLabel "Drink"@en;
               skos:definition """
    A beverage, or drink, is a kind of liquid which is specifically prepared
    for human consumption.
    """@en;
               skos:prefLabel "음료"@ko,
                              "Beverage"@en.
bevon:BeverageCan dcterms:issued "2013-07-04+09:00"^^xsd:date;
                  dcterms:modified "2014-03-01+09:00"^^xsd:date;
                  a owl:Class;
                  rdfs:comment """
    Beverage cans are made of aluminium (75% of worldwide production) or
    tin-plated steel (25% worldwide production).
    """@en;
                  rdfs:isDefinedBy bevon:;
                  rdfs:seeAlso wiki:Beverage_can;
                  rdfs:subClassOf bevon:Container;
                  status:term_status "unstable"@en;
                  skos:definition """
    A beverage can is a metal container designed to hold a fixed portion of
    liquid such as a carbonated soft drinks, alcoholic beverages, fruit juices,
    teas, tisanes, energy drinks, etc.
    """@en;
                  skos:prefLabel "Beverage Can"@en,
                                 "음료 캔"@ko.
bevon:BourbonWhiskey dcterms:issued "2013-07-04+09:00"^^xsd:date;
                     dcterms:modified "2014-03-01+09:00"^^xsd:date;
                     a owl:Class;
                     rdfs:comment """
    The name of the spirit derives from its historical association with an area
    known as Old Bourbon, around what is now Bourbon County, Kentucky (which,
    in turn, was named after the French House of Bourbon royal family). It has
    been produced since the 18th century. While it may be made anywhere in the
    United States, it is strongly associated with the American South in
    general, and Kentucky in particular.
    """@en;
                     rdfs:isDefinedBy bevon:;
                     rdfs:seeAlso wiki:Bourbon_whiskey;
                     rdfs:subClassOf bevon:AmericanWhisky,
                                     pto:Bourbon_whiskey;
                     status:term_status "unstable"@en;
                     skos:altLabel "Bourbon Whisky"@en;
                     skos:definition """
    Bourbon whiskey is a type of American whiskey – a barrel-aged distilled
    spirit made primarily from corn.
    """@en;
                     skos:prefLabel "버번 위스키"@ko,
                                    "Bourbon Whiskey"@en.
bevon:Brandy dcterms:issued "2013-07-04+09:00"^^xsd:date;
             dcterms:modified "2014-03-01+09:00"^^xsd:date;
             a owl:Class;
             rdfs:comment """
    Brandy generally contains 35–60% alcohol by volume (70–120 US proof) and is
    typically taken as an after-dinner drink. Some brandies are aged in wooden
    casks, some are colored with caramel coloring to imitate the effect of
    aging, and some brandies are produced using a combination of both aging and
    coloring.
    """@en;
             rdfs:isDefinedBy bevon:;
             rdfs:seeAlso wiki:Brandy;
             rdfs:subClassOf pto:Brandy,
                             bevon:DistilledBeverage;
             status:term_status "testing"@en;
             skos:definition """
    Brandy (from brandywine, derived from Dutch brandewijn—\"burnt wine\") is a
    spirit produced by distilling wine.
    """@en;
             skos:prefLabel "Brandy"@en,
                            "브랜디"@ko.
bevon:Brewery dcterms:issued "2013-07-04+09:00"^^xsd:date;
              dcterms:modified "2014-03-01+09:00"^^xsd:date;
              a owl:Class;
              rdfs:comment """
    A company that makes beer is called either a brewery or a brewing company.
    """@en;
              rdfs:isDefinedBy bevon:;
              rdfs:seeAlso wiki:Brewery;
              status:term_status "unstable"@en;
              skos:definition """
    A brewery is a dedicated building for the making of beer, though beer can
    be made at home, and has been for much of beer's history.
    """@en;
              skos:prefLabel "양조장"@ko,
                             "Brewery"@en.
bevon:CanadianWhisky dcterms:issued "2013-07-04+09:00"^^xsd:date;
                     dcterms:modified "2014-03-01+09:00"^^xsd:date;
                     a owl:Class;
                     rdfs:comment """
    Most Canadian whiskies are blended multi-grain liquors containing a large
    percentage of corn spirits, and are typically lighter and smoother than
    other whisky styles.
    """@en;
                     rdfs:isDefinedBy bevon:;
                     rdfs:seeAlso wiki:Canadian_whisky;
                     rdfs:subClassOf bevon:Whisky,
                                     pto:Canadian_whisky;
                     status:term_status "unstable"@en;
                     skos:altLabel "Canadian Whiskey"@en;
                     skos:definition """
    Canadian whisky is a type of whisky produced in Canada.
    """@en;
                     skos:prefLabel "캐내디언 위스키"@ko,
                                    "Canadian Whisky"@en.
bevon:CarbonatedWater dcterms:issued "2013-07-04+09:00"^^xsd:date;
                      dcterms:modified "2014-03-01+09:00"^^xsd:date;
                      a owl:Class;
                      rdfs:isDefinedBy bevon:;
                      rdfs:seeAlso wiki:Carbonated_water;
                      rdfs:subClassOf bevon:Water,
                                      pto:Carbonated_water;
                      status:term_status "unstable"@en;
                      skos:altLabel "소다수"@ko,
                                    "클럽소다"@ko,
                                    "Seltzer Water"@en,
                                    "Soda Water"@en,
                                    "Sparkling Water"@en,
                                    "Fizzy Water"@en,
                                    "Club Soda"@en;
                      skos:definition """
    Carbonated water is water into which carbon dioxide gas under pressure has
    been dissolved.
    """@en;
                      skos:prefLabel "Carbonated Water"@en,
                                     "탄산수"@ko.
bevon:Cocktail dcterms:issued "2013-07-04+09:00"^^xsd:date;
               dcterms:modified "2014-03-01+09:00"^^xsd:date;
               a owl:Class;
               rdfs:comment """
    Cocktails were originally a mixture of spirits, sugar, water, and bitters.
    It is now often used for almost any mixed drink that contains alcohol,
    including mixers, mixed shots, etc. A cocktail today usually contains one
    or more kinds of spirit and one or more mixers, such as soda or fruit
    juice. Additional ingredients may be sugar, honey, milk, cream, and various
    herbs.
    """@en;
               rdfs:isDefinedBy bevon:;
               rdfs:seeAlso wiki:Cocktail;
               rdfs:subClassOf bevon:MixedDrink,
                               pto:Cocktail,
                               bevon:AlcoholicBeverage;
               owl:disjointWith bevon:Mocktail;
               status:term_status "unstable"@en;
               skos:definition """
    A cocktail is a mixed drink that contains alcohol, including mixers, mixed
    shots, etc.
    """@en;
               skos:prefLabel "칵테일"@ko,
                              "Cocktail"@en.
bevon:CocktailGroup rdf:_1 bevon:Cocktail;
                    rdf:_2 bevon:Highball;
                    rdf:_3 bevon:BeerCocktail;
                    rdf:_4 bevon:Shandy;
                    rdf:_5 bevon:Mocktail;
                    a rdf:Bag;
                    rdfs:comment """
    These classes and properties are for describing beverages categorized under
    Mixed Drink.
    """@en;
                    rdfs:label "Cocktail Terms"@en.
bevon:Cognac dcterms:issued "2013-07-04+09:00"^^xsd:date;
             dcterms:modified "2014-03-01+09:00"^^xsd:date;
             a owl:Class;
             rdfs:comment """
    It is produced in the wine-growing region surrounding the town from which
    it takes its name, in the French Departements of Charente and
    Charente-Maritime.
    """@en;
             rdfs:isDefinedBy bevon:;
             rdfs:seeAlso wiki:Cognac;
             rdfs:subClassOf bevon:Brandy,
                             pto:Cognac;
             status:term_status "testing"@en;
             skos:definition """
    Cognac, named after the town of Cognac in France, is a variety of brandy.
    """@en;
             skos:prefLabel "코냑"@ko,
                            "Cognac"@en.
bevon:Container dcterms:issued "2013-07-04+09:00"^^xsd:date;
                dcterms:modified "2014-03-01+09:00"^^xsd:date;
                a owl:Class;
                rdfs:isDefinedBy bevon:;
                rdfs:seeAlso wiki:Container;
                rdfs:subClassOf dbyago:Containers;
                status:term_status "unstable"@en;
                skos:definition """
    A container is an item used to contain, store, and transport a beverage.
    """@en;
                skos:prefLabel "Container"@en,
                               "용기"@ko.
bevon:ContainerGroup rdf:_1 bevon:Container;
                     rdf:_2 bevon:BeverageCan;
                     rdf:_3 bevon:GlassBottle;
                     rdf:_4 bevon:PlasticBottle;
                     rdf:_5 bevon:Keg;
                     rdf:_6 bevon:volume;
                     a rdf:Bag;
                     rdfs:comment """
    These classes and properties are used to describe beverage containers.
    """@en;
                     rdfs:label "Container Terms"@en.
bevon:CoreGroup rdf:_1 bevon:Beverage;
                rdf:_10 bevon:Distillery;
                rdf:_11 bevon:name;
                rdf:_12 bevon:description;
                rdf:_13 bevon:origin;
                rdf:_14 bevon:manufacturer;
                rdf:_15 bevon:color;
                rdf:_16 bevon:launch;
                rdf:_17 bevon:abv;
                rdf:_18 bevon:proof;
                rdf:_19 bevon:container;
                rdf:_2 bevon:AlcoholicBeverage;
                rdf:_20 bevon:aging;
                rdf:_21 bevon:fermentation_base;
                rdf:_22 bevon:distillery;
                rdf:_23 bevon:ingredient;
                rdf:_3 bevon:FermentedBeverage;
                rdf:_4 bevon:DistilledBeverage;
                rdf:_5 bevon:NonAlcoholicBeverage;
                rdf:_6 bevon:MixedDrink;
                rdf:_7 bevon:Container;
                rdf:_8 bevon:Aging;
                rdf:_9 bevon:FermentationBase;
                a rdf:Bag;
                rdfs:comment """
    These classes and properties form the core of BEVON. They describe
    characteristics of beverages in relatively broad terms.
    """@en;
                rdfs:label "Core Terms"@en.
bevon:DilutedSoju dcterms:issued "2013-07-04+09:00"^^xsd:date;
                  dcterms:modified "2014-03-01+09:00"^^xsd:date;
                  a owl:Class;
                  rdfs:isDefinedBy bevon:;
                  rdfs:subClassOf bevon:Soju;
                  owl:disjointWith bevon:DistilledSoju;
                  status:term_status "unstable"@en;
                  skos:definition """
    Diluted Soju is made by mixing pure ethanol distilled from various grains,
    such as potatoes, wheat, barley, sweet potatoes, or tapioca, with water and
    flavoring.
    """@en;
                  skos:prefLabel "Diluted Soju"@en,
                                 "희석식 소주"@ko.
bevon:DistilledBeverage dcterms:issued "2013-07-04+09:00"^^xsd:date;
                        dcterms:modified "2014-03-01+09:00"^^xsd:date;
                        a owl:Class;
                        rdfs:comment """
     This excludes undistilled fermented beverages such as beer, wine, and
     cider.
     """@en;
                        rdfs:isDefinedBy bevon:;
                        rdfs:seeAlso wiki:Distilled_beverage;
                        rdfs:subClassOf pto:Distilled_beverage,
                                        bevon:AlcoholicBeverage;
                        status:term_status "testing"@en;
                        skos:altLabel "Spirit"@en,
                                      "Liquor"@en;
                        skos:definition """
     A distilled beverage, spirit, or liquor is an alcoholic beverage
     containing ethanol that is produced by distilling (i.e., concentrating
     by distillation) ethanol produced by means of fermenting grain, fruit,
     or vegetables.
     """@en;
                        skos:prefLabel "증류주"@ko,
                                       "Distilled Beverage"@en.
bevon:DistilledSoju dcterms:issued "2013-07-04+09:00"^^xsd:date;
                    dcterms:modified "2014-03-01+09:00"^^xsd:date;
                    a owl:Class;
                    rdfs:isDefinedBy bevon:;
                    rdfs:subClassOf bevon:Soju;
                    owl:disjointWith bevon:DilutedSoju;
                    status:term_status "unstable"@en;
                    skos:definition """
    Distilled Soju is manufactured traditionally by distillation from grains,
    mainly rice.
    """@en;
                    skos:prefLabel "증류식 소주"@ko,
                                   "Distilled Soju"@en.
bevon:Distillery dcterms:issued "2013-07-04+09:00"^^xsd:date;
                 dcterms:modified "2014-03-01+09:00"^^xsd:date;
                 a owl:Class;
                 rdfs:isDefinedBy bevon:;
                 rdfs:seeAlso wiki:Distillation;
                 status:term_status "unstable"@en;
                 skos:definition """
    A distillery is a premise where distillation takes place, especially
    distillation of alcohol.
    """@en;
                 skos:prefLabel "증류소"@ko,
                                "Distillery"@en.
bevon:DryStout dcterms:issued "2013-07-04+09:00"^^xsd:date;
               dcterms:modified "2014-03-01+09:00"^^xsd:date;
               a owl:Class;
               rdfs:isDefinedBy bevon:;
               rdfs:subClassOf bevon:Stout;
               status:term_status "unstable"@en;
               skos:altLabel "Irish Stout"@en;
               skos:definition """
    Irish stout or dry stout is very dark or rich in color and it often has a
    \"roasted\" or coffee-like taste.
    """@en;
               skos:prefLabel "Dry Stout"@en,
                              "드라이 스타우트"@ko.
bevon:Dunkel dcterms:issued "2013-07-04+09:00"^^xsd:date;
             dcterms:modified "2014-03-01+09:00"^^xsd:date;
             a owl:Class;
             rdfs:comment """
    Dunkel is the German word meaning dark, and dunkel beers typically range in
    color from amber to dark reddish brown. They are characterized by their
    smooth malty flavor.
    """@en;
             rdfs:isDefinedBy bevon:;
             rdfs:seeAlso wikipedia:Dunkel;
             rdfs:subClassOf pto:Dunkel,
                             bevon:Lager;
             status:term_status "unstable"@en;
             skos:altLabel "Dunkles"@en;
             skos:definition """
    Dunkel, or Dunkles, is a word used for several types of dark German lager.
    """@en;
             skos:prefLabel "둔켈"@ko,
                            "Dunkel"@en.
bevon:FermentationBase dcterms:issued "2013-07-04+09:00"^^xsd:date;
                       dcterms:modified "2014-03-01+09:00"^^xsd:date;
                       a owl:Class;
                       rdfs:isDefinedBy bevon:;
                       status:term_status "unstable"@en;
                       skos:definition """
    A fruit or grain which provides the sugar for fermentation from which a
    alcoholic beverage is made.
    """@en;
                       skos:prefLabel "발효 주재료"@ko,
                                      "Fermentation Base"@en.
bevon:FermentedBeverage dcterms:issued "2013-07-04+09:00"^^xsd:date;
                        dcterms:modified "2014-03-01+09:00"^^xsd:date;
                        a owl:Class;
                        rdfs:isDefinedBy bevon:;
                        rdfs:subClassOf bevon:AlcoholicBeverage;
                        status:term_status "testing"@en;
                        skos:altLabel "발효주"@ko;
                        skos:definition """
    A fermented beverage is a drink produced by fermenting grain, fruit, or
    vegetables.
    """@en;
                        skos:prefLabel "양조주"@ko,
                                       "Fermented Beverage"@en.
bevon:FruitWine dcterms:issued "2014-03-07+09:00"^^xsd:date;
                dcterms:modified "2014-03-07+09:00"^^xsd:date;
                a owl:Class;
                rdfs:comment """
    This definition is sometimes broadened to include any fermented alcoholic
    beverage except beer. For historical reasons, mead, cider, and perry are
    also excluded from the definition of fruit wine.
    """@en;
                rdfs:isDefinedBy bevon:;
                rdfs:seeAlso wiki:Fruit_wine;
                rdfs:subClassOf pto:Fruit_wine,
                                bevon:Wine;
                status:term_status "testing"@en;
                skos:definition """
    Fruit wines are fermented alcoholic beverages made from a variety of base
    ingredients (other than grapes); they may also have additional flavors
    taken from fruits, flowers, and herbs.
    """@en;
                skos:prefLabel "Fruit Wine"@en,
                               "과실주"@ko,
                               "Vin de Sureau"@fr.
bevon:Gin dcterms:issued "2013-07-04+09:00"^^xsd:date;
          dcterms:modified "2014-03-01+09:00"^^xsd:date;
          a owl:Class;
          rdfs:isDefinedBy bevon:;
          rdfs:seeAlso wiki:Gin;
          rdfs:subClassOf bevon:DistilledBeverage,
                          pto:Gin;
          status:term_status "testing"@en;
          skos:definition """
    Gin is a spirit which derives its predominant flavor from juniper berries
    (Juniperus communis).
    """@en;
          skos:prefLabel "진"@ko,
                         "Gin"@en.
bevon:GlassBottle dcterms:issued "2013-07-04+09:00"^^xsd:date;
                  dcterms:modified "2014-03-01+09:00"^^xsd:date;
                  a owl:Class;
                  rdfs:comment """
    Glass bottles can vary in size considerably, but are most commonly found in
    sizes ranging between about 10ml and 5 litres.
    """@en;
                  rdfs:isDefinedBy bevon:;
                  rdfs:seeAlso wiki:Glass_bottle;
                  rdfs:subClassOf bevon:Container;
                  status:term_status "unstable"@en;
                  skos:definition """
    A glass bottle is a bottle created from glass.
    """@en;
                  skos:prefLabel "Glass Bottle"@en,
                                 "유리병"@ko.
bevon:Highball dcterms:issued "2013-07-04+09:00"^^xsd:date;
               dcterms:modified "2014-03-01+09:00"^^xsd:date;
               a owl:Class;
               rdfs:isDefinedBy bevon:;
               rdfs:seeAlso wiki:Highball;
               rdfs:subClassOf bevon:Cocktail,
                               pto:Highball;
               status:term_status "unstable"@en;
               skos:definition """
    Highball is the name for a family of mixed drinks that are composed of an
    alcoholic base spirit and a larger proportion of a non-alcoholic mixer.
    """@en;
               skos:prefLabel "하이볼"@ko,
                              "Highball"@en.
bevon:IrishRedAle dcterms:issued "2013-07-04+09:00"^^xsd:date;
                  dcterms:modified "2014-03-01+09:00"^^xsd:date;
                  a owl:Class;
                  rdfs:isDefinedBy bevon:;
                  rdfs:seeAlso wiki:Irish_red_ale;
                  rdfs:subClassOf bevon:PaleAle;
                  status:term_status "unstable"@en;
                  skos:definition """
    Irish red ale, red ale, or Irish ale is a name used by brewers in Ireland.
    """@en;
                  skos:prefLabel "Irish Red Ale"@en,
                                 "아이리쉬 레드 에일"@ko.
bevon:IrishWhiskey dcterms:issued "2013-07-04+09:00"^^xsd:date;
                   dcterms:modified "2014-03-01+09:00"^^xsd:date;
                   a owl:Class;
                   rdfs:comment """
    Key regulations defining Irish whiskey and its production are established
    by the Irish Whiskey Act of 1980.
    """@en;
                   rdfs:isDefinedBy bevon:;
                   rdfs:seeAlso wiki:Irish_whiskey;
                   rdfs:subClassOf pto:Irish_whiskey,
                                   bevon:Whisky;
                   status:term_status "unstable"@en;
                   skos:altLabel "Irish Whisky"@en;
                   skos:definition """
    Irish whiskey is whisky made in Ireland.
    """@en;
                   skos:prefLabel "Irish Whiskey"@en,
                                  "아이리쉬 위스키"@ko,
                                  "Fuisce"@ga.
bevon:JapaneseWhisky dcterms:issued "2013-07-04+09:00"^^xsd:date;
                     dcterms:modified "2014-03-01+09:00"^^xsd:date;
                     a owl:Class;
                     rdfs:comment """
    Whisky production in Japan began around 1870, but the first commercial
    production was in 1924 upon the opening of the country's first distillery,
    Yamazaki. Broadly speaking the style of Japanese whisky is more similar to
    that of Scotch whisky than Irish, American, or Canadian styles of whisky,
    and thus the spelling typically follows the Scottish convention (omitting
    the letter \"e\").
    """@en;
                     rdfs:isDefinedBy bevon:;
                     rdfs:seeAlso wiki:Japanese_whisky;
                     rdfs:subClassOf pto:Japanese_whisky,
                                     bevon:Whisky;
                     status:term_status "unstable"@en;
                     skos:altLabel "Japanese Whiskey"@en;
                     skos:definition """
    Japanese whisky is whisky made in Japan.
    """@en;
                     skos:prefLabel "재패니즈 위스키"@ko,
                                    "Japanese Whisky"@en.
bevon:Keg dcterms:issued "2013-07-04+09:00"^^xsd:date;
          dcterms:modified "2014-03-01+09:00"^^xsd:date;
          a owl:Class;
          rdfs:isDefinedBy bevon:;
          rdfs:seeAlso wiki:Keg;
          rdfs:subClassOf bevon:Container;
          status:term_status "unstable"@en;
          skos:definition """
    A keg is a small barrel.
    """@en;
          skos:prefLabel "Keg"@en,
                         "케그"@ko.
bevon:Lager dcterms:issued "2013-07-04+09:00"^^xsd:date;
            dcterms:modified "2014-03-01+09:00"^^xsd:date;
            a owl:Class;
            rdfs:isDefinedBy bevon:;
            rdfs:seeAlso wiki:Lager;
            rdfs:subClassOf bevon:Beer,
                            pto:Lager;
            status:term_status "unstable"@en;
            skos:definition """
    Lager is a type of beer that is fermented and conditioned at low
    temperatures.
    """@en;
            skos:prefLabel "Lager"@en,
                           "라거"@ko.
bevon:Liqueur dcterms:issued "2013-07-04+09:00"^^xsd:date;
              dcterms:modified "2014-03-01+09:00"^^xsd:date;
              a owl:Class;
              rdfs:comment """
    Liqueurs are typically quite sweet; they are usually not aged for long
    after the ingredients are mixed, but may have resting periods during their
    production to allow flavors to marry.
    """@en;
              rdfs:isDefinedBy bevon:;
              rdfs:seeAlso wiki:Liqueur;
              rdfs:subClassOf pto:Liqueur,
                              bevon:DistilledBeverage;
              status:term_status "testing"@en;
              skos:altLabel "Cordials"@en,
                            "Schnapps"@en;
              skos:definition """
    A liqueur is an alcoholic beverage made from a distilled spirit that has
    been flavored with fruit, cream, herbs, spices, flowers or nuts and bottled
    with added sugar or other sweetener (such as high-fructose corn syrup).
    """@en;
              skos:prefLabel "리큐어"@ko,
                             "Liqueur"@en.
bevon:Longneck dcterms:issued "2013-07-04+09:00"^^xsd:date;
               dcterms:modified "2014-03-01+09:00"^^xsd:date;
               a owl:Class;
               rdfs:comment """
    It is known as the standard longneck bottle or industry standard bottle
    (ISB). The ISB longnecks have a uniform capacity, height, weight and
    diameter and can be reused on average 16 times. The long neck offers a long
    cushion of air to absorb the pressure of carbonation to reduce the risk of
    exploding. The longneck also provides a handle for drinking directly from
    the bottle without transferring body heat to the beer from one's hand.
    """@en;
               rdfs:isDefinedBy bevon:;
               rdfs:subClassOf bevon:BeerBottle;
               status:term_status "unstable"@en;
               skos:altLabel "North American Longneck"@en,
                             "Industry Standard Bottle"@en;
               skos:definition """
    A longneck is a type of beer bottle with a long neck.
    """@en;
               skos:prefLabel "긴목 맥주병"@ko,
                              "Longneck"@en.
bevon:MaltWhisky dcterms:issued "2013-07-04+09:00"^^xsd:date;
                 dcterms:modified "2014-03-01+09:00"^^xsd:date;
                 a owl:Class;
                 rdfs:isDefinedBy bevon:;
                 rdfs:seeAlso wiki:Malt_whisky;
                 rdfs:subClassOf bevon:Whisky,
                                 pto:Malt_whisky;
                 status:term_status "unstable"@en;
                 skos:altLabel "Malt Whiskey"@en;
                 skos:definition """
    Malt whisky is whisky that is made from a fermented mash produced primarily
    from a malted grain.
    """@en;
                 skos:prefLabel "Malt Whisky"@en,
                                "몰트 위스키"@ko.
bevon:MineralWater dcterms:issued "2013-07-04+09:00"^^xsd:date;
                   dcterms:modified "2014-03-01+09:00"^^xsd:date;
                   a owl:Class;
                   rdfs:comment """
    Mineral water may be sparkling due to contained gases.
    """@en;
                   rdfs:isDefinedBy bevon:;
                   rdfs:seeAlso wiki:Mineral_water;
                   rdfs:subClassOf bevon:Water,
                                   pto:Mineral_water;
                   status:term_status "unstable"@en;
                   skos:definition """
    Mineral water is water from a mineral spring containing various minerals
    such as salts and sulfur compounds.
    """@en;
                   skos:prefLabel "광천수"@ko,
                                  "Mineral Water"@en.
bevon:MixedDrink dcterms:issued "2013-07-04+09:00"^^xsd:date;
                 dcterms:modified "2014-03-01+09:00"^^xsd:date;
                 a owl:Class;
                 rdfs:comment """
    Some mixed drinks are alcoholic beverages that contain liquor; others are
    non-alcoholic.
    """@en;
                 rdfs:isDefinedBy bevon:;
                 rdfs:seeAlso wiki:Mixed_drink;
                 rdfs:subClassOf pto:Mixed_drink,
                                 bevon:Beverage;
                 status:term_status "testing"@en;
                 skos:definition """
    A mixed drink is a beverage in which two or more ingredients are mixed.
    """@en;
                 skos:prefLabel "혼합 음료"@ko,
                                "Mixed Drink"@en.
bevon:Mocktail dcterms:issued "2013-07-04+09:00"^^xsd:date;
               dcterms:modified "2014-03-01+09:00"^^xsd:date;
               a owl:Class;
               rdfs:isDefinedBy bevon:;
               rdfs:subClassOf bevon:MixedDrink,
                               bevon:NonAlcoholicBeverage;
               owl:disjointWith bevon:Cocktail;
               status:term_status "unstable"@en;
               skos:definition """
    Mocktails are mock cocktails, or those that do not contain any alcohol.
    """@en;
               skos:prefLabel "목테일"@ko,
                              "Mocktail"@en.
bevon:NonAlcoholicBeer dcterms:issued "2013-07-04+09:00"^^xsd:date;
                       dcterms:modified "2014-03-01+09:00"^^xsd:date;
                       a owl:Class;
                       rdfs:isDefinedBy bevon:;
                       rdfs:seeAlso wiki:Low-alcohol_beer;
                       rdfs:subClassOf pto:Low-alcohol_beer,
                                       bevon:NonAlcoholicBeverage;
                       owl:disjointWith bevon:Beer;
                       status:term_status "unstable"@en;
                       skos:altLabel "Low-alcoholic Beer"@en;
                       skos:definition """
    Non-alcohol beer (also called light beer, low-alcoholic beer, small beer,
    small ale, or near-beer) is beer with low alcohol content or no alcohol,
    which aim to reproduce the taste of beer without the inebriating effects of
    standard alcoholic brews.
    """@en;
                       skos:prefLabel "Non-alcoholic Beer"@en,
                                      "비알코올 맥주"@ko.
bevon:NonAlcoholicBeverage dcterms:issued "2013-07-04+09:00"^^xsd:date;
                           dcterms:modified "2014-03-01+09:00"^^xsd:date;
                           a owl:Class;
                           rdfs:isDefinedBy bevon:;
                           rdfs:seeAlso wiki:Non-alcoholic_beverage;
                           rdfs:subClassOf bevon:Beverage,
                                           pto:Non-alcoholic_beverage;
                           owl:disjointWith bevon:AlcoholicBeverage;
                           status:term_status "testing"@en;
                           skos:definition """
     A non-alcoholic beverage (also known as a virgin drink) is defined
     in the U.S. as a beverage that contains less than 0.5% alcohol by volume.
     """@en;
                           skos:prefLabel "Non-alcoholic Beverage"@en,
                                          "비알코올 음료"@ko.
bevon:PaleAle dcterms:issued "2013-07-04+09:00"^^xsd:date;
              dcterms:modified "2014-03-01+09:00"^^xsd:date;
              a owl:Class;
              rdfs:comment """
    It is one of the world's major beer styles.
    """@en;
              rdfs:isDefinedBy bevon:;
              rdfs:seeAlso wiki:Pale_ale;
              rdfs:subClassOf bevon:Ale,
                              pto:Pale_ale;
              status:term_status "unstable"@en;
              skos:definition """
    Pale ale is a beer made by warm fermentation using predominantly pale malt.
    """@en;
              skos:prefLabel "Pale Ale"@en,
                             "페일 에일"@ko.
bevon:PaleLager dcterms:issued "2013-07-04+09:00"^^xsd:date;
                dcterms:modified "2014-03-01+09:00"^^xsd:date;
                a owl:Class;
                rdfs:isDefinedBy bevon:;
                rdfs:seeAlso wiki:Pale_lager;
                rdfs:subClassOf bevon:Lager,
                                pto:Pale_lager;
                status:term_status "unstable"@en;
                skos:definition """
    Pale lager is a very pale to golden-colored beer with a well attenuated
    body and a varying degree of noble hop bitterness.
    """@en;
                skos:prefLabel "페일 라거"@ko,
                               "Pale Lager"@en.
bevon:Pilsner dcterms:issued "2013-07-04+09:00"^^xsd:date;
              dcterms:modified "2014-03-01+09:00"^^xsd:date;
              a owl:Class;
              rdfs:comment """
    It took its name from the city of Pilsen (Plzeň, Bohemia, Czech Republic,
    where it was first produced in 1842).
    """@en;
              rdfs:isDefinedBy bevon:;
              rdfs:seeAlso wiki:Pilsner;
              rdfs:subClassOf pto:Pilsner,
                              bevon:PaleLager;
              status:term_status "unstable"@en;
              skos:altLabel "Pilsener"@en,
                            "Pils"@en;
              skos:definition """
    Pilsner (also pilsener or simply pils) is a type of pale lager.
    """@en;
              skos:prefLabel "필스너"@ko,
                             "Pilsner"@en.
bevon:Pisco dcterms:issued "2013-07-04+09:00"^^xsd:date;
            dcterms:modified "2014-03-01+09:00"^^xsd:date;
            a owl:Class;
            rdfs:isDefinedBy bevon:;
            rdfs:seeAlso wiki:Pisco;
            rdfs:subClassOf pto:Pisco,
                            bevon:Brandy;
            status:term_status "testing"@en;
            skos:definition """
    Pisco is a colorless or yellowish-to-amber colored grape brandy produced
    in winemaking regions of Peru and Chile.
    """@en;
            skos:prefLabel "Pisco"@en,
                           "피스코"@ko.
bevon:PlasticBottle dcterms:issued "2013-07-04+09:00"^^xsd:date;
                    dcterms:modified "2014-03-01+09:00"^^xsd:date;
                    a owl:Class;
                    rdfs:comment """
    Plastic bottles are typically used to store liquids such as water, soft
    drinks, motor oil, cooking oil, medicine, shampoo, milk, and ink.
    """@en;
                    rdfs:isDefinedBy bevon:;
                    rdfs:seeAlso wiki:Plastic_bottle;
                    rdfs:subClassOf bevon:Container;
                    status:term_status "unstable"@en;
                    skos:definition """
    A plastic bottle is a bottle constructed of plastic.
    """@en;
                    skos:prefLabel "Plastic Bottle"@en,
                                   "플라스틱 병"@ko.
bevon:Porter dcterms:issued "2013-07-04+09:00"^^xsd:date;
             dcterms:modified "2014-03-01+09:00"^^xsd:date;
             a owl:Class;
             rdfs:comment """
    The name came about as a result of its popularity with street and river
    porters.
    """@en;
             rdfs:isDefinedBy bevon:;
             rdfs:seeAlso wiki:English_porter;
             rdfs:subClassOf pto:English_porter,
                             bevon:Ale;
             status:term_status "unstable"@en;
             skos:altLabel "English Porter"@en;
             skos:definition """
    Porter is a dark style of beer originating in London in the 18th century,
    descended from brown beer, a well hopped beer made from brown malt.
    """@en;
             skos:prefLabel "Porter"@en,
                            "포터"@ko.
bevon:RedWine dcterms:issued "2014-03-07+09:00"^^xsd:date;
              dcterms:modified "2014-03-07+09:00"^^xsd:date;
              a owl:Class;
              rdfs:comment """
    The actual colour of the wine can range from intense violet, typical of
    young wines, through to brick red for mature wines and brown for older red
    wines.
    """@en;
              rdfs:isDefinedBy bevon:;
              rdfs:seeAlso wiki:Red_wine;
              rdfs:subClassOf bevon:Wine,
                              pto:Red_wine;
              owl:sameAs vin:RedWine;
              status:term_status "testing"@en;
              skos:definition """
    Red wine is a type of wine made from dark-coloured (black) grape varieties.
    """@en;
              skos:prefLabel "Vin Rouge"@fr,
                             "Red Wine"@en,
                             "레드 와인"@ko.
bevon:RelationGroup rdf:_1 bevon:related;
                    rdf:_2 bevon:similar;
                    rdf:_3 bevon:variant;
                    rdf:_4 bevon:variantOf;
                    rdf:_5 bevon:non_alcoholic_version;
                    a rdf:Bag;
                    rdfs:comment """
    These properties are used for describing relations between beverages.
    """@en;
                    rdfs:label "Relation Terms"@en.
bevon:Rum dcterms:issued "2013-07-04+09:00"^^xsd:date;
          dcterms:modified "2014-03-01+09:00"^^xsd:date;
          a owl:Class;
          rdfs:comment """
    The distillate, a clear liquid, is then usually aged in
    oak barrels.
    """@en;
          rdfs:isDefinedBy bevon:;
          rdfs:seeAlso wiki:Rum;
          rdfs:subClassOf bevon:DistilledBeverage,
                          pto:Rum;
          status:term_status "testing"@en;
          skos:definition """
    Rum is a distilled alcoholic beverage made from sugarcane byproducts, such
    as molasses, or directly from sugarcane juice, by a process of fermentation
    and distillation.
    """@en;
          skos:prefLabel "Ron"@es,
                         "Rum"@en,
                         "럼"@ko.
bevon:Sake dcterms:issued "2013-07-04+09:00"^^xsd:date;
           dcterms:modified "2014-03-01+09:00"^^xsd:date;
           a owl:Class;
           rdfs:isDefinedBy bevon:;
           rdfs:seeAlso wiki:Sake;
           rdfs:subClassOf bevon:FermentedBeverage,
                           pto:Sake;
           status:term_status "testing"@en;
           skos:altLabel "Rice Wine"@en;
           skos:definition """
    Sake or saké is an alcoholic beverage of Japanese origin that is made from
    fermented rice.
    """@en;
           skos:prefLabel "사케"@ko,
                          "Sake"@en,
                          "Saké"@fr.
bevon:ScotchWhisky dcterms:issued "2013-07-04+09:00"^^xsd:date;
                   dcterms:modified "2014-03-01+09:00"^^xsd:date;
                   a owl:Class;
                   rdfs:comment """
    All Scotch whisky was originally made from malt barley. Commercial
    distilleries began introducing whisky made from wheat and rye in the late
    eighteenth century.
    """@en;
                   rdfs:isDefinedBy bevon:;
                   rdfs:seeAlso wiki:Scotch_whisky;
                   rdfs:subClassOf bevon:Whisky,
                                   pto:Scotch_whisky;
                   status:term_status "unstable"@en;
                   skos:altLabel "Scotch Whiskey"@en;
                   skos:definition """
    Scotch whisky (often referred to simply as \"Scotch\") is malt whisky or grain
    whisky made in Scotland.
    """@en;
                   skos:prefLabel "Scotch Whisky"@en,
                                  "스카치 위스키"@ko.
bevon:Shandy dcterms:issued "2013-07-04+09:00"^^xsd:date;
             dcterms:modified "2014-03-01+09:00"^^xsd:date;
             a owl:Class;
             rdfs:comment """
    The proportions of the two ingredients are adjusted to taste, usually
    half-and-half.
    """@en;
             rdfs:isDefinedBy bevon:;
             rdfs:seeAlso wiki:Shandy;
             rdfs:subClassOf pto:Shandy,
                             bevon:Cocktail;
             status:term_status "unstable"@en;
             skos:definition """
    A shandy, or shandygaff, is beer mixed with a soft drink, carbonated
    lemonade, ginger beer, ginger ale, or apple juice.
    """@en;
             skos:prefLabel "Shandy"@en,
                            "섄디"@ko.
bevon:SingleMaltScotch dcterms:issued "2013-07-04+09:00"^^xsd:date;
                       dcterms:modified "2014-03-01+09:00"^^xsd:date;
                       a owl:Class;
                       rdfs:comment """
    As with any Scotch whisky, a single malt Scotch must be distilled in
    Scotland and matured in oak casks in Scotland for at least three years
    (most single malts are matured longer).
    """@en;
                       rdfs:isDefinedBy bevon:;
                       rdfs:seeAlso wiki:Single_malt_Scotch;
                       rdfs:subClassOf bevon:ScotchWhisky,
                                       pto:Single_malt_Scotch,
                                       bevon:SingleMaltWhisky;
                       status:term_status "unstable"@en;
                       skos:definition """
    Single Malt Scotch is single malt whisky made in Scotland using a pot still
    distillation process at a single distillery, with malted barley as the only
    grain ingredient.
    """@en;
                       skos:prefLabel "Single Malt Scotch"@en,
                                      "싱글 몰트 스카치"@ko.
bevon:SingleMaltWhisky dcterms:issued "2013-07-04+09:00"^^xsd:date;
                       dcterms:modified "2014-03-01+09:00"^^xsd:date;
                       a owl:Class;
                       rdfs:isDefinedBy bevon:;
                       rdfs:seeAlso wiki:Single_malt_whisky;
                       rdfs:subClassOf pto:Single_malt_whisky,
                                       bevon:MaltWhisky;
                       status:term_status "unstable"@en;
                       skos:altLabel "Single Malt Whiskey"@en;
                       skos:definition """
    Single malt whisky is a whisky made at one particular distillery from a
    mash that uses only malted grain, ordinarily barley.
    """@en;
                       skos:prefLabel "싱글 몰트 위스키"@ko,
                                      "Single Malt Whisky"@en.
bevon:Soju dcterms:issued "2013-07-04+09:00"^^xsd:date;
           dcterms:modified "2014-03-01+09:00"^^xsd:date;
           a owl:Class;
           rdfs:comment """
    Its taste is comparable to vodka, though often slightly sweeter due to
    sugars added in the manufacturing process.
    """@en;
           rdfs:isDefinedBy bevon:;
           rdfs:seeAlso wiki:Soju;
           rdfs:subClassOf pto:Soju,
                           bevon:DistilledBeverage;
           status:term_status "testing"@en;
           skos:definition """
    Soju is a distilled beverage native to Korea.
    """@en;
           skos:prefLabel "Soju"@en,
                          "소주"@ko.
bevon:SpeysideSingleMalt dcterms:issued "2013-07-04+09:00"^^xsd:date;
                         dcterms:modified "2014-03-01+09:00"^^xsd:date;
                         a owl:Class;
                         rdfs:isDefinedBy bevon:;
                         rdfs:seeAlso wiki:Speyside_single_malts;
                         rdfs:subClassOf bevon:SingleMaltScotch,
                                         pto:Speyside_single_malts;
                         status:term_status "unstable"@en;
                         skos:definition """
    Speyside single malts are single malt Scotch whiskies, distilled in
    Strathspey, the area around the River Spey in Moray and Badenoch and
    Strathspey, in northeastern Scotland.
    """@en;
                         skos:prefLabel "스페이사이드 싱글 몰트"@ko,
                                        "Speyside Single Malt"@en.
bevon:Stout dcterms:issued "2013-07-04+09:00"^^xsd:date;
            dcterms:modified "2014-03-01+09:00"^^xsd:date;
            a owl:Class;
            rdfs:comment """
    Stouts were traditionally the generic term for the strongest or stoutest
    porters, typically 7% or 8%, produced by a brewery.
    """@en;
            rdfs:isDefinedBy bevon:;
            rdfs:seeAlso wiki:Stout;
            rdfs:subClassOf pto:Stout,
                            bevon:Porter;
            status:term_status "unstable"@en;
            skos:altLabel "Strong Porter"@en;
            skos:definition """
    Stout is a dark beer made using roasted malt or roasted barley, hops, water
    and yeast.
    """@en;
            skos:prefLabel "Stout"@en,
                           "스타우트"@ko.
bevon:Tequila dcterms:issued "2013-07-04+09:00"^^xsd:date;
              dcterms:modified "2014-03-01+09:00"^^xsd:date;
              a owl:Class;
              rdfs:isDefinedBy bevon:;
              rdfs:seeAlso wiki:Tequila;
              rdfs:subClassOf bevon:DistilledBeverage,
                              pto:Tequila;
              status:term_status "testing"@en;
              skos:definition """
    Tequila is a distilled beverage made from the blue agave plant, primarily
    in the area surrounding the city of Tequila, 65 kilometres (40 mi)
    northwest of Guadalajara, and in the highlands (Los Altos) of the western
    Mexican state of Jalisco.
    """@en;
              skos:prefLabel "Tequila"@en,
                             "테킬라"@ko.
bevon:TequilaBlanco dcterms:issued "2013-07-04+09:00"^^xsd:date;
                    dcterms:modified "2014-03-01+09:00"^^xsd:date;
                    a owl:Class;
                    rdfs:isDefinedBy bevon:;
                    rdfs:subClassOf bevon:Tequila;
                    status:term_status "unstable"@en;
                    skos:altLabel "Tequila Plata"@en;
                    skos:definition """
    Tequila Blanco (\"white\") or Plata (\"silver\") is a white spirit, un-aged and
    bottled or stored immediately after distillation, or aged less than two
    months in stainless steel or neutral oak barrels.
    """@en;
                    skos:prefLabel "테킬라 블랑코"@ko,
                                   "Tequila Blanco"@en.
bevon:Vodka dcterms:issued "2013-07-04+09:00"^^xsd:date;
            dcterms:modified "2014-03-01+09:00"^^xsd:date;
            a owl:Class;
            rdfs:comment """
    Vodka is made by the distillation of fermented substances such as grains,
    potatoes, or sometimes fruits or sugar.
    """@en;
            rdfs:isDefinedBy bevon:;
            rdfs:seeAlso wiki:Vodka;
            rdfs:subClassOf pto:Vodka,
                            bevon:DistilledBeverage;
            status:term_status "testing"@en;
            skos:definition """
    Vodka is a distilled beverage composed primarily of water and ethanol,
    sometimes with traces of impurities and flavorings.
    """@en;
            skos:prefLabel "보드카"@ko,
                           "Vodka"@en,
                           "водка"@ru,
                           "Wódka"@pl.
bevon:Water dcterms:issued "2013-07-04+09:00"^^xsd:date;
            dcterms:modified "2014-03-01+09:00"^^xsd:date;
            a owl:Class;
            rdfs:isDefinedBy bevon:;
            rdfs:seeAlso wiki:Water;
            rdfs:subClassOf bevon:NonAlcoholicBeverage,
                            pto:Water;
            status:term_status "testing"@en;
            skos:definition """
    In the Beverage Ontology, Water means a drinking water.
    """@en;
            skos:prefLabel "물"@ko,
                           "Water"@en.
bevon:Whisky dcterms:issued "2013-07-04+09:00"^^xsd:date;
             dcterms:modified "2015-07-23+09:00"^^xsd:date;
             a owl:Class;
             rdfs:comment """
    Different grains are used for different varieties, including barley, malted
    barley, rye, malted rye, wheat, and corn. Whisky is typically aged in
    wooden casks, made generally of charred white oak.
    """@en;
             rdfs:isDefinedBy bevon:;
             rdfs:seeAlso wiki:Whisky;
             rdfs:subClassOf pto:Whisky,
                             bevon:DistilledBeverage;
             owl:sameAs <http://purl.org/vocab/whisky/terms/Whisky>;
             status:term_status "testing"@en;
             skos:altLabel "Whiskey"@en;
             skos:definition """
    Whisky or whiskey is a type of distilled alcoholic beverage made from
    fermented grain mash.
    """@en;
             skos:prefLabel "Whisky"@en,
                            "위스키"@en.
