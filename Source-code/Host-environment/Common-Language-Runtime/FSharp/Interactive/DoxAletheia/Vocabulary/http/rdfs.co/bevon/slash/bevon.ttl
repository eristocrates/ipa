                                         bevon:description """
    Guinness is a popular Irish dry stout that originated in the brewery of
    Arthur Guinness (1725–1803) at St. James's Gate, Dublin. Guinness is one
    of the most successful beer brands worldwide.
    """@en;
                                         bevon:fermentation_base <http://dbpedia.org/resource/Barley>;
                                         bevon:ibu "37"^^xsd:nonNegativeInteger;
                                         bevon:launch "1759"^^xsd:gYear;
