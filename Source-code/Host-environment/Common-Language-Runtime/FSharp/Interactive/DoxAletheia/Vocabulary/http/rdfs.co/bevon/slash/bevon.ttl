@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix bevon: <http://rdfs.co/bevon/>.

<http://jayg.me/> a <http://xmlns.com/foaf/0.1/Person>;
                  <http://xmlns.com/foaf/0.1/homepage> <http://jayg.org/>;
                  <http://xmlns.com/foaf/0.1/mbox_sha1sum> "f03421e94730da58e8943d3a1d2c4c6b02898e14";
                  <http://xmlns.com/foaf/0.1/name> "김보람"@ko,
                                                   "James G. Kim"@en.
<http://purl.org/vocab/whisky/terms/Distillery> rdfs:subClassOf bevon:Distillery.
<http://purl.org/vocab/whisky/terms/abv> rdfs:subPropertyOf bevon:abv.
<http://purl.org/vocab/whisky/terms/distillery> rdfs:subPropertyOf bevon:distillery.
bevon:0.8 <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/4.0/>;
          <http://purl.org/dc/terms/creator> <http://jayg.me/>;
          <http://purl.org/dc/terms/description> """
    Beverage Ontology is a Web vocabulary for describing beverages, mainly
    alcoholic.
    """@en;
          <http://purl.org/dc/terms/hasFormat> <http://rdfs.co/bevon/0.8/rdf>,
                                               <http://rdfs.co/bevon/0.8/html>,
                                               <http://rdfs.co/bevon/0.8/ttl>;
          <http://purl.org/dc/terms/identifier> "http://rdfs.co/bevon/0.8";
          <http://purl.org/dc/terms/isVersionOf> bevon:;
          <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
          <http://purl.org/dc/terms/modified> "2015-07-23+09:00"^^xsd:date;
          <http://purl.org/dc/terms/publisher> <http://jayg.me/>;
          <http://purl.org/dc/terms/replaces> bevon:0.7;
          <http://purl.org/dc/terms/rights> "Copyright © 2013-2015 James G. Kim Some Rights Reserved.";
          <http://purl.org/dc/terms/title> "BEVON: Beverage Ontology"@en;
          <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
          <http://purl.org/vocab/vann/example> [rdfs:comment """
    <pre><code>beverage:Glenfiddich12YearOld
  a owl:NamedIndividual, bevon:SpeysideSingleMalt , gr:ProductOrServiceModel ;
  bevon:name \"Glenfiddich 12 Year Old\"@en , \"글렌피딕 12년\"@ko ;
  bevon:description \"\"\"
    Carefully matured in the finest American bourbon and Spanish sherry oak
    casks for at least 12 years. Married and mellowed in oak marrying tuns for
    complete harmony of aroma and flavor.

    A single malt Scotch whisky with distinctive fresh pear, creamy with subtle
    oak flavors and a long smooth and mellow finish.
    \"\"\"@en ;
  bevon:origin &lt;http://dbpedia.org/resource/Strathspey,_Scotland&gt; ;
  bevon:launch \"1887\"^^xsd:gYear ;
  bevon:distillery [
    a bevon:Distillery ;
    owl:sameAs &lt;http://dbpedia.org/resource/Glenfiddich_distillery&gt; ;
    whisky:region &lt;http://dbpedia.org/resource/Strathspey,_Scotland&gt; ;
    whisky:owner &lt;http://dbpedia.org/resource/William_Grant_%26_Sons&gt; ;
    whisky:waterSource [
      a whisky:WaterSource ;
      dcterms:title \"Robbie Dhu Springs\"@en , \"로비 듀 수원지\"@ko
    ]
  ] ;
  bevon:manufacturer &lt;http://dbpedia.org/resource/William_Grant_%26_Sons&gt; ;
  bevon:fermentation_base &lt;http://dbpedia.org/resource/Barley&gt; ;
  bevon:aging [
    a bevon:Aging ;
    bevon:material &lt;http://dbpedia.org/resource/Oak&gt; ;
    bevon:previous_content
      &lt;http://dbpedia.org/resource/Bourbon_whiskey&gt; ,
      &lt;http://dbpedia.org/resource/Sherry&gt; ;
    bevon:duration [
      a time:DurationDescription ;
      time:years \"12\"^^xsd:decimal
    ]
  ] ;
  bevon:color [
    a dbpedia:Colour ;
    owl:sameAs &lt;http://dbpedia.org/resource/Gold_(color)&gt; ;
    owl:sameAs &lt;http://purl.org/colors/rgb/FFD700&gt; ;
    dcterms:title \"Gold\"@en
  ] ;
  bevon:abv \"40\"^^xsd:decimal ;
  bevon:container container:700mlGlassBottle .

container:700mlGlassBottle a owl:NamedIndividual, bevon:GlassBottle ;
  skos:prefLabel \"700ml Glass Bottle\"@en , \"700ml 유리병\"@ko ;
  skos:altLabel \"70cl Glass Bottle\"@en ;
  bevon:volume [
    a gr:QuantitativeValueInteger ;
    gr:hasUnitOfMeasurement \"MLT\" ;
    gr:hasValue \"700\"^^xsd:int
  ] .</code></pre>
    """^^rdf:XMLLiteral ; 
                                                rdfs:label "Glenfiddich 12 Year Old"@en],
                                               [rdfs:comment """
    <pre><code>beverage:WhiskyAndSoda
  a owl:NamedIndividual, bevon:Highball , gr:ProductOrServiceModel ;
  bevon:name \"Whisky &amp; Soda\"@en , \"위스키 소다\"@ko ;
  bevon:description \"\"\"
    Whisky &amp; Soda is a kind of mixed drinks that are composed of whisky and
    carbonated water.
    \"\"\"@en ;
  bevon:ingredient [
    a food:Ingredient ;
    bevon:food [
      a bevon:Whisky ;
      owl:sameAs &lt;http://dbpedia.org/resource/Whisky&gt; ;
      dcterms:title \"Whisky\"@en
    ] ;
    bevon:quantity [
      a gr:QuantitativeValueInteger ;
      gr:hasUnitOfMeasurement \"OZA\" ;
      gr:hasValue \"2\"^^xsd:int
    ]
  ] , [
    a food:Ingredient ;
    bevon:food [
      a bevon:CarbonatedWater ;
      owl:sameAs &lt;http://dbpedia.org/resource/Carbonated_water&gt; ;
      dcterms:title \"Carbonated Water\"@en
    ]
  ] .</code></pre>
    """^^rdf:XMLLiteral ; 
                                                rdfs:label "Whisky & Soda"@en];
          <http://purl.org/vocab/vann/preferredNamespacePrefix> "bevon";
          <http://purl.org/vocab/vann/preferredNamespaceUri> "http://rdfs.co/bevon/";
          <http://purl.org/vocab/vann/termGroup> bevon:BeerGroup,
                                                 bevon:RelationGroup,
                                                 bevon:ContainerGroup,
                                                 bevon:CoreGroup,
                                                 bevon:WineGroup,
                                                 bevon:CocktailGroup,
                                                 bevon:WhiskyGroup;
          a <http://www.w3.org/ns/adms#SemanticAsset>,
            <http://creativecommons.org/ns#Work>,
            <http://purl.org/vocommons/voaf#Vocabulary>,
            <http://www.w3.org/2002/07/owl#Ontology>;
          rdfs:comment """
    Most of the descriptions given here are from Wikipedia or from the websites
    of the related products.
    """@en,
                       """
    <div>
      The master version of this vocabulary is maintained in <a
      href=\"https://github.com/jgkim/bevon\">the GitHub repository</a> so others
      can contribute edits and improvements.
    </div>
    """;
          rdfs:seeAlso <https://github.com/jgkim/bevon>;
          <http://www.w3.org/2002/07/owl#versionInfo> "0.8";
          <http://www.w3.org/2004/02/skos/core#changeNote> [<http://purl.org/dc/terms/creator> <http://jayg.me/> ; 
                                                            <http://purl.org/dc/terms/date> "2015-07-27+09:00"^^xsd:date ; 
                                                            rdf:value """
      Made the vocabulary as a type of voaf:Vocabulary
      """@en],
                                                           [<http://purl.org/dc/terms/creator> <http://jayg.me/> ; 
                                                            <http://purl.org/dc/terms/date> "2014-03-03+09:00"^^xsd:date ; 
                                                            rdf:value """
      Added a link to the GitHub repository
      """@en],
                                                           [<http://purl.org/dc/terms/creator> <http://jayg.me/> ; 
                                                            <http://purl.org/dc/terms/date> "2014-03-06+09:00"^^xsd:date ; 
                                                            rdf:value """
      Added term groups for core, relation, container, beer, whisky and
      cocktail terms
      """@en],
                                                           [<http://purl.org/dc/terms/creator> <http://jayg.me/> ; 
                                                            <http://purl.org/dc/terms/date> "2014-03-01+09:00"^^xsd:date ; 
                                                            rdf:value """
      Minor revisions for documentation
      """@en];
          <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/terms/creator> <http://jayg.me/> ; 
                                                             <http://purl.org/dc/terms/date> "2015-07-23+09:00"^^xsd:date ; 
                                                             rdf:value """
      Fixed the sameAs relationship of bevon:Whisky
      """@en],
                                                            [<http://purl.org/dc/terms/creator> <http://jayg.me/> ; 
                                                             <http://purl.org/dc/terms/date> "2014-03-07+09:00"^^xsd:date ; 
                                                             rdf:value """
      Changed the semantics of bevon:Wine to be a superclass of wine:Wine
      """@en],
                                                            [<http://purl.org/dc/terms/creator> <http://jayg.me/> ; 
                                                             <http://purl.org/dc/terms/date> "2014-03-07+09:00"^^xsd:date ; 
                                                             rdf:value """
      Added bevon:RedWine, bevon:WhiteWine and bevon:FruitWine
      """@en],
                                                            [<http://purl.org/dc/terms/creator> <http://jayg.me/> ; 
                                                             <http://purl.org/dc/terms/date> "2014-03-06+09:00"^^xsd:date ; 
                                                             rdf:value """
      Changed bevon:FermentedBeverages to bevon:FermentedBeverage for the
      consistency
      """@en];
          <http://www.w3.org/ns/adms#status> <http://purl.org/adms/status/UnderDevelopment>.
<http://rdfs.co/bevon/0.8/html> <http://purl.org/dc/terms/format> [rdfs:seeAlso <http://www.iana.org/assignments/media-types/text/html> ; 
                                                                   rdfs:label "HTML"@en ; 
                                                                   rdf:value "text/html" ; 
                                                                   <http://purl.org/dc/dcam/memberOf> <http://purl.org/dc/terms/IMT> ; 
                                                                   a <http://purl.org/dc/terms/MediaType>].
<http://rdfs.co/bevon/0.8/rdf> <http://purl.org/dc/terms/format> [rdfs:seeAlso <http://www.iana.org/assignments/media-types/application/rdf+xml> ; 
                                                                  rdfs:label "RDF/XML"@en ; 
                                                                  rdf:value "application/rdf+xml" ; 
                                                                  <http://purl.org/dc/dcam/memberOf> <http://purl.org/dc/terms/IMT> ; 
                                                                  a <http://purl.org/dc/terms/MediaType>].
<http://rdfs.co/bevon/0.8/ttl> <http://purl.org/dc/terms/format> [rdfs:seeAlso <http://www.iana.org/assignments/media-types/text/turtle> ; 
                                                                  rdfs:label "Turtle"@en ; 
                                                                  rdf:value "text/turtle" ; 
                                                                  <http://purl.org/dc/dcam/memberOf> <http://purl.org/dc/terms/IMT> ; 
                                                                  a <http://purl.org/dc/terms/MediaType>].
bevon:Aging <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy bevon:;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
            <http://www.w3.org/2004/02/skos/core#definition> """
    Aging is the process of storing beverages in casks for a specific period of
    time to remove harsh flavors and add distinct characteristics found in the
    cask's wood.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "숙성"@ko,
                                                            "Aging"@en.
bevon:AlcoholicBeverage <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:isDefinedBy bevon:;
                        rdfs:seeAlso <http://en.wikipedia.org/wiki/Alcoholic_beverage>;
                        rdfs:subClassOf bevon:Beverage,
                                        <http://www.productontology.org/id/Alcoholic_beverage>;
                        <http://www.w3.org/2002/07/owl#disjointWith> bevon:NonAlcoholicBeverage;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
                        <http://www.w3.org/2004/02/skos/core#definition> """
     An alcoholic beverage is a drink and psychoactive drug containing
     ethyl alcohol which is commonly referred to as ethanol.
     """@en;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "알코올 음료"@ko,
                                                                        "Alcoholic Beverage"@en.
bevon:Ale <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
          <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment """
    The yeast will ferment the beer quickly, giving it a sweet, full bodied and
    fruity taste.
    """@en;
          rdfs:isDefinedBy bevon:;
          rdfs:seeAlso <http://en.wikipedia.org/wiki/Ale>;
          rdfs:subClassOf bevon:Beer,
                          <http://www.productontology.org/id/Ale>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
          <http://www.w3.org/2004/02/skos/core#definition> """
    Ale is a type of beer brewed from malted barley using a warm-fermentation
    with a strain of brewers' yeast.
    """@en;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "에일"@ko,
                                                          "Ale"@en.
bevon:AmericanWhiskey <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                      <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment """
    The production and labeling of American whiskey are governed by Title 27 of
    the U.S. Code of Federal Regulations.
    """@en;
                      rdfs:isDefinedBy bevon:;
                      rdfs:seeAlso <http://en.wikipedia.org/wiki/American_whiskey>;
                      rdfs:subClassOf <http://www.productontology.org/id/American_whiskey>,
                                      bevon:Whisky;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                      <http://www.w3.org/2004/02/skos/core#altLabel> "American Whisky"@en;
                      <http://www.w3.org/2004/02/skos/core#definition> """
    American whiskey is a distilled beverage produced in the United States from
    a fermented mash of cereal grain.
    """@en;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "American Whiskey"@en,
                                                                      "아메리칸 위스키"@ko.
bevon:Beer <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
           <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
           a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment """
    The starch and saccharification enzymes are often derived from malted
    cereal grains, most commonly malted barley and malted wheat.
    """@en;
           rdfs:isDefinedBy bevon:;
           rdfs:seeAlso <http://en.wikipedia.org/wiki/Beer>;
           rdfs:subClassOf bevon:FermentedBeverage,
                           <http://www.productontology.org/id/Beer>;
           <http://www.w3.org/2002/07/owl#disjointWith> bevon:NonAlcoholicBeer;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
           <http://www.w3.org/2004/02/skos/core#definition> """
    Beer is an alcoholic beverage produced by the saccharification of starch
    and fermentation of the resulting sugar.
    """@en;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "맥주"@ko,
                                                           "Beer"@en.
bevon:BeerBottle <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment """
    Dark amber or brown glass greatly reduces UV light from spoiling the beer.
    However, lighter colored bottles are often used for marketing reasons.
    """@en;
                 rdfs:isDefinedBy bevon:;
                 rdfs:seeAlso <http://en.wikipedia.org/wiki/Beer_bottle>;
                 rdfs:subClassOf bevon:GlassBottle;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                 <http://www.w3.org/2004/02/skos/core#definition> """
    A beer bottle is a bottle made to contain beer, usually made of glass and
    come in various sizes, shapes and colors.
    """@en;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "맥주병"@ko,
                                                                 "Beer Bottle"@en.
bevon:BeerCocktail <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                   <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:isDefinedBy bevon:;
                   rdfs:seeAlso <http://en.wikipedia.org/wiki/Beer_cocktail>;
                   rdfs:subClassOf bevon:Cocktail,
                                   <http://www.productontology.org/id/Beer_cocktail>;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                   <http://www.w3.org/2004/02/skos/core#definition> """
    A beer cocktail is a cocktail that is made by mixing beer with a distilled
    beverage. In this type of cocktail, the primary ingredient is beer.
    """@en;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Beer Cocktail"@en,
                                                                   "맥주 칵테일"@ko.
bevon:BeerGroup rdf:_1 bevon:Beer;
                rdf:_10 bevon:PaleLager;
                rdf:_11 bevon:Pilsner;
                rdf:_12 bevon:NonAlcoholicBeer;
                rdf:_13 bevon:Brewery;
                rdf:_14 bevon:BeerBottle;
                rdf:_15 bevon:Longneck;
                rdf:_16 bevon:BeerKeg;
                rdf:_17 bevon:ibu;
                rdf:_18 bevon:srm;
                rdf:_19 bevon:brewery;
                rdf:_2 bevon:Ale;
                rdf:_3 bevon:PaleAle;
                rdf:_4 bevon:IrishRedAle;
                rdf:_5 bevon:Porter;
                rdf:_6 bevon:Stout;
                rdf:_7 bevon:DryStout;
                rdf:_8 bevon:Lager;
                rdf:_9 bevon:Dunkel;
                a rdf:Bag;
                rdfs:comment """
    In addition to the BEVON core terms, there are a number of terms for use
    when describing beverages categorized under Beer.
    """@en;
                rdfs:label "Beer Terms"@en.
bevon:BeerKeg <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy bevon:;
              rdfs:subClassOf bevon:Keg;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    Beer kegs are made of stainless steel, or less commonly, of aluminium.
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "맥주 케그"@ko,
                                                              "Beer Keg"@en.
bevon:Beverage <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
               <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy bevon:;
               rdfs:seeAlso <http://en.wikipedia.org/wiki/Beverage>;
               rdfs:subClassOf <http://www.w3.org/TR/2003/PR-owl-guide-20031209/food#PotableLiquid>,
                               <http://www.productontology.org/id/Drink>,
                               <http://data.lirmm.fr/ontologies/food#Food>;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
               <http://www.w3.org/2004/02/skos/core#altLabel> "Drink"@en;
               <http://www.w3.org/2004/02/skos/core#definition> """
    A beverage, or drink, is a kind of liquid which is specifically prepared
    for human consumption.
    """@en;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "음료"@ko,
                                                               "Beverage"@en.
bevon:BeverageCan <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment """
    Beverage cans are made of aluminium (75% of worldwide production) or
    tin-plated steel (25% worldwide production).
    """@en;
                  rdfs:isDefinedBy bevon:;
                  rdfs:seeAlso <http://en.wikipedia.org/wiki/Beverage_can>;
                  rdfs:subClassOf bevon:Container;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> """
    A beverage can is a metal container designed to hold a fixed portion of
    liquid such as a carbonated soft drinks, alcoholic beverages, fruit juices,
    teas, tisanes, energy drinks, etc.
    """@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Beverage Can"@en,
                                                                  "음료 캔"@ko.
bevon:BourbonWhiskey <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment """
    The name of the spirit derives from its historical association with an area
    known as Old Bourbon, around what is now Bourbon County, Kentucky (which,
    in turn, was named after the French House of Bourbon royal family). It has
    been produced since the 18th century. While it may be made anywhere in the
    United States, it is strongly associated with the American South in
    general, and Kentucky in particular.
    """@en;
                     rdfs:isDefinedBy bevon:;
                     rdfs:seeAlso <http://en.wikipedia.org/wiki/Bourbon_whiskey>;
                     rdfs:subClassOf bevon:AmericanWhisky,
                                     <http://www.productontology.org/id/Bourbon_whiskey>;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "Bourbon Whisky"@en;
                     <http://www.w3.org/2004/02/skos/core#definition> """
    Bourbon whiskey is a type of American whiskey – a barrel-aged distilled
    spirit made primarily from corn.
    """@en;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "버번 위스키"@ko,
                                                                     "Bourbon Whiskey"@en.
bevon:Brandy <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """
    Brandy generally contains 35–60% alcohol by volume (70–120 US proof) and is
    typically taken as an after-dinner drink. Some brandies are aged in wooden
    casks, some are colored with caramel coloring to imitate the effect of
    aging, and some brandies are produced using a combination of both aging and
    coloring.
    """@en;
             rdfs:isDefinedBy bevon:;
             rdfs:seeAlso <http://en.wikipedia.org/wiki/Brandy>;
             rdfs:subClassOf <http://www.productontology.org/id/Brandy>,
                             bevon:DistilledBeverage;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    Brandy (from brandywine, derived from Dutch brandewijn—\"burnt wine\") is a
    spirit produced by distilling wine.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Brandy"@en,
                                                             "브랜디"@ko.
bevon:Brewery <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment """
    A company that makes beer is called either a brewery or a brewing company.
    """@en;
              rdfs:isDefinedBy bevon:;
              rdfs:seeAlso <http://en.wikipedia.org/wiki/Brewery>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    A brewery is a dedicated building for the making of beer, though beer can
    be made at home, and has been for much of beer's history.
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "양조장"@ko,
                                                              "Brewery"@en.
bevon:CanadianWhisky <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment """
    Most Canadian whiskies are blended multi-grain liquors containing a large
    percentage of corn spirits, and are typically lighter and smoother than
    other whisky styles.
    """@en;
                     rdfs:isDefinedBy bevon:;
                     rdfs:seeAlso <http://en.wikipedia.org/wiki/Canadian_whisky>;
                     rdfs:subClassOf bevon:Whisky,
                                     <http://www.productontology.org/id/Canadian_whisky>;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "Canadian Whiskey"@en;
                     <http://www.w3.org/2004/02/skos/core#definition> """
    Canadian whisky is a type of whisky produced in Canada.
    """@en;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "캐내디언 위스키"@ko,
                                                                     "Canadian Whisky"@en.
bevon:CarbonatedWater <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                      <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:isDefinedBy bevon:;
                      rdfs:seeAlso <http://en.wikipedia.org/wiki/Carbonated_water>;
                      rdfs:subClassOf bevon:Water,
                                      <http://www.productontology.org/id/Carbonated_water>;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                      <http://www.w3.org/2004/02/skos/core#altLabel> "소다수"@ko,
                                                                     "클럽소다"@ko,
                                                                     "Seltzer Water"@en,
                                                                     "Soda Water"@en,
                                                                     "Sparkling Water"@en,
                                                                     "Fizzy Water"@en,
                                                                     "Club Soda"@en;
                      <http://www.w3.org/2004/02/skos/core#definition> """
    Carbonated water is water into which carbon dioxide gas under pressure has
    been dissolved.
    """@en;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Carbonated Water"@en,
                                                                      "탄산수"@ko.
bevon:Cocktail <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
               <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment """
    Cocktails were originally a mixture of spirits, sugar, water, and bitters.
    It is now often used for almost any mixed drink that contains alcohol,
    including mixers, mixed shots, etc. A cocktail today usually contains one
    or more kinds of spirit and one or more mixers, such as soda or fruit
    juice. Additional ingredients may be sugar, honey, milk, cream, and various
    herbs.
    """@en;
               rdfs:isDefinedBy bevon:;
               rdfs:seeAlso <http://en.wikipedia.org/wiki/Cocktail>;
               rdfs:subClassOf bevon:MixedDrink,
                               <http://www.productontology.org/id/Cocktail>,
                               bevon:AlcoholicBeverage;
               <http://www.w3.org/2002/07/owl#disjointWith> bevon:Mocktail;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
               <http://www.w3.org/2004/02/skos/core#definition> """
    A cocktail is a mixed drink that contains alcohol, including mixers, mixed
    shots, etc.
    """@en;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "칵테일"@ko,
                                                               "Cocktail"@en.
bevon:CocktailGroup rdf:_1 bevon:Cocktail;
                    rdf:_2 bevon:Highball;
                    rdf:_3 bevon:BeerCocktail;
                    rdf:_4 bevon:Shandy;
                    rdf:_5 bevon:Mocktail;
                    a rdf:Bag;
                    rdfs:comment """
    These classes and properties are for describing beverages categorized under
    Mixed Drink.
    """@en;
                    rdfs:label "Cocktail Terms"@en.
bevon:Cognac <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """
    It is produced in the wine-growing region surrounding the town from which
    it takes its name, in the French Departements of Charente and
    Charente-Maritime.
    """@en;
             rdfs:isDefinedBy bevon:;
             rdfs:seeAlso <http://en.wikipedia.org/wiki/Cognac>;
             rdfs:subClassOf bevon:Brandy,
                             <http://www.productontology.org/id/Cognac>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    Cognac, named after the town of Cognac in France, is a variety of brandy.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "코냑"@ko,
                                                             "Cognac"@en.
bevon:Container <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy bevon:;
                rdfs:seeAlso <http://en.wikipedia.org/wiki/Container>;
                rdfs:subClassOf <http://dbpedia.org/class/yago/Containers>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                <http://www.w3.org/2004/02/skos/core#definition> """
    A container is an item used to contain, store, and transport a beverage.
    """@en;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Container"@en,
                                                                "용기"@ko.
bevon:ContainerGroup rdf:_1 bevon:Container;
                     rdf:_2 bevon:BeverageCan;
                     rdf:_3 bevon:GlassBottle;
                     rdf:_4 bevon:PlasticBottle;
                     rdf:_5 bevon:Keg;
                     rdf:_6 bevon:volume;
                     a rdf:Bag;
                     rdfs:comment """
    These classes and properties are used to describe beverage containers.
    """@en;
                     rdfs:label "Container Terms"@en.
bevon:CoreGroup rdf:_1 bevon:Beverage;
                rdf:_10 bevon:Distillery;
                rdf:_11 bevon:name;
                rdf:_12 bevon:description;
                rdf:_13 bevon:origin;
                rdf:_14 bevon:manufacturer;
                rdf:_15 bevon:color;
                rdf:_16 bevon:launch;
                rdf:_17 bevon:abv;
                rdf:_18 bevon:proof;
                rdf:_19 bevon:container;
                rdf:_2 bevon:AlcoholicBeverage;
                rdf:_20 bevon:aging;
                rdf:_21 bevon:fermentation_base;
                rdf:_22 bevon:distillery;
                rdf:_23 bevon:ingredient;
                rdf:_3 bevon:FermentedBeverage;
                rdf:_4 bevon:DistilledBeverage;
                rdf:_5 bevon:NonAlcoholicBeverage;
                rdf:_6 bevon:MixedDrink;
                rdf:_7 bevon:Container;
                rdf:_8 bevon:Aging;
                rdf:_9 bevon:FermentationBase;
                a rdf:Bag;
                rdfs:comment """
    These classes and properties form the core of BEVON. They describe
    characteristics of beverages in relatively broad terms.
    """@en;
                rdfs:label "Core Terms"@en.
bevon:DilutedSoju <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy bevon:;
                  rdfs:subClassOf bevon:Soju;
                  <http://www.w3.org/2002/07/owl#disjointWith> bevon:DistilledSoju;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> """
    Diluted Soju is made by mixing pure ethanol distilled from various grains,
    such as potatoes, wheat, barley, sweet potatoes, or tapioca, with water and
    flavoring.
    """@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Diluted Soju"@en,
                                                                  "희석식 소주"@ko.
bevon:DistilledBeverage <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment """
     This excludes undistilled fermented beverages such as beer, wine, and
     cider.
     """@en;
                        rdfs:isDefinedBy bevon:;
                        rdfs:seeAlso <http://en.wikipedia.org/wiki/Distilled_beverage>;
                        rdfs:subClassOf <http://www.productontology.org/id/Distilled_beverage>,
                                        bevon:AlcoholicBeverage;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "Spirit"@en,
                                                                       "Liquor"@en;
                        <http://www.w3.org/2004/02/skos/core#definition> """
     A distilled beverage, spirit, or liquor is an alcoholic beverage
     containing ethanol that is produced by distilling (i.e., concentrating
     by distillation) ethanol produced by means of fermenting grain, fruit,
     or vegetables.
     """@en;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "증류주"@ko,
                                                                        "Distilled Beverage"@en.
bevon:DistilledSoju <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                    <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy bevon:;
                    rdfs:subClassOf bevon:Soju;
                    <http://www.w3.org/2002/07/owl#disjointWith> bevon:DilutedSoju;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                    <http://www.w3.org/2004/02/skos/core#definition> """
    Distilled Soju is manufactured traditionally by distillation from grains,
    mainly rice.
    """@en;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "증류식 소주"@ko,
                                                                    "Distilled Soju"@en.
bevon:Distillery <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:isDefinedBy bevon:;
                 rdfs:seeAlso <http://en.wikipedia.org/wiki/Distillation>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                 <http://www.w3.org/2004/02/skos/core#definition> """
    A distillery is a premise where distillation takes place, especially
    distillation of alcohol.
    """@en;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "증류소"@ko,
                                                                 "Distillery"@en.
bevon:DryStout <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
               <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy bevon:;
               rdfs:subClassOf bevon:Stout;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
               <http://www.w3.org/2004/02/skos/core#altLabel> "Irish Stout"@en;
               <http://www.w3.org/2004/02/skos/core#definition> """
    Irish stout or dry stout is very dark or rich in color and it often has a
    \"roasted\" or coffee-like taste.
    """@en;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Dry Stout"@en,
                                                               "드라이 스타우트"@ko.
bevon:Dunkel <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """
    Dunkel is the German word meaning dark, and dunkel beers typically range in
    color from amber to dark reddish brown. They are characterized by their
    smooth malty flavor.
    """@en;
             rdfs:isDefinedBy bevon:;
             rdfs:seeAlso <https://en.wikipedia.org/wiki/Dunkel>;
             rdfs:subClassOf <http://www.productontology.org/id/Dunkel>,
                             bevon:Lager;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Dunkles"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    Dunkel, or Dunkles, is a word used for several types of dark German lager.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "둔켈"@ko,
                                                             "Dunkel"@en.
bevon:FermentationBase <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:isDefinedBy bevon:;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                       <http://www.w3.org/2004/02/skos/core#definition> """
    A fruit or grain which provides the sugar for fermentation from which a
    alcoholic beverage is made.
    """@en;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "발효 주재료"@ko,
                                                                       "Fermentation Base"@en.
bevon:FermentedBeverage <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:isDefinedBy bevon:;
                        rdfs:subClassOf bevon:AlcoholicBeverage;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "발효주"@ko;
                        <http://www.w3.org/2004/02/skos/core#definition> """
    A fermented beverage is a drink produced by fermenting grain, fruit, or
    vegetables.
    """@en;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "양조주"@ko,
                                                                        "Fermented Beverage"@en.
bevon:FruitWine <http://purl.org/dc/terms/issued> "2014-03-07+09:00"^^xsd:date;
                <http://purl.org/dc/terms/modified> "2014-03-07+09:00"^^xsd:date;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment """
    This definition is sometimes broadened to include any fermented alcoholic
    beverage except beer. For historical reasons, mead, cider, and perry are
    also excluded from the definition of fruit wine.
    """@en;
                rdfs:isDefinedBy bevon:;
                rdfs:seeAlso <http://en.wikipedia.org/wiki/Fruit_wine>;
                rdfs:subClassOf <http://www.productontology.org/id/Fruit_wine>,
                                bevon:Wine;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
                <http://www.w3.org/2004/02/skos/core#definition> """
    Fruit wines are fermented alcoholic beverages made from a variety of base
    ingredients (other than grapes); they may also have additional flavors
    taken from fruits, flowers, and herbs.
    """@en;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Fruit Wine"@en,
                                                                "과실주"@ko,
                                                                "Vin de Sureau"@fr.
bevon:Gin <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
          <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:isDefinedBy bevon:;
          rdfs:seeAlso <http://en.wikipedia.org/wiki/Gin>;
          rdfs:subClassOf bevon:DistilledBeverage,
                          <http://www.productontology.org/id/Gin>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
          <http://www.w3.org/2004/02/skos/core#definition> """
    Gin is a spirit which derives its predominant flavor from juniper berries
    (Juniperus communis).
    """@en;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "진"@ko,
                                                          "Gin"@en.
bevon:GlassBottle <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment """
    Glass bottles can vary in size considerably, but are most commonly found in
    sizes ranging between about 10ml and 5 litres.
    """@en;
                  rdfs:isDefinedBy bevon:;
                  rdfs:seeAlso <http://en.wikipedia.org/wiki/Glass_bottle>;
                  rdfs:subClassOf bevon:Container;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> """
    A glass bottle is a bottle created from glass.
    """@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Glass Bottle"@en,
                                                                  "유리병"@ko.
bevon:Highball <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
               <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy bevon:;
               rdfs:seeAlso <http://en.wikipedia.org/wiki/Highball>;
               rdfs:subClassOf bevon:Cocktail,
                               <http://www.productontology.org/id/Highball>;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
               <http://www.w3.org/2004/02/skos/core#definition> """
    Highball is the name for a family of mixed drinks that are composed of an
    alcoholic base spirit and a larger proportion of a non-alcoholic mixer.
    """@en;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "하이볼"@ko,
                                                               "Highball"@en.
bevon:IrishRedAle <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy bevon:;
                  rdfs:seeAlso <http://en.wikipedia.org/wiki/Irish_red_ale>;
                  rdfs:subClassOf bevon:PaleAle;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> """
    Irish red ale, red ale, or Irish ale is a name used by brewers in Ireland.
    """@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Irish Red Ale"@en,
                                                                  "아이리쉬 레드 에일"@ko.
bevon:IrishWhiskey <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                   <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment """
    Key regulations defining Irish whiskey and its production are established
    by the Irish Whiskey Act of 1980.
    """@en;
                   rdfs:isDefinedBy bevon:;
                   rdfs:seeAlso <http://en.wikipedia.org/wiki/Irish_whiskey>;
                   rdfs:subClassOf <http://www.productontology.org/id/Irish_whiskey>,
                                   bevon:Whisky;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "Irish Whisky"@en;
                   <http://www.w3.org/2004/02/skos/core#definition> """
    Irish whiskey is whisky made in Ireland.
    """@en;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Irish Whiskey"@en,
                                                                   "아이리쉬 위스키"@ko,
                                                                   "Fuisce"@ga.
bevon:JapaneseWhisky <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment """
    Whisky production in Japan began around 1870, but the first commercial
    production was in 1924 upon the opening of the country's first distillery,
    Yamazaki. Broadly speaking the style of Japanese whisky is more similar to
    that of Scotch whisky than Irish, American, or Canadian styles of whisky,
    and thus the spelling typically follows the Scottish convention (omitting
    the letter \"e\").
    """@en;
                     rdfs:isDefinedBy bevon:;
                     rdfs:seeAlso <http://en.wikipedia.org/wiki/Japanese_whisky>;
                     rdfs:subClassOf <http://www.productontology.org/id/Japanese_whisky>,
                                     bevon:Whisky;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "Japanese Whiskey"@en;
                     <http://www.w3.org/2004/02/skos/core#definition> """
    Japanese whisky is whisky made in Japan.
    """@en;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "재패니즈 위스키"@ko,
                                                                     "Japanese Whisky"@en.
bevon:Keg <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
          <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:isDefinedBy bevon:;
          rdfs:seeAlso <http://en.wikipedia.org/wiki/Keg>;
          rdfs:subClassOf bevon:Container;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
          <http://www.w3.org/2004/02/skos/core#definition> """
    A keg is a small barrel.
    """@en;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Keg"@en,
                                                          "케그"@ko.
bevon:Lager <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy bevon:;
            rdfs:seeAlso <http://en.wikipedia.org/wiki/Lager>;
            rdfs:subClassOf bevon:Beer,
                            <http://www.productontology.org/id/Lager>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
            <http://www.w3.org/2004/02/skos/core#definition> """
    Lager is a type of beer that is fermented and conditioned at low
    temperatures.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Lager"@en,
                                                            "라거"@ko.
bevon:Liqueur <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment """
    Liqueurs are typically quite sweet; they are usually not aged for long
    after the ingredients are mixed, but may have resting periods during their
    production to allow flavors to marry.
    """@en;
              rdfs:isDefinedBy bevon:;
              rdfs:seeAlso <http://en.wikipedia.org/wiki/Liqueur>;
              rdfs:subClassOf <http://www.productontology.org/id/Liqueur>,
                              bevon:DistilledBeverage;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Cordials"@en,
                                                             "Schnapps"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    A liqueur is an alcoholic beverage made from a distilled spirit that has
    been flavored with fruit, cream, herbs, spices, flowers or nuts and bottled
    with added sugar or other sweetener (such as high-fructose corn syrup).
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "리큐어"@ko,
                                                              "Liqueur"@en.
bevon:Longneck <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
               <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment """
    It is known as the standard longneck bottle or industry standard bottle
    (ISB). The ISB longnecks have a uniform capacity, height, weight and
    diameter and can be reused on average 16 times. The long neck offers a long
    cushion of air to absorb the pressure of carbonation to reduce the risk of
    exploding. The longneck also provides a handle for drinking directly from
    the bottle without transferring body heat to the beer from one's hand.
    """@en;
               rdfs:isDefinedBy bevon:;
               rdfs:subClassOf bevon:BeerBottle;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
               <http://www.w3.org/2004/02/skos/core#altLabel> "North American Longneck"@en,
                                                              "Industry Standard Bottle"@en;
               <http://www.w3.org/2004/02/skos/core#definition> """
    A longneck is a type of beer bottle with a long neck.
    """@en;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "긴목 맥주병"@ko,
                                                               "Longneck"@en.
bevon:MaltWhisky <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:isDefinedBy bevon:;
                 rdfs:seeAlso <http://en.wikipedia.org/wiki/Malt_whisky>;
                 rdfs:subClassOf bevon:Whisky,
                                 <http://www.productontology.org/id/Malt_whisky>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                 <http://www.w3.org/2004/02/skos/core#altLabel> "Malt Whiskey"@en;
                 <http://www.w3.org/2004/02/skos/core#definition> """
    Malt whisky is whisky that is made from a fermented mash produced primarily
    from a malted grain.
    """@en;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Malt Whisky"@en,
                                                                 "몰트 위스키"@ko.
bevon:MineralWater <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                   <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment """
    Mineral water may be sparkling due to contained gases.
    """@en;
                   rdfs:isDefinedBy bevon:;
                   rdfs:seeAlso <http://en.wikipedia.org/wiki/Mineral_water>;
                   rdfs:subClassOf bevon:Water,
                                   <http://www.productontology.org/id/Mineral_water>;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                   <http://www.w3.org/2004/02/skos/core#definition> """
    Mineral water is water from a mineral spring containing various minerals
    such as salts and sulfur compounds.
    """@en;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "광천수"@ko,
                                                                   "Mineral Water"@en.
bevon:MixedDrink <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment """
    Some mixed drinks are alcoholic beverages that contain liquor; others are
    non-alcoholic.
    """@en;
                 rdfs:isDefinedBy bevon:;
                 rdfs:seeAlso <http://en.wikipedia.org/wiki/Mixed_drink>;
                 rdfs:subClassOf <http://www.productontology.org/id/Mixed_drink>,
                                 bevon:Beverage;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
                 <http://www.w3.org/2004/02/skos/core#definition> """
    A mixed drink is a beverage in which two or more ingredients are mixed.
    """@en;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "혼합 음료"@ko,
                                                                 "Mixed Drink"@en.
bevon:Mocktail <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
               <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy bevon:;
               rdfs:subClassOf bevon:MixedDrink,
                               bevon:NonAlcoholicBeverage;
               <http://www.w3.org/2002/07/owl#disjointWith> bevon:Cocktail;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
               <http://www.w3.org/2004/02/skos/core#definition> """
    Mocktails are mock cocktails, or those that do not contain any alcohol.
    """@en;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "목테일"@ko,
                                                               "Mocktail"@en.
bevon:NonAlcoholicBeer <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:isDefinedBy bevon:;
                       rdfs:seeAlso <http://en.wikipedia.org/wiki/Low-alcohol_beer>;
                       rdfs:subClassOf <http://www.productontology.org/id/Low-alcohol_beer>,
                                       bevon:NonAlcoholicBeverage;
                       <http://www.w3.org/2002/07/owl#disjointWith> bevon:Beer;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                       <http://www.w3.org/2004/02/skos/core#altLabel> "Low-alcoholic Beer"@en;
                       <http://www.w3.org/2004/02/skos/core#definition> """
    Non-alcohol beer (also called light beer, low-alcoholic beer, small beer,
    small ale, or near-beer) is beer with low alcohol content or no alcohol,
    which aim to reproduce the taste of beer without the inebriating effects of
    standard alcoholic brews.
    """@en;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Non-alcoholic Beer"@en,
                                                                       "비알코올 맥주"@ko.
bevon:NonAlcoholicBeverage <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                           <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:isDefinedBy bevon:;
                           rdfs:seeAlso <http://en.wikipedia.org/wiki/Non-alcoholic_beverage>;
                           rdfs:subClassOf bevon:Beverage,
                                           <http://www.productontology.org/id/Non-alcoholic_beverage>;
                           <http://www.w3.org/2002/07/owl#disjointWith> bevon:AlcoholicBeverage;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
                           <http://www.w3.org/2004/02/skos/core#definition> """
     A non-alcoholic beverage (also known as a virgin drink) is defined
     in the U.S. as a beverage that contains less than 0.5% alcohol by volume.
     """@en;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Non-alcoholic Beverage"@en,
                                                                           "비알코올 음료"@ko.
bevon:PaleAle <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment """
    It is one of the world's major beer styles.
    """@en;
              rdfs:isDefinedBy bevon:;
              rdfs:seeAlso <http://en.wikipedia.org/wiki/Pale_ale>;
              rdfs:subClassOf bevon:Ale,
                              <http://www.productontology.org/id/Pale_ale>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    Pale ale is a beer made by warm fermentation using predominantly pale malt.
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Pale Ale"@en,
                                                              "페일 에일"@ko.
bevon:PaleLager <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy bevon:;
                rdfs:seeAlso <http://en.wikipedia.org/wiki/Pale_lager>;
                rdfs:subClassOf bevon:Lager,
                                <http://www.productontology.org/id/Pale_lager>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                <http://www.w3.org/2004/02/skos/core#definition> """
    Pale lager is a very pale to golden-colored beer with a well attenuated
    body and a varying degree of noble hop bitterness.
    """@en;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "페일 라거"@ko,
                                                                "Pale Lager"@en.
bevon:Pilsner <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment """
    It took its name from the city of Pilsen (Plzeň, Bohemia, Czech Republic,
    where it was first produced in 1842).
    """@en;
              rdfs:isDefinedBy bevon:;
              rdfs:seeAlso <http://en.wikipedia.org/wiki/Pilsner>;
              rdfs:subClassOf <http://www.productontology.org/id/Pilsner>,
                              bevon:PaleLager;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Pilsener"@en,
                                                             "Pils"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    Pilsner (also pilsener or simply pils) is a type of pale lager.
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "필스너"@ko,
                                                              "Pilsner"@en.
bevon:Pisco <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy bevon:;
            rdfs:seeAlso <http://en.wikipedia.org/wiki/Pisco>;
            rdfs:subClassOf <http://www.productontology.org/id/Pisco>,
                            bevon:Brandy;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
            <http://www.w3.org/2004/02/skos/core#definition> """
    Pisco is a colorless or yellowish-to-amber colored grape brandy produced
    in winemaking regions of Peru and Chile.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Pisco"@en,
                                                            "피스코"@ko.
bevon:PlasticBottle <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                    <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment """
    Plastic bottles are typically used to store liquids such as water, soft
    drinks, motor oil, cooking oil, medicine, shampoo, milk, and ink.
    """@en;
                    rdfs:isDefinedBy bevon:;
                    rdfs:seeAlso <http://en.wikipedia.org/wiki/Plastic_bottle>;
                    rdfs:subClassOf bevon:Container;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                    <http://www.w3.org/2004/02/skos/core#definition> """
    A plastic bottle is a bottle constructed of plastic.
    """@en;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Plastic Bottle"@en,
                                                                    "플라스틱 병"@ko.
bevon:Porter <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """
    The name came about as a result of its popularity with street and river
    porters.
    """@en;
             rdfs:isDefinedBy bevon:;
             rdfs:seeAlso <http://en.wikipedia.org/wiki/English_porter>;
             rdfs:subClassOf <http://www.productontology.org/id/English_porter>,
                             bevon:Ale;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#altLabel> "English Porter"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    Porter is a dark style of beer originating in London in the 18th century,
    descended from brown beer, a well hopped beer made from brown malt.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Porter"@en,
                                                             "포터"@ko.
bevon:RedWine <http://purl.org/dc/terms/issued> "2014-03-07+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2014-03-07+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment """
    The actual colour of the wine can range from intense violet, typical of
    young wines, through to brick red for mature wines and brown for older red
    wines.
    """@en;
              rdfs:isDefinedBy bevon:;
              rdfs:seeAlso <http://en.wikipedia.org/wiki/Red_wine>;
              rdfs:subClassOf bevon:Wine,
                              <http://www.productontology.org/id/Red_wine>;
              <http://www.w3.org/2002/07/owl#sameAs> <http://www.w3.org/TR/2003/PR-owl-guide-20031209/wine#RedWine>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    Red wine is a type of wine made from dark-coloured (black) grape varieties.
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Vin Rouge"@fr,
                                                              "Red Wine"@en,
                                                              "레드 와인"@ko.
bevon:RelationGroup rdf:_1 bevon:related;
                    rdf:_2 bevon:similar;
                    rdf:_3 bevon:variant;
                    rdf:_4 bevon:variantOf;
                    rdf:_5 bevon:non_alcoholic_version;
                    a rdf:Bag;
                    rdfs:comment """
    These properties are used for describing relations between beverages.
    """@en;
                    rdfs:label "Relation Terms"@en.
bevon:Rum <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
          <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment """
    The distillate, a clear liquid, is then usually aged in
    oak barrels.
    """@en;
          rdfs:isDefinedBy bevon:;
          rdfs:seeAlso <http://en.wikipedia.org/wiki/Rum>;
          rdfs:subClassOf bevon:DistilledBeverage,
                          <http://www.productontology.org/id/Rum>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
          <http://www.w3.org/2004/02/skos/core#definition> """
    Rum is a distilled alcoholic beverage made from sugarcane byproducts, such
    as molasses, or directly from sugarcane juice, by a process of fermentation
    and distillation.
    """@en;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Ron"@es,
                                                          "Rum"@en,
                                                          "럼"@ko.
bevon:Sake <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
           <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
           a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:isDefinedBy bevon:;
           rdfs:seeAlso <http://en.wikipedia.org/wiki/Sake>;
           rdfs:subClassOf bevon:FermentedBeverage,
                           <http://www.productontology.org/id/Sake>;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
           <http://www.w3.org/2004/02/skos/core#altLabel> "Rice Wine"@en;
           <http://www.w3.org/2004/02/skos/core#definition> """
    Sake or saké is an alcoholic beverage of Japanese origin that is made from
    fermented rice.
    """@en;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "사케"@ko,
                                                           "Sake"@en,
                                                           "Saké"@fr.
bevon:ScotchWhisky <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                   <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment """
    All Scotch whisky was originally made from malt barley. Commercial
    distilleries began introducing whisky made from wheat and rye in the late
    eighteenth century.
    """@en;
                   rdfs:isDefinedBy bevon:;
                   rdfs:seeAlso <http://en.wikipedia.org/wiki/Scotch_whisky>;
                   rdfs:subClassOf bevon:Whisky,
                                   <http://www.productontology.org/id/Scotch_whisky>;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "Scotch Whiskey"@en;
                   <http://www.w3.org/2004/02/skos/core#definition> """
    Scotch whisky (often referred to simply as \"Scotch\") is malt whisky or grain
    whisky made in Scotland.
    """@en;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Scotch Whisky"@en,
                                                                   "스카치 위스키"@ko.
bevon:Shandy <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """
    The proportions of the two ingredients are adjusted to taste, usually
    half-and-half.
    """@en;
             rdfs:isDefinedBy bevon:;
             rdfs:seeAlso <http://en.wikipedia.org/wiki/Shandy>;
             rdfs:subClassOf <http://www.productontology.org/id/Shandy>,
                             bevon:Cocktail;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    A shandy, or shandygaff, is beer mixed with a soft drink, carbonated
    lemonade, ginger beer, ginger ale, or apple juice.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Shandy"@en,
                                                             "섄디"@ko.
bevon:SingleMaltScotch <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment """
    As with any Scotch whisky, a single malt Scotch must be distilled in
    Scotland and matured in oak casks in Scotland for at least three years
    (most single malts are matured longer).
    """@en;
                       rdfs:isDefinedBy bevon:;
                       rdfs:seeAlso <http://en.wikipedia.org/wiki/Single_malt_Scotch>;
                       rdfs:subClassOf bevon:ScotchWhisky,
                                       <http://www.productontology.org/id/Single_malt_Scotch>,
                                       bevon:SingleMaltWhisky;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                       <http://www.w3.org/2004/02/skos/core#definition> """
    Single Malt Scotch is single malt whisky made in Scotland using a pot still
    distillation process at a single distillery, with malted barley as the only
    grain ingredient.
    """@en;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Single Malt Scotch"@en,
                                                                       "싱글 몰트 스카치"@ko.
bevon:SingleMaltWhisky <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:isDefinedBy bevon:;
                       rdfs:seeAlso <http://en.wikipedia.org/wiki/Single_malt_whisky>;
                       rdfs:subClassOf <http://www.productontology.org/id/Single_malt_whisky>,
                                       bevon:MaltWhisky;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                       <http://www.w3.org/2004/02/skos/core#altLabel> "Single Malt Whiskey"@en;
                       <http://www.w3.org/2004/02/skos/core#definition> """
    Single malt whisky is a whisky made at one particular distillery from a
    mash that uses only malted grain, ordinarily barley.
    """@en;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "싱글 몰트 위스키"@ko,
                                                                       "Single Malt Whisky"@en.
bevon:Soju <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
           <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
           a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment """
    Its taste is comparable to vodka, though often slightly sweeter due to
    sugars added in the manufacturing process.
    """@en;
           rdfs:isDefinedBy bevon:;
           rdfs:seeAlso <http://en.wikipedia.org/wiki/Soju>;
           rdfs:subClassOf <http://www.productontology.org/id/Soju>,
                           bevon:DistilledBeverage;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
           <http://www.w3.org/2004/02/skos/core#definition> """
    Soju is a distilled beverage native to Korea.
    """@en;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Soju"@en,
                                                           "소주"@ko.
bevon:SpeysideSingleMalt <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                         <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:isDefinedBy bevon:;
                         rdfs:seeAlso <http://en.wikipedia.org/wiki/Speyside_single_malts>;
                         rdfs:subClassOf bevon:SingleMaltScotch,
                                         <http://www.productontology.org/id/Speyside_single_malts>;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                         <http://www.w3.org/2004/02/skos/core#definition> """
    Speyside single malts are single malt Scotch whiskies, distilled in
    Strathspey, the area around the River Spey in Moray and Badenoch and
    Strathspey, in northeastern Scotland.
    """@en;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "스페이사이드 싱글 몰트"@ko,
                                                                         "Speyside Single Malt"@en.
bevon:Stout <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment """
    Stouts were traditionally the generic term for the strongest or stoutest
    porters, typically 7% or 8%, produced by a brewery.
    """@en;
            rdfs:isDefinedBy bevon:;
            rdfs:seeAlso <http://en.wikipedia.org/wiki/Stout>;
            rdfs:subClassOf <http://www.productontology.org/id/Stout>,
                            bevon:Porter;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Strong Porter"@en;
            <http://www.w3.org/2004/02/skos/core#definition> """
    Stout is a dark beer made using roasted malt or roasted barley, hops, water
    and yeast.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Stout"@en,
                                                            "스타우트"@ko.
bevon:Tequila <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy bevon:;
              rdfs:seeAlso <http://en.wikipedia.org/wiki/Tequila>;
              rdfs:subClassOf bevon:DistilledBeverage,
                              <http://www.productontology.org/id/Tequila>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    Tequila is a distilled beverage made from the blue agave plant, primarily
    in the area surrounding the city of Tequila, 65 kilometres (40 mi)
    northwest of Guadalajara, and in the highlands (Los Altos) of the western
    Mexican state of Jalisco.
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Tequila"@en,
                                                              "테킬라"@ko.
bevon:TequilaBlanco <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
                    <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy bevon:;
                    rdfs:subClassOf bevon:Tequila;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                    <http://www.w3.org/2004/02/skos/core#altLabel> "Tequila Plata"@en;
                    <http://www.w3.org/2004/02/skos/core#definition> """
    Tequila Blanco (\"white\") or Plata (\"silver\") is a white spirit, un-aged and
    bottled or stored immediately after distillation, or aged less than two
    months in stainless steel or neutral oak barrels.
    """@en;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "테킬라 블랑코"@ko,
                                                                    "Tequila Blanco"@en.
bevon:Vodka <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment """
    Vodka is made by the distillation of fermented substances such as grains,
    potatoes, or sometimes fruits or sugar.
    """@en;
            rdfs:isDefinedBy bevon:;
            rdfs:seeAlso <http://en.wikipedia.org/wiki/Vodka>;
            rdfs:subClassOf <http://www.productontology.org/id/Vodka>,
                            bevon:DistilledBeverage;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
            <http://www.w3.org/2004/02/skos/core#definition> """
    Vodka is a distilled beverage composed primarily of water and ethanol,
    sometimes with traces of impurities and flavorings.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "보드카"@ko,
                                                            "Vodka"@en,
                                                            "водка"@ru,
                                                            "Wódka"@pl.
bevon:Water <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2014-03-01+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy bevon:;
            rdfs:seeAlso <http://en.wikipedia.org/wiki/Water>;
            rdfs:subClassOf bevon:NonAlcoholicBeverage,
                            <http://www.productontology.org/id/Water>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
            <http://www.w3.org/2004/02/skos/core#definition> """
    In the Beverage Ontology, Water means a drinking water.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "물"@ko,
                                                            "Water"@en.
bevon:Whisky <http://purl.org/dc/terms/issued> "2013-07-04+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2015-07-23+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """
    Different grains are used for different varieties, including barley, malted
    barley, rye, malted rye, wheat, and corn. Whisky is typically aged in
    wooden casks, made generally of charred white oak.
    """@en;
             rdfs:isDefinedBy bevon:;
             rdfs:seeAlso <http://en.wikipedia.org/wiki/Whisky>;
             rdfs:subClassOf <http://www.productontology.org/id/Whisky>,
                             bevon:DistilledBeverage;
             <http://www.w3.org/2002/07/owl#sameAs> <http://purl.org/vocab/whisky/terms/Whisky>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Whiskey"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    Whisky or whiskey is a type of distilled alcoholic beverage made from
    fermented grain mash.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Whisky"@en,
                                                             "위스키"@en.
