                rdf:_2 bevon:RedWine;
                rdf:_3 bevon:WhiteWine;
                rdf:_4 bevon:FruitWine;
                a rdf:Bag;
                rdfs:comment """
    These classes describe types of wines.
    """@en;
                rdfs:label "Wine Terms"@en.
