@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ssso: <http://purl.org/ontology/ssso#>.

<http://purl.org/ontology/ssso> <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
                                <http://purl.org/dc/terms/creator> "Jakob Voß";
                                <http://purl.org/dc/terms/description> "An event-based RDF ontology for typical status in fulfillment of a service."@en;
                                <http://purl.org/dc/terms/modified> "2013-11-19"^^xsd:date;
                                <http://purl.org/dc/terms/title> "Simple Service Status Ontology"@en;
                                <http://purl.org/vocab/vann/preferredNamespacePrefix> "ssso";
                                <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/ontology/ssso#";
                                a <http://www.w3.org/2002/07/owl#Ontology>;
                                rdfs:label "SSSO";
                                <http://www.w3.org/2002/07/owl#versionInfo> "0.3.0".
ssso:ExecutedService a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy <http://purl.org/ontology/ssso>;
                     rdfs:label "ExecutedService"@en;
                     rdfs:subClassOf ssso:ServiceEvent;
                     <http://www.w3.org/2002/07/owl#disjointWith> ssso:ReservedService,
                                                                  ssso:RejectedService,
                                                                  ssso:ProvidedService,
                                                                  ssso:PreparedService.
ssso:PreparedService a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy <http://purl.org/ontology/ssso>;
                     rdfs:label "ReservedService"@en;
                     rdfs:subClassOf ssso:ServiceEvent;
                     <http://www.w3.org/2002/07/owl#disjointWith> ssso:ReservedService,
                                                                  ssso:RejectedService,
                                                                  ssso:ProvidedService,
                                                                  ssso:ExecutedService.
ssso:RejectedService a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy <http://purl.org/ontology/ssso>;
                     rdfs:label "RejectedService"@en;
                     rdfs:subClassOf ssso:ServiceEvent;
                     <http://www.w3.org/2002/07/owl#disjointWith> ssso:ReservedService,
                                                                  ssso:ProvidedService,
                                                                  ssso:PreparedService,
                                                                  ssso:ExecutedService.
ssso:ReservedService a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy <http://purl.org/ontology/ssso>;
                     rdfs:label "ReservedService"@en;
                     rdfs:subClassOf ssso:ServiceEvent;
                     <http://www.w3.org/2002/07/owl#disjointWith> ssso:ReservedService,
                                                                  ssso:RejectedService,
                                                                  ssso:ProvidedService,
                                                                  ssso:PreparedService,
                                                                  ssso:ExecutedService.
ssso:ServiceEvent a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy <http://purl.org/ontology/ssso>;
                  rdfs:label "ServiceEvent"@en;
                  rdfs:subClassOf <http://linkedevents.org/ontology/Event>,
                                  <http://schema.org/IndividualProduct>,
                                  <http://purl.org/ontology/c4dm/event.owl#Event>,
                                  <http://purl.org/dc/dcmitype/Event>,
                                  <http://www.semanticdesktop.org/ontologies/2007/04/02/ncal#Event>,
                                  <http://schema.org/Event>,
                                  <http://www.loa-cnr.it/ontologies/DUL.owl#Event>,
                                  <http://www.europeana.eu/schemas/edm/Event>,
                                  <http://purl.org/tio/ns#Event>,
                                  <http://purl.org/ontology/service#Service>,
                                  <http://purl.org/goodrelations/v1#Individual>,
                                  <http://purl.org/NET/cidoc-crm/core#E7_Activity>,
                                  <http://www.w3.org/ns/prov#Activity>.
ssso:ServiceFulfillment a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:isDefinedBy <http://purl.org/ontology/ssso>;
                        rdfs:label "ServiceFulfillment"@en;
                        rdfs:subClassOf ssso:ServiceEvent.
ssso:TimeTravel a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy <http://purl.org/ontology/ssso>;
                rdfs:label "TimeTravel"@en.
ssso:nextService a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain ssso:ServiceEvent;
                 rdfs:isDefinedBy <http://purl.org/ontology/ssso>;
                 rdfs:label "nextService"@en;
                 rdfs:range ssso:ServiceEvent;
                 <http://www.w3.org/2002/07/owl#inverseOf> ssso:previousService.
ssso:previousService a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:domain ssso:ServiceEvent;
                     rdfs:isDefinedBy <http://purl.org/ontology/ssso>;
                     rdfs:label "previousService"@en;
                     rdfs:range ssso:ServiceEvent;
                     <http://www.w3.org/2002/07/owl#inverseOf> ssso:nextService.
