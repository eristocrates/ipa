lslife:SpeciesOccurrenceLayer a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:label "species occurrence layer",
                                         "A layer containing data about species ocurrence.";
                              rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Layer>;
                              <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                               <http://www.w3.org/2002/07/owl#onProperty> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#containsFeatureSet> ; 
                                                                               <http://www.w3.org/2002/07/owl#onClass> lslife:SpeciesOccurrenceSet ; 
                                                                               a <http://www.w3.org/2002/07/owl#Restriction>].
lslife:SpeciesOccurrenceSet <http://semanticscience.org/resource/comment> "An species ocurrence set provides a set of species ocurrences required to generate a disctibution model.";
                            a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:label "species ocurrence set";
                            rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#FeatureSet>;
                            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:Species ; 
