lslife:hasLowerBoundInclusive a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:label "has lower bound inclusive".
lslife:hasModellingScenario a <http://www.w3.org/2002/07/owl#ObjectProperty>;
