@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix lslife: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#>.

<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#BoxedGeographicRegion> a <http://www.w3.org/2002/07/owl#Class>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#FeatureSet> a <http://www.w3.org/2002/07/owl#Class>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#FileManifestation> a <http://www.w3.org/2002/07/owl#Class>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Layer> a <http://www.w3.org/2002/07/owl#Class>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#VectorDataset> a <http://www.w3.org/2002/07/owl#Class>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#WCSResponseManifestation> a <http://www.w3.org/2002/07/owl#Class>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#containsFeatureSet> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                  rdfs:label "contains feature set".
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#coversRegion> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                            rdfs:label "covers region".
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasLayer> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                        rdfs:label "has layer".
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#representsEntity> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                rdfs:label "represents entity".
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl> <http://creativecommons.org/ns#license> "http://creativecommons.org/licenses/by/3.0/"^^xsd:anyURI;
                                                               <http://protege.stanford.edu/plugins/owl/protege#defaultLanguage> "en";
                                                               <http://purl.org/dc/elements/1.1/contributor> """Contributors are those that engage in discussions during the development of this ontology (in alphabetical order):
karl benedict
luis garnica
cj grady
bill hudspeth
deana pennington
soren scott
aimee stewart""";
