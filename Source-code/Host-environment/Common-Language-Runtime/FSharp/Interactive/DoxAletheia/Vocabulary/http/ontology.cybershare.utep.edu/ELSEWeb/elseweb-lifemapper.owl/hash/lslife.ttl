                                                                    a <http://www.w3.org/2002/07/owl#Class>].
lslife:UnpostedScenario <http://semanticscience.org/resource/comment> "A scenario that has not been posted and is composed by some scenario layer and has a JSON experiment specification URL.";
                        a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "unposted scenario";
                        <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:ScenarioLayer ; 
