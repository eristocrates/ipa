@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix edac: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#>.
@prefix lslife: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#>.
@prefix lswmo: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix sio: <http://semanticscience.org/resource/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix lsweb: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

lsweb:BoxedGeographicRegion a owl:Class.
lsweb:FeatureSet a owl:Class.
lsweb:FileManifestation a owl:Class.
lsweb:Layer a owl:Class.
lsweb:VectorDataset a owl:Class.
lsweb:WCSResponseManifestation a owl:Class.
lsweb:containsFeatureSet a owl:ObjectProperty;
                         rdfs:label "contains feature set".
lsweb:coversRegion a owl:ObjectProperty;
                   rdfs:label "covers region".
lsweb:hasLayer a owl:ObjectProperty;
               rdfs:label "has layer".
lsweb:representsEntity a owl:ObjectProperty;
                       rdfs:label "represents entity".
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl> ccrel:license "http://creativecommons.org/licenses/by/3.0/"^^xsd:anyURI;
                                                               <http://protege.stanford.edu/plugins/owl/protege#defaultLanguage> "en";
                                                               dc11:contributor """Contributors are those that engage in discussions during the development of this ontology (in alphabetical order):
karl benedict
luis garnica
cj grady
bill hudspeth
deana pennington
soren scott
aimee stewart""";
                                                               dc11:creator "Natalia Villanueva-Rosales"@en,
                                                                            "ELSEWeb team"@en,
                                                                            "http://cybershare.utep.edu"^^xsd:anyURI,
                                                                            "Nicholas del Rio"@en;
                                                               dc11:description """The ELSEWeb Lifemapper ontology provides classes for describing biodiversity modelling services provided by Lifemapper. This project provides  support for the ELSEWeb project(http://elseweb.cybershare.utep.edu/).
website: http://elseweb.cybershare.utep.edu/ontologies
email: nvillanuevarosales@utep.edu
"""@en;
                                                               dc11:issued "2014-05-01"^^xsd:date;
                                                               dc11:rights "free to use,share,modify. modify with attribution [http://creativecommons.org/licenses/by/3.0/].";
                                                               dc11:title "ELSEWeb Lifemapper Ontology"@en;
                                                               dcterms:identifier "elseweb-lifemapper.owl";
                                                               dcterms:modified "2015-09-24"^^xsd:date;
                                                               vann:preferredNamespacePrefix "elseweb-lifemapper"@en;
                                                               vann:preferredNamespaceUri "http://ontology.cybershare.utep.edu/ELSEWeb/";
                                                               a owl:Ontology;
                                                               rdfs:isDefinedBy <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl>;
                                                               owl:imports <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl>,
                                                                           <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl>,
                                                                           <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl>,
                                                                           <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl>;
                                                               owl:versionIRI <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl>;
                                                               owl:versionInfo "1.2".
lslife:ExecutableExperimentSpecification sio:comment "An executable experiment specification specifies a modelling algorithm, a modelling scenario and an ocurrence set to generate a species distribution model.";
                                         a owl:Class;
                                         rdfs:label "executable experiment specification";
                                         owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lslife:LifemapperAlgorithm ; 
                                                                                  owl:onProperty lslife:specifiesModellingAlgorithm ; 
                                                                                  a owl:Restriction]
                                                                                  [owl:someValuesFrom lslife:ModellingScenario ; 
                                                                                  owl:onProperty lslife:specifiesModellingScenario ; 
                                                                                  a owl:Restriction]
                                                                                  [owl:someValuesFrom lslife:SpeciesOccurrenceSet ; 
                                                                                  owl:onProperty lslife:specifiesOccurrenceSet ; 
                                                                                  a owl:Restriction]) ; 
                                                              a owl:Class].
lslife:ExecutedExperimentSpecification sio:comment "An executed experiment specification provides an experiment result.";
                                       a owl:Class;
                                       rdfs:label "executed experiment specification";
                                       rdfs:subClassOf lslife:ExecutableExperimentSpecification;
                                       owl:equivalentClass [owl:someValuesFrom lslife:ExperimentResult ; 
                                                            owl:onProperty lslife:hasExperimentResult ; 
                                                            a owl:Restriction].
lslife:ExecutedWCSDataset sio:comment "A dataset that is the output of a WCS service.";
                          a owl:Class;
                          rdfs:label "executed wcs dataset";
                          rdfs:subClassOf lslife:InputWCSDataset;
                          owl:equivalentClass [owl:someValuesFrom lslife:WCSResponse ; 
                                               owl:onProperty lslife:hasWCSResponse ; 
                                               a owl:Restriction].
lslife:ExperimentResult a owl:Class;
                        rdfs:comment "An experiment result provides a result ID and a URL where the result of an experiment can be retrieved.";
                        rdfs:label "experiment result";
                        owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom rdfs:Literal ; 
                                                                 owl:onProperty lslife:hasExperimentResultID ; 
                                                                 a owl:Restriction]
                                                                 [owl:someValuesFrom rdfs:Literal ; 
                                                                 owl:onProperty lslife:hasExperimentResultURL ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
lslife:ExtractedWCSResponse sio:comment "The TIFF dataset that contains the extracted payload from a WCS response.";
                            a owl:Class;
                            rdfs:label "extracted wcs response";
                            rdfs:subClassOf lslife:WCSResponse;
                            owl:equivalentClass [owl:someValuesFrom lslife:TIFFDataset ; 
                                                 owl:onProperty lslife:hasExtractedPayload ; 
                                                 a owl:Restriction].
lslife:InputWCSDataset sio:comment "A dataset that is required as an input to a WCS service.";
                       a owl:Class;
                       rdfs:label "input wcs dataset";
                       owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lsweb:BoxedGeographicRegion ; 
                                                                owl:onProperty lsweb:coversRegion ; 
                                                                a owl:Restriction]
                                                                [owl:someValuesFrom edac:RGISWCSManifestation ; 
                                                                owl:onProperty lsweb:hasManifestation ; 
                                                                a owl:Restriction]
                                                                [owl:someValuesFrom rdfs:Literal ; 
                                                                owl:onProperty lslife:hasJSONExperimentSpecificationURL ; 
                                                                a owl:Restriction]
                                                                [owl:someValuesFrom rdfs:Literal ; 
                                                                owl:onProperty lslife:hasLayerUnits ; 
                                                                a owl:Restriction]
                                                                [owl:someValuesFrom xsd:integer ; 
                                                                owl:onProperty lslife:hasTypeCode ; 
                                                                a owl:Restriction]) ; 
                                            a owl:Class].
lslife:InputWCSDatasetExperimentSpecification sio:comment "An experiment specification that provides an input wcs dataset.";
                                              a owl:Class;
                                              rdfs:label "input wcs dataset experiment specification";
                                              rdfs:subClassOf lslife:JSONExperimentSpecification;
                                              owl:equivalentClass [owl:someValuesFrom lslife:InputWCSDataset ; 
                                                                   owl:onProperty lslife:hasInputWCSDataset ; 
                                                                   a owl:Restriction].
lslife:JSONExperimentSpecification sio:comment "The location of an experiment specification in the JSON format.";
                                   a owl:Class;
                                   rdfs:label "json experiment specification";
                                   owl:equivalentClass [owl:someValuesFrom rdfs:Literal ; 
                                                        owl:onProperty lslife:hasJSONExperimentSpecificationURL ; 
                                                        a owl:Restriction].
lslife:Layer sio:comment "A unit of data (i.e. dataset) that is used as a component of a scenario specification.";
             a owl:Class;
             rdfs:label "layer";
             owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom rdfs:Literal ; 
                                                      owl:onProperty lslife:hasJSONExperimentSpecificationURL ; 
                                                      a owl:Restriction]
                                                      [owl:someValuesFrom xsd:integer ; 
                                                      owl:onProperty lslife:hasLayerID ; 
                                                      a owl:Restriction]
                                                      [owl:someValuesFrom rdfs:Literal ; 
                                                      owl:onProperty lslife:hasLayerURL ; 
                                                      a owl:Restriction]) ; 
                                  a owl:Class].
lslife:LifemapperAlgorithm sio:comment "A species modelling algorithm provided by lifemapper that is controlled by lifemapper parameters.";
                           a owl:Class;
                           rdfs:label "lifemapper algorithm";
                           rdfs:subClassOf lswmo:SpeciesModellingAlgorithm;
                           owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lslife:LifemapperParameters ; 
                                                                    owl:onProperty lswmo:behaviorControlledBy ; 
                                                                    a owl:Restriction]
                                                                    [owl:onProperty lslife:hasAlgorithmCode ; 
                                                                    owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class].
lslife:LifemapperParameter sio:comment "A species modelling parameter that controls the behavior of a lifemapper algorithm.";
                           a owl:Class;
                           rdfs:label "lifemapper parameter";
                           rdfs:subClassOf lswmo:SpeciesModellingParameter;
                           owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom rdfs:Literal ; 
                                                                    owl:onProperty lswmo:boundToValue ; 
                                                                    a owl:Restriction]
                                                                    [owl:someValuesFrom rdfs:Literal ; 
                                                                    owl:onProperty lswmo:hasParameterName ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class].
lslife:LifemapperParameters sio:comment "A set of parameters that controls the behaviour of a specific lifemapper algorithm.";
                            a owl:Class;
                            rdfs:label "lifemapper parameters";
                            rdfs:subClassOf lswmo:SpeciesModellingParameters;
                            owl:equivalentClass [owl:someValuesFrom lslife:LifemapperParameter ; 
                                                 owl:onProperty lswmo:hasParameterMember ; 
                                                 a owl:Restriction].
lslife:LifemapperSoftware sio:comment "A species modelling software provided by lifemapper.";
                          a owl:Class;
                          rdfs:label "lifemapper software";
                          rdfs:subClassOf lswmo:SpeciesModellingSoftware.
lslife:ModellingScenario sio:comment "A modelling scenario provides the specification of an experiment that can be executed.";
                         a owl:Class;
                         rdfs:label "modelling scenario";
                         rdfs:subClassOf lslife:Scenario;
                         owl:equivalentClass [owl:someValuesFrom lslife:ExecutableExperimentSpecification ; 
                                              owl:onProperty lslife:isModellingScenarioOf ; 
                                              a owl:Restriction].
lslife:ParameterDescription sio:comment "The description of an algorithm parameter.";
                            a owl:Class;
                            rdfs:label "parameter description";
                            owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom xsd:anyURI ; 
                                                                     owl:onProperty lslife:hasParameterClass ; 
                                                                     a owl:Restriction]
                                                                     [owl:onProperty lslife:hasLowerBoundInclusive ; 
                                                                     owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     a owl:Restriction]
                                                                     [owl:onProperty lslife:hasUpperBoundInclusive ; 
                                                                     owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class].
lslife:ParameterDescriptions sio:comment "A set of parameter descriptions.";
                             a owl:Class;
                             rdfs:label "parameter descriptions";
                             owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lslife:LifemapperAlgorithm ; 
                                                                      owl:onProperty lslife:describesBehaviorOf ; 
                                                                      a owl:Restriction]
                                                                      [owl:onProperty lslife:hasParameterDescription ; 
                                                                      owl:onClass lslife:ParameterDescription ; 
                                                                      owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ; 
                                                                      a owl:Restriction]
                                                                      [owl:someValuesFrom xsd:anyURI ; 
                                                                      owl:onProperty lslife:hasParameterCollectionClass ; 
                                                                      a owl:Restriction]) ; 
                                                  a owl:Class].
lslife:PostedScenario sio:comment "A scenario that has been posted.";
                      a owl:Class;
                      rdfs:label "posted scenario";
                      rdfs:subClassOf lslife:UnpostedScenario;
                      owl:equivalentClass [owl:someValuesFrom lslife:Scenario ; 
                                           owl:onProperty lslife:hasPublishedScenario ; 
                                           a owl:Restriction].
lslife:PostedTIFFDataset a owl:Class;
                         rdfs:comment "A TIFF dataset with information about the layers it contains.";
                         rdfs:label "posted tiff dataset";
                         rdfs:subClassOf lslife:TIFFDataset;
                         owl:equivalentClass [owl:someValuesFrom lslife:Layer ; 
                                              owl:onProperty lslife:hasPublishedLayer ; 
                                              a owl:Restriction].
lslife:Scenario sio:comment "A modelling scenario that provides the URL of the specification, an scenario ID and a URL where it can be retrieved.";
                a owl:Class;
                rdfs:label "scenario";
                rdfs:subClassOf lslife:Scenario;
                owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom rdfs:Literal ; 
                                                         owl:onProperty lslife:hasJSONExperimentSpecificationURL ; 
                                                         a owl:Restriction]
                                                         [owl:someValuesFrom xsd:integer ; 
                                                         owl:onProperty lslife:hasScenarioID ; 
                                                         a owl:Restriction]
                                                         [owl:someValuesFrom rdfs:Literal ; 
                                                         owl:onProperty lslife:hasScenarioURL ; 
                                                         a owl:Restriction]) ; 
                                     a owl:Class].
lslife:ScenarioLayer sio:comment "A layer that composes a scenario.";
                     a owl:Class;
                     rdfs:label "scenario layer";
                     rdfs:subClassOf lslife:Layer;
                     owl:equivalentClass [owl:someValuesFrom lslife:UnpostedScenario ; 
                                          owl:onProperty lslife:isScenarioLayerOf ; 
                                          a owl:Restriction].
lslife:Species sio:comment "A group of living organisms which is the principal natural taxonomic unit.",
                           "Erinus alpinus";
               a owl:Class;
               rdfs:label "species";
               rdfs:subClassOf lsweb:Entity;
               owl:equivalentClass [owl:onProperty lslife:hasGenusName ; 
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction].
lslife:SpeciesOccurrenceDataset a owl:Class;
                                rdfs:label "species occurrence dataset";
                                rdfs:subClassOf lsweb:VectorDataset;
                                owl:equivalentClass [owl:someValuesFrom lslife:SpeciesOccurrenceLayer ; 
                                                     owl:onProperty lsweb:hasLayer ; 
                                                     a owl:Restriction].
lslife:SpeciesOccurrenceLayer a owl:Class;
                              rdfs:label "species occurrence layer",
                                         "A layer containing data about species ocurrence.";
                              rdfs:subClassOf lsweb:Layer;
                              owl:equivalentClass [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty lsweb:containsFeatureSet ; 
                                                   owl:onClass lslife:SpeciesOccurrenceSet ; 
                                                   a owl:Restriction].
lslife:SpeciesOccurrenceSet sio:comment "An species ocurrence set provides a set of species ocurrences required to generate a disctibution model.";
                            a owl:Class;
                            rdfs:label "species ocurrence set";
                            rdfs:subClassOf lsweb:FeatureSet;
                            owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lslife:Species ; 
                                                                     owl:onProperty lslife:hasOccurrenceOfSpecies ; 
                                                                     a owl:Restriction]
                                                                     [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     owl:onProperty lslife:hasNumberOfOccurrences ; 
                                                                     owl:onDataRange xsd:integer ; 
                                                                     a owl:Restriction]
                                                                     [owl:onProperty lslife:hasOccurrenceSetID ; 
                                                                     owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class].
lslife:TIFFDataset sio:comment "A dataset that is represented in TIFF format and provides the location where it can be retrieved, the units of the layers and the type code.";
                   a owl:Class;
                   rdfs:label "tiff dataset";
                   owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lsweb:FileManifestation ; 
                                                            owl:onProperty lsweb:hasManifestation ; 
                                                            a owl:Restriction]
                                                            [owl:someValuesFrom rdfs:Literal ; 
                                                            owl:onProperty lslife:hasJSONExperimentSpecificationURL ; 
                                                            a owl:Restriction]
                                                            [owl:someValuesFrom rdfs:Literal ; 
                                                            owl:onProperty lslife:hasLayerUnits ; 
                                                            a owl:Restriction]
                                                            [owl:someValuesFrom xsd:integer ; 
                                                            owl:onProperty lslife:hasTypeCode ; 
                                                            a owl:Restriction]) ; 
                                        a owl:Class].
lslife:UnpostedScenario sio:comment "A scenario that has not been posted and is composed by some scenario layer and has a JSON experiment specification URL.";
                        a owl:Class;
                        rdfs:label "unposted scenario";
                        owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lslife:ScenarioLayer ; 
                                                                 owl:onProperty lslife:hasScenarioLayer ; 
                                                                 a owl:Restriction]
                                                                 [owl:someValuesFrom rdfs:Literal ; 
                                                                 owl:onProperty lslife:hasJSONExperimentSpecificationURL ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
lslife:WCSResponse sio:comment "A response obtained from a WCS server, including the response manifestation, the experiment specification URL, layer units and type code.";
                   a owl:Class;
                   rdfs:label "wcs response";
                   owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom lsweb:WCSResponseManifestation ; 
                                                            owl:onProperty lsweb:hasManifestation ; 
                                                            a owl:Restriction]
                                                            [owl:someValuesFrom rdfs:Literal ; 
                                                            owl:onProperty lslife:hasJSONExperimentSpecificationURL ; 
                                                            a owl:Restriction]
                                                            [owl:someValuesFrom rdfs:Literal ; 
                                                            owl:onProperty lslife:hasLayerUnits ; 
                                                            a owl:Restriction]
                                                            [owl:someValuesFrom xsd:integer ; 
                                                            owl:onProperty lslife:hasTypeCode ; 
                                                            a owl:Restriction]) ; 
                                        a owl:Class].
lslife:describesBehaviorOf a owl:ObjectProperty;
                           rdfs:domain lslife:ParameterDescriptions;
                           rdfs:label "describes behavior of";
                           rdfs:range lslife:LifemapperAlgorithm.
lslife:hasAlgorithmCode a owl:DatatypeProperty;
                        rdfs:domain lslife:LifemapperAlgorithm;
                        rdfs:label "has algorithm code";
                        rdfs:range rdfs:Literal.
lslife:hasDefaultValue a owl:DatatypeProperty;
                       rdfs:label "has default value".
lslife:hasExperimentResult a owl:ObjectProperty;
                           rdfs:label "has experiment result".
lslife:hasExperimentResultID a owl:DatatypeProperty;
                             rdfs:label "has experiment result id".
lslife:hasExperimentResultURL a owl:DatatypeProperty;
                              rdfs:label "has experiment result url".
lslife:hasExtractedPayload a owl:ObjectProperty;
                           rdfs:label "has extracted payload".
lslife:hasGenusName a owl:DatatypeProperty;
                    rdfs:domain lslife:Species;
                    rdfs:label "has genus name";
                    rdfs:range rdfs:Literal.
lslife:hasInputWCSDataset a owl:ObjectProperty;
                          rdfs:label "has input wcs dataset".
lslife:hasJSONExperimentSpecificationURL a owl:DatatypeProperty;
                                         rdfs:label "has json experiment specification  url".
lslife:hasLayerID a owl:DatatypeProperty;
                  rdfs:label "has layer id".
lslife:hasLayerURL a owl:DatatypeProperty;
                   rdfs:label "has layer url".
lslife:hasLayerUnits a owl:DatatypeProperty;
                     rdfs:label "has layer units".
lslife:hasLowerBoundInclusive a owl:DatatypeProperty;
                              rdfs:label "has lower bound inclusive".
lslife:hasModellingScenario a owl:ObjectProperty;
                            rdfs:label "has modelling scenario";
                            owl:inverseOf lslife:isModellingScenarioOf.
lslife:hasNumberOfOccurrences a owl:DatatypeProperty;
                              rdfs:domain lslife:SpeciesOccurrenceSet;
                              rdfs:label "has number of occurrences";
                              rdfs:range xsd:integer.
lslife:hasOccurrenceOfSpecies a owl:ObjectProperty;
                              rdfs:label "has occurrence of species";
                              rdfs:subPropertyOf lsweb:representsEntity.
lslife:hasOccurrenceSetID a owl:DatatypeProperty;
                          rdfs:domain lslife:SpeciesOccurrenceSet;
                          rdfs:label "has occurrence set id";
                          rdfs:range rdfs:Literal.
lslife:hasParameterClass a owl:DatatypeProperty;
                         rdfs:label "has parameter class".
lslife:hasParameterCollectionClass a owl:DatatypeProperty;
                                   rdfs:label "has parameter collection class".
lslife:hasParameterDescription a owl:ObjectProperty;
                               rdfs:domain lslife:ParameterDescriptions;
                               rdfs:label "has parameter description";
                               rdfs:range lslife:ParameterDescription.
lslife:hasPublishedLayer a owl:ObjectProperty;
                         rdfs:label "has published layer".
lslife:hasPublishedScenario a owl:ObjectProperty;
                            rdfs:label "has published scenario".
lslife:hasScenarioID a owl:DatatypeProperty;
                     rdfs:label "has scenario id".
lslife:hasScenarioLayer a owl:ObjectProperty;
                        rdfs:label "has scenario layer".
lslife:hasScenarioURL a owl:DatatypeProperty;
                      rdfs:label "has scenario url".
lslife:hasTypeCode a owl:DatatypeProperty;
                   rdfs:label "has type code".
lslife:hasUpperBoundInclusive a owl:DatatypeProperty;
                              rdfs:label "has upper bound inclusive".
lslife:hasWCSResponse a owl:ObjectProperty;
                      rdfs:label "has wcs response".
lslife:isModellingScenarioOf a owl:ObjectProperty;
                             rdfs:label "is modelling scenaio of".
lslife:isScenarioLayerOf a owl:ObjectProperty;
                         rdfs:label "is scenario layer of";
                         owl:inverseOf lslife:hasScenarioLayer.
lslife:specifiesModellingAlgorithm a owl:ObjectProperty;
                                   rdfs:label "specifies modelling algorithm";
                                   rdfs:range lslife:LifemapperAlgorithm.
lslife:specifiesModellingScenario a owl:ObjectProperty;
                                  rdfs:label "specifies modelling scenario".
lslife:specifiesOccurrenceSet a owl:ObjectProperty;
                              rdfs:label "specifies occurrence set".
lslife:specifiesProjectionScenario a owl:ObjectProperty;
                                   rdfs:label "specifies projection scenario".
