                                                                                                                             [<http://www.w3.org/2002/07/owl#onProperty> lslife:hasOccurrenceSetID ; 
                                                                                                                             <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                             a <http://www.w3.org/2002/07/owl#Class>].
lslife:TIFFDataset <http://semanticscience.org/resource/comment> "A dataset that is represented in TIFF format and provides the location where it can be retrieved, the units of the layers and the type code.";
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "tiff dataset";
                   <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#FileManifestation> ; 
                                                                                                                    <http://www.w3.org/2002/07/owl#onProperty> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasManifestation> ; 
