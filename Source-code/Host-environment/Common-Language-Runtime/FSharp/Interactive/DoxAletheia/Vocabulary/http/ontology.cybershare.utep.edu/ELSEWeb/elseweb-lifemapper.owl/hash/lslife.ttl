                                rdfs:label "species occurrence dataset";
                                rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#VectorDataset>;
                                <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:SpeciesOccurrenceLayer ; 
