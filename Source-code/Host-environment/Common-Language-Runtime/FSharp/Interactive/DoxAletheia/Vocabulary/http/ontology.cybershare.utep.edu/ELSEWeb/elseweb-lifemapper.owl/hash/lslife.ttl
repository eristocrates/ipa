                                                                                                         "Nicholas del Rio"@en;
                                                               <http://purl.org/dc/elements/1.1/description> """The ELSEWeb Lifemapper ontology provides classes for describing biodiversity modelling services provided by Lifemapper. This project provides  support for the ELSEWeb project(http://elseweb.cybershare.utep.edu/).
website: http://elseweb.cybershare.utep.edu/ontologies
email: nvillanuevarosales@utep.edu
"""@en;
                                                               <http://purl.org/dc/elements/1.1/issued> "2014-05-01"^^xsd:date;
                                                               <http://purl.org/dc/elements/1.1/rights> "free to use,share,modify. modify with attribution [http://creativecommons.org/licenses/by/3.0/].";
                                                               <http://purl.org/dc/elements/1.1/title> "ELSEWeb Lifemapper Ontology"@en;
                                                               <http://purl.org/dc/terms/identifier> "elseweb-lifemapper.owl";
                                                               <http://purl.org/dc/terms/modified> "2015-09-24"^^xsd:date;
                                                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "elseweb-lifemapper"@en;
                                                               <http://purl.org/vocab/vann/preferredNamespaceUri> "http://ontology.cybershare.utep.edu/ELSEWeb/";
                                                               a <http://www.w3.org/2002/07/owl#Ontology>;
                                                               rdfs:isDefinedBy <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl>;
                                                               <http://www.w3.org/2002/07/owl#imports> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl>,
                                                                                                       <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl>,
                                                                                                       <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper-parameters.owl>,
                                                                                                       <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl>;
                                                               <http://www.w3.org/2002/07/owl#versionIRI> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl>;
                                                               <http://www.w3.org/2002/07/owl#versionInfo> "1.2".
lslife:ExecutableExperimentSpecification <http://semanticscience.org/resource/comment> "An executable experiment specification specifies a modelling algorithm, a modelling scenario and an ocurrence set to generate a species distribution model.";
                                         a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:label "executable experiment specification";
                                         <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:LifemapperAlgorithm ; 
                                                                                                                                          <http://www.w3.org/2002/07/owl#onProperty> lslife:specifiesModellingAlgorithm ; 
                                                                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                                          [<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:ModellingScenario ; 
                                                                                                                                          <http://www.w3.org/2002/07/owl#onProperty> lslife:specifiesModellingScenario ; 
                                                                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                                          [<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:SpeciesOccurrenceSet ; 
                                                                                                                                          <http://www.w3.org/2002/07/owl#onProperty> lslife:specifiesOccurrenceSet ; 
                                                                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                          a <http://www.w3.org/2002/07/owl#Class>].
lslife:ExecutedExperimentSpecification <http://semanticscience.org/resource/comment> "An executed experiment specification provides an experiment result.";
                                       a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:label "executed experiment specification";
                                       rdfs:subClassOf lslife:ExecutableExperimentSpecification;
                                       <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:ExperimentResult ; 
                                                                                        <http://www.w3.org/2002/07/owl#onProperty> lslife:hasExperimentResult ; 
                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>].
lslife:ExecutedWCSDataset <http://semanticscience.org/resource/comment> "A dataset that is the output of a WCS service.";
                          a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:label "executed wcs dataset";
                          rdfs:subClassOf lslife:InputWCSDataset;
                          <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:WCSResponse ; 
                                                                           <http://www.w3.org/2002/07/owl#onProperty> lslife:hasWCSResponse ; 
                                                                           a <http://www.w3.org/2002/07/owl#Restriction>].
lslife:ExperimentResult a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "An experiment result provides a result ID and a URL where the result of an experiment can be retrieved.";
                        rdfs:label "experiment result";
                        <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                                                                                                         <http://www.w3.org/2002/07/owl#onProperty> lslife:hasExperimentResultID ; 
                                                                                                                         a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                                                                                                         <http://www.w3.org/2002/07/owl#onProperty> lslife:hasExperimentResultURL ; 
                                                                                                                         a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                         a <http://www.w3.org/2002/07/owl#Class>].
lslife:ExtractedWCSResponse <http://semanticscience.org/resource/comment> "The TIFF dataset that contains the extracted payload from a WCS response.";
                            a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:label "extracted wcs response";
                            rdfs:subClassOf lslife:WCSResponse;
                            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:TIFFDataset ; 
                                                                             <http://www.w3.org/2002/07/owl#onProperty> lslife:hasExtractedPayload ; 
                                                                             a <http://www.w3.org/2002/07/owl#Restriction>].
lslife:InputWCSDataset <http://semanticscience.org/resource/comment> "A dataset that is required as an input to a WCS service.";
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:label "input wcs dataset";
                       <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#BoxedGeographicRegion> ; 
                                                                                                                        <http://www.w3.org/2002/07/owl#onProperty> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#coversRegion> ; 
                                                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#RGISWCSManifestation> ; 
                                                                                                                        <http://www.w3.org/2002/07/owl#onProperty> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#hasManifestation> ; 
                                                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                                                                                                        <http://www.w3.org/2002/07/owl#onProperty> lslife:hasJSONExperimentSpecificationURL ; 
                                                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                                                                                                        <http://www.w3.org/2002/07/owl#onProperty> lslife:hasLayerUnits ; 
                                                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:integer ; 
                                                                                                                        <http://www.w3.org/2002/07/owl#onProperty> lslife:hasTypeCode ; 
                                                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                        a <http://www.w3.org/2002/07/owl#Class>].
lslife:InputWCSDatasetExperimentSpecification <http://semanticscience.org/resource/comment> "An experiment specification that provides an input wcs dataset.";
                                              a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:label "input wcs dataset experiment specification";
                                              rdfs:subClassOf lslife:JSONExperimentSpecification;
                                              <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:InputWCSDataset ; 
                                                                                               <http://www.w3.org/2002/07/owl#onProperty> lslife:hasInputWCSDataset ; 
                                                                                               a <http://www.w3.org/2002/07/owl#Restriction>].
lslife:JSONExperimentSpecification <http://semanticscience.org/resource/comment> "The location of an experiment specification in the JSON format.";
                                   a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:label "json experiment specification";
                                   <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                                                                    <http://www.w3.org/2002/07/owl#onProperty> lslife:hasJSONExperimentSpecificationURL ; 
                                                                                    a <http://www.w3.org/2002/07/owl#Restriction>].
lslife:Layer <http://semanticscience.org/resource/comment> "A unit of data (i.e. dataset) that is used as a component of a scenario specification.";
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "layer";
             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                                                                                              <http://www.w3.org/2002/07/owl#onProperty> lslife:hasJSONExperimentSpecificationURL ; 
                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                              [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:integer ; 
                                                                                                              <http://www.w3.org/2002/07/owl#onProperty> lslife:hasLayerID ; 
                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                              [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                                                                                              <http://www.w3.org/2002/07/owl#onProperty> lslife:hasLayerURL ; 
                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                              a <http://www.w3.org/2002/07/owl#Class>].
lslife:LifemapperAlgorithm <http://semanticscience.org/resource/comment> "A species modelling algorithm provided by lifemapper that is controlled by lifemapper parameters.";
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:label "lifemapper algorithm";
                           rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingAlgorithm>;
                           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:LifemapperParameters ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#onProperty> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#behaviorControlledBy> ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                            [<http://www.w3.org/2002/07/owl#onProperty> lslife:hasAlgorithmCode ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>].
lslife:LifemapperParameter <http://semanticscience.org/resource/comment> "A species modelling parameter that controls the behavior of a lifemapper algorithm.";
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:label "lifemapper parameter";
                           rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingParameter>;
                           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#onProperty> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#boundToValue> ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                            [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#onProperty> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#hasParameterName> ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>].
lslife:LifemapperParameters <http://semanticscience.org/resource/comment> "A set of parameters that controls the behaviour of a specific lifemapper algorithm.";
                            a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:label "lifemapper parameters";
                            rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingParameters>;
                            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:LifemapperParameter ; 
                                                                             <http://www.w3.org/2002/07/owl#onProperty> <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#hasParameterMember> ; 
                                                                             a <http://www.w3.org/2002/07/owl#Restriction>].
lslife:LifemapperSoftware <http://semanticscience.org/resource/comment> "A species modelling software provided by lifemapper.";
                          a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:label "lifemapper software";
                          rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingSoftware>.
lslife:ModellingScenario <http://semanticscience.org/resource/comment> "A modelling scenario provides the specification of an experiment that can be executed.";
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "modelling scenario";
                         rdfs:subClassOf lslife:Scenario;
                         <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:ExecutableExperimentSpecification ; 
                                                                          <http://www.w3.org/2002/07/owl#onProperty> lslife:isModellingScenarioOf ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>].
lslife:ParameterDescription <http://semanticscience.org/resource/comment> "The description of an algorithm parameter.";
                            a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:label "parameter description";
                            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:anyURI ; 
                                                                                                                             <http://www.w3.org/2002/07/owl#onProperty> lslife:hasParameterClass ; 
                                                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                             [<http://www.w3.org/2002/07/owl#onProperty> lslife:hasLowerBoundInclusive ; 
                                                                                                                             <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                             [<http://www.w3.org/2002/07/owl#onProperty> lslife:hasUpperBoundInclusive ; 
                                                                                                                             <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                             a <http://www.w3.org/2002/07/owl#Class>].
lslife:ParameterDescriptions <http://semanticscience.org/resource/comment> "A set of parameter descriptions.";
                             a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:label "parameter descriptions";
                             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:LifemapperAlgorithm ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#onProperty> lslife:describesBehaviorOf ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                              [<http://www.w3.org/2002/07/owl#onProperty> lslife:hasParameterDescription ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#onClass> lslife:ParameterDescription ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "0"^^xsd:nonNegativeInteger ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                              [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:anyURI ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#onProperty> lslife:hasParameterCollectionClass ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                              a <http://www.w3.org/2002/07/owl#Class>].
lslife:PostedScenario <http://semanticscience.org/resource/comment> "A scenario that has been posted.";
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "posted scenario";
                      rdfs:subClassOf lslife:UnpostedScenario;
                      <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:Scenario ; 
                                                                       <http://www.w3.org/2002/07/owl#onProperty> lslife:hasPublishedScenario ; 
                                                                       a <http://www.w3.org/2002/07/owl#Restriction>].
lslife:PostedTIFFDataset a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A TIFF dataset with information about the layers it contains.";
                         rdfs:label "posted tiff dataset";
                         rdfs:subClassOf lslife:TIFFDataset;
                         <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:Layer ; 
                                                                          <http://www.w3.org/2002/07/owl#onProperty> lslife:hasPublishedLayer ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>].
lslife:Scenario <http://semanticscience.org/resource/comment> "A modelling scenario that provides the URL of the specification, an scenario ID and a URL where it can be retrieved.";
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "scenario";
                rdfs:subClassOf lslife:Scenario;
                <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> lslife:hasJSONExperimentSpecificationURL ; 
                                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:integer ; 
                                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> lslife:hasScenarioID ; 
                                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> lslife:hasScenarioURL ; 
                                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                 a <http://www.w3.org/2002/07/owl#Class>].
lslife:ScenarioLayer <http://semanticscience.org/resource/comment> "A layer that composes a scenario.";
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "scenario layer";
                     rdfs:subClassOf lslife:Layer;
                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> lslife:UnpostedScenario ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> lslife:isScenarioLayerOf ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>].
lslife:Species <http://semanticscience.org/resource/comment> "A group of living organisms which is the principal natural taxonomic unit.",
                                                             "Erinus alpinus";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "species";
               rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#Entity>;
               <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> lslife:hasGenusName ; 
                                                                <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                a <http://www.w3.org/2002/07/owl#Restriction>].
