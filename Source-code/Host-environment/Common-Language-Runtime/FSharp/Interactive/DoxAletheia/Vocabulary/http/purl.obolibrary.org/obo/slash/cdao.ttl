cdao:OBI_0000399 cdao:IAO_0000111 "solid support function";
                 cdao:IAO_0000112 "Taped, glued, pinned, dried or molecularly bonded to a solid support";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A solid support function is a function of a device on which an entity is kept in a defined position and prevented in its movement"@en;
