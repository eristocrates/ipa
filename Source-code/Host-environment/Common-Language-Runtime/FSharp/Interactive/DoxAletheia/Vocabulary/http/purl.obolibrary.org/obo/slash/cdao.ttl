cdao:OBI_0302885 cdao:IAO_0000111 "filtration";
                 cdao:IAO_0000112 "PMID: 18524968.Filtration of CSF improves isolation of Mycobacteria.J Clin Microbiol. 2008 Jun 4."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "filtration is a process which separates components suspended in a fluid based on granularity properties relying on a filter device"@en;
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "OBI-Branch: adapted from wikipedia and wordnet";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "filtration"@en;
