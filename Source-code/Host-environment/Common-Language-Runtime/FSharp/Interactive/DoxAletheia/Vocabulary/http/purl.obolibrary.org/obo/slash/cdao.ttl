                 cdao:IAO_0000117 "Trish Whetzel"@en;
                 cdao:IAO_0000119 "MO"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "vacuum dryer"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000383 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0002089,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000370 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000401 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400118 cdao:IAO_0000111 "vortexer"@en;
                 cdao:IAO_0000112 "VWR  Genie 2"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A vortexer is an instrument that mixes small vials of liquid by creating a rotation of the liquid around its own center. It consists of an electric motor with the drive shaft oriented vertically and attached to a cupped rubber piece mounted slightly off-center. As the motor runs the rubber piece oscillates rapidly in a circular motion. When a test tube or other appropriate container is pressed into the rubber cup (or touched to its edge) the motion is transmitted to the liquid inside and a vortex is created."@en;
                 cdao:IAO_0000117 "Melanie Courtot"@en,
                                  "Trish Whetzel"@en;
                 cdao:IAO_0000118 "vortex_mixer"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Vortex_mixer"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "vortexer"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000377 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0001033.
cdao:OBI_0400119 cdao:IAO_0000111 "microarray wash station"@en;
                 cdao:IAO_0000112 "ArrayIt(r) Microarray Wash Station"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a device that is used to wash Affymetrix-type arrays."@en;
                 cdao:IAO_0000117 "Trish Whetzel"@en;
                 cdao:IAO_0000119 "MO_626 wash_station"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "microarray wash station"@en;
                 rdfs:subClassOf cdao:OBI_0002089,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000401 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400120 cdao:IAO_0000111 "temperature control bath"@en;
                 cdao:IAO_0000112 "VWR Signature Deep-Chamber Heated Water Bath. A water bath is used for temperatures up to 100 degrees C. An oil bath is employed for temperatures over 100 degrees C."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A temperature_control_bath is a device that has the function to regulate the temperature of a material, the function to contain fluid and the function to vary and maintain the temperature of the contained fluid. Heat exchange (energy transfer) between the material and the heating element is facilitated via the contained fluid. A temperature_control_bath is composed of a container, a heating element and/or a cooling element and a means to adjust the needed temperature. In most cases also a timer and a means to stir the fluid is provided as well."@en;
                 cdao:IAO_0000117 "Frank Gibson",
                                  "Alan Ruttenburg",
                                  "Daniel Schober";
                 cdao:IAO_0000119 "OBI Instrument branch";
                 cdao:IAO_0000232 "DS: This was heated_bath. It was renamed to reflect the possability that the same bath can be used for cooling. We can now define the temperature variables and based on that infer if it is a cooling device or a heating device (also quite relative to surrounding temperature)."@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "temperature control bath"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000370 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000401 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0002089.
cdao:OBI_0400121 cdao:IAO_0000111 "molecular crosslinker"@en;
                 cdao:IAO_0000112 "Stratalinker"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "a device that is able to chemically join two or more molecules."@en;
                 cdao:IAO_0000116 """AL: if we intend that other ontologies can be used in conjunction with OBI, we shouldn't have such a general term used specifically for chemically joining two or more molecules. I'm sure there are other \"crosslinkers\" that are on a much different scale in engineering etc. I have moved the original label to be an alternative term, and have renamed the main label accordingly."""@en;
                 cdao:IAO_0000117 "Trish Whetzel"@en;
                 cdao:IAO_0000118 "molecular crosslinker"@en;
                 cdao:IAO_0000119 "MO ?? cannot be found in MO"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "molecular crosslinker"@en;
                 rdfs:subClassOf cdao:OBI_0001032,
                                 cdao:OBI_0002089,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000367 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000401 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400135 cdao:IAO_0000111 "image cytometer"@en;
                 cdao:IAO_0000112 "The most common current application of image cytometry is for DNA analysis, followed by quantitation of immunohistochemical staining."@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An image_cytometer is an instrument for image-based study or measurement of cells."@en;
                 cdao:IAO_0000117 "Melanie Courtot"@en;
                 cdao:IAO_0000119 "http://web.mit.edu/solab/Research/ImageCytometry.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "image cytometer"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400082 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000397 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400079 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000398,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400065 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400137 cdao:IAO_0000111 "cytometer"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A cytometer is an instrument for counting and measuring cells."@en;
                 cdao:IAO_0000117 "Melanie Courtot"@en;
                 cdao:IAO_0000119 "http://medical.merriam-webster.com/medical/cytometer"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "cytometer"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000453 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400065 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400079 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400082 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 cdao:OBI_0000832.
cdao:OBI_0400140 cdao:IAO_0000111 "gel tank"@en;
                 cdao:IAO_0000112 "CHEF gel box, slab gel box, capillary electrophoresis"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "a device which holds a gel and running buffers to allow electrophoresis to be performed. A gel tank has the function to contain and to control the contained environment and transfer energy from an energy supply through the running buffers to the gel matrix and the material with charged molecules in an electric field across a porous matrix or medium with the objective to separate the charged molecules."@en;
                 cdao:IAO_0000117 "Person:Kevin Clancy"@en,
                                  "Person:Frank Gibson";
                 cdao:IAO_0000118 "electrophoresis box"@en,
                                  "electrophoresis unit"@en;
                 cdao:IAO_0000119 "sep:00095"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "gel tank"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000370 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0002089,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000401 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400142 cdao:IAO_0000111 "power supply"@en;
                 cdao:IAO_0000112 "A AC/DC transformer that generates the reqired power for an electrophoresis apparatus"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A power supply is an device or part of a device that permits the required application of a defined electrical charge to an instrument. The power supply may permit the defined application of a given amount of current for a defined length of time."@en;
                 cdao:IAO_0000117 "Frank Gibson",
                                  "Daniel Schober"@en;
                 cdao:IAO_0000118 "power pack"@en,
                                  "PSU"@en,
                                  "power supply unit"@en,
                                  "electrical power supply"@en;
                 cdao:IAO_0000119 "sep:00093",
                                  "PERSON: Daniel Schober"@en;
                 cdao:IAO_0000232 "was power_pack, maps to SEP electrical_power_supply"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "power supply"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000384 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000968.
cdao:OBI_0400143 cdao:IAO_0000111 "fluorometer"@en;
                 cdao:IAO_0000112 "laser/detector in capillary electrophoresis apparatus, NanoDrop ND-3300"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A fluorometer is an instrument for the detection and measurement of parameters of fluoresence, which in turn are used to identify the presence and amount of specific molecules in the sample."@en;
                 cdao:IAO_0000117 "Kevin Lister"@en,
                                  "Allyson Lister"@en;
                 cdao:IAO_0000119 "OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "fluorometer"@en;
                 rdfs:subClassOf cdao:OBI_0400115.
cdao:OBI_0400146 cdao:IAO_0000111 "multispectral imaging flow cytometer"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A multispectral_imaging_flow_cytometer is an instrument which combines quantitative image analysis and flow cytometry in a single platform. It measures the amount, location and movement of molecules on, in, or between cells, and  the location and co-localization of multiple markers on or in cells. It can also quantitate morphologically distinct cell subpopulations."@en;
                 cdao:IAO_0000117 "Melanie Courtot"@en;
                 cdao:IAO_0000118 "MIFC"@en;
                 cdao:IAO_0000119 "http://www.amnis.com/"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "multispectral imaging flow cytometer"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000392 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000398,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400044 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000397 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400147 cdao:IAO_0000111 "microarray"@en;
                 cdao:IAO_0000112 "An affymetrix U133 array is a microarray. Microarrays include 1 and 2-color arrays, custom and commercial arrays (e.g, Affymetrix, Agilent, Nimblegen, Illumina, etc.) for expression profiling, DNA variant detection, protein binding, and other genomic and functional genomic assays.";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A processed material that is made to be used in an analyte assay. It consists of a physical immobilisation matrix in which substances that bind the analyte are placed in regular spatial position."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000119 "PERSON: Chris Stoeckert";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "microarray"@en;
                 rdfs:subClassOf cdao:OBI_0001865.
cdao:OBI_0400148 cdao:IAO_0000111 "DNA microarray"@en;
                 cdao:IAO_0000112 """Moran G, Stokes C, Thewes S, Hube B, Coleman DC, Sullivan D (2004). \"Comparative genomics using Candida albicans DNA microarrays reveals absence and divergence of virulence-associated genes in Candida dubliniensis\". Microbiology 150: 3363-3382. doi:10.1099/mic.0.27221-0. PMID 15470115"""@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A DNA-microarray is a microarray that is used as a physical 2D immobilisation matrix for DNA sequences. DNA microarray-bound DNA fragments are used as targets for a hybridising probed sample."@en;
                 cdao:IAO_0000117 "PERSON: Frank Gibson",
                                  "PERSON: Daniel Schober"@en;
                 cdao:IAO_0000118 "DNA Chip"@en,
                                  "DNA-array"@en;
                 cdao:IAO_0000119 "Web:<http://en.wikipedia.org/wiki/DNA_microarray>@2008/03/03";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "DNA microarray"@en;
                 rdfs:subClassOf cdao:OBI_0400147.
cdao:OBI_0400149 cdao:IAO_0000111 "protein microarray"@en;
                 cdao:IAO_0000112 "The most common protein microarray is the antibody microarray, where antibodies are spotted onto the protein chip and are used as capture molecules to detect proteins from cell lysate solutions."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A protein-microarray is a microarray, ususlly a piece of glass, on which different molecules of protein have been affixed at separate locations in an ordered manner. These are used to identify protein-protein or protein-small molecule interactions."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000119 "PERSON: Daniel Schober";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "protein microarray"@en;
                 rdfs:subClassOf cdao:OBI_0400147.
cdao:OBI_0400153 cdao:IAO_0000111 "droplet sorter"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 """A droplet sorter is part_of a flow cytometer sorter that converts the carrier fluid stream into individual droplets, and these droplets are directed into separate locations for recovery (enriching the original
sample for particles of interest based on qualities determined by gating) or disposal."""@en;
                 cdao:IAO_0000117 "OBI Instrument branch";
                 cdao:IAO_0000119 "OBI Instrument branch";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "droplet sorter"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000403 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000932.
cdao:OBI_0400155 cdao:IAO_0000111 "water bath"@en;
                 cdao:IAO_0000112 "A water bath was used to allow for cell incubation at 38 degree centigrade for 8 hours."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A water bath is a temperature control bath in which a water acts as contact medium enabling temperature transfer from the heating element or cooling element to the sample. The temperature can be controlled in the 0 to 100 degree centigrade range (under normal pressure)."@en;
                 cdao:IAO_0000117 "Daniel Schober";
                 cdao:IAO_0000119 "PERSON: Daniel Schober";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "water bath"@en;
                 rdfs:subClassOf cdao:OBI_0400120.
cdao:OBI_0400157 cdao:IAO_0000111 "oil bath"@en;
                 cdao:IAO_0000112 "An oil bath was used to allow for fast reaction of two chemical compounds during a 2 hour period."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An oil bath is a temperature control bath in which oil acts as contact medium for the temperature transfer (from heating or cooling elements to the sample)."@en;
                 cdao:IAO_0000117 "Daniel Schober";
                 cdao:IAO_0000119 "PERSON: Daniel Schober";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "oil bath"@en;
                 rdfs:subClassOf cdao:OBI_0400120.
cdao:OBI_0400158 cdao:IAO_0000111 "digital-to-analog converter"@en;
                 cdao:IAO_0000112 "A digital-to-analog_converter is used to convert a computergenerated discrete signal into a continuous analog one, e.g. a sound."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A digital-to-analog_converter is an instrument that converts a finite resolution digital signal into an infinite resolution analog signal."@en;
                 cdao:IAO_0000117 "Daniel Schober";
                 cdao:IAO_0000119 "PERSON: Daniel Schober";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "digital-to-analog converter"@en;
                 rdfs:subClassOf cdao:OBI_0000968,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000393 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400168 cdao:IAO_0000111 "microtome"@en;
                 cdao:IAO_0000112 "PMID: 9974145.Serial sectioning of thick tissue with a novel vibrating blade microtome. Brain Res Brain Res Protoc. 1999 Jan;3(3):302-7."@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A microtome is a mechanical instrument used to cut biological specimens into very thin segments for further treatment (e.g. ISH) and ultimately microscopic or histologic examination. Most microtomes provide cooling facilities (cryo-microtome) and use a steel blade to cut a slice of defined thickness. Some are automatic, and some are driven by hand."@en;
                 cdao:IAO_0000117 "PERSON: Phillippe Rocca-Serra";
                 cdao:IAO_0000119 "PERSON: Daniel Schober";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "microtome"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000372 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000379 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000932.
cdao:OBI_0400169 cdao:IAO_0000111 "microscope"@en;
                 cdao:IAO_0000112 "PMID:18466942. A light and transmission electron microscope study of hepatic portal tracts in the rhesus monkey (Macacus rhesus). Tissue Cell. 2008 May 6"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A microscope is an instrument which magnifies the view on objects (too small to be viewed by the naked eye) under increased resolution. A microscope can be an optical instrument but also and electronic instrument. There are various kind of optical microscopes, e.g confocal microscope, epifluoresence microscope)"@en;
                 cdao:IAO_0000117 "PERSON: Phillippe Rocca-Serra";
                 cdao:IAO_0000119 "wikipedia";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "microscope"@en;
                 rdfs:subClassOf cdao:OBI_0000398,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000397 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000369 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
