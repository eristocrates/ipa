cdao:OBI_0000398 cdao:IAO_0000111 "image acquisition device"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An image creation device is a device which captures a digitized image of an object"@en;
