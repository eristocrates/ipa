                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A menopausal status indicating that it has been 6-12 months since last menstrual period.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
