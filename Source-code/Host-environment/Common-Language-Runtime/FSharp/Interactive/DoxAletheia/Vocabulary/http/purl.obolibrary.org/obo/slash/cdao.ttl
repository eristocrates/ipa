                    rdfs:label "right cerebral hemisphere";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0003688 cdao:IAO_0000111 "omentum";
                    cdao:IAO_0000115 "A fold of peritoneum originating at the stomach and supporting the viscera.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "omentum";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0004648 cdao:IAO_0000111 "esophagus muscularis mucosa";
                    cdao:IAO_0000115 "A muscularis mucosa that is part of a esophagus.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "esophagus muscularis mucosa";
