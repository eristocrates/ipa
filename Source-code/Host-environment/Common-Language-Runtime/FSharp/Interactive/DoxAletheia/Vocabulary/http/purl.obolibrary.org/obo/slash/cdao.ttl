cdao:OBI_0000796 cdao:IAO_0000111 "purification objective";
                 cdao:IAO_0000112 "the objective to obtain a pure fraction of a specific peptide when running an HPLC on a crude synthesis of peptides.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "The objective to separate a material entity into different compositions of which one or more have are purified fractions that contain higher concentration of a desired component, while others contain impurities and are not of interest";
                 cdao:IAO_0000117 "PERSON:Bjoern Peters";
                 cdao:IAO_0000118 "isolation objective";
