cdao:OBI_0000401 cdao:IAO_0000111 "environment control function"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An environmental control function is a function that regulates a contained environment within specified parameter ranges. For example the control of light exposure, humidity and temperature."@en;
                 cdao:IAO_0000117 "Daniel Schober",
                                  "Melanie Courtot",
                                  "Frank Gibson",
                                  "Bill Bug";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "environment control function"@en;
                 rdfs:subClassOf cdao:BFO_0000034.
cdao:OBI_0000403 cdao:IAO_0000111 "sort function"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A sort function is a function to distinguish material components based on some associated physical quality or entity and to partition the separate components into distinct fractions according to a defined order."@en;
                 cdao:IAO_0000117 "Melanie Courtot",
                                  "Frank Gibson",
                                  "Daniel Schober";
                 a <http://www.w3.org/2002/07/owl#Class>;
