cdao:GO_0048869 cdao:IAO_0000111 "cellular developmental process";
                cdao:IAO_0000115 "A biological process whose specific outcome is the progression of a cell over time from an initial condition to a later condition.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "cellular developmental process";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0050896 cdao:IAO_0000111 "response to stimulus";
                cdao:IAO_0000115 "Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a stimulus. The process begins with detection of the stimulus and ends with a change in state or activity or the cell or organism.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "response to stimulus";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0051276 cdao:IAO_0000111 "chromosome organization";
                cdao:IAO_0000115 "A process that is carried out at the cellular level that results in the assembly, arrangement of constituent parts, or disassembly of chromosomes, structures composed of a very long molecule of DNA and associated proteins that carries hereditary information. This term covers covalent modifications at the molecular level as well as spatial relationships among the major components of a chromosome.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "chromosome organization";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0070358 cdao:IAO_0000111 "actin polymerization-dependent cell motility";
