                                 cdao:REO_0000280.
cdao:CHEBI_16670 cdao:IAO_0000111 "peptide";
                 cdao:IAO_0000115 "Amide derived from two or more amino carboxylic acid molecules (the same or different) by formation of a covalent bond from the carbonyl carbon of one to the nitrogen atom of another with formal loss of water. The term is usually applied to structures formed from alpha-amino acids, but it includes those derived from any amino carboxylic acid. X = OH, OR, NH2, NHR, etc.";
                 cdao:IAO_0000412 cdao:chebi.owl;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "peptide";
                 rdfs:subClassOf cdao:CHEBI_33839.
