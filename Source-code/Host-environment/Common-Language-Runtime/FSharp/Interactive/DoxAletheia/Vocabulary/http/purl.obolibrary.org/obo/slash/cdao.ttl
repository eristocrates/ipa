cdao:OBI_0000562 cdao:IAO_0000111 "anion trap column"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An anion trap column is a trap column and ion-exchange column which contains cationic anion-exchange resins."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01277",
