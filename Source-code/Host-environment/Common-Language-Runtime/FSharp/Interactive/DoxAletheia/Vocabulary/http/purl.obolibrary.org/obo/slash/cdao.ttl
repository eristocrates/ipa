                                                                      cdao:OBI_0000245) ; 
                             a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0000648 cdao:IAO_0000111 "clustered data set";
                 cdao:IAO_0000112 "A clustered data set is the output of a K means clustering data transformation";
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A data set that is produced as the output of a class discovery data transformation and consists of a data set with assigned discovered class labels."@en;
                 cdao:IAO_0000117 "PERSON: Monnie McGee",
                                  "PERSON: James Malone";
                 cdao:IAO_0000118 "data set with assigned discovered class labels";
                 cdao:IAO_0000232 "AR thinks could be a data item instead";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "clustered data set"@en;
                 rdfs:subClassOf cdao:IAO_0000100;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200175 ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0000649 cdao:IAO_0000111 "data set of features";
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A data set that is produced as the output of a descriptive statistical calculation data transformation and consists of producing a data set that represents one or more features of interest about the input data set."@en;
                 cdao:IAO_0000117 "PERSON: Monnie McGee",
                                  "PERSON: James Malone";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "data set of features"@en;
                 rdfs:subClassOf cdao:IAO_0000100;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200184 ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0000650 cdao:IAO_0000111 "differential expression analysis data transformation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A differential expression analysis data transformation is a data transformation that has an objective of differential expression analysis.  Frequently this data transformation involves summarizing or otherwise aggregating signals from various samples categorized into groups, and calculating measures of group differences from these aggregated signals."@en;
                 cdao:IAO_0000117 "Melanie Courtot"@en,
                                  "Dan Berrios",
                                  "Monnie McGee"@en,
                                  "James Malone"@en;
                 cdao:IAO_0000119 "WEB:"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "differential expression analysis data transformation"@en;
                 rdfs:subClassOf cdao:OBI_0200000;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200031 ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0000651 cdao:IAO_0000111 "urine specimen";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a portion of urine collected from an organism";
                 cdao:IAO_0000116 "are we happy calling collection of urine a material separation?",
                                  "This could be instead a kind of collection of secreted stuff. Among secreted stuff there is passive, and active. urine is secreted, passiv.  lavage is secreted, active",
                                  "4/10/2011BP: It seems to me that the editor notes refer to a previous version, and are no longer relevant. ";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "urine specimen";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0600005 ; 
