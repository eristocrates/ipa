                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A measurement datum which is the result of combining multiple datum. For example, a mean or summary score. "@en;
                 cdao:IAO_0000116 "JT:  We included this because we wanted to talk about an output from a questionnaire that summarized the answers to the questionnaire, but which was not actually the answer to any single question. "@en;
                 cdao:IAO_0000117 "Person: Jessica Turner"@en;
                 cdao:IAO_0000118 "questionaire score";
                 cdao:IAO_0000119 "Person: Jessica Turner"@en;
                 cdao:IAO_0000232 "JZ: can we defined it logically as the output of some data transformation, like aggragate data transformation?"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "scalar score from composite inputs";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200000 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000004 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000032.
