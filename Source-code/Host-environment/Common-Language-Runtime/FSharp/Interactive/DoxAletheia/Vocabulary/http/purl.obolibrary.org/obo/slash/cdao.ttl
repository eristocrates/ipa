                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Adjuvant role is a role that inheres in a material entity and which is realized through a process of modifying a biological response."@en;
                 cdao:IAO_0000117 "IEDB"@en;
                 cdao:IAO_0000118 "adjuvent role";
