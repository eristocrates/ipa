                 a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                   <http://www.w3.org/2002/07/owl#Thing>;
                 rdfs:label "obsolete_manufacturer role of Bruker Daltonics";
                 <http://www.w3.org/2002/07/owl#deprecated> true.
cdao:OBI_0000854 cdao:IAO_0000111 "western blot analysis";
                 cdao:IAO_0000112 "Running a cell lysate on an acrylamide gel in a western blot aparatus to separate the constituent proteins, followed by transfer of the proteins from the gel to a nitrocellulose membrane. Staining this membrane with specific antibodies to detect the presence of specific proteins of interest.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An analyte assay that detects specific peptides in an input material by separating it using gel electrophoresis, transfering the separated molecules to a membrane, and staining them with_ antibodies specific to the analyte molecules.";
                 cdao:IAO_0000117 "IEDB",
                                  "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "Philippe Rocca-Serra",
                                  "IEDB";
                 a <http://www.w3.org/2002/07/owl#Class>;
