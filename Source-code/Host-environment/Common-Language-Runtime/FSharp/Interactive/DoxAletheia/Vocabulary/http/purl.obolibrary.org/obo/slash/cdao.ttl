cdao:OBI_0000800 cdao:IAO_0000111 "cross linking";
                 cdao:IAO_0000112 "cross linking can be used as a probe to link proteins together, to check protein protein interactions";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A process in which bonds are created that link one polymer to another";
                 cdao:IAO_0000117 "PERSON: Chris Stoeckert";
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Cross-link";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "cross linking";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000456 ; 
