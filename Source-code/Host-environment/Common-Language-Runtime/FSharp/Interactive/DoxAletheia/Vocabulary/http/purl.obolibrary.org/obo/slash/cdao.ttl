                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0000415
                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0600028 ; 
                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0002087 ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
