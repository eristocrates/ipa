                 rdfs:label "energy supply function"@en;
                 rdfs:subClassOf cdao:BFO_0000034.
cdao:OBI_0000392 cdao:IAO_0000111 "information processor function"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An information processor function is a function that converts information from one form to another, by a lossless process or an extraction process."@en;
                 cdao:IAO_0000117 "Frank Gibson";
                 cdao:IAO_0000118 "data processor function"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
