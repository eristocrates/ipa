cdao:UO_0000102 cdao:IAO_0000111 "nanoliter";
                cdao:IAO_0000115 "A volume unit which is equal to one thousandth of one millionth of a liter or 10^[-9] L.";
                cdao:IAO_0000118 "nl";
                cdao:IAO_0000412 cdao:uo.owl;
