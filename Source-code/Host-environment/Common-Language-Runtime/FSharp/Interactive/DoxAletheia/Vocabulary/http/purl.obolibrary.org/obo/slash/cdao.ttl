                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A processed material which measures gamma radiation"@en;
                 cdao:IAO_0000117 "Frank Gibson"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Gamma_counter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
