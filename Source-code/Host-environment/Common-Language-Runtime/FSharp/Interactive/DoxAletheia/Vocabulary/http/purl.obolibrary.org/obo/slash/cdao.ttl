                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:isDefinedBy cdao:iao.owl;
                 rdfs:label "has associated axiom(nl)"@en.
cdao:IAO_0000602 cdao:IAO_0000111 "has associated axiom(fol)"@en;
