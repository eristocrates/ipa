                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A menopausal status indicating that it has been more than 12 months since the last menstrual period with no prior hysterectomy or that there has been a prior bilateral oophorectomy.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "NCI BBRB, OBIB";
                 cdao:IAO_0000234 "NCI BBRB";
