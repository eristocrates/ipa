cdao:OBI_0000575 cdao:IAO_0000111 "Bruker Ultrastabilized NMR magnet"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An NMR magnet manufactured by Bruker for Ultra-High Field NMR, available from 750 MHz to 900 MHz, which provides reliable operation at reduced temperature and ambient pressure via being rigidly mounted and stabilized."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
