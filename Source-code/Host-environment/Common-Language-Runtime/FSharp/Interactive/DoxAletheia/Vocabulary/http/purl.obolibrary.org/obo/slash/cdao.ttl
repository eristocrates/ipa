cdao:OBI_0000875 cdao:IAO_0000111 "viral hemagglutination inhibition assay";
                 cdao:IAO_0000112 "Examining the ability of a monoclonal antibody to inhibit hemagglutination by Influenza A virus by comparing the levels of hemagglutination with and without the presence of the antibody.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An assay that measures the ability of an evaluant to inhibit hemagglutination by a virus. Hemagglutinin is a viral protein which binds to sialic acid receptors on cells or to erythrocytes, causing the cells to clump. Loss of clumping indicates hemagglutination inhibition by the evaluant.";
                 cdao:IAO_0000117 "Bjoern Peters",
                                  "Melanie Courtot",
                                  "Randi Vita";
                 cdao:IAO_0000118 "biological activity",
                                  "viral haemagglutinin inhibition assay",
                                  "hemagglutination inhibition",
                                  "HAI",
                                  "HIA";
                 cdao:IAO_0000119 "OBI branch derived";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "viral hemagglutination inhibition assay";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0000086
                                                                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:NCBITaxon_10239 ; 
