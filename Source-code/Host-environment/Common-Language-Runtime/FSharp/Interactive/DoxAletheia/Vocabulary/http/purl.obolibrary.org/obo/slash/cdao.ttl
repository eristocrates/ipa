                                 cdao:OBI_0000734.
cdao:OBI_0000696 cdao:IAO_0000111 "AB SOLiD System";
                 cdao:IAO_0000112 "PMID: 19336255. RNA-Seq-quantitative measurement of expression through massively parallel RNA-sequencing. Wilhelm BT, Landry JR. Methods. 2009 Jul;48(3):249-57.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "is a DNA sequencer which is manufactured by Applied Biosystems and which enable DNA sequencing by ligation";
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "Applied Biosystems";
                 a <http://www.w3.org/2002/07/owl#Class>;
