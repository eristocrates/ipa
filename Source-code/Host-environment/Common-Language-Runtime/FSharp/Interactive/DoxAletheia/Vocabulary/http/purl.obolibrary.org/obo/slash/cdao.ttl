cdao:OBI_0002161 cdao:IAO_0000111 "systematic evolution of ligands by exponential enrichment assay";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A binding assay that identifies protein-binding sites on nucleic acids by selecting high-affinity target ligands from a randomized pool. The process is repeated in rounds, then the bound nucleic acids are separated from the unbound nucleic acids and amplified by PCR._";
                 cdao:IAO_0000117 "Rebecca Tauber";
                 cdao:IAO_0000118 "SELEX";
                 cdao:IAO_0000119 "PMID:21720957";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "systematic evolution of ligands by exponential enrichment assay";
                 rdfs:subClassOf cdao:OBI_0001146.
cdao:OBI_0002162 cdao:IAO_0000111 "footprinting assay";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An assay that measures ligand binding and conformational changes by the solvent accessibility of the backbone, bases, or side-chain structures of macromolecules through their sensitivity to chemical or enzymatic cleavage or modification reactions.";
                 cdao:IAO_0000117 "Bjoern Peters";
                 cdao:IAO_0000119 "doi:10.1002/3527600906.mcb.200300025";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "footprinting assay";
                 rdfs:subClassOf cdao:OBI_0000070.
cdao:OBI_0002163 cdao:IAO_0000111 "DNAse footprinting assay";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An enzymatic footprinting assay that determines protein-binding sites on DNA by identifying bound fragments that are protected from DNAse I-catalyzed hydrolysis";
                 cdao:IAO_0000117 "Rebecca Tauber";
                 cdao:IAO_0000119 "OBI development call";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "DNAse footprinting assay";
                 rdfs:subClassOf cdao:OBI_0002162.
