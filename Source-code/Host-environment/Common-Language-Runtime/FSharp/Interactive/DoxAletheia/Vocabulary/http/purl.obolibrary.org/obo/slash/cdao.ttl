                                 cdao:OBI_0001479,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:UBERON_0001088 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0001000 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0000652 cdao:IAO_0000111 "material combination";
                 cdao:IAO_0000112 "Mixing two fluids. Adding salt into water. Injecting a mouse with PBS.";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "is a material processing with the objective to combine two or more material entities as input into a single material entity as output.";
                 cdao:IAO_0000116 "created at workshop as parent class for 'adding material into target', which is asymmetric, while combination encompasses all addition processes.";
                 cdao:IAO_0000117 "bp";
                 cdao:IAO_0000119 "bp";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "material combination";
                 rdfs:subClassOf cdao:OBI_0000094,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:BFO_0000040 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:BFO_0000040 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000686 ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0000653 cdao:IAO_0000111 "fuzzy clustering objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A fuzzy clustering objective is a data transformation objective where the aim is to assign input objects (typically vectors of attributes) a probability that a point belongs to a class, where the number of class and their specifications are not known a priori."@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000119 "PERSON: Ryan Brinkman",
                                  "PERSON: James Malone";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "fuzzy clustering objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0000654 cdao:IAO_0000111 "device setting";
                 cdao:IAO_0000112 "Examples, 300V for 4 hours, 200mvolts, 37degrees.A knob set a 300 V is the device setting, the protocol stating to set the instrument to 300V is a device setting specification";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "a quality inheres_in some device and is concretization of some (device_setting_specification and is_about a quality of the device";
                 cdao:IAO_0000116 "There is some question of whether 'device setting' is really best modelled as a quality.  To be revisited after assay terms have been worked through. See https://github.com/obi-ontology/obi/issues/133";
                 cdao:IAO_0000117 "PERSON: Frank Gibson";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "device setting";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000047 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000052 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:BFO_0000019.
