cdao:OBI_0600027 cdao:IAO_0000111 "artificially induced cell membrane lysis"@en;
                 cdao:IAO_0000112 "http://www.ncbi.nlm.nih.gov/sites/entrez?cmd=Retrieve&db=PubMed&amp;list_uids=16080188&dopt=AbstractPlus; The destruction of cell membranes with detergent."@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "a material transformation to break the membranes of cells, releasing the cells contents; input=>cells; output=>cell_lysate"@en;
                 cdao:IAO_0000116 "---\\nThere is a more general 'membrane lysis', which could apply to artificial membranes etc. For this general membrane encapsulated objects would need to be defined."@en;
                 cdao:IAO_0000117 "PlanAndPlannedProcess Branch"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "artificially induced cell membrane lysis"@en;
                 rdfs:subClassOf cdao:OBI_0000094,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000456 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0600028 cdao:IAO_0000111 "artificially induced reverse transcription"@en;
                 cdao:IAO_0000112 "The use of M-MLV reverse transcriptase from the Moloney murine leukemia virus to transcribe an RNA sample into cDNA"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "a protocol with the objective to transcribe single-stranded RNA into complementary DNA (cDNA)"@en;
                 cdao:IAO_0000116 "We need to indicate the relationship between the cDNA generated and the RNA that was used as a template. This may be outside of the OBI scope"@en,
                                  "It could also be added that the reverse transcriptase is bearer of a GO:0003964 RNA-directed DNA polymerase activity, which is realized in this process.";
                 cdao:IAO_0000117 "PERSON:Kevin Clancy"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "artificially induced reverse transcription"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000419 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000094,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000456 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:CHEBI_16991 ; 
