     rdfs:label \"RO id policy\"
     'has ID policy for': \"RO\"""";
                 cdao:IAO_0000115 """Relates an ontology used to record id policy to a prefix concatenated with an integer in the id range (left padded with \"0\"s to make this many digits) to construct an ID for a term being created.""";
                 cdao:IAO_0000117 "Person:Alan Ruttenberg";
                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:label "has ID prefix"@en.
cdao:IAO_0000600 cdao:IAO_0000111 "elucidation"@en;
                 cdao:IAO_0000117 "person:Alan Ruttenberg"@en;
                 cdao:IAO_0000119 "Person:Barry Smith"@en;
                 cdao:IAO_0000600 "Primitive terms in a highest-level ontology such as BFO are terms which are so basic to our understanding of reality that there is no way of defining them in a non-circular fashion. For these, therefore, we can provide only elucidations, supplemented by examples and by axioms"@en;
                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:isDefinedBy cdao:iao.owl;
                 rdfs:label "elucidation"@en.
cdao:IAO_0000601 cdao:IAO_0000111 "has associated axiom(nl)"@en;
                 cdao:IAO_0000117 "Person:Alan Ruttenberg"@en;
