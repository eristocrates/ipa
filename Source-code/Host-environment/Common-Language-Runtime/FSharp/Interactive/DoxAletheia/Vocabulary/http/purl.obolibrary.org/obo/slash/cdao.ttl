                 rdfs:subClassOf cdao:OBI_0000048.
cdao:OBI_0000479 cdao:IAO_0000111 "solid NMR probe"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An NMR probe that is designed to hold a solid sample."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400243",
