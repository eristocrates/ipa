cdao:UBERON_0007311 cdao:IAO_0000111 "sputum";
                    cdao:IAO_0000115 "Matter ejected from the lungs, bronchi, and trachea, through the mouth.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "sputum";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0007610 cdao:IAO_0000111 "tibial artery";
                    cdao:IAO_0000115 "The anterior and posterior arteries created at the bifurcation of the popliteal artery. The anterior tibial artery begins at the lower border of the popliteus muscle and lies along the tibia at the distal part of the leg to surface superficially anterior to the ankle joint. Its branches are distributed throughout the leg, ankle, and pes. The posterior tibial artery begins at the lower border of the popliteus muscle, lies behind the tibia in the lower part of its course, and is found situated between the medial malleolus and the medial process of the calcaneal tuberosity. Its branches are distributed throughout the leg and foot.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "tibial artery";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0007650 cdao:IAO_0000111 "esophagogastric junction";
                    cdao:IAO_0000115 "The junction between the esophagus and the stomach epithelium";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "esophagogastric junction";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0036149 cdao:IAO_0000111 "suprapubic skin";
                    cdao:IAO_0000115 "Area of skin in the hypoastric region of the abdomen.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "suprapubic skin";
