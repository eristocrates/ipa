                rdfs:subClassOf cdao:SO_0000353.
cdao:SO_0000149 cdao:IAO_0000111 "contig";
                cdao:IAO_0000115 "A contiguous sequence derived from sequence assembly. Has no gaps, but may contain N's from unavailable bases.";
                cdao:IAO_0000412 cdao:so.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "contig";
                rdfs:subClassOf cdao:SO_0000353.
cdao:SO_0000276 cdao:IAO_0000111 "miRNA";
                cdao:IAO_0000115 "Small, ~22-nt, RNA molecule that is the endogenous transcript of a miRNA gene (or the product of other non coding RNA genes. Micro RNAs are produced from precursor molecules (SO:0000647) that can form local hairpin structures, which ordinarily are processed (usually via the Dicer pathway) such that a single miRNA molecule accumulates from one arm of a hairpin precursor molecule. Micro RNAs may trigger the cleavage of their target molecules or act as translational repressors.";
                cdao:IAO_0000412 cdao:so.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "miRNA";
                rdfs:subClassOf cdao:SO_0000001.
cdao:SO_0000353 cdao:IAO_0000111 "sequence_assembly";
                cdao:IAO_0000115 "A sequence of nucleotides that has been algorithmically derived from an alignment of two or more different sequences.";
                cdao:IAO_0000412 cdao:so.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "sequence_assembly";
                rdfs:subClassOf cdao:SO_0001248.
cdao:SO_0000988 cdao:IAO_0000111 "circular";
                cdao:IAO_0000115 "A quality of a nucleotide polymer that has no terminal nucleotide residues.";
                cdao:IAO_0000412 cdao:so.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "circular";
                rdfs:subClassOf cdao:PATO_0001241.
cdao:SO_0001248 cdao:IAO_0000111 "assembly";
                cdao:IAO_0000115 "A region of the genome of known length that is composed by ordering and aligning two or more different regions.";
                cdao:IAO_0000412 cdao:so.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "assembly";
                rdfs:subClassOf cdao:SO_0001410.
cdao:SO_0001410 cdao:IAO_0000111 "experimental_feature";
                cdao:IAO_0000115 "A region which is the result of some arbitrary experimental procedure. The procedure may be carried out with biological material or inside a computer.";
                cdao:IAO_0000412 cdao:so.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "experimental_feature";
                rdfs:subClassOf cdao:SO_0000001.
cdao:UBERON_0000007 cdao:IAO_0000111 "pituitary gland";
                    cdao:IAO_0000115 "The pituitary gland is an endocrine gland that secretes hormones that regulate many other glands [GO]. An endocrine gland located ventral to the diencephalon and derived from mixed neuroectodermal and non neuroectodermal origin [ZFIN].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "pituitary gland";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000029 cdao:IAO_0000111 "lymph node";
                    cdao:IAO_0000115 "Any of the rounded masses of lymphoid tissue that are surrounded by a capsule of connective tissue, are distributed along the lymphatic vessels, and contain numerous lymphocytes which filter the flow of lymph.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "lymph node";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000105 cdao:IAO_0000111 "life cycle stage";
                    cdao:IAO_0000115 "A spatiotemporal region encompassing some part of the life cycle of an organism.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "life cycle stage";
                    rdfs:subClassOf cdao:GO_0008150.
cdao:UBERON_0000165 cdao:IAO_0000111 "mouth";
                    cdao:IAO_0000115 "The proximal portion of the digestive tract, containing the oral cavity and bounded by the oral opening. In vertebrates, this extends to the pharynx and includes gums, lips, tongue and parts of the palate. Typically also includes the teeth, except where these occur elsewhere (e.g. pharyngeal jaws) or protrude from the mouth (tusks).";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "mouth";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000173 cdao:IAO_0000111 "amniotic fluid";
                    cdao:IAO_0000115 "Amniotic fluid is a bodily fluid consisting of watery liquid surrounding and cushioning a growing fetus within the amnion. It allows the fetus to move freely without the walls of the uterus being too tight against its body. Buoyancy is also provided. The composition of the fluid changes over the course of gestation. Initially, amniotic fluid is similar to maternal plasma, mainly water with electrolytes. As the fetus develops, proteins, carbohydrates, lipids, phospholipids originating from the lungs, fetal cells, and urea are deposited in the fluid.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "amniotic fluid";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0000178 cdao:IAO_0000111 "blood";
                    cdao:IAO_0000115 "A fluid that is composed of blood plasma and erythrocytes.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "blood";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0000310 cdao:IAO_0000111 "breast";
                    cdao:IAO_0000115 "The upper ventral region of the torso of an organism.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "breast";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000362 cdao:IAO_0000111 "renal medulla";
                    cdao:IAO_0000115 "the inner portion of the kidney consisting of the renal pyramids";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "renal medulla";
                    rdfs:subClassOf cdao:UBERON_0000481.
cdao:UBERON_0000463 cdao:IAO_0000111 "organism substance";
                    cdao:IAO_0000115 "Material anatomical entity in a gaseous, liquid, semisolid or solid state; produced by anatomical structures or derived from inhaled and ingested substances that have been modified by anatomical structures as they pass through the body.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "organism substance";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000465 cdao:IAO_0000111 "material anatomical entity";
                    cdao:IAO_0000115 "Anatomical entity that has mass.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "material anatomical entity";
                    rdfs:subClassOf cdao:BFO_0000040.
cdao:UBERON_0000473 cdao:IAO_0000111 "testis";
                    cdao:IAO_0000115 "A gonad of a male animal. A gonad produces and releases sperm.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "testis";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000477 cdao:IAO_0000111 "anatomical cluster";
                    cdao:IAO_0000115 "Anatomical group that has its parts adjacent to one another.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "anatomical cluster";
                    rdfs:subClassOf cdao:BFO_0000040.
cdao:UBERON_0000479 cdao:IAO_0000111 "tissue";
                    cdao:IAO_0000115 "Multicellular anatomical structure that consists of many cells of one or a few types, arranged in an extracellular matrix such that their long-range organisation is at least partly a repetition of their short-range organisation.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "tissue";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000481 cdao:IAO_0000111 "multi-tissue structure";
                    cdao:IAO_0000115 "Anatomical structure that has as its parts two or more portions of tissue of at least two different types and which through specific morphogenetic processes forms a single distinct structural unit demarcated by bona-fide boundaries from other distinct structural units of different types.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "multi-tissue structure";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000483 cdao:IAO_0000111 "epithelium";
                    cdao:IAO_0000115 "Portion of tissue, that consists of one or more layers of epithelial cells connected to each other by cell junctions and which is underlain by a basal lamina. Examples: simple squamous epithelium, glandular cuboidal epithelium, transitional epithelium, myoepithelium[CARO].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "epithelium";
                    rdfs:subClassOf cdao:UBERON_0000479.
cdao:UBERON_0000945 cdao:IAO_0000111 "stomach";
                    cdao:IAO_0000115 "An expanded region of the vertebrate alimentary tract that serves as a food storage compartment and digestive organ. A stomach is lined, in whole or in part by a glandular epithelium.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "stomach";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000947 cdao:IAO_0000111 "aorta";
                    cdao:IAO_0000115 "The main trunk of the systemic arterial system that carries blood from the heart to all the organs and other structures of the body, bringing oxygenated blood to all parts of the body in the systemic circulation";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "aorta";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000948 cdao:IAO_0000111 "heart";
                    cdao:IAO_0000115 "A myogenic muscular circulatory organ found in the vertebrate cardiovascular system composed of chambers of cardiac muscle. It is the primary circulatory organ.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "heart";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000955 cdao:IAO_0000111 "brain";
                    cdao:IAO_0000115 "The brain is the center of the nervous system in all vertebrate, and most invertebrate, animals. Some primitive animals such as jellyfish and starfish have a decentralized nervous system without a brain, while sponges lack any nervous system at all. In vertebrates, the brain is located in the head, protected by the skull and close to the primary sensory apparatus of vision, hearing, balance, taste, and smell[WP].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "brain";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000956 cdao:IAO_0000111 "cerebral cortex";
                    cdao:IAO_0000115 "The thin layer of gray matter on the surface of the cerebral hemisphere that develops from the telencephalon. It consists of the neocortex (6 layered cortex or isocortex), the hippocampal formation and the olfactory cortex.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "cerebral cortex";
                    rdfs:subClassOf cdao:UBERON_0000477.
cdao:UBERON_0000992 cdao:IAO_0000111 "ovary";
                    cdao:IAO_0000115 "the gonad of a female organism which contains germ cells";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "ovary";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000995 cdao:IAO_0000111 "uterus";
                    cdao:IAO_0000115 "the female muscular organ of gestation in which the developing embryo or fetus is nourished until birth";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "uterus";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0000996 cdao:IAO_0000111 "vagina";
                    cdao:IAO_0000115 "A fibromuscular tubular tract leading from the uterus to the exterior of the body in female placental mammals and marsupials, or to the cloaca in female birds, monotremes, and some reptiles[WP].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "vagina";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001013 cdao:IAO_0000111 "adipose tissue";
                    cdao:IAO_0000115 "Portion of connective tissue composed of adipocytes enmeshed in areolar tissue";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "adipose tissue";
                    rdfs:subClassOf cdao:UBERON_0000479.
cdao:UBERON_0001037 cdao:IAO_0000111 "strand of hair";
                    cdao:IAO_0000115 "A filament, mostly protein, that grows from follicles found in the dermis[WP].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "strand of hair";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001052 cdao:IAO_0000111 "rectum";
                    cdao:IAO_0000115 "the terminal portion of the intestinal tube, terminating with the anus";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "rectum";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001087 cdao:IAO_0000111 "pleural fluid";
                    cdao:IAO_0000115 "Transudate contained in the pleural cavity.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "pleural fluid";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0001088 cdao:IAO_0000111 "urine";
                    cdao:IAO_0000115 "Excretion that is the output of a kidney";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "urine";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0001089 cdao:IAO_0000111 "sweat";
                    cdao:IAO_0000115 "Secretion produced by a sweat gland.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "sweat";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0001090 cdao:IAO_0000111 "synovial fluid";
                    cdao:IAO_0000115 "Joint fluid is a transudate of plasma that is actively secreted by synovial cells.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "synovial fluid";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0001134 cdao:IAO_0000111 "skeletal muscle tissue";
                    cdao:IAO_0000115 "Muscle tissue that consists primarily of skeletal muscle fibers.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "skeletal muscle tissue";
                    rdfs:subClassOf cdao:UBERON_0000479.
cdao:UBERON_0001155 cdao:IAO_0000111 "colon";
                    cdao:IAO_0000115 "Last portion of the large intestine before it becomes the rectum.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "colon";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001159 cdao:IAO_0000111 "sigmoid colon";
                    cdao:IAO_0000115 "The part of the large intestine that is closest to the rectum and anus. It forms a loop that averages about 40 cm. in length, and normally lies within the pelvis, but on account of its freedom of movement it is liable to be displaced into the abdominal cavity.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "sigmoid colon";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001225 cdao:IAO_0000111 "cortex of kidney";
                    cdao:IAO_0000115 "Outer cortical portion of the kidney, between the renal capsule and the renal medulla.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "cortex of kidney";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001255 cdao:IAO_0000111 "urinary bladder";
                    cdao:IAO_0000115 "distensible musculomembranous organ situated in the anterior part of the pelvic cavity in which urine collects before excretion[MP].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "urinary bladder";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001264 cdao:IAO_0000111 "pancreas";
                    cdao:IAO_0000115 "An endoderm derived structure that produces precursors of digestive enzymes and blood glucose regulating enzymes[GO].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "pancreas";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001268 cdao:IAO_0000111 "peritoneal fluid";
                    cdao:IAO_0000115 "Transudate contained in the peritoneal cavity.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "peritoneal fluid";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0001323 cdao:IAO_0000111 "tibial nerve";
                    cdao:IAO_0000115 "The tibial nerve is a branch of the sciatic nerve. The tibial nerve passes through the popliteal fossa to pass below the arch of soleus. In the popliteal fossa the nerve gives off branches to gastrocnemius, popliteus, soleus and plantaris muscles, an articular branch to the knee joint, and a cutaneous branch that will become the sural nerve. The sural nerve is joined by fibres from the common peroneal nerve and runs down the calf to supply the lateral side of the foot. Below the soleus muscle the nerve lies close to the tibia and supplies the tibialis posterior, the flexor digitorum longus and the flexor hallucis longus. The nerve passes into the foot running posterior to the medial malleolus. Here it is bound down by the flexor retinaculum in company with the posterior tibial artery. [WP,unvetted].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "tibial nerve";
                    rdfs:subClassOf cdao:UBERON_0000477.
cdao:UBERON_0001359 cdao:IAO_0000111 "cerebrospinal fluid";
                    cdao:IAO_0000115 "A clear, colorless, bodily fluid, that occupies the subarachnoid space and the ventricular system around and inside the brain and spinal cord.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "cerebrospinal fluid";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0001567 cdao:IAO_0000111 "cheek";
                    cdao:IAO_0000115 "A fleshy subdivision of one side of the face bounded by an eye, ear and the nose.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "cheek";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001621 cdao:IAO_0000111 "coronary artery";
                    cdao:IAO_0000115 "An artery that supplies the myocardium.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "coronary artery";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001638 cdao:IAO_0000111 "vein";
                    cdao:IAO_0000115 "Any of the tubular branching vessels that carry blood from the capillaries toward the heart.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "vein";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001723 cdao:IAO_0000111 "tongue";
                    cdao:IAO_0000115 "A muscular organ in the floor of the mouth.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "tongue";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001728 cdao:IAO_0000111 "nasopharynx";
                    cdao:IAO_0000115 "the section of the pharynx that lies above the soft palate";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "nasopharynx";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001729 cdao:IAO_0000111 "oropharynx";
                    cdao:IAO_0000115 "the portion of the pharynx that lies between the soft palate and the upper edge of the epiglottis";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "oropharynx";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001797 cdao:IAO_0000111 "vitreous humor";
                    cdao:IAO_0000115 "A transparent, semigelatinous substance that fills the cavity behind the crystalline lens of the eye and in front of the retina";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "vitreous humor";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0001830 cdao:IAO_0000111 "minor salivary gland";
                    cdao:IAO_0000115 "One of the smaller, largely mucus-secreting, exocrine glands of the oral cavity, consisting of the labial, buccal, molar, lingual, and palatine glands[MP].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "minor salivary gland";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001836 cdao:IAO_0000111 "saliva";
                    cdao:IAO_0000115 "A fluid produced in the oral cavity by salivary glands, typically used in predigestion, but also in other functions.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "saliva";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0001873 cdao:IAO_0000111 "caudate nucleus";
                    cdao:IAO_0000115 "Subcortical nucleus of telecephalic origin consisting of an elongated gray mass lying lateral to and bordering the lateral ventricle. It is divided into a head, body and tail in some species.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "caudate nucleus";
                    rdfs:subClassOf cdao:UBERON_0000477.
cdao:UBERON_0001874 cdao:IAO_0000111 "putamen";
                    cdao:IAO_0000115 "Subcortical nucleus of telencephalic , which together with the caudate nucleus, forms the striatum. The putamen lies lateral to the internal capsule and medial to the external medullary lamina, and is separated from the caudate nucleus by the fibers of the internal capsule for most of its length, except at its anterior portion.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "putamen";
                    rdfs:subClassOf cdao:UBERON_0000477.
cdao:UBERON_0001913 cdao:IAO_0000111 "milk";
                    cdao:IAO_0000115 "An emulsion of fat globules within a fluid that is secreted by the mammary gland during lactation.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "milk";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0001970 cdao:IAO_0000111 "bile";
                    cdao:IAO_0000115 "vital aqueous secretion of the liver that is formed by hepatocytes and modified down stream by absorptive and secretory properties of the bile duct epithelium.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "bile";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0001987 cdao:IAO_0000111 "placenta";
                    cdao:IAO_0000115 "organ of metabolic interchange between fetus and mother, partly of embryonic origin and partly of maternal origin[GO]. The fetal portion of the placenta is known as the villous chorion. The maternal portion is known as the decidua basalis. The two portions are held together by anchoring villi that are anchored to the decidua basalis by the cytotrophoblastic shell.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "placenta";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0001988 cdao:IAO_0000111 "feces";
                    cdao:IAO_0000115 "Portion of semisolid bodily waste discharged through the anus[MW,modified]";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "feces";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0002032 cdao:IAO_0000111 "areola";
                    cdao:IAO_0000115 "Subdivision of breast which consists of skin, connective tissue and smooth muscle bundle and modified sebaceous glands and which surrounds the nipple.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "areola";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0002037 cdao:IAO_0000111 "cerebellum";
                    cdao:IAO_0000115 "Part of the metencephalon that lies in the posterior cranial fossa behind the brain stem. It is concerned with the coordination of movement[MESH]. A large dorsally projecting part of the brain concerned especially with the coordination of muscles and the maintenance of bodily equilibrium, situated between the brain stem and the back of the cerebrum , and formed in humans of two lateral lobes and a median lobe[BTO]. Brain structure derived from the anterior hindbrain, and perhaps including posterior midbrain. The cerebellum plays a role in somatic motor function, the control of muscle tone, and balance[ZFA].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "cerebellum";
                    rdfs:subClassOf cdao:UBERON_0000481.
cdao:UBERON_0002046 cdao:IAO_0000111 "thyroid gland";
                    cdao:IAO_0000115 "A two-lobed endocrine gland found in all vertebrates, located in front of and on either side of the trachea in humans, and producing various hormones, such as triiodothyronine and calcitonin[BTO].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "thyroid gland";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0002048 cdao:IAO_0000111 "lung";
                    cdao:IAO_0000115 "Respiration organ that develops as an oupocketing of the esophagus.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "lung";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0002067 cdao:IAO_0000111 "dermis";
                    cdao:IAO_0000115 "The dermis is a layer of skin between the epidermis (with which it makes up the skin) and subcutaneous tissues, and is composed of two layers, the papillary and reticular dermis[WP].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "dermis";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0002072 cdao:IAO_0000111 "hypodermis";
                    cdao:IAO_0000115 "Lowermost layer of the integumentary system in vertebrates. Types of cells that are found in the hypodermis are fibroblasts, adipose cells, and macrophages. It is derived from the mesoderm, but unlike the dermis, it is not derived from the dermatome region of the mesoderm. The hypodermis is used mainly for fat storage[WP].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "hypodermis";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0002097 cdao:IAO_0000111 "skin of body";
                    cdao:IAO_0000115 "The organ covering the body that consists of the dermis and epidermis.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "skin of body";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0002106 cdao:IAO_0000111 "spleen";
                    cdao:IAO_0000115 "the organ that functions to filter blood and to store red corpuscles and platelets";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "spleen";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0002107 cdao:IAO_0000111 "liver";
                    cdao:IAO_0000115 "An exocrine gland which secretes bile and functions in metabolism of protein and carbohydrate and fat, synthesizes substances involved in the clotting of the blood, synthesizes vitamin A, detoxifies poisonous substances, stores glycogen, and breaks down worn-out erythrocytes[GO].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "liver";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0002116 cdao:IAO_0000111 "ileum";
                    cdao:IAO_0000115 "the portion of the small intestine that extends from the jejunum to the colon";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "ileum";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0002358 cdao:IAO_0000111 "peritoneum";
                    cdao:IAO_0000115 "A serous membrane that lines the peritoneal cavity[VHOG,modified].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "peritoneum";
                    rdfs:subClassOf cdao:UBERON_0000481.
cdao:UBERON_0002367 cdao:IAO_0000111 "prostate gland";
                    cdao:IAO_0000115 "The prostate gland is a partly muscular, partly glandular body that is situated near the base of the mammalian male urethra and secretes an alkaline viscid fluid which is a major constituent of the ejaculatory fluid.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "prostate gland";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0002369 cdao:IAO_0000111 "adrenal gland";
                    cdao:IAO_0000115 "Either of a pair of complex endocrine organs near the anterior medial border of the kidney consisting of a mesodermal cortex that produces glucocorticoid, mineralocorticoid, and androgenic hormones and an ectodermal medulla that produces epinephrine and norepinephrine[BTO].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "adrenal gland";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0002371 cdao:IAO_0000111 "bone marrow";
                    cdao:IAO_0000115 "the soft tissue that fills the cavities of bones";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "bone marrow";
                    rdfs:subClassOf cdao:UBERON_0000479.
cdao:UBERON_0002409 cdao:IAO_0000111 "pericardial fluid";
                    cdao:IAO_0000115 "Transudate contained in the pericardial cavity.[FMA]";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "pericardial fluid";
                    rdfs:subClassOf cdao:UBERON_0000463.
cdao:UBERON_0002469 cdao:IAO_0000111 "esophagus mucosa";
                    cdao:IAO_0000115 "A mucosa that is part of a esophagus [Automatically generated definition].";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "esophagus mucosa";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0002812 cdao:IAO_0000111 "left cerebral hemisphere";
                    cdao:IAO_0000115 "A cerebral hemisphere that is in the left side of a brain.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "left cerebral hemisphere";
