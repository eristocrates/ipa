cdao:OBI_0000478 cdao:IAO_0000111 "column connector"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A device that connects two or more columns together in a functional way with leak-tight connection, low dead volume, low thermal mass and high inertness."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01236",
