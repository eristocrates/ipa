cdao:RO_0000091 cdao:IAO_0000115 "a relation between an independent continuant (the bearer) and a disposition, in which the disposition specifically depends on the bearer for its existence"@en;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain cdao:BFO_0000004;
                rdfs:label "has disposition"@en;
                rdfs:range cdao:BFO_0000016;
                rdfs:subPropertyOf cdao:RO_0000053;
                <http://www.w3.org/2002/07/owl#equivalentProperty> [<http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0000092];
                <http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0000092.
cdao:RO_0000092 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:label "disposition of"@en;
                rdfs:subPropertyOf cdao:RO_0000052;
                <http://www.w3.org/2002/07/owl#equivalentProperty> [<http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0000091].
cdao:RO_0001000 cdao:IAO_0000111 "derives from";
                cdao:IAO_0000112 "this nucleus derives from this parent nucleus (nuclear division)"@en,
                                 "this cell derives from this parent cell (cell division)"@en;
                cdao:IAO_0000114 cdao:IAO_0000125;
                cdao:IAO_0000115 "a relation between two distinct material entities, the new entity and the old entity, in which the new entity begins to exist when the old entity ceases to exist, and the new entity inherits the significant portion of the matter of the old entity"@en;
                cdao:IAO_0000116 "This is a very general relation. More specific relations are preferred when applicable, such as 'directly develops from'."@en;
                cdao:IAO_0000118 "derives_from"@en;
                cdao:IAO_0000412 cdao:ro.owl;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain cdao:BFO_0000004;
                rdfs:label "derives from"@en;
                rdfs:range cdao:BFO_0000004;
                rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
                <http://www.w3.org/2002/07/owl#equivalentProperty> [<http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0001001];
                <http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0001001.
cdao:RO_0001001 cdao:IAO_0000112 "this parent nucleus derives into this nucleus (nuclear division)"@en,
                                 "this parent cell derives into this cell (cell division)"@en;
                cdao:IAO_0000114 cdao:IAO_0000125;
                cdao:IAO_0000115 "a relation between two distinct material entities, the old entity and the new entity, in which the new entity begins to exist when the old entity ceases to exist, and the new entity inherits the significant portion of the matter of the old entity"@en;
                cdao:IAO_0000116 "This is a very general relation. More specific relations are preferred when applicable, such as 'directly develops into'. To avoid making statements about a future that may not come to pass, it is often better to use the backward-looking 'derives from' rather than the forward-looking 'derives into'."@en;
                cdao:IAO_0000118 "derives_into"@en;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:label "derives into"@en;
                <http://www.w3.org/2002/07/owl#equivalentProperty> [<http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0001000].
cdao:RO_0001015 cdao:IAO_0000111 "is location of"@en;
                cdao:IAO_0000112 "my head is the location of my brain"@en,
                                 "this cage is the location of this rat"@en;
                cdao:IAO_0000115 "a relation between two independent continuants, the location and the target, in which the target is entirely within the location"@en;
                cdao:IAO_0000116 "Most location relations will only hold at certain times, but this is difficult to specify in OWL. See https://code.google.com/p/obo-relations/wiki/ROAndTime"@en;
                cdao:IAO_0000118 "location_of"@en;
                cdao:RO_0001900 cdao:RO_0001901;
                a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                  <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:label "location of"@en;
                <http://www.w3.org/2002/07/owl#equivalentProperty> [<http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0001025];
                <http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0001025.
cdao:RO_0001025 cdao:IAO_0000111 "located in"@en;
                cdao:IAO_0000112 "this rat is located in this cage"@en,
                                 "my brain is located in my head"@en;
                cdao:IAO_0000115 "a relation between two independent continuants, the target and the location, in which the target is entirely within the location"@en;
                cdao:IAO_0000116 "Most location relations will only hold at certain times, but this is difficult to specify in OWL. See https://code.google.com/p/obo-relations/wiki/ROAndTime"@en,
                                 "Location as a relation between instances: The primitive instance-level relation c located_in r at t reflects the fact that each continuant is at any given time associated with exactly one spatial region, namely its exact location. Following we can use this relation to define a further instance-level location relation - not between a continuant and the region which it exactly occupies, but rather between one continuant and another. c is located in c1, in this sense, whenever the spatial region occupied by c is part_of the spatial region occupied by c1.    Note that this relation comprehends both the relation of exact location between one continuant and another which obtains when r and r1 are identical (for example, when a portion of fluid exactly fills a cavity), as well as those sorts of inexact location relations which obtain, for example, between brain and head or between ovum and uterus"@en;
                cdao:IAO_0000118 "located_in"@en;
                cdao:RO_0001900 cdao:RO_0001901;
                <http://purl.org/dc/elements/1.1/source> "http://www.obofoundry.org/ro/#OBO_REL:located_in";
                a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                  <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:label "located in"@en;
                <http://www.w3.org/2002/07/owl#equivalentProperty> [<http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0001015].
cdao:RO_0001900 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                rdfs:label "temporal interpretation"@en;
                <http://xmlns.com/foaf/0.1/page> "https://github.com/oborel/obo-relations/wiki/ROAndTime"^^xsd:anyURI.
cdao:RO_0001901 cdao:IAO_0000115 """

## Elucidation

This is used when the statement/axiom is assumed to hold true 'eternally'

## How to interpret (informal)

First the \"atemporal\" FOL is derived from the OWL using the standard
interpretation. This axiom is temporalized by embedding the axiom
within a for-all-times quantified sentence. The t argument is added to
all instantiation predicates and predicates that use this relation.

## Example

    Class: nucleus
    SubClassOf: part_of some cell

    forall t :
      forall n :
        instance_of(n,Nucleus,t)
         implies
        exists c :
          instance_of(c,Cell,t)
          part_of(n,c,t)

## Notes

This interpretation is *not* the same as an at-all-times relation

""";
                a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "axiom holds for all times"@en.
cdao:RO_0001902 cdao:IAO_0000115 """

## Elucidation

This is used when the first-order logic form of the relation is
binary, and takes no temporal argument.

## Example:

    Class: limb
    SubClassOf: develops_from some lateral-plate-mesoderm

     forall t, t2:
      forall x :
        instance_of(x,Limb,t)
         implies
        exists y :
          instance_of(y,LPM,t2)
          develops_from(x,y)


""";
                a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "relation has no temporal argument"@en.
cdao:RO_0002000 cdao:IAO_0000112 "the surface of my skin is a 2D boundary of my body"@en;
                cdao:IAO_0000115 "a relation between a 2D immaterial entity (the boundary) and a material entity, in which the boundary delimits the material entity"@en;
                cdao:IAO_0000116 "Although the boundary is two-dimensional, it exists in three-dimensional space and thus has a 3D shape."@en,
                                 "A 2D boundary may have holes and gaps, but it must be a single connected entity, not an aggregate of several disconnected parts."@en;
                cdao:IAO_0000118 "is 2D boundary of"@en,
                                 "is boundary of"@en,
                                 "boundary of"@en,
                                 "2D_boundary_of"@en;
                cdao:RO_0001900 cdao:RO_0001901;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:label "2D boundary of"@en;
                <http://www.w3.org/2002/07/owl#equivalentProperty> [<http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0002002];
                <http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0002002.
cdao:RO_0002002 cdao:IAO_0000112 "my body has 2D boundary the surface of my skin"@en;
                cdao:IAO_0000115 "a relation between a material entity and a 2D immaterial entity (the boundary), in which the boundary delimits the material entity"@en;
                cdao:IAO_0000116 "Although the boundary is two-dimensional, it exists in three-dimensional space and thus has a 3D shape."@en,
                                 "A 2D boundary may have holes and gaps, but it must be a single connected entity, not an aggregate of several disconnected parts."@en;
                cdao:IAO_0000118 "has boundary"@en,
                                 "has_2D_boundary"@en;
                cdao:RO_0001900 cdao:RO_0001901;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain cdao:BFO_0000040;
                rdfs:label "has 2D boundary"@en;
                rdfs:range cdao:BFO_0000141;
                <http://www.w3.org/2002/07/owl#equivalentProperty> [<http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0002000].
cdao:RO_0002087 cdao:IAO_0000117 "David Osumi-Sutherland";
                cdao:IAO_0000118 "starts_at_end_of";
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "X immediately_preceded_by Y iff: end(X) simultaneous_with start(Y)"@en;
                rdfs:label "immediately preceded by"@en;
                rdfs:subPropertyOf cdao:BFO_0000062;
                <http://www.w3.org/2002/07/owl#inverseOf> cdao:RO_0002090.
cdao:RO_0002090 cdao:IAO_0000117 "David Osumi-Sutherland";
                cdao:IAO_0000118 "meets",
                                 "ends_at_start_of";
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "X immediately_precedes_Y iff: end(X) simultaneous_with start(Y)"@en;
                rdfs:label "immediately precedes"@en;
                rdfs:subPropertyOf cdao:BFO_0000063.
cdao:RO_0002219 cdao:IAO_0000111 "surrounded by";
                cdao:IAO_0000115 "x surrounded_by y if and only if x is adjacent to y and for every region r that is adjacent to x, r overlaps y";
                cdao:IAO_0000412 cdao:ro.owl;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:label "surrounded by"@en;
                rdfs:subPropertyOf cdao:RO_0002220.
cdao:RO_0002220 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:label "adjacent to".
cdao:RO_0002222 cdao:IAO_0000114 cdao:IAO_0000125;
