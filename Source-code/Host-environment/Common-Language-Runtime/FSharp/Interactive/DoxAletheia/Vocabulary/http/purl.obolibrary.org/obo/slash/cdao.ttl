                                 cdao:OBI_0002089,
                                 cdao:OBI_0000832,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000372 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000401 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000453 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000932.
cdao:OBI_0000049 cdao:IAO_0000111 "mass spectrometer"@en;
                 cdao:IAO_0000112 "LCQ Fleet Ion Trap MSn manufactured by thermo fisher scientific"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A mass spectrometer is an instrument which is used to measure the mass to charge ratio of ions. All mass spectrometers consist of three basic parts: an ion source, a mass analyzer, and a detector system. The stages within the mass spectrometer are: 1. Production of ions from the sample 2. Separation of ions with different masses 3. Detection of the number of ions of each mass produced 4.Collection of data to generate the mass spectrum"@en;
                 cdao:IAO_0000117 "Frank Gibson"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Mass_spectrometry"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "mass spectrometer"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000654 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000053 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000832,
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000345 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000361 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000364 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cdao:NCBITaxon_9606
                                                                                                                           cdao:OBI_0000245) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000647 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000453 ; 
