                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0000861 cdao:IAO_0000111 "Likelihood-ratio test";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Likelihood-ratio is a data transformation which tests whether there is evidence of the need to move from a simple model to a more complicated one (where the simple model is nested within the complicated one); tests of the goodness-of-fit between two models.";
                 cdao:IAO_0000117 "Tina Boussard";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Likelihood-ratio test";
                 rdfs:subClassOf cdao:OBI_0200000.
