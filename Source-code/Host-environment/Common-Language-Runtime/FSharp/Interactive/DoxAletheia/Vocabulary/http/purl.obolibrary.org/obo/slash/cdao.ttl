cdao:OBI_0200186 cdao:IAO_0000111 "error correction objective"@en;
                 cdao:IAO_0000112 "Application of a multiple testing correction method";
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "An error correction objective is a data transformation objective where the aim is to remove (correct for) erroneous contributions arising from the input data, or the transformation itself."@en;
                 cdao:IAO_0000117 "James Malone, Helen Parkinson"@en;
                 cdao:IAO_0000119 "PERSON: James Malone";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "error correction objective"@en;
                 rdfs:subClassOf cdao:OBI_0200168.
cdao:OBI_0200187 cdao:IAO_0000111 "sequence analysis data transformation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A sequence analysis data transformation is a data transformation that has objective sequence analysis and has the aim of analysing ordered biological data for sequential patterns."@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000119 "EDITOR";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "sequence analysis data transformation"@en;
                 rdfs:subClassOf cdao:OBI_0200000;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200081 ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200188 cdao:IAO_0000111 "cross validation objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A cross validation objective is a data transformation objective in which the aim is to partition a sample of data into subsets such that the analysis is initially performed on a single subset, while the other subset(s) are retained for subsequent use in confirming and validating the initial analysis."@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000118 "rotation estimation objective"@en;
                 cdao:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Cross_validation";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "cross validation objective"@en;
                 rdfs:subClassOf cdao:OBI_0200172.
cdao:OBI_0200189 cdao:IAO_0000111 "merging objective";
                 cdao:IAO_0000112 "merging of columns from two different data sets"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A merging objective is a data transformation objective in which the data transformation has the aim of performing a union of two or more sets."@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000118 "combining objective"@en;
                 cdao:IAO_0000119 "PERSON: Data Transformation Branch";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "merging objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
