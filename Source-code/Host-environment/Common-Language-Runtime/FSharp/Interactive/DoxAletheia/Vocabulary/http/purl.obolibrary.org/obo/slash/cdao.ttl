                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An inclusion criterion that defines and states one or more sexes which, if met, makes an entity suitable for a given task or participation in a given process."@en;
                 cdao:IAO_0000117 "Mathias Brochhausen"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
