cdao:IAO_0000644 cdao:IAO_0000111 "statistical analysis section"@en;
                 cdao:IAO_0000112 "The section labelled 'statistical analysis' in a typical scientific journal article, e.g. Mondo et al. Cardiovasc J Afr. 2013 Mar; 24(2): 28–33. (http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3734881/)"@en;
                 cdao:IAO_0000115 "A part of the document used to describe the statistical methodologies employed in the work presented in the document."@en;
                 cdao:IAO_0000117 "PERSON: Bill Baumgartner"@en;
                 cdao:IAO_0000118 "statistical analysis"@en;
                 cdao:IAO_0000233 <https://github.com/information-artifact-ontology/IAO/issues/183>;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "statistical analysis section"@en;
                 rdfs:subClassOf cdao:IAO_0000314,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000643 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
