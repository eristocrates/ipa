cdao:OBI_0000717 cdao:IAO_0000111 "HeliScope Single Molecule Sequencer";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "is a DNA sequencer manufacturer by Helicos Corporation to carry out Single Molecule sequencing using reversible termination chemistry";
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "HeliScope Single Molecule Sequencer";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#hasValue> cdao:OBI_0000757 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000304 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0400103.
cdao:OBI_0000718 cdao:IAO_0000111 "pathogen role";
                 cdao:IAO_0000112 "Pathogen: An agent of disease. A disease producer. The term pathogen most commonly is used to refer to infectious organisms. These include bacteria (such as staph), viruses (such as HIV), and fungi (such as yeast). Less commonly, pathogen refers to a noninfectious agent of disease such as a chemical.   http://www.medterms.com/script/main/art.asp?articlekey=6383";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "pathogen role is a role which inheres in an organism and realized in the process of disease course in the organism bearing host role caused by the organism bearing pathogen role";
                 cdao:IAO_0000117 "GROUP: Role Branch";
                 cdao:IAO_0000119 "OBI";
                 cdao:IAO_0000232 "6 April 2009:  from the Vaccine Community";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "pathogen role";
                 rdfs:subClassOf cdao:BFO_0000023,
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> cdao:OGMS_0000063 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000054 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0100026 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000052 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0000719 cdao:IAO_0000111 "vaccine preparation";
                 cdao:IAO_0000112 "The production of B. pertussis vaccine.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "vaccine preparation is a planned  process with specified output a vaccine";
                 cdao:IAO_0000119 "OBI";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "vaccine preparation";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000456 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000094.
cdao:OBI_0000720 cdao:IAO_0000111 "immunologic adjuvant role";
                 cdao:IAO_0000112 "Adjuvants are pharmacological or immunological agents that modify the effect of other agents (e.g., drugs, vaccines) while having few if any direct effects when given by themselves.   http://en.wikipedia.org/wiki/Adjuvant";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "The role a material entity plays when it is co-administered with an immunogen in order to enhance the immune response to the immunogen.";
                 cdao:IAO_0000116 """11Feb09:Vaccine Ontology Definition: Adjuvant boosts immune response of a vaccine or antigen in the host.  
the role 'adjuvant role' inheres in some 'material entity' and is realized by some 'immune response assay'.""";
                 cdao:IAO_0000117 "GROUP:  Role branch";
                 cdao:IAO_0000119 "Vaccine Ontology, Wikipedia, OBI";
                 cdao:IAO_0000232 "Renamed from adjuvent role, to be a more specific useage for immunology, tracker https://sourceforge.net/tracker/?func=detail&atid=886178&aid=2887909&group_id=177891";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "";
                 rdfs:label "immunologic adjuvant role";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> cdao:GO_0006955 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000054 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_1110092.
cdao:OBI_0000721 cdao:IAO_0000111 "glucose tolerance test";
                 cdao:IAO_0000112 "PMID: 19527607";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An assay that measures glucose clearance from blood over time by repeated glucose measurement in blood serum or plasma after the administration of a glucose bolus in-vivo. This assay can be used to evaluate the severity of insulin resistance or the efficiency of glucose clearance.";
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "NuGO OBI plan branch";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "glucose tolerance test";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000418 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
