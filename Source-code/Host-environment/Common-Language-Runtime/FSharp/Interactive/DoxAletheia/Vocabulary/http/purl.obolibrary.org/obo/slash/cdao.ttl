cdao:OBI_0001958 cdao:IAO_0000111 "systematic review study design";
                 cdao:IAO_0000112 "The effect of moderate gestational alcohol consumption during pregnancy on speech and language outcomes in children: a systematic review. http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3892059/",
                                  "Red blood cell transfusion in patients with traumatic brain injury: a systematic review protocol. http://www.ncbi.nlm.nih.gov/pmc/articles/PMC4090399/";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A study design for identifying in the literature prior studies of a pre-determined phenomenon or set of related phenomena according to certain criteria, extracting findings from these studies, and summarizing these findings and/or attempting to draw new conclusions from them which were not justified by any of the individual, prior studies. Many systematic reviews also assess the quality of the studies so reviewed.";
                 cdao:IAO_0000117 "PERSON: Bill Hogan";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "systematic review study design";
                 rdfs:subClassOf cdao:OBI_0500000.
cdao:OBI_0001959 cdao:IAO_0000111 "multiplexed nucleotide library sequencing"@en;
                 cdao:IAO_0000112 "http://www.illumina.com/technology/multiplexing_sequencing_assay.ilmn"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 """A planned process which consists in running a set of samples as a pool on a sequencing instrument, while retaining the ability to associate individual results to each of the individual input samples through the use of a ligated oligonucleotide (the \"multiplex identifier sequence\"). This oligonucleotide is  introduced during the sequence library preparation, and is unique to and specific for all library fragments derived from each sample in a sample pool."""@en;
                 cdao:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en,
                                  "Dan Berrios";
                 cdao:IAO_0000119 "OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "multiplexed nucleotide library sequencing"@en;
                 rdfs:subClassOf cdao:OBI_0000094,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0002602 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001970 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0001960 cdao:IAO_0000111 "taxonomic diversity assessment by targeted gene survey";
                 cdao:IAO_0000112 "PMID:20679230",
                                  "PMID:25367129";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An assay that dteremines taxonomic and community diversity information by sequencing specific genomic regions used as marker of identity or diversity.";
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000118 "targeted gene survey DNA barcoding",
                                  "environmental gene survey",
                                  "targeted gene survey";
                 cdao:IAO_0000119 "OBI";
