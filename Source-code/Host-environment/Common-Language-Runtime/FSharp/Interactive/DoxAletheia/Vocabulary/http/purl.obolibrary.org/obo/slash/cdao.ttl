cdao:OBI_0000912 cdao:IAO_0000111 "X-ray crystallography assay";
                 cdao:IAO_0000112 "Crystallizing an antibody:antigen complex, and recording the diffraction pattern of a synchrotron beam, and assembling the 3d complex structure based on homologous complexes.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A 3D structure determination assay in which the diffraction of pattern of X-ray beams in a crystal of purified material entities is used to resolve the 3-dimensional structure of the material entity of interest.";
                 cdao:IAO_0000117 "IEDB";
                 cdao:IAO_0000119 "IEDB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "X-ray crystallography assay";
