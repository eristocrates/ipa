cdao:OBI_0302910 cdao:IAO_0000111 "prediction";
                 cdao:IAO_0000112 "Prediction of TF target sites based on atomistic models of protein-DNA complexes. BMC Bioinformatics. 2008 Oct 16;9(1):436. PMID: 18922190"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a process by which an  event or an entity is described before it actually happens or is being discovered and identified."@en;
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "OBI";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "prediction"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000109 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000011,
