                 cdao:IAO_0000115 "An assay that determines the specific location of a protein. Subcellular localization is distinguished from tissue-based localization based on the type of microscopy applied.";
                 cdao:IAO_0000117 "Rebecca Tauber";
                 cdao:IAO_0000119 "OBI development call";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "protein localization assay";
                 rdfs:subClassOf cdao:OBI_0000070.
