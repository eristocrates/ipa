cdao:OBI_0000795 cdao:IAO_0000111 "glucometer";
                 cdao:IAO_0000112 "Diabetic patients use glucometers to determine their glucose levels";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A measurement device with the function to measure and record the level/amount of glucose in a blood sample";
                 cdao:IAO_0000117 "PERSON:Frank Gibson",
                                  "PERSON:Helen Parkinson";
