                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0000116 cdao:IAO_0000111 "worker role";
                 cdao:IAO_0000112 "Public sector workers in states that run their own OSHA programs are covered by those states.   http://www.osha.gov/as/opa/worker/index.html"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a personnel role played by a party who executes a component of the study plan; this can occur before, during, after or outside the study timeline"@en;
                 cdao:IAO_0000116 """\"executes the study plan\" includes the suppliers and manufacturers of reagents and other materials used in the study""";
                 cdao:IAO_0000117 "Person:Jennifer Fostel"@en;
                 cdao:IAO_0000118 "worker";
                 cdao:IAO_0000119 "OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "worker role"@en;
                 rdfs:subClassOf cdao:OBI_0000202.
cdao:OBI_0000117 cdao:IAO_0000111 "Bernoulli trial";
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "An assay where the output data is a datum with one of two values denoting success and failure.";
                 cdao:IAO_0000117 "PlanAndPlannedProcess Branch";
                 cdao:IAO_0000119 "OBI branch derived";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Bernoulli trial";
                 rdfs:subClassOf cdao:OBI_0000070.
cdao:OBI_0000118 cdao:IAO_0000111 "gene list"@en;
                 cdao:IAO_0000112 "Gene lists may arise from analysis to determine differentially expressed genes, may be collected from the literature for involvement in a particular process or pathway (e.g., inflammation), or may be the input for gene set enrichment analysis."@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A data set of the names or identifiers of genes that are the outcome of an analysis or have been put together for the purpose of an analysis."@en;
                 cdao:IAO_0000117 "person:Chris Stoeckert"@en;
                 cdao:IAO_0000119 "group:OBI";
                 cdao:IAO_0000232 "kind of report. (alan) need to be careful to distinguish from output of a data transformation or calculation. A gene list is a report when it is published as such? Relates to question of whether report is a whole, or whether it can be a part of some other narrative object."@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "gene list"@en;
                 rdfs:subClassOf cdao:IAO_0000100.
cdao:OBI_0000119 cdao:IAO_0000111 "number of particles in subset"@en;
                 cdao:IAO_0000112 "500, 200, 0"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A measurement datum measuring the number of subjects in a defined subset in a flow cytometer instrument. The datum has a qualitative role"@en;
                 cdao:IAO_0000117 "person:Kevin Clancy"@en;
                 cdao:IAO_0000119 "Submitted by the Flow Cytometry community in DigitalEntity-FlowCytometry-2007-03-30.txt";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "number of particles in subset"@en;
                 rdfs:subClassOf cdao:IAO_0000109.
cdao:OBI_0000124 cdao:IAO_0000111 "is_supported_by_data";
                 cdao:IAO_0000112 """The relation between the conclusion \"Gene tpbA is involved in EPS production\" and the data items produced using two sets of organisms, one being a tpbA knockout, the other being tpbA wildtype tested in polysacharide production assays and analyzed using an ANOVA. """;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "The relation between a data item and a conclusion where the conclusion is the output of a data interpreting process and the data item is used as an input to that process";
                 cdao:IAO_0000117 "OBI";
                 cdao:IAO_0000119 "Philly 2011 workshop",
                                  "OBI";
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain cdao:OBI_0001909;
                 rdfs:label "is_supported_by_data";
                 rdfs:range cdao:IAO_0000027.
cdao:OBI_0000125 cdao:IAO_0000111 "number of lost events electronic"@en;
                 cdao:IAO_0000112 "74, 0, 14 events lost due to data acquisition electronic coincidence."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A measurement datum measuring the number of analysis events lost due to errors in data acquisition electronic coincidence in a flow cytometer instrument. The datum has a qualitative role."@en;
                 cdao:IAO_0000117 "person:Kevin Clancy"@en;
                 cdao:IAO_0000119 "Submitted by the Flow Cytometry community in DigitalEntity-FlowCytometry-2007-03-30.txt";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "number of lost events electronic"@en;
                 rdfs:subClassOf cdao:IAO_0000109.
cdao:OBI_0000129 cdao:IAO_0000111 "calibration substance role"@en;
                 cdao:IAO_0000112 "pH buffer used to calibrate a pH meter bears a calibration substance role"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A reference substance role that is realized when characteristics or responses elicited by the bearer are used to ensure an instrument is within protocol specification of accuracy or performance";
                 cdao:IAO_0000117 "Jennifer Fostel"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "calibration substance role"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> cdao:OBI_0000818 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000054 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000025.
cdao:OBI_0000131 cdao:IAO_0000111 "molecular feature identification objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Molecular_feature_identification_objective is a biological_feature_identification_objective role describing a study designed to examine or characterize molecular features of a biological system, e.g. expression profiling, copy number of molecular components, epigenetic modifications."@en;
                 cdao:IAO_0000117 "Jennifer Fostel"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "molecular feature identification objective"@en;
                 rdfs:subClassOf cdao:OBI_0000015.
cdao:OBI_0000134 cdao:IAO_0000111 "hardware testing objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Hardware_testing_objective is a methodology_testing_objective role describing a study designed to examine the effects of using different hardware, e.g. scanner."@en;
                 cdao:IAO_0000117 "Jennifer Fostel"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "hardware testing objective"@en;
                 rdfs:subClassOf cdao:OBI_0000208.
cdao:OBI_0000136 cdao:IAO_0000111 "incubator"@en;
                 cdao:IAO_0000112 "Incubators are used in microbiology for culturing (growing) bacteria and other microorganisms. Incubators in tissue culture rooms are used for culturing stem cells, lymphocytes, skin fibroblasts and other types of cells"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a device in which environmental conditions (light, photoperiod, temperature, humidity, etc.) can be controlled"@en;
                 cdao:IAO_0000117 "Frank Gibson"@en;
                 cdao:IAO_0000119 "http://www.medterms.com/script/main/art.asp?articlekey=18426"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "incubator"@en;
                 rdfs:subClassOf cdao:OBI_0002089,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000401 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0000140 cdao:IAO_0000111 "label role"@en;
                 cdao:IAO_0000114 cdao:IAO_0000428;
                 cdao:IAO_0000115 "Label role is a role which inheres in a material entity and which is realized in a detection of label assay"@en;
                 cdao:IAO_0000116 "need to add a restriction that the material entity has the disposition / quality that permits it to be detected, and one way to say this (BP) is that the entity is such that an assay exists that detects the presence of the material entity"@en,
                                  "Nucleotides synthesized with the incorporation of biotin were used to synthesize cDNA, which was then detected by adding fluorochrome-conjugated anti-biotin antibody.  the fluorochrome bears label role, the antibody bears detector role, the biotin bears reporter role. may need to change the terms following discussion"@en,
                                  "we need to sort out probe, detector and reporter.  See https://sourceforge.net/tracker/index.php?func=detail&amp;aid=1866458&amp;group_id=177891&amp;atid=886178"@en,
                                  "MHB (9-26-12): consider deprecation of this class and replacement with REO:'molecular label role'";
                 cdao:IAO_0000117 "Role Branch"@en;
                 cdao:IAO_0000118 "label";
                 cdao:IAO_0000119 "OBI";
                 cdao:IAO_0000231 cdao:IAO_0000228;
                 cdao:IAO_0100001 "http://purl.obolibrary.org/obo/REO_0000171";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "obsolete_label role"@en;
                 rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass>;
                 <http://www.w3.org/2002/07/owl#deprecated> true.
