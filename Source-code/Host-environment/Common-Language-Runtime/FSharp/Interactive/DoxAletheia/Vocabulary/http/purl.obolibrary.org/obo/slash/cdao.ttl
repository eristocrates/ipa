cdao:OBI_0000732 cdao:IAO_0000111 "restriction enzyme";
                 cdao:IAO_0000112 "The enzyme EcoR1 cuts DNA at the canonical cleavage site CAATTG";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "an enzyme that has a specific target cleavage sites within nucleic acids";
                 cdao:IAO_0000117 "Kevin Clancy, Bjoern Peters";
