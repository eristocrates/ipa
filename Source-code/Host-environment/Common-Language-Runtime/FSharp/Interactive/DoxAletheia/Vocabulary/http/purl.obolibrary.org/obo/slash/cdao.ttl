                                  "sacrifice"@en;
                 cdao:IAO_0000119 "CEBS, Biomaterial_branch"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "killing"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0100026
                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:PATO_0001421 ; 
                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000086 ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000456 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0100026
                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:PATO_0001422 ; 
                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000086 ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000094.
cdao:OBI_0600007 cdao:IAO_0000111 "administering substance in vivo"@en;
                 cdao:IAO_0000112 "Balb/c mice received an intracameral or subconjunctival injection of trinitrophenylated spleen cells",
                                  "injecting mice with 10 ug morphine intranasally, a patient taking two pills of 1 mg aspirin orally"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A process by which a substance is intentionally given to an organism resulting in exposure of the organism to that substance.";
                 cdao:IAO_0000116 "2009-11-10. Tracker: https://sourceforge.net/tracker/?func=detail&aid=2893050&group_id=177891&atid=886178",
                                  "Different routes and means of administration should go as children underneath this"@en,
                                  """Update the definition based on the discussion. Details see the tracker:
https://sourceforge.net/p/obi/obi-terms/738/""",
                                  "needs roles such as perturber and perturbee (children of input role). Perturb is too strong. Host might be the name for one role. Others considered: Doner, Donated, Acceptor."@en;
                 cdao:IAO_0000117 "Person:Bjoern Peters",
                                  "Bjoern Peters"@en;
                 cdao:IAO_0000119 "IEDB"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "administering substance in vivo"@en;
                 rdfs:subClassOf cdao:OBI_0000274,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000434 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0100026 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0100026 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000319 ; 
                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000055 ; 
                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0000444
                                                                                                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cdao:OBI_0100026
                                                                                                                                                                                                                                                                                                           cdao:UBERON_0000465) ; 
                                                                                                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000081 ; 
                                                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000055 ; 
                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0600008 cdao:IAO_0000111 "acquisition"@en;
                 cdao:IAO_0000112 "Downloading a 3D structure from the PDB. Purchasing antibodies from sigma. ";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "the planned process of gaining possession of a continuant "@en;
                 cdao:IAO_0000116 "5/31/2012 - OBI workshop: This process is not implying ownership of the material / information. ",
                                  """Following OBI call November 2012,5th:
addition of a restriction to acquisition class to capture the need of having selection criteria
Relates to the creation of a class 'selection rule'"""@en;
                 cdao:IAO_0000117 "Bjoern Peters"@en;
                 cdao:IAO_0000119 "IEDB"@en;
                 cdao:IAO_0000232 "This needs to be fleshed out and logical definitions added that will allow to place the children terms automatically under acquisition"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "acquisition"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001755 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000059 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000055 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0001928,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cdao:BFO_0000040
                                                                                                                           cdao:IAO_0000030) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0600009 cdao:IAO_0000111 "exposure of material to environment"@en;
                 cdao:IAO_0000112 "Putting cells in a freezer at -80C.  Cy5-labeled DNA is irradiated with a laser to excite the fluorophore. Inducing a phase transition in a material by putting it in an environment with a specific temperature. Oxygen deprivation in a chamber."@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "a planned process in which an input material is exposed to a defined set of conditions in a controlled environment. The environment is a specified input."@en;
                 cdao:IAO_0000117 "Bjoern Peters"@en;
                 cdao:IAO_0000119 "IEDB"@en;
                 cdao:IAO_0000232 "Alan says there will be problmes, e.g. with selection by survival"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "exposure of material to environment"@en;
                 rdfs:subClassOf cdao:OBI_0000011.
cdao:OBI_0600010 cdao:IAO_0000111 "material acquisition"@en;
                 cdao:IAO_0000112 "Acquiring 50 C57BL/6 mice bred in the animal facility of the institute as a service to investigators. Purchasing 1 mg of peptides synthesized by Mimotopes at 80% purity. Getting a gift of purified CD4+ specific antibodies presented by Stephen Schoenberger at LIAI."@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An acquisition in which possession of a material entity is gained."@en;
                 cdao:IAO_0000116 "This excludes processes that create or change materials, such as material transformations.",
                                  "The assumption is that the object already exists in its current state, e.g, an available mouse strain purchased from the Jackson Lab, this is the differentia from specimen creation";
                 cdao:IAO_0000117 "Bjoern Peters, Alan Ruttenberg, Helen Parkinson"@en;
                 cdao:IAO_0000118 "material procurement";
                 cdao:IAO_0000119 "IEDB"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "material acquisition"@en;
                 rdfs:subClassOf cdao:OBI_0600008,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:BFO_0000040 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0600011 cdao:IAO_0000111 "acclimatization"@en;
                 cdao:IAO_0000112 "placing mice in animal facility for 2 weeks prior to an experiment to accustom them to their environment, reducing stress"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A protocol application in which an object is left in an environment for some period of time, until some qualities of interest are in equilibrium with that environment."@en;
                 cdao:IAO_0000117 "Jennifer Fostel"@en;
                 cdao:IAO_0000119 "CEBS, Biomaterial_branch"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "acclimatization"@en;
                 rdfs:subClassOf cdao:OBI_0600009.
cdao:OBI_0600012 cdao:IAO_0000111 "environmental material collection"@en;
                 cdao:IAO_0000112 "Taking 1 liter of surface ocean water from the San Diego Mission Bay Jetty. Capturing mice living in rural Arkansas"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "environmental_material_collection is an acquisition where an object is taken from an environment and put into a storage container. Roles include, environment, thing collected, container, acquirer."@en;
                 cdao:IAO_0000116 """relabel the term and add axiom connecting to EnVO:'environmental material'
discussed on obi-dev call 9/28/2015, details see: https://sourceforge.net/p/obi/obi-terms/779/""";
                 cdao:IAO_0000117 "Bjoern Peters, Alan Ruttenberg"@en;
                 cdao:IAO_0000119 "IEDB"@en;
                 cdao:IAO_0000232 "the researcher is very interested in the location"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "environmental material collection process"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000684 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000659,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:ENVO_00010483 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0100051 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0600013 cdao:IAO_0000111 "information acquisition"@en;
                 cdao:IAO_0000112 "Gathering all influenza HA sequences from GenBank, Retrieveing HLA allele frequencies in the North American populations from dbMHC"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An acquisition in which possession of information is gained."@en;
                 cdao:IAO_0000116 "This excludes processes that create or change information, such as assays and data transformations.";
                 cdao:IAO_0000117 "Bjoern Peters"@en;
                 cdao:IAO_0000118 "data collection";
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "information acquisition"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000030 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0600008.
cdao:OBI_0600014 cdao:IAO_0000111 "material component separation"@en;
                 cdao:IAO_0000112 "Using a cell sorter to separate a mixture of T cells into two fractions; one with surface receptor CD8 and the other lacking the receptor, or purification"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "a material processing in which components of an input material become segregated in space"@en;
                 cdao:IAO_0000117 "Bjoern Peters"@en;
                 cdao:IAO_0000119 "IEDB"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "material component separation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:BFO_0000040 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000094,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:BFO_0000040 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000639 ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0600015 cdao:IAO_0000111 "group assignment"@en;
                 cdao:IAO_0000112 "Assigning' to be treated with active ingredient role' to an organism during group assignment. The group is those organisms that have the same role in the context of an investigation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "group assignment is a process which has an organism as specified input and during which a role is assigned"@en;
                 cdao:IAO_0000117 "Philippe Rocca-Serra"@en;
                 cdao:IAO_0000118 "cohort assignment",
                                  "study assignment";
                 cdao:IAO_0000119 "OBI Plan"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "group assignment"@en;
                 rdfs:subClassOf cdao:OBI_0000011,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:BFO_0000023
                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0100026 ; 
                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000052 ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0100026 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0600016 cdao:IAO_0000111 "pooling specimens";
                 cdao:IAO_0000112 "http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=104564; Combining spleens of 20 mice, Combining supernatant from a cell culture obtained at different time points"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "physical combination of several instances of like material"@en;
                 cdao:IAO_0000117 "PlanAndPlannedProcess Branch"@en;
                 cdao:IAO_0000118 "sample pooling"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 cdao:IAO_0000232 "like' is one of the things that you should be controling for in a well-designed experiment. The instances of material need to have the same class."@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "pooling specimens"@en;
                 rdfs:subClassOf cdao:OBI_0000652,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0100051 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000686 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0302716 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#minCardinality> "2"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0600017 cdao:IAO_0000111 "assay detecting a molecular label";
                 cdao:IAO_0000112 "Determination of the amount of phycoerytherin label present in a cell population stained with anti-CD8-PE in order to determine the percentage of CD8+ T cells present";
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "An assay that detects the presence or a quality of a molecular label which is a proxy for the detection of the molecular target to which the label is attached";
                 cdao:IAO_0000117 "Matthew Brush";
                 cdao:IAO_0000119 "OBI developer call, 3-12-12";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "assay detecting a molecular label";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001936 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000136 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001936 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000070,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000109 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0600018 cdao:IAO_0000111 "material portioning"@en;
                 cdao:IAO_0000112 "pouring 50 mL aliquots of fetal calf serum into conical tubes from a 500 mL stock"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "a material processing in which the input substance is partitioned into a number of portions that are similar in composition."@en;
                 cdao:IAO_0000117 "PERSON:Bjoern Peters"@en;
                 cdao:IAO_0000118 "apportioning"@en,
                                  "aliquoting"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "material portioning"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000678 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0600014.
cdao:OBI_0600019 cdao:IAO_0000111 "non-specific labeling"@en;
                 cdao:IAO_0000112 "The addition of phycoerytherin label to an anti-CD8 antibody, to label all antibodies."@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "The addition of a reagent labeling the entire input biomaterial enabling future detection of the output biomaterial"@en;
                 cdao:IAO_0000117 "PlanAndPlannedProcess Branch"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 cdao:IAO_0000232 "definition blessed by Allyson, Bjoern, Jay & Randi"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "non-specific labeling"@en;
                 rdfs:subClassOf cdao:OBI_0600038.
cdao:OBI_0600020 cdao:IAO_0000111 "histological assay";
                 cdao:IAO_0000112 "the counting of the number of cells with fluorescent label at their surface to determine the percentage of the population which was activated";
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "An assay that uses visual examination of cells or tissue (or images of them) to make an assessment regarding a quality of the cells or tissue. This assay can include steps of staining, imaging, and judgement.";
                 cdao:IAO_0000117 "Adam Witney",
                                  "Helen Parkinson";
                 cdao:IAO_0000118 "histopathology",
                                  "histology";
                 cdao:IAO_0000119 "OBI branch derived";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "histological assay";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000185 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cdao:CL_0000000
                                                                                                                                                                           cdao:OBI_0100066) ; 
