                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0000871 cdao:IAO_0000111 "viral hemagglutination assay";
                 cdao:IAO_0000112 "Determining the viral titer of a virus infected human by measuring the presence of hemagglutination when dilutions of serum samples are added to a known quantity of red blood cells.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An assay that quantifies viruses by their hemagglutination activity.";
                 cdao:IAO_0000117 "Melanie Courtot",
                                  "Bjoern Peters",
                                  "Randi Vita";
                 cdao:IAO_0000118 "viral haemagglutinin assay",
                                  "HI",
                                  "HA";
                 cdao:IAO_0000119 "url:http://en.wikipedia.org/wiki/Hemagglutination_assay";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "viral hemagglutination assay";
                 rdfs:subClassOf cdao:OBI_0000443,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000109 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
