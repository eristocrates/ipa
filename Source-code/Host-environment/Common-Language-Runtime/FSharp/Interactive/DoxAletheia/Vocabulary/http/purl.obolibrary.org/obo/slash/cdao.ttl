                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0000204 cdao:IAO_0000111 "nutrient role";
                 cdao:IAO_0000112 "Luria broth; vitamin A; A nutrient is a substance used in an organism's metabolism which must be taken in from the environment.  Wikipedia."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a role that inheres in a material entity and is realized in the use of that material entity by an organism when it is used in that organism's metabolism and provides nourishment."@en;
                 cdao:IAO_0000117 "GROUP:  Role branch"@en;
                 cdao:IAO_0000118 "nutrient";
                 cdao:IAO_0000119 "Wikipedia, feb 29, 2008"@en;
                 cdao:IAO_0000232 "19 Feb 2009; old def: A nutrient role is a role played by a substance used in an organism's metabolism which is taken in from the environment and provides nourishment.";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "nutrient role"@en;
                 rdfs:subClassOf cdao:BFO_0000023,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:BFO_0000040 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000052 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0000205 cdao:IAO_0000111 "Dropout"@en;
                 cdao:IAO_0000112 "Escaped rat; human who moved to another city. Rat which escapes part way through a study; a human study participant who moved to another city before the study was completed (and stopped participating in the study)"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Dropout is a study subject role borne by an entity realized by a process of leaving the study earlier than the protocol specified and where the bearer of the dropout role had been borne study subject role prior to bearing dropout role."@en;
                 cdao:IAO_0000116 """Will be modelled as defined material, ouput of some 'dropout or withdrawal
process' instead of role""";
                 cdao:IAO_0000117 "Role Branch"@en;
                 cdao:IAO_0000119 "OBI";
                 cdao:IAO_0000231 cdao:IAO_0000103;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "obsolete_dropout role"@en;
                 rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass>;
                 <http://www.w3.org/2002/07/owl#deprecated> true.
