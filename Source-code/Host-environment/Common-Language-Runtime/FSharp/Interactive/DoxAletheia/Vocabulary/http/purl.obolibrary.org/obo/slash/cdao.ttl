cdao:OBI_0000260 cdao:IAO_0000111 "plan"@en;
                 cdao:IAO_0000112 "The plan of researcher X to perform an experiment according to a protocol.";
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A plan is a realizable entity that is the inheres in a bearer who is committed to realizing it as a planned process."@en;
                 cdao:IAO_0000116 "This class is included to make clear how the plan specification, the plan, and the planned process relate. OBI will however only subclass and work under the 'plan specification', and 'planned process' class, as we want to avoid to get deep into discussions of 'intend' etc.";
                 cdao:IAO_0000117 "AR, BP, JM, MC, PRS"@en;
                 cdao:IAO_0000119 "branch derived"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "plan"@en;
                 rdfs:subClassOf cdao:BFO_0000017.
