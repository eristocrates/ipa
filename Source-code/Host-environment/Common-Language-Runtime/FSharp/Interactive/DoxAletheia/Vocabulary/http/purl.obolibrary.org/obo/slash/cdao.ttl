                                 [<http://www.w3.org/2002/07/owl#hasValue> cdao:OBI_0001004 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0001002 cdao:IAO_0000111 "Faraday cage";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A device formed by conducting material or by a mesh of such material, that blocks out external static electric fields.";
                 cdao:IAO_0000117 "PERSON:Bjoern Peters";
                 cdao:IAO_0000118 "Faraday shield";
                 cdao:IAO_0000119 "Wikipedia http://en.wikipedia.org/wiki/Faraday_cage";
