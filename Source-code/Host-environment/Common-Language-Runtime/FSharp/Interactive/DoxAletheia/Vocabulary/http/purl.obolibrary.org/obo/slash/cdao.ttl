cdao:OBI_0001633 cdao:IAO_0000111 "purified material";
                 cdao:IAO_0000112 "A mixture of peptide molecules that has been run through an HPLC column to remove 65";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A material entity that is generated by a purification process in which an input material is separated to obtain a fraction with a higher concentration of a desired component";
                 cdao:IAO_0000117 "GROUP: OBI call ";
