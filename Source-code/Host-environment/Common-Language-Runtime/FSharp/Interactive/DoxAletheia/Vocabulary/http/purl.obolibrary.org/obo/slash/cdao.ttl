                 cdao:IAO_0000112 "Opisthorchis viverrini: Detection by polymerase chain reaction (PCR) in human stool samples. Exp Parasitol. 2008 Sep 9.  PMID: 18805413"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "PCR is the process in which a DNA polymerase is used to amplify a piece of DNA by in vitro enzymatic replication. As PCR progresses, the DNA thus generated is itself used as a template for replication. This sets in motion a chain reaction in which the DNA template is exponentially amplified."@en;
                 cdao:IAO_0000117 "OBI Plan";
                 cdao:IAO_0000118 "PCR"@en;
                 cdao:IAO_0000119 "adapted from wikipedai";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "polymerase chain reaction"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:CHEBI_16991 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000456 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000406 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0600058,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0000376
                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:GO_0042575 ; 
                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000052 ; 
