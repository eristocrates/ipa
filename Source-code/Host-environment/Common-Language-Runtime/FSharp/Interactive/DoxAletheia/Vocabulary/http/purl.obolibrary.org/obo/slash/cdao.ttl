                                 cdao:OBI_0000025.
cdao:OBI_0000065 cdao:IAO_0000111 "polyethylene glycol p-(1,1,3,3-tetramethylbutyl)-phenyl ether"@en;
                 cdao:IAO_0000112 "PMID: 30799. J Histochem Cytochem. 1978 Sep;26(9):696-712. Acid lipase: a histochemical and biochemical study using triton X100-naphtyl palmitate micelles."@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "triton X100 is a chemical entity which belongs to the group of The pluronics which are triblock copolymers of ethylene oxide and propylene oxide. Triton x-100 is_used_as detergent due to its non-ionic surfactant properties"@en;
                 cdao:IAO_0000117 "Philippe Rocca-Serra"@en;
                 cdao:IAO_0000119 "adapted from Wikipedia before possible import from CHEBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "polyethylene glycol p-(1,1,3,3-tetramethylbutyl)-phenyl ether"@en;
                 rdfs:subClassOf cdao:CHEBI_23367.
cdao:OBI_0000066 cdao:IAO_0000111 "investigation"@en;
                 cdao:IAO_0000112 "Lung cancer investigation using expression profiling, a stem cell transplant investigation, biobanking is not an investigation, though it may be part of an investigation";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "a planned process that consists of parts: planning, study design execution, documentation and which produce conclusion(s)."@en;
                 cdao:IAO_0000117 "Bjoern Peters"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 cdao:IAO_0000232 """Following OBI call November 2012,26th: it was decided there was no need for adding \"achieves objective of drawing conclusion\" as existing relations were providing equivalent ability. this note closes the issue and validates the class definition to be part of the OBI core
editor = PRS"""@en,
                                  "Could add specific objective specification";
                 cdao:IAO_0000412 cdao:obi.owl;
                 cdao:OBI_0001847 "study";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "investigation"@en;
