                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:CHEBI_33697 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0600029 cdao:IAO_0000111 "isolation of cell culture supernatant"@en;
                 cdao:IAO_0000112 "Pouring out a portion of the fluid part of an adherant cell culture growing in a flask.; The centrifugation of a T cell culture followed by aspiration of the supernatant while the cellular pellet remains in the centrifuge tube."@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "a protocol which results in the separation of supernatant material from a cell culture"@en;
                 cdao:IAO_0000116 "This does not apply to the case where the cells are lysed"@en;
                 cdao:IAO_0000117 "PlanAndPlannedProcess Branch"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "isolation of cell culture supernatant"@en;
                 rdfs:subClassOf cdao:OBI_0600014,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000681 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0600030 cdao:IAO_0000111 "experimental disease induction"@en;
                 cdao:IAO_0000112 "the injection of mice with LCM virus iv to establish an LCMV infection. Witholding food from animals to induce starvation syndrome."@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "a protocol application to induce a specific disease in an organism"@en;
                 cdao:IAO_0000117 "PlanAndPlannedProcess Branch"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 cdao:IAO_0000232 "could be defined class"@en;
