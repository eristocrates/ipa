                 cdao:IAO_0000116 "need to add Klenow subunit of DNA polymerase I under material entity";
                 cdao:IAO_0000117 """Person: Bjoern Peters
Person: Chris Stoeckert""",
                                  "Person: Philippe Rocca-Serra";
                 cdao:IAO_0000119 "PMID: 6312838. A technique for radiolabeling DNA restriction endonuclease fragments to high specific activity. Feinberg AP, Vogelstein B. Anal Biochem. 1983 Jul 1;132(1):6-13.";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "random primed DNA labeling";
