cdao:OBI_0000054 cdao:IAO_0000111 "ratio of collected to emitted light"@en;
                 cdao:IAO_0000112 "10%"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A measurement datum measuring the amount of light collected s compared to the total amount of emitted light in the detector component of a flow cytometer instrument. The datum has a qualitative role"@en;
                 cdao:IAO_0000117 "person:Chris Stoeckert"@en,
                                  "person:Kevin Clancy"@en;
                 cdao:IAO_0000119 "Submitted by the Flow Cytometry community in DigitalEntity-FlowCytometry-2007-03-30.txt";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "ratio of collected to emitted light"@en;
                 rdfs:subClassOf cdao:IAO_0000109.
cdao:OBI_0000055 cdao:IAO_0000111 "software optimization objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Software_optimization is a software_testing_objective role describing a study designed to identify the best software or parameters of the software."@en;
                 cdao:IAO_0000117 "Jennifer Fostel"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "software optimization objective"@en;
