                                 cdao:OBI_0001146.
cdao:OBI_0001980 cdao:IAO_0000111 "in vivo intervention experiment";
                 cdao:IAO_0000112 "Comparing the level of allergy symptoms in humans before and post allergy immunotherapy. Testing if injection of a chemical compound into mice will lead to decreased survival.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An assay in which the effect of a targeted process (the intervention) on an organism is tested.";
                 cdao:IAO_0000116 "The intervention in an experiment should be modeled accordingly to the intevention carried out in a human cllinical trial, which is currently modeled as 'study intervention'. This touches the boundaries of study vs. assay.";
                 cdao:IAO_0000117 "IEDB";
                 cdao:IAO_0000119 "IEDB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "in vivo intervention experiment";
                 rdfs:subClassOf cdao:OBI_0000070,
