                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000221 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:UO_0000001 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000039 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000032.
cdao:IAO_0000409 cdao:IAO_0000112 """The Basic Formal Ontology ontology makes a distinction between Universals and defined classes, where the formal are \"natural kinds\" and the latter arbitrary collections of entities.""";
                 cdao:IAO_0000115 "A denotator type indicates how a term should be interpreted from an ontological perspective.";
                 cdao:IAO_0000117 "Alan Ruttenberg";
                 cdao:IAO_0000119 "Barry Smith, Werner Ceusters";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "denotator type";
                 rdfs:subClassOf cdao:IAO_0000102;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (cdao:IAO_0000410
                                                                                                         cdao:IAO_0000420
                                                                                                         cdao:IAO_0000421) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:IAO_0000410 cdao:IAO_0000116 """Hard to give a definition for. Intuitively a \"natural kind\" rather than a collection of any old things, which a class is able to be, formally. At the meta level, universals are defined as positives, are disjoint with their siblings, have single asserted parents.""";
                 cdao:IAO_0000117 "Alan Ruttenberg";
                 cdao:IAO_0000119 "A Formal Theory of Substances, Qualities, and Universals, http://ontology.buffalo.edu/bfo/SQU.pdf";
                 a cdao:IAO_0000409,
                   <http://www.w3.org/2002/07/owl#NamedIndividual>;
                 rdfs:label "universal".
cdao:IAO_0000411 cdao:IAO_0000111 "is denotator type"@en;
                 cdao:IAO_0000115 "relates an class defined in an ontology, to the type of it's denotator";
                 cdao:IAO_0000116 "In OWL 2 add AnnotationPropertyRange('is denotator type' 'denotator type')";
                 cdao:IAO_0000117 "Alan Ruttenberg";
                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:label "is denotator type".
cdao:IAO_0000412 cdao:IAO_0000111 "imported from"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "For external terms/classes, the ontology from which the term was imported"@en;
                 cdao:IAO_0000117 "PERSON:Melanie Courtot"@en,
                                  "PERSON:Alan Ruttenberg"@en;
                 cdao:IAO_0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en;
                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:isDefinedBy cdao:iao.owl;
                 rdfs:label "imported from"@en.
cdao:IAO_0000413 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "relates a process to a time-measurement-datum that represents the duration of the process"@en;
                 cdao:IAO_0000117 "Person:Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain cdao:IAO_0000416;
                 rdfs:label "is duration of"@en;
                 rdfs:range cdao:BFO_0000015;
                 rdfs:subPropertyOf cdao:IAO_0000136.
cdao:IAO_0000414 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A scalar measurement datum that is the result of measurement of mass quality"@en;
                 cdao:IAO_0000116 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"@en;
                 cdao:IAO_0000117 "Person:Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "mass measurement datum"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#allValuesFrom> cdao:UO_0000002 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000039 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#allValuesFrom> cdao:PATO_0000125 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000221 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 cdao:IAO_0000032.
cdao:IAO_0000415 cdao:IAO_0000111 "hypothesis textual entity"@en;
                 cdao:IAO_0000112 "that fucoidan has a small statistically significant effect on AT3 level but no useful clinical effect as in-vivo anticoagulant, a paraphrase of part of the last paragraph of the discussion section of the paper 'Pilot clinical study to evaluate the anticoagulant activity of fucoidan', by Lowenthal et. al.PMID:19696660"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A textual entity that expresses an assertion that is intended to be tested."@en;
                 cdao:IAO_0000116 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"@en;
                 cdao:IAO_0000117 "Person:Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "hypothesis textual entity"@en;
                 rdfs:subClassOf cdao:IAO_0000300.
cdao:IAO_0000416 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A scalar measurement datum that is the result of measuring a temporal interval"@en;
                 cdao:IAO_0000116 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case"@en;
                 cdao:IAO_0000117 "Person:Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "time measurement datum"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#allValuesFrom> cdao:UO_0000003 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000039 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#allValuesFrom> cdao:BFO_0000015 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000413 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 cdao:IAO_0000032.
cdao:IAO_0000417 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "inverse of the relation of is quality measurement of"@en;
                 cdao:IAO_0000116 "2009/10/19 Alan Ruttenberg. Named 'junk' relation useful in restrictions, but not a real instance relationship"@en;
                 cdao:IAO_0000117 "Person:Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:label "is quality measured as"@en;
                 <http://www.w3.org/2002/07/owl#equivalentProperty> [<http://www.w3.org/2002/07/owl#inverseOf> cdao:IAO_0000221].
cdao:IAO_0000418 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a relation between a data item and a quality of a material entity where the material entity is the specified output of a material transformation which achieves an objective specification that indicates the intended value of the specified quality."@en;
                 cdao:IAO_0000117 "Person:Bjoern Peters"@en,
                                  "Person:Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:label "is quality specification of"@en;
                 rdfs:subPropertyOf cdao:IAO_0000136;
                 <http://www.w3.org/2002/07/owl#equivalentProperty> [<http://www.w3.org/2002/07/owl#inverseOf> cdao:IAO_0000419];
                 <http://www.w3.org/2002/07/owl#inverseOf> cdao:IAO_0000419.
cdao:IAO_0000419 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "inverse of the relation of is quality specification of"@en;
                 cdao:IAO_0000116 "2009/10/19 Alan Ruttenberg. Named 'junk' relation useful in restrictions, but not a real instance relationship"@en;
                 cdao:IAO_0000117 "Person:Bjoern Peters"@en,
                                  "Person:Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:label "quality is specified as"@en;
                 <http://www.w3.org/2002/07/owl#equivalentProperty> [<http://www.w3.org/2002/07/owl#inverseOf> cdao:IAO_0000418].
cdao:IAO_0000420 cdao:IAO_0000115 "A defined class is a class that is defined by a set of logically necessary and sufficient conditions but is not a universal";
                 cdao:IAO_0000116 """\"definitions\", in some readings, always are given by necessary and sufficient conditions. So one must be careful (and this is difficult sometimes) to distinguish between defined classes and universal.""";
                 cdao:IAO_0000117 "Alan Ruttenberg";
                 a cdao:IAO_0000409,
                   <http://www.w3.org/2002/07/owl#NamedIndividual>;
                 rdfs:label "defined class".
cdao:IAO_0000421 cdao:IAO_0000115 "A named class expression is a logical expression that is given a name. The name can be used in place of the expression.";
                 cdao:IAO_0000116 "named class expressions are used in order to have more concise logical definition but their extensions may not be interesting classes on their own. In languages such as OWL, with no provisions for macros, these show up as actuall classes. Tools may with to not show them as such, and to replace uses of the macros with their expansions";
                 cdao:IAO_0000117 "Alan Ruttenberg";
                 a cdao:IAO_0000409,
                   <http://www.w3.org/2002/07/owl#NamedIndividual>;
                 rdfs:label "named class expression".
cdao:IAO_0000422 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A textual entity that is used as directive to deliver something to a person, or organization";
                 cdao:IAO_0000116 "2010-05-24 Alan Ruttenberg. Use label for the string representation. See issue https://github.com/information-artifact-ontology/IAO/issues/59";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "postal address"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:GAZ_00000448 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000136 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000300.
cdao:IAO_0000423 cdao:IAO_0000115 "Terms with this status should eventually replaced with a term from another ontology."@en;
                 cdao:IAO_0000117 "Alan Ruttenberg"@en;
                 cdao:IAO_0000119 "group:OBI"@en;
                 a cdao:IAO_0000078,
                   <http://www.w3.org/2002/07/owl#NamedIndividual>;
                 rdfs:label "to be replaced with external ontology term"@en.
cdao:IAO_0000424 cdao:IAO_0000111 "expand expression to"@en;
                 cdao:IAO_0000112 """ObjectProperty: RO_0002104
Label: has plasma membrane part
Annotations: IAO_0000424 \"http://purl.obolibrary.org/obo/BFO_0000051 some (http://purl.org/obo/owl/GO#GO_0005886 and http://purl.obolibrary.org/obo/BFO_0000051 some ?Y)\"
"""@en;
                 cdao:IAO_0000115 "A macro expansion tag applied to an object property (or possibly a data property)  which can be used by a macro-expansion engine to generate more complex expressions from simpler ones"@en;
                 cdao:IAO_0000117 "Chris Mungall";
                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:label "expand expression to"@en.
cdao:IAO_0000425 cdao:IAO_0000111 "expand assertion to"@en;
                 cdao:IAO_0000112 """ObjectProperty: RO???
Label: spatially disjoint from
Annotations: expand_assertion_to \"DisjointClasses: (http://purl.obolibrary.org/obo/BFO_0000051 some ?X)  (http://purl.obolibrary.org/obo/BFO_0000051 some ?Y)\"
"""@en;
                 cdao:IAO_0000115 "A macro expansion tag applied to an annotation property which can be expanded into a more detailed axiom."@en;
                 cdao:IAO_0000117 "Chris Mungall"@en;
                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:label "expand assertion to"@en.
cdao:IAO_0000426 cdao:IAO_0000111 "first order logic expression"@en;
                 cdao:IAO_0000117 "PERSON:Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:label "first order logic expression"@en.
cdao:IAO_0000427 cdao:IAO_0000111 "antisymmetric property"@en;
                 cdao:IAO_0000112 "part_of antisymmetric property xsd:true"@en;
                 cdao:IAO_0000115 "use boolean value xsd:true to indicate that the property is an antisymmetric property"@en;
                 cdao:IAO_0000117 "Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:label "antisymmetric property"@en.
cdao:IAO_0000428 cdao:IAO_0000115 "A term that is metadata complete, has been reviewed, and problems have been identified that require discussion before release. Such a term requires editor note(s) to identify the outstanding issues."@en;
                 cdao:IAO_0000117 "Alan Ruttenberg"@en;
                 cdao:IAO_0000119 "group:OBI"@en;
                 a cdao:IAO_0000078,
                   <http://www.w3.org/2002/07/owl#NamedIndividual>;
                 rdfs:label "requires discussion"@en.
cdao:IAO_0000429 cdao:IAO_0000111 "email address"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000116 "Alan Ruttenberg 1/3/2012 - Provisional id, see issue at https://github.com/information-artifact-ontology/IAO/issues/130&thanks=130&ts=1325636583"@en;
                 cdao:IAO_0000117 "Person:Chris Stoeckart"@en,
                                  "Person:Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "email address"@en;
                 rdfs:subClassOf cdao:IAO_0000030.
cdao:IAO_0000442 cdao:IAO_0000111 "author role"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A role inhering in a person or organization that is realized when the bearer participates in the work which is the basis of the document, in the writing of the document, and signs it with their name."@en;
                 cdao:IAO_0000117 "PERSON: Melanie Courtot"@en,
                                  "PERSON: Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "author role"@en;
                 rdfs:subClassOf cdao:BFO_0000023.
cdao:IAO_0000443 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a planned process in which journal articles are read or processed and data items are extracted, typically for further analysis or indexing";
                 cdao:IAO_0000117 "Person:Alan Ruttenberg";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "data item extraction from journal article";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000027 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000013 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000011.
cdao:IAO_0000572 cdao:IAO_0000112 "Recording the current temperature in a laboratory notebook. Writing a journal article. Updating a patient record in a database."@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "a planned process in which a document is created or added to by including the specified input in it."@en;
                 cdao:IAO_0000116 "6/11/9: Edited at OBI workshop. We need to be able identify a child form of information artifact which corresponds to something enduring (not brain like). This used to be restricted to physical document or digital entity as the output, but that excludes e.g. an audio cassette tape"@en;
                 cdao:IAO_0000117 "Bjoern Peters"@en;
                 cdao:IAO_0000119 "wikipedia http://en.wikipedia.org/wiki/Documenting"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "documenting"@en;
                 rdfs:subClassOf cdao:OBI_0000011,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000310 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000030 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:IAO_0000573 cdao:IAO_0000111 "line graph"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 """A line graph is a type of graph created by connecting a series of data
points together with a line."""@en;
                 cdao:IAO_0000117 "PERSON:Chris Stoeckert"@en,
                                  "PERSON:Melanie Courtot"@en;
                 cdao:IAO_0000118 "line chart"@en;
                 cdao:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Line_chart"@en,
                                  "GROUP:OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "line graph"@en;
                 rdfs:subClassOf cdao:IAO_0000038.
cdao:IAO_0000574 cdao:IAO_0000112 "A new pubmed ID being created for a journal article, and the associated pubmed record containing information to the journal article. A license plate number registered at the DMV to be belonging to a specific vehicle and owner. Placing a barcode on a product and entering information in a database that this barcode is assigned."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a planned process in which a new CRID is created, associated with an entity, and stored in the CRID registry thereby registering it as being associated with some entity"@en;
                 cdao:IAO_0000116 "2014-05-05: It is the CRID registry that assigns CRIDs, not the users of the registry."@en;
                 cdao:IAO_0000117 "Person:Alan Ruttenberg"@en,
                                  "Person:Melanie Courtot"@en,
                                  "Person:Bjoern Peters"@en;
                 cdao:IAO_0000118 "assigning a CRID";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "assigning a centrally registered identifier"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000577 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000011,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000579 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000057 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:IAO_0000575 cdao:IAO_0000112 "Articles in Pubmed are reviewed by curators who add MESH terms to the Pubmed records in order to categorize them better and improve the ability to search for them. ";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A planned process in which a CRID registry associates an information content entity with a CRID symbol"@en;
                 cdao:IAO_0000117 "PERSON:Alan Ruttenberg"@en;
                 cdao:IAO_0000118 "associating information with a CRID in the CRID registry";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "associating information with a centrally registered identifier in its registry"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000577 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000011,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000579 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000057 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000030 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:IAO_0000576 cdao:IAO_0000115 "a planned process with the objective to establish a system that allows to refer to specific entities of a certain kind and store information about them, by establishing a CRID registry and plan specifications for the process of 1) assigning a CRID and 2) looking up a CRID.";
                 cdao:IAO_0000116 "MC, 20101124: deprecated following discussion at IAO call 20101124. Term was deemed not necessary - no use case for now.";
                 cdao:IAO_0000231 cdao:IAO_0000103;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "obsolete_establishing a CRID registry";
                 rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass>;
                 <http://www.w3.org/2002/07/owl#deprecated> true.
cdao:IAO_0000577 cdao:IAO_0000112 """The sentence \"The article has Pubmed ID 12345.\" contains a CRID that has two parts: one part is the CRID symbol, which is '12345'; the other part denotes the CRID registry, which is Pubmed."""@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A symbol that is part of a CRID and that is sufficient to look up a record from the CRID's registry."@en;
                 cdao:IAO_0000117 "PERSON: Bill Hogan"@en,
                                  "PERSON: Alan Ruttenberg"@en,
                                  "PERSON: Bjoern Peters"@en,
                                  "PERSON: Melanie Courtot"@en;
                 cdao:IAO_0000118 "CRID symbol";
                 cdao:IAO_0000119 "Original proposal from Bjoern, discussions at IAO calls"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "centrally registered identifier symbol"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000578 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000050 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000028.
cdao:IAO_0000578 cdao:IAO_0000112 """The sentence \"The article has Pubmed ID 12345.\" contains a CRID that has two parts: one part is the CRID symbol, which is '12345'; the other part denotes the CRID registry, which is Pubmed."""@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An information content entity that consists of a CRID symbol and additional information about the CRID registry to which it belongs."@en;
                 cdao:IAO_0000116 "2014-05-05: In defining this term we take no position on what the CRID denotes. In particular do not assume it denotes a *record* in the CRID registry (since the registry might not have 'records')."@en,
                                  """Alan, IAO call 20101124: potentially the CRID denotes the instance it was associated with during creation. 
"""@en,
                                  "Note, IAO call 20101124: URIs are not always CRID, as not centrally registered. We acknowledge that CRID is a subset of a larger identifier class, but this subset fulfills our current needs. OBI PURLs are CRID as they are registered with OCLC. UPCs (Universal Product Codes from AC Nielsen)are not CRID as they are not centrally registered."@en;
                 cdao:IAO_0000117 "PERSON: Melanie Courtot"@en,
                                  "PERSON: Bjoern Peters"@en,
                                  "PERSON: Alan Ruttenberg"@en,
                                  "PERSON: Bill Hogan"@en;
                 cdao:IAO_0000118 "CRID";
                 cdao:IAO_0000119 "Original proposal from Bjoern, discussions at IAO calls"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "centrally registered identifier"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000579 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000219 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000030,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000577 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:IAO_0000579 cdao:IAO_0000112 "PubMed is a CRID registry. It has a dataset of PubMed identifiers associated with journal articles. "@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A CRID registry is a dataset of CRID records, each consisting of a CRID symbol and additional information which was recorded in the dataset through a assigning a centrally registered identifier process."@en;
                 cdao:IAO_0000117 "PERSON: Bill Hogan"@en,
                                  "PERSON: Bjoern Peters"@en,
                                  "PERSON: Alan Ruttenberg"@en,
                                  "PERSON: Melanie Courtot"@en;
                 cdao:IAO_0000118 "CRID registry";
                 cdao:IAO_0000119 "Original proposal from Bjoern, discussions at IAO calls"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "centrally registered identifier registry"@en;
                 rdfs:subClassOf cdao:IAO_0000100.
cdao:IAO_0000580 cdao:IAO_0000112 "Going to the PubMed website and entering a PubMed ID in order to retrieve the Pubmed information associated with that ID. ";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A planned process in which a request to a CRID registry is made to return the information associated with a CRID symbol"@en;
                 cdao:IAO_0000117 "PERSON: Melanie Courtot"@en,
                                  "PERSON: Bill Hogan"@en,
                                  "PERSON: Bjoern Peters"@en,
                                  "PERSON: Alan Ruttenberg"@en;
                 cdao:IAO_0000118 "looking up a CRID";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "looking up a centrally registered identifier"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000577 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000011,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000030 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000579 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000057 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:IAO_0000581 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "relates a time stamped measurement datum to the time measurement datum that denotes the time when the measurement was taken"@en;
                 cdao:IAO_0000117 "Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                   <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain cdao:IAO_0000582;
                 rdfs:label "has time stamp"@en;
                 rdfs:range cdao:IAO_0000416;
                 rdfs:subPropertyOf cdao:BFO_0000051.
cdao:IAO_0000582 cdao:IAO_0000114 cdao:IAO_0000123;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "time stamped measurement datum"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000416 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000581 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000109 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000583 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 cdao:IAO_0000109.
cdao:IAO_0000583 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "relates a time stamped measurement datum to the measurement datum that was measured"@en;
                 cdao:IAO_0000117 "Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain cdao:IAO_0000582;
                 rdfs:label "has measurement datum"@en;
                 rdfs:range [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:IAO_0000109
                                                                             [<http://www.w3.org/2002/07/owl#complementOf> cdao:IAO_0000416 ; 
                                                                             a <http://www.w3.org/2002/07/owl#Class>]) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                 rdfs:subPropertyOf cdao:BFO_0000051.
cdao:IAO_0000584 cdao:IAO_0000112 "pmid:20604925 - time-lapse live cell microscopy"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A data set that is an aggregate of data recording some measurement at a number of time points. The time series data set is an ordered list of pairs of time measurement data and the corresponding measurement data acquired at that time."@en;
                 cdao:IAO_0000117 "Alan Ruttenberg"@en;
                 cdao:IAO_0000118 "experimental time series"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "time sampled measurement data set"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000582 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000100.
cdao:IAO_0000589 cdao:IAO_0000111 "OBO foundry unique label"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "An alternative name for a class or property which is unique across the OBO Foundry."@en;
                 cdao:IAO_0000116 "The intended usage of that property is as follow: OBO foundry unique labels are automatically generated based on regular expressions provided by each ontology, so that SO could specify unique label = 'sequence ' + [label], etc. , MA could specify 'mouse + [label]' etc. Upon importing terms, ontology developers can choose to use the 'OBO foundry unique label' for an imported term or not. The same applies to tools .";
                 cdao:IAO_0000117 "PERSON:Alan Ruttenberg"@en,
                                  "PERSON:Chris Mungall"@en,
                                  "PERSON:Melanie Courtot"@en,
                                  "PERSON:Bjoern Peters"@en;
                 cdao:IAO_0000119 "GROUP:OBO Foundry <http://obofoundry.org/>"@en;
                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:label "OBO foundry unique label"@en.
cdao:IAO_0000590 cdao:IAO_0000111 "written name"@en;
                 cdao:IAO_0000112 """\"United States of America\""""@en,
                                  """\"Bill Clinton\""""@en,
                                  """\"The Eiffel Tower\""""@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A textual entity that denotes a particular in reality."@en;
                 cdao:IAO_0000117 "PERSON: Bill Hogan"@en;
                 cdao:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/114"@en;
                 cdao:IAO_0000232 """The qualifier \"written\" is to set it apart from spoken names.  Also, note the restrictions to particulars.  We are not naming universals.   We could however, be naming, attributive collections which are particulars, so \"All people located in the boundaries of the city of Little Rock, AR on June 18, 2011 at 9:50a CDT\" would be a name."""@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "written name"@en;
                 rdfs:subClassOf cdao:IAO_0000300.
cdao:IAO_0000591 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A software method (also called subroutine, subprogram, procedure, method, function, or routine) is software designed to execute a specific task."@en;
                 cdao:IAO_0000117 "PERSON: Michel Dumontier"@en,
                                  "PERSON: Melanie Courtot"@en;
                 cdao:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "software method"@en;
                 rdfs:subClassOf cdao:IAO_0000010.
cdao:IAO_0000592 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 " A software module is software composed of a collection of software methods."@en;
                 cdao:IAO_0000117 "PERSON: Michel Dumontier"@en,
                                  "PERSON: Melanei Courtot"@en;
                 cdao:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en;
