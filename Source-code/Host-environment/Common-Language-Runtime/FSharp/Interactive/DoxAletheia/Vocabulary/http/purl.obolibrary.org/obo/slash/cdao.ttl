cdao:OBI_0600044 cdao:IAO_0000111 "lavage"@en;
                 cdao:IAO_0000112 "the collection of bronchoalveolar lavage fluid (BAL) from the lungs of mice in order to study the cytokines present"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A protocol application to separate cells and/or cellular secretions from an anatomical space by the introduction and removal of fluid"@en;
