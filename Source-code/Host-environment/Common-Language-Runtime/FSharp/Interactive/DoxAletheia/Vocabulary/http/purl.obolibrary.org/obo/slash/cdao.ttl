                 rdfs:label "obsolete2_digital document"@en;
                 rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass>;
                 <http://www.w3.org/2002/07/owl#deprecated> true.
cdao:IAO_0000109 cdao:IAO_0000111 "measurement datum"@en;
                 cdao:IAO_0000112 """Examples of measurement data are the recoding of the weight of a mouse as {40,mass,\"grams\"}, the recording of an observation of the behavior of the mouse {,process,\"agitated\"}, the recording of the expression level of a gene as measured through the process of microarray experiment {3.4,luminosity,}."""@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A measurement datum is an information content entity that is a recording of the output of a measurement such as produced by a device."@en;
                 cdao:IAO_0000116 "2/2/2009 is_specified_output of some assay?"@en;
                 cdao:IAO_0000117 "person:Chris Stoeckert"@en;
                 cdao:IAO_0000119 "group:OBI"@en,
                                  "OBI_0000305"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "measurement datum"@en;
                 rdfs:subClassOf cdao:IAO_0000027,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001933 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0001938 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
