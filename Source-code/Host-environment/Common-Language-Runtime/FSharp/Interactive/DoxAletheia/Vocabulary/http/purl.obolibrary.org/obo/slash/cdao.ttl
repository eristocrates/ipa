cdao:OBI_0001981 cdao:IAO_0000111 "disease exacerbation in vivo intervention experiment";
                 cdao:IAO_0000112 "Injecting a set of mice with a peptide and measuring symtoms to determine if their disease course was more severe than the disease course of a set of mice that were not injected with the same peptide.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An in vivo intervention experiment that tests the ability of the intervention to increase the severity of a disease in the host.";
                 cdao:IAO_0000116 "Should have data about disease severity as readout; could just use disease for now";
                 cdao:IAO_0000117 "IEDB";
                 cdao:IAO_0000119 "IEDB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "disease exacerbation in vivo intervention experiment";
                 rdfs:subClassOf cdao:OBI_0001980.
cdao:OBI_0001982 cdao:IAO_0000111 "protection from challenge in vivo intervention experiment";
                 cdao:IAO_0000112 "Injecting a set of mice with a peptide and measuring symtoms to determine if their disease course was less severe than the disease course of a set of mice that were not injected with the same peptide.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An in vivo intervention experiment that tests the ability of the intervention to prevent occurrence of a disease in a host.";
                 cdao:IAO_0000116 "should have challenge as intervention";
                 cdao:IAO_0000117 "IEDB";
                 cdao:IAO_0000119 "IEDB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "protection from challenge in vivo intervention experiment";
                 rdfs:subClassOf cdao:OBI_0001980.
cdao:OBI_0001983 cdao:IAO_0000111 "tolerance induction intervention experiment";
                 cdao:IAO_0000112 "Injecting a set of mice with a Der p 2 peptide and measuring the IL-2 response of T cells from those mice when exposed to the Der p 2 protein in vitro to determine if those T cells made less IL-2 than cells taken from mice which were not injected with the same Der p 2 peptide.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An in vivo intervention experiment that tests the ability of the intervention to decrease an immune response.";
                 cdao:IAO_0000116 "should have tolerance induction as intervention";
                 cdao:IAO_0000117 "IEDB";
                 cdao:IAO_0000119 "IEDB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "tolerance induction intervention experiment";
                 rdfs:subClassOf cdao:OBI_0001980.
cdao:OBI_0001984 cdao:IAO_0000111 "treatment intervention experiment";
                 cdao:IAO_0000112 "Testing if administering oral histamine-blockers will reduce the number of emergency room visits in severely asthmatic individuals.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An in vivo intervention experiment in which the ability of the intervention to reduce or cure the effects of a disease are tested.";
                 cdao:IAO_0000116 "should have treatment as intervention";
                 cdao:IAO_0000117 "IEDB";
                 cdao:IAO_0000119 "IEDB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "treatment intervention experiment";
                 rdfs:subClassOf cdao:OBI_0001980.
