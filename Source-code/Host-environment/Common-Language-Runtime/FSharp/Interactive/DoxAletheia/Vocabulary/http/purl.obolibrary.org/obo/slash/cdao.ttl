                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000136 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000300.
cdao:IAO_0000302 cdao:IAO_0000111 "author identification"@en;
                 cdao:IAO_0000112 "L. Hunter"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A textual entity intended to identify a particular author"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "author identification"@en;
                 rdfs:subClassOf cdao:IAO_0000590.
cdao:IAO_0000303 cdao:IAO_0000111 "institutional identification"@en;
                 cdao:IAO_0000112 "University of Colorado Denver School of Medicine"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
