cdao:OBI_0000997 cdao:IAO_0000111 "growth environment";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "The collection of material entities and their qualities that are located near a live organism, tissue or cell and can influence its growth.";
                 cdao:IAO_0000116 "Right now this may be incomplete. Should also cover e.g. sound, light as well.";
                 cdao:IAO_0000117 "PERSON:Richard Scheuermann, Jie Zheng, Bjoern Peters";
                 cdao:IAO_0000119 "OBI group";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "growth environment";
                 rdfs:subClassOf cdao:BFO_0000040.
cdao:OBI_0000998 cdao:IAO_0000111 "left handed";
