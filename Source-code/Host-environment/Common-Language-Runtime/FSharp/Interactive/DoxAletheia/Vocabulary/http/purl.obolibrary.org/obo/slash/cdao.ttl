cdao:OBI_0000823 cdao:IAO_0000111 "thrombin time assay";
                 cdao:IAO_0000112 "PMID:19696660#The thrombin time was determined using thromboclotin assay kit.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An assay that measures the time between the addition of the thrombin and the clot formation in plasma.";
