cdao:OBI_0000390 cdao:IAO_0000111 "thermostatic circulator"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A thermostatic circulator is a device which cools or heats a circulating liquid. It has the function to contain control the contained environment and transfer energy from or to the circulating liquid"@en;
                 cdao:IAO_0000117 "Frank Gibson";
                 cdao:IAO_0000119 "sep:00098";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "thermostatic circulator"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000370 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
