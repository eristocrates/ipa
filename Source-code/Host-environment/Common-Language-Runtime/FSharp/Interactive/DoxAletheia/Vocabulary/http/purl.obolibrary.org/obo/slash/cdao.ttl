                 cdao:IAO_0000112 """\"included hospital patients\""""@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An inclusion criterion defines that a human being has to be a hospital patient to be suitable for a given task or participation in a given process."@en;
