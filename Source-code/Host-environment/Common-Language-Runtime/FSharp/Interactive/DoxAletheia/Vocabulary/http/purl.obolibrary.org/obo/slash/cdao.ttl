cdao:OBI_0000698 cdao:IAO_0000111 "DNA ligase";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A DNA ligase is an enzyme that covalently joins two compatible pieces of DNA through the cleavage of an ATP molecule";
                 cdao:IAO_0000116 "5/22 Need to explore if there are GO / other classes exist that capture this. We need it now for cloning experiments",
                                  "replaced by imported PRO: DNA ligase";
                 cdao:IAO_0000117 "Kevin Clancy, Bjoern Peters";
                 cdao:IAO_0000118 "ligase";
                 cdao:IAO_0000231 cdao:IAO_0000228;
                 a <http://www.w3.org/2002/07/owl#Class>;
