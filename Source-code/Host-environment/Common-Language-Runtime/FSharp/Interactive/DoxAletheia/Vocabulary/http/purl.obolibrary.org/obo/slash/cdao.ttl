                 rdfs:subClassOf cdao:OBI_0000681.
cdao:OBI_0000797 cdao:IAO_0000111 "obsolete_primary structure of protein";
                 cdao:IAO_0000112 "SIINFEKL' is the primary structure of a peptide ";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "The primary structure of a protein that is completely defined by the set of its amino acid residue parts and the linear order induced by the peptide bonds that hold them together";
                 cdao:IAO_0000117 "Person:Bjoern Peters";
                 cdao:IAO_0000231 cdao:IAO_0000228;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "replaced by SO_0000104 polypeptide";
                 rdfs:label "obsolete_primary structure of protein";
                 rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass>;
                 <http://www.w3.org/2002/07/owl#deprecated> true.
cdao:OBI_0000798 cdao:IAO_0000111 "capsule shell";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a small rounded gelatinous container";
                 cdao:IAO_0000117 "Person:Alan Ruttenberg";
                 cdao:IAO_0000119 "http://www.golovchenko.org/cgi-bin/wnsearch?q=capsule#2n";
