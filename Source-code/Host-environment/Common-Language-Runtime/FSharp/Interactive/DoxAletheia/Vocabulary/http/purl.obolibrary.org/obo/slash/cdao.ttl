cdao:OBI_0001979 cdao:IAO_0000111 "fluorescence quenching binding assay";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A binding assay in which the proximity of two entities is monitored by measuring a fluorescent signal of one of the entities that gets reduced if the two entities are cliose to each other.";
                 cdao:IAO_0000117 "IEDB";
                 cdao:IAO_0000119 "IEDB";
                 a <http://www.w3.org/2002/07/owl#Class>;
