cdao:IAO_0000400 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A cartesian spatial coordinate datum is a representation of a point in a spatial region, in which equal changes in the magnitude of a coordinate value denote length qualities with the same magnitude"@en;
                 cdao:IAO_0000116 "2009-08-18 Alan Ruttenberg - question to BFO list about whether the BFO sense of the lower dimensional regions is that they are always part of actual space (the three dimensional sort) http://groups.google.com/group/bfo-discuss/browse_thread/thread/9d04e717e39fb617"@en;
                 cdao:IAO_0000117 "Alan Ruttenberg"@en;
                 cdao:IAO_0000232 "AR notes: We need to discuss whether it should include site.";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "cartesian spatial coordinate datum"@en;
                 rdfs:seeAlso "http://groups.google.com/group/bfo-discuss/browse_thread/thread/9d04e717e39fb617"@en;
                 rdfs:subClassOf cdao:IAO_0000027,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:BFO_0000018 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000219 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000407 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:IAO_0000401 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A cartesion spatial coordinate datum that  uses one value to specify a position along a one dimensional spatial region"@en;
                 cdao:IAO_0000117 "Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "one dimensional cartesian spatial coordinate datum"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000404 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:BFO_0000018
                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:BFO_0000026 ; 
