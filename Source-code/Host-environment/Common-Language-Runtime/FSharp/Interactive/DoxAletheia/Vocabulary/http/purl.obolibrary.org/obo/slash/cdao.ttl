cdao:OBI_0002081 cdao:IAO_0000111 "specimens collected longitudinally"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A collection of specimens that was derived from the same source material entity at different time points in order to observe changes in that entity."@en;
                 cdao:IAO_0000116 "Details see tracker: https://sourceforge.net/p/obi/obi-terms/778/";
                 cdao:IAO_0000117 "Person: Chris Stoeckert"@en;
                 cdao:IAO_0000119 "Bjoern Peters, OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "specimens collected longitudinally"@en;
                 rdfs:subClassOf cdao:OBI_0002076.
cdao:OBI_0002082 cdao:IAO_0000111 "reporter gene assay";
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "An assay that detects expression of a reporter gene that was inserted under the control of a regulatory sequence of interest.";
                 cdao:IAO_0000117 "Paul D. Thomas",
                                  "Chris Stoeckert";
                 cdao:IAO_0000118 "reporter gene detection assay";
                 cdao:IAO_0000119 "Paul D. Thomas, Yang Chai; FaceBase";
                 cdao:IAO_0000233 "https://github.com/obi-ontology/obi/issues/781";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "reporter gene assay";
                 rdfs:subClassOf cdao:OBI_0000070.
cdao:OBI_0002083 cdao:IAO_0000111 "enhancer activity detection by reporter gene assay";
                 cdao:IAO_0000112 """PMID 19268701: \"we experimentally concatenated up to four enhancers from different genes and used a transgenic mouse assay to compare the in vivo activity of these compound elements with that of the single modules\"""";
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A reporter gene assay that detects expression of a reporter gene that was inserted under the control of an enhancer of interest.";
                 cdao:IAO_0000117 "Yang Chai",
                                  "Paul D. Thomas";
                 cdao:IAO_0000118 "enhancer reporter gene assay";
                 cdao:IAO_0000119 "FaceBase",
                                  "PMID 24614317";
                 cdao:IAO_0000233 "https://github.com/obi-ontology/obi/issues/781";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "enhancer activity detection by reporter gene assay";
                 rdfs:subClassOf cdao:OBI_0002082.
cdao:OBI_0002084 cdao:IAO_0000111 "transcription cofactor activity region identification by ChIP-Seq assay";
                 cdao:IAO_0000112 """PMID 19212405: \"we present the results of chromatin immunoprecipitation with the enhancer-associated protein p300 followed by massively parallel sequencing, and map several thousand in vivo binding sites of p300 in mouse embryonic forebrain, midbrain and limb tissue\"""";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A ChIP-seq assay that identifies regions of chromatin bound to a chromatin modifying protein, e.g. a histone acetyltransferase.";
                 cdao:IAO_0000117 "Paul D. Thomas",
                                  "Yang Chai";
                 cdao:IAO_0000118 "chromatin modifier binding site identification by ChIP-Seq assay";
                 cdao:IAO_0000119 "PMID:19212405";
                 cdao:IAO_0000233 "https://github.com/obi-ontology/obi/issues/782";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "transcription cofactor activity region identification by ChIP-Seq assay";
                 rdfs:subClassOf cdao:OBI_0000716.
cdao:OBI_0002085 cdao:IAO_0000111 "transcript expression location detection by hybridization chain reaction assay";
                 cdao:IAO_0000112 """PMID 25977364: \"Multiplexed imaging of mRNA expression using fluorescent hybridization chain reaction (HCR) quantitatively confirmed the expression profiles of lead cells\"""";
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "An in situ hybridization assay in which the location (e.g. anatomical/tissue) of a transcript is detected by a multiplexed fluorescent in situ hybridization, based on orthogonal amplification with hybridization chain reactions (HCR). RNA probes complementary to mRNA targets trigger chain reactions in which fluorophore-labeled RNA hairpins self-assemble into tethered fluorescent amplification polymers.";
                 cdao:IAO_0000117 "Yang Chai",
                                  "Paul D. Thomas";
                 cdao:IAO_0000118 "transcript expression location detection by fluorescent HCR.";
                 cdao:IAO_0000119 "PMID:21037591";
                 cdao:IAO_0000233 "https://github.com/obi-ontology/obi/issues/783";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "transcript expression location detection by hybridization chain reaction assay";
                 rdfs:subClassOf cdao:OBI_0001686.
cdao:OBI_0002086 cdao:IAO_0000111 "Tet-assisted bisulfite sequencing assay";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A bisulfite sequencing assay that identifies genomic methylation patterns by using a bisulfite based protocol with the Tet enzyme to differentiate 5-hydroxylmethylcytosine (5hmC) from 5-methylcytosine (5mC) through a step-wise oxidative demethylation of 5mC, converting it to 5-carboxylcytosine (5caC) while keeping 5hmC protected.";
                 cdao:IAO_0000117 "Jason Hilton",
                                  "Chris Stoeckert",
                                  "Bjoern Peters",
                                  "OBI";
                 cdao:IAO_0000118 "TAB-seq",
                                  "Tet-assisted bisulfite sequencing";
                 cdao:IAO_0000119 "PMID:23196972";
                 cdao:IAO_0000233 "http://sourceforge.net/p/obi/obi-terms/789/";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Tet-assisted bisulfite sequencing assay";
                 rdfs:subClassOf cdao:OBI_0000748.
cdao:OBI_0002087 cdao:IAO_0000111 "containing a specimen function"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A contain function that involves physical contact with a specimen. This function is typically performed in such a way that the specimen is usable for an investigation or assay."@en;
                 cdao:IAO_0000116 "For details see tracker item: http://sourceforge.net/p/obi/obi-terms/792/"@en;
                 cdao:IAO_0000117 "Chris Stoeckert"@en;
                 cdao:IAO_0000119 "Duke Biobank, OBIB";
                 <http://purl.org/dc/elements/1.1/source> "Biobank"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "containing a specimen function"@en;
                 rdfs:subClassOf cdao:OBI_0000370.
cdao:OBI_0002088 cdao:IAO_0000111 "specimen container"@en;
                 cdao:IAO_0000112 "COPAN eSwab, CPT vacutainer, PAXgene Blood DNA tube"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A container with the function of containing a specimen."@en;
                 cdao:IAO_0000116 "For details see tracker item: http://sourceforge.net/p/obi/obi-terms/792/"@en;
                 cdao:IAO_0000117 "Chris Stoeckert"@en;
                 cdao:IAO_0000119 "Duke Biobank, OBIB"@en;
                 <http://purl.org/dc/elements/1.1/source> "Biobank"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Specimen containers are typically constructed or treated in a particular manner in order to perform their containing a specimen function. This will be a defined class so that any container (e.g., cryotube, vacutainer, conical test tube) with the function of containing a specimen will be inferred to be a specimen container."@en;
                 rdfs:label "specimen container"@en;
