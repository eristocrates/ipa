                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400142 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000057 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0600033.
cdao:OBI_0302914 cdao:IAO_0000111 "digital curation";
                 cdao:IAO_0000112 "PMID: 16901087. Supporting the curation of biological databases with reusable text mining.Genome Inform. 2005;16(2):32-44."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Digital curation is the process of establishing and developing long term repositories of digital assets for current and future reference by researchers, scientists, and historians, and scholars generally."@en;
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "wikipedia";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "digital curation"@en;
                 rdfs:subClassOf cdao:IAO_0000572.
cdao:OBI_0400005 cdao:IAO_0000111 "A10-Analyzer"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A A10 is a flow_cytometer_analyser manufactured by Apogee. It uses an arc lamp as a light source, with choices of 75W Xe, 75W Xe/Hg or 100W Hg arc lamps. It has filters and collectors for up to three fluorescent parameters and two scatter parameters. It uses analog electronics. The A10 can be used for measuring the properties of individual cells."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.apogeeflow.com/flow_cytometry_products.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "A10-Analyzer"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400006 cdao:IAO_0000111 "A40-MiniFCM"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A A40-MiniFCM is a flow_cytometer_analyser that allows for the choice of one of four lasers (375nm, 405nm,488nm, 532nm, 635nm), and PMTs and filters for collecting up to four parameters. It uses digital electronics. A military version of this cytometer is available as well. The A40-MiniFCM is geared towards the most demanding applications such as archaea, bacteria and large virus."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.apogeeflow.com/flow_cytometry_products.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "A40-MiniFCM"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400007 cdao:IAO_0000111 "analog-to-digital converter"@en;
                 cdao:IAO_0000112 "The analog to digital converter transformed the analog output from the photomultiplier tube to a digital signal for collection."@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An analog-to-digital_converter is an instrument that converts an infinite resolution analog signal to a finite resolution digital signal."@en;
                 cdao:IAO_0000117 "Melanie Courtot"@en,
                                  "John Quinn"@en;
                 cdao:IAO_0000118 "A2D"@en,
                                  "A-D"@en;
                 cdao:IAO_0000119 "http://en.wiktionary.org/wiki/Analog-to-Digital_Converter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "analog-to-digital converter"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000393 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000968.
cdao:OBI_0400008 cdao:IAO_0000111 "flow cytometer analyzer"@en;
                 cdao:IAO_0000112 "FACS Calibur, Luminex 100"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An analyser is a flow_cytometer that is used to measure properties of particles (whole cells, nuclei, chromosomes, diatoms, plankton, bacteria, viruses) by moving these particles through a detection chamber. An analyser is used to collect data for analysis."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.flocyte.com/FRTP/Resources/flow_cytometry_glossary.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "flow cytometer analyzer"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400082 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400065 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400043 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000453 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0400044,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400079 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400009 cdao:IAO_0000111 "arc lamp"@en;
                 cdao:IAO_0000112 "The Jablochkoff Candle"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Arc lamp is a light source that produces light by an electric arc (or voltaic arc). The lamp consists of two electrodes typically made of tungsten which are separated by a gas. The type of lamp is often named by the gas contained in the bulb; including neon, argon, xenon, krypton, sodium, metal halide, and mercury. The electric arc in an arc lamp consists of gas which is initially ionized by a voltage and is therefore electrically conductive. To start an arc lamp, usually a very high voltage is needed to ignite or strike the arc. This requires an electrical circuit sometimes called an igniter, which is part of a larger circuit called the ballast. The ballast supplies a suitable voltage and current to the lamp as its electrical characteristics change with temperature and time. Older cytometers may use arc lamps to irradiate particles at the interrogation point."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Arc_lamp"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "arc lamp"@en;
                 rdfs:subClassOf cdao:OBI_0400065.
cdao:OBI_0400010 cdao:IAO_0000111 "argon ion laser"@en;
                 cdao:IAO_0000112 "argon ion laser in a cytometer"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An argon-ion laser is an ion laser that uses argon ions as the lasing medium. These lasers are used primarily to emit light at wave lengths of 458 nm, 488 nm or 514.5 nm, though it is possible to use them to emit several wavelengths of blue and green light. Argon-ion lasers can emit light at many different wave lenghts, and excite a number of different flourochromes."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000119 "John Quinn"@en,
                                  "http://en.wikipedia.org/wiki/Laser#Gas_lasers";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "argon ion laser"@en;
                 rdfs:subClassOf cdao:OBI_0400060.
cdao:OBI_0400011 cdao:IAO_0000111 "avalanche photodiode"@en;
                 cdao:IAO_0000112 "C30644E -  InGaAs Avalanche Photodiode"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An avalanche photodiode is typically used to collect photons emitted by forward scatter because it is far less sensitive, and less likely o be burned out, than a PMT. A photodiode with high quantum efficiency and a mechanism for producing gains as high as a few thousand."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "avalanche photodiode"@en;
                 rdfs:subClassOf cdao:OBI_0400083.
cdao:OBI_0400012 cdao:IAO_0000111 "Bactiflow"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A Bactiflow is a flow_cytometer_analyser manufactured by Chemunex SA. It is a cell counter for bacteria and other micro organisms. Bacteria are stained with a fluorochrome and the number of particles that fluoresce are counted. The system uses digital electronics, a single laser and a single detector. An ALS version is available as well - Automatic Labeling System. The Bactiflow is specialized cytometer used exclusively for counting microbes."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.chemunex.com/products/chemframe.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Bactiflow"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400013 cdao:IAO_0000111 "band pass filter"@en;
                 cdao:IAO_0000112 "530/30 BP filter, 585/42 BP filter"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A band pass filter is an optical filter that passes wavelengths of light within a certain range and rejects (attenuates) frequencies outside that range. The passed wavelengths are indicated in the specifications of the filter and its name. A 480/20 band-pass filter pass light with at wavelengths of 460 to 500 nm and attenuates all others."@en;
                 cdao:IAO_0000117 "Person:John Quinn"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Band_pass_filter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "band pass filter"@en;
                 rdfs:subClassOf cdao:OBI_0400079.
cdao:OBI_0400014 cdao:IAO_0000111 "BioSorter1000"@en;
                 cdao:IAO_0000112 "BioSorter 1000 at TSRI Flow Cytometry Core Facility"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A BioSorter1000 is a flow_cytometer_sorter manufactured by Union Biometrica. It includes analog electronics, 488/514 nm multi-line Argon-ion laser for fluorescence and a light stabilized 670 nm forward scatter laser for extinction and time-of-flight. It has filters and PMTs for 3 fluorescent parameters and photodiodes for scatter, time of flight, and extinction. The flow cell is quartz cuvette. The BioSorterTM 1000 is an instrument for analyzing and sorting objects from 200-600 microns in diameter."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.unionbio.com/products/BioSorter.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "BioSorter1000"@en;
                 rdfs:subClassOf cdao:OBI_0400099.
cdao:OBI_0400015 cdao:IAO_0000111 "BioSorter2000"@en;
                 cdao:IAO_0000112 "BioSorter 2000 at TSRI Flow Cytometry Core Facility"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A BioSorter2000 is a sorter manufactured by Union Biometrica. It includes analog electronics, 488/514 nm multi-line Argon-ion laser for fluorescence and a light stabilized 670 nm forward scatter laser for extinction and time-of-flight. It has filters and PMTs for 3 fluorescent parameters and photodiodes for scatter, time of flight, and extinction. The flow cell is quartz cuvette. The BioSorterTM 2000 is an instrument for analyzing and sorting objects from 500 microns to 1.5 millimeters in diameter."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.unionbio.com/products/BioSorter.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "BioSorter2000"@en;
                 rdfs:subClassOf cdao:OBI_0400099.
cdao:OBI_0400016 cdao:IAO_0000111 "BioSorter250"@en;
                 cdao:IAO_0000112 "BioSorter 250 at TSRI Flow Cytometry Core Facility"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A BioSorter250 is a flow_cytometer_sorter manufactured by Union Biometrica. It includes analog electronics, 488/514 nm multi-line Argon-ion laser for fluorescence and a light stabilized 670 nm forward scatter laser for extinction and time-of-flight. It has filters and PMTs for 3 fluorescent parameters and photodiodes for scatter, time of flight, and extinction. The flow cell is quartz cuvette. The BioSorterTM 250 is an instrument for analyzing and sorting objects from 40-200 microns in diameter."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.unionbio.com/products/BioSorter.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "BioSorter250"@en;
                 rdfs:subClassOf cdao:OBI_0400099.
cdao:OBI_0400017 cdao:IAO_0000111 "BioSorter500"@en;
                 cdao:IAO_0000112 "BioSorter 500 at TSRI Flow Cytometry Core Facility"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A BioSorter500 is a flow_cytometer_sorter manufactured by Union Biometrica. It includes analog electronics, 488/514 nm multi-line Argon-ion laser for fluorescence and a light stabilized 670 nm forward scatter laser for extinction and time-of-flight. It has filters and PMTs for 3 fluorescent parameters and photodiodes for scatter, time of flight, and extinction. The flow cell is quartz cuvette. The BioSorterTM 500 is an instrument for analyzing and sorting objects from 100-250 microns in diameter and less than 2mm in length."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.unionbio.com/products/BioSorter.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "BioSorter500"@en;
                 rdfs:subClassOf cdao:OBI_0400099.
cdao:OBI_0400018 cdao:IAO_0000111 "Cell Lab Quanta SC"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A Cell Lab Quanta SC is a flow_cytometer_analyser manufactured by Becman Coulter. It features a mercury arc lamp optimized at 366, 405, and 435 nm, and a 488 nm laser diode. It has filters and PMTs to collect up to 3 fluorescent parameters, and a photodiode for side scatter detection. This cytometer uses Couter-Volume for cell size measurements. The Cell Lab Quanta SC can be used for measuring the properties of individual cells."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.beckmancoulter.com/cell-lab"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Cell Lab Quanta SC"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400019 cdao:IAO_0000111 "charge plate"@en;
                 cdao:IAO_0000112 "LSR2 charge plate"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Part of the fluidics subsystem. Charge plates are used or sorters. They create an charged electric field when particles deemed to be desired for further analysis are shaken form the piexo electric crystal. The charged particles are drawn toward the charged plate, and the altered drop location causes the particles to fall into a collection tube. Charge plates enable sorting."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "charge plate"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000383 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000374 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000968.
cdao:OBI_0400020 cdao:IAO_0000111 "cell sorter collection tube"@en;
                 cdao:IAO_0000112 "LSR2 collection tube"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Part of the fluidics subsystem. The collection tube is a vessel for capturing cells of interest that have been identified by a sorter. The collection tube is the end location of sorted cells."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "cell sorter collection tube"@en;
                 rdfs:subClassOf cdao:OBI_0000836.
cdao:OBI_0400022 cdao:IAO_0000111 "Cyan"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A Cyan is a flow_cytometer_analyser manufactured by Dako Cytomation. It features include digital electronics, three lasers: 488 nm, 635 nm, and 405 nm, and filters and collectors for nine fluorescent parameters and two scatter parameters. The Cyan can be used for measuring the properties of individual cells."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.dakousa.com/prod_productrelatedinformation?url=gprod_cyan_index.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Cyan"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400023 cdao:IAO_0000111 "CYFlow ML"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A CyFlow_ML is a flow_cytometer_analyser manufactured by Partec. It is a digital machine which uses 4 light sources: triple laser configurations including new powerful 200mW@488nm blue solid state laser + 100W UV lamp for highest resolution DNA analysis, and can collect 16 optical parameters: FSC1, FSC2, SSC, FL1-FL13. Ultracompact high end desktop multilaser Flow Cytometer for all applications in cell analysis and absolute counting."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.partec.de/products/cyflow-ml.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "CYFlow ML"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400024 cdao:IAO_0000111 "CyFlow SL"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "a flow_cytometer_analyser manufactured by Partec. Its specs are: ultracompact and fully equipped mobile/portable instrument, dimensions [cm]: L 43 x H 16 x D 37, highest stability/robustness and highest precision, 5 optical parameters: FSC, SSC, FL-1, FL-2, FL-3, 20mW@488nm blue solid state laser , other laser light sources optional (UV, violet, green, red), WindowsTM XP FloMax (software for real time data acquisition, data display, and data evaluation), parallel 16 bit digital pulse processing Compact mobile Flow Cytometer for any kind of cell analysis and absolute volumetric counting. The CyFlow_SL allows to analyze forward and side scatter signals in combination with up to 3 fluorescence channels."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.partec.de/products/cyflow.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "CyFlow SL"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400025 cdao:IAO_0000111 "CyFlow SL3"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A CyFlow_Sl3 is a flow_cytometer_analyser manufactured by Partec. Its specs are: ultracompact and fully equipped mobile/portable instrument, dimensions [cm]: L 43 x H 16 x D 37 , highest stability/robustness and highest precision, 5 optical parameters: FSC, SSC, FL-1, FL-2, FL-3, 20mW@488nm blue solid state laser, other laser light sources optional (UV, violet, green, red), WindowsTM XP FloMax (software for real time data acquisition, data display, and data evaluation), parallel 16 bit digital pulse processing. The CyFlow SL3 is a compact and dedicated portable Flow Cytometer for accurate and affordable cell analysis and true volumetric absolute counting in HIV Monitoring and AIDS patient follow-up by precise and direct CD4 and CD4% measurement."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.partec.de/products/cyflowsl3.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "CyFlow SL3"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400026 cdao:IAO_0000111 "CyFlow Space"@en;
                 cdao:IAO_0000112 "CyFlow Space at TSRI Flow Cytometry Core Facility"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A CyFlow_Space is a flow_cytometer_sorter manufactured by Partec. Its specs are: 8optical parameters, 6 colours:FSC, SSC, FL1-FL6 , 3laser light sources: 200mW@488nm blue solid state laser 25mW@635nm red diode laser 50mW@405nm violet or 8mW@375nm ultraviolet diode laser _ultracompact desktop high end instrument. Parallel 16bit digital pulse processing. The CyFlow Space is a 6-Colour FCM System and Cell Sorter for Clinical Routine and Research."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.partec.de/products/cyflowspace.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "CyFlow Space"@en;
                 rdfs:subClassOf cdao:OBI_0400099.
cdao:OBI_0400027 cdao:IAO_0000111 "CytoBuoy"@en;
                 cdao:IAO_0000112 "CytoBuoy can be used to conduct extended and/or high frequency time series of phytoplankton distribution and abundance on fixed locations"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A flow cytometer analyser which is manufactured by Cyto Buoy Inc. They are the buoy mounted version of the CytoSense, equipped with wireless transmission of control and data files. They are a single laser, multi parameter instrument. Various types of micro-laser are offered; available measuring parameters are forward light scatter, side scatter, and fluorescence (max. 9 colour bands). The current series have 5 parameters."@en;
                 cdao:IAO_0000117 "John Quinn, Melanie Courtot"@en;
                 cdao:IAO_0000119 "http://www.cytobuoy.com/"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "CytoBuoy flow cytometer analyzer"@en;
                 rdfs:subClassOf cdao:OBI_0400008,
                                 [<http://www.w3.org/2002/07/owl#hasValue> cdao:OBI_0001458 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000304 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400028 cdao:IAO_0000111 "CytoSence"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A CytoSense is a flow_cytometer_analyser manufactured by Cyto Buoy Inc. They are a single laser, multi parameter instrument. Various types of micro-laser are offered; available measuring parameters are forward light scatter, side scatter, and fluorescence (max. 9 colour bands). The current series have 5 parameters. The CytoSense is the basic instrument, which can be used for normal laboratory applications, as well as for autonomous monitoring with internal data logging or direct data transmission. The special instrument design and its splashproof housing allow operation on moving platforms and outdoor sites."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.cytobuoy.com/"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "CytoSence"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400029 cdao:IAO_0000111 "CytoSub"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A CytoSub is a flow_cytometer_analyser manufactured by Cyto Buoy Inc. They are a single laser, multi parameter instrument. Various types of micro-laser are offered; available measuring parameters are forward light scatter, side scatter, and fluorescence (max. 9 colour bands). The current series have 5 parameters. The CytoSub is the submersible version equipped with a high pressure sample inlet loop and a high pressure housing to allow underwater operation down to 200 m, lowered on a cable or mounted on a flooded underwater vehicle."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.cytobuoy.com/"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "CytoSub"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400030 cdao:IAO_0000111 "dichroic filter"@en;
                 cdao:IAO_0000112 "Cy3 Dichroic Filter"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A dichroic filter is an optical filter which is used to selectively pass light of a small range of colors while reflecting other colors. A dichroic filter passes the specified range of light whereas a dichroic mirror reflects the specified range of light."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Dichroic_filter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "dichroic filter"@en;
                 rdfs:subClassOf cdao:OBI_0400079.
cdao:OBI_0400031 cdao:IAO_0000111 "dichroic mirror"@en;
                 cdao:IAO_0000112 "ViewLux Alexa 594 dichroic mirror"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A dichroic mirror is an optical filter which is used to selectively reflect light of a small range of colors while passing other colors. A dichroic filter passes the specified range of light whereas a dichroic mirror reflects the specified range of light."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Dichroic_mirror"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "dichroic mirror"@en;
                 rdfs:subClassOf cdao:OBI_0400079.
cdao:OBI_0400032 cdao:IAO_0000111 "differential pressure gauge"@en;
                 cdao:IAO_0000112 "LSR2 differential pressure gauge"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Part of the fluidics subsystem. The differential pressure gauge monitors the difference between sample and sheath fluid pressures in systems where pressure is used to force the sample fluid to flow in the center of the sheath fluid. A differential pressure gauge can be used by the operator to make sure that the sample fluid is at a greater pressure than the sheath fluid, which maintains a core of sample fluid."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "differential pressure gauge"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000453 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000832.
cdao:OBI_0400033 cdao:IAO_0000111 "diode laser"@en;
                 cdao:IAO_0000112 "FAX-RS3-H0 diode laser manufactured by Diode Laser Concepts, Inc."@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A diode laser is a laser in which the active medium is a p-n junction semiconductor laser diode, similar to that found in a light-emitting diode. Laser diodes emit at wavelengths from 375 nm to 1800 nm, and wavelengths of over 3 micrometer have been demonstrated. A diode laser can by used to irradiate cells in a flow cytometer."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000119 "John Quinn"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "diode laser"@en;
                 rdfs:subClassOf cdao:OBI_0400064.
cdao:OBI_0400034 cdao:IAO_0000111 "dye laser"@en;
                 cdao:IAO_0000112 "Rhodamine 101 dye laser used to irradiate cells in a flow cytometer."@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A dye laser is a laser in which the lasing medium is a fluorescent dye, usually dissolved in an organic solvent such as ethanol or ethylene glycol. The particular dye used determines the wavelengths the laser can emit. The laser medium is places between two parallel mirrors for light emission amplification."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en,
                                  "John Quinn"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "dye laser"@en;
                 rdfs:subClassOf cdao:OBI_0400064.
cdao:OBI_0400036 cdao:IAO_0000111 "FACS Calibur"@en;
                 cdao:IAO_0000112 """\"FACS Calibur at TFL, BCCRC, Vancouver\""""@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "The FACS Calibur is one of the most popular cytometers in use for research."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 """\"http://www.bdbiosciences.com/immunocytometry_systems/products/display_product.php?keyID=45, 2007-05-11\""""@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "FACS Calibur"@en;
                 rdfs:subClassOf cdao:OBI_0400099.
cdao:OBI_0400037 cdao:IAO_0000111 "FACS Canto"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A FACS_Canto is a flow_cytometer_analyser manufactured by Becton Dickinson. It features digital electronics, a solid state 488 nm, and a HeNe 633 nm lasers, and filters and PMTs for collecting up to 6 fluorescent parameters. The FACS_Canto is an analyser usually used in clinical applications."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.bdbiosciences.com/pdfs/brochures/23-8742-00.pdf"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "FACS Canto"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400038 cdao:IAO_0000111 "FACS Canto2"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A FACS_Canto2 is a flow_cytometer_analyser manufactured by BD. It features digital electronics, two solid state lasers at 488 and 633 nm with the option for a third 405 nm laser, and filters and collectors for measuring up to 8 fluorescent paramters with either the 2 or 3 laser option. The FACS_Canto2 is an analyser usually used in clinical applications."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.bdbiosciences.com/cgi-bin/literature/view?part_num=23-8786-01"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "FACS Canto2"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400039 cdao:IAO_0000111 "FACS Scan"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A FACS_Scan is a flow_cytometer_analyser manufactured by Becton Dickinson. IT features analog electronics, one 488 nm solid state laser, and the filters and PMTs to collect up to three fluorescent parameters The FACS_Scan is usually used for research applications."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.brc.ubc.ca/brc/facs.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "FACS Scan"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400040 cdao:IAO_0000111 "FACSAria"@en;
                 cdao:IAO_0000112 "FACSAria at TSRI Flow Cytometry Core Facility"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A FASCSAria is a flow_cytometer_sorter manufactured by Becton Dickinson. It features digital electronics, a solid state 488 nm blue laser, a solid state 407 nm violet laser, and a HeNe (633 nm) ion laser. The Aria has the filters and PMTs to collect side scatter and 9 fluorescent parameters. The Aria has a photodiode detector for forward scatter collector. The flow cell is Quartz cuvette. The FACSAria is a sorter used to collect and analyse cells using up to 11 parameters."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.bdbiosciences.com/external_files/is/doc/mkt_lit/brochures/SJ-0003-00Aria.pdf"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "FACSAria"@en;
                 rdfs:subClassOf cdao:OBI_0400099.
cdao:OBI_0400041 cdao:IAO_0000111 "FACSvantage"@en;
                 cdao:IAO_0000112 "FACSvantage at TSRI Flow Cytometry Core Facility"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "The FACSvantage is a flow_cytometer_sorter manufactured by Becton Dickinson. It has analog electronics, three lasers (several options are available), and the filters and PMTs to collect 6 fluorescent parameters and side scatter, and a photodiode to collect forward scatter. The FACSvantage can be used to analyse, sort and collect cells."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.bdbiosciences.com/features/products/display_product.php?keyID=42"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "FACSvantage"@en;
                 rdfs:subClassOf cdao:OBI_0400099.
cdao:OBI_0400042 cdao:IAO_0000111 "FC 500"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A FC_500 is a flow_cytometer_analyser manufactured by Beckman Coulter. It features digital electronics, 488 nm and 635 nm lasers, filters and PMTs for 5 fluorescent parameters, a diode for collecting side scatter and a solid state detector for forward scatter. The FC 500 is an analyser usually used for either research or clinical applications."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.beckmancoulter.com/products/instrument/flowcytometry/fc500series.asp"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "FC 500"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400043 cdao:IAO_0000111 "flow cell";
                 cdao:IAO_0000112 "Biofilm Flow Cell"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Aparatus in the fluidic subsystem where the sheath and sample meet. Can be one of several types; jet-in-air, quartz cuvette, or a hybrid of the two. The sample flows through the center of a fluid column of sheath fluid in the flow cell."@en;
                 cdao:IAO_0000117 "Person:John Quinn"@en;
                 cdao:IAO_0000118 "flow_cell";
                 cdao:IAO_0000119 "http://www.flocyte.com/FRTP/Resources/flow_cytometry_glossary.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "flow cell"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000370 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000967.
cdao:OBI_0400044 cdao:IAO_0000111 "flow cytometer"@en;
                 cdao:IAO_0000112 "FACS Calibur"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A flow_cytometer is an instrument for counting, examining and sorting microscopic particles in suspension. It allows simultaneous multiparametric analysis of the physical and/or chemical characteristics of single cells flowing through an optical and/or electronic detection apparatus. A flow cytometer is an instrument that can be used to quantitatively measure the properties of individual cells in a flowing medium."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Flow_cytometer"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "flow cytometer"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400078 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400153 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400043 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400065 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400079 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400082 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 cdao:OBI_0400137.
cdao:OBI_0400045 cdao:IAO_0000111 "fluid pressure regulator"@en;
                 cdao:IAO_0000112 "LSR2 fluid pressure regulator"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Part of the fluidic subsystem. The fluid pressure regulator maintains constant pressure within the sheath and or sample lines by filling the lines with enough gas to push the fluid at the desired rate. The gas is usually air, and less frequently nitrogen. In the sheath line, the gas is pushed into the sheath tank. In the sample line the gas is pushed into the collection tube. Fluid pressure regulators maintain great enough pressure to push sample fluid out of the tube and sheath fluid out of the sheath tank."@en;
                 cdao:IAO_0000117 "Person: John Quinn"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "fluid pressure regulator"@en;
                 rdfs:subClassOf cdao:OBI_0002089,
                                 cdao:OBI_0000832,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000401 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000453 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400047 cdao:IAO_0000111 "gas laser";
                 cdao:IAO_0000112 "helium-neon gas laser used to erradiate cells in a flow cytometer."@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A gas laser is a laser in which the lasing medium is a gas. The laser medium is places between two parallel mirrors for light emission amplification. The gas is excited to emit light via an external light source or an electric current discharging through the gas."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Gas_laser",
                                  "John Quinn"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "gas laser"@en;
                 rdfs:subClassOf cdao:OBI_0400064.
cdao:OBI_0400048 cdao:IAO_0000111 "Guava EasyCyte Mini"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A Guava_EasyCyte_Mini is a flow_cytometer_analyser that includes a single 488 nm laser, and filters and PMTs to collect up to 3 fluorescent parameters. It includes a photodiode forward scatter collector and an optional photodiode for side scatter collection.Guava cytometers use aspiration instead of fluid systems to transport cells within the machine. The mini accepts tubes only for inputting cells or beads. The Guava_EasyCyte_Mini cytometer is a small portable cytometer particularly useful for field measurement."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.guavatechnologies.com/main/products/easyCyteMini.cfm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Guava EasyCyte Mini"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400049 cdao:IAO_0000111 "Guava EasyCyte Plus"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A Guava_EasyCyte_Plus System is a flow_cytometer_analyser that includes a single 488 nm laser, and filters and PMTs to collect up to 4 fluorescent parameters. It includes a photodiode forward scatter collector and an optional photodiode for side scatter collection.Guava cytometers use aspiration instead of fluid systems to transport cells within the machine. The EasyCyte plus accepts 96 well plates as well as tubes. The Guava_EasyCyte_Plus cytometer is a small portable cytometer particularly useful for field measurement."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.guavatechnologies.com/main/products/easycyte-new.cfm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Guava EasyCyte Plus"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400050 cdao:IAO_0000111 "Guava Personal Cell Analysis"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A  Guava_Personal_Cell_Analysis System is a flow_cytometer_analyser that includes a single 532 nm laser, and filters and PMTs to collect up to 2 fluorescent parameters. It includes a photodiode forward scatter collector. Guava cytometers use aspiration instead of fluid systems to transport cells within the machine. The PCA96 uses only tubes to introduce specimen. The Guava PCA cytometer is a small portable cytometer particularly useful for field measurement."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000118 "Guava_PCA"@en;
                 cdao:IAO_0000119 "http://www.guavatechnologies.com/main/products/PCA-new.cfm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Guava Personal Cell Analysis"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400051 cdao:IAO_0000111 "Guava Personal Cell Analysis-96"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "The Guava_Personal_Cell_Analysis-96 Systems is a flow_cytometer_analyser that includes a single 532 nm laser, and filters and PMTs to collect up to 2 fluorescent parameters. It includes a photodiode forward scatter collector. Guava cytometers use aspiration instead of fluid systems to transport cells within the machine. The PCA96 uses either tubes or 96 well plates to introduce specimen. The Guava PCA -96 cytometer is a small portable cytometer particularly useful for field measurement."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000118 "Guava_PCA-96"@en;
                 cdao:IAO_0000119 "http://www.guavatechnologies.com/main/products/PCA-96new.cfm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Guava Personal Cell Analysis-96"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400052 cdao:IAO_0000111 "helium cadmium ion laser"@en;
                 cdao:IAO_0000112 "KIMMON HeCd 325nm laser"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A helium-cadmium laser is a metal vapor laser that emits wavelengths of 442, 325 and 354 nms. This laser is a metal vapor laser. A helium-cadmium laser can by used to irradiate cells in a flow cytometer."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Laser#Gas_lasers"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "helium cadmium ion laser"@en;
                 rdfs:subClassOf cdao:OBI_0400073.
cdao:OBI_0400053 cdao:IAO_0000111 "helium neon ion laser"@en;
                 cdao:IAO_0000112 "A helium neon laser can by used to irradiate cells in a flow cytometer."@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A helium-neon laser (HeNe) is an ion laser that uses helium and neon gas-ions as lasing medium. HeNe lasers emit at 543 nm and 633 nm most commonly and can also be used at 543, 594, and 611 nm."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Laser#Gas_lasers",
                                  "John Quinn"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "helium neon ion laser"@en;
                 rdfs:subClassOf cdao:OBI_0400060.
cdao:OBI_0400054 cdao:IAO_0000111 "Amnis ImageStream"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 """The ImageStream is a multispectral_imaging_flow_cytometer manufactured by Amnis. Its has digital electronics, a single standard 488 nm solid state laser. In addition an optional 658 nm and your choice of either a 405 nm or 375 nm solid state laser can be added. Information is collected using cameras. The ImageStream system CCD camera produces six images of each cell, including darkfield, brightfield, and up to four fluorescent colors. Each image is used to calculate over 40 features, so a six-image assay results in ~250 morphometric and photometric features per cell. The ImageStream is a flow cytometer that takes pictures of the cells in flow.
It has both components, an Image cytometer and a flow cytometer."""@en;
                 cdao:IAO_0000116 "It has both components, an Image cytometer and a flow cytometer."@en;
                 cdao:IAO_0000117 "Melanie Courtot"@en,
                                  "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.amnis.com/"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Amnis ImageStream"@en;
                 rdfs:subClassOf cdao:OBI_0400146,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400044 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400135 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400055 cdao:IAO_0000111 "inFlux Analyzer"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "The inFlux Analyzer is a flow_cytometer_analyser manufactured by Cytopeia. It is a digital machine, with these laser options: Coherent 70, 90, 300 series water cooled lasers, solid state UV 355nm, Violet 408nm, Violet-Blue 479nm, Blue-488nm, Green-531nm, Red-635nm, Red-647nm. Filters and PMTs are used for all parameters (including forward light scatter), and up to 12 PMTs can be included. The Influx analyser can be used to measure the properties of individual cells."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.cytopeia.com/analyzer.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "inFlux Analyzer"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400056 cdao:IAO_0000111 "Influx Cell Sorter"@en;
                 cdao:IAO_0000112 "Influx Cell Sorter at TSRI Flow Cytometry Core Facility"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A Influx Cell Sorter is a flow_cytometer_sorter manufactured by Cytopeia. It is a digital machine, with these laser options: Coherent 70, 90, 300 series water cooled lasers, solid state UV 355nm, Violet 408nm, Violet-Blue 479nm, Blue-488nm, Green-531nm, Red-635nm, Red-647nm. The sorting is multi-way, index, and proportional sorting. Filters and PMTs are used for all parameters (including forward light scatter), and up to 12 PMTs can be included. The Influx cell sorter can be used to measure, sort, and collect ndividual cells."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.cytopeia.com/sorter.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Influx Cell Sorter"@en;
                 rdfs:subClassOf cdao:OBI_0400099.
cdao:OBI_0400059 cdao:IAO_0000111 "interrogation_point"@en;
                 cdao:IAO_0000112 "Interrogation point in BD FACS Calibur"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Point within the fluidic subsystem at which the laser intersects the stream, illuminating the cells where they emit their fluorescence and scatter the light. The laser irradiates the cell at the interrogation point."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.flocyte.com/FRTP/Resources/flow_cytometry_glossary.htm, 2007-05-11"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "interrogation_point"@en;
                 rdfs:subClassOf cdao:BFO_0000029.
cdao:OBI_0400060 cdao:IAO_0000111 "ion laser"@en;
                 cdao:IAO_0000112 "2 Watt Lexel 88 Argon Ion laser"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An ion laser is a gas laser which uses an ionized gas as its lasing medium."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Ion_laser",
                                  "John Quinn"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "ion laser"@en;
                 rdfs:subClassOf cdao:OBI_0400047.
cdao:OBI_0400061 cdao:IAO_0000111 "jet_in_air_flow_chamber"@en;
                 cdao:IAO_0000112 "Jet-in-air flow chamber in DakoCytomation MoFlo high-speed cell sorter"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A flow cell in which the cells are pinched off as droplets and allowed to drop through the air. The laser intersects with the cell in mid-air. A jet in air flow chamber allows the laser to intersect with the cells without any intermittent media other than air."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.flocyte.com/FRTP/Resources/flow_cytometry_glossary.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "jet_in_air_flow_chamber"@en;
                 rdfs:subClassOf cdao:BFO_0000029.
cdao:OBI_0400062 cdao:IAO_0000111 "krypton ion laser"@en;
                 cdao:IAO_0000112 "Lexel 95L krypton laser"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A krypton-ion laser is an ion laser that uses krypton as the lasing medium. These lasers can emit at 468, 476, 482, 520, 531, 568, 647 (the most powerful line), and 676 nm all at once. They have much lower gain than argon lasers however."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000119 "John Quinn"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "krypton ion laser"@en;
                 rdfs:subClassOf cdao:OBI_0400060.
cdao:OBI_0400063 cdao:IAO_0000111 "LactoScope C4"@en;
                 cdao:IAO_0000112 "LactoScope C4 Automatic Economical"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A LactoScope_C4 is a spectrophotometer with which the composition of milk and milk products is analysed via infrared technology. The LactoScope determines the amount of the constituents fat, protein, lactose and the total solids content with extreme accuracy."@en;
                 cdao:IAO_0000117 "Melanie Courtot"@en,
                                  "Josef Spidlen"@en;
                 cdao:IAO_0000119 "http://www.aicompanies.com/DeltaCD/lacto_ftir_auto.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "LactoScope C4"@en;
                 rdfs:subClassOf cdao:OBI_0400115.
cdao:OBI_0400064 cdao:IAO_0000111 "laser"@en;
                 cdao:IAO_0000112 "A laser is the most common way to irradiate a cell in a flow cytometer."@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A laser (acronym for light amplification by the stimulated emission of radiation) is a light source that emits photons of the same characteristics in a coherent beam. A laser uses a solid, liquid or gaseous lasing medium, that contains molecules, of which some atoms have electrons that emit photons of the same frequency when falling back to their normal orbital after excitation (pumping) by external means A laser is the most common way to irradiate a cell in a flow cytometer."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000118 "light amplification by the stimulated emission of radiation"@en;
                 cdao:IAO_0000119 "John Quinn"@en,
                                  "http://en.wikipedia.org/wiki/Laser";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "laser"@en;
                 rdfs:subClassOf cdao:OBI_0400065.
cdao:OBI_0400065 cdao:IAO_0000111 "light source"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A light source is an optical subsystem that provides light for use in a distant area using a delivery system (e.g., fiber optics). Light sources may include one of a variety of lamps (e.g., xenon, halogen, mercury). Most light sources are operated from line power, but some may be powered from batteries. They are mostly used in endoscopic, microscopic, and other examination and/or in surgical procedures. The light source is part of the optical subsystem. In a flow cytometer the light source directs high intensity light at particles at the interrogation point. The light source in a flow cytometer is usually a laser."@en;
                 cdao:IAO_0000117 "Elizabeth M. Goralczyk"@en,
                                  "John Quinn"@en,
                                  "Olga Tchuvatkina"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "light source"@en;
                 rdfs:subClassOf cdao:OBI_0001032,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000367 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400066 cdao:IAO_0000111 "logarithmic voltage amplifier"@en;
                 cdao:IAO_0000112 "HLVA-100 logarithmic voltage amplifier developed by FEMTO Messtechnik, GmbH"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A logarithmic voltage amplifier is an analog electronic circuit that puts out a voltage or current proportional to the voltage or current at its input, with logarithmic proportionality. In an analog system, the logarithmic voltage amplifier is used to present parameters with a high dynamic range on a more useful scale."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "logarithmic voltage amplifier"@en;
                 rdfs:subClassOf cdao:OBI_0400101.
cdao:OBI_0400067 cdao:IAO_0000111 "long pass filter"@en;
                 cdao:IAO_0000112 "750 LP filter"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A long pass filter is an optical filter that passes high wavelengths of light but attenuates (or reduces) wavelengths lower than the cutoff frequency. A long pass filter with a cutoff of 500 nm would pass all wavelengths greater than 500 nm."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/high-pass_filter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "long pass filter"@en;
                 rdfs:subClassOf cdao:OBI_0400079.
cdao:OBI_0400068 cdao:IAO_0000111 "LSR2"@en;
                 cdao:IAO_0000112 "LSR2 at TSRI Flow Cytometry Core Facility"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A LSR2 is a sorter manufactured by Becton Dickinson. It features digital electronics, a solid state 488 nm blue laser and optionally can also have any combination of solid state UV (355 nm) and violet (405 nm) lasers and the a HeNe (633 nm) ion laser. The LSR2 has the filters and PMTs to work with 13 fluorescent parameters. The LSR II is one of the most common sorters in use."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.bdbiosciences.com/external_files/is/doc/mkt_lit/brochures/live/web_enabled/SJ-0142-00LSR2.pdf"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "LSR2"@en;
                 rdfs:subClassOf cdao:OBI_0400099.
cdao:OBI_0400069 cdao:IAO_0000111 "Luminex 100"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "The Luminex 100 is a flow_cytometer_analyser manufactured by Luminex. It is a single laser system (575 nm) with avalanche photodiodes in red and infrared and a single PMT for fluorescence. The flow chamber is a square quartz cuvette."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.luminexcorp.com/products/luminex_100IS.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Luminex 100"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400070 cdao:IAO_0000111 "Luminex 200"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A Luminex_200 is a flow_cytometer_analyser manufactured by Luminex. The optical specifications are: Reporter laser: 532 nm, nominal output 10 - 15 mW, maximum 500 mW, frequency-doubled diode; mode of operation, continuous wave (CW). Classification laser: 635 nm, 9.1 __ 6%, maximum output 25 mW, diode; mode of operation, continuous wave (CW) Reporter detector: Photomultiplier tube, detection bandwidth of 565 - 585 nm Classification detector and doublet discriminator: Avalanche photo diodes with temperature compensation"@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.luminexcorp.com/support/faqs.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Luminex 200"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400071 cdao:IAO_0000111 "MACS Quant"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A MACS Quant is a flow_cytometer_analyser manufactured by Miltenyi. It uses digital electronics, and has three lasers of wavelengths 405 nm, 488 nm, and 635 nm. It has filters and detectors to collect 7 fluorescent parameters and 2 scatter parameters. The MACS Quant is an analyser usually used in research applications."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.miltenyi.com"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "MACS Quant"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400073 cdao:IAO_0000111 "metal vapor laser"@en;
                 cdao:IAO_0000112 "Gold vapor laser, Helium-cadmium metal-vapor laser"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A metal vapor laser is a gas laser in which the lasing medium is metal vapor. A metal vapor laser can by used to irradiate cells in a flow cytometer."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "metal vapor laser"@en;
                 rdfs:subClassOf cdao:OBI_0400047.
cdao:OBI_0400074 cdao:IAO_0000111 "mixed argon-krypton gas laser"@en;
                 cdao:IAO_0000112 "argon-krypton laser in a cytometer"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A mixed argon krypton gas laser is an ion laser in which the lasing medium is a mixture of argon and krypton. A mixed argon-krypton laser can by used to irradiate cells in a flow cytometer."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.eio.com/repairfaq/sam/laserarg.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "mixed argon-krypton gas laser"@en;
                 rdfs:subClassOf cdao:OBI_0400060.
cdao:OBI_0400075 cdao:IAO_0000111 "MoFlo"@en;
                 cdao:IAO_0000112 "MoFlo at TSRI Flow Cytometry Core Facility"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A MoFlo is a flow_cytometer_sorter manufactured by Dako Cytomation. It features digital electronics, the option to include several lasers (solid state 488 nm, 635 nm, and a 351 nm diode laser), and has the filtering and collection capacity for up to 10 flouresecent parameters. The MoFlo is an instrument that can be used to both analyze quantitatively and collect cells in a flowing medium."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.dakousa.com/index/prod_search/prod_groups.htm?productareaid=16"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "MoFlo"@en;
                 rdfs:subClassOf cdao:OBI_0400099.
cdao:OBI_0400076 cdao:IAO_0000111 "multi-well plate"@en;
                 cdao:IAO_0000112 "96 well plate, 48 multiwell plate"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A particle deliver vessel. A multi-well plate is a vessel that can deliver multiple samples to a flow cytometer in a specified order. It must be used with a plate loader."@en;
                 cdao:IAO_0000116 "FG this is synonymous with microtiter plate"@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.nuncbrand.com/page.aspx?ID=301"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "multi-well plate"@en;
                 rdfs:subClassOf cdao:OBI_0400081.
cdao:OBI_0400077 cdao:IAO_0000111 "neodymium-YAG laser"@en;
                 cdao:IAO_0000112 "Neodymium-YAG Laser in DURIP99 System"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A Neodymium-YAG (yttrium aluminum garnet) laser is a solid state laser in which the lasing medium is a solid rod of crystalline material pumped by a flash lamp or a diode laser. Typical output wavelengths are 355, 532, and 1064 nm. A neodymium-YAG laser can by used to irradiate cells in a flow cytometer."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000119 "John Quinn"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "neodymium-YAG laser"@en;
                 rdfs:subClassOf cdao:OBI_0400096.
cdao:OBI_0400078 cdao:IAO_0000111 "obscuration bar"@en;
                 cdao:IAO_0000112 "obscuration bar in a flow cytometer"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An obscuration bar is a an optical subsystem which is a strip of metal or other material that serves to block out direct light from the illuminating beam. The obscuration bar prevents the bright light scattered in the forward directions from burning out the collection device."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000119 "John Quinn"@en,
                                  "Flow Cytometry: First Principles, by Alice Longobardi Givan, ISBN-10: 0471382248, ISBN-13: 978-0471382249";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "obscuration bar"@en;
                 rdfs:subClassOf cdao:OBI_0000932,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000378 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400079 cdao:IAO_0000111 "optical filter"@en;
                 cdao:IAO_0000112 "720 LP filter, 580/30 BP filter"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An optical filter is an optical subsystem that selectively transmits light having certain properties (often, a particular range of wavelengths, that is, range of colours of light), while blocking the remainder. They are commonly used in photography, in many optical instruments, and to colour stage lighting Optical filters can be arranged to segregate and collect light by wave length."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Optical_filter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "optical filter"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000378 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000932.
cdao:OBI_0400080 cdao:IAO_0000111 "optical subsystem"@en;
                 cdao:IAO_0000112 "optical subsystem of a cytometer"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "a device or part of a device that deals with the behavior and properties of light and the interaction of light with matter. Commonly optical subsystems consist of an excitation optics and collection optics. The excitation optics of a flow cytometer optical subsystem consist of the laser and lenses that are used to shape and focus the laser beam. The collections optics consist of a collection lens to collect light emitted from the particle laser beam interaction and a system of optical mirrors and filters to route specified wavelengths of the collected light to designated optical detectors. The optical subsystem in a flow cytometer consists of the equipment used to irradiate particles, and collect the light either emitted or scattered by those particles."@en;
                 cdao:IAO_0000116 "DS: Is 'subsystem' necessary or is 'optical_system' enough. Not sure its graph position since an optical subsystem is not necessarily an instrument, but more likely part of one."@en;
                 cdao:IAO_0000117 "Person: Daniel Schober"@en;
                 cdao:IAO_0000119 "John Quinn"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "optical subsystem"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400065 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400078 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000968,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400079 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400081 cdao:IAO_0000111 "particle delivery vessel"@en;
                 cdao:IAO_0000112 "FC 500 particle delivery vessel"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Part of the fluidics subsystem. A particle delivery vessel is used to introduce either a single sample or multiple samples to a flow cytometer. The most common particle delivery vessel is a sample tube."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en;
                 cdao:IAO_0000232 "FG: this should be delted - particle delivery is a role that an object can play"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "particle delivery vessel"@en;
                 rdfs:subClassOf cdao:OBI_0000047.
cdao:OBI_0400082 cdao:IAO_0000111 "photodetector"@en;
                 cdao:IAO_0000112 "A photomultiplier tube, a photo diode"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A photodetector is a device used to detect and measure the intensity of radiant energy through photoelectric action. In a cytometer, photodetectors measure either the number of photons of laser light scattered on impact with a cell (for example), or the flourescence emitted by excitation of a fluorescent dye."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://einstein.stanford.edu/content/glossary/glossary.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "photodetector"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000453 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000832.
cdao:OBI_0400083 cdao:IAO_0000111 "photodiode"@en;
                 cdao:IAO_0000112 "Avalanche photodiode"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A photodiode is a semiconductor photodetector used to detect light and generate an electrical current. Typically used in forward scatter (FSC) detection. The photodiode collects the forward light scatter in a cytometer."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://cyto.mednet.ucla.edu/Protocols/flow.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "photodiode"@en;
                 rdfs:subClassOf cdao:OBI_0400082.
cdao:OBI_0400084 cdao:IAO_0000111 "photomultiplier tube"@en;
                 cdao:IAO_0000112 "R9647 by manufactured by Hamamatsu"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A photomultiplier is a device that is normally in the form of a tube, that uses a photocathode to convert photons into photoelectrons which are then amplified. PMTs are typically used to detect SSC and fluorescent parameters. Cytometers have a PMT for each color they can collect."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://cyto.mednet.ucla.edu/Protocols/flow.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "photomultiplier tube"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000395 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000832,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000370 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000967,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000453 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400085 cdao:IAO_0000111 "piezo electric crystal";
                 cdao:IAO_0000112 "quartz piezoelectric crystal, topaz piezoelectric crystal, piezoelectric crystal in a sonar"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Apparatus in the fluidic subsystem of sorters that vibrates to break up the stream coming out of the flow chamber into droplets for sorting. The peizo electric crystal vibrates in a manner that breaks off droplets at regular intervals. Not all droplets contain a cell."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.flocyte.com/FRTP/Resources/flow_cytometry_glossary.htm"@en;
                 cdao:IAO_0000232 "think this is natural thing, not a device HP/JF";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "piezo electric crystal"@en;
                 rdfs:subClassOf cdao:OBI_0001033,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000377 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400086 cdao:IAO_0000111 "plate loader"@en;
                 cdao:IAO_0000112 "FC 500 plate loader"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Part of the fluidics system. A plate loader positions the wells of a multi-well plate under the aspiration tube is a preset order. A plate loader is used for high throughput applications."@en;
                 cdao:IAO_0000116 "measurement function is not corret as discussed on April 26 dev call. Will add new function such as positioning function. Add to tracker will discuss in the future.";
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.beckmancoulter.com/literature/Bioresearch/P-10202A.pdf"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "plate loader"@en;
                 rdfs:subClassOf cdao:OBI_0000968,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000383 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0400087 cdao:IAO_0000111 "preamplifier"@en;
                 cdao:IAO_0000112 "Built in preamplifier in a Hamamatsu H9656 PMT"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A preamplifier is part of the electronics subsystem. It converts the current output from its associated detector to a voltage. The preamplifier is the first stage in analog electronics signal processing."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "preamplifier"@en;
                 rdfs:subClassOf cdao:OBI_0400101.
cdao:OBI_0400088 cdao:IAO_0000111 "quartz cuvette flow chamber"@en;
                 cdao:IAO_0000112 "CVF-Q-10 flow chamber, CV-Q-10 flow chamber"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A flow cell in which the laser irradiates the cell as it passes through a quartz cuvette. A quartz cuvette flow chamber can be used to allow the laser to irradiate cells."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.flocyte.com/FRTP/Resources/flow_cytometry_glossary.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "quartz cuvette flow chamber"@en;
                 rdfs:subClassOf cdao:OBI_0400043.
cdao:OBI_0400089 cdao:IAO_0000111 "Reflection"@en;
                 cdao:IAO_0000112 "Reflection at TSRI Flow Cytometry Core Facility"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A Reflection is a sorter manufactured by iCyte. It uses digital signal processing, and can be configured with lasers of the users choice from among these excitation wavelengths: 355, 405,488, 532, 635nm. It accommodates up to 48 traditional PMTs. Options include an acousto-optical tunable filter (AOTF) and 16 channel spectrometer (370 to 730 nm). The various detection components can be uniquely configured across multiple Highly Automated Parallel Sorting (HAPS) modules. The Reflection can be used to analyse, sort, and collect cells."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.i-cyt.com/reflection.htm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Reflection"@en;
                 rdfs:subClassOf cdao:OBI_0400099.
cdao:OBI_0400091 cdao:IAO_0000111 "cytometer sample tube"@en;
                 cdao:IAO_0000112 "sample tube in a cytometer"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A particle delivery vessel. The cytometer sample tube is a vessel in which the sample is introduced to the cytometer. Frequently the tube is placed on the cytometer in such a manner that a seal is formed between the tube and cytometer, and gas is used to create enough pressure to push the sample out of the tube and into the cytometer."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "cytometer sample tube"@en;
                 rdfs:subClassOf cdao:OBI_0000836.
cdao:OBI_0400094 cdao:IAO_0000111 "sheath tank"@en;
                 cdao:IAO_0000112 "LSR2 sheath tank"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Part of the fluidics system. The sheath tank is the vessel that holds the sheath fluid at a constant pressure, allowing for it to be pushed into the flow chamber at a constant rate. The sheath tank holds the pressurized sheath fluid."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "Practical Flow Cytometry 4th Edition, Howard Shapiro, ISBN-10: 0471411256, ISBN-13: 978-0471411253"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "sheath tank"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000401 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000370 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0002089.
cdao:OBI_0400095 cdao:IAO_0000111 "short pass filter"@en;
                 cdao:IAO_0000112 "620 SP filter"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A short pass filter is an optical filter that passes low wavelengths of light but attenuates (or reduces) wavelengths higher than the cutoff frequency. A short pass filter with a cutoff of 500 nm would pass all wavelengths less than 500 nm."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Low-pass_filter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "short pass filter"@en;
                 rdfs:subClassOf cdao:OBI_0400079.
cdao:OBI_0400096 cdao:IAO_0000111 "solid state laser"@en;
                 cdao:IAO_0000112 "Solid State Heat Capacity Laser developed at DOE's Lawrence Livermore National Laboratory for the USA Army's Space and Missile Defense Command"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A solid-state laser is a laser that uses a lasing medium that is a solid, rather than a liquid such as dye lasers or a gas such as gas lasers. Semiconductor-based diode lasers are also in the solid state, but are generally considered separately from solid-state lasers. The first laser developed was an optical pumped ruby crystal solid state laser."@en;
                 cdao:IAO_0000117 "Daniel Schober"@en;
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Solid-state_laser"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "solid state laser"@en;
                 rdfs:subClassOf cdao:OBI_0400064.
cdao:OBI_0400097 cdao:IAO_0000111 "Somacount"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A Somacount is a flow_cytometer_analyser manufactured by Bently Instruments. It is a specialized tool for counting somatic cells in milk by specifically staining them with Ethidium Bromide and counting the cells that fluoresce. It has one laser, and the filters and a PMT for the single parameter. There are three sizes available, the 150, 300, and 500 with the number indicating the maximum number of cells that can be analysed per hour. The Somacount is an example of a very specific use cytometer; it exclusively counts somatic cells in milk."@en;
                 cdao:IAO_0000117 "John Quinn"@en;
                 cdao:IAO_0000119 "http://www.bentleyinstruments.com/somacount.html#Anchor-Bentley-49575"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Somacount"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
cdao:OBI_0400098 cdao:IAO_0000111 "SomaScope"@en;
                 cdao:IAO_0000112 "SomaScope Mark II Automatic Economical"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "The SomaScope is an instrument to quantify somatic cells in milk."@en;
                 cdao:IAO_0000117 "Josef Spidlen"@en;
                 cdao:IAO_0000119 """\"http://www.aicompanies.com/DeltaCD/soma_auto_adv.htm, 2007-05-10\""""@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "SomaScope"@en;
                 rdfs:subClassOf cdao:OBI_0400008.
