                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0000521 cdao:IAO_0000111 "flame ionization detector"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A flame ionization detector is a GC detector that consist of a hydrogen/air flame and a collector plate which are normally heated independently of the chromatographic oven. Heating is necessary in order to prevent condensation of water generated by the flame and also to prevent any hold-up of solutes as they pass from the column to the flame. There is an electrode above the flame to collect the ions formed at a hydrogen/air flame. The number of ions hitting the collector is measured and a signal is generated. Flame ionization detectors are most widely used and generally applicable for gas chromatography and hence is used for routine and general purpose analysis. It is easy to use but destructive of the sample."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000118 "FID"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01197",
                                  "WEB:<http://homepages.onsnet.nu/%7Ealkema/html/whatisgc.html>"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "flame ionization detector"@en;
                 rdfs:subClassOf cdao:OBI_0000637.
cdao:OBI_0000522 cdao:IAO_0000111 "vial"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A vial is a cylindrical container often made from glass tubing."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01117",
                                  "GROUP:<http://msi-ontology.sourceforge.net>"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "vial"@en;
                 rdfs:subClassOf cdao:OBI_0000601.
cdao:OBI_0000523 cdao:IAO_0000111 "magic angle spinning rotor"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A rotor device that holds the NMR sample and enables the adjustment of the orientation of the rotation axis for a sample in a NMR instrument in the magic angle."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000118 "MAS rotor"@en;
                 cdao:IAO_0000119 "WEB:<http://www.freepatentsonline.com/4352066.html>"@en,
                                  "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400130";
                 cdao:IAO_0000232 "NMR instrument"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "magic angle spinning rotor"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000566 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000050 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000968.
cdao:OBI_0000524 cdao:IAO_0000111 "Varian VXR spectrometer"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A Varian NMR spectrometer."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "WEB:<http://www.scs.uiuc.edu/NMR/instruments/vxr500.php>"@en,
                                  "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400238";
                 cdao:IAO_0000232 "NMR instrument"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Varian VXR spectrometer"@en;
                 rdfs:subClassOf cdao:OBI_0000611.
cdao:OBI_0000525 cdao:IAO_0000111 "splitless GC injector"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Injected sample enters column immediately (while split valve to split vent is closed). Here a sample is introduced into a heated small chamber via a syringe through a septum - the heat facilitates volatilization of the sample and sample matrix. The carrier gas then either sweeps the entirety (splitless mode) or a portion (split mode) of the sample into the column. In split mode, a part of the sample/carrier gas mixture in the injection chamber is exhausted through the split vent."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01060",
                                  "WEB:<http://en.wikipedia.org/wiki/Gas_chromatography>"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "splitless GC injector"@en;
                 rdfs:subClassOf cdao:OBI_0000504.
cdao:OBI_0000526 cdao:IAO_0000111 "preparative autosampler"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "For preparative LC with injection of sample volumes ranging from L to mL ranges."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01062",
                                  "GROUP:<http://msi-ontology.sourceforge.net>"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "preparative autosampler"@en;
                 rdfs:subClassOf cdao:OBI_0000494.
cdao:OBI_0000527 cdao:IAO_0000111 "flow high resolution probe"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Hyphenated analytical techniques combining mass spectrometry and chromatography are well-established laboratory tools. The combination of chromatography and NMR has also made its way into the analytical laboratory. Further developments even combine all three techniques into an LC-NMR/NMR-MS system. The use of solid phase extraction provides an efficient interface between chromatography and NMR with demands for special type of flow probes."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000118 "flow HR-probe"@en;
                 cdao:IAO_0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                                  "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400195";
                 cdao:IAO_0000232 "NMR probe"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "flow high resolution probe"@en;
                 rdfs:subClassOf cdao:OBI_0000480.
cdao:OBI_0000528 cdao:IAO_0000111 "liquid chromatography valve"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A sample valve that must be able to sustain pressures up to 10,000 p.s.i., although it is most likely to operate on a continuous basis, at pressures of 3,000 p.s.i. or less. The higher the operating pressure the tighter the valve seating surfaces must be forced together to eliminate any leak. It follows that any abrasive material, however fine, that passes into the valve can cause the valve seating to become scored each time it is rotated which will ultimately lead to leaks. This will cause the sample size to vary between samples and eventually affect the accuracy of the analysis. It follows that any solid material must be carefully removed from any sample before filling the valve. The sample volume of an internal loop valve is situated in the connecting slot of the valve rotor and can be used only for relatively small sample volumes. Internal sample loop valves provide samples with volumes ranging from 0.1 ml to about 0.5 ml. Valve operation is shown in figure 6. The left-hand side diagram shows the load position. The sample occupies the rotor slot and has been filled by passing the sample from an appropriate syringe through the rotor slot to waste. While loading the sample, the mobile phase supply is passed through the valve directly to the column. To place the sample onto the column, the valve is then rotated and the valve slot containing the sample is now placed between the solvent supply and the column. As a result, the sample is passed into the column by the flow of solvent."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "WEB:<http://www.chromatography-online.org/EC-Dispersion/HPLC-Sample-Valves/rs16.html>"@en,
                                  "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01110";
                 cdao:IAO_0000232 "chromatography device"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "liquid chromatography valve"@en;
                 rdfs:subClassOf cdao:OBI_0000048.
cdao:OBI_0000529 cdao:IAO_0000111 "JEOL NMR probe"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An NMR probe that is manufactured by JEOL."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400232",
                                  "GROUP:<http://msi-ontology.sourceforge.net>"@en;
                 cdao:IAO_0000232 "NMR device"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "JEOL NMR probe"@en;
                 rdfs:subClassOf cdao:OBI_0000516.
cdao:OBI_0000530 cdao:IAO_0000111 "Bruker UltraShield Plus NMR magnet"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An NMR magnet of which Brukers claims it is the latest and most advanced self-shielding NMR magnet technology ever developed. These magnets are the ultimate advancement in high performance, actively-shielded NMR solutions. They offer unprecedented shielding performance whilst ensuring no compromise in system homogeneity, stability or cryogenic specifications."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "WEB:<http://www.bruker-biospin.com/nmr_magnets_usplus.html>"@en,
                                  "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400190";
                 cdao:IAO_0000232 "NMR instrument"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Bruker UltraShield Plus NMR magnet"@en;
                 rdfs:subClassOf cdao:OBI_0000597.
cdao:OBI_0000531 cdao:IAO_0000111 "Bruker CryoProbe"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "The Bruker BioSpin CryoProbe is a high-performance cryogenically cooled probe developed for high-resolution applications. It has improved signal/noise (S/N) ratios obtained by reducing the operating temperature of the coil and the pre-amplifier. As a result, the efficiency of the coil is improved and the noise of the coil and the pre-amplifier are reduced.The dramatic increase in the S/N ratio by a factor of 3-4, as compared to conventional probes, leads to a possible reduction in experiment time of up to 16 or a reduction in required sample concentration by a factor of up to 4. The CryoProbes possess key characteristics for NMR analysis:\\n   Significant S/N gains (with moderately salty samples also)\\n   Short pulse widths\\n   Short ring down times\\n   Linear behavior in power response\\n   Gradient capability\\n   CryoProbes are available as Triple Resonance, Dual, Selective X Detection, MicroImaging, and Quad Nucleus Probes configurations at 400 MHz and higher\\n   All high resolution probes have a lock circuit\\n   All high resolution probes have Z-gradient."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                                  "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400191";
                 cdao:IAO_0000232 "NMR probe"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Bruker CryoProbe"@en;
                 rdfs:subClassOf cdao:OBI_0000561.
cdao:OBI_0000532 cdao:IAO_0000111 "column cartridge"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A device that binds the chromatography column and additional connector elements and / or valves or syringes into one physical unity for further processing."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                                  "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01055";
                 cdao:IAO_0000232 "chromatography device, check on definition !"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "column cartridge"@en;
                 rdfs:subClassOf cdao:OBI_0000048.
cdao:OBI_0000533 cdao:IAO_0000111 "affinity column"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An affinity column is a chromatography column that is used in affinity chromatography. Differences in the affinity of molecules to be separated to a stationary phase are used for discriminate retention."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01094",
                                  "GROUP:<http://msi-ontology.sourceforge.net>"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "affinity column"@en;
                 rdfs:subClassOf cdao:OBI_0000038.
cdao:OBI_0000534 cdao:IAO_0000111 "tecmag NMR instrument"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An NMR instrument that is manufactured by tecmag."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400250",
                                  "GROUP:<http://msi-ontology.sourceforge.net>"@en;
                 cdao:IAO_0000232 "NMR instrument"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "tecmag NMR instrument"@en;
                 rdfs:subClassOf cdao:OBI_0000566.
cdao:OBI_0000535 cdao:IAO_0000111 "gel filtration column"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A Gel filtration column is a chromatography column for size-exclusion chromatography, in which the stationary phase is a gel. The main application of gel filtration chromatography is the fractionation of proteins and other water-soluble polymers."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01104",
                                  "GROUP:<http://msi-ontology.sourceforge.net>"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "gel filtration column"@en;
                 rdfs:subClassOf cdao:OBI_0000618.
cdao:OBI_0000536 cdao:IAO_0000111 "fraction collector"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A fraction detector is a device that allows regular or specified samples to be taken from a column eluate and stored in a retrievable form. The storage vessels are usually small sample tubes or vials that are oriented in a rotating disk or in a moving belt, there movement usually being controlled by a microprocessor. On receiving a signal from the microprocessor, the next vial is placed under the column outlet and the eluate collected until receiving another signal from the computer. Once the properties of the chromatogram that describes the separation has been ascertained, then the collection program can be defined. The fractions can be collected on a basis of time either at regular intervals or a specific times to collect specific peaks. Alternatively the fractions can be collected by monitoring the detector output and when a peak starts to elute the fraction collector is activated and the peak collected in a specific vial. When the peak returns to base line the column eluate is then directed to waste until the next peak starts eluting. Fraction collectors are in common use with most liquid chromatographs. They are used to collect samples for further purification, subsequent examination by spectroscopic techniques or for biological or organoleptic testing."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01073",
                                  "WEB:<http://www.chromatography-online.org/topics/fraction/collector.html>"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "fraction collector"@en;
                 rdfs:subClassOf cdao:OBI_0000485.
cdao:OBI_0000537 cdao:IAO_0000111 "copy number variation profiling assay";
                 cdao:IAO_0000112 "Profiling of copy number variations (CNVs) in healthy individuals from three ethnic groups using a human genome 32 K BAC-clone-based array. PMID:18058796";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An assay that determines lost or amplified genomic regions of DNA by comparing genomic DNA originating from tissues from the same or different individuals using specific techniques such as CGH, array CGH, SNP genotyping";
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000118 "CNV analysis";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "copy number variation profiling assay";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000109 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001404 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000136 ; 
