cdao:OBI_0000060 cdao:IAO_0000111 "trial monitor role";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "a responsible party involved in planning, overseeing the conduct of a study or study component, and interpreting data from a study"@en;
                 cdao:IAO_0000117 "Person:Jennifer Fostel"@en;
                 cdao:IAO_0000118 "trial monitor";
                 cdao:IAO_0000232 "CDISC definition:  Person employed by the sponsor or CRO who is responsible for determining that a trial is being conducted in accordance with the protocol and GCP guidance. NOTE: A monitor's duties may include, but are not limited to, helping to plan and initiate a trial, assessing the conduct of trials, and assisting in data analysis, interpretation and extrapolation. Clinical Research Associate:  Primary representative of the sponsor; monitors progress of investigator sites participating in a clinical study."@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "trial monitor role"@en;
                 rdfs:subClassOf cdao:OBI_0000102.
cdao:OBI_0000064 cdao:IAO_0000111 "positive reference substance role";
                 cdao:IAO_0000112 "MMS mutagen"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 """a reference role in which the characteristics or responses elicited by the substance playing the reference substance role are used to establish a \"100%\" response""";
                 cdao:IAO_0000117 "Person: Jennifer Fostel"@en;
                 cdao:IAO_0000118 "positive reference substance";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "positive reference substance role"@en;
