                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000314.
cdao:IAO_0000318 cdao:IAO_0000111 "results section"@en;
                 cdao:IAO_0000112 "The section labelled 'results' in a typical scientific journal article"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A part of a publication about an investigation that is about a study design execution"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 cdao:IAO_0000118 "results"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "results section"@en;
