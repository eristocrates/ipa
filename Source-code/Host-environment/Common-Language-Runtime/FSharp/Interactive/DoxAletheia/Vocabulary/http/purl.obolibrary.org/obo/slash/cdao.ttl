                 cdao:IAO_0000112 "the use of a sucrose gradient to isolate mitochondria"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "a protocol application that uses different concentrations of materials in a defined order to create a gradient to facilitate the separation of an input material into its components with specific qualities"@en;
                 cdao:IAO_0000117 "PERSON:Kevin Clancy"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
