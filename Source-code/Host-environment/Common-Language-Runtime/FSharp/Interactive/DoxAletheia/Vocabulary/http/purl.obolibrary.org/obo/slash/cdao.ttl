                                 cdao:OBI_0000857.
cdao:OBI_0000406 cdao:IAO_0000111 "PCR product"@en;
                 cdao:IAO_0000112 "PCR products are the results of amplifcation process. Detection of a PCR products is used to detect DNA and RNA.";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "is double stranded DNA that is the specified output of a polymerase chain reaction"@en;
                 cdao:IAO_0000116 "We are using PCR and not the written out words, as this is the most common used."@en;
                 cdao:IAO_0000117 "GROUP: OBI BIomaterial Branch";
                 cdao:IAO_0000119 "GROUP: OBI BIomaterial Branch";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "PCR product"@en;
                 rdfs:subClassOf cdao:OBI_0000809,
                                 cdao:CHEBI_4705;
