                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An Instrument which is used to carry out a NMR analysis of some sample."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000118 "NMR instrument"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400059",
                                  "GROUP:<http://msi-ontology.sourceforge.net>"@en;
