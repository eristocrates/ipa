cdao:OBI_0000275 cdao:IAO_0000111 "analyte role";
                 cdao:IAO_0000112 "Glucose in blood (measured in an assay to determine the concentration of glucose).";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A measurand role borne by a molecular entity or an atom and realized in an analyte assay which achieves the objective to measure the magnitude/concentration/amount of the analyte in the entity bearing evaluant role."@en;
                 cdao:IAO_0000116 "qualities such as weight, color are not assayed but measured, so they do not fall into this category.",
                                  "interestingly, an analyte is still an analyte even if it is not detected.  for this reason it does not bear a specified input role",
                                  "pH (technically the inverse log of [H+]) may be considered a quality; this remains to be tested.";
                 cdao:IAO_0000117 "GROUP: Role Branch";
                 cdao:IAO_0000119 "OBI";
                 cdao:IAO_0000232 "Feb 10, 2009.  changes after discussion at OBI Consortium Workshop Feb 2-6, 2009.  accepted as core term.";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "analyte role"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cdao:CHEBI_23367
                                                                                                                           cdao:CHEBI_33250) ; 
