cdao:OBI_0000722 cdao:IAO_0000111 "paired-end library";
                 cdao:IAO_0000112 "PMID: 19339662. Next-generation DNA sequencing of paired-end tags (PET) for transcriptome and genome analyses. Genome Res. 2009 Apr;19(4):521-32. Fullwood MJ, Wei CL, Liu ET, Ruan Y.";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "is a collection of short paired tags from the two ends of DNA fragments are extracted and covalently linked as ditag constructs";
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000118 "paired-end tag (PET) library",
                                  "mate-paired library";
                 cdao:IAO_0000119 "adapted from information provided by Solid web site";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "paired-end library";
                 rdfs:subClassOf cdao:OBI_0000047.
cdao:OBI_0000723 cdao:IAO_0000111 "DNA sequencing by ligation assay";
                 cdao:IAO_0000112 "ABI Solid Sequencing uses the ligation-based DNA sequencing technology (https://en.wikipedia.org/wiki/ABI_Solid_Sequencing).";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A DNA sequencing assay that performs chain extension during the sequencing reaction step using DNA ligase";
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "url:https://en.wikipedia.org/wiki/Sequencing_by_ligation";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "DNA sequencing by ligation assay";
                 rdfs:subClassOf cdao:OBI_0000626,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:PR_000023089 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0000724 cdao:IAO_0000111 "Solexa sequencing assay";
                 cdao:IAO_0000112 "PMID: 18987734";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A DNA sequencing by synthesis assay that identifies sequence information using DNA polymerase and reversible terminator, requiring immobilization of genomic DNA fragments onto a surface and a specific clonal amplification step known as bridge PCR. Reliance on a reversible terminator allows cycles of DNA chain extension by DNA polymerase and imaging without the need of electrophoretic separation of newly synthesized DNA fragment as with Sanger sequencing.";
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000118 "reversible terminator sequencing";
                 cdao:IAO_0000119 "Solexa web site (SS_DNAsequencing.pdf document available on july 2009)";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Solexa sequencing assay";
                 rdfs:subClassOf cdao:OBI_0000734,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cdao:OBI_0000722
                                                                                                                           cdao:OBI_0000736) ; 
