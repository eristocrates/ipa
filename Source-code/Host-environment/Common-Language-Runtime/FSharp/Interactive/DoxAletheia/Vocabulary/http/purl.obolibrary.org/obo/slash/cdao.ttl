cdao:OBI_0200195 cdao:IAO_0000111 "proportional hazards model estimation";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Proportional hazards model is a data transformation model to estimate the effects of different covariates influencing the times-to-failure of a system.";
                 cdao:IAO_0000117 "PERSON: James Malone",
                                  "PERSON: Tina Boussard";
                 cdao:IAO_0000118 "Cox model",
                                  "Cox proportional hazards model";
                 cdao:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Cox_proportional_hazards_model";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "proportional hazards model estimation";
                 rdfs:subClassOf cdao:OBI_0200194,
