                                 cdao:OBI_0000094.
cdao:OBI_0600041 cdao:IAO_0000111 "concentrate"@en;
                 cdao:IAO_0000112 "Evaporation of the solution containing DNA to increase the concentration of the DNA molecules"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "a protocol application to create an output material with an increased density of a material of interest that is part of the input material by separating other parts of the input material"@en;
                 cdao:IAO_0000117 "PERSON:Kevin Clancy"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "concentrate"@en;
