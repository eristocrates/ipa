                 rdfs:domain cdao:OBI_0000011;
                 rdfs:label "achieves_planned_objective";
                 rdfs:range cdao:IAO_0000005;
                 <http://www.w3.org/2002/07/owl#inverseOf> cdao:OBI_0000833.
