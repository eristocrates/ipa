                                 cdao:OBI_0000070.
cdao:OBI_0000444 cdao:IAO_0000111 "target of material addition role";
                 cdao:IAO_0000112 "peritoneum of an animal receiving an interperitoneal injection; solution in a tube receiving additional material; location of absorbed material following a dermal application.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "target of material addition role is a role realized by an entity into which a material is added in a material addition process";
                 cdao:IAO_0000116 "From Branch discussion with BP, AR, MC -- there is a need for the recipient to interact with the administered material.  for example, a tooth receiving a filling was not considered to be a target role.";
                 cdao:IAO_0000117 "GROUP:  Role Branch";
                 cdao:IAO_0000119 "OBI";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "target of material addition role"@en;
                 rdfs:subClassOf cdao:BFO_0000023,
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> cdao:OBI_0000274 ; 
