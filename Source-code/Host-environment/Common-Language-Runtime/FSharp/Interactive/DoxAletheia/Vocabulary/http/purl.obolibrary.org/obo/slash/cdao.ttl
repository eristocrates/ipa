cdao:OBI_0000868 cdao:IAO_0000111 "pattern matching objective";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A pattern matching objective aims to detect the presence of the constituents of a given pattern. In contrast to pattern recognition, the pattern is rigidly specified. Patterns are typicall sequences or trees.";
                 cdao:IAO_0000117 "Tina Boussard";
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Pattern_matching";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "pattern matching objective";
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0000869 cdao:IAO_0000111 "polyA RNA extract";
                 cdao:IAO_0000112 "Preparation of polyA RNA by cellulose-bound oligo-dT (Aviv, H., Leder, P. 1972. Purification of biologically active globin messenger RNA by chromatography on oligothymidylic acid-cellulose. Proc. Nat. Acad. Sci. USA 69, 1408-1412.)";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A RNA extract that is the output of an extraction process in which RNA molecules with poly A tail at its 3' end are purified.";
                 cdao:IAO_0000117 "PERSON: Jie Zheng",
                                  "PERSON: Chris Stoeckert";
                 cdao:IAO_0000119 "UPenn Group";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "polyA RNA extract";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000848 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
