cdao:IAO_0000635 cdao:IAO_0000111 "patients section"@en;
                 cdao:IAO_0000112 "The section labelled 'patients' in a typical scientific journal article, e.g. in Citak et al. Acta Orthop. 2013 Jun; 84(3): 326–327. (http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3715825/)"@en;
                 cdao:IAO_0000115 "A part of a document about the patients that participated in a study."@en;
                 cdao:IAO_0000117 "PERSON: Bill Baumgartner"@en;
                 cdao:IAO_0000233 <https://github.com/information-artifact-ontology/IAO/issues/183>;
