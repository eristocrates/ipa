                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A scaling data transformation is a data transformation that has objective scaling."@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000119 "PERSON: James Malone"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
