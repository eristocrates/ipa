                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0000876 cdao:IAO_0000111 "cytoplasmic RNA extract";
                 cdao:IAO_0000112 "Cytoplasmic RNA extraction from mammalian tissues to create cDNA library (Carninci P, Nakamura M, Sato K, Hayashizaki Y, Brownstein MJ. Cytoplasmic RNA extraction from fresh and frozen mammalian tissues. Biotechniques. 2002;33:306–309.)";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A RNA extract that is the output of a RNA extraction process in which RNA molecules found in the cytoplasm are extracted.";
                 cdao:IAO_0000117 "PERSON: Jie Zheng",
                                  "PERSON: Chris Stoeckert";
                 cdao:IAO_0000119 "UPenn Group";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "cytoplasmic RNA extract";
                 rdfs:subClassOf cdao:OBI_0000880,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000859 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
