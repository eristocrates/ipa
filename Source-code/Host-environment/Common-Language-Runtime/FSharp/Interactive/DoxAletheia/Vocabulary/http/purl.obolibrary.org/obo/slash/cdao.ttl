                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Proxy respondent is a worker role of describing patient's symptoms or condition to medical personnel"@en;
                 cdao:IAO_0000117 "Jennifer Fostel"@en;
