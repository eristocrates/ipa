cdao:OBI_0000560 cdao:IAO_0000111 "ion exchange column"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An ion exchange column is a chromatography column that is used in ion exchange chromatography and anion or cation exchange resins to enable separation."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01105",
