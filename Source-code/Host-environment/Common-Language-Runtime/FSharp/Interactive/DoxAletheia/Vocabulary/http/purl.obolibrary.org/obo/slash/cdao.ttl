cdao:OBI_0000102 cdao:IAO_0000111 "responsible party role";
                 cdao:IAO_0000112 "he THERAPIST has the ability to print a separate statement for the patient and each responsible party. http://www.beaverlog.com/therapist/ez_support/billing/responsible_party_statements.htm"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
