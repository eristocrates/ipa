cdao:OBI_0002112 cdao:IAO_0000111 "small RNA sequencing assay";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An RNA-seq assay which is targeting small RNA (< 200 bp) sequences such as, but not exclusive to, miRNAs using, for example, small RNA library preparation kits.";
                 cdao:IAO_0000117 "Jason Hilton",
                                  "Mark A. Miller",
                                  "Chris Stoeckert";
                 cdao:IAO_0000118 "short RNA-seq",
                                  "small RNA-seq";
                 cdao:IAO_0000119 "url:http://science.sciencemag.org/content/316/5830/1484.full",
                                  "url:http://www.illumina.com/techniques/sequencing/rna-sequencing/small-rna-seq.html";
                 cdao:IAO_0000233 "https://github.com/obi-ontology/obi/issues/859";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "small RNA sequencing assay";
                 rdfs:subClassOf cdao:OBI_0001271.
cdao:OBI_0002113 cdao:IAO_0000111 "bromouridine labeling and sequencing assay";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An RNA-seq assay to identify spans of nascent transcription in the genome through isolation of recent bromouridine (Bru) labelled RNAs.";
                 cdao:IAO_0000117 "Chris Stoeckert",
                                  "Jason Hilton";
                 cdao:IAO_0000118 "Bru-seq";
                 cdao:IAO_0000119 "PMC:4009065";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "bromouridine labeling and sequencing assay";
                 rdfs:subClassOf cdao:OBI_0001271.
cdao:OBI_0002114 cdao:IAO_0000111 "bromouridine pulse-chase and sequencing assay";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An RNA-seq assay to identify RNA populations of specific ages through isolation of RNAs first labelled with bromouridine (Bru) followed by chasing in uridine for different periods of time.";
                 cdao:IAO_0000117 "Jason Hilton",
                                  "Chris Stoeckert";
                 cdao:IAO_0000118 "BruChase-seq";
                 cdao:IAO_0000119 "PMC:4009065";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "bromouridine pulse-chase and sequencing assay";
                 rdfs:subClassOf cdao:OBI_0001271.
cdao:OBI_0002115 cdao:IAO_0000111 "cytometry time of flight assay";
                 cdao:IAO_0000112 "Whole human blood samples were incubated with lipopolysaccharide (LPS) to examine dose-dependent signaling responses within the toll-like receptor 4 (TLR4) pathway. After LPS stimulation, rare earth metal tagged antibodies against phenotypic markers were used to stain the blood sample (Nd143-CD45RA, Nd145-CD4, Er170-CD3, Sm152-TCR__, Pr141-CD7, Nd146-CD8, Nd142-CD19). A Fluidigm CyTOF version 1 instrument equipped with CyTOF software version 5.1.648 was used to measure and analyze the levels of antibody staining refelctive of the level of expression of those surface receptors.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A cytometry assay in which the presence of molecules of interest on or in cells is indicated by binding of antibodies labeled with rare earth element tags which are detected by time-of-flight mass spectrometry.";
                 cdao:IAO_0000117 "ImmPort";
                 cdao:IAO_0000118 "CyTOF";
                 cdao:IAO_0000119 "PMID:26190063";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "cytometry time of flight assay";
                 rdfs:subClassOf cdao:OBI_0001977,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000470 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:REO_0000171
                                                                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:CHEBI_33321 ; 
                                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000052 ; 
                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000055 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:CHEBI_33321 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0002116 cdao:IAO_0000111 "high performance liquid chromotography assay";
                 cdao:IAO_0000112 "On-line coupled immunoaffinity chromatography-reversed-phase high-performance liquid chromatography (IAC-HPLC) with detection by quadrupole ion trap mass spectrometry using a particle beam interface has been developed for the determination of the steroids, dexamethasone and flumethasone. HEMA (polyhydroxyethylmethacrylate) was evaluated as a support material for the anti-dexamethasone antibodies used in IAC. Antibody cross-reactivity and non-specific binding have been investigated for the HEMA bound anti-dexamethasone IAC column. The on-line IAC-HPLC-MS determination of dexamethasone and flumethasone in post-administration equine urine samples showed precisions (R.S.D.) of 8.0 and 7.1%, respectively, with limits of detection in the range 3-4 ng/ml.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An analytical chromatography assay that utilizes a high performance liquid chromatography instrument for separation of compounts in a solution.";
                 cdao:IAO_0000117 "ImmPort";
                 cdao:IAO_0000118 "HPLC";
                 cdao:IAO_0000119 "PMID:9491555";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "high performance liquid chromotography assay";
                 rdfs:subClassOf cdao:OBI_0001630;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0001630
                                                                                                                  [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:BFO_0000034
                                                                                                                                                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001057 ; 
                                                                                                                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000052 ; 
                                                                                                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000055 ; 
                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001057 ; 
                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>]) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0002117 cdao:IAO_0000111 "whole genome sequencing assay";
                 cdao:IAO_0000112 "WGS permits comprehensive sequencing of introns and exons, whereas whole exome sequencing (WES) allows deeper sequencing of exonic regions at a lower cost. Due to the large number of genetic variants found in each genome, it is necessary to use filtering approaches to distinguish deleterious from benign variants. WES has been used successfully to identify novel genetic causes of primary immunodeficiency. Complex structural variations and non-Mendelian disorders remain challenges for WGS.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A DNA sequencing assay that intends to provide information about the sequence of an entire genome of an organism.";
                 cdao:IAO_0000116 "Genotyping assays should ideally identify which part of the genome the information is about. We do not currently have a good way to do this. That information should be added later.";
                 cdao:IAO_0000117 "ImmPort";
                 cdao:IAO_0000118 "WGS";
                 cdao:IAO_0000119 "PMID:23095910",
                                  "PMID:25827230";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "whole genome sequencing assay";
                 rdfs:subClassOf cdao:OBI_0000626.
cdao:OBI_0002118 cdao:IAO_0000111 "exome sequencing assay";
                 cdao:IAO_0000112 "DNA was extracted from the Ficoll pellet of blood taken from congenital asplenia patients. Unamplified, high-molecular weight, RNase-treated genomic DNA (4_6 _g) was used for whole exome sequencing (WES) with the use of Agilent 71 Mb (V4 + UTR) singlesample capture and an Illumina HiSeq 2000. Sequencing was carried out so as to obtain 30_ coverage from 2 _ 100-bp paired-end reads. We used the Annovar tool (25) to annotate the resulting highquality (HQ) variants. In the regions targeted by WES capture (81.5% of the consensus coding genome), the mean numbers of single-nucleotide variants (SNVs) and small insertions/deletions (indels) detected per sample were 84,192 and13,325, respectively. After filtering, a mean of 74,398 (95.3%) high-quality (HQ) SNVs and 9,033 (70.6%) HQ indels were called. A mean of 105 coding HQ SNVs and 32 indels was identified.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A DNA sequencing assay that intends to provide information about the sequence of the protein coding components of a genome (exons).";
                 cdao:IAO_0000117 "ImmPort";
                 cdao:IAO_0000118 "WES";
                 cdao:IAO_0000119 "PMID:25827230";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "exome sequencing assay";
                 rdfs:subClassOf cdao:OBI_0000626.
cdao:OBI_0002119 cdao:IAO_0000111 "microscopy assay";
                 cdao:IAO_0000112 "Lung, liver, and spleen tissue samples were collected from female BALB/c mice and fixed in 100% formalin solution, embedded in paraffin, sectioned, and stained with hematoxylin and eosin. The stained samples were examined for signs of pathological changes under light microscopy.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An imaging assay that utilizes a microscope to magnify features of the visualized material of interest that are not visible to naked eye.";
                 cdao:IAO_0000117 "ImmPort";
                 cdao:IAO_0000119 "PMID:21685355";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "microscopy assay";
                 rdfs:subClassOf cdao:OBI_0000185;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0000185
                                                                                                                  [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:BFO_0000034
                                                                                                                                                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400169 ; 
                                                                                                                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000052 ; 
                                                                                                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000055 ; 
                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0400169 ; 
                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>]) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0002120 cdao:IAO_0000111 "mixed lymphocyte reaction assay";
                 cdao:IAO_0000112 "T cells were separated from PBL of laboratory volunteers and used as responder cells (R). Mitomycin C-treated allogeneic mAPC enriched populations were used as stimulators (S), incubated for 5 days, pulsed with 3H-thymidine (3H-TdR) for 16 hours, harvested, and radioactivity counted using a beta scintillation counter to measure proliferation of the 3H-thymidine labeled cells.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A cytometry assay where lymphocytes from two individuals are co-cultured with the lymphocytes from one of the allogeneic individuals (Responders) being labeled (with 3H Thymidine or BrdU) and the proliferation of the labeled cells is measured, which is thought to reflect recognition of histocompatibility antigens on the unlabeled cells (stimulators).";
                 cdao:IAO_0000117 "ImmPort";
                 cdao:IAO_0000118 "MLR";
                 cdao:IAO_0000119 "PMID:14969764";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "mixed lymphocyte reaction assay";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0000086
                                                                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:REO_0000280 ; 
                                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000052 ; 
                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000055 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
