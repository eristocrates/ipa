                    rdfs:label "mucosa of oropharynx";
                    rdfs:subClassOf cdao:UBERON_0000465.
cdao:UBERON_0006618 cdao:IAO_0000111 "atrium auricular region";
                    cdao:IAO_0000115 "A small conical pouch projections located on the upper anterior portion of each atrium of the heart.";
                    cdao:IAO_0000412 cdao:uberon.owl;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "atrium auricular region";
                    rdfs:subClassOf cdao:UBERON_0000481.
