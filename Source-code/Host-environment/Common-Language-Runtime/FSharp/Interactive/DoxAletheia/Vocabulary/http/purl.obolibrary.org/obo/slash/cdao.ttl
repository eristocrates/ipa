                                 cdao:IAO_0000400.
cdao:IAO_0000403 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A cartesion spatial coordinate datum that  uses three values to specify a position within a three dimensional spatial region"@en;
                 cdao:IAO_0000117 "Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "three dimensional cartesian spatial coordinate datum"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:BFO_0000018
                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:BFO_0000028 ; 
                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000050 ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000219 ; 
