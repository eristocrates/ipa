                 cdao:IAO_0000112 "The objective to obtain multiple aliquots of an enzyme preparation.";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A material separation objective aiming to separate material into multiple portions, each of which contains a similar composition of the input material.";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "portioning objective";
                 rdfs:subClassOf cdao:OBI_0000639;
