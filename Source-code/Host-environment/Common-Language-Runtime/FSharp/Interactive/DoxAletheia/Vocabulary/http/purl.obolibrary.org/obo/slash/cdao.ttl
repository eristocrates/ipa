cdao:UBERON_0005022 cdao:IAO_0000111 "mucosa of nasopharynx";
                    cdao:IAO_0000115 "A mucosa that is part of a nasopharynx [Automatically generated definition].";
                    cdao:IAO_0000412 cdao:uberon.owl;
