                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A service provides sequencing service which is the realization of some sequencing such as RNA and DNA sequencing in which the service provider role is realized.";
                 cdao:IAO_0000117 "Person: Jie Zheng";
                 cdao:IAO_0000119 "Adpated from 'DNA sequencing service'";
