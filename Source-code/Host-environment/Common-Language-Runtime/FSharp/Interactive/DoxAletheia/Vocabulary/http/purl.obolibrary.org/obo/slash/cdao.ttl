                 rdfs:range xsd:float;
                 rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
cdao:IAO_0000405 a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                   <http://www.w3.org/2002/07/owl#DatatypeProperty>;
