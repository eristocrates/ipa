                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000832.
cdao:OBI_0000817 cdao:IAO_0000111 "fucoidan";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Fucoidan is a sulfated polysaccharide (MW: average 20,000) found mainly in various species of brown seaweed such as kombu, limu moui,bladderwrack, wakame, mozuku, and hijiki (variant forms of fucoidan have also been found in animal species, including the sea cucumber).";
                 cdao:IAO_0000117 "Helen Parkinson";
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Fucoidan";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "fucoidan";
                 rdfs:subClassOf cdao:CHEBI_23367.
cdao:OBI_0000818 cdao:IAO_0000111 "calibration";
                 cdao:IAO_0000112 "the process of using pH buffer adjust a pH meter";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A planned process with the objective to establish the relationship between data produced by a measurement device and physical qualities. This is done by using the measurement device under defined conditions, and either tuning it to adjust the measured output, or record the output and use it as a reference in future measurements.";
                 cdao:IAO_0000117 "GROUP: OBI Philly workshop";
                 cdao:IAO_0000119 "WEB:http://en.wikipedia.org/wiki/calibration";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "calibration";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000070 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000011,
