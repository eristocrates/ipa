cdao:OBI_0001144 cdao:IAO_0000111 "binding constant"@en;
                 cdao:IAO_0000112 """The predicted or measured binding affinity of a peptide to a MHC molecule can be captured in the binding constants \"IC50 = 12 nM\" or \"t 1/2 = 30 minutes\". """@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A binding datum about the disposition of two or more material entities to form complexes which comes in the form of a scalar and unit that are utilized in equations that model the binding process"@en;
                 cdao:IAO_0000116 "10/6/11 BP: The distinction between binding datum and binding constant is based on the later being part of an equation. That should be captured in the logical definition here, and used to make it to a defined class. ";
                 cdao:IAO_0000117 "PERSON: Bjoern Peters, Randi Vita, Jason Greenbaum"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "binding constant"@en;
                 rdfs:subClassOf cdao:OBI_0001181;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#unionOf> (cdao:OBI_0001536
                                                                                                           cdao:OBI_0001548
                                                                                                           cdao:OBI_0001571
                                                                                                           cdao:OBI_0001581
                                                                                                           cdao:OBI_0001583
                                                                                                           cdao:OBI_0001603
                                                                                                           cdao:OBI_0001605) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0001145 cdao:IAO_0000111 "3D structure determination of bound complex assay";
                 cdao:IAO_0000112 "Determination of a 3D structure of an antibody binding a protein by X-Ray crystallography, which identifies the specific binding site of the antibody.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A 3D structure determination assay in which a complex of 2 or more material enties is characterized which provides information on their binding configuration.";
                 cdao:IAO_0000117 "IEDB";
                 cdao:IAO_0000119 "IEDB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "3D structure determination of bound complex assay";
                 rdfs:subClassOf cdao:OBI_0600045;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0600045
                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001588 ; 
                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000136 ; 
