cdao:OBI_1110059 cdao:IAO_0000111 "ELISPOT assay measuring epitope specific interferon-gamma production by T cells";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An assay of epitope specific interferon-gamma production by T cells that uses an ELISPOT assay.";
                 cdao:IAO_0000117 "PERSON:Randi Vita, Jason Greenbaum, Bjoern Peters";
