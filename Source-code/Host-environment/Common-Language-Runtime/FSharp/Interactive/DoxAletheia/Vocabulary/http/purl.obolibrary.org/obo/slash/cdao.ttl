                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a genetic transformation which relies on the use of physical, electrical and chemical phenomena to introduce DNA or RNA into a cell"@en;
                 cdao:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en;
