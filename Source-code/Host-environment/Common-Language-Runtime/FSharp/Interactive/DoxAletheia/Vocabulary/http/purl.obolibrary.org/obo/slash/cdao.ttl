cdao:OBI_0001172 cdao:IAO_0000111 "dose response curve";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A data item of paired values, one indicating the dose of a material, the other quantitating a measured effect at that dose. The dosing intervals are chosen so that effect values be interpolated by a plotting a curve. ";
                 cdao:IAO_0000117 "Bjoern Peters; Randi Vita";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "dose response curve";
                 rdfs:subClassOf cdao:IAO_0000573.
cdao:OBI_0001173 cdao:IAO_0000111 "service";
                 cdao:IAO_0000112 "providing a training course for UCSD employees how to run a DNA sequencer; sequencing a DNA sample provided by a service consumer restricted to non-human samples; giving access to tissue samples in a biobank within OHSU; JAX shipping mice from their colony ";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A planned process in which a service provider performs a task (i.e. a planned process) for a service consumer.";
                 cdao:IAO_0000117 "Carlo; Matt";
                 cdao:IAO_0000119 "OBI workshop San Diego 2011";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "service";
