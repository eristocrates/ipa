                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0000407 cdao:IAO_0000111 "viral RNA extraction";
                 cdao:IAO_0000112 "The AccuPrepTM Viral RNA Extraction Kit is designed for the rapid and convenient extraction of viral RNA from cell-free samples as serum, plasma, CSF, urine, etc - http://www.biokits.com/moreinfos.html?id=2703";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "The extraction of RNA from an input material that specifically isolates viral RNA";
