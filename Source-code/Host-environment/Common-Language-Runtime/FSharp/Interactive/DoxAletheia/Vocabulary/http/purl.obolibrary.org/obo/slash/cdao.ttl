cdao:OBI_0001159 cdao:IAO_0000111 "age since egg laying measurement datum"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since egg laying, the process of the production of egg(s) by an organism.";
                 cdao:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng";
                 cdao:IAO_0000119 "MO_767 egg laying";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "age since egg laying measurement datum"@en;
                 rdfs:subClassOf cdao:OBI_0001167.
cdao:OBI_0001160 cdao:IAO_0000111 "assay validation objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "an objective specification to check the accuracy or the quality of the results of an assay by comparison with independent results"@en;
                 cdao:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en;
                 cdao:IAO_0000119 "GROUP: Penn Group"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "assay validation objective"@en;
                 rdfs:subClassOf cdao:IAO_0000005.
cdao:OBI_0001161 cdao:IAO_0000111 "age since germination measurement datum"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since germination, the process consisting of physiological and developmental changes by a seed, spore, pollen grain (microspore), or zygote that occur after release from dormancy, and encompassing events prior to and including the first visible indications of growth.";
                 cdao:IAO_0000116 "Definition of germination comes from GO. However, the term is deprecated from GO now because it is a grouping term without biological significance.";
                 cdao:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng";
                 cdao:IAO_0000119 "MO_590 germination";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "age since germination measurement datum"@en;
                 rdfs:subClassOf cdao:OBI_0001167.
cdao:OBI_0001162 cdao:IAO_0000111 "validation by reverse transcription PCR design"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a study design in which checks the accuracy or the quality of the result of an assay  by comparing with reverse transcription PCR results"@en;
                 cdao:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en;
                 cdao:IAO_0000119 "MO_986 reverse_transcription_PCR_quality_control"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "validation by reverse transcription PCR design"@en;
                 rdfs:subClassOf cdao:OBI_0500000.
cdao:OBI_0001163 cdao:IAO_0000111 "age since eclosion measurement datum"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since eclosion, the process of emergence of an adult insect from its pupa or cocoon.";
                 cdao:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng";
                 cdao:IAO_0000119 "MO_876 eclosion";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "age since eclosion measurement datum"@en;
                 rdfs:subClassOf cdao:OBI_0001167.
cdao:OBI_0001164 cdao:IAO_0000111 "age since sowing measurement datum"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since sowing, the process of placing a seed or spore in some media with the intention to invoke germination.";
                 cdao:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng";
                 cdao:IAO_0000119 "MO_748 sowing";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "age since sowing measurement datum"@en;
                 rdfs:subClassOf cdao:OBI_0001167.
cdao:OBI_0001165 cdao:IAO_0000111 "age since coitus measurement datum"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since coitus, the process of copulation that occurs during the process of sexual reproduction.";
                 cdao:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng";
                 cdao:IAO_0000119 "MO_783 coitus";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "age since coitus measurement datum"@en;
                 rdfs:subClassOf cdao:OBI_0001167.
cdao:OBI_0001166 cdao:IAO_0000111 "validation by real time PCR design"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a study design in which the accuracy or the quality of the result of an assay is checked by comparing with real time PCR results"@en;
                 cdao:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en;
                 cdao:IAO_0000119 "MO_434 real_time_PCR_quality_control"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "validation by real time PCR design"@en;
                 rdfs:subClassOf cdao:OBI_0500000.
cdao:OBI_0001167 cdao:IAO_0000111 "age measurement datum"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A time measurement datum that is the result of measurement of age of an organism";
                 cdao:IAO_0000116 """note that we are currently defining subtypes of age measurement datum that specify when the age is relative to, e.g. planting, as we don't have adequate temporal predicates yet.
life of bearer doesn't imply organism
this assay measures time not developmental stage. we recognize that development can take different time periods under different conditions such as media / temperature
age as a quality is dubious; we plan to revisit
stages in development are currently handled with controlled vocabulary, such as 2-somite stage """;
                 cdao:IAO_0000117 "PERSON: Alan Ruttenberg, Chris Stoeckert, Jie Zheng";
                 cdao:IAO_0000119 "MO_178 Age";
                 cdao:IAO_0000232 """In MageTab file, we use
initialTimePoint (a process) + age (a number expected) + TimeUnit (definied in UO, such as year, hour, day, etc.)
Now we use the term label indicating the start time point of measuring the age, (number + TimeUnit) are expected instances of the class""",
                                  """discussed on Nov 15, dev call
All subtype will be defined by textual definition now.""";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "age measurement datum"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:PATO_0000011 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000221 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000416.
cdao:OBI_0001168 cdao:IAO_0000111 "age since fertilization measurement datum"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since fertilization, the process of the union of gametes of opposite sexes during the process of sexual reproduction to form a zygote.";
                 cdao:IAO_0000116 "Definition of fertilization comes from GO.";
                 cdao:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng";
                 cdao:IAO_0000119 "MO_701 fertilization";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "age since fertilization measurement datum"@en;
                 rdfs:subClassOf cdao:OBI_0001167.
cdao:OBI_0001169 cdao:IAO_0000111 "age since birth measurement datum"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An age measurement datum that is the result of the measurement of the age of an organism since birth, the process of emergence and separation of offspring from the mother.";
                 cdao:IAO_0000117 "PERSON:Chris Stoeckert, Jie Zheng";
                 cdao:IAO_0000119 "MO_710 birth";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "age since birth measurement datum"@en;
                 rdfs:subClassOf cdao:OBI_0001167.
