                 cdao:IAO_0000115 "A pathologic primary tumor stage for ovary according to AJCC 7th edition indicating that the tumor involves one or both ovaries with pelvic extension.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/ovary/path_t/";
