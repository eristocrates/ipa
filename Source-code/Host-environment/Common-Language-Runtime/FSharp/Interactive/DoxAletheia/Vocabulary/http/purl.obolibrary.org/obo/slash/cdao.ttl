cdao:OBI_0000301 cdao:IAO_0000111 "obsoleted_has_specified_output_information";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A relation between a participant in a process, that produces a data set . The process is the realization of a concretization of a realizable information entity (objective specification or plan specification). In general, not all data present at the end of the process are specified_data."@en;
                 cdao:IAO_0000117 "PERSON: Frank Gibson",
                                  "PERSON: Alan Ruttenberg"@en;
                 cdao:IAO_0000231 cdao:IAO_0000103;
