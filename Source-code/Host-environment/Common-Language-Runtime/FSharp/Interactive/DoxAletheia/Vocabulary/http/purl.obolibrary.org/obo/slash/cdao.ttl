cdao:OBI_0000738 cdao:IAO_0000111 "restriction enzyme based cloning";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "restriction enzyme based cloning is a recombinant vector cloning process that has as an input genetic material that was cleaved with restriction enzymes, and a cloning vector that was cleaved with complementary restriction enzymes. It uses ligase to chemically join the input genetic material and the cloning vector to create a recombinant vector.";
                 cdao:IAO_0000117 "Kevin Clancy, Bjoern Peters";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "restriction enzyme based cloning";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0000411
                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000742 ; 
