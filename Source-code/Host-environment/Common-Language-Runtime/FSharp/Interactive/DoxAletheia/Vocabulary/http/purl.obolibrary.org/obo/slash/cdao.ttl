cdao:OBI_0001153 cdao:IAO_0000111 "genetic transformation objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a material transformation objective aims to create genetically modified organism or cell"@en;
                 cdao:IAO_0000117 "Person: Jie Zheng"@en;
