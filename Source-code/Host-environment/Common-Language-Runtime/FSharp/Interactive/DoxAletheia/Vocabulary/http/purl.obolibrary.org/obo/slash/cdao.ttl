cdao:OBI_0002586 cdao:IAO_0000111 "digital acquisition card";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "The digital acquisition card acts as the interface between the computer and a measurement device via the computer bus. It converts the signal generated by a measurement device (output from device) to a digital signal via an analog-to-digital converter, ADC. It also converts a digital signal to an analog signal via a digital-to-analog converter, DAC. This analog signal (e.g., stimulus) is fed to a measurement device (input to device).";
                 cdao:IAO_0000117 "Mark A. Miller";
                 cdao:IAO_0000118 "DAQ device",
                                  "digital acquisition and digital generation card";
                 cdao:IAO_0000119 "Brenda Farrell, bfarrell@bcm.edu";
                 <http://purl.org/dc/elements/1.1/date> "2018-08-07T13:47:12Z"^^xsd:dateTime;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "digital acquisition card";
                 rdfs:seeAlso "https://github.com/obi-ontology/obi/issues/927";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000393 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000968.
cdao:OBI_0002587 cdao:IAO_0000111 "machine learning";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A planned process in which statistical techniques are used to give computers the ability to learn about patterns in data, without being explicitly programmed.  Learning is defined in this case as progressively improving performance on a specific task.";
                 cdao:IAO_0000117 "Mark A. Miller";
                 cdao:IAO_0000119 "https://en.wikipedia.org/wiki/Machine_learning";
                 <http://purl.org/dc/elements/1.1/contributor> "https://github.com/TrisSN";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "machine learning";
                 rdfs:subClassOf cdao:OBI_0000011.
cdao:OBI_0002588 cdao:IAO_0000111 "supervised machine learning";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A machine learning process using a function that maps an input to an output based on example input-output pairs. It infers a function from labeled training data consisting of a set of training examples.";
                 cdao:IAO_0000117 "Mark A. Miller";
                 cdao:IAO_0000119 "https://en.wikipedia.org/wiki/Supervised_learning";
                 <http://purl.org/dc/elements/1.1/contributor> "https://github.com/TrisSN";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "supervised machine learning";
                 rdfs:subClassOf cdao:OBI_0002587.
cdao:OBI_0002589 cdao:IAO_0000111 "unsupervised machine learning";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 """A machine learning process that infers a function describing the structure of \"unlabeled\" data (i.e. data that has not been classified or categorized).""";
                 cdao:IAO_0000117 "Mark A. Miller";
                 cdao:IAO_0000119 "https://en.wikipedia.org/wiki/Unsupervised_learning";
                 <http://purl.org/dc/elements/1.1/contributor> "https://github.com/TrisSN";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "unsupervised machine learning";
                 rdfs:subClassOf cdao:OBI_0002587.
