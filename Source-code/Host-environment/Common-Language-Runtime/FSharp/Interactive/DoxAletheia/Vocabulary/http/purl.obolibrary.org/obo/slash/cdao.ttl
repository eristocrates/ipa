cdao:OBI_0001681 cdao:IAO_0000111 "yeast one-hybrid assay";
                 cdao:IAO_0000112 "Yeast one-hybrid assays for gene-centered human gene regulatory network mapping. PMID:22037702";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An assay that determines protein DNA interactions using a single fusion protein in which the activating domain is linked directly to the binding domain.";
