cdao:OBI_0200080 cdao:IAO_0000111 "network analysis"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A data transformation that takes as input data that describes biological networks in terms of the node (a.k.a. vertex) and edge graph elements and their characteristics and generates as output properties of the constituent nodes and edges, the sub-graphs, and the entire network."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000118 "network topology analysis";
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "network analysis"@en;
                 rdfs:subClassOf cdao:OBI_0200000.
cdao:OBI_0200081 cdao:IAO_0000111 "sequence analysis objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A sequence analysis objective is a data transformation objective which aims to analyse some ordered biological data for sequential patterns."@en;
                 cdao:IAO_0000117 "James Malone";
                 cdao:IAO_0000119 "PERSON: James Malone";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "sequence analysis objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0200082 cdao:IAO_0000111 "longitudinal data analysis";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Longitudinal analysis is a data transformation used to perform repeated observations of the same items over long periods of time."@en;
                 cdao:IAO_0000117 "PERSON: Tina Boussard",
                                  "PERSON: James Malone";
                 cdao:IAO_0000118 "longitudinal data analysis"@en,
                                  "correlation analysis";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "longitudinal data analysis"@en;
                 rdfs:subClassOf cdao:OBI_0200000,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200196 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200083 cdao:IAO_0000111 "survival analysis objective"@en;
                 cdao:IAO_0000112 "Kaplan meier data transformation";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A data transformation objective which has the data transformation aims to model time to event data (where events are e.g. death and or disease recurrence); the purpose of survival analysis is to model the underlying distribution of event times and to assess the dependence of the event time on other explanatory variables";
                 cdao:IAO_0000117 "PERSON: Tina Boussard",
                                  "PERSON: James Malone";
                 cdao:IAO_0000118 "survival analysis";
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Survival_analysis";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "survival analysis objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0200085 cdao:IAO_0000111 "mass spectrometry analysis"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A data transformation which has the objective of spectrum analysis.";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "mass spectrometry analysis"@en;
                 rdfs:subClassOf cdao:OBI_0200000;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200197 ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200086 cdao:IAO_0000111 "spread calculation data transformation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A spread calculation is a data transformation that has objective spread calculation."@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000119 "EDITOR";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "spread calculation data transformation"@en;
                 rdfs:subClassOf cdao:OBI_0200000;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200180 ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200088 cdao:IAO_0000111 "Kaplan Meier"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a nonparametric (actuarial) data transformation technique for estimating time-related events. It is a univariate analysis that estimates the probability of the proportion of subjects in remission at a particular time, starting from the initiation of active date (time zero), and takes into account those lost to follow-up or not yet in remission at end of study (censored)";
                 cdao:IAO_0000117 "PERSON: James Malone",
                                  "PERSON: Tina Boussard";
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Kaplan%E2%80%93Meier_estimator";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Kaplan Meier"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200083 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200194.
cdao:OBI_0200089 cdao:IAO_0000111 "multiple testing correction method";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A multiple testing correction method is a hypothesis test performed simultaneously on M > 1 hypotheses.  Multiple testing procedures produce a set of rejected hypotheses that is an estimate for the set of false null hypotheses while controlling for a suitably define Type I error rate";
                 cdao:IAO_0000117 "Monnie McGee";
                 cdao:IAO_0000118 "multiple testing procedure"@en;
                 cdao:IAO_0000119 "PAPER: Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 9-10.";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "multiple testing correction method"@en;
                 rdfs:subClassOf cdao:OBI_0000668;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000791 ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200091 cdao:IAO_0000111 "inter-rater reliability objective";
                 cdao:IAO_0000112 """A study was conducted to determine the inter-rater reliability of common clinical examination procedures proposed to identify patients with lumbar segmental instability.

Examples include joint-probability of agreement, Cohen's kappa and the related Fleiss' kappa, inter-rater correlation, concordance correlation coefficient and intra-class correlation.""";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a data transformation objective of determining the concordance or agreement between human judges.";
                 cdao:IAO_0000117 "Person:Helen Parkinson",
                                  "Person:Alan Ruttenberg";
                 cdao:IAO_0000118 "inter-rater agreement";
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Inter-rater_reliability";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "inter-rater reliability objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0200092 cdao:IAO_0000111 "Westfall and Young family wise error rate correction"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Is a data transformation process in which the Westfall and Young method is applied with the aim of controlling for multiple testing";
                 cdao:IAO_0000116 "PRS: 2011-03-31: set specified input and specified output to the data transformation"@en,
                                  """2011-03-31: [PRS]. 
specified input and output of dt which were missing"""@en;
                 cdao:IAO_0000117 "Helen Parkinson";
                 cdao:IAO_0000118 "Westfall and Young FWER correction"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Westfall and Young family wise error rate correction"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000791 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001265 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000175 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200073.
cdao:OBI_0200093 cdao:IAO_0000111 "polynomial transformation"@en;
                 cdao:IAO_0000112 """a*x+b, with a non-zero, is a polynomial of degree one in one variable;  a*x^2+b*x+c, with a nonzero, is a polynomial of degree 2 in 1
variable; a*x*y+b*y+c, with a non-zero, is a polynomial of degree 2 in 2 variables (x and y); a_1*x_1+...+a_n*x_n+b, with at least one of the a_i's non-zero, is a polynomial of degree one in n variables"""@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A polynomial transformation is a data transformation that is obtained through a polynomial, where a polynomial is a mathematical expression involving a sum of powers in one or more variables multiplied by coefficients (e.g. see http://mathworld.wolfram.com/Polynomial.html). The number of variables and the degree are properties of a polynomial. The degree of a polynomial is the highest power of its terms, where the terms of a polynomial are the individual summands with the coefficients omitted."@en;
                 cdao:IAO_0000117 "Elisabetta Manduchi"@en;
                 cdao:IAO_0000119 "WEB: http://mathworld.wolfram.com/Polynomial.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "polynomial transformation"@en;
                 rdfs:subClassOf cdao:OBI_0200000.
cdao:OBI_0200094 cdao:IAO_0000111 "logarithmic transformation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A logarithmic transformation is a data transformation consisting in the application of the logarithm function with a given base a (where a>0 and a is not equal to 1) to a (one dimensional) positive real number input. The logarithm function with base a can be defined as the inverse of the exponential function with the same base. See e.g. http://en.wikipedia.org/wiki/Logarithm."@en;
                 cdao:IAO_0000117 "Elisabetta Manduchi"@en;
                 cdao:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Logarithm"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "logarithmic transformation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200167 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200169.
cdao:OBI_0200095 cdao:IAO_0000111 "exponential transformation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An exponential transformation is a data transformation consisting in the application of the exponential function with a given base a (where a>0 and a is typically not equal to 1) to a (one dimensional) real number input. For alternative definitions and properties of this function see, e.g., http://en.wikipedia.org/wiki/Exponential_function and http://en.wikipedia.org/wiki/Characterizations_of_the_exponential_function."@en;
                 cdao:IAO_0000117 "Elisabetta Manduchi"@en;
                 cdao:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Characterizations_of_the_exponential_function"@en,
                                  "WEB: http://en.wikipedia.org/wiki/Exponential_function"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "exponential transformation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200167 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200169.
cdao:OBI_0200097 cdao:IAO_0000111 "non-negative matrix factorization";
                 cdao:IAO_0000112 "Non-negative matrix factorization is used in text mining where document-term matrix is constructed with the weights of various terms (typically weighted word frequency information) from a set of documents. This matrix is factored into a term-feature and a feature-document matrix.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Non negative matrix factorization is a data transformation in which factorises a matrix and which forces that all elements must be equal to or greater than zero.";
                 cdao:IAO_0000119 "http://en.wikipedia.org/wiki/Non-negative_matrix_factorization";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "non-negative matrix factorization"@en;
                 rdfs:subClassOf cdao:OBI_0200000.
cdao:OBI_0200098 cdao:IAO_0000111 "soft independent modeling of class analogy analysis";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Soft independent modeling by class analogy (SIMCA) is a descriptive statistics method for supervised classification of data. The method requires a training data set consisting of samples (or objects) with a set of attributes and their class membership. The term soft refers to the fact the classifier can identify samples as belonging to multiple classes and not necessarily producing a classification of samples into non-overlapping classes."@en;
                 cdao:IAO_0000117 "Tina Hernandez-Boussard"@en;
                 cdao:IAO_0000118 "SIMCA"@en;
                 cdao:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Soft_independent_modelling_of_class_analogies"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "soft independent modeling of class analogy analysis"@en;
                 rdfs:subClassOf cdao:OBI_0200169,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200167 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200099 cdao:IAO_0000111 "discriminant function analysis"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "Discriminant function analysis is a form of discriminant analysis used to determine which variables discriminate between two or more naturally occurring groups. Analysis is used to determine which variable(s) are the best predictors of a particular outcome."@en;
                 cdao:IAO_0000117 "Tina Hernandez-Boussard"@en;
                 cdao:IAO_0000119 "WEB: http://www.statsoft.com/textbook/stdiscan.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "discriminant function analysis"@en;
                 rdfs:subClassOf cdao:OBI_0200106,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000648 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000023 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200179 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 cdao:OBI_0200175,
                                 cdao:OBI_0000663.
cdao:OBI_0200100 cdao:IAO_0000111 "canonical variate analysis"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "canonical variate analysis is a form of discriminant analysis that takes several continuous predictor variables and uses the entire set to predict several criterion variables, each of which is also continuous. CVA simultaneously calculates a linear composite of all x variables and  a linear composite of all y variables. Unlike other multivariate techniques, these weighted composites are derived in pairs. Each linear combination is called a canonical variate and takes the general linear form."@en;
                 cdao:IAO_0000117 "Tina Hernandez-Boussard"@en;
                 cdao:IAO_0000118 "CVA"@en;
                 cdao:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Canonical_analysis"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "canonical variate analysis"@en;
                 rdfs:subClassOf cdao:OBI_0200171,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200172 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200106.
cdao:OBI_0200101 cdao:IAO_0000111 "linear discriminant functional analysis"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "Linear discriminant functional analysis (LDFA) is a multivariate technique used in special applications where there are several intact groups (random assignment may be impossible) and they have been measured on several independent measures. Thus, you will want to describe how these groups differ on the basis of these measures. In this case, classification and prediction is the main objective."@en;
                 cdao:IAO_0000117 "Tina Hernandez-Boussard"@en;
                 cdao:IAO_0000119 "PERSON: Tina Hernandez-Boussard"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "linear discriminant functional analysis"@en;
                 rdfs:subClassOf cdao:OBI_0000663,
                                 cdao:OBI_0200106,
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000023 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200179 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000648 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200175.
cdao:OBI_0200102 cdao:IAO_0000111 "regression analysis method"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "Regression analysis is a descriptive statistics technique that examines the relation of a dependent variable (response variable) to specified independent variables (explanatory variables). Regression analysis can be used as a descriptive method of data analysis (such as curve fitting) without relying on any assumptions about underlying processes generating the data."@en;
                 cdao:IAO_0000117 "Tina Hernandez-Boussard"@en;
                 cdao:IAO_0000119 "BOOK: Richard A. Berk, Regression Analysis: A Constructive Critique, Sage Publications (2004) 978-0761929048"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "regression analysis method"@en;
                 rdfs:subClassOf cdao:OBI_0200000.
cdao:OBI_0200103 cdao:IAO_0000111 "multiple linear regression analysis"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 """multiple linear regression is a regression method that models the relationship between a dependent variable Y, independent variables Xi, i = 1, ..., p, and a random term epsilon. The model can be written as
    Y = \\beta_0 + \\beta_1 X_1 + \\beta_2 X_2 + \\cdots +\\beta_p X_p + \\varepsilon
where \\beta_0 =  0 is the intercept (\"constant\" term), the \\beta_i s  are the respective parameters of independent variables, and p is the number of parameters to be estimated in the linear regression."""@en;
                 cdao:IAO_0000117 "Tina Hernandez-Boussard"@en;
                 cdao:IAO_0000119 "WEB:http://en.wikipedia.org/wiki/Linear_regression"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "multiple linear regression analysis"@en;
                 rdfs:subClassOf cdao:OBI_0200102.
cdao:OBI_0200104 cdao:IAO_0000111 "principal component regression"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "The Principal Component Regression method is a regression analysis method that combines the Principal Component Analysis (PCA)spectral decomposition with an Inverse Least Squares (ILS) regression method to create a quantitative model for complex samples. Unlike quantitation methods based directly on Beer's Law which attempt to calculate the absorbtivity coefficients for the constituents of interest from a direct regression of the constituent concentrations onto the spectroscopic responses, the PCR method regresses the concentrations on the PCA scores."@en;
                 cdao:IAO_0000117 "Tina Hernandez-Boussard"@en;
                 cdao:IAO_0000119 "WEB: : http://www.thermo.com/com/cda/resources/resources_detail/1,2166,13414,00.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "principal component regression"@en;
                 rdfs:subClassOf cdao:OBI_0200175,
                                 cdao:OBI_0200102,
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000648 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200178 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0200105 cdao:IAO_0000111 "partial least square regression analysis"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 """Partial least squares regression is an extension of the multiple linear regression model (see, e.g., Multiple Regression or General Stepwise Regression). In its simplest form, a linear model specifies the (linear) relationship between a dependent (response) variable Y, and a set of predictor variables, the X's, so that
Y = b0 + b1X1 + b2X2 + ... + bpXp
In this equation b0 is the regression coefficient for the intercept and the bi values are the regression coefficients (for variables 1 through p) computed from the data."""@en;
                 cdao:IAO_0000117 "Tina Hernandez-Boussard"@en;
                 cdao:IAO_0000118 "PLS-RA"@en;
                 cdao:IAO_0000119 "ARTICLE: de Jong, S. (1993). SIMPLS: An alternative approach to partial least squares regression. Chemometrics and Intelligent Laboratory Systems, 18: 251-263."@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "partial least square regression analysis"@en;
                 rdfs:subClassOf cdao:OBI_0200102.
cdao:OBI_0200106 cdao:IAO_0000111 "discriminant analysis"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "Discriminant function analysis is used to determine which variables discriminate between two or more naturally occurring groups. Analysis is used to determine which variable(s) are the best predictors of a particular outcome."@en;
                 cdao:IAO_0000117 "Tina Hernandez-Boussard"@en;
                 cdao:IAO_0000119 "WEB: http://www.statsoft.com/textbook/stdiscan.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "discriminant analysis"@en;
                 rdfs:subClassOf cdao:OBI_0200000.
cdao:OBI_0200107 cdao:IAO_0000111 "partial least square discriminant analysis"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "PLS Discriminant Analysis (PLS-DA) is a discriminant analysis performed in order to sharpen the separation between groups of observations, by hopefully rotating PCA (Principal Components Analysis) components such that a maximum separation among classes is obtained, and to understand which variables carry the class separating information.";
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000118 "PLS-DA"@en;
                 cdao:IAO_0000119 "WEB: http://www.camo.com/rt/Resources/pls-da.html";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "partial least square discriminant analysis"@en;
                 rdfs:subClassOf cdao:OBI_0200106.
cdao:OBI_0200108 cdao:IAO_0000111 "eh transformation"@en;
                 cdao:IAO_0000112 "This type of transformation is typically used in flow cytometry."@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An eh transformation is a data transformation obtained by applying the function EH described in what follows to a (one dimensional) real number input. EH(x)=exp(x*d/r)+b*(d/r)*x-1, if x>=0, and EH(x)=-exp(-x*d/r)+b*(d/r)*x+1, otherwise. Here exp denotes an exponential transformation and b, d, r are positive real constants with the objective of normalization."@en;
                 cdao:IAO_0000117 "Joseph Spliden"@en,
                                  "Elisabetta Manduchi"@en,
                                  "Ryan Brinkman"@en;
                 cdao:IAO_0000119 "WEB: http://flowcyt.sourceforge.net/gating/latest.pdf"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "eh transformation"@en;
                 rdfs:subClassOf cdao:OBI_0200169,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200167 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200109 cdao:IAO_0000111 "b transformation"@en;
                 cdao:IAO_0000112 "This type of transformation is typically used in flow cytometry."@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A b transformation is a data transformation obtained by applying the function B described in what follows to a (one dimensional) real number input. B(x)= a*exp(b*x)-c*exp(-d*x)+f, where exp denotes an exponential transformation and a, b, c, d, f are real constants with a, b, c, d positive with the objective of normalization."@en;
                 cdao:IAO_0000117 "Joseph Spliden"@en,
                                  "Ryan Brinkman"@en,
                                  "Elisabetta Manduchi"@en;
                 cdao:IAO_0000119 "WEB: http://flowcyt.sourceforge.net/gating/latest.pdf"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "b transformation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000451 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200167 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 cdao:OBI_0200169.
cdao:OBI_0200110 cdao:IAO_0000111 "s transformation"@en;
                 cdao:IAO_0000112 "This type of transformation is typically used in flow cytometry."@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An s transformation is a data transformation obtained by applying the function S described in what follows to a (one dimensional) real number input. S(x)=T*exp(w-m)*(exp(x-w)-(p^2)*exp((w-x)/p)+p^2-1) if x>=w, S(x)=-S(w-x) otherwise; where exp denotes an exponential_transformations, 'p^' denotes the exponential transformation with base p; T, w, m, p are real constants with T, m, and p positive and w non-negative, and where w and p are related by w=2p*ln(p)(p+1) with the objective of normalization."@en;
                 cdao:IAO_0000117 "Elisabetta Manduchi"@en,
                                  "Ryan Brinkman"@en,
                                  "Joseph Spliden"@en;
                 cdao:IAO_0000119 "WEB: http://flowcyt.sourceforge.net/gating/latest.pdf"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "s transformation"@en;
                 rdfs:subClassOf cdao:OBI_0200169,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200167 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200111 cdao:IAO_0000111 "data visualization";
                 cdao:IAO_0000112 "Generation of a heatmap from a microarray dataset";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An planned process that creates images, diagrams or animations from the input data."@en;
                 cdao:IAO_0000117 "James Malone"@en,
                                  "Melanie Courtot"@en,
                                  "Tina Boussard"@en,
                                  "Elisabetta Manduchi"@en;
                 cdao:IAO_0000118 "visualization"@en,
                                  "data encoding as image";
                 cdao:IAO_0000119 "PERSON: Melanie Courtot"@en,
                                  "PERSON: James Malone"@en,
                                  "PERSON: Elisabetta Manduchi"@en,
                                  "PERSON: Tina Boussard"@en;
                 cdao:IAO_0000232 """Possible future hierarchy might include this:
information_encoding
>data_encoding
>>image_encoding""";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "data visualization"@en;
                 rdfs:subClassOf cdao:OBI_0000011,
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> cdao:IAO_0000027 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000027 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cdao:IAO_0000038
                                                                                                                          cdao:IAO_0000101) ; 
                                                                                 a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cdao:IAO_0000038
                                                                                                                           cdao:IAO_0000101) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200113 cdao:IAO_0000111 "similarity calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A similarity calculation is a data transformation that attaches to each pair of objects in the input a number that is meant to reflect how 'close' or 'similar' those objects are."@en;
                 cdao:IAO_0000117 "Elisabetta Manduchi"@en;
                 cdao:IAO_0000119 "PERSON: Elisabetta Manduchi"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "similarity calculation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000023 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000648 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000663,
                                 cdao:OBI_0200175.
cdao:OBI_0200114 cdao:IAO_0000111 "euclidean distance calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An euclidean distance calculation is a similarity calculation that attaches to each pair of real number vectors of the same dimension n the square root of the sum of the square differences between corresponding components. The smaller this number, the more similar the two vectors are considered."@en;
                 cdao:IAO_0000117 "Elisabetta Manduchi"@en;
                 cdao:IAO_0000119 "PERSON: Elisabetta Manduchi"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "euclidean distance calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200113.
cdao:OBI_0200115 cdao:IAO_0000111 "pearson correlation coefficient calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 """A pearson correlation coefficient calculation is a similarity calculation which attaches to each pair of random variables X and Y the ratio of their covariance by the product of their standard deviations. Given a series of n measurements of X and Y written as x_i and y_i where i = 1, 2, ..., n, then their Pearson correlation coefficient refers to the \"sample correlation coefficient\" and is written as the sum over i of the ratios (x_i-xbar)*(y_i-ybar)/((n-1)*s_x*s_y) where xbar and ybar are the sample means of X and Y , s_x and s_y are the sample standard deviations of X and Y. The closer the pearson correlation coefficient is to 1, the more similar the inputs are considered."""@en;
                 cdao:IAO_0000117 "Elisabetta Manduchi"@en;
                 cdao:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Correlation"@en,
                                  "PERSON: Elisabetta Manduchi"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "pearson correlation coefficient calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200113.
cdao:OBI_0200116 cdao:IAO_0000111 "loess fitting"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A loess fitting is a curve fitting obtained by localized regression. The latter refers to fitting a polynomial (straight line, quadratic, cubic, etc) to data values within a window covering a fraction of the total number of observations. As the window slides along the axis, a new polynomial is fit to the observations falling within the window. This continues until all points are fit with a local polynomial. The results are then smoothed together to form a curve. The smoothness of loess fits is controlled by a smoothing parameter (often denoted as alpha, usually between 1/4 and 1) and the degree of the polynomial that is fitted by the method (usually denoted by lambda)."@en;
                 cdao:IAO_0000117 "Monnie McGee"@en,
                                  "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "ARTICLE: Mathematical details of loess fits are given in Cleveland, William (1993) Visualizing Data. Hobart Press, Summit, New Jersey, pp. 94-101."@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "loess fitting"@en;
                 rdfs:subClassOf cdao:OBI_0200072,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200174 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200117 cdao:IAO_0000111 "mode calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A mode calculation is a descriptive statistics calculation in which the mode is calculated which is the most common value in a data set. It is most often used as a measure of center for discrete data."@en;
                 cdao:IAO_0000117 "James Malone"@en,
                                  "Monnie McGee"@en;
                 cdao:IAO_0000119 "PERSON: Monnie McGee"@en,
                                  "PERSON: James Malone"@en;
                 cdao:IAO_0000232 "From Monnie's file comments - need to add center_calculation role but it doesn't exist yet - (editor note added by James Jan 2008)"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "mode calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200181,
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000674 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200177 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200078 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200184.
cdao:OBI_0200118 cdao:IAO_0000111 "quantile calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A quantile calculation is a descriptive statistics calculation in which the kth quantile is the data value for which an approximate k fraction of the data is less than or equal to that value.  See http://www.stat.wvu.edu/SRS/Modules/Quantiles/quantiles.html for details."@en;
                 cdao:IAO_0000117 "Monnie McGee"@en;
                 cdao:IAO_0000119 "WEB: http://www.stat.wvu.edu/SRS/Modules/Quantiles/quantiles.html"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "quantile calculation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200078 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200184.
cdao:OBI_0200119 cdao:IAO_0000111 "median calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A median calculation is a  descriptive statistics calculation in which the midpoint of the data set (the 0.5 quantile) is calculated.  First, the observations are sorted in increasing order.  For an odd number of observations, the median is the middle value of the sorted data.  For an even number of observations, the median is the average of the two middle values."@en;
                 cdao:IAO_0000117 "Monnie McGee"@en,
                                  "James Malone"@en;
                 cdao:IAO_0000119 "PERSON: James Malone"@en,
                                  "PERSON: Monnie McGee"@en;
                 cdao:IAO_0000232 "From Monnie's file comments - need to add center_calculation role but it doesn't exist yet - (editor note added by James Jan 2008)"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "median calculation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000674 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200177 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 cdao:OBI_0200184,
                                 cdao:OBI_0200181,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200078 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200120 cdao:IAO_0000111 "variance calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A variance calculation is a descriptive statistics calculation in which the variance is defined as the average squared distance of each observation in the data set to the mean of the data set.  It is also known as the second central moment."@en;
                 cdao:IAO_0000117 "Monnie McGee"@en;
                 cdao:IAO_0000119 "PERSON: Monnie McGee"@en;
                 cdao:IAO_0000232 "From Monnie's file comments - need to add spread_calculation and moment_calculation roles but they don't exist yet - (editor note added by James Jan 2008)"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "variance calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200086,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200180 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200184,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200078 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200121 cdao:IAO_0000111 "standard deviation calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A standard deviation calculation is a descriptive statistics calculation defined as the square root of the variance.  Also thought of as the average distance of each value to the mean."@en;
                 cdao:IAO_0000117 "Monnie McGee"@en;
                 cdao:IAO_0000119 "PERSON: Monnie McGee"@en;
                 cdao:IAO_0000232 "From Monnie's file comments - need to add spread calculation role but they doesn't exist yet - (editor note added by James Jan 2008)"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "standard deviation calculation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200078 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200086,
                                 cdao:OBI_0200184,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200180 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200122 cdao:IAO_0000111 "interquartile-range calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "The interquartile range is a descriptive statistics calculation defined as the difference between the 0.75 quantile and the 0.25 quantile for a set of data."@en;
                 cdao:IAO_0000117 "Monnie McGee"@en;
                 cdao:IAO_0000119 "PERSON: Monnie McGee"@en;
                 cdao:IAO_0000232 "From Monnie's file comments - need to add spread calculation role but they doesn't exist yet - (editor note added by James Jan 2008)"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "interquartile-range calculation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200078 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200086,
                                 cdao:OBI_0200184,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200180 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200123 cdao:IAO_0000111 "skewness calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A skewness calculation is a descriptive statistics calculation defined as a parameter that describes how much a distribution (or a data set) varies from a bell-shaped curve.  See http://www.riskglossary.com/link/skewness.htm for details.  It is also known as the third central moment"@en;
                 cdao:IAO_0000117 "Monnie McGee"@en;
                 cdao:IAO_0000119 "WEB: http://www.riskglossary.com/link/skewness.htm"@en;
                 cdao:IAO_0000232 "From Monnie's file comments - need to add moment calculation role but they doesn't exist yet - (editor note added by James Jan 2008)"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "skewness calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200181,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200078 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200184,
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000674 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200177 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0200124 cdao:IAO_0000111 "kurtosis calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A kurtosis calculation is a descriptive statistics calculation defined as a parameter that measures how large or small the tails of a distribution are relative to the mean.  For details, see http://davidmlane.com/hyperstat/A53638.html"@en;
                 cdao:IAO_0000117 "Monnie McGee"@en;
                 cdao:IAO_0000119 "WEB: http://davidmlane.com/hyperstat/A53638.html"@en;
                 cdao:IAO_0000232 "From Monnie's file comments - need to add moment calculation role but they doesn't exist yet - (editor note added by James Jan 2008)"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "kurtosis calculation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200078 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200086,
                                 cdao:OBI_0200184,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200180 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200125 cdao:IAO_0000111 "data combination"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A data transformation in which individual input data elements and values are merged together into a output set of data elements and values."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000118 "data pooling";
                 cdao:IAO_0000119 "editor"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "data combination"@en;
                 rdfs:subClassOf cdao:OBI_0200000,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200189 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200126 cdao:IAO_0000111 "network graph construction"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network analysis in which an input data set describing objects and relationships between objects is transformed into an output representation of these objects as nodes and the relationships as edges of a network graph."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "network graph construction"@en;
                 rdfs:subClassOf cdao:OBI_0200080.
cdao:OBI_0200127 cdao:IAO_0000111 "weighted network graph construction"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network graph construction in which an input data set describing objects and quantitative relationships between objects is transformed into and output representation of these objects as nodes and the quantitative relationships as weighted edges of a network graph."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "weighted network graph construction"@en;
                 rdfs:subClassOf cdao:OBI_0200126.
cdao:OBI_0200128 cdao:IAO_0000111 "directed network graph construction"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network graph construction in which an input data set describing objects and directional relationships between objects is transformed into and output representation of these objects as nodes and the directional relationships as directed edges of a network graph."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "directed network graph construction"@en;
                 rdfs:subClassOf cdao:OBI_0200126.
cdao:OBI_0200129 cdao:IAO_0000111 "node quality calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network analysis in which an input data set describing node objects and edge relationships between node objects is used to determine the output quality of one of the node objects in the network."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "node quality calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200080.
cdao:OBI_0200130 cdao:IAO_0000111 "node degree calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A node quality calculation in which an input data set describing object nodes and relationship edges between object nodes is used to enumerate the number of unique relationships of an individual object node."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "node degree calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200129.
cdao:OBI_0200131 cdao:IAO_0000111 "quantitative node degree calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A node quality calculation in which an input data set describing object nodes and quantitative relationship edges between object nodes is used to sum all of the quantitative relationships of an individual object node."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "quantitative node degree calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200129.
cdao:OBI_0200132 cdao:IAO_0000111 "node in-degree calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A node quality calculation in which an input data set describing object nodes and directional relationship edges between object nodes is used to enumerate the number of unique relationships pointing into an individual object node."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "node in-degree calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200129.
cdao:OBI_0200133 cdao:IAO_0000111 "node out-degree calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A node quality calculation in which an input data set describing object nodes and directional relationship edges between object nodes is used to enumerate the number of unique relationships pointing out of an individual object node."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "node out-degree calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200129.
cdao:OBI_0200134 cdao:IAO_0000111 "node shortest path identification"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A node quality calculation in which a path describing the shortest path needed to transverse through connected nodes and edges to arrive at a specific target node in the network."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "node shortest path identification"@en;
                 rdfs:subClassOf cdao:OBI_0200129.
cdao:OBI_0200135 cdao:IAO_0000111 "edge quality calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network analysis in which an input data set describing node objects and edge relationships between node objects is used to determine the output quality of one of the edge relationships in the network."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "edge quality calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200080.
cdao:OBI_0200136 cdao:IAO_0000111 "edge betweenness calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "An edge quality calculation in which the input is a data sets of shortest paths between all pairs of node in the network and the output is the sum of all shortest paths that traverse the specific edge."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "edge betweenness calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200135.
cdao:OBI_0200137 cdao:IAO_0000111 "network subgraph quality calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network analysis in which an input data set describing node objects and edge relationships between node objects is used to determine the output quality of a subgraph partition of the network."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "network subgraph quality calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200080.
cdao:OBI_0200138 cdao:IAO_0000111 "subgraph degree calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network subgraph quality calculation in which an input data set describing subgraphs and relationship edges between subgraphs and other network objects is used to enumerate the number of unique relationships of an individual subgraph."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "subgraph degree calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200137.
cdao:OBI_0200139 cdao:IAO_0000111 "quantitative subgraph degree calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network subgraph quality calculation in which an input data set describing subgraphs and quantitative relationship edges between subgraphs and other network objects is used to sum the quantitative relationships of an individual subgraph."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "quantitative subgraph degree calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200137.
cdao:OBI_0200140 cdao:IAO_0000111 "mathematical feature";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "feature is a (parent_class) that describes a characteristic, trait or quality of a data transformation"@en;
                 cdao:IAO_0000116 "This class is temporary and will be placed outside of data transformation ultimately (if it still remains at all after review)"@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000119 "PERSON: James Malone";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "mathematical feature"@en;
                 rdfs:subClassOf cdao:OBI_0200000.
cdao:OBI_0200141 cdao:IAO_0000111 "log base";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "The log base is a feature of a logarithmic function which is defined in http://en.wikipedia.org/wiki/Logarithm. Its value can be any positive real number different from 1.";
                 cdao:IAO_0000117 "Elisabetta Manduchi";
                 cdao:IAO_0000118 "logarithm base",
                                  "logarithmic base";
                 cdao:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Logarithm";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "log base"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:float ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000292 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200140.
cdao:OBI_0200143 cdao:IAO_0000111 "subgraph in-degree calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network subgraph quality calculation in which an input data set describing subgraphs and directional relationship edges between subgraphs and other network objects is used to enumerate the number of unique relationships pointing into an individual subgraph."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "subgraph in-degree calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200137.
cdao:OBI_0200144 cdao:IAO_0000111 "subgraph out-degree calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network subgraph quality calculation in which an input data set describing subgraphs and relationship edges between subgraphs and other network objects is used to enumerate the number of unique relationships pointing out of an individual subgraph."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "subgraph out-degree calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200137.
cdao:OBI_0200145 cdao:IAO_0000111 "intra subgraph connectivity calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network subgraph quality calculation in which an input data set describing internal nodes, edges and node degrees is used to determine the average node degree within the subgraph."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "intra subgraph connectivity calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200137.
cdao:OBI_0200146 cdao:IAO_0000111 "subgraph modularity calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network subgraph quality calculation in which an input data set of subgraph in-degree and out-degree qualities is used to calculate the ratio of indegree to outdegree as a measure of modularity."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "subgraph modularity calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200137.
cdao:OBI_0200147 cdao:IAO_0000111 "network graph quality calculation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A network analysis in which an input data set describing node objects and edge relationships between node objects is used to determine the output quality of the network as a whole."@en;
                 cdao:IAO_0000117 "Richard Scheuermann"@en;
                 cdao:IAO_0000119 "PERSON: Richard Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "network graph quality calculation"@en;
                 rdfs:subClassOf cdao:OBI_0200080.
cdao:OBI_0200149 cdao:IAO_0000111 "unit-variance scaling"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A unit-variance scaling is a data transformation that divides all measurements of a variable by the standard deviation of that variable."@en;
                 cdao:IAO_0000117 "Elisabetta Manduchi"@en,
                                  "Philippe Rocca-Serra"@en;
                 cdao:IAO_0000118 "autoscaling"@en;
                 cdao:IAO_0000119 "PMID:16762068"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "unit-variance scaling"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200167 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200169.
cdao:OBI_0200150 cdao:IAO_0000111 "MA transformation";
                 cdao:IAO_0000112 "MA transformations are typically used in microarray data analyses. In this context, the g_i and r_i represent the reporter intensities in the two channels of a 2-channel assay or the reporter intensities in two related one-channel assays. Typically the base used for the logarithm is 2.";
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "An MA transformation is a data transformation which takes as input a collection of data points (g_1, r_1), (g_2, r_2), ..., (g_n, r_n)  with the r_i and g_i positive real numbers, and whose output is the collection of data points (A_1, M_1), (A_2, M_2), ..., (A_n, M_n) where, for each i, A_i=(log(g_i)+log(r_i))/2 and M_i=log(r_i)-log(g_i). Here log denotes a logarithmic transformation.";
                 cdao:IAO_0000117 "Elisabetta Manduchi",
                                  "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "PERSON: Elisabetta Manduchi";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "MA transformation";
                 rdfs:subClassOf cdao:OBI_0200000.
cdao:OBI_0200151 cdao:IAO_0000111 "exponential base";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "The exponential base is a feature of an exponential function which is defined in http://en.wikipedia.org/wiki/Exponential_function. Its value can be any positive real number (typically different from 1).";
                 cdao:IAO_0000117 "Elisabetta Manduchi";
                 cdao:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Exponential_function";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "exponential base"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:float ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000292 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200140.
cdao:OBI_0200152 cdao:IAO_0000111 "polynomial degree";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "The polynomial degree is a feature of a polynomial function defined as the highest power of the polynomial's terms, where the terms of a polynomial are the individual summands with the coefficients omitted.";
                 cdao:IAO_0000117 "Elisabetta Manduchi";
                 cdao:IAO_0000119 "PERSON: Elisabetta Manduchi";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "polynomial degree"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000292 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200140.
cdao:OBI_0200153 cdao:IAO_0000111 "number of variables";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "The number of variables is a feature of any function (including polynomial functions) with domain contained in an n-dimensional vector space and is defined as n, the dimension of such space.";
                 cdao:IAO_0000117 "Elisabetta Manduchi";
                 cdao:IAO_0000119 "PERSON: Elisabetta Manduchi";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "number of variables"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:integer ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000292 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200140.
cdao:OBI_0200154 cdao:IAO_0000111 "agglomerative hierarchical clustering"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "An agglomerative hierarchical clustering is a hierarchical clustering which starts with separate clusters and then successively combines these clusters until there is only one cluster remaining."@en;
                 cdao:IAO_0000117 "Elisabetta Manduchi",
                                  "James Malone"@en;
                 cdao:IAO_0000118 "bottom-up hierarchical clustering";
                 cdao:IAO_0000119 "PERSON: Elisabetta Manduchi"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "agglomerative hierarchical clustering"@en;
                 rdfs:subClassOf cdao:OBI_0200042.
cdao:OBI_0200155 cdao:IAO_0000111 "divisive hierarchical clustering"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A divisive hierarchical clustering is a hierarchical clustering which starts with a single cluster and then successively splits resulting clusters until only clusters of individual objects remain."@en;
                 cdao:IAO_0000117 "Elisabetta Manduchi",
                                  "James Malone"@en;
                 cdao:IAO_0000118 "top-down hierarchical clustering";
                 cdao:IAO_0000119 "PERSON: Elisabetta Manduchi"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "divisive hierarchical clustering"@en;
                 rdfs:subClassOf cdao:OBI_0200042.
cdao:OBI_0200156 cdao:IAO_0000111 "data partitioning"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "Data partitioning is a data transformation with the objective of partitioning or separating input data into output subsets."@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000119 "PERSON: Ryan Brinkman"@en,
                                  "PERSON: Richard Scheuermann"@en,
                                  "PERSON: Melanie Courtot"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "data partitioning"@en;
                 rdfs:subClassOf cdao:OBI_0200000.
cdao:OBI_0200157 cdao:IAO_0000111 "data vector reduction objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "Data vector reduction is a data transformation objective in which k m-dimensional input vectors are reduced to j m-dimensional output vectors, where j is smaller than k."@en;
                 cdao:IAO_0000117 "Richard H. Scheuermann"@en,
                                  "James Malone";
                 cdao:IAO_0000119 "PERSON: Richard H. Scheuermann"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "data vector reduction objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0200160 cdao:IAO_0000111 "generalized family wise error rate correction method"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A generalized FWER correction method is a multiple testing procedure that controls the probability of at least k+1 false positives, where k is a user-supplied integer.";
                 cdao:IAO_0000117 "Monnie McGee";
                 cdao:IAO_0000118 "gFWER correction"@en;
                 cdao:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 19";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "generalized family wise error rate correction method"@en;
                 rdfs:subClassOf cdao:OBI_0200089,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000791 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200161 cdao:IAO_0000111 "quantile number of false positives correction method"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A quantile number of false positives correction method is a MTP that controls for the pth quantile of the distribution of the number of false positives out of the total number of tests performed'";
                 cdao:IAO_0000117 "Monnie McGee";
                 cdao:IAO_0000118 "QNFP"@en;
                 cdao:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 19";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "quantile number of false positives correction method"@en;
                 rdfs:subClassOf cdao:OBI_0200089,
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000662 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000791 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0200162 cdao:IAO_0000111 "tail probability for the proportion of false positives correction method"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A TPPFP correction method is a MTP that controls the probability that the proportion of false positives among all rejected hypotheses is no greater than a constant q, where q is between 0 and 1.";
                 cdao:IAO_0000117 "Monnie McGee";
                 cdao:IAO_0000118 "TPPFP correction method"@en;
                 cdao:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 20";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "tail probability for the proportion of false positives correction method"@en;
                 rdfs:subClassOf cdao:OBI_0200089,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000791 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200163 cdao:IAO_0000111 "false discovery rate correction method"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "The false discovery rate is a  data transformation used in multiple hypothesis testing to correct for multiple comparisons. It controls the expected proportion of incorrectly rejected null hypotheses (type I errors) in a list of rejected hypotheses. It is a less conservative comparison procedure with greater power than familywise error rate (FWER) control, at a cost of increasing the likelihood of obtaining type I errors. .";
                 cdao:IAO_0000116 """2011-03-31: [PRS]. 
creating a defined class by specifying the necessary output of dt
allows correct classification of FDR dt"""@en;
                 cdao:IAO_0000117 "Philippe Rocca-Serra"@en,
                                  "Monnie McGee";
                 cdao:IAO_0000118 "FDR correction method"@en;
                 cdao:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 21 and http://www.wikidoc.org/index.php/False_discovery_rate";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "false discovery rate correction method"@en;
                 rdfs:subClassOf cdao:OBI_0200089,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000791 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000175 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001442 ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200164 cdao:IAO_0000111 "proportion of expected false positives correction method"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A proportion of expected false positives correction method is a multiple testing procedure that controls the ratio of the expected value of the numbers of false positives to the expected value of the numbers of rejected hypotheses.";
                 cdao:IAO_0000117 "Monnie McGee";
                 cdao:IAO_0000118 "PEFP correction method"@en;
                 cdao:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 21";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "proportion of expected false positives correction method"@en;
                 rdfs:subClassOf cdao:OBI_0200089,
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000662 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000791 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0200165 cdao:IAO_0000111 "quantile proportion of false positives correction method"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A quantile proportion of false positives correction method is a multiple testing procedure that controls the pth quantile of the distribution of the proportion of false positives among the rejected hypothesis (false discovery rate).";
                 cdao:IAO_0000117 "Monnie McGee";
                 cdao:IAO_0000118 "QPFP correction method"@en;
                 cdao:IAO_0000119 "Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 21";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "quantile proportion of false positives correction method"@en;
                 rdfs:subClassOf cdao:OBI_0200089,
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000662 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000791 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0200166 cdao:IAO_0000111 "data transformation objective"@en;
                 cdao:IAO_0000112 "normalize objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An objective specification to transformation input data into output data"@en;
                 cdao:IAO_0000116 "Modified definition in 2013 Philly OBI workshop";
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000119 "PERSON: James Malone"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "data transformation objective"@en;
                 rdfs:subClassOf cdao:IAO_0000005.
cdao:OBI_0200167 cdao:IAO_0000111 "data normalization objective"@en;
                 cdao:IAO_0000112 """Quantile transformation which has normalization objective can be used for expression microarray assay normalization and it is referred to as \"quantile normalization\", according to the procedure described e.g. in PMID 12538238."""@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 """A normalization objective is a data transformation objective where the aim is to remove
systematic sources of variation to put the data on equal footing in order
to create a common base for comparisons."""@en;
                 cdao:IAO_0000117 "Helen Parkinson",
                                  "Elisabetta Manduchi",
                                  "James Malone"@en;
                 cdao:IAO_0000119 "PERSON: Helen Parkinson",
                                  "PERSON: James Malone"@en,
                                  "PERSON: Elisabetta Manduchi";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "data normalization objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0200168 cdao:IAO_0000111 "correction objective"@en;
                 cdao:IAO_0000112 "Type I error correction"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A correction objective is a data transformation objective where the aim is to correct for error, noise or other impairments to the input of the data transformation or derived from the data transformation itself"@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000119 "PERSON: James Malone",
                                  "PERSON: Melanie Courtot";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "correction objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0200169 cdao:IAO_0000111 "normalization data transformation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A normalization data transformation is a data transformation that has objective normalization."@en;
                 cdao:IAO_0000117 "James Malone";
                 cdao:IAO_0000119 "PERSON: James Malone"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "normalization data transformation"@en;
                 rdfs:subClassOf cdao:OBI_0200000;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000451 ; 
                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200167 ; 
                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0200170 cdao:IAO_0000111 "averaging data transformation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An averaging data transformation is a data transformation that has objective averaging."@en;
                 cdao:IAO_0000117 "James Malone";
                 cdao:IAO_0000119 "PERSON: James Malone"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "averaging data transformation"@en;
                 rdfs:subClassOf cdao:OBI_0200000;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000679 ; 
                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000425 ; 
                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0200171 cdao:IAO_0000111 "partitioning data transformation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A partitioning data transformation is a data transformation that has objective partitioning."@en;
                 cdao:IAO_0000117 "James Malone";
                 cdao:IAO_0000119 "PERSON: James Malone"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "partitioning data transformation"@en;
                 rdfs:subClassOf cdao:OBI_0200000;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200172 ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0200172 cdao:IAO_0000111 "partitioning objective"@en;
                 cdao:IAO_0000112 "A k-means clustering which has partitioning objective is a data transformation in which the input data is partitioned into k output sets."@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A partitioning objective is a data transformation objective where the aim is to generate a collection of disjoint non-empty subsets whose union equals a non-empty input set."@en;
                 cdao:IAO_0000117 "James Malone"@en,
                                  "Elisabetta Manduchi";
                 cdao:IAO_0000119 "PERSON: Elisabetta Manduchi";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "partitioning objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0200173 cdao:IAO_0000111 "background correction objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A background correction objective is a data transformation objective where the aim is to remove irrelevant contributions from the measured signal, e.g. those due to instrument noise or sample preparation."@en;
                 cdao:IAO_0000117 "James Malone"@en,
                                  "Elisabetta Manduchi";
                 cdao:IAO_0000119 "PERSON: Elisabetta Manduchi";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "background correction objective"@en;
                 rdfs:subClassOf cdao:OBI_0200168.
cdao:OBI_0200174 cdao:IAO_0000111 "curve fitting objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A curve fitting objective is a data transformation objective in which the aim is to find a curve which matches a series of data points and possibly other constraints."@en;
                 cdao:IAO_0000117 "James Malone"@en,
                                  "Elisabetta Manduchi";
                 cdao:IAO_0000119 "PERSON: Elisabetta Manduchi";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "curve fitting objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0200175 cdao:IAO_0000111 "class discovery data transformation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A class discovery data transformation (sometimes called unsupervised classification) is a data transformation that has objective class discovery."@en;
                 cdao:IAO_0000117 "James Malone";
                 cdao:IAO_0000118 "unsupervised classification data transformation",
                                  "clustering data transformation";
                 cdao:IAO_0000119 "PERSON: James Malone"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "class discovery data transformation"@en;
                 rdfs:subClassOf cdao:OBI_0200000;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000648 ; 
                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200178 ; 
                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0200176 cdao:IAO_0000111 "Fisher's exact test";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Fisher's exact test is a data transformation used to determine if there are nonrandom associations between two Fisher's exact test is a statistical significance test used in the analysis of contingency tables where sample sizes are small where the significance of the deviation from a null hypothesis can be calculated exactly, rather than relying on an approximation that becomes exact in the limit as the sample size grows to infinity, as with many statistical tests.";
                 cdao:IAO_0000117 "James Malone";
                 cdao:IAO_0000119 "WEB:http://mathworld.wolfram.com/FishersExactTest.html";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Fisher's exact test";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000675 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000673.
cdao:OBI_0200177 cdao:IAO_0000111 "center calculation objective"@en;
                 cdao:IAO_0000112 "A mean calculation which has center calculation objective is a data transformation in which the center of the input data is discovered through the calculation of a mean average."@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A center calculation objective is a data transformation objective where the aim is to calculate the center of an input data set."@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000119 "PERSON: James Malone";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "center calculation objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0200178 cdao:IAO_0000111 "class discovery objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A class discovery objective (sometimes called unsupervised classification) is a data transformation objective where the aim is to organize input data  (typically vectors of attributes) into classes, where the number of classes and their specifications are not known a priori. Depending on usage, the class assignment can be definite or probabilistic."@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000118 "discriminant analysis objective"@en,
                                  "clustering objective",
                                  "unsupervised classification objective"@en;
                 cdao:IAO_0000119 "PERSON: James Malone",
                                  "PERSON: Elisabetta Manduchi";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "class discovery objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0200179 cdao:IAO_0000111 "class prediction objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 """A class prediction objective (sometimes called supervised classification) is a data transformation objective where the aim is to create a predictor from training data through a machine learning technique. The training data consist of pairs of objects (typically vectors of attributes) and
class labels for these objects. The resulting predictor can be used to attach class labels to any valid novel input object. Depending on usage, the prediction can be definite or probabilistic. A classification is learned from the training data and can then be tested on test data."""@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000118 "classification objective",
                                  "supervised classification objective"@en;
                 cdao:IAO_0000119 "PERSON: Elisabetta Manduchi",
                                  "PERSON: James Malone";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "class prediction objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0200180 cdao:IAO_0000111 "spread calculation objective"@en;
                 cdao:IAO_0000112 "Spread calculation can be achieved by use of a standard deviation, which measures distance from the mean";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "is a data transformation objective whereby the aim is to the calculate the spread of a dataset, spread is a descriptive statistic which describes the variability of values in a data set ";
                 cdao:IAO_0000116 "Awaiting English definition from Monnie McGee"@en;
                 cdao:IAO_0000117 "Person:Helen Parkinson",
                                  "James Malone"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "spread calculation objective"@en;
                 rdfs:subClassOf cdao:OBI_0200166.
cdao:OBI_0200181 cdao:IAO_0000111 "center calculation data transformation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A center calculation data transformation is a data transformation that has objective of center calculation."@en;
                 cdao:IAO_0000117 "James Malone";
                 cdao:IAO_0000119 "PERSON: James Malone"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "center calculation data transformation"@en;
                 rdfs:subClassOf cdao:OBI_0200000;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000674 ; 
                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200177 ; 
                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0200182 cdao:IAO_0000111 "data vector reduction data transformation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A data vector reduction is a data transformation that has objective data vector reduction and that consists of reducing the input vectors k to a smaller number of output vectors j, where j<k."@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000119 "PERSON: James Malone"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "data vector reduction data transformation"@en;
                 rdfs:subClassOf cdao:OBI_0000707;
