cdao:SO_0000001 cdao:IAO_0000111 "region";
                cdao:IAO_0000115 "A sequence_feature with an extent greater than zero. A nucleotide region is composed of bases and a polypeptide region is composed of amino acids.";
                cdao:IAO_0000118 "sequence",
                                 "primary structure of sequence macromolecule";
                cdao:IAO_0000412 cdao:so.owl;
