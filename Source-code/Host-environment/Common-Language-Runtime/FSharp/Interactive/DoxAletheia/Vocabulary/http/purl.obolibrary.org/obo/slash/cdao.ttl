                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "ion exchange column"@en;
                 rdfs:subClassOf cdao:OBI_0000038.
cdao:OBI_0000561 cdao:IAO_0000111 "Bruker NMR probe"@en;
