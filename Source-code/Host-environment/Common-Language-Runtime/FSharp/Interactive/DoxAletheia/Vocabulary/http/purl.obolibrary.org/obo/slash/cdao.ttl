cdao:OBI_0002175 cdao:IAO_0000111 "ATP bioluminescence assay";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An analyte assay that detects ATP concentration through light intensity when luciferase catalyzes the oxidation of luciferin in the presence of ATP, magnesium ions, and molecular oxygen.";
                 cdao:IAO_0000117 "Rebecca Tauber";
                 cdao:IAO_0000118 "cell viability ATP quantitation assay",
                                  "ATP quantitation assay";
                 cdao:IAO_0000119 "ECO";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "ATP bioluminescence assay";
