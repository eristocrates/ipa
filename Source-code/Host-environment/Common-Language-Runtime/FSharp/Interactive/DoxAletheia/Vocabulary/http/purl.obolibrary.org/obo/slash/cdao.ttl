cdao:OBI_0000210 cdao:IAO_0000111 "analytical cytology data file"@en;
                 cdao:IAO_0000112 "FCS file, ACS file, foo.fcs, foo.asc"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A digital entity intended to capture data in analytical cytology domain."@en;
