cdao:UO_0000041 cdao:IAO_0000111 "nanomole";
                cdao:IAO_0000115 "A substance unit equal to one thousandth of one millionth of a mole or 10^[-9] mol.";
                cdao:IAO_0000118 "nmol";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000006,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "nanomole".
cdao:UO_0000042 cdao:IAO_0000111 "picomole";
                cdao:IAO_0000115 "A substance unit equal to 10^[-12] mol.";
                cdao:IAO_0000118 "pmol";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000006,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "picomole".
cdao:UO_0000051 cdao:IAO_0000111 "concentration unit";
                cdao:IAO_0000115 "A unit which represents a standard measurement of how much of a given substance there is mixed with another substance.";
                cdao:IAO_0000412 cdao:uo.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "concentration unit";
                rdfs:subClassOf cdao:IAO_0000003.
cdao:UO_0000062 cdao:IAO_0000111 "molar";
                cdao:IAO_0000115 "A unit of concentration which expresses a concentration of 1 mole of solute per liter of solution (mol/L).";
                cdao:IAO_0000118 "M";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "molar".
cdao:UO_0000063 cdao:IAO_0000111 "millimolar";
                cdao:IAO_0000115 "A unit of molarity which is equal to one thousandth of a molar or 10^[-3] M.";
                cdao:IAO_0000118 "mM";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "millimolar".
cdao:UO_0000064 cdao:IAO_0000111 "micromolar";
                cdao:IAO_0000115 "A unit of molarity which is equal to one millionth of a molar or 10^[-6] M.";
                cdao:IAO_0000118 "uM";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "micromolar".
cdao:UO_0000065 cdao:IAO_0000111 "nanomolar";
                cdao:IAO_0000115 "A unit of molarity which is equal to one thousandth of one millionth of a molar or 10^[-9] M.";
                cdao:IAO_0000118 "nM";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "nanomolar".
cdao:UO_0000066 cdao:IAO_0000111 "picomolar";
                cdao:IAO_0000115 "A unit of molarity which is equal to 10^[-12] M.";
                cdao:IAO_0000118 "pM";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "picomolar".
cdao:UO_0000095 cdao:IAO_0000111 "volume unit";
                cdao:IAO_0000115 "A unit which is a standard measure of the amount of space occupied by any substance, whether solid, liquid, or gas.";
                cdao:IAO_0000412 cdao:uo.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "volume unit";
                rdfs:subClassOf cdao:IAO_0000003.
cdao:UO_0000097 cdao:IAO_0000111 "cubic centimeter";
                cdao:IAO_0000115 "A volume unit which is equal to one millionth of a cubic meter or 10^[-9] m^[3], or to 1 ml.";
                cdao:IAO_0000118 "cc";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000095,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "cubic centimeter".
cdao:UO_0000098 cdao:IAO_0000111 "milliliter";
                cdao:IAO_0000115 "A volume unit which is equal to one thousandth of a liter or 10^[-3] L, or to 1 cubic centimeter.";
                cdao:IAO_0000118 "ml";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000095,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "milliliter".
cdao:UO_0000099 cdao:IAO_0000111 "liter";
                cdao:IAO_0000115 "A volume unit which is equal to one thousandth of a cubic meter or 10^[-3] m^[3], or to 1 decimeter.";
                cdao:IAO_0000118 "L";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000095,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "liter".
cdao:UO_0000100 cdao:IAO_0000111 "cubic decimeter";
                cdao:IAO_0000115 "A volume unit which is equal to one thousand of a cubic meter or 10^[-3] m^[3], or to 1 L.";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000095,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "cubic decimeter".
cdao:UO_0000101 cdao:IAO_0000111 "microliter";
                cdao:IAO_0000115 "A volume unit which is equal to one millionth of a liter or 10^[-6] L.";
                cdao:IAO_0000118 "ul";
