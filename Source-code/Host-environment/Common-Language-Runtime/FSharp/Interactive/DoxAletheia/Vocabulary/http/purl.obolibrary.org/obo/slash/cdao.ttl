                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:BFO_0000023.
cdao:OBI_1110084 cdao:IAO_0000111 "effector T cell function";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "The function inhering in a T cell that is realized in an immune response that results from the T cell receptor binding to the MHC:epitope complex."@en;
                 cdao:IAO_0000117 "IEDB"@en;
                 cdao:IAO_0000119 "IEDB"@en;
