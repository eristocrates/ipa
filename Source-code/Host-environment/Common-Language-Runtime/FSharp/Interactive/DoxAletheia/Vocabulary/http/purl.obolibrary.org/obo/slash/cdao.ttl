cdao:OBI_0002077 cdao:IAO_0000111 "specimens derived from shared ancestor"@en;
                 cdao:IAO_0000112 "Aliquoting one specimen to multiple tubes and the collection of the aliquoted specimens are a specimen family. Slicing a tissue specimen into multiple sections for microscopy."@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A collection of specimens derived from one common specimen via one or more material processing process(es)."@en;
                 cdao:IAO_0000116 "Details see tracker: https://sourceforge.net/p/obi/obi-terms/778/";
                 cdao:IAO_0000117 "Chris Stoeckert, Jie Zheng"@en;
                 cdao:IAO_0000118 "specimen family"@en;
                 cdao:IAO_0000119 "Duke Biobank, OBIB, OBI"@en;
                 <http://purl.org/dc/elements/1.1/source> "Biobank";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "specimens derived from shared ancestor"@en;
                 rdfs:subClassOf cdao:OBI_0002076.
cdao:OBI_0002078 cdao:IAO_0000111 "specimen set collection process"@en;
                 cdao:IAO_0000112 "Collection of both blood and urine specimens in one clinical visit; Taking out liver and brain specimens during an autopsy."@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A specimen collection process that generates multiple specimens from one source (e.g. one organism) during a time period which for the purpose of the study can be considered to be taken at the same sampling time."@en;
                 cdao:IAO_0000117 "Chris Stoeckert, Jie Zheng"@en;
                 cdao:IAO_0000119 "OBIB, OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "specimen set collection process"@en;
                 rdfs:subClassOf cdao:OBI_0000659.
