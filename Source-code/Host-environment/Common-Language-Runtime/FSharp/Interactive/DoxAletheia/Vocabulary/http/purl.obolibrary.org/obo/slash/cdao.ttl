cdao:OBI_0000208 cdao:IAO_0000111 "methodology testing objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Methodology_testing_objective is an objective role carried out by a proposition defining the aim of the study is to examine the effect of using different methodologies."@en;
                 cdao:IAO_0000117 "Jennifer Fostel"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
