cdao:OBI_0000867 cdao:IAO_0000111 "establishing cancer cell line";
                 cdao:IAO_0000112 "Establishment of HeLa immortal cell line";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "is a planned process in which the objective is to generate a cell line from a natural population of cancer cells which are already immortal";
                 cdao:IAO_0000119 "";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Helen Parkinson";
                 rdfs:label "establishing cancer cell line";
                 rdfs:subClassOf cdao:OBI_0001867,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001906 ; 
