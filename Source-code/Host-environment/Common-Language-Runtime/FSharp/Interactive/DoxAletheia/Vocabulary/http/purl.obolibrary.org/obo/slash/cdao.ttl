cdao:OBI_0001937 cdao:IAO_0000111 "has specified numeric value";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A relation between a value specification and a number that quantifies it.";
                 cdao:IAO_0000116 "A range of 'real' might be better than 'float'. For now we follow 'has measurement value' until we can consider technical issues with SPARQL queries and reasoning.";
                 cdao:IAO_0000117 "PERSON: James A. Overton";
                 cdao:IAO_0000119 "OBI";
                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain cdao:OBI_0001933;
                 rdfs:label "has specified numeric value";
                 rdfs:range <http://www.w3.org/2002/07/owl#real>;
                 rdfs:subPropertyOf cdao:OBI_0002135.
