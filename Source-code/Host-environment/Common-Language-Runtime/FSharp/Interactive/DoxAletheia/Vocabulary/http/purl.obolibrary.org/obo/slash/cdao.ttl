                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0001961 cdao:IAO_0000111 "PCR program"@en;
                 cdao:IAO_0000112 "https://www.neb.com/protocols/1/01/01/taq-dna-polymerase-with-standard-taq-buffer-m0273"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "a PCR program is a plan specification which is executed during a polymerase chain reaction (PCR) by a thermocycler instrument that will iterate through the changes in temperature and duration of each of the annealing, denaturation, elongation steps for as many times as specified by the program."@en;
                 cdao:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en;
                 cdao:IAO_0000119 "OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "PCR program"@en;
                 rdfs:subClassOf cdao:IAO_0000104.
cdao:OBI_0001962 cdao:IAO_0000111 "target gene specification"@en;
                 cdao:IAO_0000112 """http://www.ncbi.nlm.nih.gov/pubmed/25367129

\"performing a profiling of microbial phylogenetic composition using sequencing of 16S rRNA gene (used as target gene)"""@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "is a directive information specifying a coding genomic region which is the focus of a planned process such as an assay, for instance in a environmental gene survey"@en;
                 cdao:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en;
                 cdao:IAO_0000119 "PRS for OBI"@en;
                 cdao:OBI_0001847 "target gene"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "target gene specification"@en;
                 rdfs:subClassOf cdao:IAO_0000033.
cdao:OBI_0001963 cdao:IAO_0000111 "target subfragment specification"@en;
                 cdao:IAO_0000112 """http://www.ncbi.nlm.nih.gov/pubmed/23335919

\"performing a profiling of microbial phylogenetic composition using massively-parallel pyrotag sequencing targeting the V9 hypervariable region (used as target subfragment) of the 18S ribosomal RNA (rRNA) gene (used as target gene)"""@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "is a directive information specifying a genomic region, possibly located in a coding genomic region, which is the focus of a planned process such as an assay, for instance in a environmental gene survey"@en;
                 cdao:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en;
                 cdao:IAO_0000119 "PRS for OBI"@en;
                 cdao:OBI_0001847 "target subfragment"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "target subfragment specification"@en;
                 rdfs:subClassOf cdao:IAO_0000033.
cdao:OBI_0001964 cdao:IAO_0000111 "decision-theoretic analysis objective";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An objective specification which what includes a description of two or more alternative actions to take in a particular situation and a metric that enables comparisons of the two actions. The objective specified is achieved in a planned process which includes a data transformation, the output of which is an identification of the 'best' choice according to the metric.";
                 cdao:IAO_0000116 "The best action to take is typically defined as the one that maximizes expected utility.";
                 cdao:IAO_0000117 "PERSON: Bill Hogan";
                 cdao:IAO_0000118 "decision analysis objective";
                 cdao:IAO_0000119 "PERSON: Bill Hogan";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "decision-theoretic analysis objective";
                 rdfs:subClassOf cdao:IAO_0000005.
cdao:OBI_0001965 cdao:IAO_0000111 "decision analysis study design";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a study design that has a decision analysis objective specification as part";
                 cdao:IAO_0000117 "PERSON: Bill Hogan";
                 cdao:IAO_0000119 "PERSON: Bill Hogan";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "decision analysis study design";
                 rdfs:subClassOf cdao:OBI_0500000;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0500000
                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001964 ; 
                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0001966 cdao:IAO_0000111 "sequence library data demultiplexing"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "is a data transformation which uses sequence alignment and  'multiplex identifier sequence' information to separate all reads belonging to a given single sample following the sequencing of a multiplexed library"@en;
                 cdao:IAO_0000117 "PERSON: Philippe Rocca-Serra"@en;
                 cdao:IAO_0000119 "PRS for OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "sequence library data demultiplexing"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200081 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0200187.
cdao:OBI_0001967 cdao:IAO_0000111 "multiplexing sequence identifier"@en;
                 cdao:IAO_0000112 "We designed primers specifically to amplify protease and reverse transcriptase from Brazilian HIV subtypes and developed a multiplexing scheme using multiplex identifier tags to minimize cost while providing more robust data than traditional genotyping techniques. in http://www.ncbi.nlm.nih.gov/pubmed/22574170"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "A multiplexing sequence identifier is a nucleic acid sequence which is used in a ligation step of library preparation process to allow pooling of samples while maintaining ability to identify individual source material and creation of a multiplexed library"@en;
                 cdao:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en;
                 cdao:IAO_0000119 "OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "multiplexing sequence identifier"@en;
                 rdfs:subClassOf cdao:CHEBI_16991,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0000711
                                                                                                                                  cdao:OBI_0001959) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000295 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0001968 cdao:IAO_0000111 "operational taxonomic unit matrix"@en;
                 cdao:IAO_0000112 "http://www.ncbi.nlm.nih.gov/pmc/articles/PMC1610290/"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 """Operational Taxonomic Unit matrix  is a data item, organized as a table, where organismal taxonomic units, computed by sequence analysis and genetic distance calculation, are counted in a set of biological or environmental samples. The table is  used to appraise biodiversity of a population or community of living organism.
"""@en;
                 cdao:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en;
                 cdao:IAO_0000119 "PRS for OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "operational taxonomic unit matrix"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200000 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000027,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:BFO_0000040 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000136 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0001969 cdao:IAO_0000111 "biodiversity assessment objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "biodiversity assessment objective is an objective of a planned process aimed at producing data item whose interpretation should provide insight about variety of biological species found in a biological sample at macroscopic or microscopic level"@en;
                 cdao:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en;
                 cdao:IAO_0000119 "PRS for OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "biodiversity assessment objective"@en;
                 rdfs:subClassOf cdao:OBI_0000015.
cdao:OBI_0001970 cdao:IAO_0000111 "multiplexed sequencing library"@en;
                 cdao:IAO_0000112 """http://www.ncbi.nlm.nih.gov/pubmed/24997861

Nat Methods. 2014 Aug;11(8):834-40. doi: 10.1038/nmeth.3022. Epub 2014 Jul 6.
Accelerated chromatin biochemistry using DNA-barcoded nucleosome libraries."""@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "a multiplexed library is a material entity which is the output of a library preparation process that uses a ligation step to attach a unique multiplexing sequence identifier to a specific sample, then mixes several such tagged samples prior to the library amplification process proper. A multiplexed library allows the sequencing of several samples in one sequencing run."@en;
                 cdao:IAO_0000117 "PERSON:Philippe Rocca-Serra"@en;
                 cdao:IAO_0000118 "DNA-barcoded sequencing library"@en;
                 cdao:IAO_0000119 "PRS for OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "multiplexed sequencing library"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0000711
                                                                                                                                  cdao:OBI_0001959) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000047,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001967 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0001971 cdao:IAO_0000111 "Ion 316 Chip v2"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 """An ion semiconductor chip manufactured by Life Technologies which detects polymerase-driven base incorporation to translate into digital form. The 316 chip is compatible with the Ion Torrent PGM and has a run time of:

3.0 hours for 200 bp reads with an output of 30-50 Mb,
4.9 hours for 400 bp reads with an output of 60 Mb-1 Gb."""@en;
                 cdao:IAO_0000116 """Issue Tracker #774
https://sourceforge.net/p/obi/obi-terms/774/"""@en;
                 cdao:IAO_0000117 "PERSON: Sagar Jain"@en;
                 cdao:IAO_0000118 "Ion 316 Chip"@en,
                                  "Ion PGM 316 Chip v2"@en,
                                  "Ion PGM 316 Chip"@en;
                 cdao:IAO_0000119 "http://www.lifetechnologies.com/us/en/home/life-science/sequencing/next-generation-sequencing/ion-torrent-next-generation-sequencing-workflow/ion-torrent-next-generation-sequencing-run-sequence/ion-pgm-ion-proton-system-chips.html";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Ion 316 Chip v2"@en;
                 rdfs:subClassOf cdao:OBI_0001973.
cdao:OBI_0001972 cdao:IAO_0000111 "Ion 318 Chip v2"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 """An ion semiconductor chip manufactured by Life Technologies which detects polymerase-driven base incorporation to translate into digital form. The 318 chip is compatible with the Ion Torrent PGM and has a run time of:

4.4 hours for 200 bp reads with an output of 60 Mb-1 Gb,
7.3 hours for 400 bp reads with an output of 1.2 Gb-2 Gb."""@en;
