cdao:OBI_0000627 cdao:IAO_0000111 "quaternary pump system"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A pump system that pump and mix up to four different solvents in parallel."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01047",
                                  "GROUP:<http://msi-ontology.sourceforge.net>"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "quaternary pump system"@en;
                 rdfs:subClassOf cdao:OBI_0000589.
cdao:OBI_0000628 cdao:IAO_0000111 "carbon nanotube column"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Carbon nanotubes (CNTs) are known to have high thermal and mechanical stability and have the potential to be high-performance separation media that utilize the nanoscale interactions. CNT can be applied in long capillary tubes for the development of gas chromatography columns. A film of CNTs can be deposited by chemical vapor deposition (CVD) to form the stationary phase in the open tubular format. Altering the CVD conditions can vary the thickness and the morphology of the CNT film, which opens the possibility of selectivity tuning. The ability to fabricate long tubes coated with CNTs can be readily employed in other gas- and liquid-phase separations as well."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01107",
                                  "WEB:<http://pubs.acs.org/cgi-bin/abstract.cgi/ancham/2005/77/i21/abs/ac050812j.html>"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "carbon nanotube column"@en;
                 rdfs:subClassOf cdao:OBI_0000038.
cdao:OBI_0000629 cdao:IAO_0000111 "Bruker solid magic angle spinning probe"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Magic angle spinning, nowadays a routine technique for solids NMR, still offers the capability of innovation. The high mechanical performance of MAS probes in conjunction with efficient rf pulse techniques open new exciting fields in solids NMR of biological samples and in the field of quadrupolar nuclei."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000118 "solid MAS probe"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400193",
                                  "GROUP:<http://msi-ontology.sourceforge.net>"@en;
                 cdao:IAO_0000232 "NMR probe"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Bruker solid magic angle spinning probe"@en;
                 rdfs:subClassOf cdao:OBI_0000561.
cdao:OBI_0000630 cdao:IAO_0000111 "hematology assay";
                 cdao:IAO_0000112 "Co-associations between insulin sensitivity and measures of liver function, subclinical inflammation, and hematology._PMID:18702943";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An assay that studies blood and blood producing organs using a variety of techniques and instruments";
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000118 "blood analysis",
                                  "haematology";
                 cdao:IAO_0000119 "OBI branch derived";
