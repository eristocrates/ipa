                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A small membrane filter of defined pore size, that filters samples from a syringe."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01122",
