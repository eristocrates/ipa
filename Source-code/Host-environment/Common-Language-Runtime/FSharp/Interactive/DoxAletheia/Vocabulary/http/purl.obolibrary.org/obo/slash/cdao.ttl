                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000055 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0001175 cdao:IAO_0000111 "selective organism creation objective"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "an objective specification to generate a population or type of organism within species that have some uniform behavioral, morphological, physiological, or genetic characteristics with similarly bred organisms.";
                 cdao:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng";
                 cdao:IAO_0000119 """WEB: wikipedia
http://en.wikipedia.org/wiki/Cultivar
http://en.wikipedia.org/wiki/Ecotype
http://en.wikipedia.org/wiki/Strain_%28biology%29""";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "selective organism creation objective"@en;
                 rdfs:subClassOf cdao:IAO_0000005.
cdao:OBI_0001176 cdao:IAO_0000111 "Individual epitope immunization in vivo";
                 cdao:IAO_0000112 "Injection of a peptide T cell epitope into a mouse";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An immunization in which an individual epitope is administered into a host organism. ";
                 cdao:IAO_0000116 "3/16/11 BP: This should have as a logical definition the exclusion that the immunogen cannot be something beyond the epitope itself. I don't know if that is possible to do here. ";
                 cdao:IAO_0000117 "PERSON:Bjoern Peters, Jason Greenbaum, Randi Vita";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Individual epitope immunization in vivo";
                 rdfs:subClassOf cdao:OBI_1110015.
