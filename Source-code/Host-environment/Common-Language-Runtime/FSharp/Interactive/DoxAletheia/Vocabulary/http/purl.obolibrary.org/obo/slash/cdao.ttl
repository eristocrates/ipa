cdao:OBI_0002428 cdao:IAO_0000111 "BMI range inclusion criterion";
                 cdao:IAO_0000112 "An important inclusion criterion is for for the individual to have a BMI between 18.5 and 35.0";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An inclusion criterion that defines and states a Body Mass Index range, which if met, makes an individual suitable for a given task or participation in a given process.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "NCI BBRB, OBIB";
                 cdao:IAO_0000234 "NCI BBRB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "BMI range inclusion criterion";
                 rdfs:subClassOf cdao:OBI_0500027.
cdao:OBI_0002429 cdao:IAO_0000111 "blood transfusion exclusion criterion";
                 cdao:IAO_0000112 "An exclusion criterion that is defined by whether the specimen donor received a whole blood transfusion within 48 hours prior to death.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An exclusion criterion that is defined by whether the specimen donor received a whole blood transfusion within a specified time frame prior to death, which if met, makes a specimen donor unsuitable for a given task or participation in a given process.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "NCI BBRB, OBIB";
                 cdao:IAO_0000234 "NCI BBRB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "blood transfusion exclusion criterion";
                 rdfs:subClassOf cdao:OBI_0500028.
cdao:OBI_0002430 cdao:IAO_0000111 "history of metastatic cancer exclusion criterion";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An exclusion criterion defined as whether an individual has ever been diagnosed with metastatic cancer (cancer that spread beyond the initial site such as to other organs like brain bone or liver), which if met, makes the individual unsuitable for a given task or participation in a given process.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "NCI BBRB, OBIB";
                 cdao:IAO_0000234 "NCI BBRB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "history of metastatic cancer exclusion criterion";
                 rdfs:subClassOf cdao:OBI_0500028.
cdao:OBI_0002431 cdao:IAO_0000111 "intravenous drug use exclusion criterion";
                 cdao:IAO_0000112 "Donor eligibility based on history of intravenous drug abuse in the last 5 years.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An exclusion criterion defined as when an individual has a history of intravenous drug abuse for a specific timeframe, which if met, makes the individual unsuitable for a given task or participation in a given process.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "NCI BBRB, OBIB";
                 cdao:IAO_0000234 "NCI BBRB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "intravenous drug use exclusion criterion";
                 rdfs:subClassOf cdao:OBI_0500028.
cdao:OBI_0002432 cdao:IAO_0000111 "history of sex with someone with a history of blood borne infection  exclusion criterion";
                 cdao:IAO_0000112 "Donor eligibility based on whether the donor has a history of sex with someone who has been diagnosed or at risk for HIV/AIDS and/or HCV and/or HBV in the last 5 years.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An exclusion criterion defined  as whether an individual has a history of sex with someone who has been diagnosed or at risk for a blood borne infections disease in a specified time frame, which if met, makes the individual unsuitable for a given task or participation in a given process.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "NCI BBRB, OBIB";
                 cdao:IAO_0000234 "NCI BBRB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "history of sex with someone with a history of blood borne infection  exclusion criterion";
                 rdfs:subClassOf cdao:OBI_0500028.
cdao:OBI_0002433 cdao:IAO_0000111 "history of sex with someone with a history of intravenous drugs exclusion criterion";
                 cdao:IAO_0000112 "Donor eligibility based on whether the donor has a history of sex with someone who has used intravenous drugs in the last 5 years.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An exclusion criterion defined  as whether an individual has a history of sex with someone who has used intravenous drugs in a specified time frame, which if met, makes the individual unsuitable for a given task or participation in a given process.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "NCI BBRB, OBIB";
                 cdao:IAO_0000234 "NCI BBRB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "history of sex with someone with a history of intravenous drugs exclusion criterion";
                 rdfs:subClassOf cdao:OBI_0500028.
cdao:OBI_0002434 cdao:IAO_0000111 "HIV exclusion criterion";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An exclusion criterion defined  as whether an individual has a history of repeatedly reactive screening assays for HIV-1 or HIV-2 antibody regardless of the results of supplemental assays, which if met, makes the individual unsuitable for a given task or participation in a given process. ";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "NCI BBRB, OBIB";
                 cdao:IAO_0000234 "NCI BBRB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "HIV exclusion criterion";
                 rdfs:subClassOf cdao:OBI_0500028.
cdao:OBI_0002435 cdao:IAO_0000111 "exposure to blood borne infectious disease exclusion criterion";
                 cdao:IAO_0000112 "Donor eligibility based on whether the donor has been exposed to HIV/AIDS. ";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An exclusion criterion defined  as whether an individual has been exposed to a blood borne infections disease through needle sticks and/or contact with non-intact skin and/or contact with open wounds and/or contact with mucous membranes, which if met, makes the individual unsuitable for a given task or participation in a given process.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "NCI BBRB, OBIB";
                 cdao:IAO_0000234 "NCI BBRB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "exposure to blood borne infectious disease exclusion criterion";
                 rdfs:subClassOf cdao:OBI_0500028.
cdao:OBI_0002436 cdao:IAO_0000111 "RNA interactome capture";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An assay that identifies RNA binding proteins by cross-linking RNA and proteins with UV light, then purifying the bound complexes by oligo(dT) capture. Finally, the complexes are analyzed by mass spectrometry.";
                 cdao:IAO_0000117 "Rebecca Tauber";
                 cdao:IAO_0000119 "PMID:26463381";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "RNA interactome capture";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000470 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000070.
cdao:OBI_0002437 cdao:IAO_0000111 "widefield microscopy";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A fluorescence microscopy technique where the specimen under investigation is fully bathed in light, as opposed to confocal microscopy in which only a small portion of the specimen is illuminated.";
                 cdao:IAO_0000117 "Jie Zheng";
                 cdao:IAO_0000118 "WFM";
                 cdao:IAO_0000119 "url:http://bitesizebio.com/19409/the-many-flavors-of-widefield-microscopy/",
                                  "url:https://svi.nl/WideFieldMicroscope";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "widefield microscopy";
                 rdfs:subClassOf cdao:CHMO_0000087.
cdao:OBI_0002438 cdao:IAO_0000111 "nuclear ligation assay";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An assay that detects the proximity of chromosomal DNA through the use of a ligation reaction in isolated nuclei.";
                 cdao:IAO_0000117 "Chris S";
                 cdao:IAO_0000119 "PMID:8327891";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "nuclear ligation assay";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001398 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000070,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:PR_000023089 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0002439 cdao:IAO_0000111 "chromosome conformation capture assay";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A nuclear ligation assay that detects chromosomal interactions between any two genomic loci. Chromatin segments are cross-linked, cut by restriction enzymes, ligated, and finally analyzed by PCR.";
                 cdao:IAO_0000117 "Chris S";
                 cdao:IAO_0000118 "3C assay";
                 cdao:IAO_0000119 "url:http://www.nature.com/nprot/journal/v2/n7/full/nprot.2007.243.html",
                                  "PMID:11847345";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "chromosome conformation capture assay";
                 rdfs:subClassOf cdao:OBI_0002438,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0001917 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000417 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0002440 cdao:IAO_0000111 "Hi-C assay";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A chromosome conformation capture assay that detects genome-wide chromosomal interactions. High-throughput techniques are used to sequence the ligated fragments after cross-linking and cutting with restriction enzymes.";
                 cdao:IAO_0000117 "Chris S";
                 cdao:IAO_0000119 "PMID:20461051";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Hi-C assay";
                 rdfs:subClassOf cdao:OBI_0002439.
cdao:OBI_0002441 cdao:IAO_0000111 "physical examination of individual";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An assay that produces a description of the qualities of an entity that has not been transformed, through observation and physical, non-invasive techniques.";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "physical examination of individual";
                 rdfs:subClassOf cdao:OBI_0000070.
cdao:OBI_0002442 cdao:IAO_0000111 "hydroxyl-radical footprinting assay";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A footprinting assay that uses the reaction of hydroxyl radicals with side-chain sites in molecules (proteins, DNA, etc)_ with the resultant mass shift demonstrating the site of modification, used to_ to asses the accessibility of that site.";
                 cdao:IAO_0000117 "Jie Zheng";
                 cdao:IAO_0000119 "PMID:21770468";
                 a <http://www.w3.org/2002/07/owl#Class>;
