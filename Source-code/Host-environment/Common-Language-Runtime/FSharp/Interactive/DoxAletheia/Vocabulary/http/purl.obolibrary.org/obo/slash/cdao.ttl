cdao:CLO_0000018 cdao:IAO_0000111 "mortal cell line cell";
                 cdao:IAO_0000115 "A cell line cell that is capable of replicating a limited number of times in culture before undergoing senescence.";
                 cdao:IAO_0000412 cdao:clo.owl;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "mortal cell line cell";
                 rdfs:subClassOf cdao:CLO_0000001.
cdao:CLO_0000019 cdao:IAO_0000111 "immortal cell line cell";
                 cdao:IAO_0000115 "A cell line cell that is expected to be capable of an unlimited number of divisions, and is thus able to support indefinite propagation in vitro as part of an immortal cell line.";
                 cdao:IAO_0000412 cdao:clo.owl;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "immortal cell line cell";
                 rdfs:subClassOf cdao:CLO_0000001.
cdao:CLO_0000031 cdao:IAO_0000111 "cell line"@en;
                 cdao:IAO_0000115 """A cultured cell population that represents a genetically stable and homogenous population of cultured cells that shares a common propagation history (i.e. has been successively passaged together in culture).  
""",
                                  "A cultured cell population that represents a genetically stable and homogenous population of cultured cells that shares a common propagation history (i.e. has been successively passaged together in culture). "@en;
                 cdao:IAO_0000412 cdao:clo.owl;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "cell line"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> cdao:CLO_0000001 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000643 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:CLO_0000001 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000643 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0001905.
cdao:CLO_0009828 cdao:IAO_0000111 "immortal cell line"@en;
                 cdao:IAO_0000115 "A cell line that is expected to be capable of indefinite propagation in an vitro culture.";
                 cdao:IAO_0000412 cdao:clo.owl;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "immortal cell line"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> cdao:CLO_0000019 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000643 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:CLO_0000019 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000643 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:CLO_0000031.
cdao:CLO_0009829 cdao:IAO_0000111 "mortal cell line"@en;
                 cdao:IAO_0000115 "A cell line is able to support only a limited number of passages in vitro.";
                 cdao:IAO_0000412 cdao:clo.owl;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "mortal cell line"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onClass> cdao:OBI_0000877 ; 
                                  <http://www.w3.org/2002/07/owl#qualifiedCardinality> "0"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> cdao:CLO_0000018 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000643 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:CLO_0000018 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000643 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:CLO_0000031.
cdao:CL_0000000 cdao:IAO_0000111 "cell",
                                 "cell"@en;
                cdao:IAO_0000112 """PMID:18089833.Cancer Res. 2007 Dec 15;67(24):12018-25. \"...Epithelial cells were harvested from histologically confirmed adenocarcinomas ..\""""@en;
                cdao:IAO_0000115 "A material entity of anatomical origin (part of or deriving from an organism) that has as its parts a maximally connected cell compartment surrounded by a plasma membrane.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "cell",
                           "cell"@en;
                rdfs:subClassOf cdao:BFO_0000040.
cdao:CL_0000001 cdao:IAO_0000111 "primary cultured cell";
                cdao:IAO_0000115 "A cultured cell that is freshly isolated from a organismal source, or derives in culture from such a cell prior to the culture being passaged.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "primary cultured cell";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#complementOf> [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:CL_0000010
                                                                                                                                                                               [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0600037 ; 
                                                                                                                                                                               <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
                                                                                                                                                                               a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                               a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                               <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0001000 ; 
                                                                               a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                 a <http://www.w3.org/2002/07/owl#Class>],
                                [<http://www.w3.org/2002/07/owl#complementOf> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0600037 ; 
                                                                               <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
                                                                               a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                 a <http://www.w3.org/2002/07/owl#Class>],
                                cdao:CL_0000010.
cdao:CL_0000003 cdao:IAO_0000111 "native cell";
                cdao:IAO_0000115 "A cell that is found in a natural setting, which includes multicellular organism cells 'in vivo' (i.e. part of an organism), and unicellular organisms 'in environment' (i.e. part of a natural environment).";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "native cell";
                rdfs:subClassOf cdao:CL_0000000.
cdao:CL_0000010 cdao:IAO_0000111 "cultured cell";
                cdao:IAO_0000115 "A cell in vitro that is or has been maintained or propagated as part of a cell culture.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "cultured cell";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0600036 ; 
                                                                          <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                          [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0600036 ; 
                                                                                                                          <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
                                                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                                                          <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0001000 ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>],
                                cdao:CL_0000578.
cdao:CL_0000057 cdao:IAO_0000111 "fibroblast";
                cdao:IAO_0000115 "A connective tissue cell which secretes an extracellular matrix rich in collagen and other macromolecules. Flattened and irregular in outline with branching processes; appear fusiform or spindle-shaped.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "fibroblast";
                rdfs:subClassOf cdao:CL_0000000.
cdao:CL_0000066 cdao:IAO_0000111 "epithelial cell";
                cdao:IAO_0000115 "A cell that is usually found in a two-dimensional sheet with a free surface. The cell has a cytoskeleton that allows for tight cell to cell contact and for cell polarity where apical part is directed towards the lumen and the basal part to the basal lamina.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "epithelial cell";
                rdfs:subClassOf cdao:CL_0000000.
cdao:CL_0000084 cdao:IAO_0000111 "T cell";
                cdao:IAO_0000115 "A type of lymphocyte whose defining characteristic is the expression of a T cell receptor complex.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "T cell";
                rdfs:subClassOf cdao:CL_0000542.
cdao:CL_0000097 cdao:IAO_0000111 "mast cell";
                cdao:IAO_0000115 "A cell that is found in almost all tissues containing numerous basophilic granules and capable of releasing large amounts of histamine and heparin upon activation. Progenitors leave bone marrow and mature in connective and mucosal tissue. Mature mast cells are found in all tissues, except the bloodstream. Their phenotype is CD117-high, CD123-negative, CD193-positive, CD200R3-positive, and FceRI-high. Stem-cell factor (KIT-ligand; SCF) is the main controlling signal of their survival and development.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "mast cell";
                rdfs:subClassOf cdao:CL_0000000.
cdao:CL_0000182 cdao:IAO_0000111 "hepatocyte";
                cdao:IAO_0000115 "The main structural component of the liver. They are specialized epithelial cells that are organized into interconnected plates called lobules. Majority of cell population of liver, polygonal in shape, arranged in plates or trabeculae between sinusoids; may have single nucleus or binucleated.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "hepatocyte";
                rdfs:subClassOf cdao:CL_0000066.
cdao:CL_0000232 cdao:IAO_0000111 "erythrocyte";
                cdao:IAO_0000115 "A red blood cell. In mammals, mature erythrocytes are biconcave disks containing hemoglobin whose function is to transport oxygen.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "erythrocyte";
                rdfs:subClassOf cdao:CL_0000000.
cdao:CL_0000235 cdao:IAO_0000111 "macrophage";
                cdao:IAO_0000115 "A mononuclear phagocyte present in variety of tissues, typically differentiated from monocytes, capable of phagocytosing a variety of extracellular particulate material, including immune complexes, microorganisms, and dead cells.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "macrophage";
                rdfs:subClassOf cdao:CL_0000000.
cdao:CL_0000236 cdao:IAO_0000111 "B cell";
                cdao:IAO_0000115 "A lymphocyte of B lineage with the phenotype CD19-positive, CD20-positive, and capable of B cell mediated immunity.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "B cell";
                rdfs:subClassOf cdao:CL_0000542.
cdao:CL_0000451 cdao:IAO_0000111 "dendritic cell";
                cdao:IAO_0000115 "A cell of hematopoietic origin, typically resident in particular tissues, specialized in the uptake, processing, and transport of antigens to lymph nodes for the purpose of stimulating an immune response via T cell activation. These cells are lineage negative (CD3-negative, CD19-negative, CD34-negative, and CD56-negative).";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "dendritic cell";
                rdfs:subClassOf cdao:CL_0000000.
cdao:CL_0000542 cdao:IAO_0000111 "lymphocyte";
                cdao:IAO_0000115 "A lymphocyte is a leukocyte commonly found in the blood and lymph that has the characteristics of a large nucleus, a neutral staining cytoplasm, and prominent heterochromatin.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "lymphocyte";
                rdfs:subClassOf cdao:CL_0000842.
cdao:CL_0000578 cdao:IAO_0000111 "experimentally modified cell in vitro";
                cdao:IAO_0000115 "A cell in vitro that has undergone physical changes as a consequence of a deliberate and specific experimental procedure.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "experimentally modified cell in vitro";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000094 ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000312 ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                cdao:OBI_0000047,
                                cdao:CL_0000000.
cdao:CL_0000624 cdao:IAO_0000111 "CD4-positive, alpha-beta T cell";
                cdao:IAO_0000115 "A mature alpha-beta T cell that expresses an alpha-beta T cell receptor and the CD4 coreceptor.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "CD4-positive, alpha-beta T cell";
                rdfs:subClassOf cdao:CL_0000789.
cdao:CL_0000625 cdao:IAO_0000111 "CD8-positive, alpha-beta T cell";
                cdao:IAO_0000115 "A T cell expressing an alpha-beta T cell receptor and the CD8 coreceptor.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "CD8-positive, alpha-beta T cell";
                rdfs:subClassOf cdao:CL_0000789.
cdao:CL_0000767 cdao:IAO_0000111 "basophil";
                cdao:IAO_0000115 "Any of the immature or mature forms of a granular leukocyte that in its mature form has an irregularly shaped, pale-staining nucleus that is partially constricted into two lobes, and with cytoplasm that contains coarse, bluish-black granules of variable size. Basophils contain vasoactive amines such as histamine and serotonin, which are released on appropriate stimulation. A basophil is CD123-positive, CD193-positive, CD203c-positive, and FceRIa-positive.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "basophil";
                rdfs:subClassOf cdao:CL_0000000.
cdao:CL_0000786 cdao:IAO_0000111 "plasma cell";
                cdao:IAO_0000115 "A terminally differentiated, post-mitotic, antibody secreting cell of the B cell lineage with the phenotype CD138-positive, surface immunonoglobulin-negative, and MHC Class II-negative. Plasma cells are oval or round with extensive rough endoplasmic reticulum, a well-developed Golgi apparatus, and a round nucleus having a characteristic cartwheel heterochromatin pattern and are devoted to producing large amounts of immunoglobulin.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "plasma cell";
                rdfs:subClassOf cdao:CL_0000236.
cdao:CL_0000789 cdao:IAO_0000111 "alpha-beta T cell";
                cdao:IAO_0000115 "A T cell that expresses an alpha-beta T cell receptor complex.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "alpha-beta T cell";
                rdfs:subClassOf cdao:CL_0000084.
cdao:CL_0000794 cdao:IAO_0000111 "CD8-positive, alpha-beta cytotoxic T cell";
                cdao:IAO_0000115 "A CD8-positive, alpha-beta T cell that is capable of killing target cells in an antigen specific manner with the phenotype perforin-positive and granzyme B-positive.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "CD8-positive, alpha-beta cytotoxic T cell";
                rdfs:subClassOf cdao:CL_0000625.
cdao:CL_0000814 cdao:IAO_0000111 "mature NK T cell";
                cdao:IAO_0000115 "A mature alpha-beta T cell of a distinct lineage that bears natural killer markers and a T cell receptor specific for a limited set of ligands. NK T cells have activation and regulatory roles particularly early in an immune response.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "mature NK T cell";
                rdfs:subClassOf cdao:CL_0000789.
cdao:CL_0000842 cdao:IAO_0000111 "mononuclear cell";
                cdao:IAO_0000115 "A leukocyte with a single non-segmented nucleus in the mature form.";
                cdao:IAO_0000412 cdao:cl.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "mononuclear cell";
                rdfs:subClassOf cdao:CL_0000000.
cdao:ENVO_00001998 cdao:IAO_0000111 "soil";
                   cdao:IAO_0000115 "Soil is an environmental material which is primarily composed of minerals, varying proportions of sand, silt, and clay, organic material such as humus, gases, liquids, and a broad range of resident micro- and macroorganisms.";
                   cdao:IAO_0000412 cdao:envo.owl;
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "soil";
                   rdfs:subClassOf cdao:ENVO_00010483.
cdao:ENVO_00002257 cdao:IAO_0000111 "podzol";
                   cdao:IAO_0000115 "Podzols are soils with a typically ash-grey upper subsurface horizon, bleached by loss of organic matter and iron oxides, on top of a dark accumulation horizon with brown, reddish or black illuviated humus and/or reddish Fe compounds. Podzols occur in humid areas in the boreal and temperate zones and locally also in the tropics.";
                   cdao:IAO_0000412 cdao:envo.owl;
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "podzol";
                   rdfs:subClassOf cdao:ENVO_00001998.
cdao:ENVO_00010483 cdao:IAO_0000111 "environmental material";
                   cdao:IAO_0000115 "A portion of environmental material is a fiat object which forms the medium or part of the medium of an environmental system.";
                   cdao:IAO_0000412 cdao:envo.owl;
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "environmental material";
                   rdfs:subClassOf cdao:BFO_0000040.
cdao:GAZ_00000448 cdao:IAO_0000111 "geographic location";
                  cdao:IAO_0000115 "A reference to a place on the Earth, by its name or by its geographical location.";
                  cdao:IAO_0000412 cdao:gaz.owl;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "geographic location";
                  rdfs:subClassOf cdao:BFO_0000029.
cdao:GO_0000785 cdao:IAO_0000111 "chromatin";
                cdao:IAO_0000115 "The ordered and organized complex of DNA, protein, and sometimes RNA, that forms the chromosome.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "chromatin";
                rdfs:subClassOf cdao:GO_0005575.
cdao:GO_0001047 cdao:IAO_0000111 "core promoter binding";
                cdao:IAO_0000115 "Interacting selectively and non-covalently with the regulatory region composed of the transcription start site and binding sites for the basal transcription machinery. Binding may occur as a sequence specific interaction or as an interaction observed only once a factor has been recruited to the DNA by other factors.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "core promoter binding";
                rdfs:subClassOf cdao:OBI_0001588.
cdao:GO_0001508 cdao:IAO_0000111 "action potential";
                cdao:IAO_0000115 "A process in which membrane potential cycles through a depolarizing spike, triggered in response to depolarization above some threshold, followed by repolarization. This cycle is driven by the flow of ions through various voltage gated channels with different thresholds and ion specificities.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "action potential";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0001788 cdao:IAO_0000111 "antibody-dependent cellular cytotoxicity";
                cdao:IAO_0000115 "Cytolysis of target cells by natural killer cells, eosinophils, neutrophils, monocytes, or macrophages following engagement of antibodies bound to the target cells by Fc receptors on the effector cells.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "antibody-dependent cellular cytotoxicity";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0001806 cdao:IAO_0000111 "type IV hypersensitivity";
                cdao:IAO_0000115 "An inflammatory response driven by T cell recognition of processed soluble or cell-associated antigens leading to cytokine release and leukocyte activation.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "type IV hypersensitivity";
                rdfs:subClassOf cdao:GO_0002524.
cdao:GO_0001816 cdao:IAO_0000111 "cytokine production";
                cdao:IAO_0000115 "The appearance of a cytokine due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "cytokine production";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0001906 cdao:IAO_0000111 "cell killing";
                cdao:IAO_0000115 "Any process in an organism that results in the killing of its own cells or those of another organism, including in some cases the death of the other organism. Killing here refers to the induction of death in one cell by another cell, not cell-autonomous death due to internal or other environmental conditions.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "cell killing";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0001913 cdao:IAO_0000111 "T cell mediated cytotoxicity";
                cdao:IAO_0000115 "The directed killing of a target cell by a T cell through the release of granules containing cytotoxic mediators or through the engagement of death receptors.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "T cell mediated cytotoxicity";
                rdfs:subClassOf cdao:GO_0001906.
cdao:GO_0002250 cdao:IAO_0000111 "adaptive immune response";
                cdao:IAO_0000115 "An immune response mediated by cells expressing specific receptors for antigen produced through a somatic diversification process, and allowing for an enhanced secondary response to subsequent exposures to the same antigen (immunological memory).";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "adaptive immune response";
                rdfs:subClassOf cdao:GO_0006955.
cdao:GO_0002367 cdao:IAO_0000111 "cytokine production involved in immune response";
                cdao:IAO_0000115 "The appearance of a cytokine due to biosynthesis or secretion following a cellular stimulus contributing to an immune response, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "cytokine production involved in immune response";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0002390 cdao:IAO_0000111 "platelet activating factor production";
                cdao:IAO_0000115 "The synthesis or release of platelet activating factor following a stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "platelet activating factor production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0002507 cdao:IAO_0000111 "tolerance induction";
                cdao:IAO_0000115 "A process that directly activates any of the steps required for tolerance, a physiologic state in which the immune system does not react destructively against the components of an organism that harbors it or against antigens that are introduced to it.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "tolerance induction";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0002514 cdao:IAO_0000111 "B cell tolerance induction";
                cdao:IAO_0000115 "A process involving any mechanism for tolerance induction in B cells.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "B cell tolerance induction";
                rdfs:subClassOf cdao:GO_0002507.
cdao:GO_0002517 cdao:IAO_0000111 "T cell tolerance induction";
                cdao:IAO_0000115 "A process involving any mechanism for tolerance induction in T cells.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "T cell tolerance induction";
                rdfs:subClassOf cdao:GO_0002507.
cdao:GO_0002524 cdao:IAO_0000111 "hypersensitivity";
                cdao:IAO_0000115 "An inflammatory response to an exogenous environmental antigen or an endogenous antigen initiated by the adaptive immune system.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "hypersensitivity";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0002534 cdao:IAO_0000111 "cytokine production involved in inflammatory response";
                cdao:IAO_0000115 "The synthesis or release of a cytokine following a inflammatory stimulus as part of an inflammatory response, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "cytokine production involved in inflammatory response";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0003674 cdao:IAO_0000111 "molecular_function";
                cdao:IAO_0000115 "A molecular process that can be carried out by the action of a single macromolecular machine, usually via direct physical interactions with other molecular entities. Function in this sense denotes an action, or activity, that a gene product (or a complex) performs. These actions are described from two distinct but related perspectives: (1) biochemical activity, and (2) role as a component in a larger system/process.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "GO:molecular_function";
                rdfs:subClassOf cdao:BFO_0000015.
cdao:GO_0003823 cdao:IAO_0000111 "antigen binding";
                cdao:IAO_0000115 "Interacting selectively and non-covalently with an antigen, any substance which is capable of inducing a specific immune response and of reacting with the products of that response, the specific antibody or specifically sensitized T-lymphocytes, or both. Binding may counteract the biological activity of the antigen.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "antigen binding";
                rdfs:subClassOf cdao:BFO_0000015.
cdao:GO_0003824 cdao:IAO_0000111 "catalytic activity";
                cdao:IAO_0000115 "Catalysis of a biochemical reaction at physiological temperatures. In biologically catalyzed reactions, the reactants are known as substrates, and the catalysts are naturally occurring macromolecular substances known as enzymes. Enzymes possess specific binding sites for substrates, and are usually composed wholly or largely of protein, but RNA that has catalytic activity (ribozyme) is often also regarded as enzymatic.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "catalytic activity";
                rdfs:subClassOf cdao:GO_0003674.
cdao:GO_0003964 cdao:IAO_0000111 "RNA-directed DNA polymerase activity";
                cdao:IAO_0000115 "Catalysis of the reaction: deoxynucleoside triphosphate + DNA(n) = diphosphate + DNA(n+1). Catalyzes RNA-template-directed extension of the 3'- end of a DNA strand by one deoxynucleotide at a time.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "RNA-directed DNA polymerase activity";
                rdfs:subClassOf cdao:GO_0003824.
cdao:GO_0005216 cdao:IAO_0000111 "ion channel activity";
                cdao:IAO_0000115 "Enables the facilitated diffusion of an ion (by an energy-independent process) by passage through a transmembrane aqueous pore or channel without evidence for a carrier-mediated mechanism. May be either selective (it enables passage of a specific ion only) or non-selective (it enables passage of two or more ions of same charge but different size).";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "ion channel activity";
                rdfs:subClassOf cdao:GO_0009987.
cdao:GO_0005575 cdao:IAO_0000111 "cellular_component";
                cdao:IAO_0000115 "A location, relative to cellular compartments and structures, occupied by a macromolecular machine when it carries out a molecular function. There are two ways in which the gene ontology describes locations of gene products: (1) relative to cellular structures (e.g., cytoplasmic side of plasma membrane) or compartments (e.g., mitochondrion), and (2) the stable macromolecular complexes of which they are parts (e.g., the ribosome).";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "cellular_component";
                rdfs:subClassOf cdao:BFO_0000040.
cdao:GO_0005694 cdao:IAO_0000111 "chromosome";
                cdao:IAO_0000115 "A structure composed of a very long molecule of DNA and associated proteins (e.g. histones) that carries hereditary information.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "chromosome";
                rdfs:subClassOf cdao:GO_0005575.
cdao:GO_0005739 cdao:IAO_0000111 "mitochondrion";
                cdao:IAO_0000115 "A semiautonomous, self replicating organelle that occurs in varying numbers, shapes, and sizes in the cytoplasm of virtually all eukaryotic cells. It is notably the site of tissue respiration.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "mitochondrion";
                rdfs:subClassOf cdao:GO_0043227.
cdao:GO_0006006 cdao:IAO_0000111 "glucose metabolic process";
                cdao:IAO_0000115 "The chemical reactions and pathways involving glucose, the aldohexose gluco-hexose. D-glucose is dextrorotatory and is sometimes known as dextrose; it is an important source of energy for living organisms and is found free as well as combined in homo- and hetero-oligosaccharides and polysaccharides.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "glucose metabolic process";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0006260 cdao:IAO_0000111 "DNA replication";
                cdao:IAO_0000115 "The cellular metabolic process in which a cell duplicates one or more molecules of DNA. DNA replication begins when specific sequences, known as origins of replication, are recognized and bound by initiation proteins, and ends when the original DNA molecule has been completely duplicated and the copies topologically separated. The unit of replication usually corresponds to the genome of the cell, an organelle, or a virus. The template for replication can either be an existing DNA molecule or RNA.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "DNA replication";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0006306 cdao:IAO_0000111 "DNA methylation";
                cdao:IAO_0000115 "The covalent transfer of a methyl group to either N-6 of adenine or C-5 or N-4 of cytosine.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "DNA methylation";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0006338 cdao:IAO_0000111 "chromatin remodeling";
                cdao:IAO_0000115 "Dynamic structural changes to eukaryotic chromatin occurring throughout the cell division cycle. These changes range from the local changes necessary for transcriptional regulation to global changes necessary for chromosome segregation.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "chromatin remodeling";
                rdfs:subClassOf cdao:GO_0009987.
cdao:GO_0006909 cdao:IAO_0000111 "phagocytosis";
                cdao:IAO_0000115 "An endocytosis process that results in the engulfment of external particulate material by phagocytes. The particles are initially contained within phagocytic vacuoles (phagosomes), which then fuse with primary lysosomes to effect digestion of the particles.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "phagocytosis";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0006955 cdao:IAO_0000111 "immune response";
                cdao:IAO_0000115 "Any immune system process that functions in the calibrated response of an organism to a potential internal or invasive threat.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "immune response";
                rdfs:subClassOf cdao:GO_0050896.
cdao:GO_0006974 cdao:IAO_0000111 "cellular response to DNA damage stimulus";
                cdao:IAO_0000115 "Any process that results in a change in state or activity of a cell (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a stimulus indicating damage to its DNA from environmental insults or errors during metabolism.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "cellular response to DNA damage stimulus";
                rdfs:subClassOf cdao:GO_0050896.
cdao:GO_0007049 cdao:IAO_0000111 "cell cycle";
                cdao:IAO_0000115 "The progression of biochemical and morphological phases and events that occur in a cell during successive cell replication or nuclear replication events. Canonically, the cell cycle comprises the replication and segregation of genetic material followed by the division of the cell, but in endocycles or syncytial cells nuclear replication or nuclear division may not be followed by cell division.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "cell cycle";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0007596 cdao:IAO_0000111 "blood coagulation";
                cdao:IAO_0000115 "The sequential process in which the multiple coagulation factors of the blood interact, ultimately resulting in the formation of an insoluble fibrin clot; it may be divided into three stages: stage 1, the formation of intrinsic and extrinsic prothrombin converting principle; stage 2, the formation of thrombin; stage 3, the formation of stable fibrin polymers.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "blood coagulation";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0008150 cdao:IAO_0000111 "biological_process";
                cdao:IAO_0000115 "A biological process represents a specific objective that the organism is genetically programmed to achieve. Biological processes are often described by their outcome or ending state, e.g., the biological process of cell division results in the creation of two daughter cells (a divided cell) from a single parent cell. A biological process is accomplished by a particular set of molecular functions carried out by specific gene products (or macromolecular complexes), often in a highly regulated manner and in a particular temporal sequence.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "biological_process";
                rdfs:subClassOf cdao:BFO_0000015;
                <http://www.w3.org/2002/07/owl#disjointWith> cdao:OBI_0000011.
cdao:GO_0008228 cdao:IAO_0000111 "opsonization";
                cdao:IAO_0000115 "The process in which a microorganism (or other particulate material) is rendered more susceptible to phagocytosis by coating with an opsonin, a blood serum protein such as a complement component or antibody.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "opsonization";
                rdfs:subClassOf cdao:GO_0006909.
cdao:GO_0008283 cdao:IAO_0000111 "cell proliferation";
                cdao:IAO_0000115 "The multiplication or reproduction of cells, resulting in the expansion of a cell population.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "cell proliferation";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0009566 cdao:IAO_0000111 "fertilization";
                cdao:IAO_0000115 "The union of gametes of opposite sexes during the process of sexual reproduction to form a zygote. It involves the fusion of the gametic nuclei (karyogamy) and cytoplasm (plasmogamy).";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "fertilization";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0009987 cdao:IAO_0000111 "cellular process";
                cdao:IAO_0000115 "Any process that is carried out at the cellular level, but not necessarily restricted to a single cell. For example, cell communication occurs among more than one cell, but occurs at the cellular level.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "cellular process";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0010467 cdao:IAO_0000111 "gene expression";
                cdao:IAO_0000115 "The process in which a gene's sequence is converted into a mature gene product or products (proteins or RNA). This includes the production of an RNA transcript as well as any processing to produce a mature RNA product or an mRNA or circRNA (for protein-coding genes) and the translation of that mRNA or circRNA into protein. Protein maturation is included when required to form an active form of a product from an inactive precursor form.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "gene expression";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0010573 cdao:IAO_0000111 "vascular endothelial growth factor production";
                cdao:IAO_0000115 "The appearance of vascular endothelial growth factor production due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "vascular endothelial growth factor production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0016064 cdao:IAO_0000111 "immunoglobulin mediated immune response";
                cdao:IAO_0000115 "An immune response mediated by immunoglobulins, whether cell-bound or in solution.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "immunoglobulin mediated immune response";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0016570 cdao:IAO_0000111 "histone modification";
                cdao:IAO_0000115 "The covalent alteration of one or more amino acid residues within a histone protein.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "histone modification";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0019814 cdao:IAO_0000111 "immunoglobulin complex";
                cdao:IAO_0000115 "A protein complex that in its canonical form is composed of two identical immunoglobulin heavy chains and two identical immunoglobulin light chains, held together by disulfide bonds and sometimes complexed with additional proteins. An immunoglobulin complex may be embedded in the plasma membrane or present in the extracellular space, in mucosal areas or other tissues, or circulating in the blood or lymph.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "immunoglobulin complex";
                rdfs:subClassOf cdao:GO_0043234.
cdao:GO_0019815 cdao:IAO_0000111 "B cell receptor complex";
                cdao:IAO_0000115 "An immunoglobulin complex that is present in the plasma membrane of B cells and that in its canonical form is composed of two identical immunoglobulin heavy chains and two identical immunoglobulin light chains and a signaling subunit, a heterodimer of the Ig-alpha and Ig-beta proteins.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "B cell receptor complex";
                rdfs:subClassOf cdao:OBI_1110022.
cdao:GO_0019882 cdao:IAO_0000111 "antigen processing and presentation";
                cdao:IAO_0000115 "The process in which an antigen-presenting cell expresses antigen (peptide or lipid) on its cell surface in association with an MHC protein complex.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "antigen processing and presentation";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0019904 cdao:IAO_0000111 "protein domain specific binding";
                cdao:IAO_0000115 "Interacting selectively and non-covalently with a specific domain of a protein.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "protein domain specific binding";
                rdfs:subClassOf cdao:OBI_0001588.
cdao:GO_0030041 cdao:IAO_0000111 "actin filament polymerization";
                cdao:IAO_0000115 "Assembly of actin filaments by the addition of actin monomers to a filament.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "actin filament polymerization";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0030097 cdao:IAO_0000111 "hemopoiesis";
                cdao:IAO_0000115 "The process whose specific outcome is the progression of the myeloid and lymphoid derived organ/tissue systems of the blood and other parts of the body over time, from formation to the mature structure. The site of hemopoiesis is variable during development, but occurs primarily in bone marrow or kidney in many adult vertebrates.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "hemopoiesis";
                rdfs:subClassOf cdao:GO_0008150.
cdao:GO_0032601 cdao:IAO_0000111 "connective tissue growth factor production";
                cdao:IAO_0000115 "The appearance of connective tissue growth factor due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "connective tissue growth factor production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032602 cdao:IAO_0000111 "chemokine production";
                cdao:IAO_0000115 "The appearance of a chemokine due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "chemokine production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032604 cdao:IAO_0000111 "granulocyte macrophage colony-stimulating factor production";
                cdao:IAO_0000115 "The appearance of granulocyte macrophage colony-stimulating factor due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "granulocyte macrophage colony-stimulating factor production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032605 cdao:IAO_0000111 "hepatocyte growth factor production";
                cdao:IAO_0000115 "The appearance of hepatocyte growth factor due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "hepatocyte growth factor production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032606 cdao:IAO_0000111 "type I interferon production";
                cdao:IAO_0000115 "The appearance of type I interferon due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels. Type I interferons include the interferon-alpha, beta, delta, episilon, zeta, kappa, tau, and omega gene families.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "type I interferon production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032607 cdao:IAO_0000111 "interferon-alpha production";
                cdao:IAO_0000115 "The appearance of interferon-alpha due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interferon-alpha production";
                rdfs:subClassOf cdao:GO_0032606.
cdao:GO_0032608 cdao:IAO_0000111 "interferon-beta production";
                cdao:IAO_0000115 "The appearance of interferon-beta due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interferon-beta production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032609 cdao:IAO_0000111 "interferon-gamma production";
                cdao:IAO_0000115 "The appearance of interferon-gamma due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels. Interferon-gamma is also known as type II interferon.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interferon-gamma production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032610 cdao:IAO_0000111 "interleukin-1 alpha production";
                cdao:IAO_0000115 "The appearance of interleukin-1 alpha due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interleukin-1 alpha production";
                rdfs:subClassOf cdao:GO_0032612.
cdao:GO_0032611 cdao:IAO_0000111 "interleukin-1 beta production";
                cdao:IAO_0000115 "The appearance of interleukin-1 beta due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interleukin-1 beta production";
                rdfs:subClassOf cdao:GO_0032612.
cdao:GO_0032612 cdao:IAO_0000111 "interleukin-1 production";
                cdao:IAO_0000115 "The appearance of interleukin-1 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interleukin-1 production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032613 cdao:IAO_0000111 "interleukin-10 production";
                cdao:IAO_0000115 "The appearance of interleukin-10 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interleukin-10 production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032614 cdao:IAO_0000111 "interleukin-11 production";
                cdao:IAO_0000115 "The appearance of interleukin-11 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interleukin-11 production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032615 cdao:IAO_0000111 "interleukin-12 production";
                cdao:IAO_0000115 "The appearance of interleukin-12 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interleukin-12 production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032616 cdao:IAO_0000111 "interleukin-13 production";
                cdao:IAO_0000115 "The appearance of interleukin-13 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interleukin-13 production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032617 cdao:IAO_0000111 "interleukin-14 production";
                cdao:IAO_0000115 "The appearance of interleukin-14 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interleukin-14 production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032618 cdao:IAO_0000111 "interleukin-15 production";
                cdao:IAO_0000115 "The appearance of interleukin-15 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interleukin-15 production";
                rdfs:subClassOf cdao:GO_0001816.
cdao:GO_0032619 cdao:IAO_0000111 "interleukin-16 production";
                cdao:IAO_0000115 "The appearance of interleukin-16 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interleukin-16 production";
