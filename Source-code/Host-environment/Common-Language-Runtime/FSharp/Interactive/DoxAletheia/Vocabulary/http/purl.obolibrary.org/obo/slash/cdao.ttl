                 cdao:IAO_0000112 "PMID: 18246869. Loss of cortical function in mice after decapitation, cervical dislocation, potassium chloride injection, and CO2 inhalation. Comp Med. 2007 Dec;57(6):570-3"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "cervical dislocation is a process by which a Vertebrate organism has its life terminated by rupturing spinal cord between cervical vertebrae induced by excessive mechanical torsion"@en;
                 cdao:IAO_0000116 "PRS:21102008: Input must be restricted to Vertebrates (requires import from NCBI tax)"@en;
