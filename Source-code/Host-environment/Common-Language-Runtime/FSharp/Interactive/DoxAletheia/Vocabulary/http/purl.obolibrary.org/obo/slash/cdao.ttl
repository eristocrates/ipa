                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0600039 cdao:IAO_0000111 "artificially induced methylation"@en;
                 cdao:IAO_0000112 "the use of enzymes to add methyl groups to DNA molecules"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A planned process of adding methyl groups to polymers"@en;
                 cdao:IAO_0000117 "PERSON:Kevin Clancy"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "artificially induced methylation"@en;
