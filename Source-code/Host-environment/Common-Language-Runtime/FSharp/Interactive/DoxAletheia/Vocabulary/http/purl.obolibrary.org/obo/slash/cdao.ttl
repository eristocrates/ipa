                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A pathologic primary tumor stage for kidney according to AJCC 7th edition indicating that the tumor grossly extends into vena cava below diaphragm.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "https://staging.seer.cancer.gov/tnm/input/1.0/kidney_parenchyma/path_t/";
                 cdao:IAO_0000234 "NCI BBRB";
                 a cdao:OBI_0002243,
                   <http://www.w3.org/2002/07/owl#NamedIndividual>;
