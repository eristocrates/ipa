                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000968.
cdao:OBI_0000043 cdao:IAO_0000111 "xenotransplantation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "is the transplantation of living cells, tissues or \\norgans from one species to another such as from pigs to humans"@en;
                 cdao:IAO_0000117 "PlanAndPlannedProcess Branch"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "xenotransplantation"@en;
                 rdfs:subClassOf cdao:OBI_0000105.
cdao:OBI_0000044 cdao:IAO_0000111 "physical document"@en;
                 cdao:IAO_0000112 "a book is a physical document"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A physical document is an object serving as a record of information by means of symbolic marks."@en;
                 cdao:IAO_0000117 "PERSON: Bjoern Peters";
                 cdao:IAO_0000119 "GROUP: OBI";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "physical document"@en;
                 rdfs:subClassOf cdao:OBI_0000047.
cdao:OBI_0000045 cdao:IAO_0000111 "waiting"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "not actively doing anything to a material for a duration of time."@en;
                 cdao:IAO_0000117 "PERSON:Alan Ruttenberg"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 cdao:IAO_0000232 "BP: I have doubts about the utility of this."@en,
                                  "We need a better handling/modeling of time (January 2008)"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "waiting"@en;
                 rdfs:subClassOf cdao:OBI_0600009.
cdao:OBI_0000047 cdao:IAO_0000111 "processed material"@en;
                 cdao:IAO_0000112 "Examples include gel matrices, filter paper, parafilm and buffer solutions, mass spectrometer, tissue samples"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "Is a material entity that is created or changed during material processing."@en;
                 cdao:IAO_0000117 "PERSON: Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "processed material"@en;
