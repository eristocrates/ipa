                                 cdao:BFO_0000023;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:BFO_0000023
                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000066 ; 
                                                                                                                                                                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000050 ; 
                                                                                                                                                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>] ; 
