cdao:OBI_0000442 cdao:IAO_0000111 "heart"@en;
                 cdao:IAO_0000112 "Alan Ruttenberg's heart";
                 cdao:IAO_0000114 cdao:IAO_0000002;
                 cdao:IAO_0000115 "The heart is a muscular organ found in all vertebrates that is responsible for pumping blood throughout the blood vessels by repeated, rhythmic contractions";
