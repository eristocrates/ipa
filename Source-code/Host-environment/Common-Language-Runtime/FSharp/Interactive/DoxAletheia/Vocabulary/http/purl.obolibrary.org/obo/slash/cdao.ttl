cdao:OBI_0001171 cdao:IAO_0000111 "half life datum (t 1/2)";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "The time it takes for 50% of a class of stochastic processes to occur. ";
                 cdao:IAO_0000117 "Bjoern Peters";
                 cdao:IAO_0000118 "t 1/2";
                 cdao:IAO_0000119 "Bjoern Peters";
                 a <http://www.w3.org/2002/07/owl#Class>;
