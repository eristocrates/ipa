                 rdfs:label "institutional identification"@en;
                 rdfs:subClassOf cdao:IAO_0000300.
cdao:IAO_0000304 cdao:IAO_0000111 "caption"@en;
                 cdao:IAO_0000112 "Figure 1: A system diagram describing the modules of the Hanalyzer.  Reading methods (green) take external sources of knowledge (blue) and extract information from them, either by parsing structured data or biomedical language processing to extract information from unstructured data.  Reading modules are responsible for tracking the provenance of all knowledge.  Reasoning methods (yellow) enrich the knowledge that results from reading by, for example, noting two genes that are annotated to the same ontology term or database entry.  All knowledge sources, read or reasoned, are assigned a reliability score, and all are combined using that score into a knowledge network (orange) that represents the integration of all sorts of relationship between a pair of genes and a combined reliability score.  A data network (also orange) is created from experimental results to be analyzed.  The reporting modules (pink) integrate the data and knowledge networks, producing visualizations that can be queried with the associated drill-down tool."@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A textual entity that describes a figure"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "caption"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000308 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000136 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000300.
cdao:IAO_0000305 cdao:IAO_0000111 "document title"@en;
                 cdao:IAO_0000112 "Textual characteristics of traditional and Open Access scientific journals are similar"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A textual entity that names a document"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "document title"@en;
                 rdfs:subClassOf cdao:IAO_0000300.
cdao:IAO_0000306 cdao:IAO_0000111 "table"@en;
                 cdao:IAO_0000112 """| T     F
--+-----
T   | T     F
F   |  F    F"""@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A textual entity that contains a two-dimensional arrangement of texts repeated at regular intervals across a spatial range, such that the spatial relationships among the constituent texts expresses propositions"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "table"@en;
                 rdfs:subClassOf cdao:IAO_0000300.
cdao:IAO_0000307 cdao:IAO_0000111 "table of abbreviations"@en;
                 cdao:IAO_0000112 """IAO  information artifact ontology
OBI  ontology of biomedical investiations
GO   gene ontology"""@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A table where the constituent texts are abbreviations and their expansions"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "table of abbreviations"@en;
                 rdfs:subClassOf cdao:IAO_0000306.
cdao:IAO_0000308 cdao:IAO_0000111 "figure"@en;
                 cdao:IAO_0000112 "Any picture, diagram or table"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An information content entity consisting of a two dimensional arrangement of information content entities such that the arrangement itself is about something."@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "figure"@en;
                 rdfs:subClassOf cdao:IAO_0000030.
cdao:IAO_0000309 cdao:IAO_0000111 "diagram"@en;
                 cdao:IAO_0000112 "A molecular structure ribbon cartoon showing helices, turns and sheets and their relations to each other in space."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A figure that expresses one or more propositions"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "diagram"@en;
                 rdfs:subClassOf cdao:IAO_0000308.
cdao:IAO_0000310 cdao:IAO_0000111 "document"@en;
                 cdao:IAO_0000112 "A journal article, patent application, laboratory notebook, or a book"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A collection of information content entities intended to be understood together as a whole"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "document"@en;
                 rdfs:subClassOf cdao:IAO_0000030.
cdao:IAO_0000311 cdao:IAO_0000111 "publication"@en;
                 cdao:IAO_0000112 "A journal article or book"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A document that has been accepted by a publisher"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "publication"@en;
                 rdfs:subClassOf cdao:IAO_0000310.
cdao:IAO_0000312 cdao:IAO_0000111 "publication about an investigation"@en;
                 cdao:IAO_0000112 "Most scientific journal articles"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A publication that is about an investigation"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 cdao:IAO_0000118 "scientific publication"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "publication about an investigation"@en;
                 rdfs:subClassOf cdao:IAO_0000311,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000066 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000136 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:IAO_0000313 cdao:IAO_0000111 "patent"@en;
                 cdao:IAO_0000112 "US Patent 6,449,603"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A document that has been accepted by a patent authority"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "patent"@en;
                 rdfs:subClassOf cdao:IAO_0000310.
cdao:IAO_0000314 cdao:IAO_0000111 "document part"@en;
                 cdao:IAO_0000112 "An abstract, introduction, method or results section."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "an information content entity that is part of a document"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "document part"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000310 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000050 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000030.
cdao:IAO_0000315 cdao:IAO_0000111 "abstract"@en;
                 cdao:IAO_0000112 "The profusion of high-throughput instruments and the explosion of new results in the scientific literature, particularly in molecular biomedicine, is both a blessing and a curse to the bench researcher.   Even knowledgeable and experienced scientists can benefit from computational tools that help navigate this vast and rapidly evolving terrain. In this paper, we describe a novel computational approach to this challenge, a knowledge-based system that combines reading, reasoning and reporting methods to facilitate analysis of experimental data. Reading methods extract information from external resources, either by parsing structured data or biomedical language processing to extract information from unstructured data, and track knowledge provenance.  Reasoning methods enrich the knowledge that results from reading by, for example, noting two genes that are annotated to the same ontology term or database entry.  Reasoning is also used to combine all sources into a knowledge network that represents the integration of all sorts of relationships between a pair of genes, and to calculate a combined reliability score. Reporting methods combine the knowledge network with a congruent network constructed from experimental data and visualize the combined network in a tool that facilitates the knowledge-based analysis of that data."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A summary of the entire document that is substantially smaller than the document it summarizes.  It is about the document it summarizes."@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "abstract"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000310 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000136 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000314.
cdao:IAO_0000316 cdao:IAO_0000111 "introduction to a publication about an investigation"@en;
                 cdao:IAO_0000112 "Section labelled 'introduction' of a typical scientific journal article"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A part of a publication about an investigation that is about the objective specification (why the investigation is being done)"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 cdao:IAO_0000118 "introduction"@en,
                                  "background"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "introduction to a publication about an investigation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:IAO_0000005 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000136 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000314.
cdao:IAO_0000317 cdao:IAO_0000111 "methods section"@en;
                 cdao:IAO_0000112 "The section labelled 'Methods' or 'Materials and Methods' in a typical scientific journal article."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A part of a publication about an investigation that is about the study design of the investigation"@en;
                 cdao:IAO_0000117 "PERSON: Lawrence Hunter"@en;
                 cdao:IAO_0000118 "experimental section"@en,
