                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000094.
cdao:OBI_0000907 cdao:IAO_0000111 "supplying";
                 cdao:IAO_0000112 "Jackson Labs supplies mouse strains.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 """The planned process of providing material entities
to be used in an investigation.""";
                 cdao:IAO_0000117 "Jennifer Fostel";
                 cdao:IAO_0000119 "Jennifer Fostel";
                 cdao:IAO_0000232 "5/31/2012: A supplying process implies that there is an acquisition process. These may need to be tied together, so that modeling either way is reciprocal. ";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "supplying";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:BFO_0000040 ; 
