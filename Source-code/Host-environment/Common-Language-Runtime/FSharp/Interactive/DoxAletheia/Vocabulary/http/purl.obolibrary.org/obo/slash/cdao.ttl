                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A liquid chromatography mass spectrometry platform is a platform that is the collection of instrument, software and reagents needed to perform a liquid chromatography mass spectrometry protocol. definition_source: OBI."@en;
                 cdao:IAO_0000117 "OBI instrument branch";
