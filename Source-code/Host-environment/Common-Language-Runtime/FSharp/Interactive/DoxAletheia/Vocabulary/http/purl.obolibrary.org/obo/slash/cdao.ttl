cdao:OBI_0002614 cdao:IAO_0000111 "birth cohort study design";
                 cdao:IAO_0000112 "The LucKi Birth Cohort Study was designed and started in 2006 to follow children from birth into adulthood on a wide range of determinants, disorders, and diseases.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A cohort study design for which the subjects are followed from the time of birth usually including information about gestation and follow up.";
                 cdao:IAO_0000117 "MIABIS";
                 cdao:IAO_0000119 "MIABIS contributors";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "birth cohort study design";
                 rdfs:subClassOf cdao:OBI_0500000.
cdao:OBI_0002615 cdao:IAO_0000111 "disease specific study design";
                 cdao:IAO_0000112 "A study of the symptoms experienced by patients who have been diagnosed with multiple sclerosis employs a disease specific study design.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A study design for which material and information is collected from subjects that have already developed a particular disease.";
                 cdao:IAO_0000117 "MIABIS";
                 cdao:IAO_0000119 "MIABIS contributors";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "disease specific study design";
                 rdfs:subClassOf cdao:OBI_0500000.
cdao:OBI_0002616 cdao:IAO_0000111 "genealogical record"@en;
                 cdao:IAO_0000112 "A family tree is a type of genealogical record.";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A document about the family relationships of persons related as members of a domestic group linked through descent from a common ancestor, marriage, or adoption.";
                 cdao:IAO_0000117 "Sarah Bost",
                                  "MIABIS";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "genealogical record"@en;
                 rdfs:subClassOf cdao:IAO_0000310.
cdao:OBI_0002617 cdao:IAO_0000111 "national registry"@en;
                 cdao:IAO_0000112 "The Social Security Administration's Death Master File is a national registry in the United States.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An information content entity that contains information about a nationwide group of individuals.";
                 cdao:IAO_0000117 "Sarah Bost",
                                  "MIABIS";
                 cdao:IAO_0000119 "MIABIS contributors";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "national registry"@en;
                 rdfs:subClassOf cdao:IAO_0000030.
cdao:OBI_0002618 cdao:IAO_0000111 "national biomedical registry"@en;
                 cdao:IAO_0000112 "The Care Register for Health Care, maintained by the Finnish National Institute for Health and Welfare, is a national biomedical registry.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A national registry that contains information about individuals that was accumulated for a biomedical purpose, such as diagnoses, treatments, or outcomes.";
                 cdao:IAO_0000117 "Sarah Bost",
                                  "MIABIS";
                 cdao:IAO_0000119 "MIABIS contributors";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "national biomedical registry"@en;
                 rdfs:subClassOf cdao:OBI_0002617.
cdao:OBI_0002815 cdao:IAO_0000111 "has representation"@en;
                 cdao:IAO_0000112 "12th arrondissement of Paris"@en,
                                  "20g",
                                  "I feel sick to my stomach every Tuesday"@en;
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "'has representation' is a data property that attaches between an information content entity and a value that contains linguistically or computationally coded text."@en;
                 cdao:IAO_0000116 "Further processing may enable the value to be represented in a component data structure such as an OBI value specification."@en;
                 cdao:IAO_0000117 "Mark Miller",
                                  "Damion Dooley";
                 <http://purl.org/dc/elements/1.1/date> "2019-07-14T07:05:50Z"^^xsd:dateTime;
                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:label "has representation"@en.
cdao:OBI_0005246 cdao:IAO_0000111 "injection function";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "The function of a device realized when administering a substance in vivo, applied particularly to the forcible insertion of a liquid or gas by means of a syringe, pump, etc.";
                 cdao:IAO_0000117 "PERSON: Melanie Courtot",
                                  "PERSON: Alan Ruttenberg";
                 cdao:IAO_0000119 "adapted from WEB: http://www.dictionary.net/injection";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "injection function";
                 rdfs:subClassOf cdao:BFO_0000034.
cdao:OBI_0100010 cdao:IAO_0000111 "Epstein Barr virus transformed B cell"@en;
                 cdao:IAO_0000112 "PMID: 8777380. Expression of thyroid peroxidase in EBV-transformed B cell lines using adenovirus.Thyroid. 1996 Feb;6(1):23-8."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A material entity which results from viral transformation process using EBV as transformation agent when applied to B-cell entity"@en;
                 cdao:IAO_0000117 "PERSON: Susanna Sansone";
                 cdao:IAO_0000119 "GROUP: OBI Biomaterial Branch";
                 a <http://www.w3.org/2002/07/owl#Class>;
