cdao:OBI_0000544 cdao:IAO_0000111 "Bruker SampleRail system"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "This Instrument system automatically prepares an NMR sample, inserts it into an NMR magnet, performs NMR experiments on the sample, and transports it back to the preparation system.   The SampleRail fulfills the transporting tasks from the preparation system into the NMR magnet and back."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "WEB:<http://www.bruker-biospin.com/automation.html>"@en,
                                  "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400207";
                 cdao:IAO_0000232 "NMR instrument"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Bruker SampleRail system"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000383 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0000968.
cdao:OBI_0000545 cdao:IAO_0000111 "column compartment"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "For chromatography analyses, the ability to maintain a stable column environment regardless of ambient temperature fluctuations is critical for maintaining retention time precision. In order to ensure such stable conditions at different chromatography steps a column compartment can be installed that ensures e.g. stable temperature of the column in a given step."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01068",
