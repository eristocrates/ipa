cdao:OBI_0001174 cdao:IAO_0000111 "passive immunization";
                 cdao:IAO_0000112 """Giving VIG (concentrated antibodies from vaccinated donors) to a patient that is infected with smallpox. 
Transferring epitope specific T cells from one mouse into another.""";
                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "The injection of immune effector material (antibodies, T cells or B cells) into an organism so that the organisms immune system gains its  immune effector function to recognize specific antigens.";
                 cdao:IAO_0000117 "PERSON: Bjoern Peters, Randi Vita, Jason Greenbaum";
                 cdao:IAO_0000118 "adoptive transfer";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "passive immunization";
                 rdfs:subClassOf cdao:OBI_0600007,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0000319
                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_1110022 ; 
