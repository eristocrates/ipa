                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:IAO_0000400.
cdao:IAO_0000402 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A cartesion spatial coordinate datum that  uses two values to specify a position within a two dimensional spatial region"@en;
                 cdao:IAO_0000117 "Alan Ruttenberg"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "two dimensional cartesian spatial coordinate datum"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000406 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000404 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:BFO_0000018
                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:BFO_0000009 ; 
                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000050 ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
