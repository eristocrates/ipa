                 cdao:IAO_0000117 "GROUP:OBI"@en;
                 cdao:IAO_0000119 "OBI_0000277"@en;
                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:label "in branch"@en.
cdao:IAO_0000114 cdao:IAO_0000111 "has curation status"@en;
                 cdao:IAO_0000117 "PERSON:Melanie Courtot"@en,
                                  "PERSON:Bill Bug"@en,
                                  "PERSON:Alan Ruttenberg"@en;
