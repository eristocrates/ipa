                 rdfs:subClassOf cdao:OBI_0000456.
cdao:OBI_0001154 cdao:IAO_0000111 "induced mutation"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a genetic transformation that the modification of the genetic material (either coding or non-coding) of an organism is caused by mutagenic compounds or irradiation."@en;
                 cdao:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en;
                 cdao:IAO_0000119 "MO_564 induced_mutation"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
