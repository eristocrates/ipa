cdao:OBI_0002598 cdao:IAO_0000111 "inverse polymerase chain reaction";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A polymerase chain reaction which amplifies DNA with only one known sequence from which primers may be designed. A series of restriction digestions and ligations result in a looped DNA fragment which can be primed for PCR.";
                 cdao:IAO_0000117 "Rebecca Tauber";
                 cdao:IAO_0000118 "inverse PCR";
                 cdao:IAO_0000119 "url:https://en.wikipedia.org/wiki/Chromosome_conformation_capture";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "inverse polymerase chain reaction";
                 rdfs:subClassOf cdao:OBI_0000415.
