                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An inclusion criterion that uses the age of majority for a state or institution, where one is generally considered to be an adult, which if met, makes an individual suitable for a given task or participation in a given process.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "NCI BBRB, OBIB";
                 cdao:IAO_0000234 "NCI BBRB";
