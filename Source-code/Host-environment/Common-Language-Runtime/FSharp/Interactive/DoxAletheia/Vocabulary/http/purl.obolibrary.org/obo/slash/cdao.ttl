cdao:OBI_0001865 cdao:IAO_0000111 "assay array"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A device made to be used in an analyte assay for immobilization of substances that bind the analyte at regular spatial positions on a surface.";
                 cdao:IAO_0000117 "PERSON: Chris Stoeckert, Jie Zheng, Alan Ruttenberg";
                 cdao:IAO_0000119 "Penn Group";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "assay array"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000399 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000085 ; 
