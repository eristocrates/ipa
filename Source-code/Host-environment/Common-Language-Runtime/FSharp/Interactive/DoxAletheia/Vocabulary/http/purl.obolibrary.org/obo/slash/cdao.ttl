cdao:GO_0097458 cdao:IAO_0000111 "neuron part";
                cdao:IAO_0000115 "Any constituent part of a neuron, the basic cellular unit of nervous tissue. A typical neuron consists of a cell body (often called the soma), an axon, and dendrites. Their purpose is to receive, conduct, and transmit impulses in the nervous system.";
                cdao:IAO_0000412 cdao:go.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "neuron part";
                rdfs:subClassOf cdao:GO_0005575.
cdao:HP_0000855 cdao:IAO_0000111 "Insulin resistance";
