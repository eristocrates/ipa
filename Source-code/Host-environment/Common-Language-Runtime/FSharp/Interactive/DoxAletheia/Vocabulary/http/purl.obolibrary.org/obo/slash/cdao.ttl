cdao:OBI_0000594 cdao:IAO_0000111 "column adapter"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An Adapter that enabled the connection of a column to additional devices."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01113",
                                  "GROUP:<http://msi-ontology.sourceforge.net>"@en;
                 cdao:IAO_0000232 "chromatography device"@en;
