cdao:OBI_0002107 cdao:IAO_0000111 "bio-layer interferometry assay";
                 cdao:IAO_0000112 "Detecting the presence of an antibody in a cell culture supernatant by detecting a shift in the interference pattern reflected from a layer of immobilized protein to which the antibody binds.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A binding assay that detects a shift in the interference pattern reflected from a layer of immobilized material on the biosensor tip to measure binding to- or dissociating from the material on the biosensor.";
                 cdao:IAO_0000117 "IEDB";
                 cdao:IAO_0000118 "biolayer interferometry, BLI";
                 cdao:IAO_0000119 "IEDB";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "bio-layer interferometry assay";
                 rdfs:subClassOf cdao:OBI_0001146.
cdao:OBI_0002108 cdao:IAO_0000111 "small-angle scattering assay";
                 cdao:IAO_0000112 "Targeting a solution of antibody bound to a protein with a neutron beam to determine the binding site of the antibody on the protein";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A 3D structure determination assay in which the scattering pattern of a neutron or x-ray beam targeted at a material entity is recorded at small angles relative to the incident beam to determine the size, shape and structure of the material entity examined.";
                 cdao:IAO_0000117 "IEDB";
                 cdao:IAO_0000118 "SAXS";
