cdao:OBI_0600022 cdao:IAO_0000111 "excision"@en;
                 cdao:IAO_0000112 "Cutting out the portion of a gel which contains a DNA fragment"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "the use physical means to remove a portion of a substance from the rest"@en;
                 cdao:IAO_0000117 "Alan Ruttenberg, Kevin Clancy"@en;
                 cdao:IAO_0000119 "www.crohnsresource.com/glossary.jsp (via google define:resection)"@en;
