cdao:OBI_0000307 cdao:IAO_0000111 "obsoleted_is_reagent_in";
                 cdao:IAO_0000112 "some Triton X-100 (Sigma-Aldrich) is_reagent_in instance of Chromium Release Assay described at  https://wiki.cbil.upenn.edu/obiwiki/index.php/Chromium_Release_assay"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Relationship between a substance and a protocol application in which it participates, where the substance has a ReagentRole"@en;
                 cdao:IAO_0000117 "Alan Ruttenberg"@en;
                 cdao:IAO_0000231 cdao:IAO_0000103;
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:label "obsoleted_is_reagent_in"@en;
