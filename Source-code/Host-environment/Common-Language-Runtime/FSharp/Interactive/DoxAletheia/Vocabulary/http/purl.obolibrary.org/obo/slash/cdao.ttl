                 cdao:IAO_0000117 "Bjoern Peters";
                 cdao:IAO_0000119 "PMID:26404144";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Southwestern blot assay";
                 rdfs:subClassOf cdao:OBI_0001591.
cdao:OBI_0002174 cdao:IAO_0000111 "immunocytochemistry";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An immuno staining assay in which samples of intact cells are examined that have had most, if not all, of their surrounding extracellular matrix removed";
                 cdao:IAO_0000117 "Bjoern Peters";
                 a <http://www.w3.org/2002/07/owl#Class>;
