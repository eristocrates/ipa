cdao:IAO_0000057 cdao:IAO_0000111 "contour plot"@en;
                 cdao:IAO_0000112 "Contour plot of SSC-H, FSC-H, and FL1-H."@en;
                 cdao:IAO_0000114 cdao:IAO_0000002;
                 cdao:IAO_0000116 "generically_dependent_continuants"@en;
