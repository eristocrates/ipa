                 cdao:IAO_0000114 cdao:IAO_0000122;
                 cdao:IAO_0000115 "An alternative term used by the IEDB.";
                 cdao:IAO_0000117 "PERSON:Randi Vita, Jason Greenbaum, Bjoern Peters";
                 cdao:IAO_0000119 "IEDB";
                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:label "IEDB alternative term";
