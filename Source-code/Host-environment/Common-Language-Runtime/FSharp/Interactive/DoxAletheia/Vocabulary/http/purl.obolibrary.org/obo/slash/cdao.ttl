                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "computation run time"@en;
                 rdfs:subClassOf cdao:IAO_0000416,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0200000 ; 
