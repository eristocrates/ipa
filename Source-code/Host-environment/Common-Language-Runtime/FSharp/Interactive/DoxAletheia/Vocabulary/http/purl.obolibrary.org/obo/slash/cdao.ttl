cdao:OBI_0600023 cdao:IAO_0000111 "non specific enzymatic cleavage"@en;
                 cdao:IAO_0000112 "The use of agarase to digest an agar gel"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "a protocol application to digest the fraction of input material that is susceptible to that enzyme"@en;
