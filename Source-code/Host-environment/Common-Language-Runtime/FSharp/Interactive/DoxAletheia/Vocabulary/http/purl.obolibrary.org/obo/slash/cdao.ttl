                                 cdao:OBI_0000011,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:IAO_0000027
                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:BFO_0000040
                                                                                                                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000067 ; 
                                                                                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000087 ; 
                                                                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
