cdao:OBI_0000799 cdao:IAO_0000111 "recombinant phage cloning";
                 cdao:IAO_0000112 "Insert selection by BamHI methyltransferase protection in P1 phage-based cloning";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Recombinant phage cloning is the process of using a phage plus some insert nucleic acid for the purposes of amplification of the insert material achieved by phage assembly in vitro.";
                 cdao:IAO_0000117 "Helen Parkinson";
