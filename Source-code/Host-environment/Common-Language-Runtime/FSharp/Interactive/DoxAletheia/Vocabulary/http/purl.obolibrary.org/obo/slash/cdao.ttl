                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:BFO_0000034
                                                                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000703 ; 
                                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000052 ; 
                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000055 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000703 ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>].
cdao:OBI_0000725 cdao:IAO_0000111 "host role";
                 cdao:IAO_0000112 "In biology, a host is an organism that harbors a virus or parasite, or a mutual or commensal symbiont, typically providing nourishment and shelter.  http://en.wikipedia.org/wiki/Host_(biology)  30 March 09";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "host role is a role played by an organism and realized by providing nourishment, shelter or a means of reproduction to another organism within the organism playing the host role";
                 cdao:IAO_0000116 """30Mar09 virus reproducing inside a cell; bacteria causing a disease, host can be harmed or not.  we want to avoid a cat sitting on my lap and an animal care technician; these are not examples or hosts; dental cares = on tooth, but part of outer layer of tooth, so covered by \"within\" in the definition""";
                 cdao:IAO_0000117 "GROUP: Role Branch";
                 cdao:IAO_0000119 "30 Mar09 submitted by vaccine community",
                                  "OBI",
                                  "http://en.wikipedia.org/wiki/Host_(biology)";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "host role";
                 rdfs:subClassOf cdao:BFO_0000023,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0100026 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000052 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0000726 cdao:IAO_0000111 "peak matching";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "Peak matching is a data transformation performed on a dataset of a graph of ordered data points (e.g. a spectrum) with the objective of pattern matching local maxima above a noise threshold";
                 cdao:IAO_0000117 "Ryan Brinkman",
                                  "James Malone";
                 cdao:IAO_0000119 "PERSON: Ryan Brinkman";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "peak matching";
                 rdfs:subClassOf cdao:OBI_0200000.
cdao:OBI_0000727 cdao:IAO_0000111 "k-nearest neighbors"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "A k-nearest neighbors is a data transformation which achieves a class discovery or partitioning objective, in which an input data object with vector y is assigned to a class label based upon the k closest training data set points to y; where k is the largest value that class label is assigned."@en;
                 cdao:IAO_0000117 "James Malone"@en;
                 cdao:IAO_0000118 "k-NN";
                 cdao:IAO_0000119 "PERSON: James Malone"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "k-nearest neighbors"@en;
