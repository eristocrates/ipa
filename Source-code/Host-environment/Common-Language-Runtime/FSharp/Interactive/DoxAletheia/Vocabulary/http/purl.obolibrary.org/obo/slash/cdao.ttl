                rdfs:label "nanoliter".
cdao:UO_0000103 cdao:IAO_0000111 "picoliter";
                cdao:IAO_0000115 "A volume unit which is equal to 10^[-12] L.";
                cdao:IAO_0000118 "pl";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000095,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "picoliter".
cdao:UO_0000105 cdao:IAO_0000111 "frequency unit";
                cdao:IAO_0000115 "A unit which is a standard measure of the number of repetitive actions in a particular time.";
                cdao:IAO_0000412 cdao:uo.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "frequency unit";
                rdfs:subClassOf cdao:IAO_0000003.
cdao:UO_0000106 cdao:IAO_0000111 "hertz";
                cdao:IAO_0000115 "A frequency unit which is equal to 1 complete cycle of a recurring phenomenon in 1 second.";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000105,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "hertz".
cdao:UO_0000109 cdao:IAO_0000111 "pressure unit";
                cdao:IAO_0000115 "A unit which is a standard measure of the force applied to a given area.";
                cdao:IAO_0000412 cdao:uo.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "pressure unit";
                rdfs:subClassOf cdao:IAO_0000003.
cdao:UO_0000163 cdao:IAO_0000111 "mass percentage";
                cdao:IAO_0000115 "A dimensionless concentration unit which denotes the mass of a substance in a mixture as a percentage of the mass of the entire mixture.";
                cdao:IAO_0000118 "percent weight pr weight",
                                 "% w/w";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "mass percentage".
cdao:UO_0000164 cdao:IAO_0000111 "mass volume percentage";
                cdao:IAO_0000115 "A dimensionless concentration unit which denotes the mass of the substance in a mixture as a percentage of the volume of the entire mixture.";
                cdao:IAO_0000118 "percent vol per vol",
                                 "% w/v";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "mass volume percentage".
cdao:UO_0000165 cdao:IAO_0000111 "volume percentage";
                cdao:IAO_0000115 "A dimensionless concentration unit which denotes the volume of the solute in mL per 100 mL of the resulting solution.";
                cdao:IAO_0000118 "percent vol per vol",
                                 "% v/v";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "volume percentage".
cdao:UO_0000175 cdao:IAO_0000111 "gram per liter";
                cdao:IAO_0000115 "A mass unit density which is equal to mass of an object in grams divided by the volume in liters.";
                cdao:IAO_0000118 "g/L",
                                 "g per L";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "gram per liter".
cdao:UO_0000176 cdao:IAO_0000111 "milligram per milliliter";
                cdao:IAO_0000115 "A mass unit density which is equal to mass of an object in milligrams divided by the volume in milliliters.";
                cdao:IAO_0000118 "mg/ml",
                                 "mg per ml";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "milligram per milliliter".
cdao:UO_0000195 cdao:IAO_0000111 "degree Fahrenheit";
                cdao:IAO_0000115 "A temperature unit which is equal to 5/9ths of a kelvin. Negative 40 degrees Fahrenheit is equal to negative 40 degrees Celsius.";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000005,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "degree Fahrenheit".
cdao:UO_0000196 cdao:IAO_0000111 "pH";
                cdao:IAO_0000115 "A dimensionless concentration notation which denotes the acidity of a solution in terms of activity of hydrogen ions (H+).";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "pH".
cdao:UO_0000207 cdao:IAO_0000111 "milliliter per liter";
                cdao:IAO_0000115 "A volume per unit volume unit which is equal to one millionth of a liter of solute in one liter of solution.";
                cdao:IAO_0000118 "ml/l",
                                 "ml per L";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "milliliter per liter".
cdao:UO_0000208 cdao:IAO_0000111 "gram per deciliter";
                cdao:IAO_0000115 "A mass density unit which is equal to mass of an object in grams divided by the volume in deciliters.";
                cdao:IAO_0000118 "g/dl";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "gram per deciliter".
cdao:UO_0000212 cdao:IAO_0000111 "colony forming unit per volume";
                cdao:IAO_0000115 "A concentration unit which a measure of viable bacterial numbers in a given volume.";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "colony forming unit per volume".
cdao:UO_0000270 cdao:IAO_0000111 "volumetric flow rate unit";
                cdao:IAO_0000115 "A unit which is a standard measure of the volume of fluid which passes through a given surface per unit time .";
                cdao:IAO_0000412 cdao:uo.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "volumetric flow rate unit";
                rdfs:subClassOf cdao:IAO_0000003.
cdao:UO_0000271 cdao:IAO_0000111 "microliters per minute";
                cdao:IAO_0000115 "A volumetric flow rate unit which is equal to one microliter volume through a given surface in one minute.";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000270,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "microliters per minute".
cdao:UO_0000280 cdao:IAO_0000111 "rate unit";
                cdao:IAO_0000115 "A unit which represents a standard measurement occurrence of a process per unit time.";
                cdao:IAO_0000412 cdao:uo.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "rate unit";
                rdfs:subClassOf cdao:IAO_0000003.
cdao:UO_0000281 cdao:IAO_0000111 "count per nanomolar second";
                cdao:IAO_0000115 "A rate unit which is equal to one over one nanomolar second.";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000280,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "count per nanomolar second".
cdao:UO_0000282 cdao:IAO_0000111 "count per molar second";
                cdao:IAO_0000115 "A rate unit which is equal to one over one molar second.";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000280,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "count per molar second".
cdao:UO_0000284 cdao:IAO_0000111 "count per nanomolar";
                cdao:IAO_0000115 "A rate unit which is equal to one over one nanomolar.";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000280,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "count per nanomolar".
cdao:UO_0000285 cdao:IAO_0000111 "count per molar";
                cdao:IAO_0000115 "A rate unit which is equal to one over one molar.";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000280,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "count per molar".
cdao:UO_0000301 cdao:IAO_0000111 "microgram per liter";
                cdao:IAO_0000115 "A mass unit density which is equal to mass of an object in micrograms divided by the volume in liters.";
                cdao:IAO_0000118 "ug/L",
                                 "ng/ml";
                cdao:IAO_0000412 cdao:uo.owl;
                a cdao:UO_0000051,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:label "microgram per liter".
cdao:VO_0000001 cdao:IAO_0000111 "vaccine";
                cdao:IAO_0000115 "A vaccine is a processed material with the function that when administered, it prevents or ameliorates a disorder in a target organism by inducing or modifying adaptive immune responses specific to the antigens in the vaccine.";
                cdao:IAO_0000412 cdao:vo.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "vaccine";
                rdfs:subClassOf cdao:BFO_0000040.
cdao:VO_0000002 cdao:IAO_0000111 "vaccination";
                cdao:IAO_0000115 "a process of administering substance in vivo that involves in adding a vaccine into a host (e.g., human) in vivo with the intent to invoke a protective or therapeutic adaptive immune response.";
                cdao:IAO_0000412 cdao:vo.owl;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "vaccination";
                rdfs:subClassOf cdao:OBI_0600007.
cdao:iao.owl a <http://www.w3.org/2002/07/owl#NamedIndividual>.
