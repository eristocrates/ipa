                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0600040 cdao:IAO_0000111 "synthesis";
                 cdao:IAO_0000112 "making cDNA from nucleotides using RNA as a template"@en;
                 cdao:IAO_0000114 cdao:IAO_0000125;
                 cdao:IAO_0000115 "the construction of a biomaterial from simpler biomaterials"@en;
                 cdao:IAO_0000116 "This probably needs breaking down into more specific applications. The example given is already covered in reverse_transcription"@en;
                 cdao:IAO_0000117 "PERSON:Kevin Clancy"@en;
                 cdao:IAO_0000118 "synthesize"@en;
                 cdao:IAO_0000119 "OBI branch derived"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "synthesis"@en;
