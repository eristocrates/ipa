                                 cdao:PR_000000001.
cdao:OBI_0000734 cdao:IAO_0000111 "DNA sequencing by synthesis assay";
                 cdao:IAO_0000112 "Roche-454 pyrosequencing and Illumina (Solexa) sequencing use synthesis-based method for DNA sequencing";
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A DNA sequencing assay that relies on DNA polymerase activity to perform chain extension during the sequencing reaction step.";
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "url:https://www.illumina.com/technology/next-generation-sequencing/sequencing-technology.html";
