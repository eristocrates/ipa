                 cdao:IAO_0000112 "PMID: 18246869. Loss of cortical function in mice after decapitation, cervical dislocation, potassium chloride injection, and CO2 inhalation. Comp Med. 2007 Dec;57(6):570-"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "decapitation is a process by which the head of a living organism is physically removed from the body, usually resulting in rapid death (in the case of Rhodnius prolixus, it might take a bit longer..)"@en;
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "OBI-Branch";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "decapitation"@en;
                 rdfs:subClassOf cdao:OBI_0000919.
cdao:OBI_0302900 cdao:IAO_0000111 "group randomization";
                 cdao:IAO_0000112 "PMID: 18349405. Randomization reveals unexpected acute leukemias in Southwest Oncology Group prostate cancer trial. J Clin Oncol. 2008 Mar 20;26(9):1532-6."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A group assignment which relies on chance to assign materials to a group of materials in order to avoid bias in experimental set up."@en;
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "adapted from wikipedia [http://en.wikipedia.org/wiki/Randomization]";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "group randomization"@en;
                 rdfs:subClassOf cdao:OBI_0600015.
