cdao:OBI_0002453 cdao:IAO_0000111 "health status inclusion criterion"@en;
                 cdao:IAO_0000112 "‘diagnosed with Type 2 diabetes mellitus’, ‘E11.4’, ’not finding of hypertension'"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An inclusion criterion that defines and states one or more clinically significant bodily components, dispositions, and/or bodily processes of an entity that are inferred from relevant clinical findings or self-reported, which, if met, makes the entity suitable for a given task or participation in a given process."@en;
                 cdao:IAO_0000117 "Mathias Brochhausen"@en;
                 cdao:IAO_0000234 "MIABIS2.0"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "health status inclusion criterion"@en;
                 rdfs:subClassOf cdao:OBI_0500027.
cdao:OBI_0002454 cdao:IAO_0000111 "clinically relevant lifestyle inclusion criterion"@en;
                 cdao:IAO_0000112 "'smoking behavior’"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An inclusion criterion that defines and states one or more clinically relevant planned processes that a human being actively participates in , which, if met, makes the human being suitable for a given task or participation in a given process."@en;
                 cdao:IAO_0000117 "Mathias Brochhausen"@en;
                 cdao:IAO_0000234 "MIABIS2.0"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "clinically relevant lifestyle inclusion criterion"@en;
                 rdfs:subClassOf cdao:OBI_0500027.
cdao:OBI_0002455 cdao:IAO_0000111 "clinically relevant exposure inclusion criterion"@en;
                 cdao:IAO_0000112 "'exposure to cigarette smoke’, ‘exposure to lead through drinking water'"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An inclusion criterion that defines and states one or more clinically relevant histories of exposure of an entity, which, if met, makes the entity suitable for a given task or participation in a given process."@en;
                 cdao:IAO_0000117 "Mathias Brochhausen"@en;
                 cdao:IAO_0000234 "MIABIS2.0"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "clinically relevant exposure inclusion criterion"@en;
                 rdfs:subClassOf cdao:OBI_0500027.
cdao:OBI_0002456 cdao:IAO_0000111 "gravidity inclusion criterion"@en;
                 cdao:IAO_0000112 "'pregnant’, ‘not pregnant'"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "An inclusion criterion that defines and states one or more gravidity statuses of an organism, which, if met, makes the entity suitable for a given task or participation in a given process."@en;
                 cdao:IAO_0000117 "Mathias Brochhausen"@en;
                 cdao:IAO_0000234 "MIABIS2.0"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "gravidity inclusion criterion"@en;
                 rdfs:subClassOf cdao:OBI_0500027.
cdao:OBI_0002457 cdao:IAO_0000111 "precision nuclear run-on sequencing assay";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An RNA-seq assay that maps the genome-wide distribution of transcriptionally-engaged Pol II at base-pair resolution by using biotin-labeled ribonucleotide triphosphate analogs (biotin-NTP) for nuclear run-on reactions, allowing the efficient affinity purification of nascent RNAs for high throughput sequencing from their 3' ends.";
                 cdao:IAO_0000117 "Rebecca Tauber";
                 cdao:IAO_0000118 "PRO-Seq",
                                  "precision nuclear run-on and sequencing assay";
                 cdao:IAO_0000119 "PMID:23430654";
                 cdao:IAO_0000233 "https://github.com/obi-ontology/obi/issues/876";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "precision nuclear run-on sequencing assay";
                 rdfs:subClassOf cdao:OBI_0001271,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000552 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0002458 cdao:IAO_0000111 "chromosome conformation capture-on-chip assay";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A nuclear ligation assay which uses cross-linking of proteins to proteins and DNA, followed by two rounds of digestion and ligation, inverse PCR, and characterization by microarray or DNA sequencing. This enables unbiased genome-wide screens for DNA contacts made by single genomic sites of interest.";
                 cdao:IAO_0000117 "Rebecca Tauber";
                 cdao:IAO_0000118 "circularized chromosome conformation capture assay",
                                  "4C assay";
                 cdao:IAO_0000119 "url:http://www.sciencedirect.com/science/article/pii/B9780123919380000045";
                 cdao:IAO_0000233 "https://github.com/obi-ontology/obi/issues/875";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "chromosome conformation capture-on-chip assay";
                 rdfs:subClassOf cdao:OBI_0002438,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0002598 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:BFO_0000051 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
