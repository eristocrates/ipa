                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:OBI_0100051.
cdao:OBI_0000681 cdao:IAO_0000111 "separation into different composition objective";
                 cdao:IAO_0000112 "The objective to obtain cells contained in a sample of blood.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A material separation objective aiming to separate a material entity that has parts of different types, and end with at least one output that is a material with parts of fewer types (modulo impurities).";
                 cdao:IAO_0000116 "We should be using has the grain relations or concentrations to distinguish the portioning and other sub-objectives";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "separation into different composition objective";
                 rdfs:subClassOf cdao:OBI_0000639.
cdao:OBI_0000682 cdao:IAO_0000111 "study result";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "Study result is an information content entity  that is a specified data output of a study.";
                 cdao:IAO_0000119 "GROUP: OBI";
                 cdao:IAO_0000231 cdao:IAO_0000230;
                 cdao:IAO_0000232 "2009-02-28: work on this term has been finalized during the OBI workshop winter 2009";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "obsolete_study result";
                 rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass>;
                 <http://www.w3.org/2002/07/owl#deprecated> true.
