                 rdfs:label "biological replicate role"@en;
                 rdfs:subClassOf cdao:OBI_0000220.
cdao:OBI_0000201 cdao:IAO_0000111 "radioactivity detection";
                 cdao:IAO_0000112 "Placing the evaluant input material close to a scintillation counter which emits light upon being hit with alpha/beta/gamma radiation and counting the frequency of light blasts to determine the radioactivity of the input material.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An assay that measures the amount of radiation in the radioactive spectrum (alpha, beta or gamma rays) emitted from an input material.";
                 cdao:IAO_0000117 "PlanAndPlannedProcess Branch",
                                  "IEDB";
