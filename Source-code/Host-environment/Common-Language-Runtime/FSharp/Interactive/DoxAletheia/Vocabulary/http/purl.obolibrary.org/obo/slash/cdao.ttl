                                 cdao:OBI_0000880.
cdao:OBI_0000870 cdao:IAO_0000111 "single-nucleotide-resolution nucleic acid structure mapping assay";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An assay that provides information about the secondary structure of nucleic acids using chemical or enzymatic probing to establish the extent of base-pairing or solvent accessiblity.";
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "RNAO";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "single-nucleotide-resolution nucleic acid structure mapping assay";
                 rdfs:subClassOf cdao:OBI_0000070;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0000070
                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000885 ; 
                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:IAO_0000136 ; 
