cdao:OBI_0000480 cdao:IAO_0000111 "Bruker high resolution probe"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "BRUKER BIOSPIN's experienced Research & Development group not only delivers top-performance probes for the more common experiments, but also a wealth of special probes for almost any application. For high resolution (HR) NMR we offer probes with a variety of important characteristics and features."@en;
                 cdao:IAO_0000117 "PERSON:Daniel Schober"@en;
                 cdao:IAO_0000118 "HR Probe"@en;
                 cdao:IAO_0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400223",
