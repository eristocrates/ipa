                                  a <http://www.w3.org/2002/07/owl#Restriction>].
cdao:OBI_0000040 cdao:IAO_0000111 "drug role"@en;
                 cdao:IAO_0000112 """http://www.answers.com/topic/drug
   1. A substance used in the diagnosis, treatment, or prevention of a disease or as a component of a medication.
   2. Such a substance as recognized or defined by the U.S. Food, Drug, and Cosmetic Act.""";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a role borne by a molecular entity and is realized in a process of absorption by an organism  alters, or effects  (or is assumed to effect) a function(s) which inhere in an organism"@en;
                 cdao:IAO_0000117 "Role Branch"@en;
                 cdao:IAO_0000118 "drug";
                 cdao:IAO_0000119 "OBI, CDISC"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "drug role"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:CHEBI_23367 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:RO_0000052 ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 cdao:BFO_0000023.
cdao:OBI_0000041 cdao:IAO_0000111 "pump valve switch"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A pump valve switch is a cardinal part of a liquid chromatography instrument that controls the flow."@en;
                 cdao:IAO_0000116 "FG:I would assume this should be a pump valve control switch and it would not be specific to a liquid chromatography instrument"@en;
                 cdao:IAO_0000117 "OBI Instrument branch"@en;
                 cdao:IAO_0000119 "OBI"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "pump valve switch"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0000379 ; 
