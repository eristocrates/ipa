cdao:OBI_1110026 cdao:IAO_0000111 "host of immune response";
                 cdao:IAO_0000112 "A mouse that is vaccinated with a peptide and develops protective immunity. A human exposed to bacteria that are killed by pre-existing immune responses.";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An organism in which an immune response process occurs."@en;
                 cdao:IAO_0000116 "In immune response processes in the context of infectious diseases and allergy, there are often multiple organisms involved, which requires calling out the 'host'. This terminology is expanded to allergy, cancer and  transplantation.";
                 cdao:IAO_0000117 "IEDB"@en;
                 cdao:IAO_0000119 "IEDB"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "host of immune response"@en;
                 rdfs:subClassOf cdao:OBI_0100026;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (cdao:OBI_0100026
                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_1110083 ; 
