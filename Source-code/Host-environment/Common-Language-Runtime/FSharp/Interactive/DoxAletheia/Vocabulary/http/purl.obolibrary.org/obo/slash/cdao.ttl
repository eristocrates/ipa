cdao:OBI_0001943 cdao:IAO_0000111 "software pipeline"@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A plan specification that specifies a chain encoded in software of processing elements (processes, threads, coroutines, etc.), arranged so that the output of each element is the input of the next. Usually some amount of buffering is provided between consecutive elements.";
                 cdao:IAO_0000117 "PERSON: Jie Zheng, Chris Stoeckert";
                 cdao:IAO_0000119 "WEB: http://en.wikipedia.org/wiki/Pipeline_%28software%29";
                 <http://purl.org/dc/elements/1.1/source> "NIAID GSCID-BRC";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "software pipeline"@en;
                 rdfs:subClassOf cdao:IAO_0000104.
