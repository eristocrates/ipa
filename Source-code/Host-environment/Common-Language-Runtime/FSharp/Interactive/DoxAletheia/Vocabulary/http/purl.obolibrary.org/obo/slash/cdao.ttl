                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "A menopausal status indicating that less than 6 months has passed since the last menstrual period and there has not been prior bilateral oophorectomy and not on estrogen replacement.";
                 cdao:IAO_0000117 "Chris Stoeckert, Helena Ellis";
                 cdao:IAO_0000119 "NCI BBRB, OBIB";
