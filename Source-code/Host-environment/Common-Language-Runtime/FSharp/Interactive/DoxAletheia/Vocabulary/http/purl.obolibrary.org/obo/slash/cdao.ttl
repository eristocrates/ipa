cdao:OBI_0302911 cdao:IAO_0000111 "validation";
                 cdao:IAO_0000112 "PMID: 18557814 . Chemical and genetic validation of dihydrofolate reductase-thymidylate synthase as a drug target in African trypanosomes. Mol Microbiol. 2008 Jun 16."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a planned process with objective to check that the accuracy or the quality of a claim or prediction  satisfies some criteria and which is assessed by comparing with independent results"@en;
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000119 "adapted from wordnet (wkipedia)";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "validation"@en;
                 rdfs:subClassOf cdao:OBI_0000011.
cdao:OBI_0302912 cdao:IAO_0000111 "electroporation";
                 cdao:IAO_0000112 "PMID: 18551712. Microfluidic electroporation for selective release of intracellular molecules at the single-cell level. Electrophoresis. 2008 Jun 13."@en;
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "a process in which a significant increase in the electrical conductivity and permeability of the cell plasma membrane caused by an externally applied electrical field. It is usually used in molecular biology as a way of introducing some substance into a cell, such as loading it with a molecular probe, a drug that can change the cell's function, or a piece of coding DNA"@en;
                 cdao:IAO_0000117 "Philippe Rocca-Serra";
                 cdao:IAO_0000118 "electropermeabilization";
                 cdao:IAO_0000119 "WEB:http://en.wikipedia.org/wiki/Electroporation";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "electroporation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:CL_0000000 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000293 ; 
