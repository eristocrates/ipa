cdao:OBI_0002460 cdao:IAO_0000111 "defined population inclusion criterion";
                 cdao:IAO_0000112 "inclusion based on age, sex, and living region (rural area or specified city).";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "An inclusion criterion that is based on fitting within the defined characteristics of a population based study design.";
                 cdao:IAO_0000117 "Chris Stoeckert, Mathias Brochhausen";
