cdao:OBI_0000685 cdao:IAO_0000111 "creating a mixture of molecules in solution";
                 cdao:IAO_0000112 "The production of PBS";
                 cdao:IAO_0000114 cdao:IAO_0000120;
                 cdao:IAO_0000115 "is a process with the objective to prepare a liquid solution of one or more chemicals at desired concentrations.";
                 cdao:IAO_0000117 "Bjoern Peters";
                 cdao:IAO_0000119 "PERSON: Helen Parkinson";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "creating a mixture of molecules in solution";
                 rdfs:subClassOf cdao:OBI_0000652,
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cdao:OBI_0302729 ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cdao:OBI_0000299 ; 
