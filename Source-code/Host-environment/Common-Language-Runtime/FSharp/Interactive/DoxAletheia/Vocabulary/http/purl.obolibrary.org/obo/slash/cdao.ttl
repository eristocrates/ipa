cdao:OBI_0002461 cdao:IAO_0000111 "BCL format"@en;
                 cdao:IAO_0000114 cdao:IAO_0000123;
                 cdao:IAO_0000115 "A data format specification that is a binary file containing base calling data. These files are created by sequencing machines during the act of sequencing, and contain data about each of the nucleotide clusters on a sequencing flow cell."@en;
                 cdao:IAO_0000117 "Stephen A. Fisher, Junhyong Kim, Dan Berrios"@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "BCL format"@en;
                 rdfs:subClassOf cdao:IAO_0000098.
cdao:OBI_0002462 cdao:IAO_0000111 "ERCC RNA spike-in";
