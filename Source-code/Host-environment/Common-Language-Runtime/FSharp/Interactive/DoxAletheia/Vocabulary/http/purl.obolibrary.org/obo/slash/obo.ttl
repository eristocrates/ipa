                                                                                         [owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000040
                                                                                                                                 [owl:someValuesFrom pobo:PATO_0000018 ; 
                                                                                                                                 owl:onProperty pobo:RO_0000053 ; 
                                                                                                                                 a owl:Restriction]
                                                                                                                                 [owl:someValuesFrom obi:0000250 ; 
