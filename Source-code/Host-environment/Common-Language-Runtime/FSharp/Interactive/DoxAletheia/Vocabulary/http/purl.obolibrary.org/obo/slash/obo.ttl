                            obi:0000070,
                            [owl:someValuesFrom iao:0000109 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction].
obi:0600018 iao:0000111 "material portioning"@en;
            iao:0000112 "pouring 50 mL aliquots of fetal calf serum into conical tubes from a 500 mL stock"@en;
            iao:0000114 iao:0000123;
            iao:0000115 "a material processing in which the input substance is partitioned into a number of portions that are similar in composition."@en;
            iao:0000117 "PERSON:Bjoern Peters"@en;
            iao:0000118 "apportioning"@en,
                        "aliquoting"@en;
            iao:0000119 "OBI branch derived"@en;
            a owl:Class;
