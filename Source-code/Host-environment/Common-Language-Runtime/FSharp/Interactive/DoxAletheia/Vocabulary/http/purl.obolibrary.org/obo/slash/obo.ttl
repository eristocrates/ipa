obi:0002107 iao:0000111 "bio-layer interferometry assay";
            iao:0000112 "Detecting the presence of an antibody in a cell culture supernatant by detecting a shift in the interference pattern reflected from a layer of immobilized protein to which the antibody binds.";
            iao:0000114 iao:0000120;
            iao:0000115 "A binding assay that detects a shift in the interference pattern reflected from a layer of immobilized material on the biosensor tip to measure binding to- or dissociating from the material on the biosensor.";
            iao:0000117 "IEDB";
            iao:0000118 "biolayer interferometry, BLI";
            iao:0000119 "IEDB";
