obi:0001958 iao:0000111 "systematic review study design";
            iao:0000112 "The effect of moderate gestational alcohol consumption during pregnancy on speech and language outcomes in children: a systematic review. http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3892059/",
                        "Red blood cell transfusion in patients with traumatic brain injury: a systematic review protocol. http://www.ncbi.nlm.nih.gov/pmc/articles/PMC4090399/";
            iao:0000114 iao:0000120;
            iao:0000115 "A study design for identifying in the literature prior studies of a pre-determined phenomenon or set of related phenomena according to certain criteria, extracting findings from these studies, and summarizing these findings and/or attempting to draw new conclusions from them which were not justified by any of the individual, prior studies. Many systematic reviews also assess the quality of the studies so reviewed.";
            iao:0000117 "PERSON: Bill Hogan";
            a owl:Class;
            rdfs:label "systematic review study design";
            rdfs:subClassOf obi:0500000.
obi:0001959 iao:0000111 "multiplexed nucleotide library sequencing"@en;
            iao:0000112 "http://www.illumina.com/technology/multiplexing_sequencing_assay.ilmn"@en;
            iao:0000114 iao:0000122;
            iao:0000115 """A planned process which consists in running a set of samples as a pool on a sequencing instrument, while retaining the ability to associate individual results to each of the individual input samples through the use of a ligated oligonucleotide (the \"multiplex identifier sequence\"). This oligonucleotide is  introduced during the sequence library preparation, and is unique to and specific for all library fragments derived from each sample in a sample pool."""@en;
            iao:0000117 "PERSON:Philippe Rocca-Serra"@en,
                        "Dan Berrios";
            iao:0000119 "OBI"@en;
            a owl:Class;
            rdfs:label "multiplexed nucleotide library sequencing"@en;
            rdfs:subClassOf obi:0000094,
                            [owl:someValuesFrom obi:0002602 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom obi:0001970 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction].
