                            [owl:someValuesFrom obi:0100060 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction],
                            obi:0000094.
obi:0000415 iao:0000111 "polymerase chain reaction";
            iao:0000112 "Opisthorchis viverrini: Detection by polymerase chain reaction (PCR) in human stool samples. Exp Parasitol. 2008 Sep 9.  PMID: 18805413"@en;
            iao:0000114 iao:0000123;
            iao:0000115 "PCR is the process in which a DNA polymerase is used to amplify a piece of DNA by in vitro enzymatic replication. As PCR progresses, the DNA thus generated is itself used as a template for replication. This sets in motion a chain reaction in which the DNA template is exponentially amplified."@en;
            iao:0000117 "OBI Plan";
            iao:0000118 "PCR"@en;
            iao:0000119 "adapted from wikipedai";
            a owl:Class;
            rdfs:label "polymerase chain reaction"@en;
            rdfs:subClassOf [owl:someValuesFrom chebi:16991 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom obi:0000456 ; 
                             owl:onProperty obi:0000417 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom obi:0000406 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            obi:0600058,
                            [owl:someValuesFrom [owl:intersectionOf (obi:0000376
                                                                     [owl:someValuesFrom go:0042575 ; 
                                                                     owl:onProperty pobo:RO_0000052 ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class] ; 
                             owl:onProperty pobo:BFO_0000055 ; 
                             a owl:Restriction].
obi:0000416 iao:0000111 "cloning insert role";
            iao:0000114 iao:0000121;
            iao:0000115 "cloning insert role is a role which inheres in DNA or RNA and is realized by the process of being inserted into a cloning vector in a cloning process."@en;
            iao:0000116 """Feb 20, 2009.  from Wikipedia:  cloning of any DNA fragment essentially involves four steps: DNA fragmentation with restriction endonucleases, ligation of DNA fragments to a vector, transfection, and screening/selection.  There are multiple processes involved, it is not just \"cloning process\"""";
            iao:0000117 "GROUP: Role branch";
            iao:0000119 "OBII and Wikipedia";
            a owl:Class;
            rdfs:label "cloning insert role"@en;
            rdfs:subClassOf pobo:BFO_0000023.
obi:0000417 iao:0000111 "achieves_planned_objective";
            iao:0000112 "A cell sorting process achieves the objective specification 'material separation objective'";
            iao:0000114 iao:0000120;
            iao:0000115 "This relation obtains between a planned process and a objective specification when the criteria specified in the objective specification are met at the end of the planned process.";
            iao:0000117 "BP, AR, PPPB branch";
            iao:0000119 "PPPB branch derived";
            iao:0000232 "modified according to email thread from 1/23/09 in accordince with DT and PPPB branch";
            a owl:ObjectProperty;
            rdfs:domain obi:0000011;
            rdfs:label "achieves_planned_objective";
            rdfs:range iao:0000005;
            owl:inverseOf obi:0000833.
