obi:0000802 iao:0000111 "prothrombin time assay";
            iao:0000112 "PMID:19696660#The prothrombin time (PT) was quantitatively determined using RecombiPlasTin (Instrumentation Laboratory Company, Lexington, Massachusetts, USA).";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that measures the prothrombin ratio, which is the prothrombin time for a patient, divided by the result for control plasma. Most commonly the test is preformed using blood plasma. Blood is drawn into a test tube containing liquid citrate, which acts as an anticoagulant. An excess of calcium is added to enable the blood to clot again.Tissue factor (also known as factor III or thromboplastin) is added, and the time the sample takes to clot is measured optically as the prothrombin time, which is compared to a control sample.";
            iao:0000117 "Alan Ruttenberg";
            iao:0000119 "url:http://en.wikipedia.org/wiki/Prothrombin_time@2009/10/06";
            a owl:Class;
            rdfs:label "prothrombin time assay";
            rdfs:subClassOf [owl:someValuesFrom iao:0000032 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom [owl:someValuesFrom go:0007596 ; 
                                                 owl:onProperty iao:0000136 ; 
                                                 a owl:Restriction] ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            obi:0000070.
obi:0000803 iao:0000111 "denaturing";
            iao:0000112 "Denaturing DNA in alcohol";
            iao:0000114 iao:0000123;
            iao:0000115 "Is a process in which the tertiary or secondary structure of a polymer is disrupted";
            iao:0000119 "http://en.wikipedia.org/wiki/Denaturation_%28biochemistry%29";
            a owl:Class;
            rdfs:label "denaturing";
