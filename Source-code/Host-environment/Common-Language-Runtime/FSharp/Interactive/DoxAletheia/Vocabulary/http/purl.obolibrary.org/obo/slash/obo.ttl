                                  owl:onProperty obi:0000643 ; 
                                  a owl:Restriction],
                                 pobo:CLO_0000031.
pobo:CLO_0009829 iao:0000111 "mortal cell line"@en;
                 iao:0000115 "A cell line is able to support only a limited number of passages in vitro.";
                 iao:0000412 pobo:clo.owl;
                 a owl:Class;
                 rdfs:label "mortal cell line"@en;
                 rdfs:subClassOf [owl:onClass obi:0000877 ; 
