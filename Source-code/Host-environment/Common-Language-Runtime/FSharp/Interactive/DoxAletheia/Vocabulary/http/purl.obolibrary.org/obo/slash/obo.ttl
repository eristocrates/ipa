            iao:0000112 "a single Hela cell"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "a cell derived from a multicellular organism that has the potential to replicate indefinitely"@en;
            iao:0000117 "PERSON: Bjoern Peters"@en;
            iao:0000119 "GROUP: OBI Biomaterial Branch"@en;
            iao:0000231 iao:0000228;
            iao:0100001 pobo:CL_0000002;
            a owl:Class;
            rdfs:label "obsolete_immortal cell"@en;
            rdfs:subClassOf oboinowl:ObsoleteClass;
            owl:deprecated true.
obi:0100039 iao:0000111 "fragment derived from protein"@en;
            iao:0000112 "the peptide with sequence SIINFEKL, which is eluted from a cell expressing hen egg lysozyme"@en;
            iao:0000114 iao:0000123;
            iao:0000115 "A material entity which is derived from a  protein"@en;
            iao:0000116 """original term: protein fragment split into synthetic polypeptide and fragment derived from protein
THE DEFINITION OF THIS SUGGESTS WE COVER THIS ALREADY IN PEPTIDE/POLYPETIDE. DO WE NEED THIS AND CAN WE DEAL WITH IT IN SOME OTHER WAY?  JAMES"""@en,
                        "BP:03/21/2010:obsoleted as the class is no longer necessary, and we would otherwise need all kinds of 'fragment derived from' classes. Instead, use composite terms with the relationship 'derived from' some protein OR derived from some part_of protein.",
                        "PRS:22022008. result from protocol_application where input=protein and output=polypeptide or peptide (to capture: derives_from protein)"@en;
            iao:0000117 "PERSON: Bjoern Peters"@en;
            iao:0000119 "GROUP: IEDB"@en;
            iao:0000231 iao:0000103;
            a owl:Class;
            rdfs:label "obsolete_fragment derived from protein"@en;
            rdfs:subClassOf oboinowl:ObsoleteClass;
            owl:deprecated true.
obi:0100046 iao:0000111 "phosphate buffered saline solution"@en;
            iao:0000112 "PMID: 16279733.Dent Mater J. 2005 Sep;24(3):414-21.PBS buffer solutions with different pH values can change porosity of DNA-chitosan complexes."@en;
            iao:0000114 iao:0000122;
            iao:0000115 "Phosphate buffered saline (abbreviated PBS) is a buffer solution commonly used in biochemistry. It is a salty solution containing sodium chloride, sodium phosphate and in some preparations potassium chloride and potassium phosphate. The buffer helps to maintain a constant pH. The concentration usually matches the human body (isotonic)."@en;
            iao:0000117 "PERSON: Philippe Rocca-Serra",
                        "PERSON: Tina Boussard"@en,
                        "PERSON: Melanie Courtot"@en;
            iao:0000118 "PBS buffer"@en;
            iao:0000119 "WEB: http://en.wikipedia.org/wiki/Phosphate_buffered_saline"@en;
            a owl:Class;
            rdfs:label "phosphate buffered saline solution"@en;
