obi:0002423 iao:0000111 "age of majority inclusion criterion";
            iao:0000114 iao:0000120;
            iao:0000115 "An inclusion criterion that uses the age of majority for a state or institution, where one is generally considered to be an adult, which if met, makes an individual suitable for a given task or participation in a given process.";
            iao:0000117 "Chris Stoeckert, Helena Ellis";
