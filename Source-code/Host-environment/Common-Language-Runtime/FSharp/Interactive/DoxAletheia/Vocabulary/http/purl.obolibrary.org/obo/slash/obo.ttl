            iao:0000114 iao:0000123;
            iao:0000115 "a worker role authorized to make study-related decisions and carry out tasks related to the study; this role occurs during the study timeline"@en;
            iao:0000117 "Person: Jennifer Fostel"@en;
            iao:0000118 "sub-investigator";
            iao:0000232 "CDISC definition:  Sub-investigator. Any member of the clinical trial team designated and supervised by the investigator at a trial site to perform critical trial-related procedures and/or to make important trial-related decisions (e.g., associates, residents, research fellows) [ICH] See associates, residents, research fellows"@en;
            a owl:Class;
            rdfs:label "sub-investigator role"@en;
