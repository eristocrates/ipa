            iao:0000112 "The provides_service_consumer_with relation links the service to its primary process it provides for the consumer (as opposed to secondary processual parts of a service process such as payment or documentation).  For example, a 'DNA sequencing service' provides_service_consumer_with 'DNA sequencing' as the essential process performed by the provider for the client.";
            iao:0000114 iao:0000123;
            iao:0000115 "A relation between a service and the primary processual part of the service that is performed by the provider for the consumer.";
            a owl:ObjectProperty;
            rdfs:domain obi:0001173;
            rdfs:label "provides_service_consumer_with";
            rdfs:subPropertyOf pobo:BFO_0000051.
obi:0000109 iao:0000111 "biological vector role";
            iao:0000112 "Some epidemiological aspects and vector role of tick infestation on layers in the Faisalabad district (Pakistan). http://journals.cambridge.org/action/displayAbstract;jsessionid=0373164489D00868AEEF2C556EB4FD29.tomcat1?fromPage=online&aid=624280"@en,
                        "1983 Sci. Amer. Jan. 58/2 Plasmids are routinely used as vectors for introducing foreign DNA into bacteria."@en;
            iao:0000114 iao:0000120;
            iao:0000115 "a biological vector role is a material to be added role that is realized by the process of transmitting material to the organism that is the target of the transmission.";
            iao:0000116 "Feb 20, 2009. The material transmitted can be genetic information (as in cloning vector) or a pathogen (as in a disease vector)",
                        false;
            iao:0000117 "GROUP:  Role Branch";
            iao:0000119 "OBI and Wikipedia";
            iao:0000231 iao:0000103;
            iao:0000232 "6/12/2009 Alan made this a material to be added role, because it was, and because this speeded up reasoning";
            a owl:Class;
            rdfs:label "biological vector role"@en;
            rdfs:subClassOf oboinowl:ObsoleteClass;
            owl:deprecated true.
obi:0000110 iao:0000111 "pH indicator dye role";
            iao:0000112 "phenol red in RPMI; pH=4 indicator dye (also carries reference role)"@en,
                        "bromophenol blue has a pH indicator dye role";
            iao:0000114 iao:0000120;
            iao:0000115 "the role of a dye that is realized when the dye is used in an experiment to measure the pH in a material entity";
            iao:0000117 "Person:Helen Parkinson",
                        "Person: Jennifer Fostel"@en;
            iao:0000118 "pH indicator dye";
