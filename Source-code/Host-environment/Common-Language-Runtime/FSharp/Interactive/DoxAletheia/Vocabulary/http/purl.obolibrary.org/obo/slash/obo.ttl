            iao:0000232 "NMR instrument"@en;
            a owl:Class;
            rdfs:label "Varian GEMINI spectrometer"@en;
            rdfs:subClassOf obi:0000611.
obi:0000478 iao:0000111 "column connector"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A device that connects two or more columns together in a functional way with leak-tight connection, low dead volume, low thermal mass and high inertness."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01236",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
