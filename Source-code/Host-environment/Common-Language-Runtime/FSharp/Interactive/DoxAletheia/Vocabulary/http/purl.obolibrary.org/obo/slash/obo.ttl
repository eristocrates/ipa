obi:0001699 iao:0000111 "antibody cross-blocking assay";
            iao:0000112 "Testing two antibodies that bind the HBV core protein for the ability of one antibody pre-incubated with the protein in solution to inhibit binding to the other antibody which is plate-bound in an ELISA format.";
            iao:0000114 iao:0000120;
            iao:0000115 "A competitive inhibition of binding assay in which two antibodies that are known to bind the same antigen are tested for the ability of one antibody to inhibit binding of the other antibody to the antigen, thereby determining if they have overlapping binding sites.";
            iao:0000117 "IEDB";
            iao:0000118 "antibody inhibition of antibody binding";
            iao:0000119 "IEDB";
            a owl:Class;
