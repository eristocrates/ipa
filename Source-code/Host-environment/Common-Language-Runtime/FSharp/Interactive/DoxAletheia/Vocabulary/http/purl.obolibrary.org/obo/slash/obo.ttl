            iao:0000114 iao:0000120;
            iao:0000115 "An electronic case report form is a digital document used to record all of the protocol required information to be reported for each trial subject. An eCRF has the property that it can be audited and compliant with requirements of 21 CFR Part 11."@en;
            iao:0000117 "person:Jennifer Fostel"@en;
            iao:0000119 "CDISC glossary";
            a owl:Class;
            rdfs:label "electronic case report form"@en;
