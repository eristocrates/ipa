                                                                     a owl:Restriction]) ; 
                                                 a owl:Class] ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            obi:0000070.
obi:0001179 iao:0000111 "epitope protection from infectious challenge experiment";
            iao:0000114 iao:0000120;
            iao:0000115 "An epitope protection experiment in which the ability of the epitope to protect the host from an infection is assessed. ";
            iao:0000117 "Bjoern Peters";
            iao:0000118 "protection from infectious challenge";
            a owl:Class;
            rdfs:label "epitope protection from infectious challenge experiment";
            rdfs:subClassOf obi:0001184.
obi:0001180 iao:0000111 "half maximal effective concentration (EC50)";
            iao:0000112 "Determining the potentency of a drug / antibody / toxicant by measuring a graded dose response curve, and determining the concentration of the compound where 50% of its maximal effect is observed. ";
            iao:0000114 iao:0000120;
            iao:0000115 """half maximal effective concentration (EC50) is a scalar measurement datum corresponding to the concentration of a compound which induces a response halfway between the baseline and maximum after some specified exposure time. 
""";
            iao:0000117 "Bjoern Peters; Randi Vita";
            iao:0000119 "wikipedia";
            a owl:Class;
            rdfs:label "half maximal effective concentration (EC50)";
            rdfs:subClassOf iao:0000032,
                            [owl:someValuesFrom obi:0001172 ; 
                             owl:onProperty iao:0000136 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom uo:0000051 ; 
                             owl:onProperty iao:0000039 ; 
                             a owl:Restriction].
obi:0001181 iao:0000111 "binding datum";
            iao:0000114 iao:0000120;
            iao:0000115 "A data item that states if two or more material entities have the disposition to form a complex, and if so, how strong that disposition is. ";
            iao:0000117 "Bjoern Peters; Randi Vita";
            a owl:Class;
            rdfs:label "binding datum";
            rdfs:subClassOf iao:0000027;
            owl:equivalentClass [owl:intersectionOf (iao:0000027
                                                     [owl:someValuesFrom obi:0001588 ; 
                                                     owl:onProperty iao:0000136 ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class].
obi:0001182 iao:0000111 "negative binding datum";
            iao:0000114 iao:0000123;
            iao:0000115 "A binding datum that states that there is no significant disposition of two or more entities to form a complex";
            a owl:Class;
            rdfs:label "negative binding datum";
            rdfs:subClassOf obi:0001181.
obi:0001183 iao:0000111 "epitope protection from tumor challenge experiment";
            iao:0000114 iao:0000120;
            iao:0000115 "An epitope protection experiment in which the ability of the epitope to protect the host from developing tumors is assessed. ";
            iao:0000117 "Bjoern Peters";
            iao:0000118 "tumor burden after challenge";
            a owl:Class;
            rdfs:label "epitope protection from tumor challenge experiment";
            rdfs:subClassOf obi:0001184.
obi:0001184 iao:0000111 "epitope protection experiment";
            iao:0000114 iao:0000120;
            iao:0000115 "An efficacy of epitope intervention experiment that tests the efficacy of inducing an immune epitope response to prevent disease in a host. ";
            iao:0000117 "Bjoern Peters";
            iao:0000118 "protection from challenge";
            a owl:Class;
            rdfs:label "epitope protection experiment";
            rdfs:subClassOf obi:0001178.
obi:0001185 iao:0000111 "selectively maintained organism"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An organism that is bred to have some uniform behavioral, morphological, physiological, or genetic characteristics with similarly bred organisms";
            iao:0000117 "Bjoern Peters, Helen Parkinson, Philippe Rocca-Serra, Jie Zheng, Chris Stoeckert ";
            iao:0000118 "strain",
                        "ecotype",
                        "cultivar";
            iao:0000119 "MO_9 StrainOrLine, MO_71 Ecotype, MO_124 Cultivar";
