            a owl:Class;
            rdfs:label "author information textual entity"@en;
            rdfs:subClassOf iao:0000300.
iao:0000609 iao:0000111 "author summary section"@en;
            iao:0000112 "The section labelled 'synopsis' in a typical scientific journal article, e.g. in Pendse et al. BMC Genomics. 2013; 14: 136. (http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3608171/)"@en;
            iao:0000115 "A part of a document, distinct from the abstract, that describes the significance and broader context of the document content. The author summary is often written in a non-technical manner and is aimed at both scientists and non-scientist readers."@en;
            iao:0000117 "PERSON: Bill Baumgartner"@en;
            iao:0000118 "synopsis"@en,
                        "author summary"@en,
                        "summary"@en;
