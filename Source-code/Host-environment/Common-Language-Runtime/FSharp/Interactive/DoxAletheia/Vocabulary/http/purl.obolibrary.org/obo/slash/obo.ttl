                             a owl:Restriction],
                            [owl:someValuesFrom chebi:33697 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction].
obi:0600029 iao:0000111 "isolation of cell culture supernatant"@en;
            iao:0000112 "Pouring out a portion of the fluid part of an adherant cell culture growing in a flask.; The centrifugation of a T cell culture followed by aspiration of the supernatant while the cellular pellet remains in the centrifuge tube."@en;
            iao:0000114 iao:0000125;
            iao:0000115 "a protocol which results in the separation of supernatant material from a cell culture"@en;
            iao:0000116 "This does not apply to the case where the cells are lysed"@en;
            iao:0000117 "PlanAndPlannedProcess Branch"@en;
            iao:0000119 "OBI branch derived"@en;
            a owl:Class;
            rdfs:label "isolation of cell culture supernatant"@en;
            rdfs:subClassOf obi:0600014,
                            [owl:someValuesFrom obi:0000681 ; 
                             owl:onProperty obi:0000417 ; 
                             a owl:Restriction].
obi:0600030 iao:0000111 "experimental disease induction"@en;
            iao:0000112 "the injection of mice with LCM virus iv to establish an LCMV infection. Witholding food from animals to induce starvation syndrome."@en;
            iao:0000114 iao:0000125;
            iao:0000115 "a protocol application to induce a specific disease in an organism"@en;
            iao:0000117 "PlanAndPlannedProcess Branch"@en;
            iao:0000119 "OBI branch derived"@en;
            iao:0000232 "could be defined class"@en;
            a owl:Class;
