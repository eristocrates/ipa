                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty obi:0000293 ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class].
obi:0001981 iao:0000111 "disease exacerbation in vivo intervention experiment";
            iao:0000112 "Injecting a set of mice with a peptide and measuring symtoms to determine if their disease course was more severe than the disease course of a set of mice that were not injected with the same peptide.";
            iao:0000114 iao:0000120;
            iao:0000115 "An in vivo intervention experiment that tests the ability of the intervention to increase the severity of a disease in the host.";
            iao:0000116 "Should have data about disease severity as readout; could just use disease for now";
            iao:0000117 "IEDB";
            iao:0000119 "IEDB";
            a owl:Class;
            rdfs:label "disease exacerbation in vivo intervention experiment";
            rdfs:subClassOf obi:0001980.
obi:0001982 iao:0000111 "protection from challenge in vivo intervention experiment";
            iao:0000112 "Injecting a set of mice with a peptide and measuring symtoms to determine if their disease course was less severe than the disease course of a set of mice that were not injected with the same peptide.";
            iao:0000114 iao:0000120;
            iao:0000115 "An in vivo intervention experiment that tests the ability of the intervention to prevent occurrence of a disease in a host.";
            iao:0000116 "should have challenge as intervention";
            iao:0000117 "IEDB";
            iao:0000119 "IEDB";
            a owl:Class;
            rdfs:label "protection from challenge in vivo intervention experiment";
            rdfs:subClassOf obi:0001980.
obi:0001983 iao:0000111 "tolerance induction intervention experiment";
            iao:0000112 "Injecting a set of mice with a Der p 2 peptide and measuring the IL-2 response of T cells from those mice when exposed to the Der p 2 protein in vitro to determine if those T cells made less IL-2 than cells taken from mice which were not injected with the same Der p 2 peptide.";
            iao:0000114 iao:0000120;
            iao:0000115 "An in vivo intervention experiment that tests the ability of the intervention to decrease an immune response.";
            iao:0000116 "should have tolerance induction as intervention";
            iao:0000117 "IEDB";
            iao:0000119 "IEDB";
            a owl:Class;
            rdfs:label "tolerance induction intervention experiment";
            rdfs:subClassOf obi:0001980.
obi:0001984 iao:0000111 "treatment intervention experiment";
            iao:0000112 "Testing if administering oral histamine-blockers will reduce the number of emergency room visits in severely asthmatic individuals.";
            iao:0000114 iao:0000120;
            iao:0000115 "An in vivo intervention experiment in which the ability of the intervention to reduce or cure the effects of a disease are tested.";
            iao:0000116 "should have treatment as intervention";
            iao:0000117 "IEDB";
            iao:0000119 "IEDB";
            a owl:Class;
            rdfs:label "treatment intervention experiment";
            rdfs:subClassOf obi:0001980.
obi:0001985 iao:0000111 "microarray assay";
            iao:0000112 "Measuring if sera from an influenza A virus immunizedmouse binds to Hemagglutinin protein that is immobilized on a microarray.";
            iao:0000114 iao:0000120;
            iao:0000115 "An analyte assay where binding of the analyte to immobilized matrix is measured.";
            iao:0000117 "IEDB";
            iao:0000119 "IEDB";
            a owl:Class;
            rdfs:label "microarray assay";
            rdfs:subClassOf obi:0000443;
