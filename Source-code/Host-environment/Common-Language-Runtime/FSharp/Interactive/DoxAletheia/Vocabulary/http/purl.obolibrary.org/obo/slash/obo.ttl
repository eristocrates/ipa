                             owl:onProperty pobo:RO_0000052 ; 
                             a owl:Restriction],
                            pobo:BFO_0000023.
obi:0000038 iao:0000111 "chromatography column"@en;
            iao:0000114 iao:0000123;
            iao:0000115 "Chromatography column in chemistry is a tube and contents (typically glass) used to purify individual chemical compounds from mixtures of compounds. It is often used for preparative applications on scales from micrograms up to kilograms."@en;
            iao:0000117 "Frank Gibson"@en;
            iao:0000119 "http://en.wikipedia.org/wiki/Column_chromatography"@en;
            iao:0000232 "open tracker https://sourceforge.net/tracker/index.php?func=detail&aid=2881353&group_id=177891&atid=886178";
