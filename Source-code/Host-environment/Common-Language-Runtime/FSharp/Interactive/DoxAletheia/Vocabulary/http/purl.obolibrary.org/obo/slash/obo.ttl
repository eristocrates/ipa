                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty pobo:BFO_0000055 ; 
                                                 a owl:Restriction]
                                                 [owl:someValuesFrom obi:0000703 ; 
                                                 owl:onProperty obi:0000293 ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class].
obi:0000725 iao:0000111 "host role";
            iao:0000112 "In biology, a host is an organism that harbors a virus or parasite, or a mutual or commensal symbiont, typically providing nourishment and shelter.  http://en.wikipedia.org/wiki/Host_(biology)  30 March 09";
            iao:0000114 iao:0000120;
            iao:0000115 "host role is a role played by an organism and realized by providing nourishment, shelter or a means of reproduction to another organism within the organism playing the host role";
            iao:0000116 """30Mar09 virus reproducing inside a cell; bacteria causing a disease, host can be harmed or not.  we want to avoid a cat sitting on my lap and an animal care technician; these are not examples or hosts; dental cares = on tooth, but part of outer layer of tooth, so covered by \"within\" in the definition""";
            iao:0000117 "GROUP: Role Branch";
            iao:0000119 "30 Mar09 submitted by vaccine community",
                        "OBI",
                        "http://en.wikipedia.org/wiki/Host_(biology)";
            a owl:Class;
            rdfs:label "host role";
            rdfs:subClassOf pobo:BFO_0000023,
                            [owl:someValuesFrom obi:0100026 ; 
                             owl:onProperty pobo:RO_0000052 ; 
                             a owl:Restriction].
obi:0000726 iao:0000111 "peak matching";
            iao:0000114 iao:0000123;
            iao:0000115 "Peak matching is a data transformation performed on a dataset of a graph of ordered data points (e.g. a spectrum) with the objective of pattern matching local maxima above a noise threshold";
            iao:0000117 "Ryan Brinkman",
                        "James Malone";
            iao:0000119 "PERSON: Ryan Brinkman";
            a owl:Class;
            rdfs:label "peak matching";
            rdfs:subClassOf obi:0200000.
obi:0000727 iao:0000111 "k-nearest neighbors"@en;
            iao:0000114 iao:0000125;
            iao:0000115 "A k-nearest neighbors is a data transformation which achieves a class discovery or partitioning objective, in which an input data object with vector y is assigned to a class label based upon the k closest training data set points to y; where k is the largest value that class label is assigned."@en;
            iao:0000117 "James Malone"@en;
            iao:0000118 "k-NN";
            iao:0000119 "PERSON: James Malone"@en;
            a owl:Class;
            rdfs:label "k-nearest neighbors"@en;
            rdfs:subClassOf obi:0200175,
                            [owl:intersectionOf ([owl:someValuesFrom obi:0000648 ; 
                                                 owl:onProperty obi:0000299 ; 
                                                 a owl:Restriction]
                                                 [owl:someValuesFrom obi:0200178 ; 
                                                 owl:onProperty obi:0000417 ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class],
                            [owl:someValuesFrom obi:0200172 ; 
                             owl:onProperty obi:0000417 ; 
                             a owl:Restriction],
                            obi:0200171.
obi:0000728 iao:0000111 "rodent care";
            iao:0000112 "keeping animal";
            iao:0000114 iao:0000123;
            iao:0000115 "rodent care  is the process by which rodents are being provided with a controlled living environment while kept in captivity for the purpose of research.";
            iao:0000117 "PPPB branch";
            iao:0000119 "PPPB branch";
