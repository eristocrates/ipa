                                                     a owl:Restriction]
                                                     [owl:someValuesFrom [owl:intersectionOf (obi:0000576
                                                                                             [owl:someValuesFrom obi:0302733 ; 
                                                                                             owl:onProperty pobo:RO_0000087 ; 
                                                                                             a owl:Restriction]) ; 
                                                                         a owl:Class] ; 
                                                     owl:onProperty pobo:BFO_0000051 ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class].
obi:0302731 iao:0000111 "buffer role";
            iao:0000112 "A buffer of carbonic acid (H2CO3) and bicarbonate (HCO3-) is present in blood plasma, to maintain a pH between 7.35 and 7.45. http://en.wikipedia.org/wiki/Buffer_solution";
            iao:0000114 iao:0000125;
            iao:0000115 "a role which inheres in some molecular entity realized during the process of buffering";
            iao:0000117 "Person:Philippe Rocca-Serra",
                        "Person:Helen Parkinson";
            iao:0000118 "buffer";
            iao:0000119 "OBI";
            a owl:Class;
            rdfs:label "buffer role"@en;
            rdfs:subClassOf pobo:BFO_0000023.
obi:0302732 iao:0000111 "solvent role";
            iao:0000112 "PMID: 18373502.Transfusion. 2008 Mar 25. Solvent/detergent treatment of platelet concentrates enhances the release of growth factors."@en;
            iao:0000114 iao:0000125;
            iao:0000115 "solvent role is a role which inheres in a molecular entity capable of ensuring the dissolution of another chemical entity and realized by the process of solvation"@en;
            iao:0000117 "Philippe Rocca-Serra";
            iao:0000119 "adpated from wikipedia (http://en.wikipedia.org/wiki/Solvatation)";
            a owl:Class;
            rdfs:label "solvent role"@en;
            rdfs:subClassOf [owl:allValuesFrom obi:0000685 ; 
                             owl:onProperty pobo:BFO_0000054 ; 
                             a owl:Restriction],
                            pobo:BFO_0000023,
                            [owl:someValuesFrom chebi:23367 ; 
                             owl:onProperty pobo:RO_0000052 ; 
                             a owl:Restriction].
obi:0302733 iao:0000111 "solute role";
            iao:0000112 "PMID: 18380397.Pharmazie. 2008 Feb;63(2):113-21.Deviations of drug solubility in water-cosolvent mixtures from the Jouyban-Acree model--effect of solute structure."@en;
            iao:0000114 iao:0000125;
            iao:0000115 "solute role is a role played by a chemical entity which is dissolved by another chemical entity (the solvent) when creating a solution"@en;
            iao:0000117 "Philippe Rocca-Serra";
            iao:0000119 "adapted from wikipedia (http://en.wikipedia.org/wiki/Solute)";
            a owl:Class;
            rdfs:label "solute role"@en;
            rdfs:subClassOf [owl:someValuesFrom chebi:23367 ; 
                             owl:onProperty pobo:RO_0000052 ; 
                             a owl:Restriction],
                            pobo:BFO_0000023,
                            [owl:allValuesFrom obi:0000685 ; 
                             owl:onProperty pobo:BFO_0000054 ; 
                             a owl:Restriction].
obi:0302736 iao:0000111 "comet assay";
            iao:0000112 "PMID: 18326531.Mutagenesis. 2008 Mar 6.Recommendations for design of the rat comet assay.";
            iao:0000114 iao:0000122;
            iao:0000115 "An assay that measures DNA damage (DNA breakage) in eucaryotic cells exposed to a challenge by determining the size and shape of DNA migration by detecting fluorescently labeled DNA from a cell placed in an electric field using gel electrophoresis";
            iao:0000117 "Philippe Rocca-Serra";
