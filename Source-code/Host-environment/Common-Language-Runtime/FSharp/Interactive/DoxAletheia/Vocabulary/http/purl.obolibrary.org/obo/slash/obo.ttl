            iao:0000114 iao:0000120;
            iao:0000115 "cervical dislocation is a process by which a Vertebrate organism has its life terminated by rupturing spinal cord between cervical vertebrae induced by excessive mechanical torsion"@en;
            iao:0000116 "PRS:21102008: Input must be restricted to Vertebrates (requires import from NCBI tax)"@en;
