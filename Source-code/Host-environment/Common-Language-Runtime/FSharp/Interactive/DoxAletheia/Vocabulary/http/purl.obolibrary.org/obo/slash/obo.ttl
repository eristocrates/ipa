                                                     owl:onProperty obi:0000312 ; 
                                                     a owl:Restriction]
                                                     [owl:someValuesFrom obi:0000740 ; 
                                                     owl:onProperty pobo:RO_0000087 ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class].
