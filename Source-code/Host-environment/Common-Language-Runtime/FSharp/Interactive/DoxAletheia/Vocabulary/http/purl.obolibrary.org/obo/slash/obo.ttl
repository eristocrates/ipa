obi:0000054 iao:0000111 "ratio of collected to emitted light"@en;
            iao:0000112 "10%"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A measurement datum measuring the amount of light collected s compared to the total amount of emitted light in the detector component of a flow cytometer instrument. The datum has a qualitative role"@en;
            iao:0000117 "person:Chris Stoeckert"@en,
