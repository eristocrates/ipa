obi:0000967 iao:0000111 "container";
            iao:0000114 iao:0000123;
            iao:0000115 "A device that can be used to restrict the location of material entities over time";
            iao:0000116 "03/21/2010: Added to allow classification of children (similar to what we want to do for 'measurement device'. Lookint at what classifies here, we may want to reconsider a contain function assigned to a part of an entity is necessarily also a function of the whole (e.g. is a centrifuge a container because it has test tubes as parts?)";
            iao:0000117 "PERSON: Bjoern Peters";
            a owl:Class;
