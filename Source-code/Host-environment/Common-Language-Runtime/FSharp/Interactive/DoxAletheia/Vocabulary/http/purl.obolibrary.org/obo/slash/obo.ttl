obi:0000871 iao:0000111 "viral hemagglutination assay";
            iao:0000112 "Determining the viral titer of a virus infected human by measuring the presence of hemagglutination when dilutions of serum samples are added to a known quantity of red blood cells.";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that quantifies viruses by their hemagglutination activity.";
            iao:0000117 "Melanie Courtot",
                        "Bjoern Peters",
                        "Randi Vita";
            iao:0000118 "viral haemagglutinin assay",
                        "HI",
                        "HA";
            iao:0000119 "url:http://en.wikipedia.org/wiki/Hemagglutination_assay";
