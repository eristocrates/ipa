iao:0000024 iao:0000112 "The length of a ruler.";
            iao:0000115 "a unit of measure is the quality of some material entity compared to which another quality is some multiple of.";
            iao:0000117 "Alan Ruttenberg";
            iao:0000119 "Smith, Ceusters, Ruttenberg, 2000 years of philosophy";
            iao:0000231 iao:0000103;
            a owl:Class;
