obi:0002188 iao:0000111 "multi-unit recording";
            iao:0000114 iao:0000123;
            iao:0000115 "An extracellular electrophysiology assay where a collection of microelectrodes (often in an 'array' configuration) is placed into neural tissue to measure the distribution of voltage and current changes for a population of cells over time.";
            iao:0000117 "Gully Burns";
            a owl:Class;
            rdfs:label "multi-unit recording";
            rdfs:subClassOf obi:0000454.
obi:0002189 iao:0000111 "local field potential recording";
            iao:0000114 iao:0000120;
            iao:0000115 "An extracellular electrophysiology assay where a microelectrode is placed in the extracellular space of brain tissue to measure action potential and compared to an electrode either outside or inside that tissue.";
            iao:0000117 "Gully Burns";
            iao:0000119 "doi:10.1007/978-1-4614-7320-6_723-1";
            a owl:Class;
            rdfs:label "local field potential recording";
