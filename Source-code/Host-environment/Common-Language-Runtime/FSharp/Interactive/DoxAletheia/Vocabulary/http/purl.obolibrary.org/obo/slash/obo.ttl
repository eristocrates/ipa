obi:0001009 iao:0000111 "obsolete_qualitative binding detection assay"@en;
            iao:0000114 iao:0000123;
            iao:0000115 "A binding assay where the specified output determines if two or more material entities do or do not have the disposition to form a complex above a threshold level of significance. The threshold can be defined through detection limits of the instrument, the use of experimental controls that establish what is considered significant binding, or a predefined cutoff based on what binding is considered significant in a certain context. "@en;
            iao:0000117 "PERSON: Bjoern Peters, Randi Vita, Jason Greenbaum"@en;
            iao:0000231 iao:0000103;
            a owl:Class;
            rdfs:label "obsolete_qualitative binding detection assay"@en;
            rdfs:subClassOf oboinowl:ObsoleteClass;
            owl:deprecated true.
