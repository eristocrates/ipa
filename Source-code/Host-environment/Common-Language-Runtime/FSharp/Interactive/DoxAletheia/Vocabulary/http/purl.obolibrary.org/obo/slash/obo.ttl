                             a owl:Restriction],
                            obi:0002590.
obi:0002593 iao:0000111 "functional association identification design";
            iao:0000114 iao:0000120;
            iao:0000115 "A molecular interaction identification design that investigates a relationship that is the result of intermediate steps between two or more molecules that are not necessarily in direct contact with each other.";
            iao:0000117 "Rebecca Tauber";
            iao:0000119 "MI:2286";
            a owl:Class;
            rdfs:label "functional association identification design";
            rdfs:subClassOf obi:0002590.
obi:0002594 iao:0000111 "direct interaction identification design";
            iao:0000114 iao:0000120;
