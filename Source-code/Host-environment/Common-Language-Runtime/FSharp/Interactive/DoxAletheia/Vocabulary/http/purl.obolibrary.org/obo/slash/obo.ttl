                             a owl:Restriction],
                            [owl:someValuesFrom obi:0100060 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction].
obi:0600038 iao:0000111 "addition of molecular label"@en;
            iao:0000112 "The addition of phycoerytherin label to an anti-CD8 antibody, to label all antibodies. The addition of anti-CD8-PE to a population of cells, to label the subpopulation cells that are CD8+."@en;
            iao:0000114 iao:0000125;
            iao:0000115 "a material processing technique intended to add a molecular label to some input material entity, to allow detection of the molecular target of this label in a detection of molecular label assay"@en;
            iao:0000117 "PERSON:Matthew Brush"@en;
            iao:0000118 "labeling";
            iao:0000119 "OBI developer call, 3-12-12"@en;
            a owl:Class;
