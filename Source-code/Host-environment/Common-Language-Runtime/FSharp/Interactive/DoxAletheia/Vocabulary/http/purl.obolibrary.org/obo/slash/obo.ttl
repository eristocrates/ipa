            owl:deprecated true.
obi:0000668 iao:0000111 "error correction data transformation"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "An error correction data transformation is a data transformation that has the objective of error correction, where the aim is to remove (correct for) erroneous contributions from the input to the data transformation."@en;
            iao:0000117 "James Malone"@en,
                        "Monnie McGee";
            iao:0000119 "EDITORS";
            a owl:Class;
            rdfs:label "error correction data transformation"@en;
