                             a owl:Restriction],
                            obi:0000832.
obi:0000817 iao:0000111 "fucoidan";
            iao:0000114 iao:0000120;
            iao:0000115 "Fucoidan is a sulfated polysaccharide (MW: average 20,000) found mainly in various species of brown seaweed such as kombu, limu moui,bladderwrack, wakame, mozuku, and hijiki (variant forms of fucoidan have also been found in animal species, including the sea cucumber).";
            iao:0000117 "Helen Parkinson";
            iao:0000119 "http://en.wikipedia.org/wiki/Fucoidan";
            a owl:Class;
            rdfs:label "fucoidan";
            rdfs:subClassOf chebi:23367.
obi:0000818 iao:0000111 "calibration";
            iao:0000112 "the process of using pH buffer adjust a pH meter";
            iao:0000114 iao:0000122;
            iao:0000115 "A planned process with the objective to establish the relationship between data produced by a measurement device and physical qualities. This is done by using the measurement device under defined conditions, and either tuning it to adjust the measured output, or record the output and use it as a reference in future measurements.";
            iao:0000117 "GROUP: OBI Philly workshop";
            iao:0000119 "WEB:http://en.wikipedia.org/wiki/calibration";
            a owl:Class;
            rdfs:label "calibration";
            rdfs:subClassOf [owl:someValuesFrom obi:0000070 ; 
