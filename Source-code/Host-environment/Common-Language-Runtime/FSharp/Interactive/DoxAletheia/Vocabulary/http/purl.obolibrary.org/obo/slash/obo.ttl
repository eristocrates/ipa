obi:0000729 iao:0000111 "cloning plasmid";
            iao:0000114 iao:0000123;
            iao:0000115 "A cloning plasmid is a plasmid that was engineered to contain a bacterial origin of replication, encodes for a selectable gene product and contains a cloning site.";
            iao:0000116 "Note: 'cloning vector role' is really a function. Should be dealt with globally";
            a owl:Class;
            rdfs:label "cloning plasmid";
