              owl:Thing;
            rdfs:label "obsolete_manufacturer role of Bruker Daltonics";
            owl:deprecated true.
obi:0000854 iao:0000111 "western blot analysis";
            iao:0000112 "Running a cell lysate on an acrylamide gel in a western blot aparatus to separate the constituent proteins, followed by transfer of the proteins from the gel to a nitrocellulose membrane. Staining this membrane with specific antibodies to detect the presence of specific proteins of interest.";
            iao:0000114 iao:0000120;
            iao:0000115 "An analyte assay that detects specific peptides in an input material by separating it using gel electrophoresis, transfering the separated molecules to a membrane, and staining them with_ antibodies specific to the analyte molecules.";
            iao:0000117 "IEDB",
                        "Philippe Rocca-Serra";
            iao:0000119 "Philippe Rocca-Serra",
                        "IEDB";
