            rdfs:label "acquisition"@en;
            rdfs:subClassOf [owl:someValuesFrom [owl:someValuesFrom obi:0001755 ; 
                                                 owl:onProperty pobo:RO_0000059 ; 
                                                 a owl:Restriction] ; 
                             owl:onProperty pobo:BFO_0000055 ; 
                             a owl:Restriction],
                            obi:0001928,
                            [owl:someValuesFrom [owl:unionOf (pobo:BFO_0000040
                                                              iao:0000030) ; 
                                                 a owl:Class] ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction].
obi:0600009 iao:0000111 "exposure of material to environment"@en;
            iao:0000112 "Putting cells in a freezer at -80C.  Cy5-labeled DNA is irradiated with a laser to excite the fluorophore. Inducing a phase transition in a material by putting it in an environment with a specific temperature. Oxygen deprivation in a chamber."@en;
            iao:0000114 iao:0000123;
            iao:0000115 "a planned process in which an input material is exposed to a defined set of conditions in a controlled environment. The environment is a specified input."@en;
            iao:0000117 "Bjoern Peters"@en;
            iao:0000119 "IEDB"@en;
            iao:0000232 "Alan says there will be problmes, e.g. with selection by survival"@en;
            a owl:Class;
            rdfs:label "exposure of material to environment"@en;
            rdfs:subClassOf obi:0000011.
obi:0600010 iao:0000111 "material acquisition"@en;
            iao:0000112 "Acquiring 50 C57BL/6 mice bred in the animal facility of the institute as a service to investigators. Purchasing 1 mg of peptides synthesized by Mimotopes at 80% purity. Getting a gift of purified CD4+ specific antibodies presented by Stephen Schoenberger at LIAI."@en;
            iao:0000114 iao:0000122;
            iao:0000115 "An acquisition in which possession of a material entity is gained."@en;
            iao:0000116 "This excludes processes that create or change materials, such as material transformations.",
                        "The assumption is that the object already exists in its current state, e.g, an available mouse strain purchased from the Jackson Lab, this is the differentia from specimen creation";
            iao:0000117 "Bjoern Peters, Alan Ruttenberg, Helen Parkinson"@en;
            iao:0000118 "material procurement";
            iao:0000119 "IEDB"@en;
            a owl:Class;
            rdfs:label "material acquisition"@en;
            rdfs:subClassOf obi:0600008,
                            [owl:someValuesFrom pobo:BFO_0000040 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction].
obi:0600011 iao:0000111 "acclimatization"@en;
            iao:0000112 "placing mice in animal facility for 2 weeks prior to an experiment to accustom them to their environment, reducing stress"@en;
            iao:0000114 iao:0000125;
            iao:0000115 "A protocol application in which an object is left in an environment for some period of time, until some qualities of interest are in equilibrium with that environment."@en;
            iao:0000117 "Jennifer Fostel"@en;
            iao:0000119 "CEBS, Biomaterial_branch"@en;
            a owl:Class;
            rdfs:label "acclimatization"@en;
            rdfs:subClassOf obi:0600009.
obi:0600012 iao:0000111 "environmental material collection"@en;
            iao:0000112 "Taking 1 liter of surface ocean water from the San Diego Mission Bay Jetty. Capturing mice living in rural Arkansas"@en;
            iao:0000114 iao:0000123;
            iao:0000115 "environmental_material_collection is an acquisition where an object is taken from an environment and put into a storage container. Roles include, environment, thing collected, container, acquirer."@en;
            iao:0000116 """relabel the term and add axiom connecting to EnVO:'environmental material'
discussed on obi-dev call 9/28/2015, details see: https://sourceforge.net/p/obi/obi-terms/779/""";
            iao:0000117 "Bjoern Peters, Alan Ruttenberg"@en;
            iao:0000119 "IEDB"@en;
            iao:0000232 "the researcher is very interested in the location"@en;
            a owl:Class;
            rdfs:label "environmental material collection process"@en;
            rdfs:subClassOf [owl:someValuesFrom obi:0000684 ; 
                             owl:onProperty obi:0000417 ; 
                             a owl:Restriction],
                            obi:0000659,
                            [owl:someValuesFrom pobo:ENVO_00010483 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom obi:0100051 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction].
obi:0600013 iao:0000111 "information acquisition"@en;
            iao:0000112 "Gathering all influenza HA sequences from GenBank, Retrieveing HLA allele frequencies in the North American populations from dbMHC"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "An acquisition in which possession of information is gained."@en;
            iao:0000116 "This excludes processes that create or change information, such as assays and data transformations.";
            iao:0000117 "Bjoern Peters"@en;
            iao:0000118 "data collection";
            iao:0000119 "OBI branch derived"@en;
            a owl:Class;
            rdfs:label "information acquisition"@en;
            rdfs:subClassOf [owl:someValuesFrom iao:0000030 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            obi:0600008.
obi:0600014 iao:0000111 "material component separation"@en;
            iao:0000112 "Using a cell sorter to separate a mixture of T cells into two fractions; one with surface receptor CD8 and the other lacking the receptor, or purification"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "a material processing in which components of an input material become segregated in space"@en;
            iao:0000117 "Bjoern Peters"@en;
            iao:0000119 "IEDB"@en;
            a owl:Class;
            rdfs:label "material component separation"@en;
            rdfs:subClassOf [owl:someValuesFrom pobo:BFO_0000040 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction],
                            obi:0000094,
                            [owl:someValuesFrom pobo:BFO_0000040 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction];
            owl:equivalentClass [owl:someValuesFrom obi:0000639 ; 
                                 owl:onProperty obi:0000417 ; 
                                 a owl:Restriction].
obi:0600015 iao:0000111 "group assignment"@en;
            iao:0000112 "Assigning' to be treated with active ingredient role' to an organism during group assignment. The group is those organisms that have the same role in the context of an investigation"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "group assignment is a process which has an organism as specified input and during which a role is assigned"@en;
            iao:0000117 "Philippe Rocca-Serra"@en;
            iao:0000118 "cohort assignment",
                        "study assignment";
            iao:0000119 "OBI Plan"@en;
            a owl:Class;
            rdfs:label "group assignment"@en;
            rdfs:subClassOf obi:0000011,
                            [owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000023
                                                                     [owl:someValuesFrom obi:0100026 ; 
