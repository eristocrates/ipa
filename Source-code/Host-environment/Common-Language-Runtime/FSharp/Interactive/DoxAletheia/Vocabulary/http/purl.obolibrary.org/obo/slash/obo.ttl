obi:0000858 iao:0000111 "record of unknown sex";
            iao:0000112 "A database record indicating that the tissue sample in a microarray experiment came from an organism for which the biological sex is not known to the person who created the record.";
            iao:0000114 iao:0000120;
            iao:0000115 "a record indicating that the biological sex of an organism is not known.";
