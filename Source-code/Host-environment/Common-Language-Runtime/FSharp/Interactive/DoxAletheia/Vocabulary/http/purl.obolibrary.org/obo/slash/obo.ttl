_:B66a62c15527f81bc8c8e23fdf66b6395 iao:0010000 <http://purl.obolibrary.org/obo/bfo/axiom/008-002>;
                                    a owl:Axiom;
                                    owl:annotatedProperty iao:0000600;
                                    owl:annotatedSource pobo:BFO_0000002;
                                    owl:annotatedTarget "A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. (axiom label in BFO2 Reference: [008-002])"@en.
_:B6752834eac4c4c03355dc72f790bef5b iao:0010000 <http://purl.obolibrary.org/obo/bfo/axiom/033-001>;
