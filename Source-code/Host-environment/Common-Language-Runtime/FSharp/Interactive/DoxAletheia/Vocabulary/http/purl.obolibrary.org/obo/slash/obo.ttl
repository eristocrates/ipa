obi:0002160 iao:0000111 "multiplexed indexed T7 ChIP-seq assay";
            iao:0000114 iao:0000122;
            iao:0000115 "A ChIP-seq assay which leverages T7 promoter amplification to allow low sample input and chromatin barcoding and pool-and-split multiplexing for high-throughput, quantitative profiling of chromatin states.";
            iao:0000117 "Jason Hilton",
                        "Chris Stoeckert";
            iao:0000118 "Mint-ChIP",
                        "Mint-ChIP-seq";
            iao:0000119 "url:http://www.cell.com/molecular-cell/abstract/S1097-2765(15)00863-1";
            iao:0000233 "https://github.com/obi-ontology/obi/issues/829";
            iao:0000234 "ENCODE DCC";
            a owl:Class;
            rdfs:label "multiplexed indexed T7 ChIP-seq assay";
            rdfs:subClassOf obi:0000716.
obi:0002161 iao:0000111 "systematic evolution of ligands by exponential enrichment assay";
            iao:0000114 iao:0000120;
            iao:0000115 "A binding assay that identifies protein-binding sites on nucleic acids by selecting high-affinity target ligands from a randomized pool. The process is repeated in rounds, then the bound nucleic acids are separated from the unbound nucleic acids and amplified by PCR._";
            iao:0000117 "Rebecca Tauber";
            iao:0000118 "SELEX";
            iao:0000119 "PMID:21720957";
            a owl:Class;
            rdfs:label "systematic evolution of ligands by exponential enrichment assay";
            rdfs:subClassOf obi:0001146.
obi:0002162 iao:0000111 "footprinting assay";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that measures ligand binding and conformational changes by the solvent accessibility of the backbone, bases, or side-chain structures of macromolecules through their sensitivity to chemical or enzymatic cleavage or modification reactions.";
            iao:0000117 "Bjoern Peters";
            iao:0000119 "doi:10.1002/3527600906.mcb.200300025";
            a owl:Class;
            rdfs:label "footprinting assay";
            rdfs:subClassOf obi:0000070.
obi:0002163 iao:0000111 "DNAse footprinting assay";
            iao:0000114 iao:0000120;
            iao:0000115 "An enzymatic footprinting assay that determines protein-binding sites on DNA by identifying bound fragments that are protected from DNAse I-catalyzed hydrolysis";
            iao:0000117 "Rebecca Tauber";
            iao:0000119 "OBI development call";
            a owl:Class;
            rdfs:label "DNAse footprinting assay";
            rdfs:subClassOf obi:0002162.
obi:0002164 iao:0000111 "mammalian 2-hybrid assay";
            iao:0000114 iao:0000120;
            iao:0000115 "A binding assay that increases the expression of a reporter gene in mammalian cells by proteins of interest attached to two portions of the transcriptional activator, bringing those portions closer together.";
            iao:0000117 "Rebecca Tauber";
            iao:0000119 "PMID:9043710",
                        "ECO:0001095";
            a owl:Class;
            rdfs:label "mammalian 2-hybrid assay";
            rdfs:subClassOf obi:0001146.
obi:0002165 iao:0000111 "protein localization assay";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that determines the specific location of a protein. Subcellular localization is distinguished from tissue-based localization based on the type of microscopy applied.";
            iao:0000117 "Rebecca Tauber";
            iao:0000119 "OBI development call";
            a owl:Class;
            rdfs:label "protein localization assay";
            rdfs:subClassOf obi:0000070.
obi:0002166 iao:0000111 "tissue-based protein localization assay";
            iao:0000114 iao:0000120;
            iao:0000115 "A protein localization assay that determines the specific location of a protein in a living tissue sample.";
            iao:0000117 "Rebecca Tauber";
            iao:0000119 "PMID:14686950";
            a owl:Class;
            rdfs:label "tissue-based protein localization assay";
            rdfs:subClassOf obi:0002165.
obi:0002167 iao:0000111 "subcellular protein localization assay";
            iao:0000114 iao:0000120;
            iao:0000115 "A protein localization assay that determines the specific subcellular location of a protein. The location is visualized through electron microscopy.";
            iao:0000117 "Rebecca Tauber";
            iao:0000119 "ECO";
            a owl:Class;
            rdfs:label "subcellular protein localization assay";
            rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000034
                                                                                         [owl:someValuesFrom obi:0000990 ; 
                                                                                         owl:onProperty pobo:RO_0000052 ; 
                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty pobo:BFO_0000055 ; 
                                                 a owl:Restriction]
                                                 [owl:someValuesFrom obi:0000990 ; 
                                                 owl:onProperty obi:0000293 ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class],
                            obi:0002165.
obi:0002168 iao:0000111 "subcellular protein immunohistochemistry assay";
            iao:0000114 iao:0000120;
            iao:0000115 "An immunohistochemistry assay that uses antibodies to display the specific subcellular location of proteins.";
            iao:0000117 "Rebecca Tauber";
            iao:0000119 "ECO";
            a owl:Class;
            rdfs:label "subcellular protein immunohistochemistry assay";
            rdfs:subClassOf obi:0001986.
obi:0002169 iao:0000111 "ChIP-qPCR assay";
            iao:0000114 iao:0000120;
            iao:0000115 "A ChIP assay that uses quantitative PCR to determine levels of specific DNA in immunoprecipitated samples.";
            iao:0000117 "Chris Stoeckert";
            iao:0000119 "PMID:18388953";
            a owl:Class;
            rdfs:label "ChIP-qPCR assay";
            rdfs:subClassOf [owl:someValuesFrom obi:0000893 ; 
                             owl:onProperty pobo:BFO_0000051 ; 
                             a owl:Restriction],
                            obi:0001954.
obi:0002170 iao:0000111 "genomic SELEX";
            iao:0000114 iao:0000120;
            iao:0000115 "A systematic evolution of ligands by exponential enrichment assay that starts with a library derived from genomic DNA instead of synthetically derived random DNA molecules.";
            iao:0000117 "Chris Stoeckert";
            iao:0000119 "PMID:20541015";
            a owl:Class;
            rdfs:label "genomic SELEX";
            rdfs:subClassOf obi:0002161.
obi:0002171 iao:0000111 "dot blot assay";
            iao:0000114 iao:0000120;
            iao:0000115 "An analyte assay that detects molecules in a mixture dotted on a membrane using DNA probes or antibodies.";
            iao:0000117 "Bjoern Peters";
            iao:0000118 "dot blot analysis";
            iao:0000119 "PMID:10473518";
            a owl:Class;
            rdfs:label "dot blot assay";
            rdfs:subClassOf obi:0000443.
obi:0002172 iao:0000111 "Northwestern blot assay";
            iao:0000114 iao:0000120;
            iao:0000115 "A direct binding assay that detects interactions of labeled RNA with immobilized protein on a membrane.";
            iao:0000117 "Bjoern Peters";
            iao:0000118 "Northwestern analysis",
                        "Northwestern assay";
            iao:0000119 "PMID:26965261";
            a owl:Class;
            rdfs:label "Northwestern blot assay";
            rdfs:subClassOf obi:0001591.
obi:0002173 iao:0000111 "Southwestern blot assay";
            iao:0000114 iao:0000120;
            iao:0000115 "A direct binding assay that detects interactions of labeled DNA with immobilized protein on a membrane.";
            iao:0000117 "Bjoern Peters";
            iao:0000119 "PMID:26404144";
            a owl:Class;
            rdfs:label "Southwestern blot assay";
            rdfs:subClassOf obi:0001591.
obi:0002174 iao:0000111 "immunocytochemistry";
            iao:0000114 iao:0000123;
            iao:0000115 "An immuno staining assay in which samples of intact cells are examined that have had most, if not all, of their surrounding extracellular matrix removed";
            iao:0000117 "Bjoern Peters";
            a owl:Class;
            rdfs:label "immunocytochemistry";
            rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (obi:0000067
                                                                                         [owl:someValuesFrom pobo:CL_0000000 ; 
