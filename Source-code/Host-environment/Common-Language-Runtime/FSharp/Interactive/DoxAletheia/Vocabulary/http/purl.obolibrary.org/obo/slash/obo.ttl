obi:0400155 iao:0000111 "water bath"@en;
            iao:0000112 "A water bath was used to allow for cell incubation at 38 degree centigrade for 8 hours."@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A water bath is a temperature control bath in which a water acts as contact medium enabling temperature transfer from the heating element or cooling element to the sample. The temperature can be controlled in the 0 to 100 degree centigrade range (under normal pressure)."@en;
            iao:0000117 "Daniel Schober";
            iao:0000119 "PERSON: Daniel Schober";
            a owl:Class;
            rdfs:label "water bath"@en;
