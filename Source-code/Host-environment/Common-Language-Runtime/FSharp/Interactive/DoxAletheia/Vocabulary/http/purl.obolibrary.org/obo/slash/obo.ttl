obi:0002113 iao:0000111 "bromouridine labeling and sequencing assay";
            iao:0000114 iao:0000122;
            iao:0000115 "An RNA-seq assay to identify spans of nascent transcription in the genome through isolation of recent bromouridine (Bru) labelled RNAs.";
            iao:0000117 "Chris Stoeckert",
                        "Jason Hilton";
            iao:0000118 "Bru-seq";
            iao:0000119 "PMC:4009065";
            a owl:Class;
            rdfs:label "bromouridine labeling and sequencing assay";
