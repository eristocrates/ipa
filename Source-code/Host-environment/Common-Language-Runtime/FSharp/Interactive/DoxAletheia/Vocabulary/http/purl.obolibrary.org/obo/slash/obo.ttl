obi:0001633 iao:0000111 "purified material";
            iao:0000112 "A mixture of peptide molecules that has been run through an HPLC column to remove 65";
            iao:0000114 iao:0000120;
            iao:0000115 "A material entity that is generated by a purification process in which an input material is separated to obtain a fraction with a higher concentration of a desired component";
            iao:0000117 "GROUP: OBI call ";
            iao:0000119 "OBI conference call";
            a owl:Class;
            rdfs:label "purified material";
