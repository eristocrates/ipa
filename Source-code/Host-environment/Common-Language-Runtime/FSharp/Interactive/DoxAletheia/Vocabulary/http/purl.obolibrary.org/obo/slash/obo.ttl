                             a owl:Class],
                            obi:0001977,
                            obi:0001632.
obi:0002175 iao:0000111 "ATP bioluminescence assay";
            iao:0000114 iao:0000120;
            iao:0000115 "An analyte assay that detects ATP concentration through light intensity when luciferase catalyzes the oxidation of luciferin in the presence of ATP, magnesium ions, and molecular oxygen.";
            iao:0000117 "Rebecca Tauber";
            iao:0000118 "cell viability ATP quantitation assay",
                        "ATP quantitation assay";
            iao:0000119 "ECO";
            a owl:Class;
            rdfs:label "ATP bioluminescence assay";
            rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (obi:0000275
                                                                                         [owl:someValuesFrom chebi:15422 ; 
                                                                                         owl:onProperty pobo:RO_0000052 ; 
