obi:0000721 iao:0000111 "glucose tolerance test";
            iao:0000112 "PMID: 19527607";
            iao:0000114 iao:0000122;
            iao:0000115 "An assay that measures glucose clearance from blood over time by repeated glucose measurement in blood serum or plasma after the administration of a glucose bolus in-vivo. This assay can be used to evaluate the severity of insulin resistance or the efficiency of glucose clearance.";
            iao:0000117 "Philippe Rocca-Serra";
            iao:0000119 "NuGO OBI plan branch";
            a owl:Class;
            rdfs:label "glucose tolerance test";
