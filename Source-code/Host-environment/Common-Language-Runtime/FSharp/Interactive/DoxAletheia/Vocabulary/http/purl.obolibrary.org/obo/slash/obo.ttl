obi:0000411 iao:0000111 "cloning vector role";
            iao:0000112 "pBluescript plays the role of a cloning vector";
            iao:0000114 iao:0000123;
            iao:0000115 "A material to be added role played by a small, self-replicating DNA or RNA molecule - usually a plasmid or chromosome - and realized in a process whereby foreign DNA or RNA is inserted into the vector during the process of cloning."@en;
            iao:0000116 "JZ: related tracker: https://sourceforge.net/p/obi/obi-terms/102/";
            iao:0000117 "PERSON: Helen Parkinson";
            a owl:Class;
            rdfs:label "cloning vector role"@en;
