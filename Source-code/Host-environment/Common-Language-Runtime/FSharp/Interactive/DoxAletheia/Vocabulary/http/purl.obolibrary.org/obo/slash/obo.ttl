iao:0000234 iao:0000114 iao:0000125;
            iao:0000115 "The name of the person, project, or organization that motivated inclusion of an ontology term by requesting its addition.";
            iao:0000117 "Person: Jie Zheng, Chris Stoeckert, Alan Ruttenberg";
