obi:0000722 iao:0000111 "paired-end library";
            iao:0000112 "PMID: 19339662. Next-generation DNA sequencing of paired-end tags (PET) for transcriptome and genome analyses. Genome Res. 2009 Apr;19(4):521-32. Fullwood MJ, Wei CL, Liu ET, Ruan Y.";
            iao:0000114 iao:0000123;
            iao:0000115 "is a collection of short paired tags from the two ends of DNA fragments are extracted and covalently linked as ditag constructs";
            iao:0000117 "Philippe Rocca-Serra";
            iao:0000118 "paired-end tag (PET) library",
                        "mate-paired library";
            iao:0000119 "adapted from information provided by Solid web site";
            a owl:Class;
            rdfs:label "paired-end library";
            rdfs:subClassOf obi:0000047.
obi:0000723 iao:0000111 "DNA sequencing by ligation assay";
            iao:0000112 "ABI Solid Sequencing uses the ligation-based DNA sequencing technology (https://en.wikipedia.org/wiki/ABI_Solid_Sequencing).";
            iao:0000114 iao:0000123;
            iao:0000115 "A DNA sequencing assay that performs chain extension during the sequencing reaction step using DNA ligase";
            iao:0000117 "Philippe Rocca-Serra";
            iao:0000119 "url:https://en.wikipedia.org/wiki/Sequencing_by_ligation";
            a owl:Class;
            rdfs:label "DNA sequencing by ligation assay";
            rdfs:subClassOf obi:0000626,
                            [owl:someValuesFrom pobo:PR_000023089 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction].
obi:0000724 iao:0000111 "Solexa sequencing assay";
            iao:0000112 "PMID: 18987734";
            iao:0000114 iao:0000120;
            iao:0000115 "A DNA sequencing by synthesis assay that identifies sequence information using DNA polymerase and reversible terminator, requiring immobilization of genomic DNA fragments onto a surface and a specific clonal amplification step known as bridge PCR. Reliance on a reversible terminator allows cycles of DNA chain extension by DNA polymerase and imaging without the need of electrophoretic separation of newly synthesized DNA fragment as with Sanger sequencing.";
            iao:0000117 "Philippe Rocca-Serra";
            iao:0000118 "reversible terminator sequencing";
            iao:0000119 "Solexa web site (SS_DNAsequencing.pdf document available on july 2009)";
            a owl:Class;
            rdfs:label "Solexa sequencing assay";
            rdfs:subClassOf obi:0000734,
                            [owl:someValuesFrom [owl:unionOf (obi:0000722
                                                              obi:0000736) ; 
                                                 a owl:Class] ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction],
                            [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000034
                                                                                         [owl:someValuesFrom obi:0000703 ; 
