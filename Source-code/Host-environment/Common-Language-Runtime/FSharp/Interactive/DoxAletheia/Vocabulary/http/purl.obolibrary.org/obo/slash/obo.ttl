                            [owl:minCardinality "2"^^xsd:nonNegativeInteger ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction].
obi:0600017 iao:0000111 "assay detecting a molecular label";
            iao:0000112 "Determination of the amount of phycoerytherin label present in a cell population stained with anti-CD8-PE in order to determine the percentage of CD8+ T cells present";
            iao:0000114 iao:0000125;
            iao:0000115 "An assay that detects the presence or a quality of a molecular label which is a proxy for the detection of the molecular target to which the label is attached";
            iao:0000117 "Matthew Brush";
            iao:0000119 "OBI developer call, 3-12-12";
            a owl:Class;
            rdfs:label "assay detecting a molecular label";
            rdfs:subClassOf [owl:someValuesFrom [owl:someValuesFrom obi:0001936 ; 
