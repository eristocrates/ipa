obi:0000292 iao:0000111 "has_feature_value";
            iao:0000114 iao:0000123;
            iao:0000115 "has_feature_value datatype property is used to describe the feature values which the feature class can contain, for example has_base can have feature values of nonNegativeInteger values."@en;
            iao:0000117 "James Malone"@en;
