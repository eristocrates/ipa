obi:0000687 iao:0000111 "nucleotide overhang cloning";
            iao:0000112 "Cloning vectors are commercially available and supplied in linearized form with 3' dT overhangs";
            iao:0000114 iao:0000120;
            iao:0000115 "Nucleotide overhang cloning is the process of inserting nucleic acid into a vector using nucleotide overhangs used to prevent self ligation";
            iao:0000117 "Helen Parkinson";
