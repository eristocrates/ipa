                                                                     a owl:Restriction]) ; 
                                                 a owl:Class] ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom obi:0100026 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction].
obi:0600016 iao:0000111 "pooling specimens";
            iao:0000112 "http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=104564; Combining spleens of 20 mice, Combining supernatant from a cell culture obtained at different time points"@en;
            iao:0000114 iao:0000125;
            iao:0000115 "physical combination of several instances of like material"@en;
            iao:0000117 "PlanAndPlannedProcess Branch"@en;
            iao:0000118 "sample pooling"@en;
            iao:0000119 "OBI branch derived"@en;
            iao:0000232 "like' is one of the things that you should be controling for in a well-designed experiment. The instances of material need to have the same class."@en;
            a owl:Class;
            rdfs:label "pooling specimens"@en;
