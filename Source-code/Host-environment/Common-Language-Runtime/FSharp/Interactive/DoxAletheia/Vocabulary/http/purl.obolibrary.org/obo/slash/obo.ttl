obi:0001980 iao:0000111 "in vivo intervention experiment";
            iao:0000112 "Comparing the level of allergy symptoms in humans before and post allergy immunotherapy. Testing if injection of a chemical compound into mice will lead to decreased survival.";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay in which the effect of a targeted process (the intervention) on an organism is tested.";
            iao:0000116 "The intervention in an experiment should be modeled accordingly to the intevention carried out in a human cllinical trial, which is currently modeled as 'study intervention'. This touches the boundaries of study vs. assay.";
            iao:0000117 "IEDB";
            iao:0000119 "IEDB";
            a owl:Class;
            rdfs:label "in vivo intervention experiment";
            rdfs:subClassOf obi:0000070,
                            [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (obi:0000067
                                                                                         [owl:someValuesFrom obi:0100026 ; 
                                                                                         owl:onProperty pobo:RO_0000081 ; 
                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty pobo:BFO_0000055 ; 
