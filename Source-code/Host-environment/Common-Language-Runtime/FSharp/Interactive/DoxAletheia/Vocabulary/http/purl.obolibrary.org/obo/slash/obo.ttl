pobo:CL_0000000 iao:0000111 "cell",
                            "cell"@en;
                iao:0000112 """PMID:18089833.Cancer Res. 2007 Dec 15;67(24):12018-25. \"...Epithelial cells were harvested from histologically confirmed adenocarcinomas ..\""""@en;
                iao:0000115 "A material entity of anatomical origin (part of or deriving from an organism) that has as its parts a maximally connected cell compartment surrounded by a plasma membrane.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "cell",
                           "cell"@en;
                rdfs:subClassOf pobo:BFO_0000040.
pobo:CL_0000001 iao:0000111 "primary cultured cell";
                iao:0000115 "A cultured cell that is freshly isolated from a organismal source, or derives in culture from such a cell prior to the culture being passaged.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "primary cultured cell";
                rdfs:subClassOf [owl:complementOf [owl:someValuesFrom [owl:intersectionOf (pobo:CL_0000010
                                                                                           [owl:someValuesFrom obi:0600037 ; 
                                                                                           owl:onProperty obi:0000312 ; 
                                                                                           a owl:Restriction]) ; 
                                                                       a owl:Class] ; 
                                                   owl:onProperty pobo:RO_0001000 ; 
                                                   a owl:Restriction] ; 
                                 a owl:Class],
                                [owl:complementOf [owl:someValuesFrom obi:0600037 ; 
                                                   owl:onProperty obi:0000312 ; 
                                                   a owl:Restriction] ; 
                                 a owl:Class],
                                pobo:CL_0000010.
pobo:CL_0000003 iao:0000111 "native cell";
                iao:0000115 "A cell that is found in a natural setting, which includes multicellular organism cells 'in vivo' (i.e. part of an organism), and unicellular organisms 'in environment' (i.e. part of a natural environment).";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "native cell";
                rdfs:subClassOf pobo:CL_0000000.
pobo:CL_0000010 iao:0000111 "cultured cell";
                iao:0000115 "A cell in vitro that is or has been maintained or propagated as part of a cell culture.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "cultured cell";
                rdfs:subClassOf [owl:unionOf ([owl:someValuesFrom obi:0600036 ; 
                                              owl:onProperty obi:0000312 ; 
                                              a owl:Restriction]
                                              [owl:someValuesFrom [owl:someValuesFrom obi:0600036 ; 
                                                                  owl:onProperty obi:0000312 ; 
                                                                  a owl:Restriction] ; 
                                              owl:onProperty pobo:RO_0001000 ; 
                                              a owl:Restriction]) ; 
                                 a owl:Class],
                                pobo:CL_0000578.
pobo:CL_0000057 iao:0000111 "fibroblast";
                iao:0000115 "A connective tissue cell which secretes an extracellular matrix rich in collagen and other macromolecules. Flattened and irregular in outline with branching processes; appear fusiform or spindle-shaped.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "fibroblast";
                rdfs:subClassOf pobo:CL_0000000.
pobo:CL_0000066 iao:0000111 "epithelial cell";
                iao:0000115 "A cell that is usually found in a two-dimensional sheet with a free surface. The cell has a cytoskeleton that allows for tight cell to cell contact and for cell polarity where apical part is directed towards the lumen and the basal part to the basal lamina.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "epithelial cell";
                rdfs:subClassOf pobo:CL_0000000.
pobo:CL_0000084 iao:0000111 "T cell";
                iao:0000115 "A type of lymphocyte whose defining characteristic is the expression of a T cell receptor complex.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "T cell";
                rdfs:subClassOf pobo:CL_0000542.
pobo:CL_0000097 iao:0000111 "mast cell";
                iao:0000115 "A cell that is found in almost all tissues containing numerous basophilic granules and capable of releasing large amounts of histamine and heparin upon activation. Progenitors leave bone marrow and mature in connective and mucosal tissue. Mature mast cells are found in all tissues, except the bloodstream. Their phenotype is CD117-high, CD123-negative, CD193-positive, CD200R3-positive, and FceRI-high. Stem-cell factor (KIT-ligand; SCF) is the main controlling signal of their survival and development.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "mast cell";
                rdfs:subClassOf pobo:CL_0000000.
pobo:CL_0000182 iao:0000111 "hepatocyte";
                iao:0000115 "The main structural component of the liver. They are specialized epithelial cells that are organized into interconnected plates called lobules. Majority of cell population of liver, polygonal in shape, arranged in plates or trabeculae between sinusoids; may have single nucleus or binucleated.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "hepatocyte";
                rdfs:subClassOf pobo:CL_0000066.
pobo:CL_0000232 iao:0000111 "erythrocyte";
                iao:0000115 "A red blood cell. In mammals, mature erythrocytes are biconcave disks containing hemoglobin whose function is to transport oxygen.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "erythrocyte";
                rdfs:subClassOf pobo:CL_0000000.
pobo:CL_0000235 iao:0000111 "macrophage";
                iao:0000115 "A mononuclear phagocyte present in variety of tissues, typically differentiated from monocytes, capable of phagocytosing a variety of extracellular particulate material, including immune complexes, microorganisms, and dead cells.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "macrophage";
                rdfs:subClassOf pobo:CL_0000000.
pobo:CL_0000236 iao:0000111 "B cell";
                iao:0000115 "A lymphocyte of B lineage with the phenotype CD19-positive, CD20-positive, and capable of B cell mediated immunity.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "B cell";
                rdfs:subClassOf pobo:CL_0000542.
pobo:CL_0000451 iao:0000111 "dendritic cell";
                iao:0000115 "A cell of hematopoietic origin, typically resident in particular tissues, specialized in the uptake, processing, and transport of antigens to lymph nodes for the purpose of stimulating an immune response via T cell activation. These cells are lineage negative (CD3-negative, CD19-negative, CD34-negative, and CD56-negative).";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "dendritic cell";
                rdfs:subClassOf pobo:CL_0000000.
pobo:CL_0000542 iao:0000111 "lymphocyte";
                iao:0000115 "A lymphocyte is a leukocyte commonly found in the blood and lymph that has the characteristics of a large nucleus, a neutral staining cytoplasm, and prominent heterochromatin.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "lymphocyte";
                rdfs:subClassOf pobo:CL_0000842.
pobo:CL_0000578 iao:0000111 "experimentally modified cell in vitro";
                iao:0000115 "A cell in vitro that has undergone physical changes as a consequence of a deliberate and specific experimental procedure.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "experimentally modified cell in vitro";
                rdfs:subClassOf [owl:someValuesFrom obi:0000094 ; 
                                 owl:onProperty obi:0000312 ; 
                                 a owl:Restriction],
                                obi:0000047,
                                pobo:CL_0000000.
pobo:CL_0000624 iao:0000111 "CD4-positive, alpha-beta T cell";
                iao:0000115 "A mature alpha-beta T cell that expresses an alpha-beta T cell receptor and the CD4 coreceptor.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "CD4-positive, alpha-beta T cell";
                rdfs:subClassOf pobo:CL_0000789.
pobo:CL_0000625 iao:0000111 "CD8-positive, alpha-beta T cell";
                iao:0000115 "A T cell expressing an alpha-beta T cell receptor and the CD8 coreceptor.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "CD8-positive, alpha-beta T cell";
                rdfs:subClassOf pobo:CL_0000789.
pobo:CL_0000767 iao:0000111 "basophil";
                iao:0000115 "Any of the immature or mature forms of a granular leukocyte that in its mature form has an irregularly shaped, pale-staining nucleus that is partially constricted into two lobes, and with cytoplasm that contains coarse, bluish-black granules of variable size. Basophils contain vasoactive amines such as histamine and serotonin, which are released on appropriate stimulation. A basophil is CD123-positive, CD193-positive, CD203c-positive, and FceRIa-positive.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "basophil";
                rdfs:subClassOf pobo:CL_0000000.
pobo:CL_0000786 iao:0000111 "plasma cell";
                iao:0000115 "A terminally differentiated, post-mitotic, antibody secreting cell of the B cell lineage with the phenotype CD138-positive, surface immunonoglobulin-negative, and MHC Class II-negative. Plasma cells are oval or round with extensive rough endoplasmic reticulum, a well-developed Golgi apparatus, and a round nucleus having a characteristic cartwheel heterochromatin pattern and are devoted to producing large amounts of immunoglobulin.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "plasma cell";
                rdfs:subClassOf pobo:CL_0000236.
pobo:CL_0000789 iao:0000111 "alpha-beta T cell";
                iao:0000115 "A T cell that expresses an alpha-beta T cell receptor complex.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "alpha-beta T cell";
                rdfs:subClassOf pobo:CL_0000084.
pobo:CL_0000794 iao:0000111 "CD8-positive, alpha-beta cytotoxic T cell";
                iao:0000115 "A CD8-positive, alpha-beta T cell that is capable of killing target cells in an antigen specific manner with the phenotype perforin-positive and granzyme B-positive.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "CD8-positive, alpha-beta cytotoxic T cell";
                rdfs:subClassOf pobo:CL_0000625.
pobo:CL_0000814 iao:0000111 "mature NK T cell";
                iao:0000115 "A mature alpha-beta T cell of a distinct lineage that bears natural killer markers and a T cell receptor specific for a limited set of ligands. NK T cells have activation and regulatory roles particularly early in an immune response.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "mature NK T cell";
                rdfs:subClassOf pobo:CL_0000789.
pobo:CL_0000842 iao:0000111 "mononuclear cell";
                iao:0000115 "A leukocyte with a single non-segmented nucleus in the mature form.";
                iao:0000412 pobo:cl.owl;
                a owl:Class;
                rdfs:label "mononuclear cell";
                rdfs:subClassOf pobo:CL_0000000.
pobo:ENVO_00001998 iao:0000111 "soil";
                   iao:0000115 "Soil is an environmental material which is primarily composed of minerals, varying proportions of sand, silt, and clay, organic material such as humus, gases, liquids, and a broad range of resident micro- and macroorganisms.";
                   iao:0000412 pobo:envo.owl;
                   a owl:Class;
                   rdfs:label "soil";
                   rdfs:subClassOf pobo:ENVO_00010483.
pobo:ENVO_00002257 iao:0000111 "podzol";
                   iao:0000115 "Podzols are soils with a typically ash-grey upper subsurface horizon, bleached by loss of organic matter and iron oxides, on top of a dark accumulation horizon with brown, reddish or black illuviated humus and/or reddish Fe compounds. Podzols occur in humid areas in the boreal and temperate zones and locally also in the tropics.";
                   iao:0000412 pobo:envo.owl;
                   a owl:Class;
                   rdfs:label "podzol";
                   rdfs:subClassOf pobo:ENVO_00001998.
pobo:ENVO_00010483 iao:0000111 "environmental material";
                   iao:0000115 "A portion of environmental material is a fiat object which forms the medium or part of the medium of an environmental system.";
                   iao:0000412 pobo:envo.owl;
                   a owl:Class;
                   rdfs:label "environmental material";
                   rdfs:subClassOf pobo:BFO_0000040.
gaz:00000448 iao:0000111 "geographic location";
             iao:0000115 "A reference to a place on the Earth, by its name or by its geographical location.";
             iao:0000412 pobo:gaz.owl;
             a owl:Class;
             rdfs:label "geographic location";
             rdfs:subClassOf pobo:BFO_0000029.
go:0000785 iao:0000111 "chromatin";
           iao:0000115 "The ordered and organized complex of DNA, protein, and sometimes RNA, that forms the chromosome.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "chromatin";
           rdfs:subClassOf go:0005575.
go:0001047 iao:0000111 "core promoter binding";
           iao:0000115 "Interacting selectively and non-covalently with the regulatory region composed of the transcription start site and binding sites for the basal transcription machinery. Binding may occur as a sequence specific interaction or as an interaction observed only once a factor has been recruited to the DNA by other factors.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "core promoter binding";
           rdfs:subClassOf obi:0001588.
go:0001508 iao:0000111 "action potential";
           iao:0000115 "A process in which membrane potential cycles through a depolarizing spike, triggered in response to depolarization above some threshold, followed by repolarization. This cycle is driven by the flow of ions through various voltage gated channels with different thresholds and ion specificities.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "action potential";
           rdfs:subClassOf go:0008150.
go:0001788 iao:0000111 "antibody-dependent cellular cytotoxicity";
           iao:0000115 "Cytolysis of target cells by natural killer cells, eosinophils, neutrophils, monocytes, or macrophages following engagement of antibodies bound to the target cells by Fc receptors on the effector cells.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "antibody-dependent cellular cytotoxicity";
           rdfs:subClassOf go:0008150.
go:0001806 iao:0000111 "type IV hypersensitivity";
           iao:0000115 "An inflammatory response driven by T cell recognition of processed soluble or cell-associated antigens leading to cytokine release and leukocyte activation.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "type IV hypersensitivity";
           rdfs:subClassOf go:0002524.
go:0001816 iao:0000111 "cytokine production";
           iao:0000115 "The appearance of a cytokine due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "cytokine production";
           rdfs:subClassOf go:0008150.
go:0001906 iao:0000111 "cell killing";
           iao:0000115 "Any process in an organism that results in the killing of its own cells or those of another organism, including in some cases the death of the other organism. Killing here refers to the induction of death in one cell by another cell, not cell-autonomous death due to internal or other environmental conditions.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "cell killing";
           rdfs:subClassOf go:0008150.
go:0001913 iao:0000111 "T cell mediated cytotoxicity";
           iao:0000115 "The directed killing of a target cell by a T cell through the release of granules containing cytotoxic mediators or through the engagement of death receptors.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "T cell mediated cytotoxicity";
           rdfs:subClassOf go:0001906.
go:0002250 iao:0000111 "adaptive immune response";
           iao:0000115 "An immune response mediated by cells expressing specific receptors for antigen produced through a somatic diversification process, and allowing for an enhanced secondary response to subsequent exposures to the same antigen (immunological memory).";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "adaptive immune response";
           rdfs:subClassOf go:0006955.
go:0002367 iao:0000111 "cytokine production involved in immune response";
           iao:0000115 "The appearance of a cytokine due to biosynthesis or secretion following a cellular stimulus contributing to an immune response, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "cytokine production involved in immune response";
           rdfs:subClassOf go:0001816.
go:0002390 iao:0000111 "platelet activating factor production";
           iao:0000115 "The synthesis or release of platelet activating factor following a stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "platelet activating factor production";
           rdfs:subClassOf go:0001816.
go:0002507 iao:0000111 "tolerance induction";
           iao:0000115 "A process that directly activates any of the steps required for tolerance, a physiologic state in which the immune system does not react destructively against the components of an organism that harbors it or against antigens that are introduced to it.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "tolerance induction";
           rdfs:subClassOf go:0008150.
go:0002514 iao:0000111 "B cell tolerance induction";
           iao:0000115 "A process involving any mechanism for tolerance induction in B cells.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "B cell tolerance induction";
           rdfs:subClassOf go:0002507.
go:0002517 iao:0000111 "T cell tolerance induction";
           iao:0000115 "A process involving any mechanism for tolerance induction in T cells.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "T cell tolerance induction";
           rdfs:subClassOf go:0002507.
go:0002524 iao:0000111 "hypersensitivity";
           iao:0000115 "An inflammatory response to an exogenous environmental antigen or an endogenous antigen initiated by the adaptive immune system.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "hypersensitivity";
           rdfs:subClassOf go:0008150.
go:0002534 iao:0000111 "cytokine production involved in inflammatory response";
           iao:0000115 "The synthesis or release of a cytokine following a inflammatory stimulus as part of an inflammatory response, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "cytokine production involved in inflammatory response";
           rdfs:subClassOf go:0001816.
go:0003674 iao:0000111 "molecular_function";
           iao:0000115 "A molecular process that can be carried out by the action of a single macromolecular machine, usually via direct physical interactions with other molecular entities. Function in this sense denotes an action, or activity, that a gene product (or a complex) performs. These actions are described from two distinct but related perspectives: (1) biochemical activity, and (2) role as a component in a larger system/process.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "GO:molecular_function";
           rdfs:subClassOf pobo:BFO_0000015.
go:0003823 iao:0000111 "antigen binding";
           iao:0000115 "Interacting selectively and non-covalently with an antigen, any substance which is capable of inducing a specific immune response and of reacting with the products of that response, the specific antibody or specifically sensitized T-lymphocytes, or both. Binding may counteract the biological activity of the antigen.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "antigen binding";
           rdfs:subClassOf pobo:BFO_0000015.
go:0003824 iao:0000111 "catalytic activity";
           iao:0000115 "Catalysis of a biochemical reaction at physiological temperatures. In biologically catalyzed reactions, the reactants are known as substrates, and the catalysts are naturally occurring macromolecular substances known as enzymes. Enzymes possess specific binding sites for substrates, and are usually composed wholly or largely of protein, but RNA that has catalytic activity (ribozyme) is often also regarded as enzymatic.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "catalytic activity";
           rdfs:subClassOf go:0003674.
go:0003964 iao:0000111 "RNA-directed DNA polymerase activity";
           iao:0000115 "Catalysis of the reaction: deoxynucleoside triphosphate + DNA(n) = diphosphate + DNA(n+1). Catalyzes RNA-template-directed extension of the 3'- end of a DNA strand by one deoxynucleotide at a time.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "RNA-directed DNA polymerase activity";
           rdfs:subClassOf go:0003824.
go:0005216 iao:0000111 "ion channel activity";
           iao:0000115 "Enables the facilitated diffusion of an ion (by an energy-independent process) by passage through a transmembrane aqueous pore or channel without evidence for a carrier-mediated mechanism. May be either selective (it enables passage of a specific ion only) or non-selective (it enables passage of two or more ions of same charge but different size).";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "ion channel activity";
           rdfs:subClassOf go:0009987.
go:0005575 iao:0000111 "cellular_component";
           iao:0000115 "A location, relative to cellular compartments and structures, occupied by a macromolecular machine when it carries out a molecular function. There are two ways in which the gene ontology describes locations of gene products: (1) relative to cellular structures (e.g., cytoplasmic side of plasma membrane) or compartments (e.g., mitochondrion), and (2) the stable macromolecular complexes of which they are parts (e.g., the ribosome).";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "cellular_component";
           rdfs:subClassOf pobo:BFO_0000040.
go:0005694 iao:0000111 "chromosome";
           iao:0000115 "A structure composed of a very long molecule of DNA and associated proteins (e.g. histones) that carries hereditary information.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "chromosome";
           rdfs:subClassOf go:0005575.
go:0005739 iao:0000111 "mitochondrion";
           iao:0000115 "A semiautonomous, self replicating organelle that occurs in varying numbers, shapes, and sizes in the cytoplasm of virtually all eukaryotic cells. It is notably the site of tissue respiration.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "mitochondrion";
           rdfs:subClassOf go:0043227.
go:0006006 iao:0000111 "glucose metabolic process";
           iao:0000115 "The chemical reactions and pathways involving glucose, the aldohexose gluco-hexose. D-glucose is dextrorotatory and is sometimes known as dextrose; it is an important source of energy for living organisms and is found free as well as combined in homo- and hetero-oligosaccharides and polysaccharides.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "glucose metabolic process";
           rdfs:subClassOf go:0008150.
go:0006260 iao:0000111 "DNA replication";
           iao:0000115 "The cellular metabolic process in which a cell duplicates one or more molecules of DNA. DNA replication begins when specific sequences, known as origins of replication, are recognized and bound by initiation proteins, and ends when the original DNA molecule has been completely duplicated and the copies topologically separated. The unit of replication usually corresponds to the genome of the cell, an organelle, or a virus. The template for replication can either be an existing DNA molecule or RNA.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "DNA replication";
           rdfs:subClassOf go:0008150.
go:0006306 iao:0000111 "DNA methylation";
           iao:0000115 "The covalent transfer of a methyl group to either N-6 of adenine or C-5 or N-4 of cytosine.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "DNA methylation";
           rdfs:subClassOf go:0008150.
go:0006338 iao:0000111 "chromatin remodeling";
           iao:0000115 "Dynamic structural changes to eukaryotic chromatin occurring throughout the cell division cycle. These changes range from the local changes necessary for transcriptional regulation to global changes necessary for chromosome segregation.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "chromatin remodeling";
           rdfs:subClassOf go:0009987.
go:0006909 iao:0000111 "phagocytosis";
           iao:0000115 "An endocytosis process that results in the engulfment of external particulate material by phagocytes. The particles are initially contained within phagocytic vacuoles (phagosomes), which then fuse with primary lysosomes to effect digestion of the particles.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "phagocytosis";
           rdfs:subClassOf go:0008150.
go:0006955 iao:0000111 "immune response";
           iao:0000115 "Any immune system process that functions in the calibrated response of an organism to a potential internal or invasive threat.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "immune response";
           rdfs:subClassOf go:0050896.
go:0006974 iao:0000111 "cellular response to DNA damage stimulus";
           iao:0000115 "Any process that results in a change in state or activity of a cell (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a stimulus indicating damage to its DNA from environmental insults or errors during metabolism.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "cellular response to DNA damage stimulus";
           rdfs:subClassOf go:0050896.
go:0007049 iao:0000111 "cell cycle";
           iao:0000115 "The progression of biochemical and morphological phases and events that occur in a cell during successive cell replication or nuclear replication events. Canonically, the cell cycle comprises the replication and segregation of genetic material followed by the division of the cell, but in endocycles or syncytial cells nuclear replication or nuclear division may not be followed by cell division.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "cell cycle";
           rdfs:subClassOf go:0008150.
go:0007596 iao:0000111 "blood coagulation";
           iao:0000115 "The sequential process in which the multiple coagulation factors of the blood interact, ultimately resulting in the formation of an insoluble fibrin clot; it may be divided into three stages: stage 1, the formation of intrinsic and extrinsic prothrombin converting principle; stage 2, the formation of thrombin; stage 3, the formation of stable fibrin polymers.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "blood coagulation";
           rdfs:subClassOf go:0008150.
go:0008150 iao:0000111 "biological_process";
           iao:0000115 "A biological process represents a specific objective that the organism is genetically programmed to achieve. Biological processes are often described by their outcome or ending state, e.g., the biological process of cell division results in the creation of two daughter cells (a divided cell) from a single parent cell. A biological process is accomplished by a particular set of molecular functions carried out by specific gene products (or macromolecular complexes), often in a highly regulated manner and in a particular temporal sequence.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "biological_process";
           rdfs:subClassOf pobo:BFO_0000015;
           owl:disjointWith obi:0000011.
go:0008228 iao:0000111 "opsonization";
           iao:0000115 "The process in which a microorganism (or other particulate material) is rendered more susceptible to phagocytosis by coating with an opsonin, a blood serum protein such as a complement component or antibody.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "opsonization";
           rdfs:subClassOf go:0006909.
go:0008283 iao:0000111 "cell proliferation";
           iao:0000115 "The multiplication or reproduction of cells, resulting in the expansion of a cell population.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "cell proliferation";
           rdfs:subClassOf go:0008150.
go:0009566 iao:0000111 "fertilization";
           iao:0000115 "The union of gametes of opposite sexes during the process of sexual reproduction to form a zygote. It involves the fusion of the gametic nuclei (karyogamy) and cytoplasm (plasmogamy).";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "fertilization";
           rdfs:subClassOf go:0008150.
go:0009987 iao:0000111 "cellular process";
           iao:0000115 "Any process that is carried out at the cellular level, but not necessarily restricted to a single cell. For example, cell communication occurs among more than one cell, but occurs at the cellular level.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "cellular process";
           rdfs:subClassOf go:0008150.
go:0010467 iao:0000111 "gene expression";
           iao:0000115 "The process in which a gene's sequence is converted into a mature gene product or products (proteins or RNA). This includes the production of an RNA transcript as well as any processing to produce a mature RNA product or an mRNA or circRNA (for protein-coding genes) and the translation of that mRNA or circRNA into protein. Protein maturation is included when required to form an active form of a product from an inactive precursor form.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "gene expression";
           rdfs:subClassOf go:0008150.
go:0010573 iao:0000111 "vascular endothelial growth factor production";
           iao:0000115 "The appearance of vascular endothelial growth factor production due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "vascular endothelial growth factor production";
           rdfs:subClassOf go:0001816.
go:0016064 iao:0000111 "immunoglobulin mediated immune response";
           iao:0000115 "An immune response mediated by immunoglobulins, whether cell-bound or in solution.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "immunoglobulin mediated immune response";
           rdfs:subClassOf go:0008150.
go:0016570 iao:0000111 "histone modification";
           iao:0000115 "The covalent alteration of one or more amino acid residues within a histone protein.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "histone modification";
           rdfs:subClassOf go:0008150.
go:0019814 iao:0000111 "immunoglobulin complex";
           iao:0000115 "A protein complex that in its canonical form is composed of two identical immunoglobulin heavy chains and two identical immunoglobulin light chains, held together by disulfide bonds and sometimes complexed with additional proteins. An immunoglobulin complex may be embedded in the plasma membrane or present in the extracellular space, in mucosal areas or other tissues, or circulating in the blood or lymph.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "immunoglobulin complex";
           rdfs:subClassOf go:0043234.
go:0019815 iao:0000111 "B cell receptor complex";
           iao:0000115 "An immunoglobulin complex that is present in the plasma membrane of B cells and that in its canonical form is composed of two identical immunoglobulin heavy chains and two identical immunoglobulin light chains and a signaling subunit, a heterodimer of the Ig-alpha and Ig-beta proteins.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "B cell receptor complex";
           rdfs:subClassOf obi:1110022.
go:0019882 iao:0000111 "antigen processing and presentation";
           iao:0000115 "The process in which an antigen-presenting cell expresses antigen (peptide or lipid) on its cell surface in association with an MHC protein complex.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "antigen processing and presentation";
           rdfs:subClassOf go:0008150.
go:0019904 iao:0000111 "protein domain specific binding";
           iao:0000115 "Interacting selectively and non-covalently with a specific domain of a protein.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "protein domain specific binding";
           rdfs:subClassOf obi:0001588.
go:0030041 iao:0000111 "actin filament polymerization";
           iao:0000115 "Assembly of actin filaments by the addition of actin monomers to a filament.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "actin filament polymerization";
           rdfs:subClassOf go:0008150.
go:0030097 iao:0000111 "hemopoiesis";
           iao:0000115 "The process whose specific outcome is the progression of the myeloid and lymphoid derived organ/tissue systems of the blood and other parts of the body over time, from formation to the mature structure. The site of hemopoiesis is variable during development, but occurs primarily in bone marrow or kidney in many adult vertebrates.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "hemopoiesis";
           rdfs:subClassOf go:0008150.
go:0032601 iao:0000111 "connective tissue growth factor production";
           iao:0000115 "The appearance of connective tissue growth factor due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "connective tissue growth factor production";
           rdfs:subClassOf go:0001816.
go:0032602 iao:0000111 "chemokine production";
           iao:0000115 "The appearance of a chemokine due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "chemokine production";
           rdfs:subClassOf go:0001816.
go:0032604 iao:0000111 "granulocyte macrophage colony-stimulating factor production";
           iao:0000115 "The appearance of granulocyte macrophage colony-stimulating factor due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "granulocyte macrophage colony-stimulating factor production";
           rdfs:subClassOf go:0001816.
go:0032605 iao:0000111 "hepatocyte growth factor production";
           iao:0000115 "The appearance of hepatocyte growth factor due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "hepatocyte growth factor production";
           rdfs:subClassOf go:0001816.
go:0032606 iao:0000111 "type I interferon production";
           iao:0000115 "The appearance of type I interferon due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels. Type I interferons include the interferon-alpha, beta, delta, episilon, zeta, kappa, tau, and omega gene families.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "type I interferon production";
           rdfs:subClassOf go:0001816.
go:0032607 iao:0000111 "interferon-alpha production";
           iao:0000115 "The appearance of interferon-alpha due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interferon-alpha production";
           rdfs:subClassOf go:0032606.
go:0032608 iao:0000111 "interferon-beta production";
           iao:0000115 "The appearance of interferon-beta due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interferon-beta production";
           rdfs:subClassOf go:0001816.
go:0032609 iao:0000111 "interferon-gamma production";
           iao:0000115 "The appearance of interferon-gamma due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels. Interferon-gamma is also known as type II interferon.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interferon-gamma production";
           rdfs:subClassOf go:0001816.
go:0032610 iao:0000111 "interleukin-1 alpha production";
           iao:0000115 "The appearance of interleukin-1 alpha due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-1 alpha production";
           rdfs:subClassOf go:0032612.
go:0032611 iao:0000111 "interleukin-1 beta production";
           iao:0000115 "The appearance of interleukin-1 beta due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-1 beta production";
           rdfs:subClassOf go:0032612.
go:0032612 iao:0000111 "interleukin-1 production";
           iao:0000115 "The appearance of interleukin-1 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-1 production";
           rdfs:subClassOf go:0001816.
go:0032613 iao:0000111 "interleukin-10 production";
           iao:0000115 "The appearance of interleukin-10 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-10 production";
           rdfs:subClassOf go:0001816.
go:0032614 iao:0000111 "interleukin-11 production";
           iao:0000115 "The appearance of interleukin-11 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-11 production";
           rdfs:subClassOf go:0001816.
go:0032615 iao:0000111 "interleukin-12 production";
           iao:0000115 "The appearance of interleukin-12 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-12 production";
           rdfs:subClassOf go:0001816.
go:0032616 iao:0000111 "interleukin-13 production";
           iao:0000115 "The appearance of interleukin-13 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-13 production";
           rdfs:subClassOf go:0001816.
go:0032617 iao:0000111 "interleukin-14 production";
           iao:0000115 "The appearance of interleukin-14 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-14 production";
           rdfs:subClassOf go:0001816.
go:0032618 iao:0000111 "interleukin-15 production";
           iao:0000115 "The appearance of interleukin-15 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-15 production";
           rdfs:subClassOf go:0001816.
go:0032619 iao:0000111 "interleukin-16 production";
           iao:0000115 "The appearance of interleukin-16 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-16 production";
           rdfs:subClassOf go:0001816.
go:0032620 iao:0000111 "interleukin-17 production";
           iao:0000115 "The appearance of any member of the interleukin-17 family of cytokines due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-17 production";
           rdfs:subClassOf go:0001816.
go:0032621 iao:0000111 "interleukin-18 production";
           iao:0000115 "The appearance of interleukin-18 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-18 production";
           rdfs:subClassOf go:0001816.
go:0032622 iao:0000111 "interleukin-19 production";
           iao:0000115 "The appearance of interleukin-19 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-19 production";
           rdfs:subClassOf go:0001816.
go:0032623 iao:0000111 "interleukin-2 production";
           iao:0000115 "The appearance of interleukin-2 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-2 production";
           rdfs:subClassOf go:0001816.
go:0032624 iao:0000111 "interleukin-20 production";
           iao:0000115 "The appearance of interleukin-20 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-20 production";
           rdfs:subClassOf go:0001816.
go:0032625 iao:0000111 "interleukin-21 production";
           iao:0000115 "The appearance of interleukin-21 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-21 production";
           rdfs:subClassOf go:0001816.
go:0032626 iao:0000111 "interleukin-22 production";
           iao:0000115 "The appearance of interleukin-22 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-22 production";
           rdfs:subClassOf go:0001816.
go:0032627 iao:0000111 "interleukin-23 production";
           iao:0000115 "The appearance of interleukin-23 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-23 production";
           rdfs:subClassOf go:0001816.
go:0032628 iao:0000111 "interleukin-24 production";
           iao:0000115 "The appearance of interleukin-24 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-24 production";
           rdfs:subClassOf go:0001816.
go:0032629 iao:0000111 "interleukin-25 production";
           iao:0000115 "The appearance of interleukin-25 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-25 production";
           rdfs:subClassOf go:0001816.
go:0032630 iao:0000111 "interleukin-26 production";
           iao:0000115 "The appearance of interleukin-26 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-26 production";
           rdfs:subClassOf go:0001816.
go:0032631 iao:0000111 "interleukin-27 production";
           iao:0000115 "The appearance of interleukin-27 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-27 production";
           rdfs:subClassOf go:0001816.
go:0032632 iao:0000111 "interleukin-3 production";
           iao:0000115 "The appearance of interleukin-3 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-3 production";
           rdfs:subClassOf go:0001816.
go:0032633 iao:0000111 "interleukin-4 production";
           iao:0000115 "The appearance of interleukin-4 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-4 production";
           rdfs:subClassOf go:0001816.
go:0032634 iao:0000111 "interleukin-5 production";
           iao:0000115 "The appearance of interleukin-5 due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "interleukin-5 production";
           rdfs:subClassOf go:0001816.
