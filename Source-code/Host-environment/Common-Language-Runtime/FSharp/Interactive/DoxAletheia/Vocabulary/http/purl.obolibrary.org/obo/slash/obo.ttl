                                                 [owl:someValuesFrom obi:0100060 ; 
                                                 owl:onProperty obi:0000299 ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class].
obi:0001148 iao:0000111 "gene knock out"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "a genetic transformation that renders a gene non-functional, e.g. due to a point mutation, or the removal of all, or part of, the gene using recombinant methods."@en;
            iao:0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en;
            iao:0000119 "MO_771 gene_knock_out"@en;
            a owl:Class;
            rdfs:label "gene knock out"@en;
            rdfs:subClassOf obi:0600043.
obi:0001149 iao:0000111 "gene knock in"@en;
            iao:0000114 iao:0000120;
            iao:0000115 """a genetic transformation that involves the insertion of a protein coding cDNA sequence at a particular locus in an organism's chromosome. Typically, this is done in mice since the technology for this process is more refined, and because mouse embryonic stem cells are easily manipulated. The difference between knock-in technology and transgenic technology is that a knock-in involves a gene inserted into a specific locus, and is a \"targeted\" insertion."""@en;
            iao:0000117 "PERSON: Chris Stoeckert, Jie Zheng";
            iao:0000119 "WEB: http://en.wikipedia.org/wiki/Gene_Knock-in"@en,
                        "MO_437 gene_knock_in"@en;
            a owl:Class;
            rdfs:label "gene knock in"@en;
            rdfs:subClassOf obi:0600043.
obi:0001150 iao:0000111 "chromosomal substitution"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A genetic transformation in which all, or part, of a chromosome from a donor replaces that of the recipient. It does not include chromosome recombination. For single gene insertion, use the term 'gene knock in'. "@en;
            iao:0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en;
            iao:0000119 "MO_995 chromosomal_substitution"@en;
            a owl:Class;
            rdfs:label "chromosomal substitution"@en;
            rdfs:subClassOf obi:0600043.
obi:0001151 iao:0000111 "genetically modified material"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "a material entity, organism or cell,  that is the output of a genetic transformation process. "@en;
            iao:0000117 "PERSON: Jie Zheng"@en;
            iao:0000119 "GROUP: OBI"@en;
            iao:0000232 "term is proposed by BP on Oct 25, 2010 dev call"@en;
            a owl:Class;
            rdfs:label "genetically modified material"@en;
            rdfs:subClassOf obi:0000047;
            owl:equivalentClass [owl:unionOf (obi:0302859
                                              [owl:intersectionOf (pobo:CL_0000000
                                                                  [owl:someValuesFrom obi:0600043 ; 
                                                                  owl:onProperty obi:0000312 ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class]) ; 
                                 a owl:Class].
obi:0001152 iao:0000111 "transfection";
            iao:0000114 iao:0000120;
            iao:0000115 "a genetic transformation which relies on the use of physical, electrical and chemical phenomena to introduce DNA or RNA into a cell"@en;
            iao:0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en;
            iao:0000119 "MO_366 transfection";
            a owl:Class;
            rdfs:label "transfection"@en;
