obi:0001178 iao:0000111 "efficacy of epitope intervention experiment";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that tests  if inducing an epitope specific immune response in an organism has an effect, such as the ability to prevent, treat or excarbate diseases in the organism. ";
            iao:0000117 "Bjoern Peters";
            iao:0000118 "efficacy of in vivo intervention";
            a owl:Class;
            rdfs:label "efficacy of epitope intervention experiment";
            rdfs:subClassOf [owl:someValuesFrom obi:0001192 ; 
                             owl:onProperty pobo:BFO_0000051 ; 
