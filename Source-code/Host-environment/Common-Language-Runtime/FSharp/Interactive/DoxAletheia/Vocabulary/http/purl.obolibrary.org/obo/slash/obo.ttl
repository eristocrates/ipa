obi:0000812 iao:0000111 "measuring neural activity in the caudate nucleus assay";
            iao:0000112 "An SU micro-electrode was used to measure neural activity in the form of spike trains in the caudate nucleus of monkeys in response to a flashing light stimulus";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that measures neural activity in the caudate nucleus";
            iao:0000117 "Helen Parkinson";
            iao:0000119 "Jessica Turner, NIF",
                        "Dirk Derom, OBI";
            a owl:Class;
            rdfs:label "measuring neural activity in the caudate nucleus assay";
            rdfs:subClassOf obi:0000454.
obi:0000813 iao:0000111 "to be treated with active ingredient role";
            iao:0000112 "Role of a patient in a group treated with an active substance in a clinical trial";
            iao:0000114 iao:0000122;
            iao:0000115 "A study subject role which begins to exist when a subject is assigned to be one of those who will receive active ingredient, and is realized in a study execution in which they receive the active ingredient";
            iao:0000117 "Person:Alan Ruttenberg";
            iao:0000119 "PERSON: Helen Parkinson";
