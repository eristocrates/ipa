            a owl:Class;
            rdfs:label "solid NMR probe"@en;
            rdfs:subClassOf obi:0000516.
obi:0000480 iao:0000111 "Bruker high resolution probe"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "BRUKER BIOSPIN's experienced Research & Development group not only delivers top-performance probes for the more common experiments, but also a wealth of special probes for almost any application. For high resolution (HR) NMR we offer probes with a variety of important characteristics and features."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000118 "HR Probe"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400223",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            iao:0000232 "NMR probe"@en;
            a owl:Class;
            rdfs:label "Bruker high resolution probe"@en;
            rdfs:subClassOf obi:0000561.
obi:0000481 iao:0000111 "chromatography detector"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A chromatography detector is a device that locates in the dimensions of space and time, the positions of the components of a mixture that has been subjected to a chromatographic process and thus permits the senses to appreciate the nature of the separation.  Defining characteristics are Dynamic Range, Response Index or Linearity, Linear Dynamic range, Detector Response,  Detector Noise Level, Detector Sensitivity or Minimum Detectable Concentration, Total System Dispersion, Sensor Dimensions, Detector Time Constant, Pressure Sensitivity, Flow Sensitivity, Operating Temperature Range."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01012",
                        "WEB:<http://www.chromatography-online.org/GC-Detectors/Classification/rs1.html>"@en;
            a owl:Class;
            rdfs:label "chromatography detector"@en;
            rdfs:subClassOf obi:0000485.
obi:0000482 iao:0000111 "normal phase column"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A normal phase column is a chromatography column in which the stationary phase is more polar than the mobile phase. Its counterpart is the reversed phase column."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01097",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "normal phase column"@en;
            rdfs:subClassOf obi:0000038.
obi:0000483 iao:0000111 "APOLLO console"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "The APOLLO is a compact, modular, multiple-DSP, Windows XP Professional-based console that can be equipped with up to 8 DDS-based RF transmitter channels configurable from 2 kHz to 3.5 GHz. Each transmitter channel produces a nominal 1V output and has the most agile frequency, phase and amplitude control of any system on the market. An array of additional options are available including multiple RF transmitters, linear high-power RF amplifiers, digital receiver arrays, low noise figure preamplifiers, a gradient control system, shim unit, MAS spin-speed controller, variable temperature unit, digital lock system and probe/coil interface. With its numerous options, the Apollo can be configured for any NMR, NQR or MRI application."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400249",
                        "WEB:<http://www.tecmag.com/apollo.htm>"@en;
            iao:0000232 "NMR instrument/NMR console"@en;
            a owl:Class;
            rdfs:label "APOLLO console"@en;
            rdfs:subClassOf obi:0000599.
obi:0000484 iao:0000111 "NMR sample holder"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An NMR sample holder is the part of an NMR instrument, which carries the NMR probe,sample tube and the nmr sample."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400212";
            iao:0000232 "NMR device"@en;
            a owl:Class;
            rdfs:label "NMR sample holder"@en;
            rdfs:subClassOf obi:0000968.
obi:0000485 iao:0000111 "chromatography instrument"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "Any instrument that is used to carry out a chromatography experiment."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01262",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            iao:0000232 "chromatography device, defined class?"@en;
            a owl:Class;
            rdfs:label "chromatography instrument"@en;
            rdfs:subClassOf [owl:someValuesFrom obi:0000372 ; 
                             owl:onProperty pobo:RO_0000085 ; 
                             a owl:Restriction],
                            obi:0000932.
obi:0000486 iao:0000111 "continuous wave NMR instrument"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "Continuous wave NMR spectrometers are similar to optical spectrometers, but the sample is held in a strong magnetic field, where the frequency of the source is slowly scanned (in some instruments, the source frequency is held constant, and the field is scanned)."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "WEB:<http://teaching.shu.ac.uk/hwb/chemistry/tutorials/molspec/nmr3.htm>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400283";
            iao:0000232 "NMR instrument"@en;
            a owl:Class;
            rdfs:label "continuous wave NMR instrument"@en;
            rdfs:subClassOf obi:0000566.
obi:0000487 iao:0000111 "fourier transformation NMR instrument"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "In fourier transformation NMR, all frequencies in a spectrum are irradiated simultaneously with a radio frequency pulse. Following the pulse, the nuclei return to thermal equilibrium. A time domain emission signal is recorded by the instrument as the nuclei relax. A frequency domain spectrum is obtained by Fourier transformation."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400284",
                        "GROUP:<http://teaching.shu.ac.uk/hwb/chemistry/tutorials/molspec/nmr3.htm>"@en;
            iao:0000232 "NMR instrument"@en;
            a owl:Class;
            rdfs:label "fourier transformation NMR instrument"@en;
            rdfs:subClassOf obi:0000566.
obi:0000489 iao:0000111 "nitrogen phosphorous detector"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "The nitrogen phosphorus detector (NPD) (sometimes called the thermionic detector) is a very sensitive, specific detector the design of which, is based on the FID. Physically the sensor appears to be very similar to the FID but, in fact, operates on an entirely different principle. The nitrogen phosphorous detector (sometimes called the thermionic detector) is a very sensitive but specific detector that responds almost exclusively to nitrogen and phosphorous compounds. It is based on the flame ionization detector but differs in that it contains a rubidium or cesium silicate (glass) bead situated in a heater coil, a little distance from the hydrogen flame. If the detector is to respond to both nitrogen and phosphorous then the hydrogen flow should be minimal so that the gas does not ignite at the jet. If the detector is to respond to phosphorous only, a large flow of hydrogen is used which is burnt at the jet. The heated bead emits electrons by thermionic emission. These electrons are collected under a potential of a few volts by an appropriately placed anode, and provides a background current. When a solute containing nitrogen or phosphorous is eluted from the column, the partially combusted nitrogen and phosphorous materials are adsorbed on the surface of the bead. The adsorbed material reduces the work function of the surface and, as consequence, the emission of electrons is increased which raises the current collected at the electrode. The sensitivity of the detector to phosphorous is about 10-12 gram per ml and for nitrogen about 10-11 gram per ml at a signal to nose ratio of 2. The alkali bead as a finite life and needs regular replacement."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01089",
                        "WEB:<http://www.chromatography-online.org/topics/nitrogen/phosphorus/detector.html>"@en;
            a owl:Class;
            rdfs:label "nitrogen phosphorous detector"@en;
            rdfs:subClassOf obi:0000637.
obi:0000490 iao:0000111 "cation exchange column"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A cation exchange column is a chromatography column that is used in cation exchange chromatography."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01096",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "cation exchange column"@en;
            rdfs:subClassOf obi:0000560.
obi:0000491 iao:0000111 "direct detection NMR probe"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An NMR probe designed to allow the direct detection of acquisition nuclei."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400280";
            iao:0000232 "NMR device"@en;
            a owl:Class;
            rdfs:label "direct detection NMR probe"@en;
            rdfs:subClassOf obi:0000516.
obi:0000492 iao:0000111 "Bruker B-ACS system"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "The Bruker Automatic Sample Changer (B-ACS 60/120), used in conjunction with Bruker DISNMR, UXNMR or XWIN-NMR software, provides dialog-guided facilities which allow the user to easily and effectively perform automatic (continuous) experiments. Features include a 60 or 120 sample capacity, random accessing of samples, positive sample identification with the optional bar code reader, and temperature control of individual samples with the optional sample heater unit."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400210",
                        "WEB:<http://www.bruker-biospin.com/automation.html>"@en;
            iao:0000232 "NMR instrument"@en;
            a owl:Class;
            rdfs:label "Bruker B-ACS system"@en;
            rdfs:subClassOf obi:0000464.
obi:0000493 iao:0000111 "rapid resolution column"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A rapid resolution column is a chromatography column as marketed by Agilent, which is used with a rapid resolution cartridge to ensure a fast chromatography process with good separation resolution."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01102",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "rapid resolution column"@en;
            rdfs:subClassOf obi:0000932,
                            [owl:someValuesFrom obi:0000372 ; 
                             owl:onProperty pobo:RO_0000085 ; 
                             a owl:Restriction].
obi:0000494 iao:0000111 "liquid chromatography autosampler"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "Designed to perform capillary LC with injection of sample volumes ranging from nL to L."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01061",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "liquid chromatography autosampler"@en;
            rdfs:subClassOf obi:0000485.
obi:0000495 iao:0000111 "vacuum degasser"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A degassing system used for degassing solvents in liquid chromatography. Dissolved gasses, usually nitrogen and oxygen from the air, tend to be evolved in the mobile phase as the pressure is reduced when the mobile phase leaves the liquid chromatography column and enters the detector. Gasses in the mobile phase in the detector can produce completely unacceptable noise and, thus, must be removed. The dissolved gasses were originally removed under vacuum but, unfortunately, are soon replaced if the solvent is left in contact with air at atmospheric pressure. For this reason degassing is now usually carried out by bubbling helium through the mobile phase reservoirs. Secondly, vacuum is used in the thermionic detector. This consists of a device, very similar in design to the thermionic valve which is attached to a vacuum and a small quantity of the eluent from a gas chromatography column allowed to bleed through it. Helium is used as the carrier gas. The presence of solute vapor causes the thermionic current to fall. This type of detector tends to become contaminated rather readily."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01053",
                        "WEB:<http://www.chromatography-online.org/topics/vacuum.html>"@en;
            a owl:Class;
            rdfs:label "vacuum degasser"@en;
            rdfs:subClassOf obi:0000589.
obi:0000496 iao:0000111 "capillary column"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A capillary column is a thin tube with a small inner diameter, usually around 0.5 mm."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01066",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "capillary column"@en;
            rdfs:subClassOf obi:0000038.
obi:0000497 iao:0000111 "sample inlet"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "The column inlet (or injector) provides the means to introduce a sample into a continuous flow of carrier gas. The inlet is a piece of hardware attached to the column head."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "WEB:<http://en.wikipedia.org/wiki/Gas_chromatography#Inlets>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01044";
            iao:0000232 "chromatography device"@en;
            a owl:Class;
            rdfs:label "sample inlet"@en;
            rdfs:subClassOf obi:0000048.
obi:0000498 iao:0000111 "NMR tube washing system"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An automatic cleaning system for NMR tubes that removes previous probe and sample residues in order to allow for tube recycling."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400204",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            iao:0000232 "NMR instrument"@en;
            a owl:Class;
            rdfs:label "NMR tube washing system"@en;
            rdfs:subClassOf obi:0000968.
obi:0000499 iao:0000111 "NMR console"@en;
            iao:0000114 iao:0000125;
            iao:0000115 "A component of an NMR instrument that controls the activities of the other components."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400015";
            iao:0000232 "NMR instrument, TODO: same as or part of acquisition computer?"@en;
            a owl:Class;
            rdfs:label "NMR console"@en;
            rdfs:subClassOf obi:0000968.
obi:0000500 iao:0000111 "dual loop autosampler"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A dual loop autosampler is an autosampler that is designed for handling both analytical (10 mL/min flow rate) to preparative scale sample purification (100 mL/min flow rate)."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01063",
                        "WEB:<http://www.chem.agilent.com/scripts/pds.asp?lpage=17149>"@en;
            a owl:Class;
            rdfs:label "dual loop autosampler"@en;
            rdfs:subClassOf obi:0000494.
obi:0000501 iao:0000111 "variable wavelength detector"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A chromatography detector, that can detect signals within a certain range at user-defined wavelengths."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01079",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "variable wavelength detector"@en;
            rdfs:subClassOf [owl:someValuesFrom obi:0000453 ; 
                             owl:onProperty pobo:RO_0000085 ; 
                             a owl:Restriction],
                            obi:0000832.
obi:0000503 iao:0000111 "Bruker LC-NMR platform"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "The LC-NMR/MS setup was first introduced by Bruker BioSpin in 1999. An LC-NMR system including a Bruker Peak Sampling Unit (BPSU-36) was coupled with a Bruker Daltonics esquire series ion trap mass spectrometer via a Bruker NMR-MS interface (BNMI). Since October 2004 the Bruker Daltonics microTOF-LC time-of-flight mass spectrometer can also be integrated in an LC-NMR setup."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400276",
                        "WEB:<http://www.bruker-biospin.com/hyphenation_lcnmr_ms.html>"@en;
            iao:0000232 "hyphenated NMR instrument platform",
                        "NMR instrument"@en;
            a owl:Class;
            rdfs:label "Bruker LC-NMR platform"@en;
            rdfs:subClassOf obi:0000596.
obi:0000504 iao:0000111 "sample injection system"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An automated chromatography system that injects the sample into the chromatography columns in order to increase speed and minimize human involvement in the purification process for  better reproducibility."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01057";
            iao:0000232 "chromatography device"@en;
            a owl:Class;
            rdfs:label "sample injection system"@en;
            rdfs:subClassOf obi:0000048.
obi:0000505 iao:0000111 "multiple wavelength detector"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A chromatography detector, that can detect many discrete wavelengths in parallel and produces a multiple wavelength chromatographic profile."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01078";
            a owl:Class;
            rdfs:label "multiple wavelength detector"@en;
            rdfs:subClassOf [owl:someValuesFrom obi:0000453 ; 
                             owl:onProperty pobo:RO_0000085 ; 
                             a owl:Restriction],
                            obi:0000832.
obi:0000506 iao:0000111 "photoionization detector"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "The selective determination of aromatic hydrocarbons or organo-heteroatom species is the job of the photoionization detector (PID). This device uses ultraviolet light as a means of ionizing an analyte exiting from a GC column. The ions produced by this process are collected by electrodes. The current generated is therefore a measure of the analyte concentration. f the amount of ionization is reproducible for a given compound, pressure, and light source then the current collected at the PID's reaction cell electrodes is reproducibly proportional to the amount of that compound entering the cell. The reason why the compounds that are routinely analyzed are either aromatic hydrocarbons or heteroatom containing compounds (like organosulfur or organophosphorus species) is because these species have ionization potentials (IP) that are within reach of commercially available UV lamps. The available lamp energies range from 8.3 to 11.7 ev, that is, lambda max ranging from 150 nm to 106 nm. Although most PIDs have only one lamp, lamps in the PID are exchanged depending on the compound selectivity required in the analysis."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000118 "PID"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01090",
                        "WEB:<http://www.chemistry.adelaide.edu.au/external/soc-rel/content/pid.htm>"@en;
            a owl:Class;
            rdfs:label "photoionization detector"@en;
            rdfs:subClassOf obi:0000637.
obi:0000507 iao:0000111 "gas generator"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An instrument that generates gases for use with the gas chromatograph. Previously gas was obtained from gas tanks or gas cylinders. However, over the past decade the use of gas generators have become more popular as it avoids having gases at high pressure in the laboratory which is perceived by some as potentially dangerous. In addition, the use of a hydrogen generator avoids the use of a cylinder of hydrogen at high pressure which is also perceived by some as a serious fire hazard despite the fact that they have been used in laboratories, quite safely for nearly a century."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01033",
                        "WEB:<http://www.chromatography-online.org/GC/Gas-Supplies/Pure-Air-Generators./rs5.html>"@en;
            iao:0000232 "gas chromatography equipment"@en;
            a owl:Class;
            rdfs:label "gas generator"@en;
            rdfs:subClassOf obi:0000542.
obi:0000508 iao:0000111 "column jacket"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A column jacket is a piece of column chromatography equipment that covers a column in order to ensure thermoisolation and create a controllable thermostatic microenvironment."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01276",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            iao:0000232 "chromatography device"@en;
            a owl:Class;
            rdfs:label "column jacket"@en;
            rdfs:subClassOf obi:0000048.
obi:0000509 iao:0000111 "electron capture detector"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "The electron capture detector is a GC detector that uses a radioactive Beta emitter (electrons) to ionize some of the carrier gas and produce a current between a biased pair of electrodes. When organic molecules that contain electronegative functional groups, such as halogens, phosphorous, and nitro groups pass by the detector, they capture some of the electrons and reduce the current measured between the electrodes."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000118 "ECD"@en;
            iao:0000119 "WEB:<http://homepages.onsnet.nu/%7Ealkema/html/whatisgc.html>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01085";
            a owl:Class;
            rdfs:label "electron capture detector"@en;
            rdfs:subClassOf obi:0000637.
obi:0000510 iao:0000111 "reversed phase column"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A reversed phase column is a chromatography column in which the mobile phase is more polar than the stationary phase. Its counterpart is the normal phase column."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01106",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "reversed phase column"@en;
            rdfs:subClassOf obi:0000038.
obi:0000511 iao:0000111 "injector lubricant"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A lubricant used in liquid chromatography that eases sample injector penetration."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01118",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "injector lubricant"@en;
            rdfs:subClassOf obi:0000601.
obi:0000512 iao:0000111 "isolation of cell population";
            iao:0000112 "removing CD4+ cells from PBMCs using magnetic beads.";
            iao:0000114 iao:0000123;
            iao:0000115 "a process in which a population of cells with certain characteristics is isolated from a larger population";
            iao:0000117 "Person: Bjoern Peters";
            a owl:Class;
            rdfs:label "isolation of cell population";
            rdfs:subClassOf [owl:someValuesFrom obi:0100060 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction],
                            obi:0600014,
                            [owl:someValuesFrom obi:0100060 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom obi:0000681 ; 
                             owl:onProperty obi:0000417 ; 
                             a owl:Restriction].
obi:0000513 iao:0000111 "DISCOVERY console"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "The Discovery console is a Windows XP Professional-based, integrated console designed especially for Solid-State NMR. The console includes everything needed to interface to any magnet and solids probe - from computer to cables to duplexing network."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400247";
            iao:0000232 "NMR instrument/NMR console"@en;
            a owl:Class;
            rdfs:label "DISCOVERY console"@en;
            rdfs:subClassOf obi:0000599.
obi:0000514 iao:0000111 "Bruker AMX series NMR instrument"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A series of older Bruker NMR magnets, now out of production. The Bruker AMX500 has proven an extremely reliable workhorse, with excellent lineshape yielding superior water suppression even without gradients. The Oxford 11.7 Tesla 5.2 cm bore magnet rests on a TMC vibration damping table. Homogeneity is controlled by a BSN-18 and BSN-2 with 19 shim controls. In addition to the 5 mm triple resonance probe, the AMX is equipped with a 10mm broadband observe probe."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400240",
                        "WEB:<http://www.tufts.edu/med/biochemistry/NMR/amx500.html>"@en;
            iao:0000232 "NMR instrument"@en;
            a owl:Class;
            rdfs:label "Bruker AMX series NMR instrument"@en;
            rdfs:subClassOf obi:0000596.
obi:0000515 iao:0000111 "chromatofocusing column"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A chromatofocusing column is a chromatography column in which a resin is equilibrated at one pH and eluted at a second pH. The use of a weak ion-exchange resin causes a pH gradient to be formed at the solvent front owing to the buffering action of the resin. This pH gradient in turn leads to an ordering of proteins by isoelectric point. Molecules of charge sign opposite the resin bind; those of charge sign like the resin do not bind."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01209",
                        "WEB:<http://www.bioprocessintl.com/default.asp?page=glossary&TopicID=1>"@en;
            a owl:Class;
            rdfs:label "chromatofocusing column"@en;
            rdfs:subClassOf obi:0000038.
obi:0000516 iao:0000111 "NMR probe"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "Part of an NMR instrument that detects the signals emitted from a sample. No single probe can perform the full range of experiments, and probes that are designed to perform more than one type of measurement usually suffer from performance compromises. The probe represents a rather fragile single point of failure that can render an NMR system completely unusable if the probe is dropped or otherwise damaged. Probes are usually characterised by Sample diameter and Frequency.\\n  alt The instrument that transmits and receives radiofrequency to and from the NMR sample."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400014",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            iao:0000232 "NMR instrument"@en;
            a owl:Class;
            rdfs:label "NMR probe"@en;
            rdfs:subClassOf [owl:someValuesFrom obi:0000566 ; 
                             owl:onProperty pobo:BFO_0000050 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom obi:0000453 ; 
                             owl:onProperty pobo:RO_0000085 ; 
                             a owl:Restriction],
                            obi:0000832.
obi:0000517 iao:0000111 "NMR magnet"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A magnet which induces a certain frequency (MHz) and which has a certain bore diameter.\\n  alt The NMR signal is a natural physical property of the certain atomic nuclei but it can only be detected with an external magnetic field. A magnet is a fundamental part of an NMR instrument which induces an electromagnetic force field (RF pulse) and by this excites and aligns the spins of the electrons of the NMR acquisition nucleus. It is usually a big (superconducting) electromagnet which is cooled by liquid helium and can be adjusted to a frequency between 200 and 950 MHz. The magnetic field strength is measured in Tesla or Gauss."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400185";
            iao:0000232 "NMR instrument"@en;
            a owl:Class;
            rdfs:label "NMR magnet"@en;
            rdfs:subClassOf obi:0000968.
obi:0000518 iao:0000111 "trap column"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A trap column is a chromatography column which is used prior to a, e.g. mass spectrometry, separation to clean up or concentrate controlled amounts of samples prior to elution to a detector."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01261",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "trap column"@en;
            rdfs:subClassOf obi:0000038.
obi:0000519 iao:0000111 "flow probe"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An NMR probe that allows the automatized flow-through of a sample. The sample is aspirated via a syringe pump into the Flow probe, the NMR spectrum is acquired and when the experiment is complete, the sample is returned to back to an external source (well plate) or flushed to waste. Sometimes pulsed field gradients (PFG) can be established in flow probes."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "WEB:<http://www.varianinc.com/cgi-bin/nav?products/NMR/accessory/auto_samplers/vast/index&cid=HFIH>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400131";
            iao:0000232 "NMR device"@en;
            a owl:Class;
            rdfs:label "flow probe"@en;
            rdfs:subClassOf obi:0000516.
obi:0000520 iao:0000111 "clinical chemistry assay";
            iao:0000112 "Influence of hydroxyethyl starch (6% HES 130/0.4) administration on hematology and clinical chemistry parameters.";
            iao:0000114 iao:0000120;
            iao:0000115 "An analyte assay which uses analytical methods to produce measurements and data on the concentration of chemical parameters (analytes) present in a bodily fluid collected from an organism.";
            iao:0000117 "Philippe Rocca-Serra";
            iao:0000118 "detection of analyte in blood sample",
                        "chemical pathology";
            iao:0000119 "url:https://en.wikipedia.org/wiki/Clinical_chemistry";
            a owl:Class;
            rdfs:label "clinical chemistry assay";
            rdfs:subClassOf obi:0000443,
                            [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (obi:0000275
                                                                                         [owl:someValuesFrom obi:0000576 ; 
                                                                                         owl:onProperty pobo:RO_0000052 ; 
                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty pobo:BFO_0000055 ; 
                                                 a owl:Restriction]
                                                 [owl:someValuesFrom obi:0000576 ; 
                                                 owl:onProperty obi:0000293 ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class],
                            [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (obi:0000067
                                                                                         [owl:someValuesFrom obi:0000655 ; 
                                                                                         owl:onProperty pobo:RO_0000081 ; 
                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty pobo:BFO_0000055 ; 
                                                 a owl:Restriction]
                                                 [owl:someValuesFrom [owl:intersectionOf (obi:0000655
                                                                                         [owl:someValuesFrom obi:0000067 ; 
                                                                                         owl:onProperty pobo:RO_0000087 ; 
                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty obi:0000293 ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class].
obi:0000521 iao:0000111 "flame ionization detector"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A flame ionization detector is a GC detector that consist of a hydrogen/air flame and a collector plate which are normally heated independently of the chromatographic oven. Heating is necessary in order to prevent condensation of water generated by the flame and also to prevent any hold-up of solutes as they pass from the column to the flame. There is an electrode above the flame to collect the ions formed at a hydrogen/air flame. The number of ions hitting the collector is measured and a signal is generated. Flame ionization detectors are most widely used and generally applicable for gas chromatography and hence is used for routine and general purpose analysis. It is easy to use but destructive of the sample."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000118 "FID"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01197",
                        "WEB:<http://homepages.onsnet.nu/%7Ealkema/html/whatisgc.html>"@en;
            a owl:Class;
            rdfs:label "flame ionization detector"@en;
            rdfs:subClassOf obi:0000637.
obi:0000522 iao:0000111 "vial"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A vial is a cylindrical container often made from glass tubing."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01117",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "vial"@en;
            rdfs:subClassOf obi:0000601.
obi:0000523 iao:0000111 "magic angle spinning rotor"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A rotor device that holds the NMR sample and enables the adjustment of the orientation of the rotation axis for a sample in a NMR instrument in the magic angle."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000118 "MAS rotor"@en;
            iao:0000119 "WEB:<http://www.freepatentsonline.com/4352066.html>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400130";
            iao:0000232 "NMR instrument"@en;
            a owl:Class;
            rdfs:label "magic angle spinning rotor"@en;
            rdfs:subClassOf [owl:someValuesFrom obi:0000566 ; 
                             owl:onProperty pobo:BFO_0000050 ; 
                             a owl:Restriction],
                            obi:0000968.
obi:0000524 iao:0000111 "Varian VXR spectrometer"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A Varian NMR spectrometer."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "WEB:<http://www.scs.uiuc.edu/NMR/instruments/vxr500.php>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400238";
            iao:0000232 "NMR instrument"@en;
            a owl:Class;
            rdfs:label "Varian VXR spectrometer"@en;
            rdfs:subClassOf obi:0000611.
obi:0000525 iao:0000111 "splitless GC injector"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "Injected sample enters column immediately (while split valve to split vent is closed). Here a sample is introduced into a heated small chamber via a syringe through a septum - the heat facilitates volatilization of the sample and sample matrix. The carrier gas then either sweeps the entirety (splitless mode) or a portion (split mode) of the sample into the column. In split mode, a part of the sample/carrier gas mixture in the injection chamber is exhausted through the split vent."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01060",
                        "WEB:<http://en.wikipedia.org/wiki/Gas_chromatography>"@en;
            a owl:Class;
            rdfs:label "splitless GC injector"@en;
            rdfs:subClassOf obi:0000504.
obi:0000526 iao:0000111 "preparative autosampler"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "For preparative LC with injection of sample volumes ranging from L to mL ranges."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01062",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "preparative autosampler"@en;
            rdfs:subClassOf obi:0000494.
obi:0000527 iao:0000111 "flow high resolution probe"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "Hyphenated analytical techniques combining mass spectrometry and chromatography are well-established laboratory tools. The combination of chromatography and NMR has also made its way into the analytical laboratory. Further developments even combine all three techniques into an LC-NMR/NMR-MS system. The use of solid phase extraction provides an efficient interface between chromatography and NMR with demands for special type of flow probes."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000118 "flow HR-probe"@en;
            iao:0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400195";
            iao:0000232 "NMR probe"@en;
            a owl:Class;
            rdfs:label "flow high resolution probe"@en;
            rdfs:subClassOf obi:0000480.
obi:0000528 iao:0000111 "liquid chromatography valve"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A sample valve that must be able to sustain pressures up to 10,000 p.s.i., although it is most likely to operate on a continuous basis, at pressures of 3,000 p.s.i. or less. The higher the operating pressure the tighter the valve seating surfaces must be forced together to eliminate any leak. It follows that any abrasive material, however fine, that passes into the valve can cause the valve seating to become scored each time it is rotated which will ultimately lead to leaks. This will cause the sample size to vary between samples and eventually affect the accuracy of the analysis. It follows that any solid material must be carefully removed from any sample before filling the valve. The sample volume of an internal loop valve is situated in the connecting slot of the valve rotor and can be used only for relatively small sample volumes. Internal sample loop valves provide samples with volumes ranging from 0.1 ml to about 0.5 ml. Valve operation is shown in figure 6. The left-hand side diagram shows the load position. The sample occupies the rotor slot and has been filled by passing the sample from an appropriate syringe through the rotor slot to waste. While loading the sample, the mobile phase supply is passed through the valve directly to the column. To place the sample onto the column, the valve is then rotated and the valve slot containing the sample is now placed between the solvent supply and the column. As a result, the sample is passed into the column by the flow of solvent."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "WEB:<http://www.chromatography-online.org/EC-Dispersion/HPLC-Sample-Valves/rs16.html>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01110";
            iao:0000232 "chromatography device"@en;
            a owl:Class;
            rdfs:label "liquid chromatography valve"@en;
            rdfs:subClassOf obi:0000048.
obi:0000529 iao:0000111 "JEOL NMR probe"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An NMR probe that is manufactured by JEOL."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400232",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            iao:0000232 "NMR device"@en;
            a owl:Class;
            rdfs:label "JEOL NMR probe"@en;
            rdfs:subClassOf obi:0000516.
obi:0000530 iao:0000111 "Bruker UltraShield Plus NMR magnet"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An NMR magnet of which Brukers claims it is the latest and most advanced self-shielding NMR magnet technology ever developed. These magnets are the ultimate advancement in high performance, actively-shielded NMR solutions. They offer unprecedented shielding performance whilst ensuring no compromise in system homogeneity, stability or cryogenic specifications."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "WEB:<http://www.bruker-biospin.com/nmr_magnets_usplus.html>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400190";
            iao:0000232 "NMR instrument"@en;
            a owl:Class;
            rdfs:label "Bruker UltraShield Plus NMR magnet"@en;
            rdfs:subClassOf obi:0000597.
obi:0000531 iao:0000111 "Bruker CryoProbe"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "The Bruker BioSpin CryoProbe is a high-performance cryogenically cooled probe developed for high-resolution applications. It has improved signal/noise (S/N) ratios obtained by reducing the operating temperature of the coil and the pre-amplifier. As a result, the efficiency of the coil is improved and the noise of the coil and the pre-amplifier are reduced.The dramatic increase in the S/N ratio by a factor of 3-4, as compared to conventional probes, leads to a possible reduction in experiment time of up to 16 or a reduction in required sample concentration by a factor of up to 4. The CryoProbes possess key characteristics for NMR analysis:\\n   Significant S/N gains (with moderately salty samples also)\\n   Short pulse widths\\n   Short ring down times\\n   Linear behavior in power response\\n   Gradient capability\\n   CryoProbes are available as Triple Resonance, Dual, Selective X Detection, MicroImaging, and Quad Nucleus Probes configurations at 400 MHz and higher\\n   All high resolution probes have a lock circuit\\n   All high resolution probes have Z-gradient."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400191";
            iao:0000232 "NMR probe"@en;
            a owl:Class;
            rdfs:label "Bruker CryoProbe"@en;
            rdfs:subClassOf obi:0000561.
obi:0000532 iao:0000111 "column cartridge"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A device that binds the chromatography column and additional connector elements and / or valves or syringes into one physical unity for further processing."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01055";
            iao:0000232 "chromatography device, check on definition !"@en;
            a owl:Class;
            rdfs:label "column cartridge"@en;
            rdfs:subClassOf obi:0000048.
obi:0000533 iao:0000111 "affinity column"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An affinity column is a chromatography column that is used in affinity chromatography. Differences in the affinity of molecules to be separated to a stationary phase are used for discriminate retention."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01094",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "affinity column"@en;
            rdfs:subClassOf obi:0000038.
obi:0000534 iao:0000111 "tecmag NMR instrument"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An NMR instrument that is manufactured by tecmag."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400250",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            iao:0000232 "NMR instrument"@en;
            a owl:Class;
            rdfs:label "tecmag NMR instrument"@en;
            rdfs:subClassOf obi:0000566.
obi:0000535 iao:0000111 "gel filtration column"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A Gel filtration column is a chromatography column for size-exclusion chromatography, in which the stationary phase is a gel. The main application of gel filtration chromatography is the fractionation of proteins and other water-soluble polymers."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01104",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "gel filtration column"@en;
            rdfs:subClassOf obi:0000618.
obi:0000536 iao:0000111 "fraction collector"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A fraction detector is a device that allows regular or specified samples to be taken from a column eluate and stored in a retrievable form. The storage vessels are usually small sample tubes or vials that are oriented in a rotating disk or in a moving belt, there movement usually being controlled by a microprocessor. On receiving a signal from the microprocessor, the next vial is placed under the column outlet and the eluate collected until receiving another signal from the computer. Once the properties of the chromatogram that describes the separation has been ascertained, then the collection program can be defined. The fractions can be collected on a basis of time either at regular intervals or a specific times to collect specific peaks. Alternatively the fractions can be collected by monitoring the detector output and when a peak starts to elute the fraction collector is activated and the peak collected in a specific vial. When the peak returns to base line the column eluate is then directed to waste until the next peak starts eluting. Fraction collectors are in common use with most liquid chromatographs. They are used to collect samples for further purification, subsequent examination by spectroscopic techniques or for biological or organoleptic testing."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01073",
                        "WEB:<http://www.chromatography-online.org/topics/fraction/collector.html>"@en;
            a owl:Class;
            rdfs:label "fraction collector"@en;
            rdfs:subClassOf obi:0000485.
obi:0000537 iao:0000111 "copy number variation profiling assay";
            iao:0000112 "Profiling of copy number variations (CNVs) in healthy individuals from three ethnic groups using a human genome 32 K BAC-clone-based array. PMID:18058796";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that determines lost or amplified genomic regions of DNA by comparing genomic DNA originating from tissues from the same or different individuals using specific techniques such as CGH, array CGH, SNP genotyping";
            iao:0000117 "Philippe Rocca-Serra";
            iao:0000118 "CNV analysis";
            a owl:Class;
            rdfs:label "copy number variation profiling assay";
            rdfs:subClassOf [owl:someValuesFrom iao:0000109 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom [owl:someValuesFrom obi:0001404 ; 
                                                 owl:onProperty iao:0000136 ; 
                                                 a owl:Restriction] ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            obi:0000070.
obi:0000538 iao:0000111 "in-line filter"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A solvent filter that sits between the pump and the injection valve that prevents dust particles, general debris and, to some extent, bacteria from entering the chromatography system. Contaminants can interfere with the low-pressure gradient former or the pump and particles entering valves may interfere with the proper function. The result could cause an increased baseline noise, non-repeatable gradient forming, unreliable flow rate or other interferences. Solvent in-line filters are low-pressure filters and will allow a high flow rate due to a large surface area and large porosity."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01123",
                        "WEB:<http://www.appliedporous.com/frits-chromatography.htm>"@en;
            a owl:Class;
            rdfs:label "in-line filter"@en;
            rdfs:subClassOf obi:0000592.
obi:0000539 iao:0000111 "imaging NMR probe"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An NMR probe that is designed for generating pictures from sample states via NMR imaging."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400244";
            iao:0000232 "NMR device"@en;
            a owl:Class;
            rdfs:label "imaging NMR probe"@en;
            rdfs:subClassOf obi:0000516.
obi:0000540 iao:0000111 "isolation of adherent cells";
            iao:0000114 iao:0000123;
            iao:0000115 "a material separation process in which cells that stick to the container in which they are grown as a cell culture are separated from those in the liquid component of the culture. The output of this process are adherent cells.";
            a owl:Class;
            rdfs:label "isolation of adherent cells";
            rdfs:subClassOf [owl:someValuesFrom obi:0100060 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom obi:0100060 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction],
                            obi:0000512.
obi:0000541 iao:0000111 "Bruker AC series NMR instrument"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A series of older Bruker NMR magnets, now out of production."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "GROUP:<http://msi-ontology.sourceforge.net>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400241";
            iao:0000232 "NMR instrument"@en;
