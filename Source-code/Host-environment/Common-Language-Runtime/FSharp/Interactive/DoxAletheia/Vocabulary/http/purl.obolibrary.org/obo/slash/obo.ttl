            rdfs:label "radiation treatment within the recent past exclusion criterion";
            rdfs:subClassOf obi:0500028.
obi:0002428 iao:0000111 "BMI range inclusion criterion";
            iao:0000112 "An important inclusion criterion is for for the individual to have a BMI between 18.5 and 35.0";
            iao:0000114 iao:0000120;
            iao:0000115 "An inclusion criterion that defines and states a Body Mass Index range, which if met, makes an individual suitable for a given task or participation in a given process.";
            iao:0000117 "Chris Stoeckert, Helena Ellis";
