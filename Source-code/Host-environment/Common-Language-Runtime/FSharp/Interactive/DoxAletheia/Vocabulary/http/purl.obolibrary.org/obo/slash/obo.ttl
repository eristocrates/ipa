obi:0002108 iao:0000111 "small-angle scattering assay";
            iao:0000112 "Targeting a solution of antibody bound to a protein with a neutron beam to determine the binding site of the antibody on the protein";
            iao:0000114 iao:0000120;
            iao:0000115 "A 3D structure determination assay in which the scattering pattern of a neutron or x-ray beam targeted at a material entity is recorded at small angles relative to the incident beam to determine the size, shape and structure of the material entity examined.";
            iao:0000117 "IEDB";
            iao:0000118 "SAXS";
