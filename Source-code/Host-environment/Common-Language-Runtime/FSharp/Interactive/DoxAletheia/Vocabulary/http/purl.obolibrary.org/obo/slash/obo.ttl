                        a owl:Class];
            rdfs:subPropertyOf pobo:BFO_0000051.
iao:0000584 iao:0000112 "pmid:20604925 - time-lapse live cell microscopy"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A data set that is an aggregate of data recording some measurement at a number of time points. The time series data set is an ordered list of pairs of time measurement data and the corresponding measurement data acquired at that time."@en;
            iao:0000117 "Alan Ruttenberg"@en;
            iao:0000118 "experimental time series"@en;
            a owl:Class;
            rdfs:label "time sampled measurement data set"@en;
            rdfs:subClassOf [owl:someValuesFrom iao:0000582 ; 
                             owl:onProperty pobo:BFO_0000051 ; 
                             a owl:Restriction],
                            iao:0000100.
iao:0000589 iao:0000111 "OBO foundry unique label"@en;
            iao:0000114 iao:0000125;
            iao:0000115 "An alternative name for a class or property which is unique across the OBO Foundry."@en;
            iao:0000116 "The intended usage of that property is as follow: OBO foundry unique labels are automatically generated based on regular expressions provided by each ontology, so that SO could specify unique label = 'sequence ' + [label], etc. , MA could specify 'mouse + [label]' etc. Upon importing terms, ontology developers can choose to use the 'OBO foundry unique label' for an imported term or not. The same applies to tools .";
            iao:0000117 "PERSON:Alan Ruttenberg"@en,
                        "PERSON:Chris Mungall"@en,
                        "PERSON:Melanie Courtot"@en,
                        "PERSON:Bjoern Peters"@en;
            iao:0000119 "GROUP:OBO Foundry <http://obofoundry.org/>"@en;
            a owl:AnnotationProperty;
            rdfs:label "OBO foundry unique label"@en.
iao:0000590 iao:0000111 "written name"@en;
            iao:0000112 """\"United States of America\""""@en,
                        """\"Bill Clinton\""""@en,
                        """\"The Eiffel Tower\""""@en;
            iao:0000114 iao:0000125;
            iao:0000115 "A textual entity that denotes a particular in reality."@en;
            iao:0000117 "PERSON: Bill Hogan"@en;
            iao:0000119 "https://github.com/information-artifact-ontology/IAO/issues/114"@en;
            iao:0000232 """The qualifier \"written\" is to set it apart from spoken names.  Also, note the restrictions to particulars.  We are not naming universals.   We could however, be naming, attributive collections which are particulars, so \"All people located in the boundaries of the city of Little Rock, AR on June 18, 2011 at 9:50a CDT\" would be a name."""@en;
            a owl:Class;
            rdfs:label "written name"@en;
            rdfs:subClassOf iao:0000300.
iao:0000591 iao:0000114 iao:0000123;
            iao:0000115 "A software method (also called subroutine, subprogram, procedure, method, function, or routine) is software designed to execute a specific task."@en;
            iao:0000117 "PERSON: Michel Dumontier"@en,
                        "PERSON: Melanie Courtot"@en;
            iao:0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en;
            a owl:Class;
            rdfs:label "software method"@en;
            rdfs:subClassOf iao:0000010.
iao:0000592 iao:0000114 iao:0000123;
            iao:0000115 " A software module is software composed of a collection of software methods."@en;
            iao:0000117 "PERSON: Michel Dumontier"@en,
                        "PERSON: Melanei Courtot"@en;
            iao:0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en;
            a owl:Class;
            rdfs:label "software module"@en;
            rdfs:subClassOf iao:0000010.
iao:0000593 iao:0000114 iao:0000123;
            iao:0000115 "A software library is software composed of a collection of software modules and/or software methods in a form that can be statically or dynamically linked to some software application."@en;
            iao:0000117 "PERSON: Michel Dumontier"@en,
                        "PERSON: Melanie Courtot"@en;
            iao:0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en;
            a owl:Class;
            rdfs:label "software library"@en;
            rdfs:subClassOf iao:0000010.
iao:0000594 iao:0000114 iao:0000123;
            iao:0000115 "A software application is software that can be directly executed by some processing unit."@en;
            iao:0000117 "PERSON: Michel Dumontier"@en,
                        "PERSON: Melanie Courtot"@en;
            iao:0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en;
            a owl:Class;
            rdfs:label "software application"@en;
            rdfs:subClassOf iao:0000010.
iao:0000595 iao:0000114 iao:0000123;
            iao:0000115 """ A software script is software whose instructions can be executed using a software 
interpreter."""@en;
            iao:0000117 "PERSON: Michel Dumontier"@en,
                        "PERSON: Melanie Courtot"@en;
            iao:0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en;
            a owl:Class;
            rdfs:label "software script"@en;
            rdfs:subClassOf iao:0000010.
iao:0000596 iao:0000112 """Ontology: <http://purl.obolibrary.org/obo/ro/idrange/>
  Annotations: 
     'has ID prefix': \"http://purl.obolibrary.org/obo/RO_\"
     'has ID digit count' : 7,
     rdfs:label \"RO id policy\"
     'has ID policy for': \"RO\"""";
            iao:0000115 """Relates an ontology used to record id policy to the number of digits in the URI. The URI is: the 'has ID prefix\" annotation property value concatenated with an integer in the id range (left padded with \"0\"s to make this many digits)""";
            iao:0000117 "Person:Alan Ruttenberg";
            a owl:AnnotationProperty;
            rdfs:label "has ID digit count"@en.
iao:0000597 iao:0000112 """Datatype: idrange:1
Annotations: 'has ID range allocated to': \"Chris Mungall\"
EquivalentTo: xsd:integer[> 2151 , <= 2300]
""";
            iao:0000115 "Relates a datatype that encodes a range of integers to the name of the person or organization who can use those ids constructed in that range to define new terms";
            iao:0000117 "Person:Alan Ruttenberg";
            a owl:AnnotationProperty;
            rdfs:label "has ID range allocated to"@en.
iao:0000598 iao:0000112 """Ontology: <http://purl.obolibrary.org/obo/ro/idrange/>
  Annotations: 
     'has ID prefix': \"http://purl.obolibrary.org/obo/RO_\"
     'has ID digit count' : 7,
     rdfs:label \"RO id policy\"
     'has ID policy for': \"RO\"""";
            iao:0000115 "Relating an ontology used to record id policy to the ontology namespace whose policy it manages";
            iao:0000117 "Person:Alan Ruttenberg";
            a owl:AnnotationProperty;
            rdfs:label "has ID policy for".
iao:0000599 iao:0000112 """Ontology: <http://purl.obolibrary.org/obo/ro/idrange/>
  Annotations: 
     'has ID prefix': \"http://purl.obolibrary.org/obo/RO_\"
     'has ID digit count' : 7,
     rdfs:label \"RO id policy\"
     'has ID policy for': \"RO\"""";
            iao:0000115 """Relates an ontology used to record id policy to a prefix concatenated with an integer in the id range (left padded with \"0\"s to make this many digits) to construct an ID for a term being created.""";
            iao:0000117 "Person:Alan Ruttenberg";
            a owl:AnnotationProperty;
            rdfs:label "has ID prefix"@en.
iao:0000600 iao:0000111 "elucidation"@en;
            iao:0000117 "person:Alan Ruttenberg"@en;
            iao:0000119 "Person:Barry Smith"@en;
            iao:0000600 "Primitive terms in a highest-level ontology such as BFO are terms which are so basic to our understanding of reality that there is no way of defining them in a non-circular fashion. For these, therefore, we can provide only elucidations, supplemented by examples and by axioms"@en;
            a owl:AnnotationProperty;
            rdfs:isDefinedBy pobo:iao.owl;
            rdfs:label "elucidation"@en.
iao:0000601 iao:0000111 "has associated axiom(nl)"@en;
            iao:0000117 "Person:Alan Ruttenberg"@en;
            iao:0000119 "Person:Alan Ruttenberg"@en;
            iao:0000600 "An axiom associated with a term expressed using natural language"@en;
            a owl:AnnotationProperty;
            rdfs:isDefinedBy pobo:iao.owl;
            rdfs:label "has associated axiom(nl)"@en.
iao:0000602 iao:0000111 "has associated axiom(fol)"@en;
            iao:0000117 "Person:Alan Ruttenberg"@en;
            iao:0000119 "Person:Alan Ruttenberg"@en;
            iao:0000600 "An axiom expressed in first order logic using CLIF syntax"@en;
            a owl:AnnotationProperty;
            rdfs:isDefinedBy pobo:iao.owl;
            rdfs:label "has associated axiom(fol)"@en.
iao:0000603 iao:0000111 "is allocated id range"@en;
            iao:0000115 """Relates an ontology IRI to an (inclusive) range of IRIs in an OBO name space. The range is give as, e.g. \"IAO_0020000-IAO_0020999\""""@en,
                        "Add as annotation triples in the granting ontology"@en;
            iao:0000117 "PERSON:Alan Ruttenberg"@en;
            a owl:AnnotationProperty;
            rdfs:label "is allocated id range"@en.
iao:0000604 iao:0000111 "retired from use as of"@en;
            iao:0000115 "relates a class of CRID to the date after which further instances should not be made, according to the central authority";
            iao:0000116 "In OWL 2 add AnnotationPropertyRange xsd:dateTimeStamp";
            iao:0000117 "Alan Ruttenberg";
            a owl:AnnotationProperty;
            rdfs:label "retired from use as of".
iao:0000605 iao:0000111 "abbreviation textual entity"@en;
            iao:0000112 """From Shiba et al. Acta Neuropathol Commun. 2013; 1: 45. (http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3893467/):

BAC: Bacterial artificial chromosome; CR: Calretinin; GFAP: Glial fibrillary acidic protein; MAP: Microtubule-associated protein; MRI: Magnetic resonance imaging; NSC: Neural stem cell; PDA: Patent ductus arteriosus; PMG: Polymicrogyria; PNH: Periventricular nodular heterotopia; VSD: Ventricular septal defect."""@en;
