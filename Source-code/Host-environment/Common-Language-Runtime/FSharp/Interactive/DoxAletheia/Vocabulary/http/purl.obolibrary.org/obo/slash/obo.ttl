                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom iao:0000579 ; 
                             owl:onProperty pobo:RO_0000057 ; 
                             a owl:Restriction].
iao:0000581 iao:0000114 iao:0000123;
            iao:0000115 "relates a time stamped measurement datum to the time measurement datum that denotes the time when the measurement was taken"@en;
            iao:0000117 "Alan Ruttenberg"@en;
            a owl:FunctionalProperty,
              owl:ObjectProperty;
