obi:0400117 iao:0000111 "vacuum dryer"@en;
            iao:0000112 "Model 777 Microarray Oven"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "An instrument which removes liquid by the application of negative pressure,  i.e. vacuum."@en;
