                             a owl:Class],
                            obi:0000734.
obi:0000698 iao:0000111 "DNA ligase";
            iao:0000114 iao:0000123;
            iao:0000115 "A DNA ligase is an enzyme that covalently joins two compatible pieces of DNA through the cleavage of an ATP molecule";
            iao:0000116 "5/22 Need to explore if there are GO / other classes exist that capture this. We need it now for cloning experiments",
                        "replaced by imported PRO: DNA ligase";
            iao:0000117 "Kevin Clancy, Bjoern Peters";
            iao:0000118 "ligase";
