                                                 a owl:Restriction]) ; 
                             a owl:Class],
                            obi:0302887.
obi:0002125 iao:0000111 "H&E-stained fixed tissue slide specimen"@en;
            iao:0000114 iao:0000125;
            iao:0000115 "A fixed tissue slide specimen that is the output of H&E slide staining."@en;
            iao:0000117 "Chris Stoeckert, Ned Haubein"@en;
            iao:0000119 "OBIB, OBI"@en;
            a owl:Class;
            rdfs:label "H&E-stained fixed tissue slide specimen"@en;
            rdfs:subClassOf [owl:intersectionOf (omiabis:0000052
