obi:0000915 iao:0000111 "freezing storage";
            iao:0000112 "a fozen pellet used for later assay";
            iao:0000114 iao:0000120;
            iao:0000115 "A storage process in temperature that maintenance the frozen status of the stored entities.";
            iao:0000116 """2010/3/3 Alan Ruttenberg: There is a question of whether we should have a separate objective to \"prepare for maintenance\"
2014/2/3 OBI dev call: \"prepare for maintenance\" is a separate process. For example, 'freezing' and 'flash freezing' are defined and can be used to produce frozen material for storage.
Updated both textual and logical definition. Both input and output material of freezing storage have quality frozen.""";
            iao:0000117 "Person: Alan Ruttenberg, Mathias Brochhausen";
            iao:0000119 "MO_481 frozen_storage"@en,
                        "OBI";
            a owl:Class;
            rdfs:label "freezing storage";
