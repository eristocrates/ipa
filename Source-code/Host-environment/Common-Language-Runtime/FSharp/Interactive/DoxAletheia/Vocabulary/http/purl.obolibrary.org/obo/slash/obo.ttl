                                                 [owl:someValuesFrom chebi:29237 ; 
                                                 owl:onProperty obi:0000293 ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class].
obi:0001977 iao:0000111 "cytometry assay";
            iao:0000112 "An intracellular material detection by flow cytometry assay measuring peforin inside a culture of T cells.";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that measures properties of cells.";
            iao:0000117 "IEDB";
            iao:0000119 "IEDB";
