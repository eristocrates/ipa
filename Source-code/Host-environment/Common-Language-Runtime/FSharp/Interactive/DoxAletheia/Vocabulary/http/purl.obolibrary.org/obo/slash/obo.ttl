            iao:0000234 "NCI BBRB";
            a owl:Class;
            rdfs:label "BMI range inclusion criterion";
            rdfs:subClassOf obi:0500027.
obi:0002429 iao:0000111 "blood transfusion exclusion criterion";
            iao:0000112 "An exclusion criterion that is defined by whether the specimen donor received a whole blood transfusion within 48 hours prior to death.";
            iao:0000114 iao:0000120;
            iao:0000115 "An exclusion criterion that is defined by whether the specimen donor received a whole blood transfusion within a specified time frame prior to death, which if met, makes a specimen donor unsuitable for a given task or participation in a given process.";
            iao:0000117 "Chris Stoeckert, Helena Ellis";
            iao:0000119 "NCI BBRB, OBIB";
            iao:0000234 "NCI BBRB";
            a owl:Class;
            rdfs:label "blood transfusion exclusion criterion";
            rdfs:subClassOf obi:0500028.
obi:0002430 iao:0000111 "history of metastatic cancer exclusion criterion";
            iao:0000114 iao:0000120;
            iao:0000115 "An exclusion criterion defined as whether an individual has ever been diagnosed with metastatic cancer (cancer that spread beyond the initial site such as to other organs like brain bone or liver), which if met, makes the individual unsuitable for a given task or participation in a given process.";
            iao:0000117 "Chris Stoeckert, Helena Ellis";
            iao:0000119 "NCI BBRB, OBIB";
            iao:0000234 "NCI BBRB";
            a owl:Class;
            rdfs:label "history of metastatic cancer exclusion criterion";
            rdfs:subClassOf obi:0500028.
obi:0002431 iao:0000111 "intravenous drug use exclusion criterion";
            iao:0000112 "Donor eligibility based on history of intravenous drug abuse in the last 5 years.";
            iao:0000114 iao:0000120;
            iao:0000115 "An exclusion criterion defined as when an individual has a history of intravenous drug abuse for a specific timeframe, which if met, makes the individual unsuitable for a given task or participation in a given process.";
            iao:0000117 "Chris Stoeckert, Helena Ellis";
            iao:0000119 "NCI BBRB, OBIB";
            iao:0000234 "NCI BBRB";
            a owl:Class;
            rdfs:label "intravenous drug use exclusion criterion";
            rdfs:subClassOf obi:0500028.
obi:0002432 iao:0000111 "history of sex with someone with a history of blood borne infection  exclusion criterion";
            iao:0000112 "Donor eligibility based on whether the donor has a history of sex with someone who has been diagnosed or at risk for HIV/AIDS and/or HCV and/or HBV in the last 5 years.";
            iao:0000114 iao:0000120;
            iao:0000115 "An exclusion criterion defined  as whether an individual has a history of sex with someone who has been diagnosed or at risk for a blood borne infections disease in a specified time frame, which if met, makes the individual unsuitable for a given task or participation in a given process.";
            iao:0000117 "Chris Stoeckert, Helena Ellis";
            iao:0000119 "NCI BBRB, OBIB";
            iao:0000234 "NCI BBRB";
            a owl:Class;
            rdfs:label "history of sex with someone with a history of blood borne infection  exclusion criterion";
            rdfs:subClassOf obi:0500028.
obi:0002433 iao:0000111 "history of sex with someone with a history of intravenous drugs exclusion criterion";
            iao:0000112 "Donor eligibility based on whether the donor has a history of sex with someone who has used intravenous drugs in the last 5 years.";
            iao:0000114 iao:0000120;
            iao:0000115 "An exclusion criterion defined  as whether an individual has a history of sex with someone who has used intravenous drugs in a specified time frame, which if met, makes the individual unsuitable for a given task or participation in a given process.";
            iao:0000117 "Chris Stoeckert, Helena Ellis";
            iao:0000119 "NCI BBRB, OBIB";
            iao:0000234 "NCI BBRB";
            a owl:Class;
            rdfs:label "history of sex with someone with a history of intravenous drugs exclusion criterion";
            rdfs:subClassOf obi:0500028.
obi:0002434 iao:0000111 "HIV exclusion criterion";
            iao:0000114 iao:0000120;
            iao:0000115 "An exclusion criterion defined  as whether an individual has a history of repeatedly reactive screening assays for HIV-1 or HIV-2 antibody regardless of the results of supplemental assays, which if met, makes the individual unsuitable for a given task or participation in a given process. ";
            iao:0000117 "Chris Stoeckert, Helena Ellis";
            iao:0000119 "NCI BBRB, OBIB";
            iao:0000234 "NCI BBRB";
            a owl:Class;
            rdfs:label "HIV exclusion criterion";
            rdfs:subClassOf obi:0500028.
obi:0002435 iao:0000111 "exposure to blood borne infectious disease exclusion criterion";
            iao:0000112 "Donor eligibility based on whether the donor has been exposed to HIV/AIDS. ";
            iao:0000114 iao:0000120;
            iao:0000115 "An exclusion criterion defined  as whether an individual has been exposed to a blood borne infections disease through needle sticks and/or contact with non-intact skin and/or contact with open wounds and/or contact with mucous membranes, which if met, makes the individual unsuitable for a given task or participation in a given process.";
            iao:0000117 "Chris Stoeckert, Helena Ellis";
            iao:0000119 "NCI BBRB, OBIB";
            iao:0000234 "NCI BBRB";
            a owl:Class;
            rdfs:label "exposure to blood borne infectious disease exclusion criterion";
            rdfs:subClassOf obi:0500028.
obi:0002436 iao:0000111 "RNA interactome capture";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that identifies RNA binding proteins by cross-linking RNA and proteins with UV light, then purifying the bound complexes by oligo(dT) capture. Finally, the complexes are analyzed by mass spectrometry.";
            iao:0000117 "Rebecca Tauber";
            iao:0000119 "PMID:26463381";
            a owl:Class;
            rdfs:label "RNA interactome capture";
            rdfs:subClassOf [owl:someValuesFrom obi:0000470 ; 
                             owl:onProperty pobo:BFO_0000051 ; 
                             a owl:Restriction],
                            obi:0000070.
obi:0002437 iao:0000111 "widefield microscopy";
            iao:0000114 iao:0000120;
            iao:0000115 "A fluorescence microscopy technique where the specimen under investigation is fully bathed in light, as opposed to confocal microscopy in which only a small portion of the specimen is illuminated.";
            iao:0000117 "Jie Zheng";
            iao:0000118 "WFM";
            iao:0000119 "url:http://bitesizebio.com/19409/the-many-flavors-of-widefield-microscopy/",
                        "url:https://svi.nl/WideFieldMicroscope";
            a owl:Class;
            rdfs:label "widefield microscopy";
            rdfs:subClassOf chmo:0000087.
obi:0002438 iao:0000111 "nuclear ligation assay";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that detects the proximity of chromosomal DNA through the use of a ligation reaction in isolated nuclei.";
            iao:0000117 "Chris S";
            iao:0000119 "PMID:8327891";
            a owl:Class;
            rdfs:label "nuclear ligation assay";
            rdfs:subClassOf [owl:someValuesFrom obi:0001398 ; 
                             owl:onProperty obi:0000417 ; 
                             a owl:Restriction],
                            obi:0000070,
                            [owl:someValuesFrom pobo:PR_000023089 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction].
obi:0002439 iao:0000111 "chromosome conformation capture assay";
            iao:0000114 iao:0000120;
            iao:0000115 "A nuclear ligation assay that detects chromosomal interactions between any two genomic loci. Chromatin segments are cross-linked, cut by restriction enzymes, ligated, and finally analyzed by PCR.";
            iao:0000117 "Chris S";
            iao:0000118 "3C assay";
            iao:0000119 "url:http://www.nature.com/nprot/journal/v2/n7/full/nprot.2007.243.html",
                        "PMID:11847345";
            a owl:Class;
            rdfs:label "chromosome conformation capture assay";
            rdfs:subClassOf obi:0002438,
                            [owl:someValuesFrom obi:0001917 ; 
                             owl:onProperty obi:0000417 ; 
                             a owl:Restriction].
obi:0002440 iao:0000111 "Hi-C assay";
            iao:0000114 iao:0000120;
            iao:0000115 "A chromosome conformation capture assay that detects genome-wide chromosomal interactions. High-throughput techniques are used to sequence the ligated fragments after cross-linking and cutting with restriction enzymes.";
            iao:0000117 "Chris S";
            iao:0000119 "PMID:20461051";
            a owl:Class;
            rdfs:label "Hi-C assay";
            rdfs:subClassOf obi:0002439.
obi:0002441 iao:0000111 "physical examination of individual";
            iao:0000114 iao:0000123;
            iao:0000115 "An assay that produces a description of the qualities of an entity that has not been transformed, through observation and physical, non-invasive techniques.";
            a owl:Class;
            rdfs:label "physical examination of individual";
            rdfs:subClassOf obi:0000070.
obi:0002442 iao:0000111 "hydroxyl-radical footprinting assay";
            iao:0000114 iao:0000120;
            iao:0000115 "A footprinting assay that uses the reaction of hydroxyl radicals with side-chain sites in molecules (proteins, DNA, etc)_ with the resultant mass shift demonstrating the site of modification, used to_ to asses the accessibility of that site.";
            iao:0000117 "Jie Zheng";
            iao:0000119 "PMID:21770468";
            a owl:Class;
            rdfs:label "hydroxyl-radical footprinting assay";
            rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (obi:0000067
                                                                                         [owl:someValuesFrom chebi:23367 ; 
