            rdfs:domain obi:0200140;
            rdfs:label "has_feature_value"@en.
obi:0000293 iao:0000111 "has_specified_input",
                        "has_specified_input"@en;
            iao:0000112 "see is_input_of example_of_usage"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "A relation between a planned process and a continuant participating in that process that is not created during  the process. The presence of the continuant during the process is explicitly specified in the plan specification which the process realizes the concretization of."@en;
            iao:0000116 "8/17/09: specified inputs of one process are not necessarily specified inputs of a larger process that it is part of. This is in contrast to how 'has participant' works.";
            iao:0000117 "PERSON: Larry Hunter",
                        "PERSON: Bjoern Peters",
                        "PERSON: Alan Ruttenberg"@en,
                        "PERSON: Melanie Coutot";
            iao:0000412 pobo:obi.owl;
            a owl:ObjectProperty;
            rdfs:domain obi:0000011;
            rdfs:label "has_specified_input"@en;
            rdfs:subPropertyOf pobo:RO_0000057;
            owl:equivalentProperty [owl:inverseOf obi:0000295];
            owl:inverseOf obi:0000295.
obi:0000294 iao:0000111 "is_concretization_of";
            iao:0000114 iao:0000123;
            iao:0000115 "Is a relationship between a generically dependent continuant and a specifically dependent continuant. A generically dependent continuant may inhere in more than one entity. It does so by virtue of the fact that there is, for each entity that it inheres, a specifically dependent *concretization* of the generically dependent continuant that is specifically dependent. For instance, consider a story, which is an information artifact that inheres in some number of books. Each book bears some quality that carries the story. The relation between this quality and the generically dependent continuant is that the former is the concretization of the latter.";
            iao:0000116 "replaced by: http://purl.obolibrary.org/obo/BFO_0000058";
            iao:0000117 "PERSON: Alan Ruttenburg",
                        "PERSON: Barry Smith";
            iao:0000231 iao:0000228;
            a owl:ObjectProperty;
            rdfs:label "obsolete_is_concretization_of"@en;
            rdfs:subPropertyOf oboinowl:ObsoleteProperty;
            owl:deprecated true.
obi:0000295 iao:0000111 "is_specified_input_of";
            iao:0000112 "some Autologous EBV(Epstein-Barr virus)-transformed B-LCL (B lymphocyte cell line) is_input_for instance of Chromum Release Assay described at https://wiki.cbil.upenn.edu/obiwiki/index.php/Chromium_Release_assay"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "A relation between a planned process and a continuant participating in that process that is not created during  the process. The presence of the continuant during the process is explicitly specified in the plan specification which the process realizes the concretization of."@en;
            iao:0000117 "PERSON:Bjoern Peters",
                        "Alan Ruttenberg"@en;
            a owl:ObjectProperty;
            rdfs:label "is_specified_input_of"@en;
            rdfs:range obi:0000011;
            rdfs:subPropertyOf pobo:RO_0000056;
            owl:equivalentProperty [owl:inverseOf obi:0000293].
obi:0000296 iao:0000111 "enrollment"@en;
            iao:0000112 """Enrollment of patients in a study.
Short-term outcome of neuropsychiatric events in systemic lupus erythematosus upon enrollment into an international inception cohort study. Arthritis Rheum. 2008 May 15;59(5):721-9. PMID: 18438902"""@en;
            iao:0000114 iao:0000125;
            iao:0000115 "enrollment is a process of identifying a set of objects for further use in an investigation based on a set of criteria or rules"@en;
            iao:0000116 "merged with 'enrollment of human subjects";
            iao:0000117 "Bjoern Peters"@en;
            iao:0000119 "IEDB"@en;
            iao:0000231 iao:0000227;
            a owl:Class;
            rdfs:label "obsolete_enrollment"@en;
            rdfs:subClassOf oboinowl:ObsoleteClass;
            owl:deprecated true.
obi:0000297 iao:0000111 "is_concretized_as";
            iao:0000114 iao:0000123;
            iao:0000115 "Is a relationship between a specifically dependent continuant and a generically dependent continuant. A generically dependent continuant may inhere in more than one entity. It does so by virtue of the fact that there is, for each entity that it inheres, a specifically dependent *concretization* of the generically dependent continuant that is specifically dependent. For instance, consider a story, which is an information artifact that inheres in some number of books. Each book bears some quality that carries the story. The relation between this quality and the generically dependent continuant is that the former is the concretization of the latter.";
            iao:0000116 "replaced by: http://purl.obolibrary.org/obo/BFO_0000059";
            iao:0000117 "PERSON: Barry Smith",
                        "PERSON: Alan Ruttenberg";
            iao:0000231 iao:0000228;
            a owl:ObjectProperty;
            rdfs:label "obsolete_is_concretized_as"@en;
            rdfs:subPropertyOf oboinowl:ObsoleteProperty;
            owl:deprecated true.
obi:0000298 iao:0000111 "has_quality";
            iao:0000114 iao:0000122;
            iao:0000115 """A relation between an entity and a quality. For types: E has_quality Q iff: 
for any eEt, exists qQt such that q inheres_in e at t. 
For instances: e has_quality q at t iff q inheres_in e at t and q instance-of Quality [GOC:cjm]""";
            iao:0000116 "replaced by: http://purl.obolibrary.org/obo/BFO_0000086";
            iao:0000117 "PERSON: Chris Mungall",
                        "GROUP:OBI:<http://obi.sourceforge.net>";
            iao:0000231 iao:0000228;
            a owl:ObjectProperty;
            rdfs:label "obsolete_has_quality"@en;
            rdfs:subPropertyOf oboinowl:ObsoleteProperty;
            owl:deprecated true.
