chebi:16670 iao:0000111 "peptide";
            iao:0000115 "Amide derived from two or more amino carboxylic acid molecules (the same or different) by formation of a covalent bond from the carbonyl carbon of one to the nitrogen atom of another with formal loss of water. The term is usually applied to structures formed from alpha-amino acids, but it includes those derived from any amino carboxylic acid. X = OH, OR, NH2, NHR, etc.";
            iao:0000412 pobo:chebi.owl;
            a owl:Class;
            rdfs:label "peptide";
            rdfs:subClassOf chebi:33839.
