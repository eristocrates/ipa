                                                     [owl:someValuesFrom [owl:someValuesFrom iao:0000030 ; 
                                                                         owl:onProperty pobo:RO_0000059 ; 
                                                                         a owl:Restriction] ; 
                                                     owl:onProperty pobo:RO_0000053 ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class].
iao:0000179 iao:0000111 "histogram"@en;
            iao:0000114 iao:0000122;
            iao:0000115 """A histogram is a report graph which is a statistical description of a
distribution in terms of occurrence frequencies of different event classes."""@en;
            iao:0000117 "PERSON:Chris Stoeckert"@en,
                        "PERSON:James Malone"@en,
                        "PERSON:Melanie Courtot"@en;
            iao:0000119 "GROUP:OBI"@en;
            a owl:Class;
            rdfs:label "histogram"@en;
            rdfs:subClassOf iao:0000038.
iao:0000180 iao:0000111 "heatmap"@en;
            iao:0000114 iao:0000122;
            iao:0000115 """A heatmap is a report graph which is a graphical representation of data
where the values taken by a variable(s) are shown as colors in a
two-dimensional map."""@en;
            iao:0000117 "PERSON:Melanie Courtot"@en,
                        "PERSON:Chris Stoeckert"@en,
                        "PERSON:James Malone"@en;
            iao:0000119 "GROUP:OBI"@en;
            a owl:Class;
            rdfs:label "heatmap"@en;
            rdfs:subClassOf iao:0000038.
iao:0000181 iao:0000111 "Venn diagram"@en;
            iao:0000114 iao:0000122;
            iao:0000115 """A Venn diagram is a report graph showing all hypothetically possible
logical relations between a finite collection of sets."""@en;
            iao:0000117 "PERSON:Chris Stoeckert"@en,
                        "PERSON:Melanie Courtot"@en,
                        "PERSON:James Malone"@en;
            iao:0000119 "WEB: http://en.wikipedia.org/wiki/Venn_diagram"@en;
            a owl:Class;
            rdfs:label "Venn diagram"@en;
            rdfs:subClassOf iao:0000038.
iao:0000182 iao:0000111 "obsolete_survival curve"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "A survival curve is a report graph which is a graphical representation of data where the percentage of survival is plotted as a function of time."@en;
            iao:0000117 "PERSON:James Malone"@en,
                        "PERSON:Melanie Courtot"@en,
                        "PERSON:Chris Stoeckert"@en;
            iao:0000119 "WEB: http://www.graphpad.com/www/book/survive.htm"@en;
            iao:0000231 iao:0000103;
            a owl:Class;
            rdfs:label "obsolete_survival curve"@en;
            rdfs:subClassOf oboinowl:ObsoleteClass;
            owl:deprecated true.
iao:0000183 iao:0000111 "dendrogram"@en;
            iao:0000112 """Dendrograms are often used in computational biology to
illustrate the clustering of genes."""@en;
            iao:0000114 iao:0000122;
            iao:0000115 """A dendrogram is a report graph which is a tree diagram
frequently used to illustrate the arrangement of the clusters produced by a
clustering algorithm."""@en;
            iao:0000117 "PERSON:Melanie Courtot"@en,
                        "PERSON:James Malone"@en,
                        "PERSON:Chris Stoeckert"@en;
