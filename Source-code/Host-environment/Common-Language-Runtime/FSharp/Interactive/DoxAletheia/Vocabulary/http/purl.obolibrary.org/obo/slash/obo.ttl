                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (obi:0000067
                                                                                         [owl:someValuesFrom obi:0000880 ; 
                                                                                         owl:onProperty pobo:RO_0000081 ; 
                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty pobo:BFO_0000055 ; 
                                                 a owl:Restriction]
                                                 [owl:someValuesFrom [owl:intersectionOf (obi:0000880
                                                                                         [owl:someValuesFrom obi:0000067 ; 
                                                                                         owl:onProperty pobo:RO_0000087 ; 
                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty obi:0000293 ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class],
                            [owl:someValuesFrom [owl:someValuesFrom go:0010467 ; 
