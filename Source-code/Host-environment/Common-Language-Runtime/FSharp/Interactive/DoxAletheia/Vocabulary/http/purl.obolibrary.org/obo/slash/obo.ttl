chebi:59054 iao:0000111 "N-methylisatoic anhydride";
            iao:0000115 "A 3,1-benzoxazin-1,4-dione having an N-methyl substituent.";
            iao:0000412 pobo:chebi.owl;
            a owl:Class;
            rdfs:label "N-methylisatoic anhydride";
            rdfs:subClassOf chebi:23367.
chebi:59055 iao:0000111 "(S)-1-(4-bromoacetamidobenzyl)EDTA";
            iao:0000115 "A tetracarboxylic acid consisting of ethylenediaminetetraacetic acid having a 4-bromoacetamidobenzyl group at the C1-position and (S)-configuration.";
            iao:0000412 pobo:chebi.owl;
            a owl:Class;
            rdfs:label "(S)-1-(4-bromoacetamidobenzyl)EDTA";
            rdfs:subClassOf chebi:23367.
chebi:59056 iao:0000111 "EDTA methidiumpropylamide";
            iao:0000115 "A combined intercalating and chelating reagent. The iron chelate, prepared by adding Fe(NH4)2(SO4)2, effects random oxidative cleavage of DNA in the presence of O2 and a reducing agent. This activity is useful as a footprinting probe.";
            iao:0000412 pobo:chebi.owl;
            a owl:Class;
            rdfs:label "EDTA methidiumpropylamide";
            rdfs:subClassOf chebi:23367.
chebi:59424 iao:0000111 "bromophenol blue";
            iao:0000115 "3H-2,1-Benzoxathiole 1,1-dioxide in which both of the hydrogens at position 3 have been substituted by 3,5-dibromo-4-hydroxyphenyl groups. It is used as a laboratory indicator, changing from yellow below pH 3 to purple at pH 4.6, and as a size marker for monitoring the progress of agarose gel and polyacrylamide gel electrophoresis. It has also been used as an industrial dye.";
            iao:0000412 pobo:chebi.owl;
            a owl:Class;
            rdfs:label "bromophenol blue";
            rdfs:subClassOf chebi:23367.
chebi:61073 iao:0000111 "oxygen radical";
            iao:0000115 "An inorganic radical in which a free electron resides on one or more oxygen atoms of an oxygen species.";
            iao:0000412 pobo:chebi.owl;
            a owl:Class;
            rdfs:label "oxygen radical";
            rdfs:subClassOf chebi:23367.
chebi:9754 iao:0000111 "tris";
           iao:0000115 "A primary amino compound that is tert-butylamine in which one hydrogen attached to each methyl group is replaced by a hydroxy group. A compound widely used as a biological buffer substance in the pH range 7--9; pKa = 8.3 at 20 degreeC; pKa = 7.82 at 37 degreeC.";
           iao:0000412 pobo:chebi.owl;
           a owl:Class;
           rdfs:label "tris";
           rdfs:subClassOf chebi:23367.
chmo:0000087 iao:0000115 "Any type of microscopy where the specimen can be made to fluoresce (emit energy as visible light) by illuminating it with light of specific wavelengths. These specimens are called fluorophores.";
             iao:0000118 "fluorescence microscopic imaging",
                         "fluorescence imaging",
                         "FM";
             iao:0000119 "CHMO";
             a owl:Class;
             rdfs:label "fluorescence microscopy";
             rdfs:subClassOf obi:0002119.
chmo:0000089 iao:0000115 "Microscopy where the specimen can be made to fluoresce (emit energy as visible light) by scanning a gas (Ar or Kr) laser spot of specific wavelength over its surface and using a spatial pinhole to eliminate out-of-focus fluorescence.";
             iao:0000118 "confocal fluorescence imaging",
                         "scanning confocal fluorescence microscopy",
                         "confocal laser scanning microscopy",
                         "CLSM",
                         "confocal-laser scanning microscopy",
                         "confocal laser scanning fluorescence microscopy",
                         "fluorescence confocal scanning laser microscopy",
                         "LSCM",
                         "fluorescence confocal microscopy";
             iao:0000119 "CHMO";
             a owl:Class;
             rdfs:label "confocal fluorescence microscopy";
             rdfs:subClassOf obi:0002119.
chmo:0000102 iao:0000115 "Microscopy where the specimen is illuminated with visible light and a system of lenses is used to produce an image.";
             iao:0000118 "optical microscopy",
                         "light microscopy",
                         "OM";
             iao:0000119 "CHMO";
             a owl:Class;
             rdfs:label "light microscopy";
             rdfs:subClassOf obi:0002119.
chmo:0000701 iao:0000115 "A method where a sample mixture is first separated by liquid chromatography before being ionised and characterised by mass-to-charge ratio and relative abundance using two mass spectrometers in series.";
             iao:0000118 "LC-MS2",
                         "liquid chromatography-tandem mass spectroscopy",
                         "LCMSMS",
                         "LC-MSMS",
                         "LC-MS/MS",
                         "liquid chromatography tandem mass spectrometry",
                         "LC-MS-MS",
                         "liquid chromatography tandem mass spectroscopy",
                         "LC/MS/MS";
             iao:0000119 "CHMO";
             a owl:Class;
             rdfs:label "liquid chromatography-tandem mass spectrometry";
             rdfs:subClassOf obi:0200198.
pobo:CLO_0000001 iao:0000111 "cell line cell";
                 iao:0000115 """A cultured cell that is part of a cell line - a stable and homogeneous population of cells with a common biological origin and propagation history in culture
""",
                             "A cultured cell that is part of a cell line - a stable and homogeneous population of cells with a common biological origin and propagation history in culture"@en;
                 iao:0000412 pobo:clo.owl;
                 a owl:Class;
                 rdfs:label "cell line cell";
                 rdfs:subClassOf [owl:someValuesFrom pobo:CL_0000001 ; 
                                  owl:onProperty pobo:RO_0001000 ; 
                                  a owl:Restriction],
                                 [owl:unionOf ([owl:someValuesFrom obi:0001867 ; 
                                               owl:onProperty obi:0000312 ; 
                                               a owl:Restriction]
                                               [owl:someValuesFrom [owl:someValuesFrom obi:0001867 ; 
                                                                   owl:onProperty obi:0000312 ; 
                                                                   a owl:Restriction] ; 
                                               owl:onProperty pobo:RO_0001000 ; 
                                               a owl:Restriction]) ; 
                                  a owl:Class],
                                 obi:0001866.
pobo:CLO_0000018 iao:0000111 "mortal cell line cell";
                 iao:0000115 "A cell line cell that is capable of replicating a limited number of times in culture before undergoing senescence.";
                 iao:0000412 pobo:clo.owl;
                 a owl:Class;
                 rdfs:label "mortal cell line cell";
                 rdfs:subClassOf pobo:CLO_0000001.
pobo:CLO_0000019 iao:0000111 "immortal cell line cell";
                 iao:0000115 "A cell line cell that is expected to be capable of an unlimited number of divisions, and is thus able to support indefinite propagation in vitro as part of an immortal cell line.";
                 iao:0000412 pobo:clo.owl;
                 a owl:Class;
                 rdfs:label "immortal cell line cell";
                 rdfs:subClassOf pobo:CLO_0000001.
pobo:CLO_0000031 iao:0000111 "cell line"@en;
                 iao:0000115 """A cultured cell population that represents a genetically stable and homogenous population of cultured cells that shares a common propagation history (i.e. has been successively passaged together in culture).  
""",
                             "A cultured cell population that represents a genetically stable and homogenous population of cultured cells that shares a common propagation history (i.e. has been successively passaged together in culture). "@en;
                 iao:0000412 pobo:clo.owl;
                 a owl:Class;
                 rdfs:label "cell line"@en;
                 rdfs:subClassOf [owl:allValuesFrom pobo:CLO_0000001 ; 
                                  owl:onProperty obi:0000643 ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom pobo:CLO_0000001 ; 
                                  owl:onProperty obi:0000643 ; 
                                  a owl:Restriction],
                                 obi:0001905.
pobo:CLO_0009828 iao:0000111 "immortal cell line"@en;
                 iao:0000115 "A cell line that is expected to be capable of indefinite propagation in an vitro culture.";
                 iao:0000412 pobo:clo.owl;
                 a owl:Class;
                 rdfs:label "immortal cell line"@en;
                 rdfs:subClassOf [owl:allValuesFrom pobo:CLO_0000019 ; 
                                  owl:onProperty obi:0000643 ; 
