            rdfs:subClassOf obi:0002590.
obi:0002592 iao:0000111 "genetic interaction identification design";
            iao:0000114 iao:0000120;
            iao:0000115 "A molecular interaction identification design that investigates a phenotype that is the result of two or more genetic perturbations, and is not explained by the individual genetic perturbations alone.";
