obi:0600023 iao:0000111 "non specific enzymatic cleavage"@en;
            iao:0000112 "The use of agarase to digest an agar gel"@en;
            iao:0000114 iao:0000125;
            iao:0000115 "a protocol application to digest the fraction of input material that is susceptible to that enzyme"@en;
            iao:0000117 "PERSON:Kevin Clancy"@en;
            iao:0000119 "OBI branch derived"@en;
            a owl:Class;
            rdfs:label "non specific enzymatic cleavage"@en;
