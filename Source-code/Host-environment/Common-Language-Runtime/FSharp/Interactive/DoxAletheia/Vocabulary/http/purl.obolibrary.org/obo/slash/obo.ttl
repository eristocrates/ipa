obi:0001979 iao:0000111 "fluorescence quenching binding assay";
            iao:0000114 iao:0000120;
            iao:0000115 "A binding assay in which the proximity of two entities is monitored by measuring a fluorescent signal of one of the entities that gets reduced if the two entities are cliose to each other.";
            iao:0000117 "IEDB";
            iao:0000119 "IEDB";
            a owl:Class;
            rdfs:label "fluorescence quenching binding assay";
