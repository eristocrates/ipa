obi:0600026 iao:0000111 "longitudinal mass measurement assay";
            iao:0000112 "The comparison of the weight of vaccinated and non-vaccinated mice after infection with influenza A over 6 weeks post-infection";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that measures the mass of a material at two or more time points";
            iao:0000117 "Helen Parkinson";
            iao:0000119 "OBI branch derived";
            a owl:Class;
