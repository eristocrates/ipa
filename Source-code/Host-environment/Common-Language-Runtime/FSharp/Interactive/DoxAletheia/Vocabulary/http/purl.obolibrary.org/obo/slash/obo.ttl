obi:0001154 iao:0000111 "induced mutation"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "a genetic transformation that the modification of the genetic material (either coding or non-coding) of an organism is caused by mutagenic compounds or irradiation."@en;
            iao:0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en;
