                 rdfs:subPropertyOf rdfs:label.
pobo:BFO_0000182 pobo:BFO_0000179 "history";
                 pobo:BFO_0000180 "History";
                 iao:0000600 "A history is a process that is the sum of the totality of processes taking place in the spatiotemporal region occupied by a material entity or site, including processes on the surface of the entity or within the cavities to which it serves as host. (axiom label in BFO2 Reference: [138-001])"@en;
                 a owl:Class;
                 rdfs:isDefinedBy pobo:bfo.owl;
                 rdfs:label "history"@en;
                 rdfs:subClassOf pobo:BFO_0000015.
