obi:0000736 iao:0000111 "single fragment library";
            iao:0000114 iao:0000123;
            iao:0000115 "is a collection of short tags from DNA fragments, are extracted and covalently linked as single tag constructs";
            iao:0000117 "Philippe Rocca-Serra";
            iao:0000118 "fragment library";
