obi:0302884 iao:0000111 "extraction";
            iao:0000112 "nucleic acid extraction using phenol chloroform";
            iao:0000114 iao:0000123;
            iao:0000115 "A material separation in which a desired component of an input material is separated from the remainder";
            iao:0000116 """Current the output of material processing defined as the molecular entity, main component in the output material entity, rather than the material entity that have grain molecular entity. 
'nucleic acid extract' is the output of 'nucleic acid extraction' and has grain 'nucleic acid'. However, the output of 'nucleic acid extraction' is 'nucleic acid' rather than 'nucleic acid extract'. We are aware of this issue and will work it out in the future."""@en;
            iao:0000117 "Philippe Rocca-Serra",
                        "Person:Bjoern Peters";
            a owl:Class;
            rdfs:label "extraction"@en;
            rdfs:subClassOf [owl:someValuesFrom obi:0000681 ; 
                             owl:onProperty obi:0000417 ; 
                             a owl:Restriction],
                            obi:0600014.
