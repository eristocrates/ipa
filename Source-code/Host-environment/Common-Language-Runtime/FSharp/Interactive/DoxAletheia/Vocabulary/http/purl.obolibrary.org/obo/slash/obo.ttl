            iao:0000232 "check on definition !"@en;
            a owl:Class;
            rdfs:label "column cartridger"@en;
            rdfs:subClassOf obi:0000485.
obi:0000550 iao:0000111 "nitrogen generator"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A gas generator that generates nitrogen gas."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01034",
