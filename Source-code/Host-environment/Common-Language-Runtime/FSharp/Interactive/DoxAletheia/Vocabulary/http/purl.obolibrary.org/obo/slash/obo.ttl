                                 a owl:Class].
obi:0000732 iao:0000111 "restriction enzyme";
            iao:0000112 "The enzyme EcoR1 cuts DNA at the canonical cleavage site CAATTG";
            iao:0000114 iao:0000123;
            iao:0000115 "an enzyme that has a specific target cleavage sites within nucleic acids";
            iao:0000117 "Kevin Clancy, Bjoern Peters";
            iao:0000232 "5/22 Need to explore if there are GO / other classes exist that capture this. We need it now for cloning experiments";
            a owl:Class;
            rdfs:label "restriction enzyme";
