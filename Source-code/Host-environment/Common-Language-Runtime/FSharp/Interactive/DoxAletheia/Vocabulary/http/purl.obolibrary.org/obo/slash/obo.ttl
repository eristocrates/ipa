                             a owl:Restriction],
                            [owl:someValuesFrom obi:0000552 ; 
                             owl:onProperty pobo:BFO_0000051 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom obi:0000880 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction],
                            obi:0000070.
obi:0001171 iao:0000111 "half life datum (t 1/2)";
            iao:0000114 iao:0000120;
            iao:0000115 "The time it takes for 50% of a class of stochastic processes to occur. ";
            iao:0000117 "Bjoern Peters";
            iao:0000118 "t 1/2";
            iao:0000119 "Bjoern Peters";
            a owl:Class;
            rdfs:label "half life datum (t 1/2)";
            rdfs:subClassOf [owl:someValuesFrom uo:0000003 ; 
                             owl:onProperty iao:0000039 ; 
                             a owl:Restriction],
                            iao:0000416.
obi:0001172 iao:0000111 "dose response curve";
            iao:0000114 iao:0000120;
            iao:0000115 "A data item of paired values, one indicating the dose of a material, the other quantitating a measured effect at that dose. The dosing intervals are chosen so that effect values be interpolated by a plotting a curve. ";
            iao:0000117 "Bjoern Peters; Randi Vita";
            a owl:Class;
            rdfs:label "dose response curve";
            rdfs:subClassOf iao:0000573.
obi:0001173 iao:0000111 "service";
            iao:0000112 "providing a training course for UCSD employees how to run a DNA sequencer; sequencing a DNA sample provided by a service consumer restricted to non-human samples; giving access to tissue samples in a biobank within OHSU; JAX shipping mice from their colony ";
            iao:0000114 iao:0000120;
            iao:0000115 "A planned process in which a service provider performs a task (i.e. a planned process) for a service consumer.";
            iao:0000117 "Carlo; Matt";
            iao:0000119 "OBI workshop San Diego 2011";
            a owl:Class;
            rdfs:label "service";
