            iao:0000112 "typtan blue has a vital dye";
            iao:0000114 iao:0000120;
            iao:0000115 "A dye role that is realized when used to detect live cells in an experiment";
            iao:0000116 "2009-11-10. Tracker: https://sourceforge.net/tracker/?func=detail&aid=2893048&group_id=177891&atid=886178";
            iao:0000117 "Person: Helen Parkinson",
