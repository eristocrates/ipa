                                                                         a owl:Restriction] ; 
                                                     owl:onProperty obi:0000299 ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class].
obi:0000883 iao:0000111 "in vivo cell killing assay";
            iao:0000112 "Labeling two populations of cells with different levels of CFSE, pusling one population with an influenza peptide, injecting the cells into a mouse, and recoving cells 24 hours later. By comparing the recovery rate of cells with different CFSE labeling, it is possible to determine if there was specific killing of peptide pulsed target cells.";
            iao:0000114 iao:0000120;
            iao:0000115 "A cell killing assay that measures if and how many target cells are killed within an organism.";
            iao:0000117 "IEDB";
            iao:0000119 "IEDB";
            a owl:Class;
            rdfs:label "in vivo cell killing assay";
            rdfs:subClassOf obi:0000882;
            owl:equivalentClass [owl:intersectionOf (obi:0000882
                                                     [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (obi:0000067
                                                                                                                 [owl:someValuesFrom obi:0100026 ; 
