obi:0000867 iao:0000111 "establishing cancer cell line";
            iao:0000112 "Establishment of HeLa immortal cell line";
            iao:0000114 iao:0000123;
            iao:0000115 "is a planned process in which the objective is to generate a cell line from a natural population of cancer cells which are already immortal";
            iao:0000119 "";
