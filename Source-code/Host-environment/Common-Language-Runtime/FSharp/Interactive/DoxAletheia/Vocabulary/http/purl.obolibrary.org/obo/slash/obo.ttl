obi:0000118 iao:0000111 "gene list"@en;
            iao:0000112 "Gene lists may arise from analysis to determine differentially expressed genes, may be collected from the literature for involvement in a particular process or pathway (e.g., inflammation), or may be the input for gene set enrichment analysis."@en;
            iao:0000114 iao:0000125;
            iao:0000115 "A data set of the names or identifiers of genes that are the outcome of an analysis or have been put together for the purpose of an analysis."@en;
