go:0040029 iao:0000111 "regulation of gene expression, epigenetic";
           iao:0000115 "Any process that modulates the frequency, rate or extent of gene expression; the process is mitotically or meiotically heritable, or is stably self-propagated in the cytoplasm of a resting cell, and does not entail a change in DNA sequence.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "regulation of gene expression, epigenetic";
           rdfs:subClassOf go:0040030.
go:0040030 iao:0000111 "regulation of molecular function, epigenetic";
           iao:0000115 "Any heritable epigenetic process that modulates the frequency, rate or extent of protein function by self-perpetuating conformational conversions of normal proteins in healthy cells. This is distinct from, though mechanistically analogous to, disease states associated with prion propagation and amyloidogenesis. A single protein, if it carries a glutamine/asparagine-rich ('prion') domain, can sometimes stably exist in at least two distinct physical states, each associated with a different phenotype; propagation of one of these traits is achieved by a self-perpetuating change in the protein from one form to the other, mediated by conformational changes in the glutamine/asparagine-rich domain. Prion domains are both modular and transferable to other proteins, on which they can confer a heritable epigenetic alteration of function; existing bioinformatics data indicate that they are rare in non-eukarya, but common in eukarya.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "regulation of molecular function, epigenetic";
           rdfs:subClassOf go:0008150.
go:0042098 iao:0000111 "T cell proliferation";
           iao:0000115 "The expansion of a T cell population by cell division. Follows T cell activation.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "T cell proliferation";
           rdfs:subClassOf go:0008283.
go:0042101 iao:0000111 "T cell receptor complex";
           iao:0000115 "A protein complex that contains a disulfide-linked heterodimer of T cell receptor (TCR) chains, which are members of the immunoglobulin superfamily, and mediates antigen recognition, ultimately resulting in T cell activation. The TCR heterodimer is associated with the CD3 complex, which consists of the nonpolymorphic polypeptides gamma, delta, epsilon, zeta, and, in some cases, eta (an RNA splice variant of zeta) or Fc epsilon chains.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "T cell receptor complex";
           rdfs:subClassOf obi:1110022.
go:0042110 iao:0000111 "T cell activation";
           iao:0000115 "The change in morphology and behavior of a mature or immature T cell resulting from exposure to a mitogen, cytokine, chemokine, cellular ligand, or an antigen for which it is specific.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "T cell activation";
           rdfs:subClassOf go:0008150.
go:0042571 iao:0000111 "immunoglobulin complex, circulating";
           iao:0000115 "An immunoglobulin complex that is secreted into extracellular space and found in mucosal areas or other tissues or circulating in the blood or lymph. In its canonical form, a circulating immunoglobulin complex is composed of two identical heavy chains and two identical light chains, held together by disulfide bonds. Some forms of are polymers of the basic structure and contain additional components such as J-chain and the secretory component.";
           iao:0000118 "antibody";
           iao:0000412 pobo:go.owl;
           obi:9991118 "antibody";
           a owl:Class;
           rdfs:label "immunoglobulin complex, circulating";
           rdfs:subClassOf obi:1110022,
                           go:0019814.
go:0042575 iao:0000111 "DNA polymerase complex";
           iao:0000115 "A protein complex that possesses DNA polymerase activity and is involved in template directed synthesis of DNA.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "DNA polymerase complex";
           rdfs:subClassOf [owl:someValuesFrom [owl:allValuesFrom go:0034061 ; 
                                                owl:onProperty pobo:BFO_0000054 ; 
                                                a owl:Restriction] ; 
                            owl:onProperty pobo:RO_0000085 ; 
                            a owl:Restriction],
                           obi:0000427,
                           go:0043234.
go:0042605 iao:0000111 "peptide antigen binding";
           iao:0000115 "Interacting selectively and non-covalently with an antigen peptide.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "peptide antigen binding";
           rdfs:subClassOf go:0003823.
go:0042611 iao:0000111 "MHC protein complex";
           iao:0000115 "A transmembrane protein complex composed of an MHC alpha chain and, in most cases, either an MHC class II beta chain or an invariant beta2-microglobin chain, and with or without a bound peptide, lipid, or polysaccharide antigen.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "MHC protein complex";
           rdfs:subClassOf go:0043234.
go:0043227 iao:0000111 "membrane-bounded organelle";
           iao:0000115 "Organized structure of distinctive morphology and function, bounded by a single or double lipid bilayer membrane. Includes the nucleus, mitochondria, plastids, vacuoles, and vesicles. Excludes the plasma membrane.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "membrane-bounded organelle";
           rdfs:subClassOf go:0005575.
go:0043234 iao:0000111 "protein complex";
           iao:0000112 "A ribosome is a protein complex";
           iao:0000115 "A stable macromolecular complex composed (only) of two or more polypeptide subunits along with any covalently attached molecules (such as lipid anchors or oligosaccharide) or non-protein prosthetic groups (such as nucleotides or metal ions). Prosthetic group in this context refers to a tightly bound cofactor. The component polypeptide subunits may be identical.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "protein complex";
           rdfs:subClassOf [owl:someValuesFrom pobo:PR_000000001 ; 
                            owl:onProperty pobo:BFO_0000051 ; 
                            a owl:Restriction],
                           pobo:BFO_0000040.
go:0043316 iao:0000111 "cytotoxic T cell degranulation";
           iao:0000115 "The regulated exocytosis of secretory granules containing preformed mediators such as perforin and granzymes by a cytotoxic T cell.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "cytotoxic T cell degranulation";
           rdfs:subClassOf go:0001906.
go:0043565 iao:0000111 "sequence-specific DNA binding";
           iao:0000115 "Interacting selectively and non-covalently with DNA of a specific nucleotide composition, e.g. GC-rich DNA binding, or with a specific sequence motif or type of DNA e.g. promotor binding or rDNA binding.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "sequence-specific DNA binding";
           rdfs:subClassOf obi:0001588.
go:0044030 iao:0000111 "regulation of DNA methylation";
           iao:0000115 "Any process that modulates the frequency, rate or extent of the covalent transfer of a methyl group to either N-6 of adenine or C-5 or N-4 of cytosine.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "regulation of DNA methylation";
           rdfs:subClassOf go:0040030.
