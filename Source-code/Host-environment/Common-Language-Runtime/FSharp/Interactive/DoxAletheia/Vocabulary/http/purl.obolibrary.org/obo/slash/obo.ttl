            iao:0000114 iao:0000002;
            iao:0000115 "A dot plot is a report graph which is a graphical representation of data where each data point is represented by a single dot placed on coordinates corresponding to data point values in particular dimensions."@en;
            iao:0000117 "person:Chris Stoeckert"@en,
                        "person:Allyson Lister"@en;
            iao:0000119 "group:OBI"@en,
                        "OBI_0000123"@en;
            a owl:Class;
            rdfs:label "dot plot"@en;
            rdfs:subClassOf iao:0000038.
