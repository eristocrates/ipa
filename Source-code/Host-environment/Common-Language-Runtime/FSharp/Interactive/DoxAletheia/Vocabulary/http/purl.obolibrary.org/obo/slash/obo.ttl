obi:0000904 iao:0000111 "reporter cell line analyte detection bioassay";
            iao:0000112 "CTLL-2 cells were grown in the presence of hybridoma supernatants and their growth was monitored by a 3H-thymidine incorporation cell proliferation assay in order to detect IL-2 in the hybridoma supernatant.";
            iao:0000114 iao:0000120;
            iao:0000115 "An analyte assay in which a cell line whose growth is known to be affected by the presence of a specific type of material (the anlyte) is cultured in the presence of an input material (the evaluant) in order to detect presence of the analyte in the evaluant.";
            iao:0000117 "IEDB";
            iao:0000119 "IEDB";
            a owl:Class;
            rdfs:label "reporter cell line analyte detection bioassay";
