obi:0000876 iao:0000111 "cytoplasmic RNA extract";
            iao:0000112 "Cytoplasmic RNA extraction from mammalian tissues to create cDNA library (Carninci P, Nakamura M, Sato K, Hayashizaki Y, Brownstein MJ. Cytoplasmic RNA extraction from fresh and frozen mammalian tissues. Biotechniques. 2002;33:306–309.)";
            iao:0000114 iao:0000120;
            iao:0000115 "A RNA extract that is the output of a RNA extraction process in which RNA molecules found in the cytoplasm are extracted.";
            iao:0000117 "PERSON: Jie Zheng",
                        "PERSON: Chris Stoeckert";
            iao:0000119 "UPenn Group";
