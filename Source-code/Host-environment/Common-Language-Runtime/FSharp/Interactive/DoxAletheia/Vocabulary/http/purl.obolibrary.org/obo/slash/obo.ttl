                                 a owl:Restriction].
obi:0000663 iao:0000111 "class prediction data transformation"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "A class prediction data transformation (sometimes called supervised classification) is a data transformation that has objective class prediction."@en;
            iao:0000117 "James Malone";
            iao:0000118 "supervised classification data transformation";
            iao:0000119 "PERSON: James Malone"@en;
