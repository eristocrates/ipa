                             a owl:Restriction],
                            obi:0000070.
obi:0001188 iao:0000111 "epitope disease exacerbation experiment";
            iao:0000114 iao:0000120;
            iao:0000115 "An efficacy of epitope intervention experiment that tests the ability of inducing an epitope immune response to increase the severity of an existing disease in the host.";
            iao:0000117 "Bjoern Peters";
            iao:0000118 "exacerbation assay";
            a owl:Class;
            rdfs:label "epitope disease exacerbation experiment";
            rdfs:subClassOf obi:0001178.
obi:0001189 iao:0000111 "epitope protection experiment based on survival";
            iao:0000114 iao:0000120;
            iao:0000115 "An epitope protection experiment that determines the success of the epitope intervention based on increased survival of the host. ";
            iao:0000117 "Bjoern Peters";
            iao:0000118 "host survival after challenge";
            a owl:Class;
            rdfs:label "epitope protection experiment based on survival";
            rdfs:subClassOf obi:0001184.
obi:0001190 iao:0000111 "epitope treatment experiment";
            iao:0000114 iao:0000120;
            iao:0000115 "An epitope intervention experiment that tests the ability of inducing an epitope immune response to treat an existing disease  in the host.";
            iao:0000117 "Bjoern Peters";
            iao:0000118 "decreased disease symptoms after treatment";
            a owl:Class;
            rdfs:label "epitope treatment experiment";
