                             a owl:Restriction],
                            obi:0000094.
obi:0000907 iao:0000111 "supplying";
            iao:0000112 "Jackson Labs supplies mouse strains.";
            iao:0000114 iao:0000120;
            iao:0000115 """The planned process of providing material entities
to be used in an investigation.""";
            iao:0000117 "Jennifer Fostel";
            iao:0000119 "Jennifer Fostel";
            iao:0000232 "5/31/2012: A supplying process implies that there is an acquisition process. These may need to be tied together, so that modeling either way is reciprocal. ";
            a owl:Class;
