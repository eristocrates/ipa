obi:0000868 iao:0000111 "pattern matching objective";
            iao:0000114 iao:0000123;
            iao:0000115 "A pattern matching objective aims to detect the presence of the constituents of a given pattern. In contrast to pattern recognition, the pattern is rigidly specified. Patterns are typicall sequences or trees.";
            iao:0000117 "Tina Boussard";
            iao:0000119 "http://en.wikipedia.org/wiki/Pattern_matching";
            a owl:Class;
            rdfs:label "pattern matching objective";
            rdfs:subClassOf obi:0200166.
obi:0000869 iao:0000111 "polyA RNA extract";
            iao:0000112 "Preparation of polyA RNA by cellulose-bound oligo-dT (Aviv, H., Leder, P. 1972. Purification of biologically active globin messenger RNA by chromatography on oligothymidylic acid-cellulose. Proc. Nat. Acad. Sci. USA 69, 1408-1412.)";
            iao:0000114 iao:0000120;
            iao:0000115 "A RNA extract that is the output of an extraction process in which RNA molecules with poly A tail at its 3' end are purified.";
