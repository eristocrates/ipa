obi:0002112 iao:0000111 "small RNA sequencing assay";
            iao:0000114 iao:0000122;
            iao:0000115 "An RNA-seq assay which is targeting small RNA (< 200 bp) sequences such as, but not exclusive to, miRNAs using, for example, small RNA library preparation kits.";
            iao:0000117 "Jason Hilton",
                        "Mark A. Miller",
