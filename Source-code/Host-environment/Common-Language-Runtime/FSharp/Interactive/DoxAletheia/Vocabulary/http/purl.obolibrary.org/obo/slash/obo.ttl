obi:0000479 iao:0000111 "solid NMR probe"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An NMR probe that is designed to hold a solid sample."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400243",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
