                                                                                                                 a owl:Restriction]) ; 
                                                                                             a owl:Class] ; 
                                                                         owl:onProperty pobo:BFO_0000055 ; 
                                                                         a owl:Restriction]
                                                                         [owl:someValuesFrom obi:0400103 ; 
                                                                         owl:onProperty obi:0000293 ; 
                                                                         a owl:Restriction]) ; 
                                                     a owl:Class]
                                                     [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (obi:0000067
                                                                                                                 [owl:someValuesFrom obi:0001051 ; 
                                                                                                                 owl:onProperty pobo:RO_0000081 ; 
                                                                                                                 a owl:Restriction]) ; 
                                                                                             a owl:Class] ; 
                                                                         owl:onProperty pobo:BFO_0000055 ; 
                                                                         a owl:Restriction]
                                                                         [owl:someValuesFrom [owl:intersectionOf (obi:0001051
                                                                                                                 [owl:someValuesFrom obi:0000067 ; 
                                                                                                                 owl:onProperty pobo:RO_0000087 ; 
