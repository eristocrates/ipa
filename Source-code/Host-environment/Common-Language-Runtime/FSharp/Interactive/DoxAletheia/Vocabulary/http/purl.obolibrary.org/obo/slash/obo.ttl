            iao:0000117 "MIABIS";
            iao:0000119 "MIABIS contributors";
            a owl:Class;
            rdfs:label "birth cohort study design";
            rdfs:subClassOf obi:0500000.
obi:0002615 iao:0000111 "disease specific study design";
