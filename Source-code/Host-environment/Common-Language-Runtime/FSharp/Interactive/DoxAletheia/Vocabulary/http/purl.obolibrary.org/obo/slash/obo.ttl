                            pobo:BFO_0000023.
obi:1110084 iao:0000111 "effector T cell function";
            iao:0000114 iao:0000123;
            iao:0000115 "The function inhering in a T cell that is realized in an immune response that results from the T cell receptor binding to the MHC:epitope complex."@en;
            iao:0000117 "IEDB"@en;
