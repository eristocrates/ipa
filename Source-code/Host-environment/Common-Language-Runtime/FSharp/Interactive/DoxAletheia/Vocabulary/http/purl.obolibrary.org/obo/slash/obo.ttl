obi:0001933 iao:0000111 "value specification";
            iao:0000112 """The value of 'positive' in a classification scheme of \"positive or negative\"; the value of '20g' on the quantitative scale of mass.""";
            iao:0000114 iao:0000122;
            iao:0000115 "An information content entity that specifies a value within a classification scheme or on a quantitative scale.";
            iao:0000116 "This term is currently a descendant of 'information content entity', which requires that it 'is about' something. A value specification of '20g' for a measurement data item of the mass of a particular mouse 'is about' the mass of that mouse. However there are cases where a value specification is not clearly about any particular. In the future we may change 'value specification' to remove the 'is about' requirement.";
            iao:0000117 "PERSON:Bjoern Peters";
            a owl:Class;
            rdfs:label "value specification";
            rdfs:subClassOf iao:0000030.
obi:0001934 iao:0000111 "predicted value";
            iao:0000114 iao:0000123;
            iao:0000115 "an information content entity that has been generated by a prediction process in which an estimate of a value of an entity is made which can be measured but without performing such a measurement. The value specification is intended to be close to the value a measurement process would produce modulo a prediction error.";
            iao:0000117 "PERSON:Bjoern Peters";
            a owl:Class;
            rdfs:label "predicted value";
            rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (iao:0000104
                                                                     [owl:allValuesFrom [owl:someValuesFrom obi:0001932 ; 
                                                                                        owl:onProperty pobo:BFO_0000055 ; 
                                                                                        a owl:Restriction] ; 
                                                                     owl:onProperty pobo:RO_0000059 ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class] ; 
                             owl:onProperty pobo:BFO_0000051 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom obi:0001933 ; 
                             owl:onProperty pobo:BFO_0000051 ; 
                             a owl:Restriction],
                            iao:0000030.
obi:0001935 iao:0000111 "predicted mass value";
            iao:0000114 iao:0000123;
            iao:0000115 " A predicted value where the prediction specifies the mass of some thing.";
            iao:0000117 "PERSON:Bjoern Peters";
            a owl:Class;
            rdfs:label "predicted mass value";
            rdfs:subClassOf obi:0001934;
            owl:equivalentClass [owl:intersectionOf (obi:0001934
                                                     [owl:someValuesFrom obi:0001929 ; 
                                                     owl:onProperty pobo:BFO_0000051 ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class].
obi:0001936 iao:0000111 "molecular-labeled material";
            iao:0000114 iao:0000125;
            iao:0000115 "a material entity that is the specified output of an addition of molecular label process that aims to label some molecular target to allow for its detection in a detection of molecular label assay";
            iao:0000117 "PERSON:Matthew Brush";
            iao:0000119 "OBI developer call, 3-12-12";
            a owl:Class;
