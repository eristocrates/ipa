obi:0400118 iao:0000111 "vortexer"@en;
            iao:0000112 "VWR  Genie 2"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "A vortexer is an instrument that mixes small vials of liquid by creating a rotation of the liquid around its own center. It consists of an electric motor with the drive shaft oriented vertically and attached to a cupped rubber piece mounted slightly off-center. As the motor runs the rubber piece oscillates rapidly in a circular motion. When a test tube or other appropriate container is pressed into the rubber cup (or touched to its edge) the motion is transmitted to the liquid inside and a vortex is created."@en;
            iao:0000117 "Melanie Courtot"@en,
                        "Trish Whetzel"@en;
            iao:0000118 "vortex_mixer"@en;
            iao:0000119 "http://en.wikipedia.org/wiki/Vortex_mixer"@en;
            a owl:Class;
            rdfs:label "vortexer"@en;
            rdfs:subClassOf [owl:someValuesFrom obi:0000377 ; 
                             owl:onProperty pobo:RO_0000085 ; 
                             a owl:Restriction],
                            obi:0001033.
obi:0400119 iao:0000111 "microarray wash station"@en;
            iao:0000112 "ArrayIt(r) Microarray Wash Station"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "a device that is used to wash Affymetrix-type arrays."@en;
            iao:0000117 "Trish Whetzel"@en;
            iao:0000119 "MO_626 wash_station"@en;
            a owl:Class;
