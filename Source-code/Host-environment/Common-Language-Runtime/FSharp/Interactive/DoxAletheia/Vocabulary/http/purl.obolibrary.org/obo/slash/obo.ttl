obi:0001174 iao:0000111 "passive immunization";
            iao:0000112 """Giving VIG (concentrated antibodies from vaccinated donors) to a patient that is infected with smallpox. 
Transferring epitope specific T cells from one mouse into another.""";
            iao:0000114 iao:0000122;
            iao:0000115 "The injection of immune effector material (antibodies, T cells or B cells) into an organism so that the organisms immune system gains its  immune effector function to recognize specific antigens.";
            iao:0000117 "PERSON: Bjoern Peters, Randi Vita, Jason Greenbaum";
            iao:0000118 "adoptive transfer";
            a owl:Class;
            rdfs:label "passive immunization";
            rdfs:subClassOf obi:0600007,
                            [owl:someValuesFrom [owl:intersectionOf (obi:0000319
                                                                     [owl:someValuesFrom obi:1110022 ; 
                                                                     owl:onProperty pobo:RO_0000052 ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class] ; 
                             owl:onProperty pobo:BFO_0000055 ; 
                             a owl:Restriction].
obi:0001175 iao:0000111 "selective organism creation objective"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "an objective specification to generate a population or type of organism within species that have some uniform behavioral, morphological, physiological, or genetic characteristics with similarly bred organisms.";
            iao:0000117 "PERSON: Chris Stoeckert, Jie Zheng";
            iao:0000119 """WEB: wikipedia
http://en.wikipedia.org/wiki/Cultivar
http://en.wikipedia.org/wiki/Ecotype
http://en.wikipedia.org/wiki/Strain_%28biology%29""";
            a owl:Class;
            rdfs:label "selective organism creation objective"@en;
            rdfs:subClassOf iao:0000005.
obi:0001176 iao:0000111 "Individual epitope immunization in vivo";
            iao:0000112 "Injection of a peptide T cell epitope into a mouse";
            iao:0000114 iao:0000120;
            iao:0000115 "An immunization in which an individual epitope is administered into a host organism. ";
            iao:0000116 "3/16/11 BP: This should have as a logical definition the exclusion that the immunogen cannot be something beyond the epitope itself. I don't know if that is possible to do here. ";
            iao:0000117 "PERSON:Bjoern Peters, Jason Greenbaum, Randi Vita";
            a owl:Class;
            rdfs:label "Individual epitope immunization in vivo";
            rdfs:subClassOf obi:1110015.
obi:0001177 iao:0000111 "RNA sequencing assay";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that determines the sequence of an RNA molecule.";
