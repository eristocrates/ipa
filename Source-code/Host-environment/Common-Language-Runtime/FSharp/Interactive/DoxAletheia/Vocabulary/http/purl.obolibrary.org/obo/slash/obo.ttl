obi:0001961 iao:0000111 "PCR program"@en;
            iao:0000112 "https://www.neb.com/protocols/1/01/01/taq-dna-polymerase-with-standard-taq-buffer-m0273"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "a PCR program is a plan specification which is executed during a polymerase chain reaction (PCR) by a thermocycler instrument that will iterate through the changes in temperature and duration of each of the annealing, denaturation, elongation steps for as many times as specified by the program."@en;
            iao:0000117 "PERSON:Philippe Rocca-Serra"@en;
            iao:0000119 "OBI"@en;
            a owl:Class;
            rdfs:label "PCR program"@en;
            rdfs:subClassOf iao:0000104.
obi:0001962 iao:0000111 "target gene specification"@en;
            iao:0000112 """http://www.ncbi.nlm.nih.gov/pubmed/25367129

\"performing a profiling of microbial phylogenetic composition using sequencing of 16S rRNA gene (used as target gene)"""@en;
            iao:0000114 iao:0000122;
            iao:0000115 "is a directive information specifying a coding genomic region which is the focus of a planned process such as an assay, for instance in a environmental gene survey"@en;
            iao:0000117 "PERSON:Philippe Rocca-Serra"@en;
            iao:0000119 "PRS for OBI"@en;
            obi:0001847 "target gene"@en;
            a owl:Class;
            rdfs:label "target gene specification"@en;
            rdfs:subClassOf iao:0000033.
obi:0001963 iao:0000111 "target subfragment specification"@en;
            iao:0000112 """http://www.ncbi.nlm.nih.gov/pubmed/23335919

\"performing a profiling of microbial phylogenetic composition using massively-parallel pyrotag sequencing targeting the V9 hypervariable region (used as target subfragment) of the 18S ribosomal RNA (rRNA) gene (used as target gene)"""@en;
            iao:0000114 iao:0000122;
            iao:0000115 "is a directive information specifying a genomic region, possibly located in a coding genomic region, which is the focus of a planned process such as an assay, for instance in a environmental gene survey"@en;
            iao:0000117 "PERSON:Philippe Rocca-Serra"@en;
            iao:0000119 "PRS for OBI"@en;
            obi:0001847 "target subfragment"@en;
            a owl:Class;
            rdfs:label "target subfragment specification"@en;
            rdfs:subClassOf iao:0000033.
obi:0001964 iao:0000111 "decision-theoretic analysis objective";
            iao:0000114 iao:0000120;
            iao:0000115 "An objective specification which what includes a description of two or more alternative actions to take in a particular situation and a metric that enables comparisons of the two actions. The objective specified is achieved in a planned process which includes a data transformation, the output of which is an identification of the 'best' choice according to the metric.";
            iao:0000116 "The best action to take is typically defined as the one that maximizes expected utility.";
            iao:0000117 "PERSON: Bill Hogan";
            iao:0000118 "decision analysis objective";
            iao:0000119 "PERSON: Bill Hogan";
            a owl:Class;
            rdfs:label "decision-theoretic analysis objective";
            rdfs:subClassOf iao:0000005.
obi:0001965 iao:0000111 "decision analysis study design";
            iao:0000114 iao:0000120;
            iao:0000115 "a study design that has a decision analysis objective specification as part";
            iao:0000117 "PERSON: Bill Hogan";
            iao:0000119 "PERSON: Bill Hogan";
            a owl:Class;
            rdfs:label "decision analysis study design";
            rdfs:subClassOf obi:0500000;
            owl:equivalentClass [owl:intersectionOf (obi:0500000
                                                     [owl:someValuesFrom obi:0001964 ; 
                                                     owl:onProperty pobo:BFO_0000051 ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class].
obi:0001966 iao:0000111 "sequence library data demultiplexing"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "is a data transformation which uses sequence alignment and  'multiplex identifier sequence' information to separate all reads belonging to a given single sample following the sequencing of a multiplexed library"@en;
            iao:0000117 "PERSON: Philippe Rocca-Serra"@en;
            iao:0000119 "PRS for OBI"@en;
            a owl:Class;
            rdfs:label "sequence library data demultiplexing"@en;
            rdfs:subClassOf [owl:someValuesFrom obi:0200081 ; 
                             owl:onProperty obi:0000417 ; 
                             a owl:Restriction],
                            obi:0200187.
obi:0001967 iao:0000111 "multiplexing sequence identifier"@en;
            iao:0000112 "We designed primers specifically to amplify protease and reverse transcriptase from Brazilian HIV subtypes and developed a multiplexing scheme using multiplex identifier tags to minimize cost while providing more robust data than traditional genotyping techniques. in http://www.ncbi.nlm.nih.gov/pubmed/22574170"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "A multiplexing sequence identifier is a nucleic acid sequence which is used in a ligation step of library preparation process to allow pooling of samples while maintaining ability to identify individual source material and creation of a multiplexed library"@en;
            iao:0000117 "PERSON:Philippe Rocca-Serra"@en;
            iao:0000119 "OBI"@en;
            a owl:Class;
            rdfs:label "multiplexing sequence identifier"@en;
