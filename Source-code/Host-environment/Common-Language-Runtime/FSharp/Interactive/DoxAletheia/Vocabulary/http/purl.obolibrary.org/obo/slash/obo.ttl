obi:0002453 iao:0000111 "health status inclusion criterion"@en;
            iao:0000112 "‘diagnosed with Type 2 diabetes mellitus’, ‘E11.4’, ’not finding of hypertension'"@en;
            iao:0000114 iao:0000123;
            iao:0000115 "An inclusion criterion that defines and states one or more clinically significant bodily components, dispositions, and/or bodily processes of an entity that are inferred from relevant clinical findings or self-reported, which, if met, makes the entity suitable for a given task or participation in a given process."@en;
