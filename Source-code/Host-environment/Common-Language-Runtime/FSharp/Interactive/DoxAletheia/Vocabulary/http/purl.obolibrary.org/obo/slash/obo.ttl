                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction],
                            obi:0000838.
obi:0600025 iao:0000111 "substance detection assay";
            iao:0000112 "the detection of phycoerytherin by means of flow cytometry";
            iao:0000114 iao:0000125;
            iao:0000115 "An assay that detects a specified substance";
            iao:0000117 "Kevin Clancy";
            iao:0000119 "OBI branch derived";
