go:0097458 iao:0000111 "neuron part";
           iao:0000115 "Any constituent part of a neuron, the basic cellular unit of nervous tissue. A typical neuron consists of a cell body (often called the soma), an axon, and dendrites. Their purpose is to receive, conduct, and transmit impulses in the nervous system.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "neuron part";
           rdfs:subClassOf go:0005575.
pobo:HP_0000855 iao:0000111 "Insulin resistance";
                iao:0000115 "Increased resistance towards insulin, that is, diminished effectiveness of insulin in reducing blood glucose levels.";
                iao:0000412 pobo:hp.owl;
                a owl:Class;
                rdfs:label "Insulin resistance";
                rdfs:subClassOf pobo:BFO_0000016.
