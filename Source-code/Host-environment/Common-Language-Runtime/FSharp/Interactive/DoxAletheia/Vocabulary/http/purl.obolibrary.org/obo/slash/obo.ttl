obi:0001943 iao:0000111 "software pipeline"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A plan specification that specifies a chain encoded in software of processing elements (processes, threads, coroutines, etc.), arranged so that the output of each element is the input of the next. Usually some amount of buffering is provided between consecutive elements.";
            iao:0000117 "PERSON: Jie Zheng, Chris Stoeckert";
            iao:0000119 "WEB: http://en.wikipedia.org/wiki/Pipeline_%28software%29";
            dc11:source "NIAID GSCID-BRC";
            a owl:Class;
            rdfs:label "software pipeline"@en;
            rdfs:subClassOf iao:0000104.
obi:0001944 iao:0000111 "sequence annotation"@en;
            iao:0000114 iao:0000120;
