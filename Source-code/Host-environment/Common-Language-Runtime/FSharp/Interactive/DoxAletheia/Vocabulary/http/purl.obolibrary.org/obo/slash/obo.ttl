obi:0001631 iao:0000111 "electron microscopy imaging assay";
            iao:0000112 "Using gold labeled antibodies to stain a mouse brain slice and use electron microscopy to generate an image that shows the location of the antibodies within the tissue structure.";
            iao:0000114 iao:0000120;
            iao:0000115 "An imaging assay in which an electrons are used to probe the density, shape and composition of an input material which are detected in an electron microscope and utilized to produce an image of the material.";
            iao:0000117 "IEDB";
