obi:0001156 iao:0000111 "age since planting measurement datum"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An age measurement datum that is the result of the measurement of the age of an organism since planting, the process of placing a plant in media (e.g. soil) to allow it to grow, which excludes sowing.";
            iao:0000117 "PERSON:Chris Stoeckert, Jie Zheng";
            iao:0000119 "MO_495 planting";
            iao:0000232 """Discussed by Jie and Chris, proposed to combine with different kinds of processes as initial time point. Proposed 'age measurement assay' is proceeded by some process. The process can be any kind of process defined in OBI. Think it is more flexible. However, it is hard to model  due to lake of temporal predicates on Nov 15, 2010 dev call.
Term proposed by Bjoern on Nov 8, 2010 dev call
Supported by Alan on Nov 15, 2010 dev call""";
            a owl:Class;
            rdfs:label "age since planting measurement datum"@en;
            rdfs:subClassOf obi:0001167.
obi:0001157 iao:0000111 "age since hatching measurement datum"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An age measurement datum that is the result of the measurement of the age of an organism since hatching, the process of emergence from an egg.";
            iao:0000117 "PERSON:Chris Stoeckert, Jie Zheng";
            iao:0000119 "MO_745 hatching";
            a owl:Class;
            rdfs:label "age since hatching measurement datum"@en;
            rdfs:subClassOf obi:0001167.
obi:0001158 iao:0000111 "age determination assay";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that determines the duration of part of the life of an organism, where the initial time point is the beginning of some transitional state (such as birth or when planted).";
            iao:0000116 "This assay measures time not developmental stage. we recognize that development takes different time periods under different conditions such as media / temperature. For example, age measurement assay of fly age, the output likes 28 days but not mid-life of age at room temperature.";
            iao:0000117 "Alan Ruttenberg";
            iao:0000118 "age measurement assay";
            iao:0000119 "OBI group";
            a owl:Class;
            rdfs:label "age determination assay";
            rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (obi:0000067
                                                                                         [owl:someValuesFrom obi:0100026 ; 
                                                                                         owl:onProperty pobo:RO_0000081 ; 
                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty pobo:BFO_0000055 ; 
                                                 a owl:Restriction]
                                                 [owl:someValuesFrom [owl:intersectionOf (obi:0100026
                                                                                         [owl:someValuesFrom obi:0000067 ; 
                                                                                         owl:onProperty pobo:RO_0000087 ; 
                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty obi:0000293 ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class],
                            [owl:someValuesFrom obi:0001167 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            obi:0000070.
obi:0001159 iao:0000111 "age since egg laying measurement datum"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An age measurement datum that is the result of the measurement of the age of an organism since egg laying, the process of the production of egg(s) by an organism.";
            iao:0000117 "PERSON:Chris Stoeckert, Jie Zheng";
            iao:0000119 "MO_767 egg laying";
            a owl:Class;
            rdfs:label "age since egg laying measurement datum"@en;
            rdfs:subClassOf obi:0001167.
obi:0001160 iao:0000111 "assay validation objective"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "an objective specification to check the accuracy or the quality of the results of an assay by comparison with independent results"@en;
            iao:0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en;
            iao:0000119 "GROUP: Penn Group"@en;
            a owl:Class;
            rdfs:label "assay validation objective"@en;
            rdfs:subClassOf iao:0000005.
obi:0001161 iao:0000111 "age since germination measurement datum"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An age measurement datum that is the result of the measurement of the age of an organism since germination, the process consisting of physiological and developmental changes by a seed, spore, pollen grain (microspore), or zygote that occur after release from dormancy, and encompassing events prior to and including the first visible indications of growth.";
            iao:0000116 "Definition of germination comes from GO. However, the term is deprecated from GO now because it is a grouping term without biological significance.";
            iao:0000117 "PERSON:Chris Stoeckert, Jie Zheng";
            iao:0000119 "MO_590 germination";
            a owl:Class;
            rdfs:label "age since germination measurement datum"@en;
            rdfs:subClassOf obi:0001167.
obi:0001162 iao:0000111 "validation by reverse transcription PCR design"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "a study design in which checks the accuracy or the quality of the result of an assay  by comparing with reverse transcription PCR results"@en;
            iao:0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en;
            iao:0000119 "MO_986 reverse_transcription_PCR_quality_control"@en;
            a owl:Class;
            rdfs:label "validation by reverse transcription PCR design"@en;
            rdfs:subClassOf obi:0500000.
obi:0001163 iao:0000111 "age since eclosion measurement datum"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An age measurement datum that is the result of the measurement of the age of an organism since eclosion, the process of emergence of an adult insect from its pupa or cocoon.";
            iao:0000117 "PERSON:Chris Stoeckert, Jie Zheng";
            iao:0000119 "MO_876 eclosion";
            a owl:Class;
            rdfs:label "age since eclosion measurement datum"@en;
            rdfs:subClassOf obi:0001167.
obi:0001164 iao:0000111 "age since sowing measurement datum"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An age measurement datum that is the result of the measurement of the age of an organism since sowing, the process of placing a seed or spore in some media with the intention to invoke germination.";
            iao:0000117 "PERSON:Chris Stoeckert, Jie Zheng";
            iao:0000119 "MO_748 sowing";
            a owl:Class;
            rdfs:label "age since sowing measurement datum"@en;
            rdfs:subClassOf obi:0001167.
obi:0001165 iao:0000111 "age since coitus measurement datum"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An age measurement datum that is the result of the measurement of the age of an organism since coitus, the process of copulation that occurs during the process of sexual reproduction.";
            iao:0000117 "PERSON:Chris Stoeckert, Jie Zheng";
            iao:0000119 "MO_783 coitus";
            a owl:Class;
            rdfs:label "age since coitus measurement datum"@en;
            rdfs:subClassOf obi:0001167.
obi:0001166 iao:0000111 "validation by real time PCR design"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "a study design in which the accuracy or the quality of the result of an assay is checked by comparing with real time PCR results"@en;
            iao:0000117 "PERSON: Chris Stoeckert, Jie Zheng"@en;
            iao:0000119 "MO_434 real_time_PCR_quality_control"@en;
            a owl:Class;
            rdfs:label "validation by real time PCR design"@en;
            rdfs:subClassOf obi:0500000.
obi:0001167 iao:0000111 "age measurement datum"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A time measurement datum that is the result of measurement of age of an organism";
            iao:0000116 """note that we are currently defining subtypes of age measurement datum that specify when the age is relative to, e.g. planting, as we don't have adequate temporal predicates yet.
life of bearer doesn't imply organism
this assay measures time not developmental stage. we recognize that development can take different time periods under different conditions such as media / temperature
age as a quality is dubious; we plan to revisit
stages in development are currently handled with controlled vocabulary, such as 2-somite stage """;
            iao:0000117 "PERSON: Alan Ruttenberg, Chris Stoeckert, Jie Zheng";
            iao:0000119 "MO_178 Age";
            iao:0000232 """In MageTab file, we use
initialTimePoint (a process) + age (a number expected) + TimeUnit (definied in UO, such as year, hour, day, etc.)
Now we use the term label indicating the start time point of measuring the age, (number + TimeUnit) are expected instances of the class""",
                        """discussed on Nov 15, dev call
All subtype will be defined by textual definition now.""";
            a owl:Class;
            rdfs:label "age measurement datum"@en;
            rdfs:subClassOf [owl:someValuesFrom pobo:PATO_0000011 ; 
                             owl:onProperty iao:0000221 ; 
                             a owl:Restriction],
                            iao:0000416.
obi:0001168 iao:0000111 "age since fertilization measurement datum"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An age measurement datum that is the result of the measurement of the age of an organism since fertilization, the process of the union of gametes of opposite sexes during the process of sexual reproduction to form a zygote.";
            iao:0000116 "Definition of fertilization comes from GO.";
            iao:0000117 "PERSON:Chris Stoeckert, Jie Zheng";
            iao:0000119 "MO_701 fertilization";
            a owl:Class;
            rdfs:label "age since fertilization measurement datum"@en;
            rdfs:subClassOf obi:0001167.
obi:0001169 iao:0000111 "age since birth measurement datum"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An age measurement datum that is the result of the measurement of the age of an organism since birth, the process of emergence and separation of offspring from the mother.";
            iao:0000117 "PERSON:Chris Stoeckert, Jie Zheng";
            iao:0000119 "MO_710 birth";
            a owl:Class;
            rdfs:label "age since birth measurement datum"@en;
            rdfs:subClassOf obi:0001167.
obi:0001170 iao:0000111 "reverse transcription polymerase chain reaction assay";
            iao:0000114 iao:0000120;
            iao:0000115 "An assay that determines the concentration of RNA in a sample in which an RNA strand is first reverse transcribed into its DNA complement (complementary DNA, or cDNA) using the enzyme reverse transcriptase, and the resulting cDNA is amplified using traditional or real-time PCR.";
            iao:0000117 "Chris Stoeckert",
                        "Jie Zheng";
            iao:0000119 "Penn Group";
            a owl:Class;
            rdfs:label "reverse transcription polymerase chain reaction assay";
