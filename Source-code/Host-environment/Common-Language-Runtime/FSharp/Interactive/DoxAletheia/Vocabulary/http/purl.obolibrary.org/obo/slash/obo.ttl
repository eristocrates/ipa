               a owl:Class;
               rdfs:label "anatomical cluster";
               rdfs:subClassOf pobo:BFO_0000040.
uberon:0000479 iao:0000111 "tissue";
               iao:0000115 "Multicellular anatomical structure that consists of many cells of one or a few types, arranged in an extracellular matrix such that their long-range organisation is at least partly a repetition of their short-range organisation.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "tissue";
               rdfs:subClassOf uberon:0000465.
uberon:0000481 iao:0000111 "multi-tissue structure";
               iao:0000115 "Anatomical structure that has as its parts two or more portions of tissue of at least two different types and which through specific morphogenetic processes forms a single distinct structural unit demarcated by bona-fide boundaries from other distinct structural units of different types.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "multi-tissue structure";
               rdfs:subClassOf uberon:0000465.
uberon:0000483 iao:0000111 "epithelium";
               iao:0000115 "Portion of tissue, that consists of one or more layers of epithelial cells connected to each other by cell junctions and which is underlain by a basal lamina. Examples: simple squamous epithelium, glandular cuboidal epithelium, transitional epithelium, myoepithelium[CARO].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "epithelium";
               rdfs:subClassOf uberon:0000479.
uberon:0000945 iao:0000111 "stomach";
               iao:0000115 "An expanded region of the vertebrate alimentary tract that serves as a food storage compartment and digestive organ. A stomach is lined, in whole or in part by a glandular epithelium.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "stomach";
               rdfs:subClassOf uberon:0000465.
uberon:0000947 iao:0000111 "aorta";
               iao:0000115 "The main trunk of the systemic arterial system that carries blood from the heart to all the organs and other structures of the body, bringing oxygenated blood to all parts of the body in the systemic circulation";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "aorta";
               rdfs:subClassOf uberon:0000465.
uberon:0000948 iao:0000111 "heart";
               iao:0000115 "A myogenic muscular circulatory organ found in the vertebrate cardiovascular system composed of chambers of cardiac muscle. It is the primary circulatory organ.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "heart";
               rdfs:subClassOf uberon:0000465.
uberon:0000955 iao:0000111 "brain";
               iao:0000115 "The brain is the center of the nervous system in all vertebrate, and most invertebrate, animals. Some primitive animals such as jellyfish and starfish have a decentralized nervous system without a brain, while sponges lack any nervous system at all. In vertebrates, the brain is located in the head, protected by the skull and close to the primary sensory apparatus of vision, hearing, balance, taste, and smell[WP].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "brain";
               rdfs:subClassOf uberon:0000465.
uberon:0000956 iao:0000111 "cerebral cortex";
               iao:0000115 "The thin layer of gray matter on the surface of the cerebral hemisphere that develops from the telencephalon. It consists of the neocortex (6 layered cortex or isocortex), the hippocampal formation and the olfactory cortex.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "cerebral cortex";
               rdfs:subClassOf uberon:0000477.
uberon:0000992 iao:0000111 "ovary";
               iao:0000115 "the gonad of a female organism which contains germ cells";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "ovary";
               rdfs:subClassOf uberon:0000465.
uberon:0000995 iao:0000111 "uterus";
               iao:0000115 "the female muscular organ of gestation in which the developing embryo or fetus is nourished until birth";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "uterus";
               rdfs:subClassOf uberon:0000465.
uberon:0000996 iao:0000111 "vagina";
               iao:0000115 "A fibromuscular tubular tract leading from the uterus to the exterior of the body in female placental mammals and marsupials, or to the cloaca in female birds, monotremes, and some reptiles[WP].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "vagina";
               rdfs:subClassOf uberon:0000465.
uberon:0001013 iao:0000111 "adipose tissue";
               iao:0000115 "Portion of connective tissue composed of adipocytes enmeshed in areolar tissue";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "adipose tissue";
               rdfs:subClassOf uberon:0000479.
uberon:0001037 iao:0000111 "strand of hair";
               iao:0000115 "A filament, mostly protein, that grows from follicles found in the dermis[WP].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "strand of hair";
               rdfs:subClassOf uberon:0000465.
uberon:0001052 iao:0000111 "rectum";
               iao:0000115 "the terminal portion of the intestinal tube, terminating with the anus";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "rectum";
               rdfs:subClassOf uberon:0000465.
uberon:0001087 iao:0000111 "pleural fluid";
               iao:0000115 "Transudate contained in the pleural cavity.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "pleural fluid";
               rdfs:subClassOf uberon:0000463.
uberon:0001088 iao:0000111 "urine";
               iao:0000115 "Excretion that is the output of a kidney";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "urine";
               rdfs:subClassOf uberon:0000463.
uberon:0001089 iao:0000111 "sweat";
               iao:0000115 "Secretion produced by a sweat gland.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "sweat";
               rdfs:subClassOf uberon:0000463.
uberon:0001090 iao:0000111 "synovial fluid";
               iao:0000115 "Joint fluid is a transudate of plasma that is actively secreted by synovial cells.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "synovial fluid";
               rdfs:subClassOf uberon:0000463.
uberon:0001134 iao:0000111 "skeletal muscle tissue";
               iao:0000115 "Muscle tissue that consists primarily of skeletal muscle fibers.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "skeletal muscle tissue";
               rdfs:subClassOf uberon:0000479.
uberon:0001155 iao:0000111 "colon";
               iao:0000115 "Last portion of the large intestine before it becomes the rectum.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "colon";
               rdfs:subClassOf uberon:0000465.
uberon:0001159 iao:0000111 "sigmoid colon";
               iao:0000115 "The part of the large intestine that is closest to the rectum and anus. It forms a loop that averages about 40 cm. in length, and normally lies within the pelvis, but on account of its freedom of movement it is liable to be displaced into the abdominal cavity.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "sigmoid colon";
               rdfs:subClassOf uberon:0000465.
uberon:0001225 iao:0000111 "cortex of kidney";
               iao:0000115 "Outer cortical portion of the kidney, between the renal capsule and the renal medulla.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "cortex of kidney";
               rdfs:subClassOf uberon:0000465.
uberon:0001255 iao:0000111 "urinary bladder";
               iao:0000115 "distensible musculomembranous organ situated in the anterior part of the pelvic cavity in which urine collects before excretion[MP].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "urinary bladder";
               rdfs:subClassOf uberon:0000465.
uberon:0001264 iao:0000111 "pancreas";
               iao:0000115 "An endoderm derived structure that produces precursors of digestive enzymes and blood glucose regulating enzymes[GO].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "pancreas";
               rdfs:subClassOf uberon:0000465.
uberon:0001268 iao:0000111 "peritoneal fluid";
               iao:0000115 "Transudate contained in the peritoneal cavity.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "peritoneal fluid";
               rdfs:subClassOf uberon:0000463.
uberon:0001323 iao:0000111 "tibial nerve";
               iao:0000115 "The tibial nerve is a branch of the sciatic nerve. The tibial nerve passes through the popliteal fossa to pass below the arch of soleus. In the popliteal fossa the nerve gives off branches to gastrocnemius, popliteus, soleus and plantaris muscles, an articular branch to the knee joint, and a cutaneous branch that will become the sural nerve. The sural nerve is joined by fibres from the common peroneal nerve and runs down the calf to supply the lateral side of the foot. Below the soleus muscle the nerve lies close to the tibia and supplies the tibialis posterior, the flexor digitorum longus and the flexor hallucis longus. The nerve passes into the foot running posterior to the medial malleolus. Here it is bound down by the flexor retinaculum in company with the posterior tibial artery. [WP,unvetted].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "tibial nerve";
               rdfs:subClassOf uberon:0000477.
uberon:0001359 iao:0000111 "cerebrospinal fluid";
               iao:0000115 "A clear, colorless, bodily fluid, that occupies the subarachnoid space and the ventricular system around and inside the brain and spinal cord.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "cerebrospinal fluid";
               rdfs:subClassOf uberon:0000463.
uberon:0001567 iao:0000111 "cheek";
               iao:0000115 "A fleshy subdivision of one side of the face bounded by an eye, ear and the nose.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "cheek";
               rdfs:subClassOf uberon:0000465.
uberon:0001621 iao:0000111 "coronary artery";
               iao:0000115 "An artery that supplies the myocardium.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "coronary artery";
               rdfs:subClassOf uberon:0000465.
uberon:0001638 iao:0000111 "vein";
               iao:0000115 "Any of the tubular branching vessels that carry blood from the capillaries toward the heart.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "vein";
               rdfs:subClassOf uberon:0000465.
uberon:0001723 iao:0000111 "tongue";
               iao:0000115 "A muscular organ in the floor of the mouth.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "tongue";
               rdfs:subClassOf uberon:0000465.
uberon:0001728 iao:0000111 "nasopharynx";
               iao:0000115 "the section of the pharynx that lies above the soft palate";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "nasopharynx";
               rdfs:subClassOf uberon:0000465.
uberon:0001729 iao:0000111 "oropharynx";
               iao:0000115 "the portion of the pharynx that lies between the soft palate and the upper edge of the epiglottis";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "oropharynx";
               rdfs:subClassOf uberon:0000465.
uberon:0001797 iao:0000111 "vitreous humor";
               iao:0000115 "A transparent, semigelatinous substance that fills the cavity behind the crystalline lens of the eye and in front of the retina";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "vitreous humor";
               rdfs:subClassOf uberon:0000463.
uberon:0001830 iao:0000111 "minor salivary gland";
               iao:0000115 "One of the smaller, largely mucus-secreting, exocrine glands of the oral cavity, consisting of the labial, buccal, molar, lingual, and palatine glands[MP].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "minor salivary gland";
               rdfs:subClassOf uberon:0000465.
uberon:0001836 iao:0000111 "saliva";
               iao:0000115 "A fluid produced in the oral cavity by salivary glands, typically used in predigestion, but also in other functions.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "saliva";
               rdfs:subClassOf uberon:0000463.
uberon:0001873 iao:0000111 "caudate nucleus";
               iao:0000115 "Subcortical nucleus of telecephalic origin consisting of an elongated gray mass lying lateral to and bordering the lateral ventricle. It is divided into a head, body and tail in some species.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "caudate nucleus";
               rdfs:subClassOf uberon:0000477.
uberon:0001874 iao:0000111 "putamen";
               iao:0000115 "Subcortical nucleus of telencephalic , which together with the caudate nucleus, forms the striatum. The putamen lies lateral to the internal capsule and medial to the external medullary lamina, and is separated from the caudate nucleus by the fibers of the internal capsule for most of its length, except at its anterior portion.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "putamen";
               rdfs:subClassOf uberon:0000477.
uberon:0001913 iao:0000111 "milk";
               iao:0000115 "An emulsion of fat globules within a fluid that is secreted by the mammary gland during lactation.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "milk";
               rdfs:subClassOf uberon:0000463.
uberon:0001970 iao:0000111 "bile";
               iao:0000115 "vital aqueous secretion of the liver that is formed by hepatocytes and modified down stream by absorptive and secretory properties of the bile duct epithelium.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "bile";
               rdfs:subClassOf uberon:0000463.
uberon:0001987 iao:0000111 "placenta";
               iao:0000115 "organ of metabolic interchange between fetus and mother, partly of embryonic origin and partly of maternal origin[GO]. The fetal portion of the placenta is known as the villous chorion. The maternal portion is known as the decidua basalis. The two portions are held together by anchoring villi that are anchored to the decidua basalis by the cytotrophoblastic shell.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "placenta";
               rdfs:subClassOf uberon:0000465.
uberon:0001988 iao:0000111 "feces";
               iao:0000115 "Portion of semisolid bodily waste discharged through the anus[MW,modified]";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "feces";
               rdfs:subClassOf uberon:0000463.
uberon:0002032 iao:0000111 "areola";
               iao:0000115 "Subdivision of breast which consists of skin, connective tissue and smooth muscle bundle and modified sebaceous glands and which surrounds the nipple.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "areola";
               rdfs:subClassOf uberon:0000465.
uberon:0002037 iao:0000111 "cerebellum";
               iao:0000115 "Part of the metencephalon that lies in the posterior cranial fossa behind the brain stem. It is concerned with the coordination of movement[MESH]. A large dorsally projecting part of the brain concerned especially with the coordination of muscles and the maintenance of bodily equilibrium, situated between the brain stem and the back of the cerebrum , and formed in humans of two lateral lobes and a median lobe[BTO]. Brain structure derived from the anterior hindbrain, and perhaps including posterior midbrain. The cerebellum plays a role in somatic motor function, the control of muscle tone, and balance[ZFA].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "cerebellum";
               rdfs:subClassOf uberon:0000481.
uberon:0002046 iao:0000111 "thyroid gland";
               iao:0000115 "A two-lobed endocrine gland found in all vertebrates, located in front of and on either side of the trachea in humans, and producing various hormones, such as triiodothyronine and calcitonin[BTO].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "thyroid gland";
               rdfs:subClassOf uberon:0000465.
uberon:0002048 iao:0000111 "lung";
               iao:0000115 "Respiration organ that develops as an oupocketing of the esophagus.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "lung";
               rdfs:subClassOf uberon:0000465.
uberon:0002067 iao:0000111 "dermis";
               iao:0000115 "The dermis is a layer of skin between the epidermis (with which it makes up the skin) and subcutaneous tissues, and is composed of two layers, the papillary and reticular dermis[WP].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "dermis";
               rdfs:subClassOf uberon:0000465.
uberon:0002072 iao:0000111 "hypodermis";
               iao:0000115 "Lowermost layer of the integumentary system in vertebrates. Types of cells that are found in the hypodermis are fibroblasts, adipose cells, and macrophages. It is derived from the mesoderm, but unlike the dermis, it is not derived from the dermatome region of the mesoderm. The hypodermis is used mainly for fat storage[WP].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "hypodermis";
               rdfs:subClassOf uberon:0000465.
uberon:0002097 iao:0000111 "skin of body";
               iao:0000115 "The organ covering the body that consists of the dermis and epidermis.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "skin of body";
               rdfs:subClassOf uberon:0000465.
uberon:0002106 iao:0000111 "spleen";
               iao:0000115 "the organ that functions to filter blood and to store red corpuscles and platelets";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "spleen";
               rdfs:subClassOf uberon:0000465.
uberon:0002107 iao:0000111 "liver";
               iao:0000115 "An exocrine gland which secretes bile and functions in metabolism of protein and carbohydrate and fat, synthesizes substances involved in the clotting of the blood, synthesizes vitamin A, detoxifies poisonous substances, stores glycogen, and breaks down worn-out erythrocytes[GO].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "liver";
               rdfs:subClassOf uberon:0000465.
uberon:0002116 iao:0000111 "ileum";
               iao:0000115 "the portion of the small intestine that extends from the jejunum to the colon";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "ileum";
               rdfs:subClassOf uberon:0000465.
uberon:0002358 iao:0000111 "peritoneum";
               iao:0000115 "A serous membrane that lines the peritoneal cavity[VHOG,modified].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "peritoneum";
               rdfs:subClassOf uberon:0000481.
uberon:0002367 iao:0000111 "prostate gland";
               iao:0000115 "The prostate gland is a partly muscular, partly glandular body that is situated near the base of the mammalian male urethra and secretes an alkaline viscid fluid which is a major constituent of the ejaculatory fluid.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "prostate gland";
               rdfs:subClassOf uberon:0000465.
uberon:0002369 iao:0000111 "adrenal gland";
               iao:0000115 "Either of a pair of complex endocrine organs near the anterior medial border of the kidney consisting of a mesodermal cortex that produces glucocorticoid, mineralocorticoid, and androgenic hormones and an ectodermal medulla that produces epinephrine and norepinephrine[BTO].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "adrenal gland";
               rdfs:subClassOf uberon:0000465.
uberon:0002371 iao:0000111 "bone marrow";
               iao:0000115 "the soft tissue that fills the cavities of bones";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "bone marrow";
               rdfs:subClassOf uberon:0000479.
uberon:0002409 iao:0000111 "pericardial fluid";
               iao:0000115 "Transudate contained in the pericardial cavity.[FMA]";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "pericardial fluid";
               rdfs:subClassOf uberon:0000463.
uberon:0002469 iao:0000111 "esophagus mucosa";
               iao:0000115 "A mucosa that is part of a esophagus [Automatically generated definition].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "esophagus mucosa";
               rdfs:subClassOf uberon:0000465.
uberon:0002812 iao:0000111 "left cerebral hemisphere";
               iao:0000115 "A cerebral hemisphere that is in the left side of a brain.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "left cerebral hemisphere";
               rdfs:subClassOf uberon:0000465.
uberon:0002813 iao:0000111 "right cerebral hemisphere";
               iao:0000115 "A cerebral hemisphere that is in the right side of a brain.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "right cerebral hemisphere";
               rdfs:subClassOf uberon:0000465.
uberon:0003688 iao:0000111 "omentum";
               iao:0000115 "A fold of peritoneum originating at the stomach and supporting the viscera.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "omentum";
               rdfs:subClassOf uberon:0000465.
uberon:0004648 iao:0000111 "esophagus muscularis mucosa";
               iao:0000115 "A muscularis mucosa that is part of a esophagus.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "esophagus muscularis mucosa";
               rdfs:subClassOf uberon:0000479.
uberon:0005022 iao:0000111 "mucosa of nasopharynx";
               iao:0000115 "A mucosa that is part of a nasopharynx [Automatically generated definition].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "mucosa of nasopharynx";
               rdfs:subClassOf uberon:0000465.
uberon:0005023 iao:0000111 "mucosa of oropharynx";
               iao:0000115 "A mucosa that is part of a oropharynx [Automatically generated definition].";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "mucosa of oropharynx";
               rdfs:subClassOf uberon:0000465.
uberon:0006618 iao:0000111 "atrium auricular region";
               iao:0000115 "A small conical pouch projections located on the upper anterior portion of each atrium of the heart.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "atrium auricular region";
               rdfs:subClassOf uberon:0000481.
uberon:0006911 iao:0000111 "digestive system secreted substance";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "digestive system secreted substance";
               rdfs:subClassOf uberon:0000463.
uberon:0007311 iao:0000111 "sputum";
               iao:0000115 "Matter ejected from the lungs, bronchi, and trachea, through the mouth.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "sputum";
               rdfs:subClassOf uberon:0000463.
uberon:0007610 iao:0000111 "tibial artery";
               iao:0000115 "The anterior and posterior arteries created at the bifurcation of the popliteal artery. The anterior tibial artery begins at the lower border of the popliteus muscle and lies along the tibia at the distal part of the leg to surface superficially anterior to the ankle joint. Its branches are distributed throughout the leg, ankle, and pes. The posterior tibial artery begins at the lower border of the popliteus muscle, lies behind the tibia in the lower part of its course, and is found situated between the medial malleolus and the medial process of the calcaneal tuberosity. Its branches are distributed throughout the leg and foot.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "tibial artery";
               rdfs:subClassOf uberon:0000465.
uberon:0007650 iao:0000111 "esophagogastric junction";
               iao:0000115 "The junction between the esophagus and the stomach epithelium";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "esophagogastric junction";
               rdfs:subClassOf uberon:0000465.
uberon:0036149 iao:0000111 "suprapubic skin";
               iao:0000115 "Area of skin in the hypoastric region of the abdomen.";
               iao:0000412 pobo:uberon.owl;
               a owl:Class;
               rdfs:label "suprapubic skin";
               rdfs:subClassOf uberon:0000465.
uo:0000001 iao:0000111 "length unit";
           iao:0000115 "A unit which is a standard measure of the distance between two points.";
           iao:0000412 pobo:uo.owl;
           a owl:Class;
           rdfs:label "length unit";
           rdfs:subClassOf iao:0000003.
uo:0000002 iao:0000111 "mass unit";
           iao:0000115 "A unit which is a standard measure of the amount of matter/energy of a physical object.";
           iao:0000412 pobo:uo.owl;
           a owl:Class;
           rdfs:label "mass unit";
           rdfs:subClassOf iao:0000003.
uo:0000003 iao:0000111 "time unit";
           iao:0000115 "A unit which is a standard measure of the dimension in which events occur in sequence.";
           iao:0000412 pobo:uo.owl;
           a owl:Class;
           rdfs:label "time unit";
           rdfs:subClassOf iao:0000003.
uo:0000005 iao:0000111 "temperature unit";
           iao:0000115 "A unit which is a standard measure of the average kinetic energy of the particles in a sample of matter.";
           iao:0000412 pobo:uo.owl;
           a owl:Class;
           rdfs:label "temperature unit";
           rdfs:subClassOf iao:0000003.
uo:0000006 iao:0000111 "substance unit";
           iao:0000115 "A unit which is a standardised quantity of an element or compound with uniform composition.";
           iao:0000412 pobo:uo.owl;
           a owl:Class;
           rdfs:label "substance unit";
           rdfs:subClassOf iao:0000003.
uo:0000008 iao:0000111 "meter";
           iao:0000115 "A length unit which is equal to the length of the path traveled by light in vacuum during a time interval of 1/299 792 458 of a second.";
           iao:0000118 "m";
           iao:0000412 pobo:uo.owl;
