                             a owl:Restriction].
obi:1110085 iao:0000111 "antigen presentation function";
            iao:0000114 iao:0000120;
            iao:0000115 "a function inhering in a cell  that expresses MHC molecules which is realized in the process of antigen processing and presentation of antigen derived parts by MHC molecules on the cell surface."@en;
            iao:0000117 "IEDB"@en;
