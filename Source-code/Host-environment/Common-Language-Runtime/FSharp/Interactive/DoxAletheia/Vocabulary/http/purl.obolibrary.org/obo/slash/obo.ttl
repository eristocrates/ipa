                             owl:onProperty pobo:RO_0000056 ; 
                             a owl:Restriction],
                            pobo:PR_000000001.
obi:0000734 iao:0000111 "DNA sequencing by synthesis assay";
            iao:0000112 "Roche-454 pyrosequencing and Illumina (Solexa) sequencing use synthesis-based method for DNA sequencing";
            iao:0000114 iao:0000123;
            iao:0000115 "A DNA sequencing assay that relies on DNA polymerase activity to perform chain extension during the sequencing reaction step.";
            iao:0000117 "Philippe Rocca-Serra";
            iao:0000119 "url:https://www.illumina.com/technology/next-generation-sequencing/sequencing-technology.html";
            a owl:Class;
            rdfs:label "DNA sequencing by synthesis assay";
            rdfs:subClassOf [owl:someValuesFrom go:0042575 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction],
                            obi:0000626.
obi:0000735 iao:0000111 "NTP-2000";
            iao:0000114 iao:0000123;
            iao:0000115 "a material consisting of 14.5% protein, 8.5% fat and 9.5% fiber produced to feed rodents";
            iao:0000117 "Jennifer Fostel, Bjoern Peters";
