obi:0000204 iao:0000111 "nutrient role";
            iao:0000112 "Luria broth; vitamin A; A nutrient is a substance used in an organism's metabolism which must be taken in from the environment.  Wikipedia."@en;
            iao:0000114 iao:0000120;
            iao:0000115 "a role that inheres in a material entity and is realized in the use of that material entity by an organism when it is used in that organism's metabolism and provides nourishment."@en;
            iao:0000117 "GROUP:  Role branch"@en;
            iao:0000118 "nutrient";
            iao:0000119 "Wikipedia, feb 29, 2008"@en;
            iao:0000232 "19 Feb 2009; old def: A nutrient role is a role played by a substance used in an organism's metabolism which is taken in from the environment and provides nourishment.";
