obi:0000664 iao:0000111 "BrdU incorporation assay";
            iao:0000112 "The measurement of T cell proliferation as a response to a viral peptide by culturing T cells stimulated with APCs and peptide in the presence of BrdU.";
            iao:0000114 iao:0000120;
            iao:0000115 "A cell proliferation assay in which cells are cultured in the presence of BrdU which is incorporated into newly synthesized DNA of replicating cells (during the S phase of the cell cycle), substituting for thymidine during DNA replication, which can be quantified by BrdU specific antibodies.";
            iao:0000117 "IEDB";
            iao:0000119 "IEDB";
            a owl:Class;
            rdfs:label "BrdU incorporation assay";
            rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom [owl:intersectionOf (pobo:REO_0000171
