obi:0000749 iao:0000111 "CART"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "A CART (classification and regression trees) is a data transformation method for producing a classification or regression model with a tree-based structure."@en;
            iao:0000117 "James Malone"@en;
            iao:0000118 "classification and regression trees";
            iao:0000119 "BOOK: David J. Hand, Heikki Mannila and Padhraic Smyth (2001) Principles of Data Mining."@en;
