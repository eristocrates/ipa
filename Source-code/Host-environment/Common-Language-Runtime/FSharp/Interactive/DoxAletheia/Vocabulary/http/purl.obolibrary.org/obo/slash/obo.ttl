            rdfs:subClassOf [owl:someValuesFrom obi:0000456 ; 
                             owl:onProperty obi:0000417 ; 
                             a owl:Restriction],
                            obi:0000094.
obi:0302903 iao:0000111 "nucleic acid hybridization";
            iao:0000112 "PMID: 18555787.Quantitative analysis of DNA hybridization in a flowthrough microarray for molecular testing. Anal Biochem. 2008 May 27."@en;
            iao:0000114 iao:0000120;
            iao:0000115 "a planned process by which totally or partially complementary, single-stranded nucleic acids are  combined into a single molecule called heteroduplex or homoduplex to an extent depending on the amount of complementarity."@en;
            iao:0000117 "Philippe Rocca-Serra";
            iao:0000119 "adapted from wikipedia [http://en.wikipedia.org/wiki/Nucleic_acid_hybridization]";
            obi:0001847 "hybridization assay";
            a owl:Class;
            rdfs:label "nucleic acid hybridization"@en;
