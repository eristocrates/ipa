go:0048869 iao:0000111 "cellular developmental process";
           iao:0000115 "A biological process whose specific outcome is the progression of a cell over time from an initial condition to a later condition.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "cellular developmental process";
           rdfs:subClassOf go:0008150.
go:0050896 iao:0000111 "response to stimulus";
           iao:0000115 "Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a stimulus. The process begins with detection of the stimulus and ends with a change in state or activity or the cell or organism.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "response to stimulus";
           rdfs:subClassOf go:0008150.
go:0051276 iao:0000111 "chromosome organization";
           iao:0000115 "A process that is carried out at the cellular level that results in the assembly, arrangement of constituent parts, or disassembly of chromosomes, structures composed of a very long molecule of DNA and associated proteins that carries hereditary information. This term covers covalent modifications at the molecular level as well as spatial relationships among the major components of a chromosome.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "chromosome organization";
           rdfs:subClassOf go:0008150.
go:0070358 iao:0000111 "actin polymerization-dependent cell motility";
           iao:0000115 "A process involved in the controlled movement of a bacterial cell powered by the continuous polymerization of actin at one pole of the cell.";
           iao:0000412 pobo:go.owl;
           a owl:Class;
           rdfs:label "actin polymerization-dependent cell motility";
           rdfs:subClassOf go:0008150.
go:0071604 iao:0000111 "transforming growth factor beta production";
