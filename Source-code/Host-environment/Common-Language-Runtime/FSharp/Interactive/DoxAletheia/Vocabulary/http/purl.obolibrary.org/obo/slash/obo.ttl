obi:0001144 iao:0000111 "binding constant"@en;
            iao:0000112 """The predicted or measured binding affinity of a peptide to a MHC molecule can be captured in the binding constants \"IC50 = 12 nM\" or \"t 1/2 = 30 minutes\". """@en;
            iao:0000114 iao:0000123;
            iao:0000115 "A binding datum about the disposition of two or more material entities to form complexes which comes in the form of a scalar and unit that are utilized in equations that model the binding process"@en;
            iao:0000116 "10/6/11 BP: The distinction between binding datum and binding constant is based on the later being part of an equation. That should be captured in the logical definition here, and used to make it to a defined class. ";
            iao:0000117 "PERSON: Bjoern Peters, Randi Vita, Jason Greenbaum"@en;
            a owl:Class;
            rdfs:label "binding constant"@en;
            rdfs:subClassOf obi:0001181;
            owl:equivalentClass [owl:unionOf (obi:0001536
                                              obi:0001548
                                              obi:0001571
                                              obi:0001581
                                              obi:0001583
                                              obi:0001603
                                              obi:0001605) ; 
                                 a owl:Class].
obi:0001145 iao:0000111 "3D structure determination of bound complex assay";
            iao:0000112 "Determination of a 3D structure of an antibody binding a protein by X-Ray crystallography, which identifies the specific binding site of the antibody.";
            iao:0000114 iao:0000120;
            iao:0000115 "A 3D structure determination assay in which a complex of 2 or more material enties is characterized which provides information on their binding configuration.";
            iao:0000117 "IEDB";
            iao:0000119 "IEDB";
            a owl:Class;
            rdfs:label "3D structure determination of bound complex assay";
            rdfs:subClassOf obi:0600045;
