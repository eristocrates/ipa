iao:0000114 iao:0000111 "has curation status"@en;
            iao:0000117 "PERSON:Melanie Courtot"@en,
                        "PERSON:Bill Bug"@en,
                        "PERSON:Alan Ruttenberg"@en;
            iao:0000119 "OBI_0000281"@en;
            a owl:AnnotationProperty;
