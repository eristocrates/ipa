obi:0400137 iao:0000111 "cytometer"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "A cytometer is an instrument for counting and measuring cells."@en;
            iao:0000117 "Melanie Courtot"@en;
            iao:0000119 "http://medical.merriam-webster.com/medical/cytometer"@en;
            a owl:Class;
            rdfs:label "cytometer"@en;
