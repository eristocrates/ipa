                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction].
obi:0000819 iao:0000111 "anticoagulant tube storage of blood specimen";
            iao:0000114 iao:0000120;
            iao:0000115 "Storage of a blood specimen in a tube with anticoagulant";
            iao:0000117 "Person:Alan Ruttenberg";
            iao:0000232 "2009/09/28 Alan Ruttenberg. Fucoidan-use-case";
