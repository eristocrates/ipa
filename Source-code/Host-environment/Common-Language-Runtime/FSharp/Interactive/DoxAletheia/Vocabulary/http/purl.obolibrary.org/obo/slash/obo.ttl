obi:0000799 iao:0000111 "recombinant phage cloning";
            iao:0000112 "Insert selection by BamHI methyltransferase protection in P1 phage-based cloning";
            iao:0000114 iao:0000120;
            iao:0000115 "Recombinant phage cloning is the process of using a phage plus some insert nucleic acid for the purposes of amplification of the insert material achieved by phage assembly in vitro.";
            iao:0000117 "Helen Parkinson";
            iao:0000119 "http://www.ncbi.nlm.nih.gov/books/bv.fcgi?rid=mcb.section.1611";
            a owl:Class;
            rdfs:label "recombinant phage cloning";
            rdfs:subClassOf obi:0600064.
