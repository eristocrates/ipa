obi:0000544 iao:0000111 "Bruker SampleRail system"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "This Instrument system automatically prepares an NMR sample, inserts it into an NMR magnet, performs NMR experiments on the sample, and transports it back to the preparation system.   The SampleRail fulfills the transporting tasks from the preparation system into the NMR magnet and back."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "WEB:<http://www.bruker-biospin.com/automation.html>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400207";
