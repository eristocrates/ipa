obi:0400157 iao:0000111 "oil bath"@en;
            iao:0000112 "An oil bath was used to allow for fast reaction of two chemical compounds during a 2 hour period."@en;
            iao:0000114 iao:0000120;
            iao:0000115 "An oil bath is a temperature control bath in which oil acts as contact medium for the temperature transfer (from heating or cooling elements to the sample)."@en;
            iao:0000117 "Daniel Schober";
            iao:0000119 "PERSON: Daniel Schober";
            a owl:Class;
            rdfs:label "oil bath"@en;
            rdfs:subClassOf obi:0400120.
obi:0400158 iao:0000111 "digital-to-analog converter"@en;
            iao:0000112 "A digital-to-analog_converter is used to convert a computergenerated discrete signal into a continuous analog one, e.g. a sound."@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A digital-to-analog_converter is an instrument that converts a finite resolution digital signal into an infinite resolution analog signal."@en;
            iao:0000117 "Daniel Schober";
            iao:0000119 "PERSON: Daniel Schober";
            a owl:Class;
            rdfs:label "digital-to-analog converter"@en;
