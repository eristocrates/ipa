            iao:0000114 iao:0000120;
            iao:0000115 "Notified body is regulator of consumables and medical devices charged by the Competent Authority with verifying compliance of medical devices (not drugs) with the applicable Essential Requirements stated in the Medical Device Directive"@en;
            iao:0000116 "Notified Body (NB). A private institution charged by the Competent Authority with verifying compliance of medical devices (not drugs) with the applicable Essential Requirements stated in the Medical Device Directive. This process, called Conformity Assessment, has EU-wide validity once completed by the NB."@en;
            iao:0000117 "Person: Jennifer Fostel"@en;
            iao:0000118 "notified body";
            iao:0000119 "OBI, CDISC"@en;
            a owl:Class;
            rdfs:label "notified body role"@en;
            rdfs:subClassOf obi:0000273.
