            iao:0000114 iao:0000120;
            iao:0000115 "A study design for which material and information is collected from subjects that have already developed a particular disease.";
            iao:0000117 "MIABIS";
            iao:0000119 "MIABIS contributors";
            a owl:Class;
            rdfs:label "disease specific study design";
            rdfs:subClassOf obi:0500000.
