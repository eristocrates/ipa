                                                                     a owl:Class] ; 
                                                 owl:onProperty pobo:BFO_0000055 ; 
                                                 a owl:Restriction]
                                                 [owl:someValuesFrom go:0042571 ; 
                                                 owl:onProperty obi:0000293 ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class].
obi:0600032 iao:0000111 "artificially induced DNA repair"@en;
            iao:0000112 "the use of DNA repair enzymes uracil DNA glycosylase and 3-methyladenine DNA glycosylase to repair DNA strands"@en;
            iao:0000114 iao:0000125;
            iao:0000115 "a protocol application to repair damaged DNA molecules"@en;
            iao:0000117 "PlanAndPlannedProcess Branch"@en;
            iao:0000119 "OBI branch derived"@en;
            iao:0000232 "---\\nis this really a protocol?\\n--> This as several other protocol applications is also a natural process. The fact that it is induced experimetnally by following a protocol makes it a protocol application. Need to make sure that labels don't conflict wi"@en;
            a owl:Class;
