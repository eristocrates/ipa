obi:0000678 iao:0000111 "portioning objective";
            iao:0000112 "The objective to obtain multiple aliquots of an enzyme preparation.";
            iao:0000114 iao:0000123;
            iao:0000115 "A material separation objective aiming to separate material into multiple portions, each of which contains a similar composition of the input material.";
            a owl:Class;
            rdfs:label "portioning objective";
            rdfs:subClassOf obi:0000639;
            owl:disjointWith obi:0000681.
obi:0000679 iao:0000111 "average value";
