pobo:RO_0000052 iao:0000111 "inheres in"@en;
                iao:0000112 "this red color inheres in this apple"@en,
                            "this fragility inheres in this vase"@en;
                iao:0000115 "a relation between a specifically dependent continuant (the dependent) and an independent continuant (the bearer), in which the dependent specifically depends on the bearer for its existence"@en;
                iao:0000116 "A dependent inheres in its bearer at all times for which the dependent exists."@en;
                iao:0000118 "inheres_in"@en;
                pobo:RO_0001900 pobo:RO_0001901;
                a owl:ObjectProperty;
                rdfs:label "inheres in"@en;
                owl:equivalentProperty [owl:inverseOf pobo:RO_0000053];
                owl:inverseOf pobo:RO_0000053.
pobo:RO_0000053 iao:0000111 "bearer of"@en;
                iao:0000112 "this apple is bearer of this red color"@en,
                            "this vase is bearer of this fragility"@en;
                iao:0000115 "a relation between an independent continuant (the bearer) and a specifically dependent continuant (the dependent), in which the dependent specifically depends on the bearer for its existence"@en;
                iao:0000116 "A bearer can have many dependents, and its dependents can exist for different periods of time, but none of its dependents can exist when the bearer does not exist."@en;
                iao:0000118 "is bearer of"@en,
                            "bearer_of"@en;
                pobo:RO_0001900 pobo:RO_0001901;
                a owl:ObjectProperty;
                rdfs:label "bearer of"@en;
                rdfs:range pobo:BFO_0000020;
                owl:equivalentProperty [owl:inverseOf pobo:RO_0000052].
