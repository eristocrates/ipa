obi:0000543 iao:0000111 "syringe filter"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A small membrane filter of defined pore size, that filters samples from a syringe."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01122",
