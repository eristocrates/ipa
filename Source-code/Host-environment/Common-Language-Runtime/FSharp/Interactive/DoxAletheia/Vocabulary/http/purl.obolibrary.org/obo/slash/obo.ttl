obi:0600022 iao:0000111 "excision"@en;
            iao:0000112 "Cutting out the portion of a gel which contains a DNA fragment"@en;
            iao:0000114 iao:0000125;
            iao:0000115 "the use physical means to remove a portion of a substance from the rest"@en;
            iao:0000117 "Alan Ruttenberg, Kevin Clancy"@en;
            iao:0000119 "www.crohnsresource.com/glossary.jsp (via google define:resection)"@en;
