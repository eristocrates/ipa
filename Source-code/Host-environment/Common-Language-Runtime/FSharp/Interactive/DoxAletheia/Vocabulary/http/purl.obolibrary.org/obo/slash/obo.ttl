            a owl:Class;
            rdfs:label "dendrogram"@en;
            rdfs:subClassOf iao:0000038.
iao:0000184 iao:0000111 "scatter plot"@en;
            iao:0000112 "Comparison of gene expression values in two samples can be displayed in a scatter plot"@en;
            iao:0000114 iao:0000122;
            iao:0000115 "A scatterplot is a graph which uses Cartesian coordinates to display values for two variables for a set of data. The data is displayed as a collection of points, each having the value of one variable determining the position on the horizontal axis and the value of the other variable determining the position on the vertical axis."@en;
            iao:0000117 "PERSON:James Malone"@en,
                        "PERSON:Melanie Courtot"@en,
                        "PERSON:Chris Stoeckert"@en;
            iao:0000118 "scattergraph"@en;
            iao:0000119 "WEB: http://en.wikipedia.org/wiki/Scatterplot"@en;
            a owl:Class;
            rdfs:label "scatter plot"@en;
            rdfs:subClassOf iao:0000038.
iao:0000185 iao:0000114 iao:0000122;
            iao:0000115 "A photograph is created by projecting an image onto a photosensitive surface such as a chemically treated plate or film, CCD receptor, etc."@en;
            iao:0000117 "PERSON:Melanie Courtot"@en,
                        "PERSON:Joanne Luciano"@en,
                        "PERSON:Alan Ruttenberg"@en;
            iao:0000119 "WEB: http://en.wiktionary.org/wiki/photograph"@en;
            a owl:Class;
            rdfs:label "photograph"@en;
            rdfs:subClassOf iao:0000101.
iao:0000186 iao:0000111 "photographic print"@en;
            iao:0000114 iao:0000125;
            iao:0000115 "A photographic print is a material entity upon which a photograph generically depends."@en;
            iao:0000117 "PERSON:Melanie Courtot"@en,
                        "PERSON:Alan Ruttenberg"@en;
            a owl:Class;
            rdfs:label "photographic print"@en;
            rdfs:subClassOf iao:0000178;
            owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000040
