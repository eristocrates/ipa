obi:0600024 iao:0000111 "maintaining cell culture"@en;
            iao:0000112 "When harvesting blood from a human, isolating T cells, and then limited dilution cloning of the cells, the maintaining_cell_culture step comprises all steps after the initial dilution and plating of the cells into culture, e.g. placing the culture into an incubator, changing or adding media, and splitting a cell culture"@en;
            iao:0000114 iao:0000125;
            iao:0000115 "a protocol application in which cells are kept alive in a defined environment outside of an organism.  part of cell_culturing"@en;
            iao:0000117 "PlanAndPlannedProcess Branch"@en;
            iao:0000119 "OBI branch derived"@en;
            a owl:Class;
            rdfs:label "maintaining cell culture"@en;
            rdfs:subClassOf [owl:someValuesFrom obi:0000806 ; 
                             owl:onProperty obi:0000417 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom obi:0100060 ; 
