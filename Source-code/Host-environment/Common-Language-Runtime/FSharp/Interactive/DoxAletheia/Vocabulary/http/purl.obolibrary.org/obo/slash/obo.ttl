                                                     a owl:Restriction]) ; 
                                 a owl:Class].
obi:0000738 iao:0000111 "restriction enzyme based cloning";
            iao:0000114 iao:0000123;
            iao:0000115 "restriction enzyme based cloning is a recombinant vector cloning process that has as an input genetic material that was cleaved with restriction enzymes, and a cloning vector that was cleaved with complementary restriction enzymes. It uses ligase to chemically join the input genetic material and the cloning vector to create a recombinant vector.";
            iao:0000117 "Kevin Clancy, Bjoern Peters";
            a owl:Class;
            rdfs:label "restriction enzyme based cloning";
