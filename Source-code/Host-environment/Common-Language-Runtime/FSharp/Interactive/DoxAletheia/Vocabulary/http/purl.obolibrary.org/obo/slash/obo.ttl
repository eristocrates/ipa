                             owl:onProperty pobo:RO_0000085 ; 
                             a owl:Restriction],
                            obi:0000968.
obi:0000545 iao:0000111 "column compartment"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "For chromatography analyses, the ability to maintain a stable column environment regardless of ambient temperature fluctuations is critical for maintaining retention time precision. In order to ensure such stable conditions at different chromatography steps a column compartment can be installed that ensures e.g. stable temperature of the column in a given step."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01068",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "column compartment"@en;
            rdfs:subClassOf obi:0000048.
obi:0000546 iao:0000111 "capillary pump system"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A pump system optimized for capillary chromatography."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01051",
                        "GROUP:<http://msi-ontology.sourceforge.net>"@en;
            a owl:Class;
            rdfs:label "capillary pump system"@en;
            rdfs:subClassOf obi:0000589.
obi:0000547 iao:0000111 "evaporative light scattering detector"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "The evaporative light scattering detector, as its name implies, utilizes a spray that continuously atomizes the column eluent into small droplets. These droplets are allowed to evaporate, leaving the solutes as fine particulate matter suspended in the atomizing gas."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "WEB:<http://www.chromatography-online.org/HPLC-Detectors/Evaporative-Light-Scattering/rs73.html>"@en,
                        "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01082";
            a owl:Class;
            rdfs:label "evaporative light scattering detector"@en;
            rdfs:subClassOf [owl:someValuesFrom obi:0000453 ; 
                             owl:onProperty pobo:RO_0000085 ; 
                             a owl:Restriction],
                            obi:0000832.
obi:0000548 iao:0000111 "isolation of PBMCs";
            iao:0000112 "cells are extracted from whole blood using ficoll, a hydrophilic polysaccharide that separates layers of blood, with monocytes and lymphocytes forming a buffy coat under a layer of plasma. This buffy coat contains the PBMCs.";
            iao:0000114 iao:0000120;
            iao:0000115 "a process in which cells with a single nucleus are isolated from a blood sample";
            iao:0000117 "PERSON: bjoern peters";
            iao:0000119 "wiki http://en.wikipedia.org/wiki/PBMC";
            a owl:Class;
            rdfs:label "isolation of PBMCs";
            rdfs:subClassOf [owl:someValuesFrom obi:0100060 ; 
                             owl:onProperty obi:0000299 ; 
                             a owl:Restriction],
                            [owl:someValuesFrom obi:0000681 ; 
                             owl:onProperty obi:0000417 ; 
                             a owl:Restriction],
                            obi:0000512,
                            [owl:someValuesFrom uberon:0000178 ; 
                             owl:onProperty obi:0000293 ; 
                             a owl:Restriction].
obi:0000549 iao:0000111 "column cartridger"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "A chromatography device where the column cartridge is inserted into and stabilised."@en;
            iao:0000117 "PERSON:Daniel Schober"@en;
            iao:0000119 "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01054",
