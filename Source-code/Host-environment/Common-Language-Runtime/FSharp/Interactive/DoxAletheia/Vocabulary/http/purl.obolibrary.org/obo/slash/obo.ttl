obi:0600034 iao:0000111 "precipitation"@en;
            iao:0000112 "The use of ethanol to precipitate DNA molecules from a solution containing DNA"@en;
            iao:0000114 iao:0000125;
            iao:0000115 "a protocol application to cause a material to precipitate (becoming a solid) out of solution. Input is a solution, output is a solution plus a solid component (the precipitate)"@en;
            iao:0000117 "PERSON:Kevin Clancy"@en;
