obi:0001480 iao:0000111 "phage display library panning";
            iao:0000112 "Screening a libray of M13 phages displaying random peptide sequences for binding to the MHC molecule HLA-A*02:02 resulting in a subset of phages that encode peptides that bind. ";
            iao:0000114 iao:0000120;
            iao:0000115 """Phage display library panning is a process in which a diverse collection of phages encoding peptides or proteins are screened and the ones encoding active peptides/proteins are selected in an iterative process similar to natural selection.
""";
            iao:0000117 "Jason Greenbaum, Randi Vita, Bjoern Peters";
            iao:0000119 "IEDB, http://en.wikipedia.org/wiki/Phage_display";
