obi:0002106 iao:0000111 "carboxyfluorescein succinimidyl ester staining assay";
            iao:0000112 "Measuring T cell proliferation based on the progressive halving of CFSE fluorescence within daughter cells following each cell division.";
            iao:0000114 iao:0000120;
