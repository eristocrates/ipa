obi:0000169 iao:0000111 "placebo role";
            iao:0000112 "Pill consisting of inert materials"@en;
            iao:0000114 iao:0000120;
            iao:0000115 "a negative reference substance is a reference role in which the substance playing the reference substance role is physically similar in appearance to the test substance";
            iao:0000117 "Person:Jennifer Fostel"@en;
            iao:0000118 "placebo";
            iao:0000232 "CDISC definition placebo. A pharmaceutical preparation that does not contain the investigational agent. In blinded studies, it is generally prepared to be physically indistinguishable from the preparation containing the investigational product."@en;
            a owl:Class;
            rdfs:label "placebo role"@en;
