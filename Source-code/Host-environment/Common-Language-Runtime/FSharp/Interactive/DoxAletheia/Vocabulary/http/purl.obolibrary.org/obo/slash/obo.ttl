obi:0000034 iao:0000111 "supernatant role";
            iao:0000112 "Precipitation is the formation of a solid in a solution during a chemical reaction. When the reaction occurs, the solid formed is called the precipitate, and the liquid remaining above the solid is called the supernate.  Wikipedia";
            iao:0000114 iao:0000120;
            iao:0000115 "supernatant role is a role which inheres in a material entity and is realized by a material separation process using gravitational force in which the material bearing the supernatant role is the liquid component of the output material.";
            iao:0000117 "GROUP: Role branch";
            iao:0000119 "OBI";
            a owl:Class;
