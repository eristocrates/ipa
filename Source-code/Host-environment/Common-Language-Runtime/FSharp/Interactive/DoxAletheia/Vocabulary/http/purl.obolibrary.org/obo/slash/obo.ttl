obi:0000801 iao:0000111 "spike train datum";
            iao:0000112 "Measurement of temporal regularity of spike train responses in auditory nerve fibers of the green treefrog";
            iao:0000114 iao:0000120;
            iao:0000115 "A measurement datum which represents information about an ordered series of action potentials in an organism's CNS measured over time.";
            iao:0000116 "needs more work to see exactly what the data set looks like - HP";
            iao:0000117 "Helen Parkinson, Alan Ruttenberg";
            iao:0000118 "spike train measurement";
            iao:0000119 "Jessica Turner, NIF";
            a owl:Class;
            rdfs:label "spike train datum";
