type Lexical_Form =
    {

      string_value: string
      form_id: byte array

     }

module Lexical_Form =
    let from_string (string_value: string) =
        let id_option = Database.Get.Form_ID_by_String string_value

        match id_option with
        | Some id ->
            { string_value = string_value
              form_id = id }
        | None ->
            Database.Put.Strings [| string_value |]

            { string_value = string_value
              form_id =
                Database.Get.Form_ID_by_String string_value
                |> Option.get }

type Term =
    {

      key: Persistent_Term
      term_id: byte array

     }

module Term =
    let from_term_key (term_key: Persistent_Term) =
        let id_option =
            Database.Get.Value_by_Memory_Map
                Memory_Map.Term_to_Term_ID
                (MessagePackSerializer.Serialize(term_key, message_pack_options))

        match id_option with
        | Some id -> { key = term_key; term_id = id }
        | None ->
            Database.Put.Term_Keys [| term_key |]

            { key = term_key
              term_id =
                Database.Get.Value_by_Memory_Map
                    Memory_Map.Term_to_Term_ID
                    (MessagePackSerializer.Serialize(term_key, message_pack_options))
                |> Option.get }


















