let StructureIds =
    LCPW_OverlayStormwaterInfrastructure_D_WM.json.Layers
    |> Array.Parallel.collect (fun layer ->
        layer.Features
        |> Array.Parallel.filter (fun feature ->
            feature.Attributes.StructureId.IsSome
            && not (String.IsNullOrWhiteSpace(feature.Attributes.StructureId.Value))
            && feature.Attributes.StructureId.Value <> "<Null>"

        )
        |> Array.Parallel.collect (fun feature ->
            let id = feature.Attributes.StructureId.Value
            // TODO be vigilant with how fragile this is!
            match id with
            | "P0068N1,2,3" -> [| "P0068N1"; "P0068N2"; "P0068N3" |]
            | "P0068N4,5,6" -> [| "P0068N4"; "P0068N5"; "P0068N6" |]
            | "P0095S1,S2,S3" -> [| "P0095S1"; "P0095S2"; "P0095S3" |]
            | _ when id.Contains "," -> id.Split([| "," |], StringSplitOptions.TrimEntries)
            | _ when id.Contains " " -> id.Split([| " " |], StringSplitOptions.TrimEntries)
            | _ when id.Contains "N/A" -> [| id.Replace("N/A", "") |]
            | _ -> [| id |]

        )


    )
    |> Array.distinct
    |> Array.filter (fun id ->
        id <> "&"
        && id <> "-"
        && not (String.IsNullOrWhiteSpace(id))

    )



