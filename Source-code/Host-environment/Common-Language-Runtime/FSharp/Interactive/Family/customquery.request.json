{
  "customQuery": {
    "requireAll": {
      "criteria": [
        {
          "nested": {
            "path": "locations",
            "score_mode": "max",
            "query": {
              "relevancyByDistance": {
                "field": "locations.address.search_coordinates",
                "origin": "27.0052532, -82.1500689",
                "scale": "300mi",
                "offset": "0mi",
                "decay": "0.5",
                "minDistanceScore": "0.1",
                "query": {
                  "requireAll": {
                    "criteria": [
                      {
                        "constantScore": {
                          "boost": 1,
                          "query": {
                            "nested": {
                              "path": "locations.eligibleForDisplay",
                              "query": {
                                "constantScore": {
                                  "boost": 1,
                                  "query": {
                                    "requireAll": {
                                      "criteria": [
                                        {
                                          "value": {
                                            "field": "locations.eligibleForDisplay.eligibleIndicator",
                                            "value": "Y"
                                          }
                                        },
                                        {
                                          "range": {
                                            "field": "locations.eligibleForDisplay.startDate",
                                            "type": "date",
                                            "lte": "2026-08-06"
                                          }
                                        },
                                        {
                                          "range": {
                                            "field": "locations.eligibleForDisplay.endDate",
                                            "type": "date",
                                            "gte": "2026-08-06"
                                          }
                                        }
                                      ]
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "matchedList": {
              "name": "testInnerHits",
              "restrictedMatchedList": "Y",
              "size": 50,
              "determineDistance": {
                "field": "locations.address.search_coordinates",
                "origin": "27.0052532, -82.1500689"
              },
              "fields": [
                "locations.locationId",
                "locations.address.addressLine1",
                "locations.address.state"
              ]
            }
          }
        },
        {
          "requireAll": {
            "criteria": [
              {
                "constantScore": {
                  "boost": 1,
                  "query": {
                    "values": {
                      "field": "network.product.networkId",
                      "values": [
                        "14069",
                        "70",
                        "7674"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
