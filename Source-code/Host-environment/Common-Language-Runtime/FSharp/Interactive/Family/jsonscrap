type JsonValue with 


    member this.array_properties = 
      this.Properties
      |> Array.filter( fun (key, json_value) -> json_value.IsArray)
      |> Array.map (fun (key,(JsonValue.Array json_array)) -> key, json_array)
    member this.string_array_properties = 
      this.array_properties
      |> Array.choose (fun (key,json_array) -> 

        let string_array = json_array |> Array.choose (fun json_value -> 
            if json_value.IsString then 
              Some (json_value.AsString())
            else None
            )
        if string_array.Length > 0 then 
          Some (key,string_array)
        else 
          None
      
      )
    member this.decimal_array_properties = 
      this.array_properties
      |> Array.choose (fun (key,json_array) -> 

        let decimal_array = json_array |> Array.choose (fun json_value -> 
            if json_value.IsNumber then 
              Some (json_value.AsDecimal())
            else None
            )
        if decimal_array.Length > 0 then 
          Some (key,decimal_array)
        else 
          None
      
      )

    member this.float_array_properties = 
      this.array_properties
      |> Array.choose (fun (key,json_array) -> 

        let float_array = json_array |> Array.choose (fun json_value -> 
            if json_value.IsFloat then 
              Some (json_value.AsFloat())
            else None
            )
        if float_array.Length > 0 then 
          Some (key,float_array)
        else 
          None
      
      )

    member this.boolean_array_properties = 
      this.array_properties
      |> Array.choose (fun (key,json_array) -> 

        let boolean_array = json_array |> Array.choose (fun json_value -> 
            if json_value.IsBoolean then 
              Some (json_value.AsBoolean())
            else None
            )
        if boolean_array.Length > 0 then 
          Some (key,boolean_array)
        else 
          None
      
      )

    member this.null_array_properties = 
      this.array_properties
      |> Array.choose (fun (key,json_array) -> 

        let null_array = json_array |> Array.choose (fun json_value -> 
            if json_value.IsNull then 
              Some (json_value.AsString())
            else None
            )
        if null_array.Length > 0 then 
          Some (key)
        else 
          None
      
      )
    member this.record_array_properties = 
      this.array_properties
      |> Array.choose (fun (key,json_array) -> 

        let record_array = json_array |> Array.choose (fun json_value -> 
            if json_value.IsRecord then 
              Some json_value
            else None
            )
        if record_array.Length > 0 then 
          Some (key,record_array)
        else 
          None
      
      )


    member this.emit_value (key:string) = 
      match this with 
        | JsonValue.String value -> Ast.Value(key, Ast.String(value))
        | JsonValue.Number value -> Ast.Value(key, Ast.Decimal(value))
        | JsonValue.Float value -> Ast.Value(key, Ast.Double(value))
        | JsonValue.Record value -> Ast.Value(key, "record")
        | JsonValue.Array value -> Ast.Value(key, "array")
        | JsonValue.Boolean value -> Ast.Value(key, Ast.Bool(value))
        | JsonValue.Null -> Ast.Value(key, "null")
    member this.clr_type = 
      match this with 
        | JsonValue.String value -> value.GetType()
        | JsonValue.Number value -> value.GetType()
        | JsonValue.Float value -> value.GetType()
        | JsonValue.Record value -> value.GetType()
        | JsonValue.Array value -> value.GetType()
        | JsonValue.Boolean value -> value.GetType()
        | JsonValue.Null -> typeof<obj>
    member this.fsharp_type_name = Literal.stringifyTypeDynamic this.clr_type
    member this.emit_field_definition (key:string)  = Ast.Field(key, this.fsharp_type_name)
    
    member this.emit_record_definition (key:string) = 
              Ast.Record(Converters.FirstCharToUpperCase key){
                  for property_key, (property_value: JsonValue) in this.datatype_properties do 
                    property_key |> property_value.emit_field_definition 
              }
    member this.emit_record_field (key:string) = 
      match this with 
        | JsonValue.String value -> Ast.RecordFieldExpr(key, Ast.String(value))
        | JsonValue.Number value -> Ast.RecordFieldExpr(key, Ast.Decimal(value))
        | JsonValue.Float value -> Ast.RecordFieldExpr(key, Ast.Double(value))
        | JsonValue.Record value -> Ast.RecordFieldExpr(key, "record")
        | JsonValue.Array value -> Ast.RecordFieldExpr(key, "array")
        | JsonValue.Boolean value -> Ast.RecordFieldExpr(key, Ast.Bool(value))
        | JsonValue.Null -> Ast.RecordFieldExpr(key, "null")
    member this.emit_record_expression (key:string) = 
          Ast.Value(key, Ast.RecordExpr([
                  for property_key, property_value in this.datatype_properties do 
                      property_key |> property_value.emit_record_field
            ])
          )

    member this.maybe_scalar = 
      match this with 
        | JsonValue.String value -> Some this
        | JsonValue.Number value -> Some this
        | JsonValue.Float value -> Some this
        | JsonValue.Record value -> None
        | JsonValue.Array value -> None
        | JsonValue.Boolean value -> Some this
        | JsonValue.Null -> None

    member this.datatype_properties = 
      
      this.Properties
      |> Array.choose( fun (key, json_value) -> 
        if json_value.maybe_scalar.IsSome then 
          Some (key,json_value.maybe_scalar.Value)
        else 
          None
      )
      
    member this.as_string = this.AsString()
    member this.keys = 
      this.Properties
      |> Array.map( fun (key, json_value) -> key)
    member this.string_properties = 
        this.Properties |> Array.choose (fun (key,json_value) ->
          match json_value with 
            | JsonValue.String value -> Some(key,value)
            | JsonValue.Number value -> None
            | JsonValue.Float value -> None
            | JsonValue.Record value -> None
            | JsonValue.Array values -> None
            | JsonValue.Boolean value -> None
            | JsonValue.Null -> None
        
        )

    member this.decimal_properties = 
      this.Properties
      |> Array.choose( fun (key, json_value) -> 
      match json_value with 
        | JsonValue.String value -> None
        | JsonValue.Number value -> Some(key,value)
        | JsonValue.Float value -> None
        | JsonValue.Record value -> None
        | JsonValue.Array value -> None
        | JsonValue.Boolean value -> None
        | JsonValue.Null -> None
      )
    member this.float_properties = 
      this.Properties
      |> Array.choose( fun (key, json_value) -> 
      match json_value with 
        | JsonValue.String value -> None
        | JsonValue.Number value -> None
        | JsonValue.Float value -> Some(key,value)
        | JsonValue.Record value -> None
        | JsonValue.Array value -> None
        | JsonValue.Boolean value -> None
        | JsonValue.Null -> None
      )
      
    member this.record_properties = 
      this.Properties
      |> Array.filter( fun (key, json_value) -> json_value.IsRecord)
    member this.record_properties_with_scalar_values = 
      this.record_properties
      |> Array.filter (fun (record_key,record_value) -> record_value.has_scalar_properties)
    member this.record_properties_with_nested_records = 
      this.record_properties
      |> Array.filter (fun (record_key,record_value) -> record_value.has_nested_records)
    member this.record_properties_with_nested_arrays = 
      this.record_properties
      |> Array.filter (fun (record_key,record_value) -> record_value.has_nested_arrays)
    member this.has_nested_non_scalar_properties = this.has_nested_arrays || this.has_nested_records
    member this.is_scalar_property_collection_record = not this.has_nested_non_scalar_properties
    member this.non_scalar_record_properties = 
      this.record_properties
      |> Array.choose (fun (record_key,record_value) -> 
          let non_scalar_properties = record_value.Properties |> Array.filter (fun (property_key,property_value) -> property_value.IsArray || property_value.IsRecord)
          if non_scalar_properties.Length > 0 then
              Some(record_key,JsonValue.Record non_scalar_properties)
          else 
              None
      )
    member this.boolean_properties = 
      this.Properties
      |> Array.choose( fun (key, json_value) -> 
      match json_value with 
        | JsonValue.String value -> None
        | JsonValue.Number value -> None
        | JsonValue.Float value -> None
        | JsonValue.Record value -> None
        | JsonValue.Array value -> None
        | JsonValue.Boolean value -> Some(key,value)
        | JsonValue.Null -> None
      )
    member this.null_properties = 
      this.Properties
      |> Array.choose( fun (key, json_value) -> 
      match json_value with 
        | JsonValue.String value -> None
        | JsonValue.Number value -> None
        | JsonValue.Float value -> None
        | JsonValue.Record value -> None
        | JsonValue.Array value -> None
        | JsonValue.Boolean value -> None
        | JsonValue.Null -> Some(key)
      )
      
    member this.has_scalar_properties = 
