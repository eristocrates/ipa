type JsonArrayElementKind =
    | StringArrayElements
    | DecimalArrayElements
    | FloatArrayElements
    | BooleanArrayElements
    | NullArrayElements
    | RecordArrayElements
    | NestedArrayElements
    | UnknownArrayElements


let classify_json_array_element (json_value: JsonValue) =
    match json_value with
    | JsonValue.String _ ->
        StringArrayElements

    | JsonValue.Number _ ->
        DecimalArrayElements

    | JsonValue.Float _ ->
        FloatArrayElements

    | JsonValue.Boolean _ ->
        BooleanArrayElements

    | JsonValue.Null ->
        NullArrayElements

    | JsonValue.Record _ ->
        RecordArrayElements

    | JsonValue.Array _ ->
        NestedArrayElements



let try_get_array_property
    (property_key: string)
    (json_record: JsonValue)
    =
    match json_record.TryGetProperty property_key with
    | Some (JsonValue.Array json_array) ->
        Some json_array

    | Some non_array_value ->
        failwithf
            "Property '%s' was expected to be an array, but its value was %A."
            property_key
            non_array_value

    | None ->
        None

let infer_array_element_kind
    (property_key: string)
    (json_records: JsonValue array)
    =
    let observed_element_kinds =
        json_records
        |> Array.choose (try_get_array_property property_key)
        |> Array.collect id
        |> Array.map classify_json_array_element
        |> Array.distinct

    match observed_element_kinds with
    | [||] ->
        // Every observed array was empty.
        //
        // JSON supplies no element-type information in this case.
        UnknownArrayElements

    | [| single_element_kind |] ->
        single_element_kind

    | conflicting_element_kinds ->
        failwithf
            "Array property '%s' contains conflicting element kinds: %A."
            property_key
            conflicting_element_kinds
let emit_json_array
    (property_key: string)
    (element_kind: JsonArrayElementKind)
    (json_array: JsonValue array)
    =
    match element_kind with
    | StringArrayElements ->
        Ast.ArrayExpr([
            for json_value in json_array do
                Ast.String(json_value.AsString())
        ])

    | DecimalArrayElements ->
        Ast.ArrayExpr([
            for json_value in json_array do
                Ast.Decimal(json_value.AsDecimal())
        ])

    | FloatArrayElements ->
        Ast.ArrayExpr([
            for json_value in json_array do
                Ast.Float(json_value.AsFloat())
        ])

    | BooleanArrayElements ->
        Ast.ArrayExpr([
            for json_value in json_array do
                Ast.Bool(json_value.AsBoolean())
        ])

    | NullArrayElements ->
        Ast.ArrayExpr([
            for _json_value in json_array do
                Ast.ConstantExpr("()")
        ])

    | UnknownArrayElements ->
        if Array.isEmpty json_array then
            Ast.ConstantExpr("([||] : obj array)")
        else
            failwithf
                "Array property '%s' was classified as unknown, but it contains values."
                property_key

    | RecordArrayElements ->
        failwithf
            "Array property '%s' contains records. Nested record-array emission has not yet been defined here."
            property_key

    | NestedArrayElements ->
        failwithf
            "Array property '%s' contains nested arrays. Nested-array emission has not yet been defined here."
            property_key







