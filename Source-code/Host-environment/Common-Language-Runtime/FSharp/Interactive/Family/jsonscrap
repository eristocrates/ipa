type Bundle with 
  static member inline as_resource<'T when 'T :> Resource> (bundle:Bundle)  =
    bundle.Entry
    |> Seq.choose (fun entry ->
        match entry.Resource with
        | :? 'T as resource -> Some resource
        | _ -> None)
    |> Seq.toArray

