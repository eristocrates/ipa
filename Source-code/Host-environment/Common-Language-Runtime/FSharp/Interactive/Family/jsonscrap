let emit_float_option (maybe_float:float option) =
  match maybe_float with 
  | Some value -> Ast.AppExpr("Some", Ast.Float(value))
  | None -> Ast.ConstantExpr("None")

let emit_boolean_option (maybe_boolean:bool option) =
  match maybe_boolean with 
  | Some value -> Ast.AppExpr("Some", Ast.Bool(value))
  | None -> Ast.ConstantExpr("None")
let emit_null_option (maybe_json_value:JsonValue option) =
  match maybe_json_value with 
  | Some value -> Ast.AppExpr("Some", value.AsString())
  | None -> Ast.ConstantExpr("None")



let root_binding = "example"
let rec emit_module (module_binding:string) (json_value:JsonValue) = 
        
        Ast.Module(module_binding.TrimStart('/').normalize_identifier){

              for key,value in json_value.string_properties -> Ast.Value(key, Ast.String(value))
              for key,value in json_value.decimal_properties -> Ast.Value(key, Ast.Decimal(value))
              for key,value in json_value.float_properties -> Ast.Value(key, Ast.Float(value))
              for key,value in json_value.boolean_properties -> Ast.Value(key, Ast.Bool(value))
              for key in json_value.null_properties -> Ast.Value(key, "()")



              // for object_key, json_object in json_value.record_properties_with_scalar_values -> Ast.Value(object_key, emit_anonymous_record json_object )




              for array_key,string_array in json_value.string_array_properties ->
                    Ast.Value(array_key, Ast.ArrayExpr([ for string_value in string_array -> Ast.String(string_value) ]))
              for array_key,decimal_array in json_value.decimal_array_properties ->
                    Ast.Value(array_key, Ast.ArrayExpr([ for decimal_value in decimal_array -> Ast.Decimal(decimal_value) ]))
              for array_key,float_array in json_value.float_array_properties ->
                    Ast.Value(array_key, Ast.ArrayExpr([ for float_value in float_array -> Ast.Float(float_value) ]))
              for array_key,boolean_array in json_value.boolean_array_properties ->
                    Ast.Value(array_key, Ast.ArrayExpr([ for boolean_value in boolean_array -> Ast.Bool(boolean_value) ]))
              for array_key in json_value.null_array_properties ->
                    Ast.Value(array_key, "[||]")
              for array_key, record_array in json_value.record_array_properties ->
              
                    let string_keys = 
                      record_array
                      |> Array.collect (fun json_value -> json_value.string_properties)
                      |> Array.map (fun (key,_) -> key)
                      |> Array.distinct
                    let decimal_keys = 
                      record_array
                      |> Array.collect (fun json_value -> json_value.decimal_properties)
                      |> Array.map (fun (key,_) -> key)
                      |> Array.distinct
                    let float_keys = 
                      record_array
                      |> Array.collect (fun json_value -> json_value.float_properties)
                      |> Array.map (fun (key,_) -> key)
                      |> Array.distinct
                    let boolean_keys = 
                      record_array
                      |> Array.collect (fun json_value -> json_value.boolean_properties)
                      |> Array.map (fun (key,_) -> key)
                      |> Array.distinct
                    let null_keys = 
                      record_array
                      |> Array.collect (fun json_value -> json_value.null_properties)
                      |> Array.distinct
                    let nested_array_keys =
                        record_array
                        |> Array.collect (fun json_record ->
                            json_record.array_properties
                            |> Array.map fst
                        )
                        |> Array.distinct
                    let nested_array_fields =
                        nested_array_keys
                        |> Array.map (fun property_key ->
                            let element_kind =
                                infer_array_element_kind
                                    property_key
                                    record_array

                            let is_optional =
                                is_option_field
                                    property_key
                                    record_array

                            property_key, element_kind, is_optional
                        )


                    Ast.Value(array_key, Ast.ArrayExpr([
                      for record_value in record_array -> 
                          let string_key_values = string_keys |> Array.map (fun string_key -> string_key, record_value.TryGetProperty string_key |> Option.map (fun value -> value.AsString()) )
                          let string_fields = string_key_values |> Array.choose (fun (key,maybe_string) -> 
                            if is_option_field key record_array then 
                              None
                            else 
                              Some (key,maybe_string.Value)
  
                            )
                          let string_option_fields = string_key_values |> Array.choose (fun (key,maybe_string) -> 
                            if is_option_field key record_array then 
                              Some (key,maybe_string)
                            else 
                              None
                            )
                          let decimal_key_values = decimal_keys |> Array.map (fun decimal_key -> decimal_key, record_value.TryGetProperty decimal_key |> Option.map (fun value -> value.AsDecimal()) )
                          let decimal_fields = decimal_key_values |> Array.choose (fun (key,maybe_decimal) -> 
                            if is_option_field key record_array then 
                              None
                            else 
                              Some (key,maybe_decimal.Value)
  
                            )
                          let decimal_option_fields = decimal_key_values |> Array.choose (fun (key,maybe_decimal) -> 
                            if is_option_field key record_array then 
                              Some (key,maybe_decimal)
                            else 
                              None
                            )
                          
                          let float_key_values = float_keys |> Array.map (fun float_key -> float_key, record_value.TryGetProperty float_key |> Option.map (fun value -> value.AsFloat()) )
                          let float_fields = float_key_values |> Array.choose (fun (key,maybe_float) -> 
                            if is_option_field key record_array then 
                              None
                            else 
                              Some (key,maybe_float.Value)
  
                            )
                          let float_option_fields = float_key_values |> Array.choose (fun (key,maybe_float) -> 
                            if is_option_field key record_array then 
                              Some (key,maybe_float)
                            else 
                              None
                            )
                          let boolean_key_values = boolean_keys |> Array.map (fun boolean_key -> boolean_key, record_value.TryGetProperty boolean_key |> Option.map (fun value -> value.AsBoolean()) )
                          let boolean_fields = boolean_key_values |> Array.choose (fun (key,maybe_boolean) -> 
                            if is_option_field key record_array then 
                              None
                            else 
                              Some (key,maybe_boolean.Value)
  
                            )
                          let boolean_option_fields = boolean_key_values |> Array.choose (fun (key,maybe_boolean) -> 
                            if is_option_field key record_array then 
                              Some (key,maybe_boolean)
                            else 
                              None
                            )
                          let null_key_values = null_keys |> Array.map (fun null_key -> null_key, record_value.TryGetProperty null_key)
                          let null_fields = null_key_values |> Array.choose (fun (key,maybe_null) -> 
                            if is_option_field key record_array then 
                              None
                            else 
                              Some (key,maybe_null.Value)
  
                            )
                          let null_option_fields = null_key_values |> Array.choose (fun (key,maybe_null) -> 
                            if is_option_field key record_array then 
                              Some (key,maybe_null)
                            else 
                              None
                            )
                          Ast.AnonRecordExpr([
                              for key,value in string_fields -> Ast.RecordFieldExpr(key, Ast.String(value))
                              for key,value in string_option_fields -> Ast.RecordFieldExpr(key, emit_string_option value)
                              for key,value in decimal_fields -> Ast.RecordFieldExpr(key, Ast.Decimal(value))
                              for key,value in decimal_option_fields -> Ast.RecordFieldExpr(key, emit_decimal_option value)
                              for key,value in float_fields -> Ast.RecordFieldExpr(key, Ast.Float(value))
                              for key,value in float_option_fields -> Ast.RecordFieldExpr(key, emit_float_option value)
                              for key,value in boolean_fields -> Ast.RecordFieldExpr(key, Ast.Bool(value))
                              for key,value in boolean_option_fields -> Ast.RecordFieldExpr(key, emit_boolean_option value)
                              for key,value in null_fields -> Ast.RecordFieldExpr(key, value.AsString())
                              for key,value in null_option_fields -> Ast.RecordFieldExpr(key, emit_null_option value)
                              for array_key, array_element_kind, array_is_optional in nested_array_fields ->
                                  match try_get_array_property array_key record_value with
                                  | Some json_array ->
                                      let emitted_array =
                                          emit_json_array
                                              array_key
                                              array_element_kind
                                              json_array

                                      if array_is_optional then
                                          Ast.RecordFieldExpr(
                                              array_key,
                                              Ast.AppExpr("Some", emitted_array)
                                          )
                                      else
                                          Ast.RecordFieldExpr(
                                              array_key,
                                              emitted_array
                                          )

                                  | None ->
                                      if array_is_optional then
                                          Ast.RecordFieldExpr(
                                              array_key,
                                              Ast.ConstantExpr("None")
                                          )
                                      else
                                          failwithf
                                              "Required array property '%s' was absent from a record."
                                              array_key

                              ])
                    ])) 
                       
              for object_key, json_object in json_value.record_properties ->
                let module_key = 
                    match object_key with 
                    | "*/*" ->  "asterisk_solidus_asterisk"
                    | _ -> object_key
                emit_module module_key json_object
        }

