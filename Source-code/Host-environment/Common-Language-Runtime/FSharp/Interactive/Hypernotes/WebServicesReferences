let references stem relative_path = 
  sprintf """
  	<ItemGroup>
        <Reference Include="%s">
          <HintPath>..\dynamic_linked_libraries\%s</HintPath>
        </Reference>
  	</ItemGroup>
  """
    stem 
    relative_path




