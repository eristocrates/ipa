unicode_blocks
|> Array.iter (fun block ->

    let unicode_block = Unicode_Standard.MakeEntity()
    let name = xattribute "name" block |> Array.head

    let first_hexdigit = xattribute "first-cp" block |> Array.head
    let first_codepoint = int'from'hexdigit_string first_hexdigit

    let last_hexdigit = xattribute "last-cp" block |> Array.head
    let last_codepoint = int'from'hexdigit_string last_hexdigit

    unicode_block.RegisterTerm "First_Codepoint" (Term.Int first_codepoint)
    unicode_block.RegisterTerm "Last_Codepoint" (Term.Int last_codepoint)

    unicode_block.Register(
        { Active = true
          Value = first_codepoint }: First_Codepoint
    )

    unicode_block.Register(
        { Active = true
          Value = last_codepoint }: Last_Codepoint
    )

    unicode_block.Register({ Active = true; Value = name }: Name)




)


