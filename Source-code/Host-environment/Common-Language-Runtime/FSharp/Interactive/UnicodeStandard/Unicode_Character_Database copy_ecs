let attribute_bindings = 
    attribute_local_names
    |> Array.map (fun attribute_local_name -> 
    let binding_raw = defaultArg (PropertyAliases.TryFind attribute_local_name) attribute_local_name
    let binding_upper = 
        let dehypenated = binding_raw.Replace('-','_')
        let capitalized = dehypenated[0].ToString().ToUpperInvariant() + dehypenated[1..]
        capitalized
    let binding_lower = binding_upper.ToLowerInvariant()
    (binding_raw, binding_upper, binding_lower)
    )

let attribute_struct_codegen = 
