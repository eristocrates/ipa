    |> Array.iter (fun {attribute_local_name}_char ->

        let codepoint = codepoint_from_unicode_char {attribute_local_name}_char
        let unicodepoint = unicodepoint_from_codepoint codepoint
        unicodepoint.RegisterTerm "{property_name}" Term.Tag

    )

    """

