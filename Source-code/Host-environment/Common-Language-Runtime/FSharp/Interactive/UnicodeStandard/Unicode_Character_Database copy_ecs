[<Struct>]
[<RequireQualifiedAccess>]
type Unicode_Name_Kind =
    | name of string
    | unicode_1_name of string
    | abbreviation of string
    | control of string
    | figment of string
    | correction of string
    | alternate of string
    | unknown of string
    static member from_alias_type (alias_type: string) (alias: string) =
        match alias_type with
        | "abbreviation" -> abbreviation alias
        | "control" -> control alias
        | "figment" -> figment alias
        | "correction" -> correction alias
        | "alternate" -> alternate alias
        | _ -> unknown alias

[<Struct>]
type Unicode_Name =
    { mutable Active: bool
      mutable Value: Unicode_Name_Kind }
    interface Unicode_Name Component with
        member this.Active
            with get () = this.Active
            and set value = this.Active <- value



let Name =

    unicode_chars
    |> Array.map (fun unicode_char ->

        let unicodepoint = codepoint_from_unicode_char unicode_char

        let na =
            unicode_char
            |> xattribute "na"
            |> Array.map (fun na ->

                if na.EndsWith("#") then
                    let na_dehashed =
                        na.TrimEnd('#')
                        + (unicode_char.Attribute "cp").Value

                    Unicode_Name_Kind.name na_dehashed
                else
                    Unicode_Name_Kind.name na

            )

        let na1 =
            unicode_char
            |> xattribute "na1"
            |> Array.map (fun na1 -> Unicode_Name_Kind.unicode_1_name na1)

        let name_aliases =
            unicode_char.Descendants()
            |> Seq.toArray
            |> Array.filter (
                element_attribute'by_local_name "alias"
                >> Option.isSome
            )
            |> Array.collect (fun name_alias ->

                name_alias
                |> xattribute "type"
                |> Array.map (fun alias_type ->
                    Unicode_Name_Kind.from_alias_type alias_type (name_alias.Attribute("alias").Value))

            )

        let names = Array.concat [| na; na1; name_aliases |]

        unicodepoint, names

    )
    |> FMap.ofArray



























