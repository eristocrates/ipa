            quad_components code_point'property'value)

    let expansion_elapsed = batch_stopwatch.Elapsed

    Write.Entity'Components entity'components LMDB_context

    batch_stopwatch.Stop()

    total_components_written <-
        total_components_written
        + entity'components.Length

    let total_rate =
        float total_components_written
        / total_stopwatch.Elapsed.TotalSeconds

