let mutable total_stopwatch = Stopwatch.StartNew()

let mutable total_components_written = 0

character_properties
|> Array.chunkBySize batch_size
|> Array.iteri (fun batch_index character_property_batch ->

    let batch_stopwatch = Stopwatch.StartNew()

    let entity'components =
        character_property_batch
        |> Array.collect (fun (code_point, property_short_name, property_value) ->
            let code_point_iri = unicode.prefix code_point

            let property_iri = property_iri_cache[property_short_name]

            let property_literal = property_literal_cache[property_value]

            let code_point'property'value =
