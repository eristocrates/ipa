          Unicode_Plane.Private_Use_Area_A
          Unicode_Plane.Private_Use_Area_B ]

    static member try_from_character_value(character_value: int) : Unicode_Plane option =
        if character_value < 0x0000
           || character_value > 0x10FFFF then
            None
        else
            let plane_index = character_value / 0x10000

            Unicode_Plane.All
            |> List.tryFind (fun plane -> plane.as_int = plane_index)

    member this.contains_character_value(character_value: int) : bool =
        this.from_character_value <= character_value
        && character_value <= this.to_character_value

    member this.is_noncharacter_value(character_value: int) : bool =
        this.non_character_values
        |> Seq.contains character_value



[<Struct>]
type Unicodepoint =
    {

      is_ascii: bool
      is_bmp: bool
      plane_value: int
      utf8_sequence_length: int
      utf16_sequence_length: int
      value: int
      unicode_category: UnicodeCategory

     }
    member this.plane(plane_value: int) = Unicode_Plane.All[this.plane_value]

    static member from_rune(rune: Rune) =

        {

          is_ascii = rune.IsAscii
          is_bmp = rune.IsBmp
          plane_value = rune.Plane
          utf8_sequence_length = rune.Utf8SequenceLength
          utf16_sequence_length = rune.Utf16SequenceLength
          value = rune.Value
          unicode_category = CharUnicodeInfo.GetUnicodeCategory rune.Value


        }

// essentially a so called grapheme cluster
[<Struct>]
type Unicode_Token =
    {

      as_string: string
      as_codepoints: Unicodepoint array

     }
    member this.is_single_codepoint = this.as_codepoints.Length = 1

    member this.is_multi_codepoint = this.as_codepoints.Length > 1



let unicode_tokens'from'string (input: string) =
    seq {
        let enumerator = StringInfo.GetTextElementEnumerator(input)

        while enumerator.MoveNext() do
            let element = enumerator.GetTextElement()
            let runes = element.EnumerateRunes() |> Seq.toArray


            let codepoints =
                runes
                |> Array.map (fun rune -> Unicodepoint.from_rune rune)

            yield
                {

                  as_string = element
                  as_codepoints = codepoints

                }



    }
    |> Seq.toArray

let test_string = "a\u0304\u0308bc\u0327"
let unicode_tokens = unicode_tokens'from'string test_string

