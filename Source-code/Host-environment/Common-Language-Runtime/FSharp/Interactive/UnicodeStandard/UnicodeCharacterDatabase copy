[<Struct>]
type Unicode_Plane =
    {

      name: string
      abbreviation: string
      as_int: int
      from_character_value: int
      to_character_value: int
      non_character_values: int array

     }

    static member private create
        (
            as_int: int,
            name: string,
            abbreviation: string,
            non_character_values: int array
        ) : Unicode_Plane =
        let from_character_value = as_int * 0x10000
        let to_character_value = from_character_value + 0xFFFF

        { name = name
          abbreviation = abbreviation
          as_int = as_int
          from_character_value = from_character_value
          to_character_value = to_character_value
          non_character_values = non_character_values }

    static member private terminal_noncharacters_for_plane(plane_index: int) : int array =
        seq {
            let plane_start = plane_index * 0x10000
            yield plane_start + 0xFFFE
            yield plane_start + 0xFFFF
        }
        |> Seq.toArray

    static member private bmp_noncharacters: int array =
        seq {
            yield! seq { 0xFDD0..0xFDEF }
            yield! Unicode_Plane.terminal_noncharacters_for_plane 0
        }
        |> Seq.toArray

    static member private noncharacters_for_non_bmp_plane(plane_index: int) : int array =
        Unicode_Plane.terminal_noncharacters_for_plane plane_index

    static member Basic_Multilingual_Plane: Unicode_Plane =
        Unicode_Plane.create (0, "Basic Multilingual Plane", "BMP", Unicode_Plane.bmp_noncharacters)

    static member Supplementary_Multilingual_Plane: Unicode_Plane =
        Unicode_Plane.create (
            1,
            "Supplementary Multilingual Plane",
            "SMP",
            Unicode_Plane.noncharacters_for_non_bmp_plane 1
        )

    static member Supplementary_Ideographic_Plane: Unicode_Plane =
        Unicode_Plane.create (
            2,
            "Supplementary Ideographic Plane",
            "SIP",
            Unicode_Plane.noncharacters_for_non_bmp_plane 2
