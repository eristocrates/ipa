#I @"C:\Repositories\eristocrates\ipa\Source-code\Host-environment\Common-Language-Runtime\FSharp\Interactive\REPL"
#load @".paket/load/main.group.fsx"
#r @"RdfAsm.dll"
open RdfAsm
#r @"RdfIO.dll"
open RdfIO

module opmv =
    let _prefixId = PrefixId.fromNamespaceLabel "http://purl.org/net/opmv/ns#" "opmv"
    let _namespaceIri = _prefixId.prefix ""
    /// <summary>
    ///   <para>rdfs:comment : Agent is a contextual entity acting as a catalyst of a process, enabling, facilitating, controlling, or affecting its execution.</para>
    ///   <para>rdfs:label : Agent</para>
    ///   <a href="http://purl.org/net/opmv/ns#Agent">opmv:Agent</a>
    /// </summary>
    let Agent = _prefixId.prefix "Agent"
    /// <summary>
    ///   <para>rdfs:comment : Artifact is a general concept that represents immutable piece of state, which may have a physical embodiment in a physical object, or a digital representation in a computer system.</para>
    ///   <para>rdfs:label : Artifact</para>
    ///   <a href="http://purl.org/net/opmv/ns#Artifact">opmv:Artifact</a>
    /// </summary>
    let Artifact = _prefixId.prefix "Artifact"
    /// <summary>
    ///   <para>rdfs:comment : Process refers to an action or series of actions performed on or caused by artifacts, and resulting in new artifacts.</para>
    ///   <para>rdfs:label : Process</para>
    ///   <a href="http://purl.org/net/opmv/ns#Process">opmv:Process</a>
    /// </summary>
    let Process = _prefixId.prefix "Process"
    /// <summary>
    ///   <para>rdfs:comment : used is an abstract property to express that an artifact was used by a process.</para>
    ///   <para>rdfs:label : used</para>
    ///   <a href="http://purl.org/net/opmv/ns#used">opmv:used</a>
    /// </summary>
    let used = _prefixId.prefix "used"
    /// <summary>
    ///   <para>rdfs:comment : wasControlledBy is an abstract property to express that a process was controlled an agent.</para>
    ///   <para>rdfs:label : wasControlledBy</para>
    ///   <a href="http://purl.org/net/opmv/ns#wasControlledBy">opmv:wasControlledBy</a>
    /// </summary>
    let wasControlledBy = _prefixId.prefix "wasControlledBy"
    /// <summary>
    ///   <para>rdfs:comment : wasDerivedFrom is an abstract property to express that an artifact was derived from another artifact.</para>
    ///   <para>rdfs:label : wasDerivedFrom</para>
    ///   <a href="http://purl.org/net/opmv/ns#wasDerivedFrom">opmv:wasDerivedFrom</a>
    /// </summary>
    let wasDerivedFrom = _prefixId.prefix "wasDerivedFrom"
    /// <summary>
    ///   <para>rdfs:comment : wasEncodedBy is an object property to express that an artifact is encoded by another artifact. The property is useful for expressing the relationship between the data and the file encoding the data.</para>
    ///   <para>rdfs:label : wasEncodedBy</para>
    ///   <a href="http://purl.org/net/opmv/ns#wasEncodedBy">opmv:wasEncodedBy</a>
    /// </summary>
    let wasEncodedBy = _prefixId.prefix "wasEncodedBy"
    /// <summary>
    ///   <para>rdfs:comment :
    ///       wasEndedAt is an object property to express that a process was finished at a specific time &lt;a xmlns="http://www.w3.org/1999/xhtml" href="http://www.w3.org/2006/time#Instant" xml:lang="en"&gt;instant&lt;/a&gt;. The property chain defines that all processes, that were performed during a specific time period which ended at a specific instant, were actually finished at that specific time instant.
    ///     ^^rdf:XMLLiteral</para>
    ///   <para>rdfs:label : wasEndedAt</para>
    ///   <a href="http://purl.org/net/opmv/ns#wasEndedAt">opmv:wasEndedAt</a>
    /// </summary>
    let wasEndedAt = _prefixId.prefix "wasEndedAt"
    /// <summary>
    ///   <para>rdfs:comment :
    ///     wasGeneratedAt is an object property to express that an artifact was generated at a specific time &lt;a xmlns="http://www.w3.org/1999/xhtml" href="http://www.w3.org/2006/time#Instant" xml:lang="en"&gt;instant&lt;/a&gt;. This property is very similar to &lt;a xmlns="http://www.w3.org/1999/xhtml" href="http://purl.org/dc/terms/created" xml:lang="en"&gt;dct:created&lt;/a&gt;. Note that in a very fine-grained case the time when an artifact was generated might not be the same as the time when the process producing that artifact finished.
    ///     ^^rdf:XMLLiteral</para>
    ///   <para>rdfs:label : wasGeneratedAt</para>
    ///   <a href="http://purl.org/net/opmv/ns#wasGeneratedAt">opmv:wasGeneratedAt</a>
    /// </summary>
    let wasGeneratedAt = _prefixId.prefix "wasGeneratedAt"
    /// <summary>
    ///   <para>rdfs:comment : wasGeneratedBy is an abstract property to express that an artifact was generated by a process.</para>
    ///   <para>rdfs:label : wasGeneratedBy</para>
    ///   <a href="http://purl.org/net/opmv/ns#wasGeneratedBy">opmv:wasGeneratedBy</a>
    /// </summary>
    let wasGeneratedBy = _prefixId.prefix "wasGeneratedBy"
    /// <summary>
    ///   <para>rdfs:comment :
    ///       wasPerformedAt is an object property to express that a process was performed at a given time &lt;a xmlns="http://www.w3.org/1999/xhtml" href="http://www.w3.org/2006/time#Instant" xml:lang="en"&gt;instant&lt;/a&gt; or during a given time &lt;a xmlns="http://www.w3.org/1999/xhtml" href="http://www.w3.org/2006/time#Interval" xml:lang="en"&gt;interval&lt;/a&gt;.
    ///     ^^rdf:XMLLiteral</para>
    ///   <para>rdfs:label : wasPerformedAt</para>
    ///   <a href="http://purl.org/net/opmv/ns#wasPerformedAt">opmv:wasPerformedAt</a>
    /// </summary>
    let wasPerformedAt = _prefixId.prefix "wasPerformedAt"
    /// <summary>
    ///   <para>rdfs:comment :
    ///     wasPerformedBy is an object property to express that a process was performed by an agent. It is a sub-property of &lt;a xmlns="http://www.w3.org/1999/xhtml" href="#wasControlledBy" xml:lang="en"&gt;wasControlledBy&lt;/a&gt;.
    ///   ^^rdf:XMLLiteral</para>
    ///   <para>rdfs:label : wasPerformedBy</para>
    ///   <a href="http://purl.org/net/opmv/ns#wasPerformedBy">opmv:wasPerformedBy</a>
    /// </summary>
    let wasPerformedBy = _prefixId.prefix "wasPerformedBy"
    /// <summary>
    ///   <para>rdfs:comment :
    ///       wasStartedAt is an object property to express that a process was started at a given time &lt;a xmlns="http://www.w3.org/1999/xhtml" href="http://www.w3.org/2006/time#Instant" xml:lang="en"&gt;instant&lt;/a&gt;. The property chain defines that all processes, that were performed during a specific time period which began at a specific instant, were actually started at that specific time instant.
    ///     ^^rdf:XMLLiteral</para>
    ///   <para>rdfs:label : wasStartedAt</para>
    ///   <a href="http://purl.org/net/opmv/ns#wasStartedAt">opmv:wasStartedAt</a>
    /// </summary>
    let wasStartedAt = _prefixId.prefix "wasStartedAt"
    /// <summary>
    ///   <para>rdfs:comment : wasTriggeredBy is an abstract property to express that a process was triggered by another process.</para>
    ///   <para>rdfs:label : wasTriggeredBy</para>
    ///   <a href="http://purl.org/net/opmv/ns#wasTriggeredBy">opmv:wasTriggeredBy</a>
    /// </summary>
    let wasTriggeredBy = _prefixId.prefix "wasTriggeredBy"
    /// <summary>
    ///   <para>rdfs:comment :
    ///     wasUsedAt is an object property to express that an artifact was used at a specific time &lt;a xmlns="http://www.w3.org/1999/xhtml" href="http://www.w3.org/2006/time#Instant" xml:lang="en"&gt;instant&lt;/a&gt;. An artifact might not be used at the starting time of the process that actually consumed it. Hence, we provide a different time-related property to express when an artifact was used.^^rdf:XMLLiteral</para>
    ///   <para>rdfs:label : wasUsedAt</para>
    ///   <a href="http://purl.org/net/opmv/ns#wasUsedAt">opmv:wasUsedAt</a>
    /// </summary>
    let wasUsedAt = _prefixId.prefix "wasUsedAt"
    /// <summary>
    ///   <para>rdfs:comment :
    ///     withRespectOf is an object property to associate a time instant at which an artifact was used or generated with the process that used or generated that artifact. At a very fine-grained distinction, the time when an artifact was used or generated might not be exactly the same as the starting or ending time of the process in which the artifact was involved. The related properties &lt;a xmlns="http://www.w3.org/1999/xhtml" href="#wasUsedAt" xml:lang="en"&gt;opmv:wasUsedAt&lt;/a&gt; and &lt;a xmlns="http://www.w3.org/1999/xhtml" href="#wasGeneratedAt" xml:lang="en"&gt;opmv:wasGeneratedAt&lt;/a&gt; can be used as shortcuts to express time-related information about an artifact. The property  &lt;a xmlns="http://www.w3.org/1999/xhtml" href="#wasUsedAt" xml:lang="en"&gt;opmv:wasUsedAt&lt;/a&gt; is only used when users want to express precisely in which process an artifact was used or generated. It can be omitted in most cases.^^rdf:XMLLiteral</para>
    ///   <para>rdfs:label : withRespectOf</para>
    ///   <a href="http://purl.org/net/opmv/ns#withRespectOf">opmv:withRespectOf</a>
    /// </summary>
    let withRespectOf = _prefixId.prefix "withRespectOf"
