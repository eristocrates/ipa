    /// </summary>
    let owns = _prefixId.prefix "owns"
    /// <summary>
    ///   <para>rdfs:label : owns asset^^xsd:string</para>
    ///   <para>skos:definition : identifies an asset that an owner owns^^xsd:string</para>
    ///   <a href="https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/ownsAsset">fibo-fnd-oac-own:ownsAsset</a>
    /// </summary>
    let ownsAsset = _prefixId.prefix "ownsAsset"
