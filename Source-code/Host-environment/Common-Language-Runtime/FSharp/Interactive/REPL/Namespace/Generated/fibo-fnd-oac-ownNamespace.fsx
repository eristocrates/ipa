    ///   <a href="https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/hasOwningParty">fibo-fnd-oac-own:hasOwningParty</a>
    /// </summary>
    let hasOwningParty = _prefixId.prefix "hasOwningParty"
    /// <summary>
    ///   <para>rdfs:label : is asset of^^xsd:string</para>
    ///   <para>skos:definition : identifies the owner of an asset^^xsd:string</para>
    ///   <a href="https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/isAssetOf">fibo-fnd-oac-own:isAssetOf</a>
    /// </summary>
    let isAssetOf = _prefixId.prefix "isAssetOf"
    /// <summary>
    ///   <para>rdfs:label : is owned asset^^xsd:string</para>
    ///   <para>skos:definition : indicates the context of ownership in which something is an asset^^xsd:string</para>
    ///   <a href="https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/isOwnedAsset">fibo-fnd-oac-own:isOwnedAsset</a>
    /// </summary>
    let isOwnedAsset = _prefixId.prefix "isOwnedAsset"
    /// <summary>
    ///   <para>rdfs:label : is owned by^^xsd:string</para>
    ///   <para>skos:definition : indicates something that someone owns^^xsd:string</para>
    ///   <a href="https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/isOwnedBy">fibo-fnd-oac-own:isOwnedBy</a>
    /// </summary>
    let isOwnedBy = _prefixId.prefix "isOwnedBy"
    /// <summary>
    ///   <para>rdfs:label : is owning party^^xsd:string</para>
    ///   <para>skos:definition : indicates the context of ownership in which the party plays the role of owner^^xsd:string</para>
    ///   <a href="https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/isOwningParty">fibo-fnd-oac-own:isOwningParty</a>
    /// </summary>
    let isOwningParty = _prefixId.prefix "isOwningParty"
    /// <summary>
    ///   <para>rdfs:label : owns^^xsd:string</para>
    ///   <para>skos:definition : indicates something that a party holds title to and may possess^^xsd:string</para>
