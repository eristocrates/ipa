    ///   <a href="https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/hasAcquisitionPrice">fibo-fnd-oac-own:hasAcquisitionPrice</a>
    /// </summary>
    let hasAcquisitionPrice = _prefixId.prefix "hasAcquisitionPrice"
    /// <summary>
    ///   <para>rdfs:label : has owned asset^^xsd:string</para>
    ///   <para>skos:definition : indicates the asset in an ownership situation^^xsd:string</para>
    ///   <a href="https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/hasOwnedAsset">fibo-fnd-oac-own:hasOwnedAsset</a>
