  <dc:creator>Christoph Ruegg</dc:creator>
  <dc:description>Math.NET Symbolics is a basic open source computer algebra library for .Net and Mono. Written in F# but works well in C# as well. Supports .Net Framework 4.5 or higher and .Net Standard 2.0 or higher, on Windows, Linux and Mac.</dc:description>
  <dc:identifier>MathNet.Symbolics</dc:identifier>
  <version>0.25</version>
  <keywords>fsharp F# math symbolics algebra simplify solve cas parse</keywords>
