<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Meziantou.Framework.Avatar</id>
    <version>2.1.1</version>
    <authors>meziantou</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/meziantou/Meziantou.Framework</projectUrl>
    <description>Generate deterministic avatar SVG images from names and bigrams</description>
    <tags>avatar, identicon, initials, svg, image</tags>
    <repository type="git" url="https://github.com/meziantou/Meziantou.Framework" branch="refs/heads/main" commit="f00db4f5232bf030e558353ee44ffa6e350d3a57" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="System.IO.Hashing" version="10.0.11" exclude="Build,Native,Analyzers,BuildTransitive" />
      </group>
      <group targetFramework="net11.0">
        <dependency id="System.IO.Hashing" version="10.0.11" exclude="Build,Native,Analyzers,BuildTransitive" />
      </group>
    </dependencies>
  </metadata>
</package>