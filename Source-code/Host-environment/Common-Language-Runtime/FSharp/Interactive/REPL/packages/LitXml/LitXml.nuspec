<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>LitXml</id>
    <version>0.1.0</version>
    <authors>HLWeil,CSBiology</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <iconUrl>https://fslab.org/docs-template/img/logo.png</iconUrl>
    <description>Small FSharp based DSL for writing literal xml</description>
    <releaseNotes>Refactor element types and elementbuilder to allow for optional and required values.
Add !! and !? operators.</releaseNotes>
    <tags>F# FSharp xml dsl</tags>
    <repository type="git" url="https://github.com/CSBiology/LitXml" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="FSharp.Core" version="6.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>