<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>PuppeteerSharp</id>
    <version>25.8.0</version>
    <title>PuppeteerSharp</title>
    <authors>Darío Kondratiuk</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/hardkoded/puppeteer-sharp</projectUrl>
    <description>Headless Browser .NET API</description>
    <tags>headless,chrome,puppeteer</tags>
    <repository type="git" url="https://github.com/hardkoded/puppeteer-sharp" commit="904c06c69fc330ec6e7385eae68d2367e7178f96" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.Extensions.Logging" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.IO.RecyclableMemoryStream" version="3.0.1" exclude="Build,Analyzers" />
        <dependency id="ReactiveExtensionsSharp" version="0.3.0" exclude="Build,Analyzers" />
        <dependency id="WebDriverBiDi" version="0.0.54" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Microsoft.Extensions.Logging" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.IO.RecyclableMemoryStream" version="3.0.1" exclude="Build,Analyzers" />
        <dependency id="ReactiveExtensionsSharp" version="0.3.0" exclude="Build,Analyzers" />
        <dependency id="WebDriverBiDi" version="0.0.54" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="10.0.7" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Logging" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.IO.RecyclableMemoryStream" version="3.0.1" exclude="Build,Analyzers" />
        <dependency id="ReactiveExtensionsSharp" version="0.3.0" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="10.0.7" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Channels" version="10.0.7" exclude="Build,Analyzers" />
        <dependency id="WebDriverBiDi" version="0.0.54" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>