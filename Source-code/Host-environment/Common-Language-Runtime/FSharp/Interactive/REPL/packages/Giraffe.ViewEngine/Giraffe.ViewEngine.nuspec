<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Giraffe.ViewEngine</id>
    <version>1.4.0</version>
    <authors>Dustin Moris Gorski and contributors</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>giraffe-64x64.png</icon>
    <projectUrl>https://github.com/giraffe-fsharp/Giraffe.ViewEngine</projectUrl>
    <description>An F# view engine for Giraffe and other ASP.NET Core web applications.</description>
    <releaseNotes>https://raw.githubusercontent.com/giraffe-fsharp/Giraffe.ViewEngine/master/RELEASE_NOTES.md</releaseNotes>
    <copyright>Copyright 2020 Dustin Moris Gorski</copyright>
    <tags>Giraffe View Engine ASP.NET Core FSharp Functional Http Web Framework Micro Service</tags>
    <repository type="git" url="https://github.com/giraffe-fsharp/Giraffe.ViewEngine" />
    <dependencies>
      <group targetFramework="net5.0">
        <dependency id="FSharp.Core" version="5.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="FSharp.Core" version="5.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>