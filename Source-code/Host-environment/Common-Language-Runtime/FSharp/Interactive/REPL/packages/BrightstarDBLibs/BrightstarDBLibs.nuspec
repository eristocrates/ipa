<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>BrightstarDBLibs</id>
    <version>1.13.3</version>
    <title>BrightstarDB (Libraries Only)</title>
    <authors>kal_ahmed</authors>
    <owners>kal_ahmed</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>http://www.opensource.org/licenses/MIT</licenseUrl>
    <projectUrl>http://brightstardb.com/</projectUrl>
    <iconUrl>http://brightstardb.com/images/logo-nuget.png</iconUrl>
    <description>BrightstarDB is a fast and scalable NoSQL database for .NET with code-first data model generation. This package only installs the BrightstarDB libraries - for entity framework support please install the BrightstarDB package.</description>
    <releaseNotes>1.13.3</releaseNotes>
    <copyright>Copyright 2017 Khalil Ahmed, Graham Moore, and other contributors</copyright>
    <tags>brightstardb rdf nosql database sparql entityframework</tags>
    <dependencies>
      <group>
        <dependency id="dotNetRDF" version="1.0.9" />
        <dependency id="Newtonsoft.Json" version="7.0.1" />
      </group>
      <group targetFramework=".NETFramework4.5">
        <dependency id="dotNetRDF" version="1.0.9" />
        <dependency id="Newtonsoft.Json" version="7.0.1" />
      </group>
      <group targetFramework=".NETPortable0.0-Profile344">
        <dependency id="dotNetRDF" version="1.0.9" />
        <dependency id="SharpSerializer.PCL" version="2.18.7" />
        <dependency id="Newtonsoft.Json" version="7.0.1" />
      </group>
      <group targetFramework=".NETPortable0.0-Profile158">
        <dependency id="dotNetRDF" version="1.0.9" />
        <dependency id="SharpSerializer.PCL" version="2.18.7" />
        <dependency id="Newtonsoft.Json" version="7.0.1" />
      </group>
    </dependencies>
  </metadata>
</package>