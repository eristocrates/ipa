<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>Cambia.UriExtensions</id>
    <version>2.1.0</version>
    <title>Cambia.UriExtensions</title>
    <authors>Steve Lautenschlager</authors>
    <owners>Steve Lautenschlager</owners>
    <licenseUrl>https://www.tldrlegal.com/l/mspl</licenseUrl>
    <projectUrl>https://www.cambiaresearch.com/articles/730004</projectUrl>
    <iconUrl>https://www.cambiaresearch.com/sites/cambia/r/logo/cr_icon2.png</iconUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Extensions for the .NET URI class.  Get, set, drop, update URI parts, query items and path items.  Fluent interface.  No more worrying about part delimiters.</description>
    <summary>Provides a suite of extension methods for the existing .NET Uri class to make extracting, modifying and building URIs and their parts easier than ever.</summary>
    <releaseNotes>Added fluency to most method calls on UriPath so that method calls can be chained.</releaseNotes>
    <copyright>Copyright © 2016-2018 Steve Lautenschlager</copyright>
    <tags>.net uri class build change extract scheme authority user info port path query fragment http https ftp mailto file url transform fluent interface</tags>
    <dependencies>
      <dependency id="AntiXSS" version="4.3.0" />
    </dependencies>
  </metadata>
</package>