        <dependency id="Azure.Core" version="1.60.0" exclude="Build,Analyzers" />
        <dependency id="OpenTelemetry.Extensions.Hosting" version="1.15.3" exclude="Build,Analyzers" />
        <dependency id="OpenTelemetry.PersistentStorage.FileSystem" version="1.0.3" exclude="Build,Analyzers" />
      </group>
