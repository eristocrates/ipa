<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FSharp.Json</id>
    <version>0.4.1</version>
    <authors>vsapronov</authors>
    <owners>vsapronov</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectUrl>https://github.com/vsapronov/FSharp.Json</projectUrl>
    <description>F# JSON Reflection based serialization library</description>
    <copyright>Copyright 2019</copyright>
    <tags>F# JSON serialization</tags>
    <repository url="https://github.com/vsapronov/FSharp.Json" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="FSharp.Core" version="4.6.2" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>