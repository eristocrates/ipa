        <dependency id="RDFSharp" version="4.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="AsyncEnumerator" version="4.0.2" exclude="Build,Analyzers" />
